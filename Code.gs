      telepon: (Array.isArray(p.telepon) ? p.telepon : []).map(function (t) { return str(t, 40); }).filter(function (t) { return /\d{6,}/.test(t.replace(/\D/g, '')); }).slice(0, 3),
      email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(str(p.email, 120)) ? str(p.email, 120) : '',
