      var l = lengkap[id] || {};
      tambah(String(r[10] || '').trim() || l.nama, String(r[11] || '').trim() || l.hp, String(r[12] || '').trim() || l.alamat,
        'Shopee', 'Marketplace (Shopee)', r[3], r[1], String(r[14] || '').trim() || l.username);
    });
  }
  try {
    var shC = getPesananConnerSheet(), lrC = shC.getLastRow();
    if (lrC > 1) {
      var lebar = Math.min(15, shC.getMaxColumns());
      shC.getRange(2, 1, lrC - 1, lebar).getValues().forEach(function (r) {
        if (!String(r[0] || '').trim() || /cancel|batal|unpaid/i.test(String(r[4] || ''))) return;
        tambah(String(r[10] || '').trim() || String(r[7] || '').trim(), String(r[11] || '').trim() || String(r[8] || '').trim(),
          String(r[12] || '').trim() || String(r[9] || '').trim(), 'Conner Hardware', 'Marketplace (Conner Hardware)', r[3], r[1], String(r[14] || '').trim());
      });
    }
  } catch (eC) { }
}

