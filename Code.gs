    if (!cocokJson) throw new Error('AI nggak balas format JSON. Respons: ' + hasilMentah.substring(0, 200));
    var parsed = JSON.parse(cocokJson[0]);

    var namaIntiDenganTipe = String(parsed.nama || '').trim();
    if (parsed.tipe) namaIntiDenganTipe += ' ' + String(parsed.tipe).trim();
    var bagianNama = [namaIntiDenganTipe, parsed.material, parsed.volume, parsed.warna]
      .map(function (b) { return String(b || '').trim(); }).filter(function (b) { return b.length > 0; });
    var namaBaru = bagianNama.join(' ');
    var tipeBaru = String(parsed.tipe || '').trim();
    var materialBaru = String(parsed.material || '').trim();
    var volumeBaru = String(parsed.volume || '').trim();
    var warnaBaru = String(parsed.warna || '').trim();
    var brandBaru = String(parsed.brand || '').trim();

    // Panggilan AI (lambat) sudah selesai di luar lock; tulis di dalam lock + cari ulang barisnya
    katTulisDiBarisSku_(sh, sku, function (row) {
      sh.getRange(row, 2).setValue(namaBaru);
      sh.getRange(row, 11, 1, 5).setValues([[brandBaru, tipeBaru, materialBaru, volumeBaru, warnaBaru]]);
    });

    result.success = true;
    result.namaBaru = namaBaru;
    result.brandBaru = brandBaru;
    result.tipeBaru = tipeBaru;
    result.materialBaru = materialBaru;
    result.volumeBaru = volumeBaru;
    result.warnaBaru = warnaBaru;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   SKU SUPPLIER TERHUBUNG - 1 SKU Jual bisa disuplai dari BEBERAPA SKU Supplier
   beda harga (misal supplier A vs B, atau batch beda harga). HPP dihitung
   RATA-RATA TERTIMBANG (weighted average) dari semua stock masuk yang MASIH ADA.
   ============================================================ */
/* ============================================================
   SKU MARKETPLACE TERHUBUNG - beda dari SKU Supplier Terhubung: ini buat kode SKU yang
   TERDAFTAR DI MARKETPLACE (TikTok Shop, Shopee, dll). SKU marketplace susah/berisiko diubah
   (dan pesanan LAMA yang udah masuk tetap pakai kode lama walau SKU-nya diganti nanti) - jadi
   solusinya bukan ubah SKU di marketplace, tapi PETAKAN ke SKU Jual internal kita di sini.
   Sekali dipetakan, semua pesanan (lama & baru) yang bawa kode itu otomatis kebaca sebagai
   SKU Jual yang benar - stock, dashboard, dan laporan keuangan ikut akurat otomatis.
   ============================================================ */
function getSkuMarketplaceTerhubungSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('SKU Marketplace Terhubung');
  if (!sh) {
    sh = ss.insertSheet('SKU Marketplace Terhubung');
    sh.getRange(1, 1, 1, 4).setValues([['SKU Jual', 'SKU Marketplace', 'Platform', 'Keterangan']]);
    sh.getRange(1, 1, 1, 4).setFontWeight('bold');
  }
  return sh;
}

// Kalau skuInput adalah SKU Marketplace yang udah dipetakan, balikin SKU Jual-nya.
// Kalau bukan (atau nggak ketemu), anggap skuInput itu SENDIRI udah SKU Jual - biar tetap
// jalan normal buat toko yang SKU marketplace-nya emang udah sama persis sama SKU Jual.
var CACHE_PETA_SKU_MARKETPLACE = null; // cache dalam 1x eksekusi doang (per-request), biar nggak baca sheet berkali-kali kalau dipanggil di dalam loop banyak item
function resolveSkuMarketplaceKeSkuJual(skuInput) {
  var skuBersih = String(skuInput || '').trim();
  if (!skuBersih) return skuBersih;

  if (!CACHE_PETA_SKU_MARKETPLACE) {
    CACHE_PETA_SKU_MARKETPLACE = {};
    var sh = getSkuMarketplaceTerhubungSheet();
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 2).getValues();
      vals.forEach(function (row) {
        var skuJual = String(row[0]).trim();
        if (!skuJual) return;
        // 1 sel bisa berisi BEBERAPA kode SKU Marketplace dipisah spasi/koma
        String(row[1]).split(/[\s,]+/).map(function (s) { return s.trim(); }).filter(function (s) { return s; })
          .forEach(function (kode) { CACHE_PETA_SKU_MARKETPLACE[kode] = skuJual; });
      });
    }
  }
  return CACHE_PETA_SKU_MARKETPLACE.hasOwnProperty(skuBersih) ? CACHE_PETA_SKU_MARKETPLACE[skuBersih] : skuBersih;
}

function prosesLihatSkuMarketplaceTerhubung(data) {
