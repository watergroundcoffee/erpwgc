/* ---------- pengisi otomatis per toko ---------- */
function ttbJalankanToko_(cfg, data, cache) {
  var lap = { diperiksa: 0, terisiApi: 0, tersimpan: 0, kolomTerisi: 0, antre: 0, tersamar: 0, peringatan: [] };
  var sh = cfg.sheet, lr = sh.getLastRow();
  if (lr < 2) return lap;
  var mulai = Math.max(2, lr - 2000), lebar = cfg.lebar;
  var vals = sh.getRange(mulai, 1, lr - mulai + 1, lebar).getValues();
  var diminta = {};
  (data.daftar || []).forEach(function (x) { var k = String(x || '').trim(); if (k) diminta[k] = true; });
  var pakaiFilter = Object.keys(diminta).length > 0, batas = Date.now() - TTB_HARI_ * 86400000;
  var target = [], info = {};
  for (var i = vals.length - 1; i >= 0 && target.length < TTB_MAKS_PER_TOKO_; i--) {
    var r = vals[i], id = ttbIdSel_(r[0]);
    if (!id || info[id] || (pakaiFilter && !diminta[id])) continue;
    var st = String(r[4] || '').trim().toUpperCase();
    if (!pakaiFilter && TTB_STATUS_LEWATI_[st]) continue;
    if (!pakaiFilter && r[1] instanceof Date && r[1].getTime() < batas) continue;
    if (String(r[10] || '').trim() && String(r[11] || '').trim() && String(r[12] || '').trim()) continue;
    if (!pakaiFilter && cache.get('TTB_X_' + cfg.toko + '_' + id)) continue;
    var pk = cfg.kolPaket ? String(r[cfg.kolPaket - 1] || '').trim() : '';
    info[id] = { status: st, paket: pk && pk !== '-' ? pk : '', channel: cfg.toko === 'Conner' ? 'Conner Hardware' : (/TOKOPEDIA/i.test(String(r[16] || '')) ? 'Tokopedia' : 'TikTok Shop') };
    target.push(id);
  }
  lap.diperiksa = target.length;
  if (!target.length) return lap;
  var akhirPer = {}, jatahPaket = TTB_MAKS_PAKET_PER_JALAN_;
  for (var b = 0; b < target.length; b += 20) {
    var ids = target.slice(b, b + 20);
    var r1 = ttbApi_(cfg, 'get', '/order/202309/orders', { ids: ids.join(',') });
    if (!r1.ok) { lap.peringatan.push(cfg.label + ' order detail: ' + (r1.pesan || r1.http)); continue; }
    ((r1.json.data && r1.json.data.orders) || []).forEach(function (o) {
      var id = String(o.id), inf = info[id];
      if (!inf) return;
      if (o.status) inf.status = String(o.status).toUpperCase();
      if (!inf.paket && o.packages && o.packages[0] && o.packages[0].id) inf.paket = String(o.packages[0].id);
      akhirPer[id] = ttbGabung_({}, ttbEkstrakAlamat_(o.recipient_address), 'Get Order Detail');
    });
  }
  target.forEach(function (id) {
    var akhir = akhirPer[id] || (akhirPer[id] = {}), inf = info[id];
    if (!ttbLengkap_(akhir) && inf.paket && jatahPaket > 0) {
      jatahPaket--;
      var r2 = ttbApi_(cfg, 'get', '/fulfillment/202309/packages/' + encodeURIComponent(inf.paket), {});
      if (r2.ok) ttbGabung_(akhir, ttbMatriksUmum_(r2.json.data || {}), 'Get Package Detail');
    }
  });
  var simpan = [], antre = [];
  target.forEach(function (id) {
    var akhir = akhirPer[id], inf = info[id];
    if (akhir.nama || akhir.hp || akhir.alamat) { simpan.push(ttbHasilDariAkhir_(cfg, id, akhir, inf)); lap.terisiApi++; }
    if (!ttbLengkap_(akhir)) {
      lap.tersamar++;
      if (inf.paket && TTB_STATUS_LABEL_[inf.status]) antre.push({ id: id, paket: inf.paket });
      try { cache.put('TTB_X_' + cfg.toko + '_' + id, '1', /AWAITING_SHIPMENT|AWAITING_COLLECTION/.test(inf.status) ? 1800 : 21600); } catch (e) { }
    }
  });
  var s = ttbSimpanSemua_(cfg, simpan);
  lap.tersimpan = s.tersimpan; lap.kolomTerisi = s.terisi;
  lap.antre = ttbAntreTambah_(cfg, antre);
  return lap;
}
function prosesOtomatisPembeliTikTok(data) {
  data = data || {};
  try {
    if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var props = PropertiesService.getScriptProperties();
    if (data.dariSistem && String(props.getProperty('TTB_OFF') || '') === '1') return { success: true, dilewati: 'dimatikan (TTB_OFF)' };
    var cache = CacheService.getScriptCache();
    if (cache.get('TTB_JALAN')) return { success: true, sedangJalan: true };
    cache.put('TTB_JALAN', '1', 240);
    var laporan = {};
    try {
      ttbPastikanToken_();
      ['Waterground', 'Conner'].forEach(function (toko) {
        var cfg = ttbCfg_(toko);
        if (!cfg) { laporan[toko] = { dilewati: 'belum terhubung' }; return; }
        try { laporan[toko] = ttbJalankanToko_(cfg, data, cache); }
        catch (eT) { laporan[toko] = { error: String(eT && eT.message || eT) }; }
      });
    } finally { cache.remove('TTB_JALAN'); }
    try { props.setProperty('TTB_TERAKHIR', JSON.stringify({ t: Date.now(), laporan: laporan }).slice(0, 8000)); } catch (eP) { }
    var terisi = 0;
    Object.keys(laporan).forEach(function (k) { terisi += (laporan[k] && laporan[k].kolomTerisi) || 0; });
    return { success: true, laporan: laporan, terisi: terisi };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

/* ---------- antrean label: browser meminta PDF (langsung dari TikTok, tidak disimpan), membaca teksnya, lalu mengirim hasil ---------- */
function prosesTtbLabelAntrean(data) {
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var maks = Math.max(1, Math.min(4, parseInt(data.maks, 10) || 3));
    var pilih = [], sisa = 0, sh;
    var lock = kunciModul_('penjualan');
    if (!lock.tryLock(15000)) return { success: true, daftar: [], sibuk: true };
    try {
      sh = getTtbAntreSheet_();
      var a = ttbBacaSheet_(sh, TTB_ANTRE_HEADER_.length), kini = Date.now();
      for (var i = a.baris.length - 1; i >= 0; i--) {
        var r = a.baris[i];
        if (String(r[6]) !== 'Menunggu' || (Number(r[5]) || 0) >= TTB_ANTRE_MAKS_COBA_ || (Number(r[7]) || 0) > kini) continue;
        if (pilih.length >= maks) { sisa++; continue; }
        pilih.push({ kunci: String(r[0]), id: String(r[1]), toko: String(r[2]), paket: String(r[3]), baris: i + 2, coba: Number(r[5]) || 0 });
      }
      pilih.forEach(function (p) { sh.getRange(p.baris, 8).setValue(kini + TTB_ANTRE_PINJAM_MS_); });
      if (pilih.length) SpreadsheetApp.flush();
    } finally { lepasKunci_(lock); }
    if (!pilih.length) return { success: true, daftar: [], sisa: 0 };
    ttbPastikanToken_();
    var hasil = [], gagal = [];
    pilih.forEach(function (p) {
      var cfg = ttbCfg_(p.toko);
      if (!cfg) { gagal.push({ p: p, pesan: 'toko belum terhubung' }); return; }
      try { hasil.push({ kunci: p.kunci, id: p.id, toko: p.toko, pdf: lblPdfTikTok_(cfg, p.paket) }); }
      catch (e) { gagal.push({ p: p, pesan: String(e && e.message || e).slice(0, 180) }); }
    });
    if (gagal.length) {
      var lock2 = kunciModul_('penjualan');
      if (lock2.tryLock(15000)) {
        try {
          gagal.forEach(function (g) {
            var n = g.p.coba + 1;
            sh.getRange(g.p.baris, 6, 1, 4).setValues([[n, n >= TTB_ANTRE_MAKS_COBA_ ? 'Gagal' : 'Menunggu', Date.now() + 30 * 60000, 'Label: ' + g.pesan]]);
          });
          SpreadsheetApp.flush();
        } finally { lepasKunci_(lock2); }
      }
    }
    return { success: true, daftar: hasil, sisa: sisa, gagal: gagal.length };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}
// hasil = [{ kunci, nama, hp, alamat, gagal, catatan }]
function ttbBersihkanLabel_(x) {
  var d = {};
  var nama = shopeeTeksBersih_(x.nama), hp = ttbHp_(x.hp), alamat = shopeeTeksBersih_(x.alamat);
  if (nama && !ttbTersamar_(nama) && nama.length >= 2 && nama.length <= 80 && /[A-Za-z]/.test(nama)) d.nama = nama;
  if (hp.status === 'terisi') d.hp = hp.nilai;
  if (alamat && !ttbTersamar_(alamat) && alamat.length >= 10 && alamat.length <= 400) d.alamat = alamat;
  return d;
}
function prosesTtbLabelSimpan(data) {
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var daftar = (Array.isArray(data.hasil) ? data.hasil : []).slice(0, 20);
    var perToko = {}, statusAntre = {};
