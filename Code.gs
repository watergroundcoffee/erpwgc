/* ============================================================
   BUKU GUDANG VIRTUAL SHOPEE v2026.10.19 (Pengiriman Kilat > Buku Gudang Shopee)
   ------------------------------------------------------------
   Pengiriman Kilat = PINDAH GUDANG (bukan penjualan). Buku ini mencatat barang yang "dititip" di Gudang Shopee:
     Saldo awal + Dikirim - Terjual - Kembali = Sisa seharusnya (saldo berjalan, tidak harus 0 per hari)
   Nilai pakai HPP (Harga Supplier di Produk Master), estimasi nilai jual = Harga Shopee (info saja).
   Sumber SAMA dengan kilat_rekap: sheet Transfer Gudang Shopee (+Detail), status booking & order pembeli,
   scan retur. Tanggal: Dikirim = Tanggal Kirim, Terjual = tanggal pesanan pembeli (Pesanan Shopee),
   Kembali = tanggal scan retur / tanggal batal transfer. HANYA MEMBACA - alur scan Kilat tidak disentuh.
   ============================================================ */
function kbgTanggalOrderShopee_(perlu) {
  var peta = {}, tz = Session.getScriptTimeZone();
  if (!Object.keys(perlu).length) return peta;
  try {
    var sh = getPesananShopeeSheet(), lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 1, lr - 1, 2).getValues().forEach(function (r) {
      var n = typeof r[0] === 'number' ? kunciResi_(r[0]) : String(r[0] || '').trim();
      if (n && perlu[n] && r[1] instanceof Date) peta[n] = finTglStr_(r[1], tz);
    });
  } catch (e) { Logger.log('kbgTanggalOrderShopee_: ' + e); }
  return peta;
}
function kbgTanggalBatal_() {
  var peta = {}, tz = Session.getScriptTimeZone();
  try {
    var sh = tgsSheetStok_(), lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 1, lr - 1, 5).getValues().forEach(function (r) {
      if (String(r[2] || '').trim() !== 'Batal In-Transit' || !(r[0] instanceof Date)) return;
      var no = String(r[4] || '').trim();
      if (no && !peta[no]) peta[no] = finTglStr_(r[0], tz);
    });
  } catch (e) { Logger.log('kbgTanggalBatal_: ' + e); }
  return peta;
}

function kbgHitung_(data, bolehHarga) {
  var tz = Session.getScriptTimeZone();
  var hariIni = finTglStr_(new Date(), tz);
  var semuaWaktu = data.semua === true;
  var rg = semuaWaktu ? { dari: '2000-01-01', sampai: hariIni } : finRentangDariData_(data);
  tgsResetMemo_();
  var semua = tgsBacaSemua_(), master = kilatMasterProduk_(), petaRetur = kilatPetaRetur_();
  var statusOrder = kilatStatusOrderRingan_(semua, !!data.segar);
  var perluOrder = {};
  semua.forEach(function (t) { if (t.orderPembeli) perluOrder[String(t.orderPembeli).trim()] = true; });
  var tglOrder = kbgTanggalOrderShopee_(perluOrder), tglBatal = kbgTanggalBatal_();

  var nol = function () { return { qty: 0, hpp: 0, jual: 0 }; };
  var R = { awal: nol(), dikirim: nol(), terjual: nol(), kembali: nol(), akhir: nol(), sekarang: nol() };
  var perSku = {}, sisaBooking = [], tanpaHpp = {}, nBooking = 0, selisihTerima = 0;
  function tambah(o, q, h, j) { o.qty += q; o.hpp += q * h; o.jual += q * j; }
  function slot(sku, it, m) {
    var k = String(sku || '').toUpperCase();
    return perSku[k] || (perSku[k] = { sku: sku, nama: it.nama || m.nama || sku, foto: m.foto || '', hppSatuan: m.hpp || 0, hargaJual: m.hargaJual || 0,
      awal: 0, dikirim: 0, terjual: 0, kembali: 0, akhir: 0, sekarang: 0 });
  }

  semua.forEach(function (t) {
    var dikirim = t.stokDipotong || t.status === 'Dikirim' || t.status === 'Diterima' || (t.status === 'Batal' && t.msKirim > 0);
    if (!dikirim) return; // Draft / batal sebelum dikirim: stok tidak pernah pindah
    var msK = t.msKirim || t.msDibuat;
    if (!msK) return;
    nBooking++;
    var tK = finTglStr_(new Date(msK), tz);
    var akhir = tgsStatusAkhir_(t, statusOrder);
    var kr = t.noResi ? kunciResi_(t.noResi) : '';
    var dRetur = kr ? petaRetur[kr] : null;
    var nasib, tN = '';
    if (dRetur || t.status === 'Batal') { nasib = 'kembali'; tN = dRetur ? finTglStr_(dRetur, tz) : (tglBatal[t.noReservasi] || tK); }
    else if (akhir.kode === 'terjual' || akhir.kode === 'terjual-proses') { nasib = 'terjual'; tN = tglOrder[String(t.orderPembeli).trim()] || tK; }
    else nasib = 'sisa';
    if (tN && tN < tK) tN = tK;

    var qtyB = 0, hppB = 0, jualB = 0;
    t.item.forEach(function (it) {
      var q = it.qtyKirim || 0;
      if (!it.sku || !(q > 0)) return;
      var m = master[String(it.sku).toUpperCase()] || {};
      var h = m.hpp || 0, j = m.hargaJual || 0;
      if (!(h > 0)) tanpaHpp[String(it.sku).toUpperCase()] = it.sku;
      if (it.qtyDiterima !== null && it.qtyDiterima !== undefined && it.qtyDiterima < q) selisihTerima += q - it.qtyDiterima;
      var p = slot(it.sku, it, m);
      // Saldo awal (sebelum periode) & arus dalam periode
      if (tK < rg.dari) { tambah(R.awal, q, h, j); p.awal += q; }
      else if (tK <= rg.sampai) { tambah(R.dikirim, q, h, j); p.dikirim += q; }
      if (nasib !== 'sisa' && tN) {
        var ke = nasib === 'terjual' ? 'terjual' : 'kembali';
        if (tN < rg.dari) { tambah(R.awal, -q, h, j); p.awal -= q; }
        else if (tN <= rg.sampai) { tambah(R[ke], q, h, j); p[ke] += q; }
      }
      if (nasib === 'sisa') { tambah(R.sekarang, q, h, j); p.sekarang += q; qtyB += q; hppB += q * h; jualB += q * j; }
    });
    if (nasib === 'sisa' && qtyB > 0) sisaBooking.push({
      noReservasi: t.noReservasi, noResi: t.noResi || '', tanggalKirim: tK, umurHari: akhir.umurHari, kode: akhir.kode, statusAkhir: akhir.label,
      noPesananPembeli: t.orderPembeli || '', qty: qtyB, nilaiModal: Math.round(hppB), nilaiJual: Math.round(jualB),
      barang: t.item.filter(function (it) { return it.qtyKirim > 0; }).map(function (it) { return { sku: it.sku, qty: it.qtyKirim }; })
    });
  });

  ['qty', 'hpp', 'jual'].forEach(function (f) { R.akhir[f] = R.awal[f] + R.dikirim[f] - R.terjual[f] - R.kembali[f]; });
  var daftar = Object.keys(perSku).map(function (k) {
    var p = perSku[k];
    p.akhir = p.awal + p.dikirim - p.terjual - p.kembali;
    p.nilaiAkhir = Math.round(p.akhir * p.hppSatuan); p.nilaiSekarang = Math.round(p.sekarang * p.hppSatuan);
    return p;
  }).filter(function (p) { return p.awal || p.dikirim || p.terjual || p.kembali || p.akhir || p.sekarang; });
  daftar.sort(function (x, y) { return y.sekarang - x.sekarang || y.dikirim - x.dikirim || String(x.sku).localeCompare(String(y.sku)); });
  sisaBooking.sort(function (x, y) { return (y.umurHari || 0) - (x.umurHari || 0); });
  Object.keys(R).forEach(function (k) { R[k].hpp = Math.round(R[k].hpp); R[k].jual = Math.round(R[k].jual); });

  var out = {
    success: true, dari: semuaWaktu ? '' : rg.dari, sampai: rg.sampai, semua: semuaWaktu, bolehHarga: bolehHarga,
    ringkas: R, perSku: daftar, sisaBooking: sisaBooking.slice(0, 300), jumlahBooking: nBooking,
    lebih30Hari: sisaBooking.filter(function (b) { return (b.umurHari || 0) >= 30; }).length,
    selisihTerima: selisihTerima, tanpaHpp: Object.keys(tanpaHpp).map(function (k) { return tanpaHpp[k]; }).slice(0, 20), dibuatMs: Date.now()
  };
  if (!bolehHarga) {
    Object.keys(R).forEach(function (k) { R[k].hpp = null; R[k].jual = null; });
    daftar.forEach(function (p) { p.hppSatuan = null; p.hargaJual = null; p.nilaiAkhir = null; p.nilaiSekarang = null; });
    out.sisaBooking.forEach(function (b) { b.nilaiModal = null; b.nilaiJual = null; });
  }
  return out;
}

