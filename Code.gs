/* ---------- 2) SOFT DELETE ---------- */
function katApakahArsip_(nilai) { return String(nilai || '').trim().toLowerCase() === 'arsip'; }

// Peta SKU yang diarsipkan (1x baca per eksekusi). Dipakai pembaca Katalog untuk menyembunyikannya.
var KAT_MEMO_ARSIP_ = null;
function katPetaArsip_(toko) {
  if (KAT_MEMO_ARSIP_) return KAT_MEMO_ARSIP_;
  var peta = {};
  try {
    var sh = getMasterProdukSheet(toko);
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var sku = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      var status = sh.getRange(2, KAT_KOL_STATUS, lastRow - 1, 1).getValues();
      for (var i = 0; i < sku.length; i++) {
        var k = String(sku[i][0] || '').trim();
        if (k && katApakahArsip_(status[i][0])) peta[k] = true;
      }
    }
  } catch (e) { /* gagal baca = anggap tidak ada arsip (tampil semua), bukan error fatal */ }
  KAT_MEMO_ARSIP_ = peta;
  return peta;
}

// Arsipkan / pulihkan sekumpulan SKU: 1x baca + 1x setValues (kolom 30-31), di dalam lock.
function katUbahStatusArsip_(skuList, jadiArsip, keterangan, namaStaff, toko) {
  return katDenganLock_(function () {
    var sh = getMasterProdukSheet(toko);
    var lastRow = sh.getLastRow();
    if (lastRow < 2) throw new Error('Belum ada produk di Master Produk.');
    var target = {};
    skuList.forEach(function (x) { var k = String(x || '').trim(); if (k) target[k] = true; });
    var kolSku = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var blok = sh.getRange(2, KAT_KOL_STATUS, lastRow - 1, 2).getValues();
    var diubah = [], sudah = [];
    var cap = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm');
    for (var i = 0; i < kolSku.length; i++) {
      var k = String(kolSku[i][0] || '').trim();
      if (!target[k]) continue;
      var arsipSekarang = katApakahArsip_(blok[i][0]);
      if (arsipSekarang === jadiArsip) { sudah.push(k); delete target[k]; continue; }
      blok[i][0] = jadiArsip ? KAT_STATUS_ARSIP : 'Aktif';
      blok[i][1] = jadiArsip ? ('Diarsip ' + cap + ' oleh ' + (namaStaff || 'Sistem') + (keterangan ? ' - ' + keterangan : '')) : ('Dipulihkan ' + cap + ' oleh ' + (namaStaff || 'Sistem'));
      diubah.push(k);
      delete target[k];
    }
    if (diubah.length) sh.getRange(2, KAT_KOL_STATUS, blok.length, 2).setValues(blok);
    KAT_MEMO_ARSIP_ = null;
    return { diubah: diubah, sudah: sudah, tidakDitemukan: Object.keys(target) };
  });
}

// PENGGANTI hapus permanen: produk diARSIPkan (baris tetap ada, histori aman, bisa dipulihkan).
function prosesHapusProdukMassal(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuList = (data.skuList || []).map(function (s) { return String(s).trim(); }).filter(function (s) { return s; });
    if (!skuList.length) throw new Error('Nggak ada produk yang dipilih.');
    var r = katUbahStatusArsip_(skuList, true, String(data.alasan || '').trim(), getNamaStaff(data.email), data.toko);
    if (!r.diubah.length && !r.sudah.length) throw new Error('SKU yang dipilih nggak ketemu.');
    katInvalidasiCacheKatalog_(data.toko);
    result.success = true;
    result.jumlahBerhasil = r.diubah.length;
    result.sudahArsip = r.sudah;
    result.tidakDitemukan = r.tidakDitemukan;
  } catch (err) { result.error = String(err.message) === 'KAT_LOCK_SIBUK' ? 'Sistem sedang sibuk, coba lagi sebentar.' : err.toString(); }
  return result;
}

function prosesPulihkanProdukArsip(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuList = (data.skuList || []).map(function (s) { return String(s).trim(); }).filter(function (s) { return s; });
    if (!skuList.length) throw new Error('Nggak ada produk yang dipilih.');
    var r = katUbahStatusArsip_(skuList, false, '', getNamaStaff(data.email), data.toko);
    katInvalidasiCacheKatalog_(data.toko);
    result.success = true;
    result.jumlahBerhasil = r.diubah.length;
    result.tidakDitemukan = r.tidakDitemukan;
  } catch (err) { result.error = String(err.message) === 'KAT_LOCK_SIBUK' ? 'Sistem sedang sibuk, coba lagi sebentar.' : err.toString(); }
  return result;
}

// HAPUS KATEGORI (berkaskade): kategori dibuang dari sheet Kategori (tanpa deleteRow - blok ditulis
// ulang), lalu semua produk yang memakainya dikosongkan jadi "Tanpa Kategori" ('').
function prosesHapusKategori_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var nama = String(data.nama || '').trim();
    if (!nama) throw new Error('Nama kategori kosong.');
    var shKat = getKategoriProdukSheet();
    var lastRowKat = shKat.getLastRow();
    var lebar = Math.max(2, shKat.getLastColumn());
    var valsKat = lastRowKat > 1 ? shKat.getRange(2, 1, lastRowKat - 1, lebar).getValues() : [];
    var sisa = valsKat.filter(function (r) { return String(r[0] || '').trim() !== nama; });
    if (sisa.length === valsKat.length) throw new Error('Kategori "' + nama + '" tidak ditemukan (mungkin sudah dihapus).');
    if (sisa.length) shKat.getRange(2, 1, sisa.length, lebar).setValues(sisa);
    shKat.getRange(2 + sisa.length, 1, valsKat.length - sisa.length, lebar).clearContent();

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow(), jumlah = 0;
    if (lastRow > 1) {
      var rangeKat = sh.getRange(2, 8, lastRow - 1, 1);
      var kolKat = rangeKat.getValues();
      kolKat.forEach(function (r) { if (String(r[0] || '').trim() === nama) { r[0] = ''; jumlah++; } });
      if (jumlah) rangeKat.setValues(kolKat);
    }
    SpreadsheetApp.flush();
    katInvalidasiCacheKatalog_(data.toko);
    result.success = true;
    result.jumlahProdukDiupdate = jumlah;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}
function prosesHapusKategori(data) { return katJalankanTerkunci_(prosesHapusKategori_inti_, data); }

// Hapus 1 link SKU Terhubung - baris dicari ULANG di dalam lock berdasarkan isinya
// (SKU Jual + kode). Nomor baris dari klien hanya dipakai kalau isinya masih cocok.
function katHapusLinkTerverifikasi_(sh, data, labelKode, namaKode) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuJual = String(data.skuJual || '').trim();
    var kode = String(data[namaKode] || '').trim();
    var rowKlien = parseInt(data.row, 10);
    if (!(skuJual && kode) && !(rowKlien >= 2)) throw new Error('Data link tidak lengkap.');
    katDenganLock_(function () {
      var lastRow = sh.getLastRow();
      if (lastRow < 2) throw new Error('Link sudah tidak ada.');
      var vals = sh.getRange(2, 1, lastRow - 1, 2).getValues();
      var cocok = function (r) { return String(r[0]).trim() === skuJual && katPecahKode_(r[1]).indexOf(kode) !== -1; };
      var idx = -1;
      if (skuJual && kode) {
        if (rowKlien >= 2 && rowKlien - 2 < vals.length && cocok(vals[rowKlien - 2])) idx = rowKlien - 2;
        else for (var i = 0; i < vals.length; i++) if (cocok(vals[i])) { idx = i; break; }
        if (idx === -1) throw new Error(labelKode + ' "' + kode + '" untuk ' + skuJual + ' sudah tidak ada (mungkin sudah dihapus). Muat ulang halaman.');
        var kodeLain = katPecahKode_(vals[idx][1]).filter(function (k) { return k !== kode; });
        if (kodeLain.length) { sh.getRange(idx + 2, 2).setValue(kodeLain.join(' ')); return; }
      } else {
        // Pemanggil lama (hanya nomor baris): tetap jalan, tapi baris wajib masih berisi data.
        idx = rowKlien - 2;
        if (idx >= vals.length || !String(vals[idx][0]).trim()) throw new Error('Baris link sudah berubah. Muat ulang halaman lalu coba lagi.');
      }
      sh.deleteRow(idx + 2); // sheet link (bukan Master/Kategori); aman karena dicari ulang di dalam lock
    });
    result.success = true;
  } catch (err) { result.error = String(err.message) === 'KAT_LOCK_SIBUK' ? 'Sistem sedang sibuk, coba lagi sebentar.' : err.toString(); }
  return result;
}
function prosesHapusSkuMarketplaceTerhubung(data) { return katHapusLinkTerverifikasi_(getSkuMarketplaceTerhubungSheet(), data, 'SKU Marketplace', 'skuMarketplace'); }
function prosesHapusSkuSupplierTerhubung(data) { return katHapusLinkTerverifikasi_(getSkuSupplierTerhubungSheet(), data, 'SKU Supplier', 'skuSupplier'); }

/* ---------- 3) VALIDASI FOTO ---------- */
var KAT_PESAN_FOTO_WEB = 'Harap upload file, bukan drag-and-drop dari web lain.';
function katValidasiUrlFoto_(url, label) {
  var u = String(url == null ? '' : url).trim();
  if (!u) return '';
  var nama = label ? 'Foto ' + label + ': ' : '';
  if (/^data:/i.test(u) || /^blob:/i.test(u)) throw new Error(nama + KAT_PESAN_FOTO_WEB);
  if (!/^https:\/\/[^\s"'<>]+$/i.test(u)) throw new Error(nama + 'alamat foto tidak valid - harus diawali https://. ' + KAT_PESAN_FOTO_WEB);
  if (u.length > 2000) throw new Error(nama + 'alamat foto terlalu panjang. ' + KAT_PESAN_FOTO_WEB);
  return u;
}
function katValidasiGaleriFoto_(galeri) {
  var arr = Array.isArray(galeri) ? galeri : [];
  if (arr.length > 9) throw new Error('Maksimal 10 foto per produk (1 utama + 9 galeri).'); // v2026.10.98 (DN-713)
  return arr.map(function (u, i) { return katValidasiUrlFoto_(u, 'ke-' + (i + 2)); }).filter(function (u) { return u; });
}
function katValidasiUkuranBase64_(base64) {
  var perkiraanByte = Math.floor(String(base64 || '').length * 3 / 4);
  if (perkiraanByte > KAT_MAKS_FOTO_BYTES) throw new Error('Ukuran foto terlalu besar (' + (perkiraanByte / 1048576).toFixed(1) + ' MB, maks 10 MB). Perkecil/kompres fotonya dulu.');
}

/* ---------- 4) PENGAMAN HARGA ---------- */
function katFmtRp_(n) {
  var v = Math.round(Number(n) || 0);
  return 'Rp ' + String(v).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}
// null = aman; string = pesan penolakan
function katPesanHppMelebihiHarga_(sku, hpp, hargaJual) {
  var h = Number(hpp) || 0, j = Number(hargaJual) || 0;
  if (h <= 0) return null;
  if (j <= 0 && !KAT_TOLAK_HPP_JIKA_HARGA_KOSONG) return null;
  if (h >= j) return 'Gagal: Harga Modal [' + katFmtRp_(h) + '] lebih besar/sama dengan Harga Jual [' + katFmtRp_(j) + '] untuk SKU ' + sku + '. Sesuaikan harga jual terlebih dahulu.';
  return null;
}
function katCekHppVsHarga_(sku, hpp, hargaJual) {
  var pesan = katPesanHppMelebihiHarga_(sku, hpp, hargaJual);
  if (pesan) throw new Error(pesan);
}


// Monitor/Rekon: produk ARSIP hanya ditampilkan kalau masih ada stok / reserve / order (perlu dibereskan)
function smPerluTampil_(p) {
  if (p.arsip) return p.onHand !== 0 || p.onReserve > 0 || p.onOrder > 0;
  return p.terdaftar || p.adaAktivitas;
}


/* ####################################################################################
   SYNC HARGA KE MARKETPLACE (Shopee & TikTok Shop)
   Aturan yang DIKUNCI di sini:
   (a) Yang dikirim ke endpoint harga dasar = HARGA CORET (Harga Normal / original_price), dibaca
       dari Master Produk. Harga Jual Final TIDAK PERNAH dikirim (diskon diurus API Promosi terpisah).
   (b) Identitas produk di marketplace diambil dari "SKU Marketplace Terhubung" per platform.
       SKU Gudang TIDAK PERNAH dipakai sebagai pengganti. Tidak ada SKU terhubung = channel dibatalkan.
   (c) FAIL-SAFE: HPP / Harga Jual / Harga Coret <= 0 atau < Rp 100 -> sync digagalkan, dicek ulang
       tepat sebelum UrlFetchApp (penjaga gawang terakhir).
   Mode default DRY_RUN: request disusun lengkap (URL, header, body) lalu HANYA di-log (Logger + sheet
   "Log Sync Harga"). Setelah token & endpoint diverifikasi, set Script Property SYNC_HARGA_MODE = LIVE.
   #################################################################################### */
var SYNC_HARGA_MIN_WAJAR = 100;            // di bawah Rp 100 dianggap tidak wajar -> tolak
var SYNC_HARGA_MAKS_ITEM = 200;            // per 1 klik Sync
var SYNC_HARGA_PESAN_FATAL = 'FATAL: HPP atau Harga Jual bernilai 0. API Sync digagalkan untuk mencegah kerugian toko.';
var SYNC_HARGA_CHANNEL = [
  // kolom Master Produk: final = Harga Jual Final (info/validasi), coret = Harga Coret (yang DIKIRIM)
  { platform: 'Shopee', label: 'Shopee', kolFinal: 7, kolCoret: 28, paramKlien: 'hargaShopee' },
  { platform: 'TikTok Shop', label: 'TikTok Shop', kolFinal: 25, kolCoret: 29, paramKlien: 'hargaTiktok' }
];

function getSyncHargaMode_() {
  // Sumber tunggal = konstanta SYNC_HARGA_MODE di atas file (Script Property lama diabaikan).
  return String(SYNC_HARGA_MODE || '').toUpperCase().replace(/[\s_-]/g, '') === 'LIVE' ? 'LIVE' : 'DRY_RUN';
}
function getLogSyncHargaSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Log Sync Harga');
  if (!sh) {
    sh = ss.insertSheet('Log Sync Harga');
    sh.getRange(1, 1, 1, 10).setValues([['Waktu', 'SKU Gudang', 'Channel', 'SKU Marketplace (dikirim)', 'Mode', 'Harga Coret dikirim (original_price)', 'Harga Jual Final (TIDAK dikirim)', 'Status', 'Pesan', 'Request (JSON)']]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

// PENJAGA GAWANG TERAKHIR - dipanggil tepat sebelum UrlFetchApp (dan juga di awal proses).
function syncGerbangHarga_(hpp, hargaFinal, hargaCoret) {
  var angka = [hpp, hargaFinal, hargaCoret].map(function (v) { return Number(v); });
  var semuaWajar = angka.every(function (n) { return isFinite(n) && n >= SYNC_HARGA_MIN_WAJAR; });
  if (!semuaWajar) throw new Error(SYNC_HARGA_PESAN_FATAL);
}

/* ---------- Fungsi utama: ONE-TO-MANY + error independen per listing ----------
   1 SKU Gudang bisa terhubung ke BANYAK listing (duplikat listing) per marketplace. Setiap listing
   ditembak sendiri-sendiri dengan try-catch independen: 1 listing gagal (misal sudah dihapus di Shopee)
   TIDAK menghentikan listing lainnya. Hasil per listing dikumpulkan & dikembalikan ke frontend.
   hargaShopee / hargaTikTok = Harga Coret yang TERLIHAT di layar (pembanding saja). Payload SELALU
   memakai Harga Coret dari sheet - Harga Jual Final tidak pernah dikirim. */
var SYNC_HARGA_BATAS_WAKTU_MS = 280000; // sisakan ruang dari batas 6 menit Apps Script


// KUNCI HARGA CORET: payload yang akan ditembak diperiksa - harga di dalamnya WAJIB = Harga Coret.
// Kalau (karena bug apa pun) yang masuk adalah Harga Jual Final atau angka lain, tembakan dibatalkan.
function syncPastikanHargaCoretDiPayload_(req, hargaCoret, hargaFinal) {
  var harga;
  if (req.platform === 'Shopee') harga = Number(req.body && req.body.price_list && req.body.price_list[0] && req.body.price_list[0].original_price);
  else harga = Number(req.body && req.body.skus && req.body.skus[0] && req.body.skus[0].price && req.body.skus[0].price.amount);
  if (harga !== Math.round(hargaCoret)) throw new Error('DIBATALKAN: harga di payload (' + harga + ') bukan Harga Coret (' + Math.round(hargaCoret) + ').');
  if (hargaCoret !== hargaFinal && harga === Math.round(hargaFinal)) throw new Error('DIBATALKAN: payload berisi Harga Jual Final - hanya Harga Coret yang boleh dikirim.');
}
// SKU Marketplace Terhubung milik 1 SKU Gudang -> { platform: [kode1, kode2, ...] }
// Pemisah yang dikenali: koma, titik koma, baris baru, DAN spasi (format lama Edit Massal/Hubungkan
// menyimpan beberapa kode dipisah spasi; SKU sendiri tidak pernah berisi spasi). Duplikat dibuang.
// ID marketplace harus digit murni. "1.72938E+18" / "1729384756102938000" hasil pembulatan Sheets
var SYNC_ID_MEMO_ = {};          // 'Shopee|SKU' -> hasil; dibuang tiap eksekusi baru
var SYNC_ID_LOKAL_MEMO_ = null;  // isi sheet lokal (1x baca per eksekusi)
function syncPetaIdLokal_() {
  if (SYNC_ID_LOKAL_MEMO_) return SYNC_ID_LOKAL_MEMO_;
  var peta = { 'TikTok Shop': {} };
  try {
    var shT = getProdukTikTokShopSheet(), lrT = shT.getLastRow();
    if (lrT > 1) shT.getRange(2, 1, lrT - 1, 3).getDisplayValues().forEach(function (r) {
      var k = String(r[0] || '').trim();
      if (!k || !syncIdValid_(r[1]) || !syncIdValid_(r[2])) return;
      // 1 seller_sku bisa dipakai BEBERAPA listing (duplikat). Dulu baris terakhir menimpa yang lain -> hanya 1 listing
      // yang ter-update. Sekarang SEMUA listing disimpan sebagai daftar dan SEMUA dikirimi harga.
      var daftarId = peta['TikTok Shop'][k] = peta['TikTok Shop'][k] || [];
      var pid = String(r[1]).trim(), sid = String(r[2]).trim();
      if (!daftarId.some(function (x) { return x.productId === pid && x.skuId === sid; })) daftarId.push({ productId: pid, skuId: sid });
    });
  } catch (eT) { }
  SYNC_ID_LOKAL_MEMO_ = peta;
  return peta;
}

// tidak bisa dibedakan 100%, tapi notasi ilmiah & sel non-digit PASTI rusak -> dianggap tidak ada.
function syncIdValid_(v) { return /^\d{5,25}$/.test(String(v == null ? '' : v).trim()); }

function syncKredensialTersedia_(platform) {
  // Lookup on-the-fly HANYA untuk TikTok Shop. (Shopee tidak pernah memanggil fungsi ini.)
  if (platform !== 'TikTok Shop') return false;
  try {
    var props = PropertiesService.getScriptProperties();
    return getTiktokAppKey().indexOf('PASTE_') !== 0 && !!props.getProperty('TIKTOK_ACCESS_TOKEN') && !!props.getProperty('TIKTOK_SHOP_CIPHER');
  } catch (e) { return false; }
}
// Pintu tunggal pencarian ID untuk 1 SKU Marketplace. Melempar Error HANYA kalau SKU tidak ada / ambigu
// di marketplace, atau API benar-benar tidak bisa dihubungi (pesan dibedakan).
function syncResolveId_(platform, skuMp) {
  if (platform !== 'TikTok Shop') throw new Error('Lookup ID on-the-fly hanya untuk TikTok Shop.');
  var kunci = platform + '|' + skuMp;
  if (SYNC_ID_MEMO_[kunci]) return SYNC_ID_MEMO_[kunci];

  // 1-2) cache lokal (sheet "Produk TikTok Shop")
  var lokal = syncPetaIdLokal_()[platform][skuMp];
  if (lokal && lokal.length) return (SYNC_ID_MEMO_[kunci] = Object.assign({ sumber: 'lokal', semua: lokal.slice() }, lokal[0]));

  // 3) Tidak ada di lokal -> cari ke TikTok
  var hasil = fetchMarketplaceID(platform, skuMp);
  if (hasil.simulasi) return (SYNC_ID_MEMO_[kunci] = hasil); // token belum ada: lanjut dengan ID placeholder, tidak disimpan
  if (!hasil.ditemukan) throw (/AMBIGU/i.test(hasil.alasan) ? new Error(hasil.alasan)
    : syncErrorDilewati_('SKU "' + skuMp + '" tidak ditemukan / tidak aktif di TikTok Shop - dilewati.'));

  syncSimpanIdKeLokal_(platform, skuMp, hasil);
  hasil.sumber = 'api';
  return (SYNC_ID_MEMO_[kunci] = hasil);
}
/* ---------- fetchMarketplaceID(platform, skuMarketplace) ----------
   Return:
     { ditemukan: true,  itemId, modelId, nama }            (Shopee)
     { ditemukan: true,  productId, skuId, nama }           (TikTok Shop)
     { ditemukan: false, alasan }                           SKU fiktif / dihapus / ambigu
     { simulasi: true, ...ID placeholder, requestLookup }   token belum terpasang (dry-run lookup)
   Error jaringan / token ditolak -> di-throw dengan pesan "Lookup ... gagal menghubungi API" (BUKAN dianggap fiktif). */
function fetchMarketplaceID(platform, skuMarketplace) {
  var sku = String(skuMarketplace || '').trim();
  if (platform !== 'TikTok Shop') throw new Error('fetchMarketplaceID hanya untuk TikTok Shop (platform "' + platform + '" tidak memakai lookup on-the-fly).');
  if (!sku) return { ditemukan: false, alasan: 'SKU marketplace kosong.' };
  return syncLookupTiktok_(sku);
}
/* Shopee (read-only):
   a) GET /api/v2/product/search_item?item_sku=...      -> kandidat item_id
   b) GET /api/v2/product/get_item_base_info?item_id_list=... -> item_sku, has_model, nama (verifikasi PERSIS)
   c) GET /api/v2/product/get_model_list?item_id=...     -> model_id yang model_sku-nya PERSIS sama (produk bervarian) */

/* TikTok Shop (read-only): POST /product/202309/products/search?page_size=20  body { seller_skus: [sku] }
   -> cari SKU yang seller_sku-nya PERSIS sama -> product_id + sku_id */
function syncLookupTiktok_(sku) {
  var tersedia = syncKredensialTersedia_('TikTok Shop');
  var props = PropertiesService.getScriptProperties();
  var path = '/product/202309/products/search';
  var body = JSON.stringify({ seller_skus: [sku] });
  var q = { app_key: getTiktokAppKey(), shop_cipher: props.getProperty('TIKTOK_SHOP_CIPHER') || '<SHOP_CIPHER>', timestamp: String(Math.floor(Date.now() / 1000)), version: '202309', page_size: '20' };
  var sign = '<SIGN>';
  if (tersedia) { try { sign = buatSignatureTikTok(path, q, body); } catch (eSign) { } }
  var req = {
    url: 'https://open-api.tiktokglobalshop.com' + path + '?app_key=' + encodeURIComponent(q.app_key) + '&shop_cipher=' + encodeURIComponent(q.shop_cipher) +
      '&timestamp=' + q.timestamp + '&version=' + q.version + '&page_size=' + q.page_size + '&sign=' + sign,
    options: { method: 'post', contentType: 'application/json', headers: { 'x-tts-access-token': props.getProperty('TIKTOK_ACCESS_TOKEN') || '<ACCESS_TOKEN>' }, payload: body, muteHttpExceptions: true },
    body: JSON.parse(body)
  };
  if (!tersedia) {
    syncLogLookup_('TikTok Shop', sku, 'SIMULASI', 'Token TikTok belum terpasang - request lookup hanya di-log', req);
    return { simulasi: true, ditemukan: true, productId: '<product_id dari lookup "' + sku + '">', skuId: '<sku_id dari lookup "' + sku + '">', nama: '', requestLookup: syncAmankanUrl_(req.url) };
  }
  try {
    var json = syncFetchJson_(req, 'TikTok products/search');
    var produk = (json.data && json.data.products) || [];
    var cocok = [];
    produk.forEach(function (p) {
      if (/DELETE|DRAFT/i.test(String(p.status || ''))) return; // listing terhapus / draft tidak bisa di-update
      (p.skus || []).forEach(function (s) {
        if (String(s.seller_sku || '').trim() === sku) cocok.push({ productId: String(p.id), skuId: String(s.id), nama: p.title || '', status: String(p.status || ''), harga: (s.price && (s.price.sale_price || s.price.original_price)) || '' });
      });
    });
    if (!cocok.length) return syncTidakDitemukan_('TikTok Shop', sku, 'tidak ada produk dengan seller_sku ini');
    // seller_sku DUPLIKAT (listing kembar) -> SEMUA listing dikembalikan & SEMUA ikut di-update (tidak lagi ditolak AMBIGU)
    syncLogLookup_('TikTok Shop', sku, 'DITEMUKAN', cocok.map(function (c) { return 'product_id ' + c.productId + ' / sku_id ' + c.skuId; }).join(' | ') +
      (cocok.length > 1 ? ' (' + cocok.length + ' listing duplikat - semua di-update)' : ''), req);
    return Object.assign({ ditemukan: true, semua: cocok }, cocok[0]);
  } catch (err) {
    syncLogLookup_('TikTok Shop', sku, 'ERROR API', String(err.message || err), req);
    throw new Error('Lookup ID TikTok untuk "' + sku + '" gagal menghubungi API: ' + (err.message || err) + ' (listing BELUM tentu fiktif - coba lagi).');
  }
}

function syncTidakDitemukan_(platform, sku, detail) {
  var alasan = 'SKU ' + platform + ' "' + sku + '" tidak ditemukan di marketplace (' + detail + '). Kemungkinan fiktif/dihapus permanen - periksa SKU Terhubung.';
  syncLogLookup_(platform, sku, 'TIDAK DITEMUKAN', alasan, null);
  return { ditemukan: false, alasan: alasan };
}


/* v2026.10.33 (Paket 17, DN-261015-153546-121): cek apakah SKU Marketplace yang diketik BENAR-BENAR ada di marketplace.
   Hanya membaca (read-only). { platform, sku } -> { status: 'ada' | 'tidak_ada' | 'gagal' | 'lewati', pesan, nama, jumlah } */
function prosesCekSkuMarketplace(data) {
  try {
    if (!cekIzin(data.email, 'buatInvoice') && !cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var platform = String(data.platform || '').trim(), sku = String(data.sku || '').trim();
    if (!sku) return { success: true, status: 'lewati', pesan: 'SKU kosong.' };
    if (platform === 'Website' || !platform) return { success: true, status: 'lewati', pesan: 'Website tidak perlu dicek ke marketplace.' };
    var cache = CacheService.getScriptCache(), kunci = 'CEKSKU_' + Utilities.base64EncodeWebSafe(platform + '|' + sku).slice(0, 200);
    var ada = cache.get(kunci);
    if (ada && !data.segar) return JSON.parse(ada);
    var hasil;
    if (platform === 'Shopee') {
      try {
        var semua = syncResolveIdShopeeSemua_(sku, !!data.segar);
        hasil = { success: true, status: 'ada', jumlah: semua.length, pesan: 'Ditemukan di Shopee' + (semua.length > 1 ? ' (' + semua.length + ' listing)' : '') + '.' };
      } catch (e) {
        hasil = e && e.dilewati ? { success: true, status: 'tidak_ada', pesan: 'Tidak ditemukan / tidak aktif di Shopee. Periksa ejaan SKU (huruf besar-kecil & spasi) di Seller Centre.' }
          : { success: true, status: 'gagal', pesan: 'Belum bisa dicek ke Shopee: ' + (e.message || e) };
      }
    } else if (platform === 'TikTok Shop' || platform === 'Tokopedia') {
      if (!syncKredensialTersedia_('TikTok Shop')) return { success: true, status: 'gagal', pesan: 'Token TikTok Shop belum terpasang - SKU belum bisa dicek.' };
      try {
        var r = syncLookupTiktok_(sku);
        hasil = r && r.ditemukan && !r.simulasi
          ? { success: true, status: 'ada', nama: r.nama || '', jumlah: (r.semua || [r]).length, pesan: 'Ditemukan di ' + (platform === 'Tokopedia' ? 'katalog TikTok Shop / Tokopedia' : 'TikTok Shop') + (r.nama ? ': ' + r.nama : '') + '.' }
          : { success: true, status: 'tidak_ada', pesan: 'Tidak ditemukan di ' + (platform === 'Tokopedia' ? 'katalog TikTok Shop / Tokopedia' : 'TikTok Shop') + ' (listing terhapus / draft tidak dihitung). Periksa ejaan SKU penjual.' };
      } catch (e2) { hasil = { success: true, status: 'gagal', pesan: 'Belum bisa dicek ke TikTok Shop: ' + (e2.message || e2) }; }
    } else return { success: true, status: 'lewati', pesan: 'Platform ' + platform + ' tidak dicek.' };
    if (hasil.status !== 'gagal') cache.put(kunci, JSON.stringify(hasil), 600);
    return hasil;
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

// Listing yang memang tidak ada / tidak aktif di marketplace -> DILEWATI (bukan kegagalan)
function syncErrorDilewati_(pesan) { var e = new Error(pesan); e.dilewati = true; return e; }

// Terjemahkan pesan penolakan marketplace ke alasan yang jelas (pesan asli tetap disertakan di UI)
function syncTerjemahkanAlasan_(pesan) {
  var p = String(pesan || '');
  var aturan = [
    [/promo|promotion|flash|campaign|discount|bundle|voucher|add.?on|sedang ikut/i, 'Produk sedang ikut promosi / flash sale - harga dasar dikunci sampai promosi selesai'],
    [/access.?token|token.*(expire|invalid)|expired|105002|106001|invalid_access_token|error_auth|belum tersedia/i, 'Token toko kedaluwarsa / tidak valid - hubungkan ulang toko di Pengaturan'],
    [/sign/i, 'Tanda tangan API ditolak - periksa App Key / Partner Key di Pengaturan'],
    [/too many|frequen|rate.?limit|limit exceed|throttl|HTTP 429|36009004/i, 'Terlalu banyak permintaan ke API - tunggu beberapa menit lalu coba lagi'],
    [/price.*(range|limit|min|max|exceed|too (high|low)|invalid)|harga.*(batas|terlalu)|original_price/i, 'Harga di luar batas yang diizinkan marketplace (terlalu tinggi / rendah dibanding harga sebelumnya)'],
    [/model.?id.*not.?found|model_not_exist|invalid.?model/i, 'model_id varian tidak cocok / varian sudah dihapus - jalankan CHECK_SKU_MAPPING'],
    [/not.?exist|not.?found|deleted|item_not_found|no such/i, 'Listing tidak ada / sudah dihapus di marketplace'],
    [/banned|unlist|inactive|frozen|review|audit|suspend|status/i, 'Listing tidak aktif (diturunkan / diblokir / sedang ditinjau)'],
    [/AMBIGU/i, 'SKU dipakai lebih dari 1 listing - buat SKU unik di Seller Center'],
    [/permission|forbidden|HTTP 403|scope/i, 'Aplikasi belum punya izin mengubah harga - aktifkan izin Product di Partner Center'],
    [/timeout|timed out|Address unavailable|DNS|gagal menghubungi/i, 'Server marketplace tidak merespons - coba lagi']
  ];
  for (var i = 0; i < aturan.length; i++) if (aturan[i][0].test(p)) return aturan[i][1];
  return '';
}

// UrlFetchApp + validasi respons. Error Shopee ada di json.error, TikTok di json.code != 0.
function syncFetchJson_(req, label) {
  var res = UrlFetchApp.fetch(req.url, req.options);
  var kode = res.getResponseCode();
  var teks = res.getContentText() || '';
  var json;
  try { json = JSON.parse(teks); } catch (e) { throw new Error(label + ': respons bukan JSON (HTTP ' + kode + ')'); }
  if (kode !== 200) throw new Error(label + ': HTTP ' + kode + ' - ' + (json.message || json.error || teks.substring(0, 150)));
  if (json.error) throw new Error(label + ': ' + json.error + ' - ' + (json.message || ''));
  if (json.code !== undefined && json.code !== 0) throw new Error(label + ': kode ' + json.code + ' - ' + (json.message || ''));
  return json;
}

// Tulis ID hasil lookup ke sheet lokal. Di dalam lock + cek ulang -> tidak ada baris dobel.
function syncSimpanIdKeLokal_(platform, sku, h) {
  if (platform !== 'TikTok Shop') return;
  var daftar = (h && h.semua && h.semua.length) ? h.semua : [h];
  try {
    katDenganLock_(function () {
      var waktu = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm');
      var sh = getProdukTikTokShopSheet();
      var lastRow = sh.getLastRow(), barisSku = [];
      // Cek ulang DI DALAM lock: baris lama SKU ini ditimpa (berurutan), kelebihan dihapus, kekurangan ditambah
      if (lastRow > 1) {
        var kol = sh.getRange(2, 1, lastRow - 1, 1).getDisplayValues();
        for (var i = 0; i < kol.length; i++) if (String(kol[i][0]).trim() === sku) barisSku.push(i + 2);
      }
      var isi = daftar.map(function (x) { return [sku, String(x.productId), String(x.skuId), x.nama || (h && h.nama) || '-', '', waktu, x.harga || '']; });
      for (var j = 0; j < isi.length; j++) {
        var target = j < barisSku.length ? barisSku[j] : sh.getLastRow() + 1;
        sh.getRange(target, 1, 1, 3).setNumberFormat('@'); // ID 19 digit tetap TEKS
        sh.getRange(target, 1, 1, isi[j].length).setValues([isi[j]]);
      }
      for (var d = barisSku.length - 1; d >= isi.length; d--) sh.deleteRow(barisSku[d]); // dari bawah -> nomor baris lain aman
    });
    SYNC_ID_LOKAL_MEMO_ = null;
  } catch (e) {
    Logger.log('Gagal menyimpan ID TikTok "' + sku + '" ke sheet lokal: ' + e); // ID sudah didapat -> update harga tetap jalan
  }
}
function syncAmankanUrl_(url) { return String(url || '').replace(/(access_token=)[^&]+/, '$1***'); }

function syncLogLookup_(platform, sku, status, pesan, req) {
  try {
    getLogSyncHargaSheet_().appendRow([new Date(), '-', platform + ' (LOOKUP ID)', sku, 'LOOKUP', '', '', status, pesan,
      req ? JSON.stringify({ url: syncAmankanUrl_(req.url), method: req.options.method, body: req.body || null }).substring(0, 45000) : '']);
  } catch (e) { }
