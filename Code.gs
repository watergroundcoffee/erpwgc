        if (tgl > hariIni) { laporan.error.push(label + ': tanggal di masa depan'); return; }
        if (tgl < '2015-01-01') { laporan.error.push(label + ': tanggal terlalu lama'); return; }
        var nama = String(inv.nama || '').trim();
        if (!nama) { laporan.error.push(label + ': nama pembeli kosong'); return; }
        var items = (inv.items || []).map(function (it) {
          return { sku: String(it.sku || '').trim(), nama: String(it.nama || '').trim() || String(it.sku || '').trim(), qty: Math.round(parseFloat(it.qty) || 0), harga: Math.round(parseFloat(it.harga) || 0) };
        }).filter(function (it) { return it.nama && it.qty > 0; });
