/* ---------- TASK CENTER: lihat_ai_task_center { versi? } ---------- */
function aiwPlatformDari_(teks) {
  var t = String(teks || '').toLowerCase();
  if (/tiktok/.test(t)) return 'TikTok Shop';
  if (/tokopedia/.test(t)) return 'Tokopedia';
