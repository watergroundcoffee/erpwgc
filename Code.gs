// Tarik SEMUA listing Conner (berhalaman) -> sheet "Produk Conner". Kolom "Stok Terkirim Terakhir" dipertahankan.
function prosesConnerTarikProduk(data) {
  var result = { success: false };
  if (!cekIzin(data.email, 'mintaStock')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; }
  var mutex = kunciSinkronAmbil_('PRODUK_CONNER', 300);
  if (!mutex) { result.error = 'Penarikan listing Conner sedang berjalan di proses lain. Tunggu 1-2 menit.'; return result; }
  try {
    var mulai = Date.now(), token = '', halaman = 0, baris = [], totalProduk = 0, berhenti = '';
    var tz = Session.getScriptTimeZone(), sekarang = Utilities.formatDate(new Date(), tz, 'dd MMM yyyy HH:mm');
    do {
      var d = cnApi_('post', '/product/202309/products/search', { page_size: 100, page_token: token }, {}, { target: 'tarik listing hal ' + (halaman + 1) });
      (d.products || []).forEach(function (p) {
        var st = String(p.status || '').toUpperCase();
        if (/DELETED|DRAFT/.test(st)) return;
        totalProduk++;
        (p.skus || []).forEach(function (s) {
          var inv = s.inventory || [], qty = 0, wh = '';
          inv.forEach(function (x) { qty += parseInt(x.quantity, 10) || 0; if (!wh && x.warehouse_id) wh = String(x.warehouse_id); });
          var varian = (s.sales_attributes || []).map(function (a) { return a.value_name || a.name || ''; }).filter(function (x) { return x; }).join(' / ');
          var harga = s.price ? (parseFloat(s.price.sale_price || s.price.tax_exclusive_price || s.price.original_price) || 0) : 0;
          baris.push([String(p.id), String(s.id), String(s.seller_sku || '').trim(), p.title || '-', varian, st || '-', wh, qty, harga, sekarang, '', '']);
        });
      });
      token = d.next_page_token || '';
      halaman++;
      if (halaman >= CN_MAKS_HALAMAN_PRODUK_ && token) { berhenti = 'Dibatasi ' + CN_MAKS_HALAMAN_PRODUK_ + ' halaman (' + baris.length + ' SKU).'; break; }
      if (Date.now() - mulai > 240000 && token) { berhenti = 'Dihentikan karena batas waktu Apps Script - sebagian listing sudah tersimpan.'; break; }
    } while (token);

    denganKunciTulis_(function () {
      var sh = cnSheetProduk_(), lr = sh.getLastRow(), lama = {};
      if (lr > 1) sh.getRange(2, 1, lr - 1, CN_KOLOM_PRODUK_.length).getValues().forEach(function (r) { lama[String(r[1])] = [r[10], r[11]]; });
      baris.forEach(function (b) { var l = lama[b[1]]; if (l) { b[10] = l[0]; b[11] = l[1]; } });
      if (lr > 1) sh.getRange(2, 1, lr - 1, CN_KOLOM_PRODUK_.length).clearContent();
      if (baris.length) {
        sh.getRange(2, 1, baris.length, 3).setNumberFormat('@');
        sh.getRange(2, 7, baris.length, 1).setNumberFormat('@');
        sh.getRange(2, 1, baris.length, CN_KOLOM_PRODUK_.length).setValues(baris);
      }
      SpreadsheetApp.flush();
    }, 20000, ['katalog']);
    PropertiesService.getScriptProperties().setProperty('CONNER_PRODUK_DITARIK', String(Date.now()));

    var lihat = prosesLihatConnerStok({ email: data.email });
    if (lihat.success) { result.daftar = lihat.daftar; result.ringkasan = lihat.ringkasan; result.tarikTerakhir = lihat.tarikTerakhir; result.gudangDefault = lihat.gudangDefault; }
    result.success = true;
    result.jumlahProduk = totalProduk;
    result.jumlahSku = baris.length;
    result.halaman = halaman;
    if (berhenti) result.peringatan = berhenti;
  } catch (err) { result.error = err.message || String(err); }
  finally { kunciSinkronLepas_('PRODUK_CONNER', mutex); }
  return result;
}

// Listing Conner (dari sheet) + stok tersedia OmniAI. Bundling dihitung dari komponen (stok paket = min komponen/qty).
function prosesLihatConnerStok(data) {
  var result = { success: false };
  try {
    if (!cnBolehLihat_(data.email)) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = cnSheetProduk_(), lr = sh.getLastRow();
    var props = PropertiesService.getScriptProperties();
    var tarikMs = parseInt(props.getProperty('CONNER_PRODUK_DITARIK') || '0', 10);
    result.tarikTerakhir = tarikMs ? cnFmtWaktu_(tarikMs) : '';
    result.gudangDefault = props.getProperty('CONNER_GUDANG_DEFAULT') || '';
    if (lr < 2) { result.success = true; result.daftar = []; result.ringkasan = { listing: 0, terhubung: 0, selisih: 0, belum: 0 }; return result; }

    // Stok tersedia (On Hand - On Reserve) dari mesin stok yang SAMA dengan Monitor Stok
    var mesin = smHitungMesinStok({});
    var avail = {};
    (mesin.daftar || []).forEach(function (p) { avail[smKey(p.sku)] = { qty: Number(p.onAvailable) || 0, nama: p.nama || '', arsip: !!p.arsip }; });

    var daftar = [], ring = { listing: 0, terhubung: 0, selisih: 0, belum: 0 };
    sh.getRange(2, 1, lr - 1, CN_KOLOM_PRODUK_.length).getValues().forEach(function (r) {
      var skuId = String(r[1] || '').trim();
      if (!skuId) return;
      ring.listing++;
      var sellerSku = String(r[2] || '').trim();
      var row = {
        productId: String(r[0]), skuId: skuId, sellerSku: sellerSku, nama: String(r[3] || ''), varian: String(r[4] || ''),
        statusProduk: String(r[5] || ''), warehouseId: String(r[6] || ''), stokConner: parseInt(r[7], 10) || 0,
        harga: parseFloat(r[8]) || 0, terkirim: r[10] === '' ? null : (parseInt(r[10], 10) || 0),
        waktuKirim: r[11] instanceof Date ? cnFmtWaktu_(r[11].getTime()) : String(r[11] || ''),
        skuGudang: '', namaGudang: '', stokOmni: null, bundling: false, status: 'belum'
      };
      if (sellerSku) {
        var bagian = pecahSkuPesananBundling_(sellerSku, 1);
        var semuaKetemu = bagian.length > 0, stokMin = null;
        bagian.forEach(function (b) {
          var a = avail[smKey(b.sku)];
          if (!a && skuAdaDiMasterProduk_(b.sku)) a = { qty: 0, nama: '' }; // terdaftar tapi belum ada mutasi
          if (!a) { semuaKetemu = false; return; }
          var bisa = Math.floor(Math.max(0, a.qty) / (b.qty || 1));
          stokMin = stokMin === null ? bisa : Math.min(stokMin, bisa);
          if (bagian.length === 1) row.namaGudang = a.nama;
        });
        row.bundling = bagian.length > 1 || bagian.some(function (b) { return b.bundling; });
        row.skuGudang = bagian.map(function (b) { return b.sku + (row.bundling && b.qty !== 1 ? ' ×' + b.qty : ''); }).join(' + ');
        if (semuaKetemu) {
          row.stokOmni = stokMin;
          row.status = row.stokOmni === row.stokConner ? 'sesuai' : 'selisih';
        }
      }
      if (row.status === 'belum') ring.belum++; else ring.terhubung++;
      if (row.status === 'selisih') ring.selisih++;
      daftar.push(row);
    });
    result.success = true;
    result.daftar = daftar;
    result.ringkasan = ring;
    result.dihitungPada = cnFmtWaktu_(Date.now());
  } catch (err) { result.error = err.message || String(err); }
  return result;
}

// Kirim stok ke Conner. items = [{ productId, skuId, qty, warehouseId? }] (maks CN_MAKS_ITEM_UPDATE_ per request)
function prosesConnerUpdateStok(data) {
  var result = { success: false };
  if (!cekIzin(data.email, 'mintaStock')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; }
  var items = Array.isArray(data.items) ? data.items : [];
  if (!items.length) { result.error = 'Tidak ada SKU yang dipilih.'; return result; }
  if (items.length > CN_MAKS_ITEM_UPDATE_) { result.error = 'Maksimal ' + CN_MAKS_ITEM_UPDATE_ + ' SKU per kiriman.'; return result; }
  var mutex = kunciSinkronAmbil_('STOK_CONNER', 300);
  if (!mutex) { result.error = 'Update stok Conner lain sedang berjalan. Coba lagi sebentar.'; return result; }
  try {
    var gudangDefault = PropertiesService.getScriptProperties().getProperty('CONNER_GUDANG_DEFAULT') || '';
    var grup = {}, urutan = [], hasil = [];
    items.forEach(function (it) {
      var pid = String(it.productId || '').trim(), sid = String(it.skuId || '').trim();
      var qty = Number(it.qty);
      var wh = String(it.warehouseId || gudangDefault || '').trim();
      if (!/^\d+$/.test(pid) || !/^\d+$/.test(sid)) { hasil.push({ skuId: sid, ok: false, pesan: 'Product/SKU ID tidak valid.' }); return; }
      if (!isFinite(qty) || qty < 0 || qty > 999999 || Math.floor(qty) !== qty) { hasil.push({ skuId: sid, ok: false, pesan: 'Jumlah stok harus bilangan bulat 0 - 999.999.' }); return; }
      if (!wh) { hasil.push({ skuId: sid, ok: false, pesan: 'Gudang TikTok belum diketahui - pilih gudang default di tab Daftar Toko.' }); return; }
      if (!grup[pid]) { grup[pid] = []; urutan.push(pid); }
      grup[pid].push({ id: sid, inventory: [{ warehouse_id: wh, quantity: qty }] });
    });

    urutan.forEach(function (pid) {
      try {
        cnApi_('post', '/product/202309/products/' + pid + '/inventory/update', {}, { skus: grup[pid] }, { target: 'update stok product ' + pid });
        grup[pid].forEach(function (s) { hasil.push({ skuId: s.id, ok: true, qty: s.inventory[0].quantity }); });
      } catch (eU) {
        var asli = String(eU.message || eU), alasan = syncTerjemahkanAlasan_(asli);
        grup[pid].forEach(function (s) { hasil.push({ skuId: s.id, ok: false, pesan: alasan ? alasan + ' — ' + asli : asli }); });
      }
    });

    // Catat ke sheet: Stok di Conner, Stok Terkirim Terakhir, Waktu Kirim Terakhir
    var sukses = {};
    hasil.forEach(function (h) { if (h.ok) sukses[h.skuId] = h.qty; });
    if (Object.keys(sukses).length) {
      denganKunciTulis_(function () {
        var sh = cnSheetProduk_(), lr = sh.getLastRow();
        if (lr < 2) return;
        var rng = sh.getRange(2, 1, lr - 1, CN_KOLOM_PRODUK_.length), v = rng.getValues(), waktu = new Date(), ubah = false;
        v.forEach(function (r) {
          var q = sukses[String(r[1])];
          if (q === undefined) return;
          r[7] = q; r[10] = q; r[11] = waktu; ubah = true;
        });
        if (ubah) { sh.getRange(2, 8, v.length, 1).setValues(v.map(function (r) { return [r[7]]; })); sh.getRange(2, 11, v.length, 2).setValues(v.map(function (r) { return [r[10], r[11]]; })); }
      }, 20000, ['katalog']);
    }
    result.success = true;
    result.hasil = hasil;
    result.berhasil = hasil.filter(function (h) { return h.ok; }).length;
    result.gagal = hasil.length - result.berhasil;
    result.waktu = cnFmtWaktu_(Date.now());
  } catch (err) { result.error = err.message || String(err); }
  finally { kunciSinkronLepas_('STOK_CONNER', mutex); }
  return result;
}

/* ---------- DEBUG: lihat respons JSON mentah (Owner) ----------
   Dipakai untuk mencocokkan parsing dengan respons asli API Conner tanpa membuka editor Apps Script. */
function prosesCekConnerApi(data) {
  var result = { success: false };
  try {
    if (!cnOwner_(data.email)) throw new Error('Hanya Owner yang bisa membuka respons mentah API.');
    var param = String(data.param || '').trim();
    var peta = {
      toko: ['get', '/authorization/202309/shops', {}, null, { tanpaCipher: true }],
      gudang: ['get', '/logistics/202309/warehouses', {}, null, {}],
      pesanan: ['post', '/order/202309/orders/search', { page_size: 5 }, {}, {}],
      produk: ['post', '/product/202309/products/search', { page_size: 5 }, {}, {}],
      detail_pesanan: ['get', '/order/202309/orders', { ids: param }, null, {}],
      detail_produk: ['get', '/product/202309/products/' + param, {}, null, {}]
    };
    var c = peta[data.endpoint];
    if (!c) throw new Error('Endpoint tidak dikenal.');
    if (/^detail_/.test(data.endpoint) && !/^[\d,]{5,400}$/.test(param)) throw new Error('Isi ID (angka) untuk endpoint detail.');
    var opsi = Object.assign({}, c[4], { mentah: true });
    var r = cnApi_(c[0], c[1], c[2], c[3], opsi);
    result.success = true;
    result.endpoint = c[0].toUpperCase() + ' ' + c[1];
    result.http = r.http;
    result.respons = r.json || r.teks;
  } catch (err) { result.error = err.message || String(err); }
  return result;
}

// Ambil deskripsi produk dari halaman URL Supplier pakai AI - hasilnya SARAN doang,
// user tetap review/edit dulu sebelum klik Simpan Deskripsi.
function prosesSalinDeskripsiDariSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('SKU kosong');

    var sh = getMasterProdukSheet();
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 5).getValues();
    var urlSupplier = '';
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][0]).trim() === sku) { urlSupplier = String(vals[i][4] || '').trim(); break; }
    }
    if (!urlSupplier) throw new Error('Produk ini belum punya URL Supplier - isi dulu di Katalog > Harga.');

    var res = fetchHemat(urlSupplier, { muteHttpExceptions: true, followRedirects: true });
    if (res.getResponseCode() !== 200) throw new Error('Gagal buka halaman supplier (kode ' + res.getResponseCode() + ')');
    var html = res.getContentText();
    // Buang tag script/style biar teksnya lebih bersih & nggak kepanjangan buat dikirim ke AI
    var teksBersih = html.replace(/<script[\s\S]*?<\/script>/gi, '').replace(/<style[\s\S]*?<\/style>/gi, '')
      .replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().substring(0, 8000);

    var prompt = 'Ini isi teks dari halaman produk di website supplier. Cari dan tulis ulang DESKRIPSI PRODUKNYA aja ' +
      '(bukan menu navigasi/footer/review/harga) dalam Bahasa Indonesia, ringkas 2-4 kalimat. ' +
      'Kalau nggak ketemu deskripsi yang jelas, bilang "Deskripsi tidak ditemukan di halaman ini". ' +
      'Jangan tambahkan pembuka/penutup, langsung isi deskripsinya aja.\n\nTeks halaman:\n' + teksBersih;

    var hasilTeks = panggilGeminiText(prompt, 'rehan');
    result.success = true;
    result.deskripsi = hasilTeks.trim();
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}


// Buat sampai 10 kategori sekaligus - lebih cepat daripada 1-1 manual
function prosesBuatKategoriMassal_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var daftarNama = data.daftarNama || [];
    if (daftarNama.length === 0) throw new Error('Nggak ada nama kategori yang diisi');

    var sh = getKategoriProdukSheet();
    var lastRow = sh.getLastRow();
    var namaSudahAda = {};
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      vals.forEach(function (row) { namaSudahAda[String(row[0]).trim().toLowerCase()] = true; });
    }

    var barisBaru = [];
    var dilewati = [];
    daftarNama.forEach(function (nama) {
      var namaBersih = String(nama || '').trim();
      if (!namaBersih) return;
      var key = namaBersih.toLowerCase();
      if (namaSudahAda[key]) { dilewati.push(namaBersih); return; }
      namaSudahAda[key] = true; // cegah duplikat DALAM daftar yang diinput sekarang juga
      barisBaru.push([namaBersih, '']);
    });

    if (barisBaru.length > 0) {
      sh.getRange(sh.getLastRow() + 1, 1, barisBaru.length, 2).setValues(barisBaru);
    }

    result.success = true;
    result.jumlahDibuat = barisBaru.length;
    result.dilewati = dilewati;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
