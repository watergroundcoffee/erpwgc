    var hp = p88Bersih_(o.hpManual), al = p88Bersih_(o.alamatManual), user = p88Bersih_(o.usernameManual);
    tambah({ nama: nama, hp: p88Samar_(hp) ? '' : hp, alamat: p88Samar_(al) ? '' : al, user: p88Samar_(user) ? '' : user, wil: al,
      sumber: (o.sumber || '') + ' ' + o.noReferensi + ' (input manual)', bid: o.sumber === 'Shopee' ? (idx.snBuyer[String(o.noReferensi)] || '') : '', manual: true });
