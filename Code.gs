function getTiktokAppSecret() { return masterConfig_('tiktok', 'appSecret') || 'PASTE_TIKTOK_APP_SECRET_DI_SINI'; }
function getShopeePartnerId() { return masterConfig_('shopee', 'partnerId') || 'PASTE_SHOPEE_PARTNER_ID_DI_SINI'; }
function getShopeePartnerKey() { return masterConfig_('shopee', 'partnerKey') || 'PASTE_SHOPEE_PARTNER_KEY_DI_SINI'; }

