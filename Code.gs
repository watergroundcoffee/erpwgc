  for (var j = 0; j < kunci.length; j++) {
    var w = obj[kunci[j]];
    if (w && typeof w === 'object' && !Array.isArray(w)) { var h = ovxCariAngka_(w, re, kedalaman + 1); if (h) return h; }
  }
  return null;
}
function prosesDashboardTrafik(data) {
