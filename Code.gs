        var r = ovxTtsGet_('/analytics/202405/shop/performance', { start_date_ge: perlu[0], end_date_lt: akhirExcl, granularity: '1D', currency: 'LOCAL' });
        if (!r.ok) catatan['TikTok Shop'] = 'TikTok Analytics: ' + (r.pesan || 'gagal') + (r.kode ? ' (kode ' + r.kode + ')' : '') + ' - pastikan scope Data Analytics diaktifkan di aplikasi TikTok.';
