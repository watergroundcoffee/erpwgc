  Object.keys(sumberPakai).forEach(function (s) { nSumber[sumberPakai[s]] = (nSumber[sumberPakai[s]] || 0) + 1; });
  D.unit = unit;
  D.sumberHpp = nSumber;
  D.tanpaHpp = Object.keys(tanpaHpp).map(function (k) { return tanpaHpp[k]; }).sort(function (a, b) { return b.qty - a.qty; }).slice(0, 30);
  D.hppSig = tanda;
  return D;
}

// Jumlahkan data harian dalam rentang [dari, sampai] (teks yyyy-MM-dd, inklusif)
function finAgregat_(D, dari, sampai) {
  var a = { kanal: {}, omzet: 0, pesanan: 0, potongan: 0, potonganKanal: {}, hpp: 0, hppKanal: {}, hppRetur: 0, rusak: 0, beli: 0, beban: {}, totalBeban: 0, lain: 0 };
  if (!dari || !sampai || dari > sampai) return finLengkapiAgregat_(a);
  Object.keys(D.hari).forEach(function (t) {
    if (t < dari || t > sampai) return;
    var h = D.hari[t];
    Object.keys(h.o).forEach(function (kn) {
      var k = a.kanal[kn] || (a.kanal[kn] = [0, 0]);
      k[0] += h.o[kn][0]; k[1] += h.o[kn][1];
    });
    a.hpp += h.h; a.rusak += h.r; a.beli += h.b; a.lain += h.l; a.hppRetur += h.hb || 0;
    if (h.hk) Object.keys(h.hk).forEach(function (kn) { a.hppKanal[kn] = (a.hppKanal[kn] || 0) + h.hk[kn]; });
    Object.keys(h.x).forEach(function (ak) { a.beban[ak] = (a.beban[ak] || 0) + h.x[ak]; });
  });
  Object.keys(a.kanal).forEach(function (kn) {
    var om = a.kanal[kn][0], n = a.kanal[kn][1];
    var tr = D.tarif[FIN_KANAL_TARIF[kn] || kn] || { persen: 0, rupiah: 0 };
    var pot = om * tr.persen / 100 + n * tr.rupiah;
    a.omzet += om; a.pesanan += n;
    if (pot > 0) { a.potonganKanal[kn] = pot; a.potongan += pot; }
  });
  return finLengkapiAgregat_(a);
}
function finLengkapiAgregat_(a) {
  a.totalBeban = Object.keys(a.beban).reduce(function (t, k) { return t + a.beban[k]; }, 0);
  a.labaKotor = a.omzet - a.hpp;
  a.bebanUsaha = a.potongan + a.totalBeban + a.rusak;
  a.labaUsaha = a.labaKotor - a.bebanUsaha;
  a.labaBersih = a.labaUsaha + a.lain;
  a.kasBersih = a.omzet - a.potongan - a.beli - a.totalBeban + a.lain;
  return a;
}

// Posisi stok (sku -> qty) di-cache 10 menit: dulu SETIAP buka Dashboard Finance menjalankan
// perhitungan stok penuh (bagian paling lambat).
function finDaftarStokRingkas_(paksa) {
  var KUNCI = 'FIN_STOK_FISIK_V1';
  if (!paksa) { var c = cacheBesarGet_(KUNCI); if (c && c.daftar) return c.daftar; }
  var st = denganIzinSistem_(function () { return prosesLihatStock({ email: '' }); });
  if (!st || !st.success) return null;
  var daftar = (st.daftar || []).map(function (d) { return { sku: d.sku, stockSaatIni: d.stockSaatIni }; });
  cacheBesarPut_(KUNCI, { daftar: daftar }, 600);
  return daftar;
}
function finNilaiStokFisik_(D, paksa) {
  var hasil = { nilai: 0, skuTanpaHarga: 0, ok: false };
  try {
    var daftarStok = finDaftarStokRingkas_(paksa);
    if (!daftarStok) return hasil;
    daftarStok.forEach(function (d) {
      var q = finAngka_(d.stockSaatIni);
      if (!(q > 0)) return;
      var u = D.unit[resolveSkuJualCepat_(d.sku)] || D.unit[String(d.sku || '').trim()] || 0;
      if (u > 0) hasil.nilai += q * u; else hasil.skuTanpaHarga++;
    });
    hasil.ok = true;
  } catch (e) { }
