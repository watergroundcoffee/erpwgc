// ===== AKSI: kilat_stok_shopee { segar } - stok tersisa di Gudang Shopee menurut API SBS (bila tersedia untuk toko) =====
// Hanya membaca. Nama field SBS tidak semuanya terdokumentasi publik -> pembacaan toleran (beberapa kemungkinan nama).
var KBG_SKU_FIELD_ = ['model_sku', 'seller_sku', 'item_sku', 'sku'];
var KBG_QTY_FIELD_ = ['sellable_qty', 'sellable_stock', 'available_qty', 'available_stock', 'available_quantity', 'stock_qty', 'on_hand_qty', 'total_qty', 'quantity', 'qty', 'stock'];
function kbgUraiStokSbs_(json, hasil) {
  function cari(o, daftar, harusTeks) {
    for (var i = 0; i < daftar.length; i++) {
      var v = o[daftar[i]];
      if (v === undefined || v === null || v === '') continue;
      if (harusTeks && (typeof v === 'string' || typeof v === 'number') && String(v).trim()) return String(v).trim();
      if (!harusTeks && isFinite(Number(v))) return Number(v);
    }
    return null;
  }
  function telusuri(o, d) {
    if (!o || typeof o !== 'object' || d > 8) return false;
    var anak = false;
    if (Array.isArray(o)) { o.forEach(function (x) { if (telusuri(x, d + 1)) anak = true; }); return anak; }
    Object.keys(o).forEach(function (k) { if (o[k] && typeof o[k] === 'object' && telusuri(o[k], d + 1)) anak = true; });
    if (anak) return true; // rincian lebih dalam (per varian) sudah tercatat -> induk tidak dihitung lagi
    var sku = cari(o, KBG_SKU_FIELD_, true), qty = cari(o, KBG_QTY_FIELD_, false);
    if (sku === null || qty === null) return false;
    var s = resolveSkuJualCepat_(sku) || sku;
    hasil[String(s).toUpperCase()] = (hasil[String(s).toUpperCase()] || 0) + qty;
    return true;
  }
  return telusuri(json && (json.response || json.data || json), 0);
}
function prosesKilatStokShopee(data) {
  var result = { success: false };
  try {
    data = data || {};
    if (!cekIzin(data.email, 'scanResiKeluar') && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var kunci = 'KILAT_STOK_SHOPEE_V1';
    if (!data.segar) { var c = cacheBesarGet_(kunci); if (c && c.success) { c.dariCache = true; return c; } }
    var kred = ambilKredensialShopee();
    if (!kred.accessToken || !kred.shopId) return { success: true, tersedia: false, pesan: 'Shopee belum terhubung.' };
    var whs = sbsPanggil_('get_bound_whs_info', {}, kred);
    if (!whs.ok) return { success: true, tersedia: false, pesan: 'Shopee belum memberi akses data Gudang Shopee untuk toko ini (' + (whs.error || whs.http) + (whs.pesan ? ': ' + whs.pesan : '') + ').' };
    var whsId = sbsCariNilai_(whs.json, /^(whs_id|warehouse_id|whs_code|warehouse_code)$/i);
    var perSku = {}, halaman = 0, terakhir = null, adaBaris = false;
    for (var p = 1; p <= 20; p++) {
      var params = { page_no: p, page_size: 50 };
      if (whsId) params.whs_id = whsId;
      var r = sbsPanggil_('get_current_inventory', params, kred);
      terakhir = r;
      if (!r.ok) break;
      halaman++;
      var sebelum = Object.keys(perSku).length;
      var dapat = kbgUraiStokSbs_(r.json, perSku);
      if (dapat) adaBaris = true;
      var resp = (r.json && r.json.response) || {};
      var lagi = resp.more === true || resp.has_next_page === true || (resp.pagination && resp.pagination.more === true);
      if (!dapat || !lagi || Object.keys(perSku).length === sebelum) break;
    }
    if (!halaman) return { success: true, tersedia: false, pesan: 'Data stok Gudang Shopee belum bisa dibaca (' + (terakhir ? (terakhir.error || terakhir.http) + (terakhir.pesan ? ': ' + terakhir.pesan : '') : '-') + ').' };
    if (!adaBaris) return { success: true, tersedia: false, pesan: 'Shopee menjawab, tapi format datanya belum dikenali. Jalankan "Cek API Gudang Shopee" lalu kirim hasilnya ke developer.', field: sbsRingkas_(terakhir && terakhir.json).field.slice(0, 40) };
    result = { success: true, tersedia: true, perSku: perSku, jumlahSku: Object.keys(perSku).length, waktu: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm') };
    try { cacheBesarPut_(kunci, result, 1800); } catch (eC) { }
  } catch (err) { result = { success: false, error: err.toString() }; }
  return result;
}

