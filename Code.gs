  var pct = function (v) { return v === null || v === undefined ? 'n/a (tidak ada pembanding)' : (v > 0 ? '+' : '') + v + '%'; };
  var h = rg.harian || {}, m = rg.bulananMTD || {}, r30 = rg.rolling30Hari || {}, bl = rg.bulanLaluPenuh || {};
  baris.push('- Hari ini: ' + copilotRp_(h.omzet) + ' / ' + (h.pesanan || 0) + ' pesanan (vs kemarin jam sama ' + pct(h.growthVsKemarinPct) + ')');
  baris.push('- Bulan ini (MTD): ' + copilotRp_(m.omzet) + ' / ' + (m.pesanan || 0) + ' pesanan, AOV ' + copilotRp_(m.aov) + ' | MoM ' + pct(m.momPct) + ' | YoY ' + pct(m.yoyPct));
  baris.push('- Bulan lalu penuh: ' + copilotRp_(bl.omzet) + ' / ' + (bl.pesanan || 0) + ' pesanan');
  baris.push('- 30 hari terakhir: ' + copilotRp_(r30.omzet) + ' / ' + (r30.pesanan || 0) + ' pesanan, AOV ' + copilotRp_(r30.aov) + ' (' + pct(r30.growthVs30HariSebelumnyaPct) + ' vs 30 hari sebelumnya)');
  if (r30.batal) baris.push('- Pembatalan 30 hari: ' + r30.batal.jumlah + ' pesanan (' + copilotRp_(r30.batal.nilai) + ', rate ' + r30.batal.ratePct + '%)');
  baris.push('### Kontribusi channel (30 hari)');
  (dl.kontribusiChannel || []).filter(function (c) { return c.omzet || c.omzet30HariSebelumnya; }).forEach(function (c) {
    baris.push('- ' + c.channel + ': ' + copilotRp_(c.omzet) + ' / ' + c.pesanan + ' pesanan (' + c.sharePct + '% omzet), growth ' + pct(c.growthPct));
  });
  var pr = dl.produk || {};
  if ((pr.top5 || []).length) {
    baris.push('### Produk terlaris 30 hari (qty)');
    pr.top5.forEach(function (p) { baris.push('- ' + p.nama + ' [' + p.sku + ']: ' + p.qty30Hari + ' unit, stok ' + (p.onHand === null ? '-' : p.onHand)); });
  }
  if ((pr.bottom3SlowMoving || []).length) {
    baris.push('### Slow moving');
    pr.bottom3SlowMoving.forEach(function (p) { baris.push('- ' + p.nama + ' [' + p.sku + ']: ' + p.qty30Hari + ' unit/30 hari, terakhir laku ' + (p.terjualTerakhir || '-') + ', stok ' + (p.onHand === null ? '-' : p.onHand)); });
  }
  if (pr.produkAktifBelumPernahTerjual) baris.push('- Produk aktif yang belum pernah terjual: ' + pr.produkAktifBelumPernahTerjual);
  var op = dl.operasional || {};
  if (op.pesananBelumAdaResi30Hari || op.pesananTikTokButuhDataPembeli) baris.push('- Operasional: ' + (op.pesananBelumAdaResi30Hari || 0) + ' pesanan belum ada resi, ' + (op.pesananTikTokButuhDataPembeli || 0) + ' pesanan TikTok butuh data pembeli');
  var pengingat = (dl.aksi && dl.aksi.pengingat) || [];
  if (pengingat.length) {
    baris.push('### Tugas Action Tracker yang terlambat');
    pengingat.slice(0, 5).forEach(function (x) { baris.push('- ' + x.judul); });
  }
  return baris.join('\n');
}

