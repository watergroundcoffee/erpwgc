function prosesLihatBahanBaku(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getBahanBakuRoasterySheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 2).getValues();
      vals.forEach(function (row, idx) {
        if (!String(row[0]).trim()) return;
        daftar.push({ row: idx + 2, nama: row[0], stock: parseFloat(row[1]) || 0 });
      });
    }
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesTambahBahanBaku(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var nama = String(data.nama || '').trim();
    if (!nama) throw new Error('Nama bahan kosong');
    var sh = getBahanBakuRoasterySheet();
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][0]).trim().toLowerCase() === nama.toLowerCase()) throw new Error('Bahan ini udah ada');
      }
    }
    sh.appendRow([nama, 0]);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesUpdateStockBahanBaku(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var row = parseInt(data.row, 10);
    var jenis = String(data.jenis || '').trim(); // 'Masuk' atau 'Kurangi'
    var jumlah = parseFloat(data.jumlah);
    if (!row || row < 2) throw new Error('Baris nggak valid');
    if (isNaN(jumlah) || jumlah <= 0) throw new Error('Jumlah nggak valid');

    var sh = getBahanBakuRoasterySheet();
    var stockSekarang = parseFloat(sh.getRange(row, 2).getValue()) || 0;
    var stockBaru = jenis === 'Masuk' ? stockSekarang + jumlah : stockSekarang - jumlah;
    if (stockBaru < 0) throw new Error('Stock nggak boleh minus');
    sh.getRange(row, 2).setValue(stockBaru);
    result.success = true;
    result.stockBaru = stockBaru;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesLihatResepProduksi(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getResepProduksiSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 3).getValues();
      vals.forEach(function (row, idx) {
