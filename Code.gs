}
function iklanValidTgl_(t) {
  t = String(t || '').trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(t)) throw new Error('Format tanggal harus yyyy-mm-dd.');
  return t;
}
// baris: [{ tanggal, toko, platform, biaya }] - data Manual TIDAK ditimpa oleh data API
function iklanUpsert_(baris, sumber, oleh) {
  if (!baris || !baris.length) return 0;
  var lock = kunciModul_('iklan');
  lock.waitLock(20000);
  var n = 0;
  try {
    var sh = getIklanHarianSheet_(), lr = sh.getLastRow();
    var data = lr > 1 ? sh.getRange(2, 1, lr - 1, IKLAN_HARIAN_HEADER_.length).getValues() : [];
    var peta = {};
    data.forEach(function (r, i) { peta[iklanTglStr_(r[0]) + '|' + r[1] + '|' + r[2]] = { row: i + 2, sumber: String(r[4] || '') }; });
    var baru = [], now = new Date();
    baris.forEach(function (b) {
      var k = b.tanggal + '|' + b.toko + '|' + b.platform, ada = peta[k];
      var nilai = [b.tanggal, b.toko, b.platform, Math.round(Number(b.biaya) || 0), sumber, now, oleh || 'sistem'];
      if (ada) {
        if (sumber === 'API' && ada.sumber === 'Manual') return;
        sh.getRange(ada.row, 1, 1, nilai.length).setValues([nilai]);
      } else { baru.push(nilai); peta[k] = { row: -1, sumber: sumber }; }
      n++;
    });
    if (baru.length) {
      var awal = sh.getLastRow() + 1;
      sh.getRange(awal, 1, baru.length, 1).setNumberFormat('@');
      sh.getRange(awal, 1, baru.length, IKLAN_HARIAN_HEADER_.length).setValues(baru);
    }
  } finally { lepasKunci_(lock); }
  CacheService.getScriptCache().remove('IKLAN_HARIAN_V1');
  return n;
}

function prosesSinkronIklanHarian(data) {
  data = data || {};
  if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  var cache = CacheService.getScriptCache();
  if (cache.get('IKLAN_HARIAN_SINKRON_JALAN')) return { success: true, sedangJalan: true };
  cache.put('IKLAN_HARIAN_SINKRON_JALAN', '1', 360);
  try {
    var props = sesiProps_();
    var hari = Math.max(1, Math.min(90, parseInt(data.hariMundur || data.hari, 10) || 14));
    var tanggal = iklanDaftarTanggal_(hari);
    var batasWaktu = Date.now() + 100 * 1000 /* v2026.10.64+1 (P47): batas Edge Function */;
    var tokoShopee = String(props.getProperty('IKLAN_TOKO_SHOPEE') || 'Waterground');
    var tokoTiktok = String(props.getProperty('IKLAN_TOKO_TIKTOK') || 'Waterground');
    var oleh = data.dariSistem ? 'sistem' : data.email;
    var laporan = {};
    try {
      var petaS = iklanTarikShopee_(tanggal, batasWaktu);
      var barisS = Object.keys(petaS).map(function (t) { return { tanggal: t, toko: tokoShopee, platform: 'Shopee', biaya: petaS[t] }; });
      iklanUpsert_(barisS, 'API', oleh);
      laporan['Shopee'] = { ok: true, hari: barisS.length };
      try {
        var rb = shopeeGet_('/api/v2/ads/get_total_balance', {}, ambilKredensialShopee());
        var resp = rb && rb.ok && rb.json && rb.json.response;
        var saldo = resp ? parseFloat(resp.total_balance !== undefined ? resp.total_balance : resp.balance) : NaN;
        if (isFinite(saldo)) props.setProperty('IKLAN_SALDO_SHOPEE', JSON.stringify({ nilai: saldo, toko: tokoShopee, waktu: Date.now() }));
      } catch (eS) { }
    } catch (e1) { laporan['Shopee'] = { ok: false, pesan: e1.message || String(e1) }; }
    try {
      var rT = iklanTarikTiktok_(tanggal, batasWaktu);
      var barisT = Object.keys(rT.peta).map(function (t) { return { tanggal: t, toko: tokoTiktok, platform: 'TikTok Shop', biaya: rT.peta[t] }; });
      iklanUpsert_(barisT, 'API', oleh);
      laporan['TikTok Shop'] = { ok: true, hari: barisT.length, peringatan: rT.peringatan || '' };
    } catch (e2) { laporan['TikTok Shop'] = { ok: false, pesan: e2.message || String(e2) }; }
    props.setProperty('IKLAN_SINKRON_TERAKHIR', String(Date.now()));
    // Sinkron MANUAL dari tombol -> sekalian perbarui snapshot jam berjalan (Iklan Per Jam)
    if (!data.dariSistem) { try { iklanCatatPerJam_({ manual: true }); } catch (eJ) { laporan['Per Jam'] = { ok: false, pesan: eJ.message || String(eJ) }; } }
    return { success: true, laporan: laporan };
  } finally { cache.remove('IKLAN_HARIAN_SINKRON_JALAN'); }
}
function iklanHarianTerjadwal() {
  try { denganIzinSistem_(function () { prosesSinkronIklanHarian({ dariSistem: true, hari: 3 }); }); } catch (e) { console.error('iklanHarianTerjadwal: ' + e); }
}
// LAMA (3 jam). Sekarang digantikan aktifkanTrackingIklanPerJam() - fungsi ini tetap ada supaya tidak error
// kalau masih dipanggil, tapi langsung mengalihkan ke tracking per jam.
function aktifkanSinkronIklanHarian() { aktifkanTrackingIklanPerJam(); }

/* ---------- (6b) TRACKING PEMAKAIAN & SALDO IKLAN PER JAM (jam bulat) ----------
   Sheet "Iklan Per Jam": 1 baris = snapshot per Tanggal + Jam + Toko + Platform.
   "Kumulatif Biaya" pada Jam H = total biaya iklan hari itu dari 00:00 s/d H:00 (jam 0..H-1).
   Jam 24 = total sehari penuh (dicatat saat run 00:00 hari berikutnya).
   Perbandingan di frontend: Kumulatif hari ini jam H  vs  Kumulatif KEMARIN jam H yang sama persis,
   jadi pagi hari tidak terlihat seolah iklan "turun drastis".
   Jadwal: trigger sekali-jalan (.at) yang menjadwalkan dirinya sendiri ke jam bulat berikutnya
   (00:00, 01:00, ...), plus trigger pengaman tiap jam yang memperbaiki rantai kalau terputus.
   Jalankan SEKALI dari editor: aktifkanTrackingIklanPerJam() */
var IKLAN_JAM_SHEET_ = 'Iklan Per Jam';
var IKLAN_JAM_HEADER_ = ['Tanggal', 'Jam', 'Toko', 'Platform', 'Kumulatif Biaya', 'Biaya Jam Ini', 'Saldo', 'Sumber', 'Dicatat'];
var IKLAN_JAM_HANDLER_ = 'iklanPerJamTerjadwal';
var IKLAN_JAM_PENGAMAN_ = 'iklanPerJamPengaman';
var IKLAN_JAM_BACA_MAKS_ = 3000; // cukup ~1 bulan terakhir untuk upsert/baca (sheet tidak perlu dibaca penuh)

function getIklanJamSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(IKLAN_JAM_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(IKLAN_JAM_SHEET_);
    sh.getRange(1, 1, 1, IKLAN_JAM_HEADER_.length).setValues([IKLAN_JAM_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('A:A').setNumberFormat('@');
  }
  return sh;
}
function iklanJamFmt_(d, pola) { return Utilities.formatDate(d, Session.getScriptTimeZone(), pola); }
// Slot jam bulat dari waktu eksekusi: menit 50-59 dibulatkan KE ATAS (trigger kadang jalan sedikit lebih awal)
function iklanJamSlot_(waktu) {
  var now = waktu || new Date();
  var menit = parseInt(iklanJamFmt_(now, 'm'), 10);
  var slot = new Date(now.getTime() + (menit >= 50 ? (60 - menit) : -menit) * 60000);
  return { tanggal: iklanJamFmt_(slot, 'yyyy-MM-dd'), jam: parseInt(iklanJamFmt_(slot, 'H'), 10), menit: menit, waktu: slot };
}
function iklanJamGeserTanggal_(tanggal, hari) {
  var d = new Date(tanggal + 'T12:00:00'); // jam 12 -> aman dari pergeseran zona
  d.setDate(d.getDate() + hari);
  return Utilities.formatDate(d, 'GMT', 'yyyy-MM-dd');
}
function iklanJam24Kosong_() { var a = []; for (var i = 0; i < 24; i++) a.push(0); return a; }

/* Shopee Ads per jam (v2.ads.get_all_cpc_ads_hourly_performance, performance_date DD-MM-YYYY) */
function iklanShopeePerJam_(tanggal, kred) {
  var p = tanggal.split('-');
  var r = shopeeGet_('/api/v2/ads/get_all_cpc_ads_hourly_performance', { performance_date: p[2] + '-' + p[1] + '-' + p[0] }, kred);
  if (!r.ok) return { ok: false, pesan: ((r.error || '') + ' ' + (r.pesan || '')).trim() };
  var resp = r.json && r.json.response;
  var list = Array.isArray(resp) ? resp : (resp && (resp.hourly_performance_list || resp.performance_list || resp.list)) || [];
  var jam = iklanJam24Kosong_();
  list.forEach(function (x) {
    var h = parseInt(x.hour !== undefined ? x.hour : (x.stat_hour !== undefined ? x.stat_hour : String(x.date_hour || '').slice(-2)), 10);
    if (!(h >= 0 && h < 24)) return;
    var v = parseFloat(x.expense !== undefined ? x.expense : (x.cost !== undefined ? x.cost : x.spend));
    if (isFinite(v)) jam[h] += v;
  });
  return { ok: true, jam: jam };
}

/* TikTok Ads per jam (Business API, dimensi stat_time_hour). Gagal -> { ok:false } lalu dipakai cadangan harian. */
function iklanTiktokPerJam_(tanggal) {
  var props = PropertiesService.getScriptProperties();
  var token = String(props.getProperty('TIKTOK_ADS_ACCESS_TOKEN') || '').trim();
  var advIds = String(props.getProperty('TIKTOK_ADS_ADVERTISER_ID') || '').split(',').map(function (s) { return s.trim(); }).filter(String);
  var storeId = String(props.getProperty('TIKTOK_ADS_STORE_ID') || '').trim();
  if (!token || !advIds.length) return { ok: false, belumDiatur: true, pesan: 'TikTok Ads belum diatur' };
  var jam = iklanJam24Kosong_();
  function tambah(list, kunci) {
    (list || []).forEach(function (row) {
      var dim = row.dimensions || {}, met = row.metrics || {};
      var t = String(dim.stat_time_hour || '');
      if (t.slice(0, 10) !== tanggal) return;
      var h = parseInt(t.slice(11, 13), 10);
      var v = parseFloat(met[kunci] !== undefined ? met[kunci] : (met.spend !== undefined ? met.spend : met.cost));
      if (h >= 0 && h < 24 && isFinite(v)) jam[h] += v;
    });
  }
  for (var a = 0; a < advIds.length; a++) {
    var adv = advIds[a], hal = 1, totalHal = 1;
    do {
      var r = iklanTiktokGet_('/open_api/v1.3/report/integrated/get/', {
        advertiser_id: adv, report_type: 'BASIC', data_level: 'AUCTION_ADVERTISER', dimensions: ['stat_time_hour'], metrics: ['spend'],
        start_date: tanggal, end_date: tanggal, page: String(hal), page_size: '100'
      }, token);
      if (!r.ok) return { ok: false, pesan: 'TikTok Ads per jam (' + adv + '): ' + r.pesan };
      tambah(r.data.list, 'spend');
      totalHal = (r.data.page_info && r.data.page_info.total_page) || 1;
      hal++;
    } while (hal <= totalHal && hal <= 10);
    if (storeId) {
      var g = iklanTiktokGet_('/open_api/v1.3/gmv_max/report/get/', {
        advertiser_id: adv, store_ids: [storeId], dimensions: ['stat_time_hour'], metrics: ['cost'],
        start_date: tanggal, end_date: tanggal, page: '1', page_size: '100'
      }, token);
      // GMV Max per jam tidak tersedia -> JANGAN pakai data per jam yang tidak lengkap; pakai cadangan harian
      if (!g.ok) return { ok: false, pesan: 'GMV Max per jam: ' + g.pesan };
      tambah(g.data.list, 'cost');
    }
  }
  return { ok: true, jam: jam };
}
function iklanKumulatif_(jamArr, h) { var s = 0; for (var i = 0; i < Math.min(h, 24); i++) s += Number(jamArr[i]) || 0; return Math.round(s); }

// Baca indeks baris yang sudah ada (hanya bagian akhir sheet) -> { 'tgl|jam|toko|plat': { row, kumulatif } }
function iklanJamIndeks_(sh) {
  var lr = sh.getLastRow(), peta = {};
  if (lr < 2) return peta;
  var awal = Math.max(2, lr - IKLAN_JAM_BACA_MAKS_ + 1);
  sh.getRange(awal, 1, lr - awal + 1, 5).getValues().forEach(function (r, i) {
    var t = iklanTglStr_(r[0]);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(t)) return;
    peta[t + '|' + Number(r[1]) + '|' + r[2] + '|' + r[3]] = { row: awal + i, kumulatif: Number(r[4]) || 0 };
  });
  return peta;
}
// baris: [{ tanggal, jam, toko, platform, kumulatif, biayaJam, saldo, sumber, hanyaKosong }]
function iklanJamUpsert_(baris) {
  if (!baris.length) return 0;
  var lock = kunciModul_('iklan');
  lock.waitLock(20000);
  var n = 0;
  try {
    var sh = getIklanJamSheet_(), peta = iklanJamIndeks_(sh), baru = [], now = new Date();
    baris.forEach(function (b) {
      var k = b.tanggal + '|' + b.jam + '|' + b.toko + '|' + b.platform, ada = peta[k];
      var nilai = [b.tanggal, b.jam, b.toko, b.platform, Math.round(Number(b.kumulatif) || 0),
        (b.biayaJam === '' || b.biayaJam === null || b.biayaJam === undefined) ? '' : Math.round(Number(b.biayaJam) || 0),
        (b.saldo === '' || b.saldo === null || b.saldo === undefined) ? '' : Math.round(Number(b.saldo) || 0), b.sumber || 'API', now];
      if (ada) {
        if (b.hanyaKosong) return; // isi-ulang (backfill) tidak menimpa snapshot asli
        sh.getRange(ada.row, 1, 1, nilai.length).setValues([nilai]);
      } else { baru.push(nilai); peta[k] = { row: -1, kumulatif: nilai[4] }; }
      n++;
    });
    if (baru.length) {
      var awal = sh.getLastRow() + 1;
      sh.getRange(awal, 1, baru.length, 1).setNumberFormat('@');
      sh.getRange(awal, 1, baru.length, IKLAN_JAM_HEADER_.length).setValues(baru);
    }
  } finally { lepasKunci_(lock); }
  return n;
}

/* Inti: catat snapshot jam bulat sekarang untuk Shopee & TikTok Shop.
   Data per jam -> kumulatif TEPAT s/d H:00 (walau eksekusi telat beberapa menit) + isi ulang jam-jam
   hari ini & kemarin yang belum tercatat (supaya pembanding "kemarin jam yang sama" langsung tersedia).
   Data per jam tidak tersedia -> cadangan: total harian berjalan (dicatat apa adanya + waktu catat). */
function iklanCatatPerJam_(opsi) {
  opsi = opsi || {};
  var cache = CacheService.getScriptCache();
  if (cache.get('IKLAN_JAM_JALAN')) return { success: true, sedangJalan: true };
  cache.put('IKLAN_JAM_JALAN', '1', 300);
  try {
    var props = sesiProps_();
    var slot = iklanJamSlot_(opsi.waktu);
    var tglIni = slot.tanggal, jamIni = slot.jam, tglKemarin = iklanJamGeserTanggal_(tglIni, -1);
    var sh = getIklanJamSheet_(), indeks = iklanJamIndeks_(sh);
    var baris = [], laporan = {};
    var platform = [
      { nama: 'Shopee', toko: String(props.getProperty('IKLAN_TOKO_SHOPEE') || 'Waterground') },
      { nama: 'TikTok Shop', toko: String(props.getProperty('IKLAN_TOKO_TIKTOK') || 'Waterground') }
    ];
    platform.forEach(function (pf) {
      try {
        var perJam, saldo = '';
        var kred = null;
        if (pf.nama === 'Shopee') {
          kred = ambilKredensialShopee();
          if (!kred || !kred.accessToken || !kred.shopId) { laporan[pf.nama] = { ok: false, pesan: 'Shopee belum terhubung' }; return; }
          perJam = function (t) { return iklanShopeePerJam_(t, kred); };
          try {
            var rb = shopeeGet_('/api/v2/ads/get_total_balance', {}, kred);
            var resp = rb && rb.ok && rb.json && rb.json.response;
            var sv = resp ? parseFloat(resp.total_balance !== undefined ? resp.total_balance : resp.balance) : NaN;
            if (isFinite(sv)) { saldo = sv; props.setProperty('IKLAN_SALDO_SHOPEE', JSON.stringify({ nilai: sv, toko: pf.toko, waktu: Date.now() })); }
          } catch (eS) { }
        } else {
          perJam = iklanTiktokPerJam_;
        }
        var hIni = perJam(tglIni);
        if (hIni.belumDiatur) { laporan[pf.nama] = { ok: false, pesan: hIni.pesan }; return; }
        if (hIni.ok) {
          // Snapshot jam ini + isi ulang jam-jam sebelumnya hari ini yang terlewat
          for (var h = 0; h <= jamIni; h++) {
            var kum = iklanKumulatif_(hIni.jam, h);
            var adaH = indeks[tglIni + '|' + h + '|' + pf.toko + '|' + pf.nama];
            if (h < jamIni && adaH) continue;
            baris.push({ tanggal: tglIni, jam: h, toko: pf.toko, platform: pf.nama, kumulatif: kum,
              biayaJam: h > 0 ? Math.round(Number(hIni.jam[h - 1]) || 0) : 0,
              saldo: h === jamIni ? saldo : '', sumber: h === jamIni ? 'API per jam' : 'API isi ulang', hanyaKosong: h < jamIni });
          }
          // Kemarin: isi ulang slot yang belum ada (termasuk jam 24 = total sehari)
          var perluKemarin = false;
          for (var hk = 0; hk <= 24; hk++) if (!indeks[tglKemarin + '|' + hk + '|' + pf.toko + '|' + pf.nama]) { perluKemarin = true; break; }
          if (perluKemarin || jamIni === 0) {
            var hKmr = perJam(tglKemarin);
            if (hKmr.ok) {
              for (var j = 0; j <= 24; j++) {
                var finalisasi = (j === 24 && jamIni === 0); // run 00:00 -> total kemarin ditimpa dengan angka final
                if (indeks[tglKemarin + '|' + j + '|' + pf.toko + '|' + pf.nama] && !finalisasi) continue;
                baris.push({ tanggal: tglKemarin, jam: j, toko: pf.toko, platform: pf.nama, kumulatif: iklanKumulatif_(hKmr.jam, j),
                  biayaJam: j > 0 ? Math.round(Number(hKmr.jam[j - 1]) || 0) : 0, saldo: '', sumber: finalisasi ? 'API per jam' : 'API isi ulang', hanyaKosong: !finalisasi });
              }
            }
          }
          laporan[pf.nama] = { ok: true, mode: 'per jam', jam: jamIni };
        } else {
          // Cadangan: total harian berjalan dari endpoint harian
          var batas = Date.now() + 60 * 1000;
          var peta = pf.nama === 'Shopee' ? iklanTarikShopee_([tglIni], batas) : iklanTarikTiktok_([tglIni], batas).peta;
          var kumH = Math.round(Number(peta[tglIni]) || 0);
          if (jamIni === 0) kumH = 0; // s/d 00:00 selalu 0
          var sebelum = indeks[tglIni + '|' + (jamIni - 1) + '|' + pf.toko + '|' + pf.nama];
          baris.push({ tanggal: tglIni, jam: jamIni, toko: pf.toko, platform: pf.nama, kumulatif: kumH,
            biayaJam: sebelum ? Math.max(0, kumH - sebelum.kumulatif) : '', saldo: saldo, sumber: 'API harian (perkiraan)' });
          if (jamIni === 0) {
            var petaK = pf.nama === 'Shopee' ? iklanTarikShopee_([tglKemarin], batas) : iklanTarikTiktok_([tglKemarin], batas).peta;
            baris.push({ tanggal: tglKemarin, jam: 24, toko: pf.toko, platform: pf.nama, kumulatif: Math.round(Number(petaK[tglKemarin]) || 0), biayaJam: '', saldo: '', sumber: 'API harian' });
          }
          laporan[pf.nama] = { ok: true, mode: 'harian', jam: jamIni, peringatan: hIni.pesan };
        }
      } catch (e) { laporan[pf.nama] = { ok: false, pesan: e.message || String(e) }; }
    });
    var n = iklanJamUpsert_(baris);
    props.setProperty('IKLAN_JAM_TERAKHIR', JSON.stringify({ tanggal: tglIni, jam: jamIni, waktu: Date.now(), laporan: laporan }));
    return { success: true, tanggal: tglIni, jam: jamIni, ditulis: n, laporan: laporan };
  } finally { cache.remove('IKLAN_JAM_JALAN'); }
}

// Jadwalkan run berikutnya TEPAT di jam bulat berikutnya (hh:00:05)
function iklanJadwalkanBerikut_() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === IKLAN_JAM_HANDLER_) ScriptApp.deleteTrigger(t); });
  var now = new Date();
  var menit = parseInt(iklanJamFmt_(now, 'm'), 10), detik = parseInt(iklanJamFmt_(now, 's'), 10);
  var ms = ((60 - menit) * 60 - detik) * 1000 + 5000;
  if (ms < 90000) ms += 3600000; // baru saja lewat jam bulat -> jadwalkan ke jam bulat berikutnya lagi
  ScriptApp.newTrigger(IKLAN_JAM_HANDLER_).timeBased().at(new Date(now.getTime() + ms)).create();
}
function iklanPerJamTerjadwal() {
  try { iklanJadwalkanBerikut_(); } catch (e) { console.error('iklanJadwalkanBerikut_: ' + e); }
  var slot = iklanJamSlot_();
  try { denganIzinSistem_(function () { iklanCatatPerJam_({}); }); } catch (e) { console.error('iklanPerJamTerjadwal: ' + e); }
  // Iklan Harian ikut diperbarui tiap jam (hari ini + kemarin; jam 00 -> 3 hari untuk finalisasi)
  try { denganIzinSistem_(function () { prosesSinkronIklanHarian({ dariSistem: true, hari: slot.jam === 0 ? 3 : 2 }); }); } catch (e) { console.error('iklanPerJamTerjadwal harian: ' + e); }
}
// Pengaman (tiap jam, menit acak): sambung ulang rantai trigger kalau putus & catat slot yang terlewat
function iklanPerJamPengaman() {
  var adaRantai = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === IKLAN_JAM_HANDLER_; });
  if (!adaRantai) { try { iklanJadwalkanBerikut_(); } catch (e) { console.error(e); } }
  var slot = iklanJamSlot_();
  if (slot.menit < 15 || slot.menit >= 50) return; // biarkan run jam bulat yang bekerja
  var info = null;
  try { info = JSON.parse(sesiProps_().getProperty('IKLAN_JAM_TERAKHIR') || 'null'); } catch (e) { }
  if (info && info.tanggal === slot.tanggal && info.jam === slot.jam) return;
  try { denganIzinSistem_(function () { iklanCatatPerJam_({}); }); } catch (e) { console.error('iklanPerJamPengaman: ' + e); }
}
// Jalankan SEKALI dari editor Apps Script. Menggantikan trigger Iklan Harian 3 jam yang lama.
function aktifkanTrackingIklanPerJam() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    var h = t.getHandlerFunction();
    if (h === 'iklanHarianTerjadwal' || h === IKLAN_JAM_HANDLER_ || h === IKLAN_JAM_PENGAMAN_) ScriptApp.deleteTrigger(t);
  });
  iklanJadwalkanBerikut_();
  ScriptApp.newTrigger(IKLAN_JAM_PENGAMAN_).timeBased().everyHours(1).create();
  var hasil = denganIzinSistem_(function () { return iklanCatatPerJam_({}); });
  Logger.log('Tracking iklan per jam AKTIF (jam bulat + pengaman). Catatan awal: ' + JSON.stringify(hasil));
}
// Ringkasan per jam untuk frontend: snapshot hari ini & kemarin (+ 7 hari terakhir jam 24 tidak diperlukan)
function iklanJamUntukFrontend_() {
  var sh = getIklanJamSheet_(), lr = sh.getLastRow();
  var tglIni = iklanJamFmt_(new Date(), 'yyyy-MM-dd'), tglKemarin = iklanJamGeserTanggal_(tglIni, -1), tglLusa = iklanJamGeserTanggal_(tglIni, -2);
  var out = [];
  if (lr > 1) {
    var awal = Math.max(2, lr - 1200 + 1);
    sh.getRange(awal, 1, lr - awal + 1, IKLAN_JAM_HEADER_.length).getValues().forEach(function (r) {
      var t = iklanTglStr_(r[0]);
      if (t !== tglIni && t !== tglKemarin && t !== tglLusa) return; // v2026.10-C: + 2 hari lalu (pembanding grafik Kemarin)
      out.push({ tanggal: t, jam: Number(r[1]) || 0, toko: String(r[2] || ''), platform: String(r[3] || ''), kumulatif: Number(r[4]) || 0,
        biayaJam: r[5] === '' ? null : Number(r[5]) || 0, saldo: r[6] === '' ? null : Number(r[6]) || 0, sumber: String(r[7] || ''),
        dicatat: r[8] instanceof Date ? r[8].getTime() : null });
    });
  }
  var info = null;
  try { info = JSON.parse(sesiProps_().getProperty('IKLAN_JAM_TERAKHIR') || 'null'); } catch (e) { }
  return { perJam: out, perJamTanggal: { hariIni: tglIni, kemarin: tglKemarin, lusa: tglLusa }, perJamTerakhir: info };
}

function prosesLihatIklanHarian(data) {
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var hari = Math.max(1, Math.min(180, parseInt(data.hari, 10) || 90));
    var tz = Session.getScriptTimeZone();
    var batas = Utilities.formatDate(new Date(Date.now() - (hari - 1) * 86400000), tz, 'yyyy-MM-dd');
    var shH = getIklanHarianSheet_(), lrH = shH.getLastRow();
    var semua = lrH > 1 ? shH.getRange(2, 1, lrH - 1, 5).getValues().map(function (r) {
      return { tanggal: iklanTglStr_(r[0]), toko: String(r[1] || ''), platform: String(r[2] || ''), biaya: Number(r[3]) || 0, sumber: String(r[4] || '') };
    }).filter(function (r) { return /^\d{4}-\d{2}-\d{2}$/.test(r.tanggal); }) : [];
    var shT = getIklanTopupSheet_(), lrT = shT.getLastRow();
    var topup = lrT > 1 ? shT.getRange(2, 1, lrT - 1, 6).getValues().map(function (r) {
      return { tanggal: iklanTglStr_(r[0]), toko: String(r[1] || ''), platform: String(r[2] || ''), nominal: Number(r[3]) || 0, catatan: String(r[4] || ''), oleh: String(r[5] || '') };
    }).filter(function (r) { return r.nominal > 0; }) : [];
    topup.sort(function (a, b) { return b.tanggal.localeCompare(a.tanggal); });
    // Estimasi saldo = total top up - pemakaian sejak top up PERTAMA (per toko + platform)
    var kelompok = {};
    topup.forEach(function (t) {
      var k = t.toko + '|' + t.platform;
      var g = kelompok[k] || (kelompok[k] = { toko: t.toko, platform: t.platform, totalTopup: 0, mulai: t.tanggal, terpakai: 0 });
      g.totalTopup += t.nominal;
      if (t.tanggal < g.mulai) g.mulai = t.tanggal;
    });
    semua.forEach(function (r) { var g = kelompok[r.toko + '|' + r.platform]; if (g && r.tanggal >= g.mulai) g.terpakai += r.biaya; });
    var api = null;
    try { api = JSON.parse(sesiProps_().getProperty('IKLAN_SALDO_SHOPEE') || 'null'); } catch (e) { }
    if (api && !kelompok[api.toko + '|Shopee']) kelompok[api.toko + '|Shopee'] = { toko: api.toko, platform: 'Shopee', totalTopup: 0, mulai: '', terpakai: 0 };
    var saldo = Object.keys(kelompok).map(function (k) {
      var g = kelompok[k];
      var pakaiApi = api && g.platform === 'Shopee' && g.toko === api.toko && (Date.now() - api.waktu) < 2 * 86400000;
      return { toko: g.toko, platform: g.platform, totalTopup: g.totalTopup, terpakai: g.terpakai, estimasi: g.totalTopup - g.terpakai, api: pakaiApi ? api.nilai : null, apiWaktu: pakaiApi ? api.waktu : null };
    });
    var jamData = { perJam: [], perJamTanggal: null, perJamTerakhir: null };
    try { jamData = iklanJamUntukFrontend_(); } catch (eJ) { console.error('iklanJamUntukFrontend_: ' + eJ); }
    return {
      success: true,
      harian: semua.filter(function (r) { return r.tanggal >= batas; }),
      topup: topup, saldo: saldo,
      sinkronTerakhir: parseInt(sesiProps_().getProperty('IKLAN_SINKRON_TERAKHIR') || '0', 10) || null,
      perJam: jamData.perJam, perJamTanggal: jamData.perJamTanggal, perJamTerakhir: jamData.perJamTerakhir,
      waktuServer: Date.now()
    };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

function prosesSimpanIklanManual(data) {
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tanggal = iklanValidTgl_(data.tanggal);
    var toko = wajibIsi_(data.toko, 'Toko');
    var platform = String(data.platform || '');
    if (IKLAN_PLATFORM_.indexOf(platform) < 0) throw new Error('Platform tidak dikenal.');
    var biaya = wajibAngka_(data.biaya, 'Biaya iklan', 0);
    iklanUpsert_([{ tanggal: tanggal, toko: toko, platform: platform, biaya: biaya }], 'Manual', data.email);
    return { success: true };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

function prosesSimpanTopupIklan(data) {
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tanggal = iklanValidTgl_(data.tanggal);
    var toko = wajibIsi_(data.toko, 'Toko');
    var platform = String(data.platform || '');
    if (IKLAN_PLATFORM_.indexOf(platform) < 0) throw new Error('Platform tidak dikenal.');
    var nominal = wajibAngka_(data.nominal, 'Nominal top up', 1);
    var lock = kunciModul_('iklan');
    lock.waitLock(15000);
    try {
      var sh = getIklanTopupSheet_(), row = sh.getLastRow() + 1;
      sh.getRange(row, 1).setNumberFormat('@');
      sh.getRange(row, 1, 1, IKLAN_TOPUP_HEADER_.length).setValues([[tanggal, toko, platform, Math.round(nominal), String(data.catatan || '').slice(0, 200), data.email, new Date()]]);
    } finally { lepasKunci_(lock); }
    return { success: true };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

/* =====================================================================================
   v2026.10-B · MEMO RUSAK / KURANG (klaim ke supplier) + JURNAL PENYESUAIAN SAK
   -------------------------------------------------------------------------------------
   Alur:
   1) LAPOR (memo_rusak_simpan)
      - Stok fisik dikurangi lewat Stock Ledger jenis "Rusak/Hilang".
      - Mesin Finance (finBangunJurnal_) otomatis membukukan:
            Dr 6-301 Beban Kerusakan Persediaan      Cr 1-103 Persediaan Barang Dagang
        (dinilai pakai Harga Modal SKU yang sama dengan HPP -> konsisten dengan Neraca).
      - Status memo: "Menunggu Klaim".
   2) SELESAI (memo_rusak_selesaikan)
      - Diganti UANG  : Jurnal Transaksi akun "Pendapatan Klaim" ->  Dr 1-101 Kas & Bank   Cr 7-102 Pendapatan Klaim
      - Diganti BARANG: Stock Ledger "Masuk" berpenanda MRK_PENANDA_PULIH -> stok pulih dan
                        Finance membalik beban:  Dr 1-103 Persediaan   Cr 6-301 Beban Kerusakan Persediaan
      - Ditolak       : tidak ada jurnal baru (kerugian tetap sebagai beban).
   Data memo: sheet "Memo Rusak Kurang". Foto bukti: Drive "OmniAI - File Upload/Memo Rusak/".
   ===================================================================================== */
var MRK_SHEET_ = 'Memo Rusak Kurang';
var MRK_AKUN_PENDAPATAN_KLAIM = 'Pendapatan Klaim';
var MRK_PENANDA_PULIH = '[PULIH-KLAIM]';
var MRK_HEADER_ = ['No Memo', 'Tanggal', 'Jenis', 'SKU', 'Nama Produk', 'Qty', 'Harga Satuan Invoice', 'Nilai Klaim', 'No Invoice Pembelian',
  'Supplier', 'Toko', 'Catatan', 'Foto (JSON)', 'Status', 'Penyelesaian', 'Nilai / Qty Diterima', 'Tgl Selesai', 'Dicatat Oleh', 'Diselesaikan Oleh', 'Stok Dikurangi', 'Epoch'];
var MRK_STATUS_TUNGGU_ = 'Menunggu Klaim';

function getMemoRusakSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(MRK_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(MRK_SHEET_);
    sh.getRange(1, 1, 1, MRK_HEADER_.length).setValues([MRK_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('A:A').setNumberFormat('@'); sh.getRange('D:D').setNumberFormat('@'); sh.getRange('I:I').setNumberFormat('@');
  }
  return sh;
}

// "Rp 1.250.000" / 1250000 / "1250000" -> 1250000
function ccAngkaRupiah_(v) {
  if (typeof v === 'number') return isFinite(v) ? v : 0;
  var s = String(v == null ? '' : v).trim();
  if (!s) return 0;
  if (/^-?\d+(\.\d+)?$/.test(s)) return parseFloat(s);
  var n = parseInt(s.replace(/[^\d-]/g, ''), 10);
  return isNaN(n) ? 0 : n;
}

function mrkSkuSama_(a, b) {
  var x = String(a || '').trim().toUpperCase(), y = String(b || '').trim().toUpperCase();
  if (!x || !y) return false;
  if (x === y) return true;
  try { return String(resolveSkuJualCepat_(a)).toUpperCase() === String(resolveSkuJualCepat_(b)).toUpperCase(); } catch (e) { return false; }
}

function mrkBacaBaris_(r, i, bolehNilai) {
  var tz = Session.getScriptTimeZone();
  var foto = []; try { foto = JSON.parse(String(r[12] || '[]')) || []; } catch (e) { foto = []; }
  return {
    row: i + 2, noMemo: String(r[0] || ''), tanggal: r[1] instanceof Date ? Utilities.formatDate(r[1], tz, 'dd MMM yyyy, HH:mm') : String(r[1] || ''),
    ms: r[1] instanceof Date ? r[1].getTime() : (Number(r[20]) || 0),
    jenis: String(r[2] || ''), sku: String(r[3] || ''), nama: String(r[4] || ''), qty: Number(r[5]) || 0,
    harga: bolehNilai ? (Number(r[6]) || 0) : null, nilai: bolehNilai ? (Number(r[7]) || 0) : null,
    noInvoice: String(r[8] || ''), supplier: String(r[9] || ''), toko: String(r[10] || ''), catatan: String(r[11] || ''), foto: foto,
    status: String(r[13] || ''), penyelesaian: String(r[14] || ''), diterima: bolehNilai || String(r[14] || '') !== 'Uang' ? r[15] : null,
    tglSelesai: r[16] instanceof Date ? Utilities.formatDate(r[16], tz, 'dd MMM yyyy, HH:mm') : String(r[16] || ''),
    dicatatOleh: String(r[17] || ''), diselesaikanOleh: String(r[18] || ''), stokDikurangi: String(r[19] || 'Ya') !== 'Tidak'
  };
}

// ===== AKSI: memo_rusak_cari_invoice - invoice pembelian TERAKHIR yang berisi SKU =====
function prosesMemoRusakCariInvoice(data) {
  return withRead(data.email, 'mintaStock', function () {
    var sku = wajibIsi_(data.sku, 'SKU');
    var bolehNilai = cekIzin(data.email, 'buatInvoice');
    var sheets = getPembelianManualSheets();
    var header = {}, tz = Session.getScriptTimeZone();
    var lrH = sheets.header.getLastRow();
    if (lrH > 1) sheets.header.getRange(2, 1, lrH - 1, 10).getValues().forEach(function (h) {
      var no = String(h[0] || '').trim(); if (!no) return;
      header[no] = { ms: h[1] instanceof Date ? h[1].getTime() : 0, tanggal: h[1] instanceof Date ? Utilities.formatDate(h[1], tz, 'dd MMM yyyy') : String(h[1] || ''),
        supplier: String(h[2] || ''), cabang: String(h[3] || ''), status: String(h[9] || 'Aktif') };
    });
    var hasil = {}, nama = '';
    var lrD = sheets.detail.getLastRow();
    if (lrD > 1) sheets.detail.getRange(2, 1, lrD - 1, 5).getValues().forEach(function (d) {
      var no = String(d[0] || '').trim(); if (!no || !mrkSkuSama_(d[1], sku)) return;
      var h = header[no] || { ms: 0, tanggal: '', supplier: '', cabang: '', status: 'Aktif' };
      if (/batal|hapus/i.test(h.status)) return;
      var x = hasil[no] || (hasil[no] = { noInvoice: no, tanggal: h.tanggal, ms: h.ms, supplier: h.supplier, cabang: h.cabang, qty: 0, harga: 0, nama: String(d[2] || '') });
      x.qty += parseFloat(d[3]) || 0;
      x.harga = parseFloat(d[4]) || x.harga;
      if (!nama) nama = String(d[2] || '');
    });
    var daftar = Object.keys(hasil).map(function (k) { return hasil[k]; }).sort(function (a, b) { return b.ms - a.ms; }).slice(0, 6);
    if (!bolehNilai) daftar.forEach(function (x) { x.harga = null; });
    var skuInduk = sku; try { skuInduk = resolveSkuJualCepat_(sku) || sku; } catch (e) { }
    var stok = null; try { stok = hitungStockSatuSku(skuInduk, data.toko); } catch (e) { }
    // Memo yang masih menunggu klaim untuk SKU ini (cegah lapor dobel)
    var terbuka = [];
    var sh = getMemoRusakSheet_(), lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 1, lr - 1, MRK_HEADER_.length).getValues().forEach(function (r, i) {
      if (String(r[13]) === MRK_STATUS_TUNGGU_ && mrkSkuSama_(r[3], sku)) terbuka.push({ noMemo: String(r[0]), qty: Number(r[5]) || 0, noInvoice: String(r[8] || '') });
    });
    return { daftar: daftar, terakhir: daftar[0] || null, skuInduk: skuInduk, nama: nama, stok: stok, memoTerbuka: terbuka };
  });
}

// ===== AKSI: memo_rusak_simpan =====
function prosesMemoRusakSimpan(data) {
  if (!cekIzin(data.email, 'mintaStock')) return { success: false, error: PESAN_TIDAK_ADA_IZIN_ };
  var jenis, sku, qty, fotoLink = [];
  try {
    jenis = String(data.jenis || '');
    if (jenis !== 'Rusak' && jenis !== 'Kurang') throw new Error('Jenis memo harus Rusak atau Kurang.');
    sku = wajibIsi_(data.sku, 'SKU');
    qty = wajibAngka_(data.qty, 'Qty', 1);
    if (Math.round(qty) !== qty) throw new Error('Qty harus bilangan bulat.');
    var foto = Array.isArray(data.foto) ? data.foto.slice(0, 4) : [];
    if (jenis === 'Rusak' && !foto.length) throw new Error('Foto bukti wajib untuk barang rusak.');
    // Upload foto DI LUAR lock (lambat) - file Drive aman walau transaksi di bawah gagal
    var folder = getSubfolderUpload('Memo Rusak');
    foto.forEach(function (f, i) {
      var b64 = String(f && f.base64 || ''); if (!b64) return;
      if (b64.length > 6 * 1024 * 1024) throw new Error('Foto ke-' + (i + 1) + ' terlalu besar (maks ±4 MB).');
      var blob = Utilities.newBlob(Utilities.base64Decode(b64), String(f.mimeType || 'image/jpeg'), 'memo-' + sku.replace(/[^\w-]/g, '') + '-' + Date.now() + '-' + (i + 1) + '.jpg');
      var file = folder.createFile(blob);
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      fotoLink.push('https://lh3.googleusercontent.com/d/' + file.getId());
    });
  } catch (eV) { return { success: false, error: eV.message || String(eV) }; }

  return withTransaction(data.email, null, 'stok', function (ktx) {
    var namaStaff = ktx.namaStaff();
    var toko = data.toko || 'Waterground';
    var skuInduk = resolveSkuJual(sku) || sku;
    var noInv = String(data.noInvoice || '').trim();
    var harga = Math.max(0, Number(data.harga) || 0);
    if (!(harga > 0) && noInv) harga = mrkHargaInvoice_(noInv, sku); // staff tanpa izin lihat harga -> server yang mengisi
    var supplier = String(data.supplier || '').trim().slice(0, 80);
    var catatan = String(data.catatan || '').trim().slice(0, 300);
    var nama = String(data.nama || '').trim().slice(0, 120);
    var kurangiStok = data.kurangiStok !== false;
    var sekarang = new Date(), tz = Session.getScriptTimeZone();
    var sh = getMemoRusakSheet_();
    // Nomor memo: MRK-yyMMdd-001 (urut per hari)
    var prefix = 'MRK-' + Utilities.formatDate(sekarang, tz, 'yyMMdd') + '-', urut = 0, lr = sh.getLastRow();
    if (lr > 1) sh.getRange(Math.max(2, lr - 300), 1, lr - Math.max(2, lr - 300) + 1, 1).getValues().forEach(function (r) {
      var s = String(r[0] || ''); if (s.indexOf(prefix) === 0) urut = Math.max(urut, parseInt(s.slice(prefix.length), 10) || 0);
    });
    var noMemo = prefix + ('00' + (urut + 1)).slice(-3);

    if (kurangiStok) {
      var shL = getStockLedgerSheet(toko);
      var rowL = shL.getLastRow() + 1;
      shL.getRange(rowL, 2).setNumberFormat('@');
      shL.getRange(rowL, 1, 1, 8).setValues([[sekarang, skuInduk, 'Rusak/Hilang', qty,
        'Memo ' + jenis + ' ' + noMemo + (noInv ? ' | Inv ' + noInv : '') + (catatan ? ' | ' + catatan : ''), namaStaff, toko, harga]]);
    }
    var rowM = sh.getLastRow() + 1;
    sh.getRange(rowM, 1).setNumberFormat('@'); sh.getRange(rowM, 4).setNumberFormat('@'); sh.getRange(rowM, 9).setNumberFormat('@');
    sh.getRange(rowM, 1, 1, MRK_HEADER_.length).setValues([[noMemo, sekarang, jenis, skuInduk, nama, qty, harga, Math.round(qty * harga), noInv, supplier, toko, catatan,
      JSON.stringify(fotoLink), MRK_STATUS_TUNGGU_, '', '', '', namaStaff, '', kurangiStok ? 'Ya' : 'Tidak', sekarang.getTime()]]);

    var hasil = { noMemo: noMemo, foto: fotoLink, stokDikurangi: kurangiStok };
    try { hasil.stockSaatIni = hitungStockSatuSku(skuInduk, toko); } catch (eS) { }
    try {
      if (kurangiStok && PropertiesService.getScriptProperties().getProperty('VIRTUAL_STOCK_AKTIF_TIKTOK') === 'true') prosesUpdateVirtualStockSatuSku(skuInduk, hasil.stockSaatIni);
    } catch (eVS) { }
    return hasil;
  }, { tungguMs: 20000 });
}

// ===== AKSI: memo_rusak_daftar =====
function prosesMemoRusakDaftar(data) {
  return withRead(data.email, 'mintaStock', function () {
    var bolehNilai = cekIzin(data.email, 'buatInvoice');
    var sh = getMemoRusakSheet_(), lr = sh.getLastRow(), daftar = [];
    if (lr > 1) sh.getRange(2, 1, lr - 1, MRK_HEADER_.length).getValues().forEach(function (r, i) {
      if (!String(r[0] || '').trim()) return;
      var x = mrkBacaBaris_(r, i, bolehNilai);
      if (data.noInvoice && x.noInvoice !== String(data.noInvoice)) return;
      daftar.push(x);
    });
    daftar.sort(function (a, b) { return b.ms - a.ms; });
    return { daftar: daftar.slice(0, 800), bolehNilai: bolehNilai };
  });
}

// ===== AKSI: memo_rusak_selesaikan - cara: 'uang' | 'barang' | 'ditolak' =====
function prosesMemoRusakSelesaikan(data) {
  var cara = String(data.cara || '');
  if (['uang', 'barang', 'ditolak'].indexOf(cara) < 0) return { success: false, error: 'Pilih cara penyelesaian klaim.' };
  var izin = cara === 'uang' ? 'buatInvoice' : 'mintaStock';
  return withTransaction(data.email, izin, 'stok', function (ktx) {
    var namaStaff = ktx.namaStaff();
    var sh = getMemoRusakSheet_(), lr = sh.getLastRow(), row = 0, r = null;
    if (lr > 1) {
      var noKol = sh.getRange(2, 1, lr - 1, 1).getValues();
      for (var i = noKol.length - 1; i >= 0; i--) if (String(noKol[i][0]).trim() === String(data.noMemo || '').trim()) { row = i + 2; break; }
    }
    if (!row) throw new Error('Memo ' + data.noMemo + ' tidak ditemukan.');
    r = sh.getRange(row, 1, 1, MRK_HEADER_.length).getValues()[0];
    if (String(r[13]) !== MRK_STATUS_TUNGGU_) throw new Error('Memo ini sudah diselesaikan (' + r[13] + ').');
    var noMemo = String(r[0]), sku = String(r[3]), qty = Number(r[5]) || 0, noInv = String(r[8] || ''), toko = String(r[10] || data.toko || 'Waterground');
    var stokDikurangi = String(r[19] || 'Ya') !== 'Tidak';
    var foto = []; try { foto = JSON.parse(String(r[12] || '[]')) || []; } catch (e) { }
    var tanggal = data.tanggal && /^\d{4}-\d{2}-\d{2}$/.test(String(data.tanggal)) ? new Date(String(data.tanggal) + 'T12:00:00') : new Date();
    var status, catatanHasil;

    if (cara === 'uang') {
      var nominal = Math.round(wajibAngka_(data.nominal, 'Nominal klaim', 1));
      var akunKas = String(data.akunKas || 'Kas & Bank').trim().slice(0, 60);
      var shJ = getJurnalTransaksiSheet();
      shJ.appendRow([tanggal, MRK_AKUN_PENDAPATAN_KLAIM, 'Pendapatan', 'Masuk', nominal,
        'Klaim ' + noMemo + ' · ' + sku + (noInv ? ' · Inv ' + noInv : '') + ' · diterima di ' + akunKas, 'Memo Rusak', foto[0] || '']);
      try { // pastikan akun ada di Bagan Akun (dipakai menu Finance)
        var shA = getBaganAkunSheet(), ada = false, lrA = shA.getLastRow();
        if (lrA > 1) ada = shA.getRange(2, 1, lrA - 1, 1).getValues().some(function (a) { return String(a[0]).trim().toLowerCase() === MRK_AKUN_PENDAPATAN_KLAIM.toLowerCase(); });
        if (!ada) shA.appendRow([MRK_AKUN_PENDAPATAN_KLAIM, 'Pendapatan', 'Ganti rugi klaim barang rusak/kurang dari supplier/kurir (7-102)']);
      } catch (eA) { }
      status = 'Selesai (Uang)'; catatanHasil = nominal;
    } else if (cara === 'barang') {
