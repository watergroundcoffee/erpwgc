  daftarAsli.forEach(function (a) { var k = ovxNormResi_(a); if (k.length >= 8) { target[k] = a; var d = aklDigit_(k); if (d && d.length >= 9) digit[d] = a; } });
  if (!Object.keys(target).length) return hasil;
  var hits = {}, mirip = {};
  aklSumber_().forEach(function (src) {
