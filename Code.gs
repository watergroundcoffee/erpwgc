    var linkInvoice = '';
    if (data.fotoBase64) {
      try {
        var decoded = Utilities.base64Decode(data.fotoBase64);
        var blob = Utilities.newBlob(decoded, data.fotoMimeType || 'image/jpeg', 'invoice-minta-stock-' + noInvoice);
        var file = getSubfolderUpload('Invoice Supplier').createFile(blob);
        file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
        linkInvoice = 'https://lh3.googleusercontent.com/d/' + file.getId();
      } catch (eFoto) { /* gagal upload foto nggak boleh gagalin simpan no invoice-nya */ }
