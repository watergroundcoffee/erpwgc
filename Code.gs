/* ---------- UJI SEMUA SUMBER (Owner) ----------
   Untuk 1-5 pesanan: setiap API dipanggil, hasilnya per field (terisi / tersamar / gambar / kosong) + jawaban mentah
   (dipotong 4.000 karakter). Tanpa daftar -> sistem memilih 1 pesanan per status dari sheet Pesanan Shopee.
   data.label = true -> PDF label resmi ikut diambil (hanya pesanan yang sudah Atur Pengiriman) untuk dibaca teksnya di browser. */
function spbPilihContohPesanan_(maks, perStatus) {
  maks = maks || 5; perStatus = perStatus || 1;
  var sh = getPesananShopeeSheet(), lr = sh.getLastRow();
  if (lr < 2) return [];
  var mulai = Math.max(2, lr - 400);
  var vals = sh.getRange(mulai, 1, lr - mulai + 1, 5).getValues();
  var urutan = ['READY_TO_SHIP', 'PROCESSED', 'SHIPPED', 'TO_CONFIRM_RECEIVE', 'COMPLETED', 'UNPAID'];
  var per = {};
  for (var i = vals.length - 1; i >= 0; i--) {
    var sn = String(vals[i][0] || '').trim(), st = String(vals[i][4] || '').trim().toUpperCase();
    if (sn && urutan.indexOf(st) >= 0 && (per[st] = per[st] || []).length < perStatus) per[st].push(sn);
  }
  var hasil = [];
  urutan.forEach(function (s) { (per[s] || []).forEach(function (x) { hasil.push(x); }); });
  return hasil.slice(0, maks);
}
function spbMatriks_(kumpul) {
  var m = {};
  Object.keys(SPB_ALIAS_).forEach(function (f) {
    var p = spbPilih_(kumpul[f]);
    m[f] = p ? { status: p.status, nilai: p.status === 'gambar' ? (p.nilai.length > 60000 ? '' : p.nilai) : p.nilai, jalur: p.jalur } : { status: 'kosong' };
  });
  return m;
}
function prosesShopeePembeliUji(data) {
  try {
    if (!mgApakahOwner_(data.email)) throw new Error('Uji sumber data pembeli khusus Owner.');
    var kred = ambilKredensialShopee();
    if (!kred.accessToken || !kred.shopId) throw new Error('Shopee belum terhubung. Selesaikan otorisasi dulu di Pengaturan.');
    var daftar = (data.daftar || []).map(function (x) { return String(x || '').trim(); }).filter(Boolean).slice(0, 5);
    var pilihOtomatis = !daftar.length;
    // v2026.10.40-b: pilih otomatis sampai 12 calon (3 per status), lalu dahulukan pesanan BIASA (bukan Pengiriman Kilat)
    if (pilihOtomatis) daftar = spbPilihContohPesanan_(12, 3);
    if (!daftar.length) throw new Error('Belum ada pesanan Shopee di sistem untuk diuji.');
    var batas = Date.now() + 100 * 1000;
    var laporan = [];
    // 1. get_order_detail (semua field pembeli + invoice_data; bila invoice_data ditolak, diulang tanpa itu)
    var fields = SHOPEE_FIELD_PEMBELI_ + ',package_list,order_status,shipping_carrier,invoice_data';
    var rd = shopeeGet_('/api/v2/order/get_order_detail', { order_sn_list: daftar.join(','), response_optional_fields: fields }, kred);
    if (!rd.ok && /param|field|invoice_data/i.test(rd.error + ' ' + rd.pesan)) {
      fields = SHOPEE_FIELD_PEMBELI_ + ',package_list,order_status,shipping_carrier';
      rd = shopeeGet_('/api/v2/order/get_order_detail', { order_sn_list: daftar.join(','), response_optional_fields: fields }, kred);
    }
    var orders = {};
    ((rd.ok && rd.json.response && rd.json.response.order_list) || []).forEach(function (o) { orders[String(o.order_sn)] = o; });
    if (pilihOtomatis) {
      var biasa = daftar.filter(function (sn) { return orders[sn] && orders[sn].advance_package !== true; });
      var kilat = daftar.filter(function (sn) { return orders[sn] && orders[sn].advance_package === true; });
      daftar = biasa.slice(0, 4).concat(kilat.slice(0, biasa.length ? 1 : 2)).slice(0, 5);
      if (!daftar.length) throw new Error('Pesanan contoh tidak ditemukan di Shopee.');
    }
    var inv = {}, catatInv = null;
    try { inv = spbInvoiceBatch_(kred, daftar, function (r) { catatInv = r; }, { paksa: true }); } catch (eInv) { catatInv = { ok: false, error: 'exception', pesan: String(eInv), teks: '' }; }
    var labelDiminta = data.label === true, labelSn = [];
    daftar.forEach(function (sn) {
      var o = orders[sn], baris = { sn: sn, status: o ? String(o.order_status || '') : '', username: '', buyerId: '', sumber: [] };
      if (o) {
        baris.username = String(o.buyer_username || ''); baris.buyerId = String(o.buyer_user_id || '');
        baris.usernameStatus = spbJenisNilai_(o.buyer_username);
        baris.kilat = o.advance_package === true;
        baris.labelSendiri = !!(o.package_list && o.package_list[0] && o.package_list[0].allow_self_design_awb);
      }
      var mentahOrder = o ? JSON.stringify(o).slice(0, 4000) : '';
      baris.sumber.push(Object.assign(spbRingkasPanggilan_('v2.order.get_order_detail', rd, fields), { mentah: mentahOrder || (rd.teks || '').slice(0, 1500),
        field: o ? spbMatriks_(spbKumpulkan_({ recipient_address: o.recipient_address || {} }, SPB_POLA_JALUR_)) : null, ditemukan: !!o }));
      var paket = (o && o.package_list && o.package_list[0] && o.package_list[0].package_number) || '';
      if (Date.now() < batas && paket) {
        var pk = spbPaketDetail_(kred, [paket]);
        baris.sumber.push(Object.assign(spbRingkasPanggilan_('v2.order.get_package_detail', pk.r, paket), { field: pk.r.ok ? spbMatriks_(pk.kumpul) : null }));
      }
      if (Date.now() < batas) {
        var d = spbDokumenKirim_(kred, sn, paket, { semua: true });
        baris.sumber.push(Object.assign(spbRingkasPanggilan_('v2.logistics.get_shipping_document_data_info', d.r, d.varian), { field: d.r && d.r.ok ? spbMatriks_(d.kumpul) : null, percobaan: d.percobaan || [] }));
        // v2026.10.41: gambar dari dokumen dibaca AI -> kolom tersendiri
        if (d.r && d.r.ok && Date.now() < batas) {
          var gmb = {};
          SPB_OCR_FIELD_.forEach(function (f) { var p = spbPilih_(d.kumpul[f]); if (p && p.status === 'gambar' && p.nilai.length <= 60000) gmb[f] = p.nilai; });
          if (Object.keys(gmb).length) { try { spbAntreTambah_([{ sn: sn, gambar: gmb }]); } catch (eA2) { } }
          if (Object.keys(gmb).length && spbOcrAktif_()) {
            var oc = { ok: false, pesan: 'exception' };
            try { oc = spbOcrBaca_(gmb); } catch (eO) { oc = { ok: false, pesan: String(eO.message || eO) }; }
            var mOc = {};
            Object.keys(SPB_ALIAS_).forEach(function (f) { mOc[f] = oc.data && oc.data[f] ? { status: 'terisi', nilai: oc.data[f], jalur: 'AI' } : { status: gmb[f] ? 'gambar' : 'kosong' }; });
            baris.sumber.push({ api: 'AI baca gambar dokumen kirim', ok: !!oc.ok, error: oc.ok ? '' : 'ocr', pesan: oc.pesan || '', varian: oc.model || '', mentah: oc.mentah || '', field: mOc });
          }
        }
      }
      var iv = inv[sn];
      baris.sumber.push(Object.assign(spbRingkasPanggilan_('v2.order.get_buyer_invoice_info', catatInv, ''), {
        field: iv ? spbMatriks_(iv.kumpul) : null, faktur: iv ? { diminta: iv.diminta, jenis: iv.jenis, error: iv.error } : null }));
      if (labelDiminta && SPB_STATUS_DOKUMEN_[baris.status] && !baris.kilat) labelSn.push(sn);
      laporan.push(baris);
    });
    // Ringkasan: field mana yang AKHIRNYA bisa didapat & dari API mana
    laporan.forEach(function (b) {
      var akhir = {};
      Object.keys(SPB_ALIAS_).forEach(function (f) {
        for (var i = 0; i < b.sumber.length; i++) {
          var s = b.sumber[i], fx = s.field && s.field[f];
          if (fx && fx.status === 'terisi') { akhir[f] = { nilai: fx.nilai, api: s.api, penagihan: /invoice/.test(s.api) }; break; }
        }
      });
      b.akhir = akhir;
    });
    var hasil = { success: true, daftar: daftar, laporan: laporan, varianDokumen: PropertiesService.getScriptProperties().getProperty('SPB_SDD_VARIAN') || '' };
    if (labelSn.length && Date.now() < batas) {
      var catatLabel = [];
      try { var b64 = lblPdfShopee_(labelSn.slice(0, 3), catatLabel); if (b64) hasil.labelPdf = b64; } catch (eL) { catatLabel.push({ ok: false, pesan: eL.message || String(eL) }); }
      hasil.labelHasil = catatLabel;
    }
    // Hasil uji yang terisi ikut disimpan (data asli Owner sendiri)
    try {
      var simpan = {};
      laporan.forEach(function (b) {
        var a = b.akhir, o = orders[b.sn];
        if (!o) return;
        var h = shopeeEkstrakPembeli_(o); h.status = b.status;
        ['nama', 'hp', 'alamat', 'kelurahan', 'kecamatan', 'kota', 'provinsi', 'kodePos'].forEach(function (f) { if (!h[f] && a[f] && !a[f].penagihan) { h[f] = a[f].nilai; h.sumber = h.sumber || {}; h.sumber[f] = a[f].api; } });
        spbGabungPenagihan_(h, inv[b.sn]);
        simpan[b.sn] = h;
      });
      hasil.tersimpan = spbSimpanLengkap_(simpan);
    } catch (eS) { hasil.tersimpanError = String(eS); }
    return hasil;
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

/* ####################################################################################
   PAKET 24d (v2026.10.42) - ANTREAN OCR GRATIS DI BROWSER (tanpa AI)
   Gambar data penerima dari get_shipping_document_data_info berisi teks murni -> dibaca Tesseract.js (OCR open source,
   gratis, jalan di browser admin/Owner yang sedang membuka web). Server hanya MENANGKAP gambar (tiap ±10 menit, selagi
   dokumen masih bisa diambil) ke sheet "Antrean OCR Pembeli Shopee"; browser mengambil antrean, membaca, mengirim teks.
   - Antrean dipinjam 5 menit per browser (beberapa tab/komputer tidak membaca pesanan yang sama).
   - Maks 3 percobaan per pesanan -> status Gagal (gambar tetap tersimpan untuk dilihat/diisi manual).
   - Setelah terbaca: gambar dihapus dari antrean (hemat database), hasil -> "Pembeli Shopee Lengkap" + kolom Manual
     sheet Pesanan Shopee yang MASIH KOSONG.
   Aksi: spb_ocr_antrean { maks } · spb_ocr_simpan { hasil:[{sn, data:{nama,hp,alamat,...}, gagal, catatan}] } (izin buatInvoice)
