  if (lr < 2) { props.setProperty('DEV_PAKET_DITERAPKAN', sudah.concat(antre.map(function (p) { return p.versi; })).join(',')); return 0; }
  // Baca tanpa kunci -> kunci singkat -> cek ulang ID per baris -> tulis (pola aman emulasi)
  var lock = kunciModul_('umum');
  if (!lock.tryLock(15000)) return 0; // dicoba lagi saat daftar dibuka berikutnya
  var n = 0;
  try {
    lr = sh.getLastRow();
