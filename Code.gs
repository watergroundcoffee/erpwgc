}

/* ======================================================================================
   LIVE MARKETPLACE PRICE SYNC - harga yang BENAR-BENAR tayang di Shopee & TikTok Shop
   Sumber:
     Shopee  : GET /api/v2/product/get_item_base_info  -> price_info[0] { original_price, current_price } (produk tanpa varian)
               GET /api/v2/product/get_model_list      -> model[].price_info[0]                         (produk bervarian)
               GET /api/v2/product/get_item_promotion  -> jenis promo yang sedang aktif (label saja)
     TikTok  : POST /product/202309/products/search { seller_skus } -> skus[].price (dipakai juga oleh Tokopedia)
   Disimpan ke sheet "Harga Live Marketplace" (snapshot per listing) - Master Produk TIDAK disentuh,
   karena kolom harga di Master Produk adalah harga milik ERP yang dipakai untuk push Sync Harga.
   Alert: Harga Tayang < Batas Harga Aman (HPP + komisi marketplace, eksHargaMinimum_).
   Platform yang gagal / belum terhubung pada satu putaran -> data lamanya DIPERTAHANKAN (tidak dihapus).
   Berkala: jalankan pasangTriggerSyncHargaLive() sekali dari editor (tiap 1 jam).
   ====================================================================================== */
var LIVE_SHEET_ = 'Harga Live Marketplace';
var LIVE_HEADER_ = ['Waktu Sync', 'SKU Gudang', 'Nama Produk', 'Platform', 'SKU Marketplace', 'Item / Product ID', 'Model / SKU ID',
  'Harga Normal (List)', 'Harga Tayang (Live)', 'Promo Aktif', 'Harga Jual ERP', 'Batas Harga Aman', 'Selisih Live vs ERP', 'Status', 'Catatan'];
var LIVE_KUNCI_OBJ_ = ['waktu', 'sku', 'nama', 'platform', 'kodeMp', 'idItem', 'idModel', 'hargaList', 'hargaLive', 'promo', 'hargaErp', 'batasAman', 'selisih', 'status', 'catatan'];
var LIVE_PROP_RINGKAS_ = 'HARGA_LIVE_RINGKAS';
var LIVE_PROP_WAKTU_PF_ = 'HARGA_LIVE_WAKTU_PLATFORM'; // { 'Shopee': 'yyyy-MM-dd HH:mm', 'TikTok Shop': ... } sync terakhir per marketplace
var LIVE_CACHE_JALAN_ = 'HARGA_LIVE_JALAN';
var LIVE_BATAS_WAKTU_MS_ = 270000;   // berhenti rapi sebelum batas 6 menit Apps Script
var LIVE_TOLERANSI_ERP_PCT_ = 1;     // selisih live vs ERP <= 1% dianggap sama

function getHargaLiveSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(LIVE_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(LIVE_SHEET_);
    sh.getRange(1, 1, 1, LIVE_HEADER_.length).setValues([LIVE_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('A:A').setNumberFormat('@');
    sh.getRange('E:G').setNumberFormat('@');
  }
  return sh;
}

/* ---------- Produk aktif + kode SKU Terhubung ---------- */
function liveBacaProduk_(filterSku) {
  filterSku = String(filterSku || '').trim();
  var sh = getMasterProdukSheet(), lr = sh.getLastRow();
  if (lr < 2) return [];
  var lebar = Math.max(KAT_KOL_STATUS, sh.getLastColumn());
  var vals = sh.getRange(2, 1, lr - 1, lebar).getValues();
  // Resolver yang SAMA dengan Sync Harga (kolom Produk Master + Katalog, fallback SKU Gudang)
  function kode(r, k, sku) { return syncKodeTerhubung_(sku, k === 'Shopee' ? ['Shopee'] : ['TikTok Shop', 'Tokopedia']).kode; }
  var out = [];
  vals.forEach(function (r) {
    var sku = String(r[0] || '').trim();
    if (!sku || katApakahArsip_(r[KAT_KOL_STATUS - 1])) return;
    if (filterSku && sku !== filterSku) return; // mode 1 SKU (sync_harga_live_sku)
    out.push({
      sku: sku, nama: String(r[1] || '').trim(), hpp: parseFloat(r[3]) || 0,
      hargaShopee: parseFloat(r[6]) || 0, hargaTiktok: parseFloat(r[24]) || 0,
      kodeShopee: kode(r, 'Shopee', sku), kodeTiktok: kode(r, 'TikTok Shop', sku)
    });
  });
  return out;
}

/* ---------- 1 baris snapshot + status ---------- */
function liveBaris_(waktu, p, platform, kodeMp, idA, idB, harga, promo, catatan) {
  var grup = platform === 'Shopee' ? 'shopee' : 'tiktok';
  var erp = platform === 'Shopee' ? p.hargaShopee : p.hargaTiktok;
  var list = harga ? Math.round(harga.list) : '', live = harga ? Math.round(harga.live) : '';
  var batas = p.hpp > 0 ? eksHargaMinimum_(p.hpp, grup) : '';
  var status;
  if (!harga) status = 'TIDAK DITEMUKAN';
  else if (!(live > 0)) status = 'HARGA KOSONG';
  else if (!(p.hpp > 0)) status = 'HPP KOSONG';
  else if (live < batas) status = 'DI BAWAH BATAS AMAN';
  else if (erp > 0 && Math.abs(live - erp) / erp * 100 > LIVE_TOLERANSI_ERP_PCT_) status = 'BEDA DENGAN ERP';
  else status = 'AMAN';
  var promoTeks = promo || '';
  if (list > 0 && live > 0 && live < list) promoTeks = 'Diskon ' + Math.round((1 - live / list) * 100) + '%' + (promoTeks ? ' (' + promoTeks + ')' : '');
  var selisih = (live > 0 && erp > 0) ? Math.round(live - erp) : '';
  return [waktu, p.sku, p.nama, platform, String(kodeMp || ''), String(idA || ''), String(idB || ''), list, live, promoTeks,
    erp || '', batas, selisih, status, String(catatan || '').slice(0, 300)];
}

function liveHargaShopee_(pi) {
  pi = Array.isArray(pi) ? pi[0] : pi;
  if (!pi) return null;
  var list = Number(pi.original_price) || 0, live = Number(pi.current_price) || list;
  if (!list) list = live;
  return (list > 0 || live > 0) ? { list: list, live: live } : null;
}
function liveHargaTiktok_(price) {
  price = price || {};
  var list = Number(price.tax_exclusive_price || price.original_price || price.amount || 0) || 0;
  var live = Number(price.sale_price || 0) || list;
  if (!list) list = live;
  return (list > 0 || live > 0) ? { list: list, live: live } : null;
}
function livePotong_(arr, n) { var o = []; for (var i = 0; i < arr.length; i += n) o.push(arr.slice(i, i + n)); return o; }

/* ---------- Shopee ---------- */
function liveSyncShopee_(produk, hasil, mulai, waktu) {
  var kred = ambilKredensialShopee();
  if (!kred || !kred.accessToken || !kred.shopId) { hasil.platform['Shopee'] = { ok: false, pesan: 'Token Shopee belum tersedia / kedaluwarsa - data lama dipertahankan.' }; return; }
  var rows = [], target = [];
  try {
    produk.forEach(function (p) {
      p.kodeShopee.forEach(function (kode) {
        if (Date.now() - mulai > LIVE_BATAS_WAKTU_MS_) { hasil.terpotong = true; return; }
        try {
          // SKU duplikat (>1 listing) -> SEMUA listing dibaca harganya
          syncResolveIdShopeeSemua_(kode).forEach(function (id, i, arr) {
            target.push({ p: p, kode: kode, item_id: Number(id.item_id), model_id: Number(id.model_id) || 0, dup: arr.length > 1 ? (i + 1) + '/' + arr.length : '' });
          });
        } catch (e) { rows.push(liveBaris_(waktu, p, 'Shopee', kode, '', '', null, '', e.message)); }
      });
    });
    var ids = [];
    target.forEach(function (t) { if (ids.indexOf(t.item_id) === -1) ids.push(t.item_id); });
    var info = {}, modelHarga = {}, promo = {};
    livePotong_(ids, 50).forEach(function (batch) {
      var r = syncPanggilShopee_(kred, '/api/v2/product/get_item_base_info', '&item_id_list=' + batch.join(','));
      (r.item_list || []).forEach(function (it) { info[it.item_id] = { has_model: !!it.has_model, harga: liveHargaShopee_(it.price_info) }; });
      try {
        var rp = syncPanggilShopee_(kred, '/api/v2/product/get_item_promotion', '&item_id_list=' + batch.join(','));
        (rp.success_list || []).forEach(function (s) {
          var jenis = [];
          (s.promotion || []).forEach(function (pr) { var j = String(pr.promotion_type || '').trim(); if (j && jenis.indexOf(j) === -1) jenis.push(j); });
          if (jenis.length) promo[s.item_id] = jenis.join(', ');
        });
      } catch (eP) { hasil.catatan.push('Info promo Shopee tidak terbaca: ' + eP.message); }
    });
    ids.forEach(function (itemId) {
      if (!info[itemId] || !info[itemId].has_model) return;
      if (Date.now() - mulai > LIVE_BATAS_WAKTU_MS_) { hasil.terpotong = true; return; }
      var m = syncPanggilShopee_(kred, '/api/v2/product/get_model_list', '&item_id=' + itemId);
      modelHarga[itemId] = {};
      (m.model || []).forEach(function (md) { modelHarga[itemId][md.model_id] = liveHargaShopee_(md.price_info); });
    });
    target.forEach(function (t) {
      var it = info[t.item_id], harga = null, catatan = '';
      if (!it) catatan = 'item_id ' + t.item_id + ' tidak dikembalikan Shopee (dihapus / tidak aktif?)';
      else if (!it.has_model) harga = it.harga;
      else if (modelHarga[t.item_id]) {
        if (t.model_id) harga = modelHarga[t.item_id][t.model_id] || null;
        else {
          Object.keys(modelHarga[t.item_id]).forEach(function (k) { var h = modelHarga[t.item_id][k]; if (h && (!harga || h.live < harga.live)) harga = h; });
          catatan = 'Produk bervarian tanpa model_sku cocok - dipakai harga varian TERMURAH.';
        }
        if (!harga && !catatan) catatan = 'model_id ' + t.model_id + ' tidak ditemukan di daftar varian.';
      } else { if (hasil.terpotong) return; catatan = 'Daftar varian belum terbaca.'; } // waktu habis -> listing ini dilewati (data lamanya dipertahankan)
      rows.push(liveBaris_(waktu, t.p, 'Shopee', t.kode, t.item_id, t.model_id, harga, promo[t.item_id] || '', (t.dup ? 'Listing duplikat ' + t.dup + '. ' : '') + catatan));
    });
    hasil.rows = hasil.rows.concat(rows);
    // Terpotong batas waktu: listing yang SUDAH terbaca tetap disimpan (parsial), sisanya data lama.
    // Putaran berikutnya mendahulukan produk yang datanya paling lama (lihat syncLiveMarketplacePrices).
    hasil.platform['Shopee'] = hasil.terpotong
      ? { ok: false, parsial: true, jumlah: rows.length, pesan: 'Terpotong batas waktu - ' + rows.length + ' listing diperbarui, sisanya menyusul di sync berikutnya.' }
      : { ok: true, jumlah: rows.length, pesan: '' };
  } catch (err) {
    hasil.platform['Shopee'] = { ok: false, pesan: 'Gagal membaca harga Shopee: ' + err.message + ' - data lama dipertahankan.' };
  }
}

/* ---------- TikTok Shop (+ Tokopedia, Seller Center gabungan) ---------- */
function liveTiktokCari_(skus) {
  var props = PropertiesService.getScriptProperties();
  var path = '/product/202309/products/search';
  var body = JSON.stringify({ seller_skus: skus });
  var q = { app_key: getTiktokAppKey(), shop_cipher: props.getProperty('TIKTOK_SHOP_CIPHER'), timestamp: String(Math.floor(Date.now() / 1000)), version: '202309', page_size: '100' };
  var sign = buatSignatureTikTok(path, q, body);
  var req = {
    url: 'https://open-api.tiktokglobalshop.com' + path + '?app_key=' + encodeURIComponent(q.app_key) + '&shop_cipher=' + encodeURIComponent(q.shop_cipher) +
      '&timestamp=' + q.timestamp + '&version=' + q.version + '&page_size=' + q.page_size + '&sign=' + sign,
    options: { method: 'post', contentType: 'application/json', headers: { 'x-tts-access-token': props.getProperty('TIKTOK_ACCESS_TOKEN') }, payload: body, muteHttpExceptions: true }
  };
  return syncFetchJson_(req, 'TikTok products/search');
}
function liveSyncTiktok_(produk, hasil, mulai, waktu) {
  if (!syncKredensialTersedia_('TikTok Shop')) { hasil.platform['TikTok Shop'] = { ok: false, pesan: 'Token TikTok Shop belum terpasang - data lama dipertahankan.' }; return; }
  try {
    var semua = [], unik = [];
    produk.forEach(function (p) { p.kodeTiktok.forEach(function (k) { semua.push({ p: p, kode: k }); if (unik.indexOf(k) === -1) unik.push(k); }); });
    var peta = {}, terpotong = false, diproses = {};
    livePotong_(unik, 20).forEach(function (batch) {
      if (terpotong || Date.now() - mulai > LIVE_BATAS_WAKTU_MS_) { terpotong = true; return; }
      var json = liveTiktokCari_(batch);
      batch.forEach(function (k) { diproses[k] = true; });
      ((json.data && json.data.products) || []).forEach(function (prod) {
        if (/DELETE|DRAFT/i.test(String(prod.status || ''))) return; // sama dengan Sync Harga: listing terhapus/draft diabaikan
        (prod.skus || []).forEach(function (s) {
          var k = String(s.seller_sku || '').trim();
          if (batch.indexOf(k) === -1) return;
          (peta[k] = peta[k] || []).push({ productId: String(prod.id), skuId: String(s.id), harga: liveHargaTiktok_(s.price) });
        });
      });
    });
    if (terpotong) { hasil.terpotong = true; semua = semua.filter(function (t) { return diproses[t.kode]; }); }
    var rows = semua.map(function (t) {
      var c = peta[t.kode] || [];
      if (!c.length) return liveBaris_(waktu, t.p, 'TikTok Shop', t.kode, '', '', null, '', 'seller_sku tidak ditemukan di TikTok Shop');
      // seller_sku duplikat -> 1 baris per listing (sama seperti Sync Harga yang meng-update SEMUA listing)
      return c.map(function (x, i) { return liveBaris_(waktu, t.p, 'TikTok Shop', t.kode, x.productId, x.skuId, x.harga, '', c.length > 1 ? 'Listing duplikat ' + (i + 1) + '/' + c.length + ' (semua ikut di-update saat Sync)' : ''); });
    });
    rows = [].concat.apply([], rows.map(function (r) { return Array.isArray(r[0]) ? r : [r]; }));
    hasil.rows = hasil.rows.concat(rows);
    hasil.platform['TikTok Shop'] = terpotong
      ? { ok: false, parsial: true, jumlah: rows.length, pesan: 'Terpotong batas waktu - ' + rows.length + ' listing diperbarui, sisanya menyusul di sync berikutnya.' }
      : { ok: true, jumlah: rows.length, pesan: '' };
  } catch (err) {
    hasil.platform['TikTok Shop'] = { ok: false, pesan: 'Gagal membaca harga TikTok Shop: ' + err.message + ' - data lama dipertahankan.' };
  }
}

/* ---------- Tulis snapshot (platform yang gagal -> baris lamanya dipertahankan) ---------- */
// opsi.parsial = { platform: true } -> hanya baris (SKU|platform) yang ikut terbaca yang diganti
// opsi.sku     = 'SKU'             -> hanya baris SKU itu (untuk platform yang ok) yang diganti (Single Sync)
function liveTulisSheet_(rowsBaru, platformOk, opsi) {
  opsi = opsi || {};
  var sh = getHargaLiveSheet_(), lr = sh.getLastRow(), n = LIVE_HEADER_.length;
  var lama = lr > 1 ? sh.getRange(2, 1, lr - 1, n).getValues() : [];
  var ganti = {};
  rowsBaru.forEach(function (r) { ganti[String(r[1]).trim() + '|' + r[3]] = true; });
  var semua = lama.filter(function (r) {
    var sku = String(r[1] || '').trim(), pf = r[3];
    if (!sku) return false;
    if (opsi.sku) return !(sku === opsi.sku && platformOk[pf]);
    if (platformOk[pf]) return false;
    if (opsi.parsial && opsi.parsial[pf] && ganti[sku + '|' + pf]) return false;
    return true;
  }).concat(rowsBaru);
  semua.sort(function (a, b) { return String(a[1]).localeCompare(String(b[1])) || String(a[3]).localeCompare(String(b[3])); });
  if (lr > 1) sh.getRange(2, 1, lr - 1, n).clearContent();
  if (semua.length) {
    sh.getRange(2, 1, semua.length, 1).setNumberFormat('@');
    sh.getRange(2, 5, semua.length, 3).setNumberFormat('@');
    sh.getRange(2, 1, semua.length, n).setValues(semua);
  }
  return semua;
}
function liveKeObjek_(r) { var o = {}; LIVE_KUNCI_OBJ_.forEach(function (k, i) { o[k] = r[i]; }); return o; }
function liveBacaSheet_() {
  var sh = getHargaLiveSheet_(), lr = sh.getLastRow();
  if (lr < 2) return [];
  return sh.getRange(2, 1, lr - 1, LIVE_HEADER_.length).getValues().filter(function (r) { return r[1]; }).map(liveKeObjek_);
}
/* ---------- Status koneksi marketplace (tanpa request API & tanpa refresh token - cuma baca Script Properties) ---------- */
function liveStatusKoneksi_() {
  var props = PropertiesService.getScriptProperties();
  var shopee = false, tiktok = false;
  try {
    var exp = parseInt(props.getProperty('SHOPEE_TOKEN_EXPIRED_AT') || '0', 10) || 0;
    shopee = !!props.getProperty('SHOPEE_ACCESS_TOKEN') && !!props.getProperty('SHOPEE_SHOP_ID') &&
      (exp > Date.now() || !!props.getProperty('SHOPEE_REFRESH_TOKEN'));
  } catch (e) { shopee = false; }
  try { tiktok = syncKredensialTersedia_('TikTok Shop'); } catch (e2) { tiktok = false; }
  return { 'Shopee': shopee, 'TikTok Shop': tiktok, 'Tokopedia': tiktok };
}
function liveWaktuPlatformBaca_() {
  try { return JSON.parse(PropertiesService.getScriptProperties().getProperty(LIVE_PROP_WAKTU_PF_) || '{}') || {}; } catch (e) { return {}; }
}
function liveWaktuPlatformCatat_(platform, waktu) {
  var peta = liveWaktuPlatformBaca_();
  Object.keys(platform || {}).forEach(function (pf) {
    var h = platform[pf];
    if (h && (h.ok || h.parsial)) peta[pf] = waktu;
  });
  try { PropertiesService.getScriptProperties().setProperty(LIVE_PROP_WAKTU_PF_, JSON.stringify(peta)); } catch (e) { }
  return peta;
}

function liveRingkas_(rows, waktu, platform, terpotong) {
  var alert = rows.filter(function (r) { return r[13] === 'DI BAWAH BATAS AMAN'; });
  var beda = rows.filter(function (r) { return r[13] === 'BEDA DENGAN ERP'; });
  var ringkas = function (r) { return { sku: r[1], nama: String(r[2]).slice(0, 40), platform: r[3], live: r[8], list: r[7], erp: r[10], batas: r[11] }; };
  return {
    waktu: waktu, jumlah: rows.length, alert: alert.length, beda: beda.length, terpotong: !!terpotong, platform: platform,
    alerts: alert.slice(0, 30).map(ringkas), bedaErp: beda.slice(0, 20).map(ringkas),
    waktuPlatform: liveWaktuPlatformBaca_(), koneksi: liveStatusKoneksi_()
  };
}

/* ---------- FUNGSI UTAMA ---------- */
function syncLiveMarketplacePrices(opsi) {
  opsi = opsi || {};
  // opsi.kanal: 'shopee' | 'tiktok' | '' (kosong = semua marketplace). Tombol kapsul per marketplace di Katalog > Harga.
  var kanal = opsi.kanal === 'shopee' || opsi.kanal === 'tiktok' ? opsi.kanal : '';
  var cache = CacheService.getScriptCache();
  if (cache.get(LIVE_CACHE_JALAN_) && !opsi.paksa) throw new Error('Sync Harga Aktual sedang berjalan (manual / terjadwal). Coba lagi 1-3 menit lagi.');
  cache.put(LIVE_CACHE_JALAN_, String(Date.now()), 330);
  var mulai = Date.now(), waktu = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm');
  var hasil = { success: false, waktu: waktu, rows: [], catatan: [], terpotong: false, platform: {} };
  try {
    var produk = liveBacaProduk_();
    // Produk yang snapshot-nya paling lama (atau belum pernah) dibaca duluan -> kalau putaran terpotong
    // batas waktu 6 menit, sync berikutnya melanjutkan produk sisanya (tidak mengulang dari awal terus).
    var umur = {};
    try { liveBacaSheet_().forEach(function (o) { var k = String(o.sku).trim(), w = String(o.waktu || ''); if (umur[k] === undefined || w < umur[k]) umur[k] = w; }); } catch (eU) { }
    produk.sort(function (a, b) { return String(umur[a.sku] || '').localeCompare(String(umur[b.sku] || '')); });
    if (kanal !== 'tiktok') liveSyncShopee_(produk, hasil, mulai, waktu);
    if (kanal !== 'shopee') liveSyncTiktok_(produk, hasil, mulai, waktu);
    var ok = {}, parsial = {};
    Object.keys(hasil.platform).forEach(function (k) { if (hasil.platform[k].ok) ok[k] = true; else if (hasil.platform[k].parsial) parsial[k] = true; });
    var semua = liveTulisSheet_(hasil.rows, ok, { parsial: parsial });
    liveWaktuPlatformCatat_(hasil.platform, waktu);
    // Sync 1 marketplace: status marketplace lain dari sync sebelumnya tetap ditampilkan (tidak hilang)
    var platformGabung = hasil.platform;
    if (kanal) {
      var lamaR = liveRingkasTersimpan_() || {};
      platformGabung = {};
      Object.keys(lamaR.platform || {}).forEach(function (k) { platformGabung[k] = lamaR.platform[k]; });
      Object.keys(hasil.platform).forEach(function (k) { platformGabung[k] = hasil.platform[k]; });
    }
    hasil.ringkas = liveRingkas_(semua, waktu, platformGabung, hasil.terpotong);
    hasil.ringkas.kanal = kanal;
    if (hasil.catatan.length) hasil.ringkas.catatan = hasil.catatan.slice(0, 5);
    try { PropertiesService.getScriptProperties().setProperty(LIVE_PROP_RINGKAS_, JSON.stringify(hasil.ringkas).slice(0, 8500)); } catch (eP) { }
    try { cache.remove(COPILOT_CACHE_KONTEKS_ + '_F'); cache.remove(COPILOT_CACHE_KONTEKS_ + '_S'); } catch (eC) { }
    hasil.success = true;
  } finally {
    cache.remove(LIVE_CACHE_JALAN_);
  }
  delete hasil.rows;
  return hasil;
}

/* ---------- AKSI doPost: sync_harga_live / lihat_harga_live ---------- */
function liveRingkasTersimpan_() {
  try { return JSON.parse(PropertiesService.getScriptProperties().getProperty(LIVE_PROP_RINGKAS_) || 'null'); } catch (e) { return null; }
}
function prosesSyncHargaLive(data) {
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, EKS_IZIN_)) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var kanal = data.kanal === 'shopee' || data.kanal === 'tiktok' ? data.kanal : '';
    var h = syncLiveMarketplacePrices({ kanal: kanal });
    return { success: true, kanal: kanal, ringkas: h.ringkas, data: liveBacaSheet_(), koneksi: liveStatusKoneksi_(), waktuPlatform: liveWaktuPlatformBaca_() };
  } catch (err) {
    return { success: false, error: (err && err.message) ? err.message : String(err) };
  }
}
function prosesLihatHargaLive(data) {
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, EKS_IZIN_)) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var ringkasL = liveRingkasTersimpan_();
    var koneksi = liveStatusKoneksi_(), waktuPf = liveWaktuPlatformBaca_();
    if (ringkasL) {
      ringkasL.koneksi = koneksi;
      // Data lama (sebelum ada catatan per marketplace): pakai waktu sync global untuk platform yang berhasil
      if (!Object.keys(waktuPf).length && ringkasL.platform) {
        Object.keys(ringkasL.platform).forEach(function (k) { if (ringkasL.platform[k] && (ringkasL.platform[k].ok || ringkasL.platform[k].parsial)) waktuPf[k] = ringkasL.waktu; });
      }
      ringkasL.waktuPlatform = waktuPf;
    }
    return { success: true, ringkas: ringkasL, data: liveBacaSheet_(), koneksi: koneksi, waktuPlatform: waktuPf };
  } catch (err) {
    return { success: false, error: (err && err.message) ? err.message : String(err) };
  }
}

/* ---------- SINGLE SYNC: tarik Harga Live Aktual KHUSUS 1 SKU (dipanggil otomatis setelah tombol
   [☁️ Shopee] / [☁️ TikTok & Tokopedia] berhasil) ----------
   data: { sku, kanal: 'shopee' | 'tiktok' | '' (keduanya), hargaHarap: Harga Coret yang barusan dikirim }
   - Hanya baris SKU itu (platform yang berhasil dibaca) yang diganti di sheet "Harga Live Marketplace".
   - Ringkasan + alert "di bawah batas aman" DIHITUNG ULANG dari seluruh sheet -> reminder ikut hilang
     begitu harga tayang sudah benar.
   - Marketplace kadang butuh beberapa detik untuk menampilkan harga baru setelah update_price:
     kalau harga normal yang terbaca belum sama dengan hargaHarap, dibaca ulang 1x setelah 4 detik. */
function syncHargaLiveSatuSku_(sku, kanal, hargaHarap) {
  var p = liveBacaProduk_(sku)[0];
  if (!p) throw new Error('SKU ' + sku + ' tidak ditemukan / sudah diarsip');
  var mulai = Date.now(), waktu = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm');
  function baca() {
    var h = { rows: [], catatan: [], terpotong: false, platform: {} };
    if (kanal !== 'tiktok') liveSyncShopee_([p], h, mulai, waktu);
    if (kanal !== 'shopee') liveSyncTiktok_([p], h, mulai, waktu);
    return h;
  }
  var hasil = baca();
  var harap = Math.round(Number(hargaHarap) || 0);
  var belumBaru = function (h) { return harap > 0 && h.rows.some(function (r) { return Number(r[7]) > 0 && Math.abs(Number(r[7]) - harap) > 1; }); };
  if (belumBaru(hasil)) { Utilities.sleep(4000); hasil = baca(); }
  var ok = {};
  Object.keys(hasil.platform).forEach(function (k) { if (hasil.platform[k].ok) ok[k] = true; });

  var lock = kunciModul_('hargaLive');
  if (!lock.tryLock(20000)) throw new Error('Sheet Harga Live sedang ditulis proses lain - coba lagi sebentar.');
  var semua;
  try { semua = liveTulisSheet_(hasil.rows, ok, { sku: sku }); }
  finally { lock.releaseLock(); }

  var lama = liveRingkasTersimpan_() || {};
  // Info status platform tetap dari sync global terakhir (single sync tidak menimpa pesannya)
  var ringkas = liveRingkas_(semua, lama.waktu || waktu, lama.platform || hasil.platform, !!lama.terpotong);
  ringkas.terakhirSku = { sku: sku, waktu: waktu };
  if (lama.catatan) ringkas.catatan = lama.catatan;
  try { PropertiesService.getScriptProperties().setProperty(LIVE_PROP_RINGKAS_, JSON.stringify(ringkas).slice(0, 8500)); } catch (eP) { }
  try { var c = CacheService.getScriptCache(); c.remove(COPILOT_CACHE_KONTEKS_ + '_F'); c.remove(COPILOT_CACHE_KONTEKS_ + '_S'); } catch (eC) { }
  return {
    ringkas: ringkas, platform: hasil.platform, waktu: waktu,
    data: semua.filter(function (r) { return String(r[1]).trim() === sku; }).map(liveKeObjek_)
  };
}
