// ===== AKSI: fin_impor_mutasi_bank { akun, namaFile, baris: [{ tanggal:'yyyy-MM-dd[ HH:mm]', ket, masuk, keluar, saldo }] } =====
function prosesFinImporMutasiBank(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var akun = String(data.akun || '').replace(/\s+/g, ' ').trim().slice(0, 60);
    if (!akun) throw new Error('Isi nama rekening (mis. BCA 1234)');
    var baris = Array.isArray(data.baris) ? data.baris : [];
    if (!baris.length) throw new Error('Tidak ada baris mutasi untuk diimpor');
    if (baris.length > 5000) throw new Error('Maksimal 5.000 baris per impor - pecah file per bulan');
    var bersih = [], ditolak = 0;
    baris.forEach(function (b) {
      var t = String(b.tanggal || '').trim();
      if (!/^\d{4}-\d{2}-\d{2}( \d{2}:\d{2})?$/.test(t)) { ditolak++; return; }
      var masuk = Math.abs(Math.round(finAngka_(b.masuk) * 100) / 100), keluar = Math.abs(Math.round(finAngka_(b.keluar) * 100) / 100);
      if (!masuk && !keluar) { ditolak++; return; }
      var saldo = b.saldo === '' || b.saldo === null || b.saldo === undefined || !isFinite(parseFloat(b.saldo)) ? '' : Math.round(parseFloat(b.saldo) * 100) / 100;
      var idKlien = /^BNK-[A-Za-z0-9_-]{8,40}$/.test(String(b.id || '')) ? String(b.id) : '';
      bersih.push({ id: idKlien, t: t, ket: String(b.ket || '').replace(/\s+/g, ' ').trim().slice(0, 250), masuk: masuk, keluar: keluar, saldo: saldo });
    });
    if (!bersih.length) throw new Error('Semua baris tidak valid - cek pemetaan kolom tanggal & nominal');
  } catch (errV) { result.error = errV.toString(); return result; }

  var lock = kunciModul_('mutasi_kas');
  try { lock.waitLock(20000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  try {
    var sh = getMutasiKasSheet_(), lr = sh.getLastRow(), tzI = Session.getScriptTimeZone();
    var adaId = {}, adaIsi = {}, kembarAda = {};
    // Anti dobel berdasarkan ISI baris (akun, tanggal, keterangan, nominal, saldo + urutan kemunculan) -
    // impor ulang file yang sama / file yang periodenya tumpang tindih tidak membuat baris dobel.
    function kunciIsi(akunX, t, ket, masuk, keluar, saldo) {
      return [String(akunX).toLowerCase(), String(t).slice(0, 16), String(ket).replace(/\s+/g, ' ').trim().toLowerCase(), Number(masuk) || 0, Number(keluar) || 0, saldo === '' || saldo === null ? '' : Number(saldo)].join('|');
    }
    if (lr > 1) sh.getRange(2, 1, lr - 1, 8).getValues().forEach(function (r) {
      var idA = String(r[0]); adaId[idA] = 1;
      var k = kunciIsi(r[2], mkTanggal_(r[1], tzI), r[4], finAngka_(r[5]), finAngka_(r[6]), r[7] === '' ? '' : finAngka_(r[7]));
      kembarAda[k] = (kembarAda[k] || 0) + 1;
      adaIsi[k + '#' + kembarAda[k]] = idA;
    });
    var kembar = {}, tulis = [], dobel = 0, petaId = {};
    var batch = 'B' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyMMdd-HHmmss');
    var oleh = getNamaStaff(data.email) || data.email || '', sekarang = new Date();
    bersih.forEach(function (b) {
      var dasar = kunciIsi(akun, b.t, b.ket, b.masuk, b.keluar, b.saldo);
      kembar[dasar] = (kembar[dasar] || 0) + 1;
      var idLama = adaIsi[dasar + '#' + kembar[dasar]];
      if (idLama) { dobel++; if (b.id && b.id !== idLama) petaId[b.id] = idLama; return; }
      var id = b.id && !adaId[b.id] ? b.id : 'BNK-' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, dasar + '#' + kembar[dasar])).slice(0, 18);
      if (adaId[id]) { dobel++; if (b.id && b.id !== id) petaId[b.id] = id; return; }
      if (b.id && b.id !== id) petaId[b.id] = id;
      adaId[id] = 1;
      tulis.push([id, b.t, akun, 'Bank', b.ket, b.masuk || '', b.keluar || '', b.saldo, '', String(data.namaFile || '').slice(0, 80), batch, sekarang, oleh]);
    });
    if (tulis.length) sh.getRange(lr + 1, 1, tulis.length, MK_HEADER.length).setValues(tulis);
    SpreadsheetApp.flush();
    mkInvalidasi_();
    result.success = true;
    result.baru = tulis.length; result.dobel = dobel; result.ditolak = ditolak; result.batch = tulis.length ? batch : ''; result.petaId = petaId;
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

