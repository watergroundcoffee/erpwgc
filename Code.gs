/* ======================================================================================
   PRICE STRATEGY AUTOMATION & ACTION SCHEDULER  (OmniAI)
   Apps Script tidak punya database/Redis/BullMQ -> "tabel" = sheet, "queue worker" = time trigger
   + kunciModul_('scheduler'). Tiga tabel:
     - action_logs     = sheet "Execution_Logs"  (SUDAH ADA - dipakai ulang, audit trail tetap 1 tempat)
     - scheduled_tasks = sheet "Scheduled_Tasks" (agenda masa depan: PENDING/PROCESSING/DONE/FAILED/CANCELLED)
     - log_api_errors  = sheet "Log_API_Errors"  (respons mentah marketplace: error, message, request_id, failure_list)
   SEKALI dari editor: pasangTriggerWorkerTugas()  (worker tiap 5 menit). sptJadwalkan_() juga memasangnya otomatis.
   Penolakan harga Shopee karena PROMO -> otomatis jadi agenda (lepas diskon toko / tunggu promo platform selesai).
   Sakelar Script Property SYNC_PROMO_AUTO_LEPAS = '0' -> listing TIDAK dilepas otomatis dari diskon toko.
   ====================================================================================== */
var SPT_SHEET_ = 'Scheduled_Tasks';
var SPT_HEADER_ = ['Task_ID', 'Execution_Time', 'Status', 'Action_Name', 'SKU', 'Parameters', 'Created_At', 'Created_By', 'Attempts', 'Last_Result', 'Updated_At'];
var SPT_MAKS_PERCOBAAN_ = 5;        // gagal teknis -> diulang maks 5x (jeda 15, 30, 45 ... menit)
var SPT_MAKS_TUNDA_ = 20;           // RETRY karena promo belum selesai -> maks 20x
var SPT_BATAS_WAKTU_MS_ = 240000;   // worker berhenti rapi sebelum batas 6 menit
var SPT_MACET_MS_ = 30 * 60000;     // PROCESSING > 30 menit = eksekusi mati di tengah jalan -> PENDING lagi
var APIERR_SHEET_ = 'Log_API_Errors';
var APIERR_HEADER_ = ['Timestamp', 'Platform', 'Endpoint', 'SKU/Target', 'HTTP', 'error', 'message', 'detail (request_id / failure_list)', 'Request Body'];
var SYNC_REGEX_PROMO_ = /promo|promotion|campaign|discount|flash.?sale|in.?activity|ongoing.?activit|sedang ikut/i;
var SHOPEE_INDEKS_UMUR_MAKS_MS_ = 6 * 3600000; // indeks SKU Shopee dibangun ulang bila lebih tua dari 6 jam
var SHOPEE_INDEKS_DICOBA_ = false;             // maks 1x bangun indeks per eksekusi
var SPT_MAKS_TUNGGU_PROMO_MS_ = 30 * 86400000; // promo yang baru selesai > 30 hari lagi tidak ditunggu lewat agenda

function sptFmt_(v) {
  if (!v) return '-';
  var d = v instanceof Date ? v : new Date(typeof v === 'number' && v < 1e12 ? v * 1000 : v);
  return isNaN(d.getTime()) ? String(v) : Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm');
}

/* ---------- log_api_errors ---------- */
function getApiErrorsSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(APIERR_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(APIERR_SHEET_);
    sh.getRange(1, 1, 1, APIERR_HEADER_.length).setValues([APIERR_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('D:D').setNumberFormat('@');
  }
  return sh;
}
function apiErrCatat_(platform, endpoint, target, body, http, json, teksMentah) {
  try {
    json = json || {};
    var resp = json.response || json.data || {};
    var detail = { request_id: json.request_id || '', code: json.code, failure_list: resp.failure_list, error_list: resp.error_list, warning: json.warning };
    var sh = getApiErrorsSheet_();
    sh.appendRow([new Date(), platform, endpoint, String(target || ''), http || '',
      String(json.error || (json.code !== undefined && json.code !== 0 ? json.code : '') || ''),
      String(json.message || (teksMentah ? String(teksMentah).slice(0, 300) : '')),
      JSON.stringify(detail).slice(0, 20000),
      (typeof body === 'string' ? body : JSON.stringify(body || '')).slice(0, 20000)]);
    if (sh.getLastRow() > 2000) sh.deleteRows(2, sh.getLastRow() - 2000);
  } catch (e) { console.error('Log_API_Errors gagal ditulis: ' + e); }
}
function prosesLihatApiErrors(data) {
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, EKS_IZIN_)) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getApiErrorsSheet_(), lr = sh.getLastRow(), n = Math.min(200, Math.max(1, parseInt(data.limit, 10) || 50));
    if (lr < 2) return { success: true, data: [] };
    var cari = String(data.sku || '').trim().toUpperCase();
    var rows = sh.getRange(2, 1, lr - 1, APIERR_HEADER_.length).getDisplayValues().reverse()
      .filter(function (r) { return !cari || String(r[3]).toUpperCase().indexOf(cari) !== -1; }).slice(0, n);
    return { success: true, data: rows.map(function (r) { var o = {}; APIERR_HEADER_.forEach(function (h, i) { o[h] = r[i]; }); return o; }) };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

/* ---------- scheduled_tasks: tabel ---------- */
function getScheduledTasksSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(SPT_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(SPT_SHEET_);
    sh.getRange(1, 1, 1, SPT_HEADER_.length).setValues([SPT_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('A:A').setNumberFormat('@');
    sh.getRange('E:F').setNumberFormat('@');
  }
  return sh;
}
function sptBarisKeObjek_(r, row) {
  var p = {}; try { p = JSON.parse(r[5] || '{}'); } catch (e) { }
  return { row: row, id: String(r[0] || '').trim(), waktu: r[1] instanceof Date ? r[1] : new Date(r[1]), status: String(r[2] || '').trim().toUpperCase(),
    action: String(r[3] || '').trim().toUpperCase(), sku: String(r[4] || '').trim(), params: p, dibuat: r[6], oleh: String(r[7] || ''),
    percobaan: Number(r[8]) || 0, hasil: String(r[9] || ''), diperbarui: r[10] };
}
function sptBacaSemua_() {
  var sh = getScheduledTasksSheet_(), lr = sh.getLastRow();
  if (lr < 2) return [];
  return sh.getRange(2, 1, lr - 1, SPT_HEADER_.length).getValues().map(function (r, i) { return sptBarisKeObjek_(r, i + 2); }).filter(function (t) { return t.id; });
}
function sptTulis_(row, f) {
  var sh = getScheduledTasksSheet_();
  if (f.waktu) sh.getRange(row, 2).setValue(f.waktu);
  if (f.status) sh.getRange(row, 3).setValue(f.status);
  if (f.params) sh.getRange(row, 6).setValue(JSON.stringify(f.params).slice(0, 45000));
  if (f.percobaan !== undefined) sh.getRange(row, 9).setValue(f.percobaan);
  if (f.hasil !== undefined) sh.getRange(row, 10).setValue(String(f.hasil).slice(0, 2000));
  sh.getRange(row, 11).setValue(new Date());
}
function sptDenganLock_(fn, ms) {
  var lock = kunciModul_('scheduler');
  if (!lock.tryLock(ms || 15000)) throw new Error('Scheduler sedang sibuk (worker berjalan) - coba lagi sebentar.');
  try { return fn(); } finally { lepasKunci_(lock); }
}

/* ---------- scheduled_tasks: buat / batal / daftar ---------- */
function sptJadwalkan_(action, sku, waktu, params, oleh) {
  var id = 'T' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyMMddHHmmss') + Math.floor(100 + Math.random() * 900);
  var now = new Date(), w = waktu instanceof Date ? waktu : new Date(waktu);
  if (isNaN(w.getTime())) throw new Error('Waktu eksekusi agenda tidak valid.');
  // appendRow atomik -> tidak perlu menunggu lock worker (baris tidak pernah dihapus, nomor baris stabil)
  getScheduledTasksSheet_().appendRow([id, w, 'PENDING', String(action).toUpperCase(), String(sku || ''), JSON.stringify(params || {}).slice(0, 45000), now, String(oleh || ''), 0, '', now]);
  SpreadsheetApp.flush();
  sptPastikanTrigger_();
  try { CacheService.getScriptCache().remove(COPILOT_CACHE_KONTEKS_ + '_F'); } catch (e) { }
  return { taskId: id, waktu: w };
}
function sptCariPending_(cocok) {
  var semua = sptBacaSemua_();
  for (var i = 0; i < semua.length; i++) if ((semua[i].status === 'PENDING' || semua[i].status === 'PROCESSING') && cocok(semua[i])) return semua[i];
  return null;
}
function sptBatalkanTugas_(taskId, oleh, alasan) {
  var id = String(taskId || '').trim();
  var out = { target: 'Task ' + (id || '-'), newValue: 'CANCELLED' };
  if (!id) { out.status = 'FAILED'; out.pesan = 'task_id wajib diisi (lihat GET_SCHEDULED_TASKS).'; return out; }
  return sptDenganLock_(function () {
    var t = sptBacaSemua_().filter(function (x) { return x.id === id; })[0];
    if (!t) { out.status = 'FAILED'; out.pesan = 'Agenda ' + id + ' tidak ditemukan.'; return out; }
    out.oldValue = t.status + ' · ' + t.action + ' ' + t.sku + ' @ ' + sptFmt_(t.waktu);
    if (t.status !== 'PENDING') { out.status = 'FAILED'; out.pesan = 'Hanya agenda PENDING yang bisa dibatalkan (status ' + id + ' sekarang ' + t.status + ').'; return out; }
    sptTulis_(t.row, { status: 'CANCELLED', hasil: 'Dibatalkan oleh ' + oleh + (alasan ? ' - ' + alasan : '') });
    out.status = 'SUCCESS';
    out.pesan = 'Agenda ' + id + ' (' + t.action + ' ' + t.sku + ', dijadwalkan ' + sptFmt_(t.waktu) + ') DIBATALKAN. Tidak ada perubahan di marketplace.';
    return out;
  });
}
function sptDaftar_(filter) {
  filter = filter || {};
  var st = String(filter.status || 'SEMUA').toUpperCase(), sku = String(filter.sku || '').trim().toUpperCase();
  var d = sptBacaSemua_().filter(function (t) {
    return (st === 'SEMUA' || st === 'ALL' || t.status === st) && (!sku || t.sku.toUpperCase() === sku);
  });
  d.sort(function (a, b) {
    var pa = a.status === 'PENDING' || a.status === 'PROCESSING', pb = b.status === 'PENDING' || b.status === 'PROCESSING';
    if (pa !== pb) return pa ? -1 : 1;
    return pa ? a.waktu - b.waktu : (new Date(b.diperbarui) - new Date(a.diperbarui));
  });
  return d.slice(0, Math.min(100, Math.max(1, parseInt(filter.limit, 10) || 20)));
}
function sptRingkasParams_(t) {
  var p = t.params || {};
  if (t.action === 'CREATE_DISCOUNT') return 'promo -' + p.diskon_persen + '% → ' + eksRp_(p.harga_promo) + ' (dasar ' + eksRp_(p.harga_dasar) + '), mulai ' + sptFmt_(p.mulai_promo_ms) + ', ' + (p.listing || []).length + ' listing';
  if (t.action === 'PROMO_UNLOCK_UPDATE_PRICE' || t.action === 'RETRY_UPDATE_PRICE') return 'kirim ulang harga ' + eksRp_(p.harga_coret) + ' ke item ' + p.item_id + (p.model_id ? '/model ' + p.model_id : '') + (p.discount_ids ? ', lepas diskon ' + p.discount_ids.join(',') : '');
  return JSON.stringify(p).slice(0, 120);
}
function sptKeObjekPublik_(t) {
  return { task_id: t.id, status: t.status, action: t.action, sku: t.sku, eksekusi: sptFmt_(t.waktu), ringkas: sptRingkasParams_(t), percobaan: t.percobaan, hasil_terakhir: t.hasil, dibuat_oleh: t.oleh, dibuat: sptFmt_(t.dibuat) };
}

/* ---------- Worker (queue consumer) ---------- */
function jalankanWorkerTugasTerjadwal() {
  var mulai = Date.now(), ringkas = { dijalankan: 0, sukses: 0, gagal: 0, ditunda: 0 };
  try { PropertiesService.getScriptProperties().setProperty('AIW_WORKER_TERAKHIR', String(mulai)); } catch (eHb) { } // heartbeat untuk health bar AI Agent
  while (Date.now() - mulai < SPT_BATAS_WAKTU_MS_) {
    // 1) KLAIM 1 agenda yang jatuh tempo (di dalam lock -> 2 worker tidak pernah mengambil agenda yang sama)
    var t = null;
    try {
      t = sptDenganLock_(function () {
        var now = Date.now(), semua = sptBacaSemua_();
        semua.forEach(function (x) { // eksekusi mati di tengah jalan -> kembalikan ke antrean
          if (x.status === 'PROCESSING' && x.diperbarui instanceof Date && now - x.diperbarui.getTime() > SPT_MACET_MS_) sptTulis_(x.row, { status: 'PENDING', hasil: 'Direset: macet di PROCESSING > 30 menit' });
        });
        var due = semua.filter(function (x) { return x.status === 'PENDING' && x.waktu.getTime() <= now; }).sort(function (a, b) { return a.waktu - b.waktu; })[0];
        if (!due) return null;
        due.percobaan++;
        sptTulis_(due.row, { status: 'PROCESSING', percobaan: due.percobaan });
        return due;
      }, 5000);
    } catch (eLock) { Logger.log('Worker: ' + eLock.message); break; }
    if (!t) break;

    // 2) EKSEKUSI di luar lock (supaya pembatalan / penjadwalan lain tidak tertahan)
    var h;
    try {
      t.simpanParams = function (p) { sptTulis_(t.row, { params: p }); };
      h = denganIzinSistem_(function () { return sptJalankanSatu_(t); }) || { status: 'FAILED', pesan: 'Handler tidak mengembalikan hasil.' };
    } catch (e) { h = { status: 'FAILED', pesan: (e && e.message) || String(e), bolehUlang: true }; }
    ringkas.dijalankan++;

    // 3) HASIL -> DONE / PENDING (diulang) / FAILED + catat ke action_logs (Execution_Logs)
    var status, waktuBaru = null;
    if (h.status === 'SUCCESS') { status = 'DONE'; ringkas.sukses++; }
    else if (h.status === 'RETRY' && t.percobaan < SPT_MAKS_TUNDA_) { status = 'PENDING'; waktuBaru = h.ulangPada || new Date(Date.now() + 6 * 3600000); ringkas.ditunda++; }
    else if (h.status !== 'RETRY' && h.bolehUlang && t.percobaan < SPT_MAKS_PERCOBAAN_) { status = 'PENDING'; waktuBaru = new Date(Date.now() + 15 * 60000 * t.percobaan); ringkas.ditunda++; }
    else { status = 'FAILED'; ringkas.gagal++; }
    if (waktuBaru && waktuBaru.getTime() < Date.now() + 10 * 60000) waktuBaru = new Date(Date.now() + 10 * 60000); // jangan berputar di putaran yang sama
    try { sptDenganLock_(function () { sptTulis_(t.row, { status: status, waktu: waktuBaru, hasil: (status === 'PENDING' ? '[diulang ' + sptFmt_(waktuBaru) + '] ' : '') + (h.pesan || '') }); }, 30000); }
    catch (eT) { sptTulis_(t.row, { status: status, waktu: waktuBaru, hasil: h.pesan || '' }); }
    eksCatatLog_('Scheduler · ' + t.id + ' (dibuat ' + t.oleh + ')', t.action, t.sku || '-', '', t.params,
      status === 'DONE' ? 'SUCCESS' : status === 'PENDING' ? 'RETRY_SCHEDULED' : 'FAILED', { taskId: t.id, pesan: h.pesan, respon: h.respon });
    try { memoryCatatEksekusi_(t.action, { status: status === 'DONE' ? 'SUCCESS' : 'FAILED', pesan: h.pesan, target: t.sku }, 'Scheduler'); } catch (eM) { }
  }
  try { var c = CacheService.getScriptCache(); c.remove(COPILOT_CACHE_KONTEKS_ + '_F'); c.remove(COPILOT_CACHE_KONTEKS_ + '_S'); } catch (eC) { }
  if (ringkas.dijalankan) Logger.log('Worker agenda: ' + JSON.stringify(ringkas));
  return ringkas;
}
function sptJalankanSatu_(t) {
  if (t.action === 'CREATE_DISCOUNT') return sptHandlerCreateDiscount_(t);
  if (t.action === 'PROMO_UNLOCK_UPDATE_PRICE') return sptProsesHargaTerkunci_(t, true);
  if (t.action === 'RETRY_UPDATE_PRICE') return sptProsesHargaTerkunci_(t, PropertiesService.getScriptProperties().getProperty('SYNC_PROMO_AUTO_LEPAS') !== '0');
  return { status: 'FAILED', pesan: 'Action agenda tidak dikenal: ' + t.action };
}
function sptPastikanTrigger_() {
  try {
    var ada = ScriptApp.getProjectTriggers().some(function (tr) { return tr.getHandlerFunction() === 'jalankanWorkerTugasTerjadwal'; });
    if (!ada) ScriptApp.newTrigger('jalankanWorkerTugasTerjadwal').timeBased().everyMinutes(5).create();
  } catch (e) { Logger.log('Trigger worker agenda belum bisa dipasang otomatis (' + e.message + ') - jalankan pasangTriggerWorkerTugas() dari editor.'); }
}
function pasangTriggerWorkerTugas() {
  ScriptApp.getProjectTriggers().forEach(function (tr) { if (tr.getHandlerFunction() === 'jalankanWorkerTugasTerjadwal') ScriptApp.deleteTrigger(tr); });
  ScriptApp.newTrigger('jalankanWorkerTugasTerjadwal').timeBased().everyMinutes(5).create();
  getScheduledTasksSheet_(); getApiErrorsSheet_();
  Logger.log('Trigger worker agenda terpasang: tiap 5 menit. Sheet Scheduled_Tasks & Log_API_Errors siap.');
}

/* ---------- Shopee helper (POST + log error mentah; DRY_RUN -> simulasi) ---------- */
function sptShopeePost_(path, body, label, target) {
  if (getSyncHargaMode_() !== 'LIVE') {
    promoLog_('SIMULASI ' + label, { body: body });
    return { ok: true, simulasi: true, pesan: '', resp: { discount_id: 'SIMULASI' }, json: {} };
  }
  var r = promoShopeePost_(path, body);
  promoLog_('Shopee ' + label, { body: body, hasil: r.json });
  var errList = (r.resp && r.resp.error_list) || [];
  if (!r.ok || errList.length) apiErrCatat_('Shopee', label, target, body, '', r.json || { message: r.pesan });
  if (!r.ok && r.json && r.json.error) r.pesan = 'Shopee Reject: ' + r.json.error + (r.json.message ? ' - ' + r.json.message : '');
  return r;
}
// Promo yang sedang/akan berjalan pada 1 item Shopee: diskon toko (bisa dilepas via API) vs promo lain (Campaign, Flash Sale, ...)
function sptInfoPromoItem_(itemId) {
  var out = { ok: true, diskonToko: [], lain: [], akhirTerlama: 0 };
  var r = promoShopeeGet_('/api/v2/product/get_item_promotion', { item_id_list: String(itemId) });
  if (!r.ok) { out.ok = false; out.pesan = r.pesan; apiErrCatat_('Shopee', 'v2.product.get_item_promotion', 'item ' + itemId, { item_id_list: itemId }, '', r.json || { message: r.pesan }); return out; }
  (r.resp.success_list || []).forEach(function (s) {
    (s.promotion || []).forEach(function (pr) {
      var jenis = String(pr.promotion_type || '').trim(), akhir = Number(pr.end_time) || 0;
      if (akhir > out.akhirTerlama) out.akhirTerlama = akhir;
      if (/^discount/i.test(jenis)) { if (!out.diskonToko.some(function (d) { return d.id === pr.promotion_id; })) out.diskonToko.push({ id: pr.promotion_id, tahap: String(pr.promotion_staging || ''), akhir: akhir }); }
      else out.lain.push(jenis + (akhir ? ' s/d ' + sptFmt_(akhir) : ''));
    });
  });
  return out;
}

/* ---------- Shopee: listing ditolak karena promo -> jadi agenda ---------- */
function sptTanganiBlokirPromoShopee_(c) {
  var itemId = Number(c.item_id), modelId = Number(c.model_id) || 0;
  var ada = sptCariPending_(function (t) {
    return (t.action === 'PROMO_UNLOCK_UPDATE_PRICE' || t.action === 'RETRY_UPDATE_PRICE') && Number(t.params.item_id) === itemId && (Number(t.params.model_id) || 0) === modelId;
  });
  if (ada) return { taskId: ada.id, ringkas: '⏰ Sudah ada agenda ' + ada.id + ' untuk listing ini (' + ada.action + ', ' + sptFmt_(ada.waktu) + ')' };
  var otomatis = PropertiesService.getScriptProperties().getProperty('SYNC_PROMO_AUTO_LEPAS') !== '0';
  var info = sptInfoPromoItem_(itemId);
  var params = { sku: c.sku, kode_mp: c.kodeMp, item_id: itemId, model_id: modelId, harga_coret: Math.round(c.hargaCoret), toko: c.toko || '', __email: c.email || '', alasan_awal: String(c.pesan || '').slice(0, 300) };
  var oleh = 'Sistem (Sync Harga) - ' + (c.email || 'tidak dikenal');
  if (otomatis && info.diskonToko.length && !info.lain.length) {
    params.discount_ids = info.diskonToko.map(function (d) { return d.id; });
    var j = sptJadwalkan_('PROMO_UNLOCK_UPDATE_PRICE', c.sku, new Date(Date.now() + 60000), params, oleh);
    return { taskId: j.taskId, ringkas: '⏰ Terkunci diskon toko ' + params.discount_ids.join(', ') + ' → dijadwalkan: lepas listing dari diskon lalu kirim ulang harga (Task ' + j.taskId + ', ±5 menit)' };
  }
  // Program/promo Shopee yang berlaku sangat lama (mis. s/d 2029) -> TIDAK dijadwalkan (agenda bertahun-tahun tidak berguna)
  if (info.akhirTerlama && info.akhirTerlama * 1000 - Date.now() > SPT_MAKS_TUNGGU_PROMO_MS_) {
    return { taskId: null, ringkas: '⛔ Terkunci program Shopee "' + (info.lain.join(', ') || 'promo') + '" - tidak bisa dilepas via API & terlalu lama untuk ditunggu. Keluarkan listing dari program ini di Seller Centre, lalu Sync ulang.' };
  }
  // Campaign / Flash Sale Shopee tidak bisa dilepas via API -> kirim ulang 10 menit setelah promo terakhir selesai
  var waktu = info.akhirTerlama ? new Date(info.akhirTerlama * 1000 + 10 * 60000) : new Date(Date.now() + 6 * 3600000);
  if (waktu.getTime() < Date.now() + 60000) waktu = new Date(Date.now() + 60000);
  var j2 = sptJadwalkan_('RETRY_UPDATE_PRICE', c.sku, waktu, params, oleh);
  return { taskId: j2.taskId, ringkas: '⏰ Terkunci promo ' + (info.lain.join(', ') || (info.diskonToko.length ? 'diskon toko' : 'aktif')) +
    ' → harga dikirim ulang otomatis ' + sptFmt_(waktu) + ' (Task ' + j2.taskId + ')' + (!otomatis && info.diskonToko.length ? ' · auto-lepas diskon dimatikan (SYNC_PROMO_AUTO_LEPAS=0)' : '') };
}

// Handler PROMO_UNLOCK_UPDATE_PRICE / RETRY_UPDATE_PRICE: (lepas diskon toko) -> kirim Harga Coret TERBARU dari Master Produk
function sptProsesHargaTerkunci_(t, bolehLepas) {
  var p = t.params || {};
  var prod = eksBacaProduk_(p.sku, p.toko);
  var hpp = prod.hpp, hargaFinal = parseFloat(prod.r[6]) || 0, coret = parseFloat(prod.r[27]) || 0;
  syncGerbangHarga_(hpp, hargaFinal, coret);
  if (coret < hargaFinal) return { status: 'FAILED', pesan: 'Harga Coret Shopee (' + eksRp_(coret) + ') < Harga Jual Final (' + eksRp_(hargaFinal) + ') - perbaiki di menu Harga.' };
  var catatanHarga = Math.round(coret) !== Math.round(p.harga_coret) ? ' (harga coret berubah sejak dijadwalkan: ' + eksRp_(p.harga_coret) + ' → ' + eksRp_(coret) + ', dipakai yang terbaru)' : '';
  var info = sptInfoPromoItem_(p.item_id), dilepas = [];
  if (bolehLepas && info.diskonToko.length) {
    info.diskonToko.forEach(function (d) {
      var r = sptShopeePost_('/api/v2/discount/delete_discount_item', { discount_id: Number(d.id), item_id: Number(p.item_id), model_id: Number(p.model_id) || 0 }, 'v2.discount.delete_discount_item', p.sku);
      dilepas.push(d.id + (r.ok ? ' ✓' : ' ✗ ' + r.pesan));
    });
    Utilities.sleep(3000);
  }
  var req = syncSusunRequestShopee_(p.kode_mp, coret, 'LIVE', false, { item_id: p.item_id, model_id: p.model_id, sumber: 'task' });
  syncPastikanHargaCoretDiPayload_(req, coret, hargaFinal);
  try { syncEksekusiRequest_(req, 'LIVE'); }
  catch (e) {
    var m = String(e && e.message || e);
    if (e && e.promo && info.akhirTerlama && info.akhirTerlama * 1000 - Date.now() > SPT_MAKS_TUNGGU_PROMO_MS_)
      return { status: 'FAILED', pesan: 'Terkunci program Shopee "' + (info.lain.join(', ') || 'promo') + '" yang berlaku sangat lama - keluarkan listing dari program ini di Seller Centre, lalu Sync ulang. ' + m };
    if (e && e.promo) return { status: 'RETRY', ulangPada: new Date(info.akhirTerlama ? info.akhirTerlama * 1000 + 10 * 60000 : Date.now() + 6 * 3600000),
      pesan: 'Masih terkunci promo (' + (info.lain.join(', ') || 'diskon toko') + ')' + (dilepas.length ? '; dilepas: ' + dilepas.join(', ') : '') + '. ' + m };
    return { status: 'FAILED', bolehUlang: !/sign|permission|forbidden|HTTP 403/i.test(m), pesan: m };
  }
  syncCatatLog_(p.sku, 'Shopee', p.kode_mp + ' [item ' + p.item_id + '/model ' + (p.model_id || 0) + ']', 'LIVE', coret, hargaFinal, 'OK', 'Terkirim oleh agenda ' + t.id + (dilepas.length ? ' setelah lepas diskon ' + dilepas.join(', ') : ''), req);
  try { katTulisDiBarisSku_(prod.sh, prod.sku, function (b) { prod.sh.getRange(b, 27).setValue(new Date()); }); invalidasiCacheKatalogHarga(p.toko); } catch (eW) { }
  return { status: 'SUCCESS', pesan: 'Harga dasar ' + eksRp_(coret) + ' terkirim ke Shopee item ' + p.item_id + (p.model_id ? '/model ' + p.model_id : '') + catatanHarga + (dilepas.length ? '. Listing dilepas dari diskon: ' + dilepas.join(', ') : '') + '.' };
}

/* ---------- ORCHESTRATOR: AUTOMATE_PRICE_RESTRUCTURE ----------
   params { sku, harga_dasar_baru, diskon_persen=15, platform='Shopee', jeda_hari=7, jeda_jam=1, durasi_promo_hari=30,
            akhiri_seluruh_diskon=false, purchase_limit=0 }
   1) Seketika   : lepas listing dari diskon toko lama (delete_discount_item). end_discount (SELURUH promo, semua produk
                   di dalamnya ikut berhenti) HANYA bila akhiri_seluruh_diskon=true.        -> action_logs
   2) +5 detik   : UPDATE_PRICE - Harga Jual & Harga Coret Shopee = harga dasar baru (+ sync ke Shopee) -> action_logs
   3) Antrean    : CREATE_DISCOUNT dijadwalkan; promo -diskon% tayang NOW + jeda (default 7 hari 1 jam).
                   Worker menjalankannya ±70 menit sebelumnya karena Shopee mewajibkan start_time >= ±1 jam ke depan. */
function automatePriceRestructure(p, opsi) {
  p = p || {}; opsi = opsi || {};
  var sku = String(p.sku || '').trim(), toko = opsi.toko;
  var out = { target: sku + ' @ Shopee (restrukturisasi harga)', oldValue: '', newValue: '' };
  var gagal = function (status, pesan) { out.status = status; out.pesan = pesan; return out; };
  if (!sku) return gagal('FAILED', 'sku wajib diisi.');
  if (!/^shopee$/i.test(String(p.platform || 'Shopee').trim())) return gagal('FAILED', 'AUTOMATE_PRICE_RESTRUCTURE saat ini hanya untuk Shopee (Discount API). TikTok Shop: atur promo di Seller Center.');
  if (opsi.autopilot) return gagal('REJECTED_POLICY', 'Restrukturisasi harga + promo selalu butuh konfirmasi manual.');
  var dasar = Math.round(Number(p.harga_dasar_baru || p.new_price || p.harga_baru));
  var diskon = (p.diskon_persen === undefined || p.diskon_persen === null || p.diskon_persen === '') ? 15 : Number(p.diskon_persen);
  if (!(dasar > 0)) return gagal('FAILED', 'harga_dasar_baru wajib angka > 0.');
  if (!(diskon > 0 && diskon < 90)) return gagal('FAILED', 'diskon_persen harus 1-89.');
  var angka = function (v, d) { return (v === undefined || v === null || v === '' || !isFinite(Number(v))) ? d : Number(v); };
  var jedaMs = Math.max(0, angka(p.jeda_hari, 7)) * 86400000 + Math.max(0, angka(p.jeda_jam, 1)) * 3600000;
  var durasiHari = Math.min(179, Math.max(1, angka(p.durasi_promo_hari, 30)));
  var hargaPromo = Math.round(dasar * (1 - diskon / 100));
  var simulasi = getSyncHargaMode_() !== 'LIVE';

  // Guardrail SEBELUM menyentuh marketplace: harga dasar DAN harga promo wajib >= HPP + komisi
  var g1 = validatePriceSafety(sku, dasar, 'Shopee', toko);
  if (g1.status !== 'OK') return gagal('REJECTED_SAFETY_VIOLATION', 'Harga dasar ' + eksRp_(dasar) + ': ' + g1.alasan);
  var g2 = validatePriceSafety(sku, hargaPromo, 'Shopee', toko);
  if (g2.status !== 'OK') return gagal('REJECTED_SAFETY_VIOLATION', 'Harga promo -' + diskon + '% (' + eksRp_(hargaPromo) + ') melanggar batas aman: ' + g2.alasan + ' Turunkan diskon atau naikkan harga dasar.');

  // Semua listing Shopee milik SKU ini (termasuk listing duplikat)
  var prod = eksBacaProduk_(sku, toko);
  out.oldValue = { harga_jual_shopee: parseFloat(prod.r[6]) || 0, harga_coret_shopee: parseFloat(prod.r[27]) || 0 };
  var kode = syncKodeTerhubung_(prod.sku, ['Shopee'], toko).kode; // resolver mapping (fallback SKU Gudang)
  var listing = [], gagalId = [];
  kode.forEach(function (k) {
    try {
      syncResolveIdShopeeSemua_(k).forEach(function (x) {
        var it = { kode: k, item_id: Number(x.item_id), model_id: Number(x.model_id) || 0 };
        if (!listing.some(function (l) { return l.item_id === it.item_id && l.model_id === it.model_id; })) listing.push(it);
      });
    } catch (e) { gagalId.push(k + ': ' + e.message); }
  });
  if (!listing.length) return gagal('FAILED', 'Listing Shopee untuk ' + sku + ' tidak ditemukan - ' + gagalId.join(' | ') + ' (jalankan CHECK_SKU_MAPPING).');

  // LANGKAH 1 - lepas diskon lama
  var akhiriSemua = p.akhiri_seluruh_diskon === true || /^(true|1|ya)$/i.test(String(p.akhiri_seluruh_diskon || ''));
  var l1 = sptLepasDiskonLama_(listing, akhiriSemua, sku);
  eksCatatLog_(opsi.oleh, akhiriSemua ? 'END_DISCOUNT (v2.discount.end_discount)' : 'REMOVE_DISCOUNT_ITEM (v2.discount.delete_discount_item)', sku, l1.lama, l1.baru, l1.status, { pesan: l1.ringkas, bagianDari: 'AUTOMATE_PRICE_RESTRUCTURE', simulasi: simulasi });
  if (l1.status === 'FAILED') return gagal('FAILED', 'Langkah 1 gagal: ' + l1.ringkas + '. Harga TIDAK diubah & promo baru TIDAK dijadwalkan.');

  // LANGKAH 2 - +5 detik: naikkan harga dasar (selama masa jeda harga jual = harga coret = harga dasar baru)
  Utilities.sleep(5000);
  var u = updateProductPrice(sku, dasar, 'Shopee', { hargaCoret: dasar, email: opsi.email, toko: toko, autopilot: false });
  eksCatatLog_(opsi.oleh, 'UPDATE_PRICE', u.target, u.oldValue, u.newValue, u.status, { pesan: u.pesan, sync: u.sync, guardrail: u.guardrail, bagianDari: 'AUTOMATE_PRICE_RESTRUCTURE' });
  if (u.status !== 'SUCCESS') return gagal(u.status, 'Langkah 1 OK (' + l1.ringkas + '), langkah 2 gagal: ' + u.pesan + ' - promo baru TIDAK dijadwalkan.');

  // LANGKAH 3 - antrean promo baru
  var mulaiPromo = Date.now() + jedaMs;
  var eksekusi = new Date(Math.max(Date.now() + 60000, mulaiPromo - 70 * 60000));
  var j = sptJadwalkan_('CREATE_DISCOUNT', sku, eksekusi, {
    sku: prod.sku, harga_dasar: dasar, diskon_persen: diskon, harga_promo: hargaPromo, mulai_promo_ms: mulaiPromo, durasi_hari: durasiHari,
    listing: listing, purchase_limit: Math.max(0, parseInt(p.purchase_limit, 10) || 0), toko: toko || '', __email: opsi.email || ''
  }, opsi.oleh);
  eksCatatLog_(opsi.oleh, 'SCHEDULE_TASK', sku, '', { task_id: j.taskId, action: 'CREATE_DISCOUNT', eksekusi: sptFmt_(eksekusi), mulai_promo: sptFmt_(mulaiPromo) }, 'SUCCESS', { bagianDari: 'AUTOMATE_PRICE_RESTRUCTURE' });

  out.status = 'SUCCESS';
  out.newValue = { harga_dasar: dasar, harga_promo: hargaPromo, task_id: j.taskId, mulai_promo: sptFmt_(mulaiPromo) };
  out.pesan = (simulasi ? '[SIMULASI - SYNC_HARGA_MODE bukan LIVE] ' : '') +
    '1) ' + l1.ringkas + ' 2) ' + u.pesan + ' 3) Promo -' + diskon + '% (' + eksRp_(dasar) + ' → ' + eksRp_(hargaPromo) + ') untuk ' + listing.length +
    ' listing dijadwalkan tayang ' + sptFmt_(mulaiPromo) + ' selama ' + durasiHari + ' hari [agenda ' + j.taskId + ']. Batalkan dengan CANCEL_SCHEDULED_TASK selama masih PENDING.' +
    (gagalId.length ? ' ⚠ Kode dilewati: ' + gagalId.join(' | ') : '');
  return out;
}

function sptLepasDiskonLama_(listing, akhiriSemua, sku) {
  var hasil = { status: 'SUCCESS', lama: [], baru: [], ringkas: '' }, gagal = [], promoLain = [], sudah = {};
  var itemIds = []; listing.forEach(function (l) { if (itemIds.indexOf(l.item_id) === -1) itemIds.push(l.item_id); });
  itemIds.forEach(function (itemId) {
    var info = sptInfoPromoItem_(itemId);
    if (!info.ok) { gagal.push('item ' + itemId + ': status promo tidak terbaca (' + info.pesan + ')'); return; }
    info.lain.forEach(function (x) { if (promoLain.indexOf(x) === -1) promoLain.push(x); });
    info.diskonToko.forEach(function (d) {
      hasil.lama.push({ discount_id: d.id, item_id: itemId, tahap: d.tahap, berakhir: sptFmt_(d.akhir) });
      if (akhiriSemua) {
        if (sudah[d.id]) return; sudah[d.id] = true;
        var upcoming = /upcoming|not.?start/i.test(d.tahap);
        var path = upcoming ? '/api/v2/discount/delete_discount' : '/api/v2/discount/end_discount';
        var r = sptShopeePost_(path, { discount_id: Number(d.id) }, upcoming ? 'v2.discount.delete_discount' : 'v2.discount.end_discount', sku);
        hasil.baru.push({ discount_id: d.id, aksi: upcoming ? 'delete_discount' : 'end_discount', ok: r.ok, pesan: r.pesan });
        if (!r.ok) gagal.push('diskon ' + d.id + ': ' + r.pesan);
      } else {
        listing.filter(function (l) { return l.item_id === itemId; }).forEach(function (l) {
          var r2 = sptShopeePost_('/api/v2/discount/delete_discount_item', { discount_id: Number(d.id), item_id: itemId, model_id: l.model_id }, 'v2.discount.delete_discount_item', sku);
          hasil.baru.push({ discount_id: d.id, item_id: itemId, model_id: l.model_id, aksi: 'delete_discount_item', ok: r2.ok, pesan: r2.pesan });
          if (!r2.ok) gagal.push('diskon ' + d.id + ' item ' + itemId + '/' + l.model_id + ': ' + r2.pesan);
        });
      }
    });
  });
  if (gagal.length) { hasil.status = 'FAILED'; hasil.ringkas = gagal.join(' | '); return hasil; }
  hasil.ringkas = hasil.baru.length
    ? (akhiriSemua ? 'Diskon toko diakhiri: ' : 'Listing dilepas dari diskon toko: ') + hasil.baru.map(function (b) { return b.discount_id + (b.item_id ? ' (item ' + b.item_id + ')' : ''); }).join(', ') + '.'
    : 'Tidak ada diskon toko aktif pada listing ini.';
  if (promoLain.length) hasil.ringkas += ' ⚠ Promo platform ' + promoLain.join(', ') + ' tidak bisa dilepas via API - update harga bisa ditolak & akan dijadwalkan ulang otomatis.';
  return hasil;
}

// Handler CREATE_DISCOUNT (H+7 hari 1 jam): add_discount + add_discount_item, lalu Harga Jual Final ERP = harga promo
function sptHandlerCreateDiscount_(t) {
  var p = t.params || {};
  var prod = eksBacaProduk_(p.sku, p.toko);
  var coret = Math.round(parseFloat(prod.r[27]) || 0);
  if (coret !== Math.round(p.harga_dasar)) return { status: 'FAILED', pesan: 'Harga Coret Shopee sekarang ' + eksRp_(coret) + ' ≠ harga dasar saat dijadwalkan ' + eksRp_(p.harga_dasar) + ' - promo dibatalkan demi keamanan. Jadwalkan ulang bila masih diinginkan.' };
  var hargaPromo = Math.round(coret * (1 - Number(p.diskon_persen) / 100));
  var g = validatePriceSafety(p.sku, hargaPromo, 'Shopee', p.toko);
  if (g.status !== 'OK') return { status: 'FAILED', pesan: 'Guardrail menolak harga promo ' + eksRp_(hargaPromo) + ': ' + g.alasan };
  var now = Math.floor(Date.now() / 1000);
  var mulai = Math.max(Math.floor(Number(p.mulai_promo_ms) / 1000) || 0, now + 3900);
  var akhir = mulai + Math.round(Number(p.durasi_hari) || 30) * 86400;
  if (!p.discount_id) { // idempoten: diskon yang sudah dibuat di percobaan sebelumnya tidak dibuat ulang
    var rD = sptShopeePost_('/api/v2/discount/add_discount', { discount_name: ('OmniAI ' + p.sku + ' -' + p.diskon_persen + '%').slice(0, 50), start_time: mulai, end_time: akhir }, 'v2.discount.add_discount', p.sku);
    if (!rD.ok || !rD.resp.discount_id) return { status: 'FAILED', bolehUlang: true, pesan: 'add_discount ditolak: ' + (rD.pesan || 'discount_id kosong') };
    p.discount_id = rD.resp.discount_id;
    t.simpanParams(p);
  }
  var perItem = {};
  (p.listing || []).forEach(function (l) {
    var it = perItem[l.item_id] = perItem[l.item_id] || { item_id: Number(l.item_id), purchase_limit: Number(p.purchase_limit) || 0 };
    if (Number(l.model_id)) (it.model_list = it.model_list || []).push({ model_id: Number(l.model_id), model_promotion_price: hargaPromo });
    else it.item_promotion_price = hargaPromo;
  });
  var daftar = Object.keys(perItem).map(function (k) { return perItem[k]; });
  var rI = sptShopeePost_('/api/v2/discount/add_discount_item', { discount_id: Number(p.discount_id) || p.discount_id, item_list: daftar }, 'v2.discount.add_discount_item', p.sku);
  if (!rI.ok) return { status: 'FAILED', bolehUlang: true, pesan: 'Diskon ' + p.discount_id + ' dibuat, tapi add_discount_item ditolak: ' + rI.pesan };
  var errList = (rI.resp && rI.resp.error_list) || [];
  var s = prosesSimpanHargaJualFinal({ email: p.__email, toko: p.toko, items: [{ sku: prod.sku, hargaShopee: hargaPromo }] });
  try { invalidasiCacheKatalogHarga(p.toko); } catch (e) { }
  return {
    status: errList.length >= (p.listing || []).length && errList.length ? 'FAILED' : 'SUCCESS',
    pesan: (rI.simulasi ? '[SIMULASI] ' : '') + 'Diskon Shopee ' + p.discount_id + ': ' + prod.sku + ' ' + eksRp_(coret) + ' → ' + eksRp_(hargaPromo) + ' (-' + p.diskon_persen + '%), ' + sptFmt_(mulai) + ' s/d ' + sptFmt_(akhir) + '.' +
      (errList.length ? ' ⚠ ' + errList.length + ' listing ditolak: ' + errList.map(function (e) { return e.item_id + (e.model_id ? '/' + e.model_id : '') + ' ' + (e.fail_message || e.fail_error || ''); }).join('; ') : '') +
      (s.success ? ' Harga Jual Final ERP = harga promo.' : ' ⚠ Harga Jual Final ERP gagal diperbarui: ' + s.error),
    respon: { discount_id: p.discount_id, error_list: errList }
  };
}

/* ---------- Indeks SKU Shopee: semua listing NORMAL -> item_sku & model_sku (varian) ----------
   search_item?item_sku= hanya mencocokkan SKU INDUK. SKU varian (model_sku) & listing yang tidak terbaca search
   baru bisa ditemukan lewat get_item_list + get_item_base_info + get_model_list. Hasil -> sheet "ID Produk Shopee" (Sumber INDEKS). */
function bangunIndeksSkuShopee_(opsi) {
  opsi = opsi || {};
  var kred = opsi.kred || ambilKredensialShopee();
  if (!kred || !kred.accessToken || !kred.shopId) throw new Error('Token Shopee belum tersedia / kedaluwarsa - hubungkan ulang Shopee.');
  var mulai = Date.now(), batas = opsi.batasMs || 240000, terpotong = false;
  var habis = function () { if (Date.now() - mulai > batas) terpotong = true; return terpotong; };
  var itemIds = [], offset = 0, putaran = 0;
  while (putaran++ < 300) {
    var r = syncPanggilShopee_(kred, '/api/v2/product/get_item_list', '&offset=' + offset + '&page_size=100&item_status=NORMAL');
    (r.item || []).forEach(function (it) { itemIds.push(it.item_id); });
    if (!r.has_next_page) break;
    offset = r.next_offset;
    if (habis()) break;
  }
  var baris = [], perluModel = [];
  livePotong_(itemIds, 50).forEach(function (batch) {
    if (habis()) return;
    var b = syncPanggilShopee_(kred, '/api/v2/product/get_item_base_info', '&item_id_list=' + batch.join(','));
    (b.item_list || []).forEach(function (it) {
      if (it.has_model) perluModel.push({ item_id: it.item_id, nama: it.item_name || '' });
      else if (String(it.item_sku || '').trim()) baris.push({ sku: String(it.item_sku).trim(), item_id: it.item_id, model_id: 0, nama: it.item_name || '' });
    });
  });
  perluModel.forEach(function (it) {
    if (habis()) return;
    var m = syncPanggilShopee_(kred, '/api/v2/product/get_model_list', '&item_id=' + it.item_id);
    (m.model || []).forEach(function (md) { var s = String(md.model_sku || '').trim(); if (s) baris.push({ sku: s, item_id: it.item_id, model_id: md.model_id, nama: it.nama }); });
  });
  var kunci = function (s, i, m) { return s + '|' + String(i).trim() + '|' + String(Number(m) || 0); };
  syncTulisUlangIdShopee_(function (rows) {
    var waktu = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm'), baru = {};
    baris.forEach(function (b) { baru[kunci(b.sku, b.item_id, b.model_id)] = b; });
    var hasil = [];
    rows.forEach(function (r) {
      var s = String(r[0] || '').trim(); if (!s) return;
      if (baru[kunci(s, r[1], r[2])]) return;                                        // diganti data indeks terbaru
      if (!terpotong && String(r[5] || '').trim().toUpperCase() === 'INDEKS') return;  // indeks LENGKAP -> baris indeks basi dibuang
      hasil.push([r[0], r[1], r[2], r[3], r[4], r[5] || '']);
    });
    Object.keys(baru).forEach(function (k) { var b = baru[k]; hasil.push([b.sku, String(b.item_id), String(b.model_id || 0), b.nama || '', waktu, 'INDEKS']); });
    return hasil;
  });
  if (!terpotong) PropertiesService.getScriptProperties().setProperty('SHOPEE_INDEKS_WAKTU', String(Date.now()));
  SHOPEE_ID_MEMO_ = null;
  var hitung = {}; baris.forEach(function (b) { hitung[b.sku] = (hitung[b.sku] || 0) + 1; });
  var dobel = Object.keys(hitung).filter(function (k) { return hitung[k] > 1; });
  return { success: true, jumlahListing: itemIds.length, jumlahSku: baris.length, skuDuplikat: dobel.slice(0, 50), jumlahSkuDuplikat: dobel.length, terpotong: terpotong, durasiDetik: Math.round((Date.now() - mulai) / 1000) };
}
function shopeeIndeksCariSku_(sku, kred, paksa) {
