// ===== AKSI: dev_catatan_simpan { catatan, jenis, prioritas, alamat, judulHalaman, hash, versi, perangkat, bagian, error[] } =====
function prosesDevCatatanSimpan(data) {
  var lock = kunciModul_('umum');
  if (!lock.tryLock(20000)) return { success: false, error: 'Sistem sibuk, coba lagi.' };
  try {
    if (!mgApakahOwner_(data.email)) throw new Error('Catatan Developer hanya untuk akun Owner.');
    var catatan = devTeks_(data.catatan, 4000);
    if (!catatan) throw new Error('Catatan masih kosong.');
    var tz = Session.getScriptTimeZone(), kini = new Date();
    var jenis = DEV_CATATAN_JENIS_.indexOf(String(data.jenis)) >= 0 ? String(data.jenis) : 'Lainnya';
    var prio = ['Tinggi', 'Sedang', 'Rendah'].indexOf(String(data.prioritas)) >= 0 ? String(data.prioritas) : 'Sedang';
    var err = (Array.isArray(data.error) ? data.error : []).slice(0, 8).map(function (e) { return devTeks_(e, 300); });
    var id = 'DN-' + Utilities.formatDate(kini, tz, 'yyMMdd-HHmmss') + '-' + Math.floor(Math.random() * 900 + 100);
    var baris = [id, kini, getNamaStaff(data.email) || data.email || '', devTeks_(data.alamat, 120), devTeks_(data.judulHalaman, 150),
      devTeks_(data.hash, 200), devTeks_(data.versi, 40), devTeks_(data.perangkat, 120), jenis, prio, catatan, devTeks_(data.bagian, 2400),
      JSON.stringify(err), 'Baru', kini, ''];
    var sh = getDevCatatanSheet_();
    sh.getRange(sh.getLastRow() + 1, 1, 1, baris.length).setValues([baris]);
    SpreadsheetApp.flush();
    return { success: true, catatan: devBarisKeObjek_(baris, tz) };
  } catch (err2) { return { success: false, error: err2.message || String(err2) }; }
  finally { lepasKunci_(lock); }
}

// ===== AKSI: dev_catatan_daftar {} =====
function prosesDevCatatanDaftar(data) {
  try {
    if (!mgApakahOwner_(data.email)) throw new Error('Catatan Developer hanya untuk akun Owner.');
    try { devTerapkanPaketSelesai_(); } catch (eP) { Logger.log('Catatan Dev: tanda paket dilewati - ' + eP); }
    var sh = getDevCatatanSheet_(), lr = sh.getLastRow(), tz = Session.getScriptTimeZone(), daftar = [];
    if (lr > 1) sh.getRange(2, 1, lr - 1, DEV_CATATAN_HEADER_.length).getValues().forEach(function (r) { if (r[0]) daftar.push(devBarisKeObjek_(r, tz)); });
    daftar.reverse(); // terbaru di atas
    return { success: true, daftar: daftar.slice(0, 1000), jumlah: daftar.length, status: DEV_CATATAN_STATUS_, jenis: DEV_CATATAN_JENIS_ };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

// ===== AKSI: dev_catatan_ubah { id, status?, catatan?, balasan?, hapus? } =====
function prosesDevCatatanUbah(data) {
  var lock = kunciModul_('umum');
  if (!lock.tryLock(20000)) return { success: false, error: 'Sistem sibuk, coba lagi.' };
  try {
    if (!mgApakahOwner_(data.email)) throw new Error('Catatan Developer hanya untuk akun Owner.');
    var id = devTeks_(data.id, 60);
    if (!id) throw new Error('ID catatan kosong.');
    var sh = getDevCatatanSheet_(), lr = sh.getLastRow(), posisi = 0;
    if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().some(function (r, i) { if (String(r[0]) === id) { posisi = i + 2; return true; } return false; });
    if (!posisi) throw new Error('Catatan tidak ditemukan (mungkin sudah dihapus).');
    if (data.hapus === true) { sh.deleteRow(posisi); SpreadsheetApp.flush(); return { success: true, dihapus: id }; }
    var r = sh.getRange(posisi, 1, 1, DEV_CATATAN_HEADER_.length).getValues()[0];
    if (String(r[0]) !== id) throw new Error('Data berubah, muat ulang lalu coba lagi.');
    if (data.status !== undefined) { if (DEV_CATATAN_STATUS_.indexOf(String(data.status)) < 0) throw new Error('Status tidak dikenal.'); r[13] = String(data.status); }
    if (data.catatan !== undefined) { var c = devTeks_(data.catatan, 4000); if (!c) throw new Error('Catatan tidak boleh kosong.'); r[10] = c; }
    if (data.balasan !== undefined) r[15] = devTeks_(data.balasan, 2000);
    // v2026.10.66 (DN-261025-192645-241): edit catatan lengkap dari halaman Catatan Developer
    if (data.jenis !== undefined) { if (DEV_CATATAN_JENIS_.indexOf(String(data.jenis)) < 0) throw new Error('Jenis tidak dikenal.'); r[8] = String(data.jenis); }
    if (data.prioritas !== undefined) { if (['Tinggi', 'Sedang', 'Rendah'].indexOf(String(data.prioritas)) < 0) throw new Error('Prioritas tidak dikenal.'); r[9] = String(data.prioritas); }
    if (data.bagian !== undefined) r[11] = devTeks_(data.bagian, 2400);
    r[14] = new Date();
    sh.getRange(posisi, 1, 1, r.length).setValues([r]);
    SpreadsheetApp.flush();
    return { success: true, catatan: devBarisKeObjek_(r, Session.getScriptTimeZone()) };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
  finally { lepasKunci_(lock); }
}

