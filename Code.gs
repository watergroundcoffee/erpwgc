// Jalankan fungsi ini LANGSUNG dari editor Apps Script (klik dropdown fungsi di atas,
// pilih "tesKoneksiTikTokShop", klik ▶ Run) buat ngecek apa koneksi TikTok Shop udah
// beneran nyambung dan tokennya valid.
// Bikin tanda tangan (signature) HMAC-SHA256 sesuai aturan resmi TikTok Shop:
// urutkan semua parameter alfabetis, gabung jadi satu string tanpa pemisah,
// apit dengan APP_SECRET di depan & belakang, baru di-hash.
function buatSignatureTikTok(path, params, bodyString, appSecretOverride) {
  var secretDipakai = appSecretOverride || getTiktokAppSecret();
  var keys = Object.keys(params).sort();
  var gabungan = '';
  keys.forEach(function (k) { gabungan += k + params[k]; });
  // Buat request POST, body-nya ikut masuk ke perhitungan signature (sebelum secret penutup)
  var stringUntukDitandatangani = secretDipakai + path + gabungan + (bodyString || '') + secretDipakai;

  var signatureBytes = Utilities.computeHmacSha256Signature(stringUntukDitandatangani, secretDipakai);
  var signatureHex = signatureBytes.map(function (byte) {
    var v = (byte < 0 ? byte + 256 : byte).toString(16);
    return v.length === 1 ? '0' + v : v;
  }).join('');
  return signatureHex; // huruf KECIL (lowercase hex) - bukan uppercase
}

function tesKoneksiTikTokShop() {
  var props = PropertiesService.getScriptProperties();
  var accessToken = props.getProperty('TIKTOK_ACCESS_TOKEN');

  if (!accessToken) {
    Logger.log('❌ BELUM ADA TOKEN TERSIMPAN. Kamu perlu buka Authorization URL dari TikTok Partner Center dulu, approve akses, baru token ini bakal keisi otomatis.');
    return;
  }

  // Jaring pengaman: cek dulu bentuk tokennya wajar apa nggak (tanpa nampilin lengkap, cuma sebagian)
  Logger.log('Token tersimpan (10 karakter awal): ' + accessToken.substring(0, 10) + '... (panjang total: ' + accessToken.length + ' karakter)');

  try {
    var path = '/authorization/202309/shops';
    var paramsUntukSign = {
      app_key: getTiktokAppKey(),
      timestamp: String(Math.floor(Date.now() / 1000)),
      version: '202309'
    };
    var signature = buatSignatureTikTok(path, paramsUntukSign);

    var url = 'https://open-api.tiktokglobalshop.com' + path +
      '?app_key=' + encodeURIComponent(getTiktokAppKey()) +
      '&timestamp=' + paramsUntukSign.timestamp +
      '&version=' + paramsUntukSign.version +
      '&sign=' + signature;

    var res = fetchHemat(url, {
      method: 'get',
      headers: { 'x-tts-access-token': accessToken },
      muteHttpExceptions: true
    });
    var kode = res.getResponseCode();
    var isi = res.getContentText();
    Logger.log('Kode respons: ' + kode);
    Logger.log('Isi respons: ' + isi);

    if (kode === 200) {
      Logger.log('✅ KONEKSI BERHASIL! Token valid dan bisa dipakai.');
      try {
        var parsed = JSON.parse(isi);
        if (parsed.data && parsed.data.shops && parsed.data.shops.length > 0) {
          var shopCipher = parsed.data.shops[0].cipher;
          PropertiesService.getScriptProperties().setProperty('TIKTOK_SHOP_CIPHER', shopCipher);
          Logger.log('✅ Shop Cipher tersimpan: ' + shopCipher.substring(0, 15) + '...');
        }
      } catch (e) {
        Logger.log('⚠️ Gagal simpan shop cipher: ' + e.toString());
      }
    } else {
      Logger.log('⚠️ Ada masalah - cek isi respons di atas buat detail errornya.');
    }
  } catch (err) {
    Logger.log('❌ Error: ' + err.toString());
  }
}

// Jalankan ini SETELAH tesKoneksiTikTokShop() berhasil (biar shop_cipher udah tersimpan) -
