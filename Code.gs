function prosesKonfirmasiMintaStockJadiPO(data) {
  var namaSupplier, items, rowsRequestAsli;
  return withTransaction(data.email, 'adminPembelian', ['pembelian', 'stok'], function () {
    var result = { success: false };
    // Bikin PO sungguhan (pakai struktur yang sama kayak PO manual biasa)
    var sheetsPO = getPurchaseOrderSheets();
    var noPO = generateNoPOHarian();
    sheetsPO.header.appendRow([noPO, new Date(), namaSupplier, 'Dipesan', getNamaStaff(data.email)]);
    items.forEach(function (it) {
      sheetsPO.detail.appendRow([noPO, it.sku, it.nama, parseFloat(it.qty) || 0, 0]);
    });

    // Tandai request asli yang jadi sumber PO ini sebagai "Dipesan ke Supplier"
    if (rowsRequestAsli.length > 0) {
      var shRequest = getStockRequestSheet();
      rowsRequestAsli.forEach(function (rowNum) {
        var r = parseInt(rowNum, 10);
        if (!r || r < 2 || r > shRequest.getLastRow()) return;
        shRequest.getRange(r, 6, 1, 2).setValues([['Dipesan ke Supplier', noPO]]);
      });
    }

    result.success = true;
    result.noPO = noPO;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    pesanTanpaIzin: 'Anda tidak punya izin Admin Pembelian.',
    validasi: function () {
      namaSupplier = String(data.namaSupplier || '').trim();
      items = data.items || []; // [{sku, nama, qty}] - dari cart yang udah diedit admin
      rowsRequestAsli = data.rowsRequestAsli || []; // baris2 Request Stock yang mau ditandai selesai
      if (!namaSupplier) throw new Error('Nama supplier kosong');
      if (items.length === 0) throw new Error('Belum ada produk di PO ini');
    }
  });
}

