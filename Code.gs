}
function prosesStokMpPratinjau(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var kode = stokMpKodeTerhubung_(), mesin = smHitungMesinStok({}), terakhir = stokMpTerakhir_(), daftar = [];
    var posisi = {}; mesin.daftar.forEach(function (p) { posisi[smKey(p.sku)] = p; });
    Object.keys(kode).forEach(function (sku) {
      var e = kode[sku]; if (e.arsip) return;
      var p = posisi[smKey(sku)] || { onHand: 0, onReserve: 0, onAvailable: 0 };
      var kirim = Math.max(0, Math.floor(p.onAvailable || 0));
      var tS = terakhir[sku + '|Shopee'], tT = terakhir[sku + '|TikTok Shop'];
      daftar.push({ sku: sku, nama: e.nama || p.nama || '', onHand: p.onHand, onReserve: p.onReserve, onAvailable: p.onAvailable, kirim: kirim,
        shopee: e.shopee, tiktok: e.tiktok,
        terakhirShopee: tS || null, terakhirTiktok: tT || null,
        berubah: (e.shopee.length && (!tS || Number(tS.qty) !== kirim)) || (e.tiktok.length && (!tT || Number(tT.qty) !== kirim)) });
    });
    daftar.sort(function (a, b) { return (b.berubah - a.berubah) || a.sku.localeCompare(b.sku); });
    result.success = true;
    result.daftar = daftar;
    result.mode = getSyncHargaMode_();
    result.dihitungPada = smFmt(mesin.batasMs);
  } catch (err) { result.error = err.toString(); }
  return result;
}
// items = [{ sku, channel: 'Shopee'|'TikTok Shop'|'semua' }]. Qty SELALU dihitung ulang di server (bukan dari browser).
function prosesStokMpKirim(data) {
  var result = { success: false, hasil: [] };
  if (!cekIzin(data.email, 'mintaStock')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; }
  var items = Array.isArray(data.items) ? data.items.slice(0, STOKMP_MAKS_SKU) : [];
  if (!items.length) { result.error = 'Pilih minimal 1 SKU.'; return result; }
  var mutex = kunciSinkronAmbil_('STOK_MP', 300);
  if (!mutex) { result.error = 'Kirim stok lain sedang berjalan. Coba lagi sebentar.'; return result; }
  var mulai = Date.now(), oleh = getNamaStaff(data.email) || data.email || '', mode = getSyncHargaMode_();
  try {
    var kode = stokMpKodeTerhubung_(), mesin = smHitungMesinStok({}), posisi = {};
    mesin.daftar.forEach(function (p) { posisi[smKey(p.sku)] = p; });
    var log = [];
    items.forEach(function (it) {
      var sku = String(it.sku || '').trim(), e = kode[sku];
      if (!e) { result.hasil.push({ sku: sku, channel: '-', ok: false, pesan: 'SKU belum punya SKU Terhubung Shopee/TikTok.' }); return; }
      var p = posisi[smKey(sku)] || { onAvailable: 0 };
      var qty = Math.max(0, Math.floor(p.onAvailable || 0));
      var kanal = [];
      if ((it.channel === 'Shopee' || it.channel === 'semua' || !it.channel) && e.shopee.length) kanal.push('Shopee');
      if ((it.channel === 'TikTok Shop' || it.channel === 'semua' || !it.channel) && e.tiktok.length) kanal.push('TikTok Shop');
      kanal.forEach(function (ch) {
        (ch === 'Shopee' ? e.shopee : e.tiktok).forEach(function (kodeMp) {
          if (Date.now() - mulai > 270000) { result.hasil.push({ sku: sku, channel: ch, kodeMp: kodeMp, ok: false, pesan: 'Waktu habis - kirim ulang sisanya.' }); return; }
          try {
            var listing = stokMpKirimSatu_(ch, kodeMp, qty, mode);
            listing.forEach(function (l) { result.hasil.push({ sku: sku, channel: ch, kodeMp: kodeMp, id: l.id, qty: qty, ok: true, dryRun: l.dryRun }); log.push([new Date(), sku, ch, kodeMp, l.id, qty, l.dryRun ? 'Dry Run' : 'Terkirim', '', oleh]); });
          } catch (eK) {
            var pesan = String(eK.message || eK);
            result.hasil.push({ sku: sku, channel: ch, kodeMp: kodeMp, qty: qty, ok: false, dilewati: !!eK.dilewati, pesan: pesan });
            log.push([new Date(), sku, ch, kodeMp, '', qty, eK.dilewati ? 'Dilewati' : 'Gagal', pesan.slice(0, 400), oleh]);
          }
        });
      });
    });
    if (log.length) { var shL = stokMpLogSheet_(); shL.getRange(shL.getLastRow() + 1, 1, log.length, 9).setValues(log); }
    result.success = true;
    result.ringkas = { ok: result.hasil.filter(function (h) { return h.ok; }).length, gagal: result.hasil.filter(function (h) { return !h.ok; }).length };
    result.mode = mode;
  } catch (err) { result.error = err.toString(); }
  finally { try { kunciSinkronLepas_('STOK_MP', mutex); } catch (eL) { } }
  return result;
}
// Return [{ id, dryRun }] - semua listing duplikat untuk 1 SKU marketplace ikut di-update
function stokMpKirimSatu_(channel, kodeMp, qty, mode) {
  if (channel === 'Shopee') {
    var target = mode === 'LIVE' ? syncResolveIdShopeeSemua_(kodeMp) : [{ item_id: '<item_sku ' + kodeMp + '>', model_id: 0 }];
    return target.map(function (t) {
      var path = '/api/v2/product/update_stock';
      var body = { item_id: Number(t.item_id) || t.item_id, stock_list: [{ model_id: Number(t.model_id) || 0, seller_stock: [{ stock: qty }] }] };
      if (mode !== 'LIVE') { Logger.log('[STOK MP DRY-RUN] Shopee ' + JSON.stringify(body)); return { id: String(t.item_id) + '/' + (t.model_id || 0), dryRun: true }; }
      var kred = ambilKredensialShopee(), ts = Math.floor(Date.now() / 1000);
      var url = getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts + '&sign=' + buatSignatureShopee(path, ts, kred.accessToken, kred.shopId) + '&access_token=' + kred.accessToken + '&shop_id=' + kred.shopId;
      var res = UrlFetchApp.fetch(url, { method: 'post', contentType: 'application/json', payload: JSON.stringify(body), muteHttpExceptions: true });
      var json = {}; try { json = JSON.parse(res.getContentText() || '{}'); } catch (e) { }
      var gagal = (json.response && json.response.failure_list) || [];
      if (res.getResponseCode() !== 200 || json.error || gagal.length) {
        apiErrCatat_('Shopee', 'v2.product.update_stock', kodeMp, body, res.getResponseCode(), json, res.getContentText());
        throw new Error('Shopee menolak: ' + (json.error || '') + ' ' + (json.message || '') + (gagal.length ? ' ' + gagal.map(function (f) { return f.failed_reason || f.reason || ''; }).join('; ') : ''));
      }
      return { id: String(t.item_id) + '/' + (t.model_id || 0), dryRun: false };
    });
  }
  var idT = syncResolveId_('TikTok Shop', kodeMp), semua = (idT.semua && idT.semua.length) ? idT.semua : [idT];
  var props = PropertiesService.getScriptProperties();
  var gudang = props.getProperty('TIKTOK_GUDANG_DEFAULT') || '';
  return semua.map(function (id) {
    var path = '/product/202309/products/' + id.productId + '/inventory/update';
    var inv = { quantity: qty }; if (gudang) inv.warehouse_id = gudang;
    var body = { skus: [{ id: String(id.skuId), inventory: [inv] }] }, bodyString = JSON.stringify(body);
    if (mode !== 'LIVE' || idT.simulasi) { Logger.log('[STOK MP DRY-RUN] TikTok ' + bodyString); return { id: id.productId + '/' + id.skuId, dryRun: true }; }
    var q = { app_key: getTiktokAppKey(), shop_cipher: props.getProperty('TIKTOK_SHOP_CIPHER') || '', timestamp: String(Math.floor(Date.now() / 1000)), version: '202309' };
    var url = 'https://open-api.tiktokglobalshop.com' + path + '?app_key=' + encodeURIComponent(q.app_key) + '&shop_cipher=' + encodeURIComponent(q.shop_cipher) + '&timestamp=' + q.timestamp + '&version=' + q.version + '&sign=' + buatSignatureTikTok(path, q, bodyString);
    var res = UrlFetchApp.fetch(url, { method: 'post', contentType: 'application/json', headers: { 'x-tts-access-token': props.getProperty('TIKTOK_ACCESS_TOKEN') || '' }, payload: bodyString, muteHttpExceptions: true });
    var json = {}; try { json = JSON.parse(res.getContentText() || '{}'); } catch (e) { }
    if (res.getResponseCode() !== 200 || (json.code !== undefined && json.code !== 0)) {
      apiErrCatat_('TikTok Shop', 'product.202309.inventory.update', kodeMp, body, res.getResponseCode(), json, res.getContentText());
      throw new Error('TikTok menolak: kode ' + json.code + ' - ' + (json.message || ('HTTP ' + res.getResponseCode())));
    }
    return { id: id.productId + '/' + id.skuId, dryRun: false };
  });
}

/* ======================================================================================
   JEMBATAN LAPORAN - MODUL GUDANG  (Executive Summary untuk AI CEO "Jaya")
   Prinsip "Token-Efficient Agentic Workflow":
   - Sistem = OTOT: baca sheet, hitung semua matematika (velocity, sisa hari, saran qty, flag anomali).
   - AI     = OTAK: hanya membaca JSON ringkas ini (~1-3 KB), lalu memutuskan aksi lewat jalur
     execute_action yang SUDAH ADA (executeAiAction + Execution_Logs + Auto-Pilot whitelist).
   - TIDAK ADA data mentah yang keluar: hanya angka agregat + daftar SKU kritis (maks WH_MAKS_SKU).
   - Daftar SKU dikirim format KOLOM + BARIS (nama kolom ditulis sekali) -> hemat token ~40%.
   - Tiap bagian dibungkus try/catch sendiri: 1 sheet error tidak menggagalkan seluruh laporan
     (bagian yang gagal tercatat di "error" + flag DATA_TIDAK_LENGKAP).
   - Hasil disimpan 1 baris per tanggal di sheet AI_Executive_Summary (riwayat tren + audit) + cache.
   Cara pakai:
     1) Editor Apps Script: jalankan tesRingkasanGudang() -> lihat JSON & perkiraan token di Log.
     2) Jalankan aktifkanRingkasanGudangHarian() SEKALI -> snapshot otomatis tiap hari jam 21:00.
     3) Front-end / AI: doPost aksi 'ringkasan_gudang_harian' atau execute_action GET_WAREHOUSE_SUMMARY.
   Parameter (Script Properties, opsional - tanpa ubah kode):
     WH_LEAD_TIME_HARI (3)  : lama supplier mengirim -> stok di bawah ini = KRITIS
     WH_HARI_MENIPIS (7)    : sisa hari di bawah ini = MENIPIS
     WH_TARGET_COVER_HARI (14): saran pesan ulang = cukup untuk sekian hari
     WH_AMBANG_UNIT (5)     : fallback (mock) bila belum ada data penjualan 30 hari
     WH_MAKS_SKU (15)       : jumlah maksimal SKU yang dikirim ke AI
   ====================================================================================== */
var WH_SKEMA_ = 'wh.daily.v1';
var WH_SHEET_ = 'AI_Executive_Summary';
var WH_HEADER_ = ['Tanggal', 'Modul', 'Skema', 'Dibuat', 'Durasi (ms)', 'Ukuran (char)', 'JSON'];
var WH_CACHE_ = 'WH_SUMMARY_V1_';
var WH_UMUR_SEGAR_MENIT_ = 30;
var WH_HARI_MS_ = 86400000;
var WH_URUTAN_STATUS_ = { HABIS: 0, KRITIS: 1, MENIPIS: 2 };
var WH_KAMUS_FLAG_ = {
  OUTBOUND_NOL: 'Belum ada resi keluar padahal biasanya ada',
  OUTBOUND_TURUN: 'Resi keluar >=30% di bawah rata-rata 7 hari (jam yang sama)',
  OUTBOUND_NAIK: 'Resi keluar >=30% di atas rata-rata 7 hari (jam yang sama)',
  PENDING_TUA: 'Ada resi Pending lebih dari 2 hari',
  RESI_TANPA_PESANAN: 'Ada resi discan keluar yang tidak cocok ke pesanan mana pun',
  RETUR_TINGGI: 'Rasio retur hari ini jauh di atas rata-rata 7 hari',
  HILANG_RUSAK: 'Ada laporan barang hilang/rusak hari ini',
  STOK_HABIS_ADA_PESANAN: 'Ada SKU habis/minus yang masih punya pesanan menunggu (oversell)',
  STOK_KRITIS: 'Ada SKU habis/kritis',
  DATA_TIDAK_LENGKAP: 'Sebagian bagian laporan gagal dihitung (lihat field error)'
};

function whParam_() {
  var p = PropertiesService.getScriptProperties();
  function n(k, d) { var v = parseFloat(p.getProperty(k)); return isFinite(v) && v > 0 ? v : d; }
  return {
    leadTimeHari: n('WH_LEAD_TIME_HARI', 3), hariMenipis: n('WH_HARI_MENIPIS', 7),
    targetCoverHari: n('WH_TARGET_COVER_HARI', 14), ambangUnit: n('WH_AMBANG_UNIT', 5),
    maksSku: Math.round(n('WH_MAKS_SKU', 15))
  };
}
function whR1_(x) { return Math.round(x * 10) / 10; }
function whAwalHari_(ms, tz) {
  return Utilities.parseDate(Utilities.formatDate(new Date(ms), tz, 'yyyy-MM-dd') + ' 00:00:00', tz, 'yyyy-MM-dd HH:mm:ss').getTime();
}
// Hitung baseline 7 hari sebelumnya. batasJamMs = null -> hari penuh; angka -> hanya s/d jam yang sama
// (supaya laporan siang hari tidak dibandingkan dengan hari penuh kemarin).
function whMasukBaseline_(ms, awalMs, batasJamMs) {
  if (ms >= awalMs || ms < awalMs - 7 * WH_HARI_MS_) return false;
  if (batasJamMs === null) return true;
  var k = Math.ceil((awalMs - ms) / WH_HARI_MS_);
  return (ms - (awalMs - k * WH_HARI_MS_)) < batasJamMs;
}

/* ---------- 1) RESI KELUAR + PENDING ---------- */
function whRingkasKeluar_(awalMs, akhirMs, batasJamMs, tz) {
  var hasil = {
    scan: 0, rata7Hari: 0, deltaPct: null, jamPertama: null, jamTerakhir: null,
    perKurir: {}, perStaff: {}, tanpaPesanan: 0, contohTanpaPesanan: [],
    pending: { total: 0, lebih2Hari: 0, tertuaHari: 0, contoh: [] }, _total7: 0
  };
  var sh = getSheetInfo('keluar').sheet, lr = sh.getLastRow();
  if (lr < 2) return hasil;
  var n = lr - 1, maksKol = sh.getMaxColumns();
  // Cuma 2 kolom yang dibaca penuh (Tanggal Scan & Status Pending); detail dibaca khusus baris yang dipakai
  var tgl = sh.getRange(2, 3, n, 1).getValues();
  var st = maksKol >= 11 ? sh.getRange(2, 11, n, 1).getValues() : null;
  var idxHariIni = [], idxPending = [], base = 0, total7 = 0;
  for (var i = 0; i < n; i++) {
    if (st && String(st[i][0] || '').trim() === 'Pending') { idxPending.push(i); continue; }
    var t = tgl[i][0];
    if (!(t instanceof Date)) continue;
    var ms = t.getTime();
    if (ms >= awalMs && ms < akhirMs) { idxHariIni.push(i); continue; }
    if (whMasukBaseline_(ms, awalMs, null)) total7++;
    if (whMasukBaseline_(ms, awalMs, batasJamMs)) base++;
  }
  hasil._total7 = total7;

  if (idxHariIni.length) {
    var vals = rhBacaBarisBerkelompok_(sh, idxHariIni, Math.min(10, maksKol), 50);
    var daftarPola = null, ringkas = null, minMs = 0, maksMs = 0;
    try { ringkas = petaResiRingkasCache_(); } catch (eP) { ringkas = null; }
    idxHariIni.forEach(function (idx) {
      var r = vals[idx];
      if (!r) return;
      var noResi = String(r[0] || '').trim();
      if (!noResi) return;
      hasil.scan++;
      var ms2 = tgl[idx][0].getTime();
      if (!minMs || ms2 < minMs) minMs = ms2;
      if (ms2 > maksMs) maksMs = ms2;
      var kurir = String(r[9] || '').trim();
      if (!kurir) { if (daftarPola === null) daftarPola = muatDaftarPolaPelajari(); kurir = deteksiKurirCepat(noResi, daftarPola); }
      hasil.perKurir[kurir] = (hasil.perKurir[kurir] || 0) + 1;
      var staff = String(r[8] || '').trim() || 'Tidak Diketahui';
      hasil.perStaff[staff] = (hasil.perStaff[staff] || 0) + 1;
      if (ringkas && !cariPetaResiRingkas_(ringkas, noResi)) {
        hasil.tanpaPesanan++;
        if (hasil.contohTanpaPesanan.length < 5) hasil.contohTanpaPesanan.push(noResi);
      }
    });
    if (minMs) { hasil.jamPertama = Utilities.formatDate(new Date(minMs), tz, 'HH:mm'); hasil.jamTerakhir = Utilities.formatDate(new Date(maksMs), tz, 'HH:mm'); }
    if (!ringkas) hasil.tanpaPesanan = null; // peta pesanan gagal dimuat -> jangan laporkan 0 palsu
  }
  hasil.rata7Hari = whR1_(base / 7);
  hasil.deltaPct = hasil.rata7Hari > 0 ? whR1_((hasil.scan - hasil.rata7Hari) / hasil.rata7Hari * 100) : null;

  // Pending: detail cuma untuk baris Pending (biasanya sedikit)
  if (idxPending.length && maksKol >= 12) {
    var det = rhBacaBarisBerkelompok_(sh, idxPending, 12, 30), daftar = [];
    var hariIniAwal = whAwalHari_(Date.now(), tz);
    idxPending.forEach(function (idx) {
      var r = det[idx];
      if (!r || !String(r[0] || '').trim()) return;
      var tp = r[11], hari = 0;
      if (tp instanceof Date) hari = Math.max(0, Math.round((hariIniAwal - whAwalHari_(tp.getTime(), tz)) / WH_HARI_MS_));
      daftar.push({ resi: String(r[0]).trim(), kurir: String(r[9] || '').trim() || 'Tidak Diketahui', hari: hari });
    });
    daftar.sort(function (a, b) { return b.hari - a.hari; });
    hasil.pending.total = daftar.length;
    hasil.pending.lebih2Hari = daftar.filter(function (x) { return x.hari > 2; }).length;
    hasil.pending.tertuaHari = daftar.length ? daftar[0].hari : 0;
    hasil.pending.contoh = daftar.slice(0, 5);
  }
  return hasil;
}

/* ---------- 2) RETUR & STOCK MASUK (cukup 1 kolom tanggal) ---------- */
function whHitungHarian_(tipe, awalMs, akhirMs, batasJamMs) {
  var konf = RH_KONFIG_SHEET[tipe];
  var sh = getSheetInfo(tipe).sheet, lr = sh.getLastRow(), out = { hariIni: 0, base: 0, total7: 0 };
  if (lr < 2) return out;
  sh.getRange(2, konf.kolomTanggal, lr - 1, 1).getValues().forEach(function (r) {
    var t = r[0];
    if (!(t instanceof Date)) return;
    var ms = t.getTime();
    if (ms >= awalMs && ms < akhirMs) { out.hariIni++; return; }
    if (whMasukBaseline_(ms, awalMs, null)) out.total7++;
    if (whMasukBaseline_(ms, awalMs, batasJamMs)) out.base++;
  });
  return out;
}

/* ---------- 3) LAPOR HILANG / RUSAK (baca ekor sheet saja) ---------- */
function whRingkasHilangRusak_(awalMs, akhirMs) {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), out = { memo: 0, qty: 0, perSku: {} };
  var shH = ss.getSheetByName('Memo Lapor Hilang Rusak'), shD = ss.getSheetByName('Memo Lapor Hilang Rusak Detail');
  if (!shH || !shD || shH.getLastRow() < 2 || shD.getLastRow() < 2) return out;
  var lrH = shH.getLastRow(), nH = Math.min(400, lrH - 1), memo = {};
  shH.getRange(lrH - nH + 1, 1, nH, 3).getValues().forEach(function (r) {
    var ms = smMs(r[1]);
    if (!ms || ms < awalMs || ms >= akhirMs) return;
    if (/tolak|batal/i.test(String(r[2] || ''))) return;
    memo[String(r[0] || '').trim()] = true;
  });
  out.memo = Object.keys(memo).length;
  if (!out.memo) return out;
  var lrD = shD.getLastRow(), nD = Math.min(2000, lrD - 1);
  shD.getRange(lrD - nD + 1, 1, nD, 3).getValues().forEach(function (r) {
    if (!memo[String(r[0] || '').trim()]) return;
    var q = parseFloat(r[2]) || 0, sku = String(r[1] || '').trim();
    out.qty += q;
    if (sku) out.perSku[sku] = (out.perSku[sku] || 0) + q;
  });
  return out;
}

/* ---------- 4) STOK KRITIS (mesin stok asli + velocity 30 hari) ---------- */
function whRingkasStok_(P) {
  var mesin = smHitungMesinStok({});
  try { smHitungPetaStok_(mesin); } catch (eC) { } // sekalian segarkan cache Monitor Stok (gratis, hasil sudah ada)

  var ter = cacheBesarGet_('TERLARIS_SKU_V1');
  if (!ter || !ter.peta) { ter = hitungTerlarisPerSku_(); try { cacheBesarPut_('TERLARIS_SKU_V1', ter, 1800); } catch (eT) { } }
  var jual30 = {}, adaVelocity = false;
  Object.keys(ter.peta || {}).forEach(function (kode) {
    var q = (ter.peta[kode] || [])[0] || 0;
    if (!(q > 0)) return;
    var induk = smKey(resolveSkuJualCepat_(kode)); // SKU marketplace/alias -> SKU master (sama seperti mesin stok)
    jual30[induk] = (jual30[induk] || 0) + q;
    adaVelocity = true;
  });

  var kandidat = [], dipantau = 0, jumlah = { HABIS: 0, KRITIS: 0, MENIPIS: 0 }, oversell = 0;
  mesin.daftar.forEach(function (p) {
    if (p.arsip || !p.terdaftar) return;
    var avail = Number(p.onAvailable) || 0, reserve = Number(p.onReserve) || 0, onOrder = Number(p.onOrder) || 0;
    var q30 = jual30[smKey(p.sku)] || 0, perHari = q30 / 30, status = null, hariSisa = null, saran = 0;
    if (adaVelocity) {
      if (perHari <= 0 && reserve <= 0) return;   // tidak laku & tidak ada pesanan = bukan urusan stok kritis
      dipantau++;
      if (perHari > 0) hariSisa = Math.max(0, avail) / perHari;
      if (avail <= 0) status = 'HABIS';
      else if (hariSisa !== null && hariSisa < P.leadTimeHari) status = 'KRITIS';
      else if (hariSisa !== null && hariSisa < P.hariMenipis) status = 'MENIPIS';
      else return;
      saran = Math.max(0, Math.ceil(perHari * P.targetCoverHari - avail - onOrder));
    } else {
      // MOCK sementara: belum ada data penjualan 30 hari -> pakai ambang unit (sama dengan dashboard <= 5)
      if (!p.adaAktivitas) return;
      dipantau++;
      if (avail > P.ambangUnit) return;
      status = avail <= 0 ? 'HABIS' : 'KRITIS';
      saran = Math.max(0, Math.ceil(P.ambangUnit * 2 - avail - onOrder));
    }
    jumlah[status]++;
    if (status === 'HABIS' && reserve > 0) oversell++;
    kandidat.push({ sku: p.sku, nama: String(p.nama || '').slice(0, 40), avail: avail, reserve: reserve, onOrder: onOrder,
      jual30: q30, hariSisa: hariSisa === null ? null : whR1_(hariSisa), status: status, saran: saran, perHari: perHari });
  });
  kandidat.sort(function (a, b) {
    return (WH_URUTAN_STATUS_[a.status] - WH_URUTAN_STATUS_[b.status]) ||
      ((a.hariSisa === null ? 1e9 : a.hariSisa) - (b.hariSisa === null ? 1e9 : b.hariSisa)) || (b.perHari - a.perHari);
  });
  var tampil = kandidat.slice(0, P.maksSku), s = mesin.statistik || {};
  return {
    metode: adaVelocity ? 'velocity-30-hari' : 'mock-ambang-unit',
    parameter: { leadTimeHari: P.leadTimeHari, hariMenipis: P.hariMenipis, targetCoverHari: P.targetCoverHari },
    skuDipantau: dipantau, jumlah: jumlah, skuOversell: oversell,
    tidakDitampilkan: Math.max(0, kandidat.length - tampil.length),
    kolom: ['sku', 'nama', 'avail', 'reserve', 'onOrder', 'jual30', 'hariSisa', 'status', 'saranQty'],
    data: tampil.map(function (x) { return [x.sku, x.nama, x.avail, x.reserve, x.onOrder, x.jual30, x.hariSisa, x.status, x.saran]; }),
    kesehatanData: { orderKeluarTanpaScan: s.orderKeluarTanpaScan || 0, orderReserveMacet: s.orderReserveMacet || 0, orderBelumBayar: s.orderBelumBayar || 0, poKeluarTanpaJejak: s.poKeluarTanpaJejak || 0 }
  };
}

/* ---------- AGREGATOR UTAMA ---------- */
// tanggalStr opsional 'yyyy-MM-dd' (default hari ini). Murni baca + hitung, tidak menyimpan apa pun.
function generateDailyWarehouseSummary(tanggalStr) {
  var mulai = Date.now(), tz = Session.getScriptTimeZone(), P = whParam_();
  var hariIni = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  if (!tanggalStr || !/^\d{4}-\d{2}-\d{2}$/.test(String(tanggalStr))) tanggalStr = hariIni;
  var awalMs = Utilities.parseDate(tanggalStr + ' 00:00:00', tz, 'yyyy-MM-dd HH:mm:ss').getTime();
  var akhirMs = awalMs + WH_HARI_MS_;
  var berjalan = tanggalStr === hariIni;
  var batasJamMs = berjalan ? (Date.now() - awalMs) : null;
  var error = {}, flags = [];
  function aman(nama, fn) { try { return fn(); } catch (e) { error[nama] = String(e && e.message || e).slice(0, 160); return null; } }

  var kel = aman('keluar', function () { return whRingkasKeluar_(awalMs, akhirMs, batasJamMs, tz); });
  var ret = aman('retur', function () { return whHitungHarian_('retur', awalMs, akhirMs, batasJamMs); });
  var stm = aman('stockMasuk', function () { return whHitungHarian_('stock', awalMs, akhirMs, batasJamMs); });
  var hr = aman('hilangRusak', function () { return whRingkasHilangRusak_(awalMs, akhirMs); });
  var stok = aman('stok', function () { return whRingkasStok_(P); });

  var out = {
    skema: WH_SKEMA_, modul: 'GUDANG', tanggal: tanggalStr, hariBerjalan: berjalan,
    dibuat: Utilities.formatDate(new Date(), tz, "yyyy-MM-dd'T'HH:mm:ssXXX"),
    keluar: null, masuk: null, kendala: null, stok: stok, flags: flags
  };

  if (kel) {
    out.keluar = { resiScan: kel.scan, rata7Hari: kel.rata7Hari, deltaPct: kel.deltaPct, jamPertama: kel.jamPertama, jamTerakhir: kel.jamTerakhir, perKurir: kel.perKurir, perStaff: kel.perStaff };
    if (kel.rata7Hari >= 10 && kel.deltaPct !== null) {
      if (kel.scan === 0 && (!berjalan || new Date().getHours() >= 12)) flags.push('OUTBOUND_NOL');
      else if (kel.deltaPct <= -30) flags.push('OUTBOUND_TURUN');
      else if (kel.deltaPct >= 30) flags.push('OUTBOUND_NAIK');
    }
  }
  if (ret || stm) {
    out.masuk = { returScan: ret ? ret.hariIni : null, stockMasukScan: stm ? stm.hariIni : null, returRatePct: null, returRate7HariPct: null };
    if (ret && kel) {
      out.masuk.returRatePct = kel.scan > 0 ? whR1_(ret.hariIni / kel.scan * 100) : null;
      out.masuk.returRate7HariPct = kel._total7 > 0 ? whR1_(ret.total7 / kel._total7 * 100) : null;
      if (ret.hariIni >= 3 && out.masuk.returRatePct !== null && out.masuk.returRatePct > Math.max(5, 2 * (out.masuk.returRate7HariPct || 0))) flags.push('RETUR_TINGGI');
    }
  }
  out.kendala = {
    totalKendalaAktif: (ret ? ret.hariIni : 0) + (kel ? kel.pending.total : 0) + (hr ? hr.memo : 0) + (kel && kel.tanpaPesanan ? kel.tanpaPesanan : 0),
    retur: ret ? ret.hariIni : null,
    pending: kel ? kel.pending : null,
    resiTanpaPesanan: kel ? { jumlah: kel.tanpaPesanan, contoh: kel.contohTanpaPesanan } : null,
    hilangRusak: hr
  };
  if (kel && kel.pending.lebih2Hari > 0) flags.push('PENDING_TUA');
  if (kel && kel.tanpaPesanan > 0) flags.push('RESI_TANPA_PESANAN');
  if (hr && hr.qty > 0) flags.push('HILANG_RUSAK');
  if (stok && stok.skuOversell > 0) flags.push('STOK_HABIS_ADA_PESANAN');
  if (stok && (stok.jumlah.HABIS + stok.jumlah.KRITIS) > 0) flags.push('STOK_KRITIS');
  if (Object.keys(error).length) { flags.push('DATA_TIDAK_LENGKAP'); out.error = error; }
  out.durasiMs = Date.now() - mulai;
  return out;
}

/* ---------- SNAPSHOT: simpan & ambil (AI cukup baca snapshot, tidak menghitung ulang) ---------- */
function whSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(WH_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(WH_SHEET_);
    sh.getRange(1, 1, 1, WH_HEADER_.length).setValues([WH_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('A:A').setNumberFormat('@');
  }
  return sh;
}
function whSimpanSnapshot_(ringkasan) {
  var teks = JSON.stringify(ringkasan);
  try { CacheService.getScriptCache().put(WH_CACHE_ + ringkasan.tanggal, teks, 21600); } catch (eC) { }
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return; // tidak kritis: cache tetap terisi
  try {
    var sh = whSheet_(), lr = sh.getLastRow(), baris = [ringkasan.tanggal, ringkasan.modul, ringkasan.skema, new Date(), ringkasan.durasiMs || 0, teks.length, teks];
    var target = 0;
    if (lr > 1) {
      var n = Math.min(120, lr - 1), awal = lr - n + 1;
      var v = sh.getRange(awal, 1, n, 2).getDisplayValues();
      for (var i = v.length - 1; i >= 0; i--) if (v[i][0] === ringkasan.tanggal && v[i][1] === ringkasan.modul) { target = awal + i; break; }
    }
    if (!target) target = lr + 1;
    sh.getRange(target, 1).setNumberFormat('@');
    sh.getRange(target, 1, 1, baris.length).setValues([baris]);
  } finally { lock.releaseLock(); }
}
// opsi: { tanggal?: 'yyyy-MM-dd', segar?: true }. Snapshot hari ini dipakai ulang bila umurnya < 30 menit;
// tanggal lampau selalu dari snapshot (kalau ada).
function whAmbilRingkasanGudang_(opsi) {
  opsi = opsi || {};
  var tz = Session.getScriptTimeZone(), hariIni = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  var tanggal = /^\d{4}-\d{2}-\d{2}$/.test(String(opsi.tanggal || '')) ? String(opsi.tanggal) : hariIni;
  if (!opsi.segar) {
    var lama = null;
    try { var c = CacheService.getScriptCache().get(WH_CACHE_ + tanggal); if (c) lama = JSON.parse(c); } catch (e) { }
    if (!lama && tanggal !== hariIni) {
      try {
        var sh = whSheet_(), lr = sh.getLastRow();
        if (lr > 1) {
          var n = Math.min(400, lr - 1), v = sh.getRange(lr - n + 1, 1, n, 7).getDisplayValues();
          for (var i = v.length - 1; i >= 0; i--) if (v[i][0] === tanggal && v[i][1] === 'GUDANG') { lama = JSON.parse(v[i][6]); break; }
        }
      } catch (eS) { }
    }
    if (lama) {
      var umurMenit = (Date.now() - new Date(lama.dibuat).getTime()) / 60000;
      if (tanggal !== hariIni || umurMenit < WH_UMUR_SEGAR_MENIT_ || opsi.bolehBasi) { lama.dariSnapshot = true; return lama; }
    }
  }
  var baru = generateDailyWarehouseSummary(tanggal);
  whSimpanSnapshot_(baru);
  return baru;
}

/* ---------- PINTU MASUK ---------- */
// doPost aksi: 'ringkasan_gudang_harian'  { tanggal?, segar? }
function prosesRingkasanGudangHarian(data) {
  try {
    if (!cekIzin(data.email, EKS_IZIN_)) throw new Error(PESAN_TIDAK_ADA_IZIN_);
    return { success: true, ringkasan: whAmbilRingkasanGudang_({ tanggal: data.tanggal, segar: !!data.segar }) };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}
// execute_action GET_WAREHOUSE_SUMMARY (baca saja -> tidak masuk Execution_Logs, boleh Auto-Pilot)
function whToolRingkasan_(params) {
  params = params || {};
  var r = whAmbilRingkasanGudang_({ tanggal: params.tanggal, segar: !!params.segar });
  var k = r.keluar || {}, s = r.stok || { jumlah: {} };
  var pesan = '📦 Gudang ' + r.tanggal + (r.hariBerjalan ? ' (berjalan)' : '') + ': ' + (k.resiScan || 0) + ' resi keluar' +
    (k.deltaPct !== null && k.deltaPct !== undefined ? ' (' + (k.deltaPct >= 0 ? '+' : '') + k.deltaPct + '% vs 7 hari)' : '') +
    ', kendala ' + ((r.kendala && r.kendala.totalKendalaAktif) || 0) +
    ', stok HABIS ' + (s.jumlah.HABIS || 0) + ' / KRITIS ' + (s.jumlah.KRITIS || 0) + ' / MENIPIS ' + (s.jumlah.MENIPIS || 0) +
    (r.flags && r.flags.length ? '\nFlag: ' + r.flags.join(', ') : '');
  return { status: 'SUCCESS', bacaSaja: true, target: 'Gudang ' + r.tanggal, data: r, pesan: pesan };
}

/* ---------- TRIGGER & TES ---------- */
function whRingkasanGudangTerjadwal() {
  denganIzinSistem_(function () { whSimpanSnapshot_(generateDailyWarehouseSummary()); });
}
// Jalankan SEKALI dari editor. Ubah jam lewat argumen bila gudang tutup lebih awal/lambat.
function aktifkanRingkasanGudangHarian(jam) {
  jam = Math.max(0, Math.min(23, parseInt(jam, 10) || 21));
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'whRingkasanGudangTerjadwal') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('whRingkasanGudangTerjadwal').timeBased().everyDays(1).atHour(jam).create();
  Logger.log('Ringkasan Gudang harian aktif tiap jam ' + jam + ':00.');
}
// Jalankan dari editor untuk melihat hasil + perkiraan token (± 1 token per 4 karakter).
function tesRingkasanGudang() {
  var r = generateDailyWarehouseSummary();
  var teks = JSON.stringify(r);
  Logger.log(JSON.stringify(r, null, 2));
  Logger.log('Ukuran: ' + teks.length + ' karakter (~' + Math.ceil(teks.length / 4) + ' token), dihitung ' + r.durasiMs + ' ms.');
}

/* ======================================================================================
   PANEL KONFIRMASI AI CEO - MODUL GUDANG
   Alur: Ringkasan (whAmbilRingkasanGudang_) -> Jaya membaca JSON ringkas -> keputusan JSON
         -> divalidasi server (whitelist aksi, SKU wajib ada di daftar kritis, qty dibatasi)
         -> tampil di Panel Konfirmasi -> Owner klik "Setujui & Eksekusi" (executeAiAction) atau "Tolak" (dicatat).
   - Hemat token: keputusan di-cache per snapshot ringkasan (buka panel berulang = 0 token).
   - Tahan gagal: kalau AI tidak tersedia (key kosong / kuota habis), sistem memberi saran berbasis aturan
     dari saranQty yang sudah dihitung, ditandai sumber "aturan-sistem".
   - Penolakan Owner ikut dibaca Jaya di analisa berikutnya supaya saran yang sama tidak diulang.
   ====================================================================================== */
var CEO_AKSI_PANEL_ = { CREATE_RESTOCK_MEMO: true };
var CEO_CACHE_ = 'CEO_GUDANG_V1_';
var CEO_MAKS_KEPUTUSAN_ = 3;

function ceoPromptSistem_() {
  return [
    'Kamu adalah Jaya, AI CEO OmniAI (ERP Waterground Coffee & Conner Hardware).',
    'Kamu HANYA menerima Executive Summary gudang dalam JSON (skema wh.daily.v1). Semua angka sudah dihitung sistem - jangan menghitung ulang, jangan mengarang data.',
    'Arti kolom stok.data: avail = stok tersedia (boleh minus = oversell, disengaja), reserve = pesanan menunggu, onOrder = sudah dipesan ke supplier,',
    'jual30 = terjual 30 hari, hariSisa = perkiraan hari stok habis, saranQty = saran pesan ulang dari sistem.',
    'Tugas: evaluasi kondisi gudang hari ini dan putuskan aksi paling berdampak. Prioritaskan SKU HABIS dengan reserve > 0, lalu KRITIS.',
    'Aksi yang BOLEH kamu usulkan (selain itu DILARANG):',
    '- CREATE_RESTOCK_MEMO params {"items":[{"sku":"SKU persis dari stok.data","qty":bilangan bulat}],"catatan":"opsional"} -> membuat Memo Minta Stock untuk tim pembelian.',
    '  Boleh menggabungkan beberapa SKU dalam 1 memo. Gunakan saranQty kecuali ada alasan kuat (jelaskan di alasan). Jangan usulkan SKU dengan saranQty 0.',
    'Masalah operasional yang tidak bisa dieksekusi (pending tua, resi tanpa pesanan, retur tinggi, hilang/rusak) tulis di "perhatian" sebagai instruksi singkat untuk manusia.',
    'Jangan mengulang usulan yang baru saja DITOLAK owner (lihat RIWAYAT) kecuali kondisinya memburuk - sebutkan itu di alasan.',
    'Balas HANYA JSON dengan bentuk persis:',
    '{"ringkasanEksekutif":"maks 2 kalimat","skorKesehatan":0-100,"keputusan":[{"tool_call":"execute_action","action":"CREATE_RESTOCK_MEMO","params":{...},"judul":"maks 60 karakter, mis. Buat Memo Restock Moka Pot","alasan":"1 kalimat alasan bisnis","prioritas":"tinggi|sedang|rendah"}],"perhatian":["maks 3 butir singkat"]}',
    'Maksimal ' + CEO_MAKS_KEPUTUSAN_ + ' keputusan. Kalau tidak ada yang perlu dieksekusi, "keputusan" = [].'
  ].join('\n');
}

// Riwayat ringkas keputusan panel (3 hari terakhir) - supaya Jaya tahu apa yang sudah disetujui / ditolak
function ceoRiwayatRingkas_() {
  try {
    var batas = Date.now() - 3 * WH_HARI_MS_;
    return sptToolLihatLog_({ limit: 40 }).data.filter(function (x) {
      var t = new Date(x.Timestamp).getTime(); // tampilan tanggal lokal bisa gagal diurai -> tetap diikutkan (sudah urut terbaru)
      return x.Action_Type === 'CREATE_RESTOCK_MEMO' && (isNaN(t) || t >= batas);
    }).slice(0, 6).map(function (x) { return x.Timestamp + ' | ' + x.Status + ' | ' + String(x['New_Value'] || x['SKU/Target'] || '').slice(0, 160); });
  } catch (e) { return []; }
}

// Peta SKU kritis dari ringkasan: { SKU_KEY: { sku, nama, avail, saranQty, status } }
function ceoPetaSkuKritis_(ringkasan) {
  var s = ringkasan && ringkasan.stok, peta = {};
  if (!s || !s.kolom || !s.data) return peta;
  var ix = {}; s.kolom.forEach(function (k, i) { ix[k] = i; });
  s.data.forEach(function (r) {
    peta[smKey(r[ix.sku])] = { sku: r[ix.sku], nama: r[ix.nama], avail: r[ix.avail], reserve: r[ix.reserve], saranQty: r[ix.saranQty], status: r[ix.status] };
  });
  return peta;
}

// Saring keputusan AI: hanya aksi whitelist, SKU yang memang ada di daftar kritis, qty bulat & wajar
function ceoValidasiKeputusan_(daftar, peta) {
  var hasil = [], ditolak = [];
  (Array.isArray(daftar) ? daftar : []).slice(0, CEO_MAKS_KEPUTUSAN_).forEach(function (k) {
    if (!k || typeof k !== 'object') return;
    var act = String(k.action || '').toUpperCase().trim();
    if (!CEO_AKSI_PANEL_[act]) { ditolak.push((act || '(kosong)') + ': aksi di luar wewenang panel'); return; }
    var p = k.params || {}, items = [], sudah = {};
    (Array.isArray(p.items) ? p.items : []).forEach(function (it) {
      var info = peta[smKey(it && it.sku)];
      if (!info) { ditolak.push('SKU ' + (it && it.sku) + ' tidak ada di daftar stok kritis'); return; }
      if (sudah[smKey(info.sku)]) return;
      var dasar = Math.max(1, Number(info.saranQty) || 0);
      var qty = Math.round(Number(it.qty));
      if (!(qty > 0)) qty = Number(info.saranQty) || 0;
      if (qty > dasar * 3) { ditolak.push('Qty ' + info.sku + ' dipangkas ke ' + (dasar * 3) + ' (maks 3x saran sistem)'); qty = dasar * 3; }
      if (!(qty > 0)) return;
      sudah[smKey(info.sku)] = true;
      items.push({ sku: info.sku, nama: info.nama, qty: qty, saranQty: Number(info.saranQty) || 0, status: info.status, avail: info.avail });
    });
    if (!items.length) return;
    hasil.push({
      tool_call: 'execute_action', action: act,
      params: { items: items.map(function (x) { return { sku: x.sku, qty: x.qty }; }), catatan: String(p.catatan || '').slice(0, 200) },
      judul: String(k.judul || ('Buat Memo Restock ' + items[0].nama)).slice(0, 80),
      alasan: String(k.alasan || '').slice(0, 300),
      prioritas: /^(tinggi|sedang|rendah)$/.test(String(k.prioritas)) ? k.prioritas : 'sedang',
      detailItem: items
    });
  });
  return { keputusan: hasil, catatanValidasi: ditolak };
}

// Saran cadangan tanpa AI: 1 memo untuk semua SKU HABIS/KRITIS yang saranQty > 0
function ceoSaranAturan_(ringkasan, alasanFallback) {
  var peta = ceoPetaSkuKritis_(ringkasan), items = [];
  Object.keys(peta).forEach(function (k) {
    var x = peta[k];
    if ((x.status === 'HABIS' || x.status === 'KRITIS') && Number(x.saranQty) > 0) items.push({ sku: x.sku, qty: Number(x.saranQty) });
  });
  var v = ceoValidasiKeputusan_(items.length ? [{
    action: 'CREATE_RESTOCK_MEMO', params: { items: items.slice(0, 20), catatan: 'Saran otomatis sistem (aturan saranQty)' },
    judul: 'Buat Memo Restock ' + items.length + ' SKU kritis', alasan: 'Stok HABIS/KRITIS di bawah lead time - jumlah mengikuti saran sistem.', prioritas: 'tinggi'
  }] : [], peta);
  var j = (ringkasan.stok && ringkasan.stok.jumlah) || {};
  return {
    ringkasanEksekutif: 'AI tidak tersedia (' + alasanFallback + '). Saran disusun sistem dari angka ringkasan: ' + (j.HABIS || 0) + ' SKU habis, ' + (j.KRITIS || 0) + ' kritis.',
    skorKesehatan: null, keputusan: v.keputusan, perhatian: [], catatanValidasi: v.catatanValidasi, sumber: 'aturan-sistem'
  };
}

function ceoAnalisaGudang_(opsi) {
  opsi = opsi || {};
  var ringkasan = whAmbilRingkasanGudang_({ tanggal: opsi.tanggal, segar: !!opsi.segarRingkasan });
  var kunci = CEO_CACHE_ + ringkasan.tanggal + '_' + String(ringkasan.dibuat).replace(/\D/g, '');
  if (!opsi.segar) {
    try { var c = CacheService.getScriptCache().get(kunci); if (c) { var o = JSON.parse(c); o.dariCache = true; return { ringkasan: ringkasan, analisa: o }; } } catch (e) { }
  }
  var analisa;
  var agen = aiAgentKey_('jaya');
  if (!agen.key || !agen.model) {
    analisa = ceoSaranAturan_(ringkasan, 'API key Jaya belum diatur');
  } else {
    var ringkasBersih = JSON.parse(JSON.stringify(ringkasan));
    delete ringkasBersih.dariSnapshot; delete ringkasBersih.durasiMs;
    var target = '';
    try { target = String(memoryBlokPrompt_(false) || '').slice(0, 1500); } catch (eM) { }
    var riwayat = ceoRiwayatRingkas_();
    var prompt = 'EXECUTIVE SUMMARY GUDANG:\n' + JSON.stringify(ringkasBersih) +
      '\n\nKAMUS FLAG: ' + JSON.stringify(WH_KAMUS_FLAG_) +
      (target ? '\n\nTARGET & ATURAN BISNIS:\n' + target : '') +
      '\n\nRIWAYAT KEPUTUSAN RESTOCK 3 HARI (waktu | status | isi):\n' + (riwayat.length ? riwayat.join('\n') : '(belum ada)');
    var hasilAi = null, errAi = null;
    for (var coba = 1; coba <= 2; coba++) {
      try { hasilAi = aiPanggilUniversal_(agen, { system: ceoPromptSistem_(), prompt: prompt, json: true, suhu: 0.2, maksToken: 1500 }); break; }
      catch (eA) { errAi = eA; if (!((eA.httpKode === 429 || eA.httpKode >= 500) && coba < 2)) break; Utilities.sleep(2000); }
    }
    if (hasilAi) { try { aiwCatatToken_(hasilAi.usage); } catch (eT) { } }
    var json = null;
    if (hasilAi) { try { json = aiParseJsonLonggar_(hasilAi.teks); } catch (eP) { errAi = new Error('Balasan AI bukan JSON valid'); } }
    if (!json) {
      analisa = ceoSaranAturan_(ringkasan, String(errAi && errAi.message || errAi || 'tidak ada balasan').slice(0, 120));
    } else {
      var v = ceoValidasiKeputusan_(json.keputusan, ceoPetaSkuKritis_(ringkasan));
      var skor = Number(json.skorKesehatan);
      analisa = {
        ringkasanEksekutif: String(json.ringkasanEksekutif || '').slice(0, 400),
        skorKesehatan: isFinite(skor) ? Math.max(0, Math.min(100, Math.round(skor))) : null,
        keputusan: v.keputusan,
        perhatian: (Array.isArray(json.perhatian) ? json.perhatian : []).slice(0, 3).map(function (x) { return String(x).slice(0, 200); }),
        catatanValidasi: v.catatanValidasi, sumber: 'jaya', model: agen.model,
        token: hasilAi.usage || null, ms: hasilAi.ms || null
      };
    }
  }
  analisa.dianalisa = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd'T'HH:mm:ssXXX");
  analisa.kunciSnapshot = kunci;
  try { CacheService.getScriptCache().put(kunci, JSON.stringify(analisa), 21600); } catch (eC) { }
  return { ringkasan: ringkasan, analisa: analisa };
}

/* ---------- doPost: analisa_ceo_gudang { segar?, segarRingkasan?, tanggal? } ---------- */
function prosesAnalisaCeoGudang(data) {
  try {
    if (!cekIzin(data.email, EKS_IZIN_)) throw new Error(PESAN_TIDAK_ADA_IZIN_);
    var r = ceoAnalisaGudang_({ segar: !!data.segar, segarRingkasan: !!data.segarRingkasan, tanggal: data.tanggal });
    return { success: true, ringkasan: r.ringkasan, analisa: r.analisa };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

/* ---------- doPost: catat_tolak_ceo { keputusan:[...], alasan? } -> Execution_Logs (REJECTED_USER) ---------- */
function prosesCatatTolakCeo(data) {
  try {
    if (!cekIzin(data.email, EKS_IZIN_)) throw new Error(PESAN_TIDAK_ADA_IZIN_);
    var daftar = Array.isArray(data.keputusan) ? data.keputusan.slice(0, CEO_MAKS_KEPUTUSAN_) : [];
    if (!daftar.length) throw new Error('Tidak ada keputusan yang ditolak.');
    var alasan = String(data.alasan || '').trim().slice(0, 300);
    daftar.forEach(function (k) {
      var act = String(k && k.action || '').toUpperCase();
      if (!CEO_AKSI_PANEL_[act]) return;
      var items = ((k.params && k.params.items) || []).slice(0, 30).map(function (x) { return String(x.sku || '').slice(0, 60) + ' x' + (Number(x.qty) || 0); });
      eksCatatLog_('User - ' + data.email, act, items.join(', ').slice(0, 200) || '-', '', 'DITOLAK: ' + items.join(', '), 'REJECTED_USER',
        { pesan: 'Ditolak owner dari Panel AI CEO' + (alasan ? ': ' + alasan : ''), judul: k.judul, alasanAi: k.alasan });
    });
    return { success: true, dicatat: daftar.length };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

/* ---------- execute_action CREATE_RESTOCK_MEMO -> Memo Minta Stock (tab Memo Gudang) ---------- */
function whEksekusiRestockMemo_(params, opsi, actionId) {
  params = params || {};
  var items = Array.isArray(params.items) ? params.items : [];
  if (!items.length) throw new Error('Daftar item restock kosong.');
  if (items.length > 50) throw new Error('Maksimal 50 SKU per memo restock AI.');
  var peta = {};
  try { peta = ceoPetaSkuKritis_(whAmbilRingkasanGudang_({ bolehBasi: true })); } catch (eR) { } // cukup untuk nama & sisa stok - tidak menghitung ulang mesin stok
  var paket = [], baru = [];
  items.forEach(function (it) {
    var sku = String(it && it.sku || '').trim(), qty = Math.round(Number(it && (it.qty || it.qtyMinta)));
    if (!sku) throw new Error('Ada item tanpa SKU.');
    if (!(qty > 0) || qty > 100000) throw new Error('Qty SKU ' + sku + ' tidak valid: ' + (it && it.qty));
    var info = peta[smKey(sku)] || {};
    paket.push({ sku: info.sku || sku, nama: info.nama || '', sisaStok: Number(info.avail) || 0, qtyMinta: qty,
      catatan: ('AI CEO' + (info.status ? ' - ' + info.status : '') + (params.catatan ? ' - ' + params.catatan : '')).slice(0, 200) });
    baru.push((info.sku || sku) + ' x' + qty);
  });
  var r = prosesSimpanMemoMintaStock({ email: opsi.email, items: paket, idPermintaan: actionId ? 'AI-' + String(actionId).slice(0, 70) : '' });
  if (!r || !r.success) return { status: 'FAILED', pesan: 'Memo restock gagal dibuat: ' + ((r && r.error) || 'tidak ada respons'), target: '-' };
  return { status: 'SUCCESS', target: r.noMemo, oldValue: '', newValue: baru.join(', '),
    pesan: 'Memo Minta Stock ' + r.noMemo + ' dibuat (' + paket.length + ' SKU)' + (r.duplikat ? ' - sudah pernah dibuat sebelumnya' : '') + '. Cek di Persediaan > Memo Gudang.' };
}


/* ============================================================
   EKSPOR MIGRASI KE SUPABASE  (BACA SAJA - tidak mengubah data apa pun)
   ------------------------------------------------------------
   Dipakai halaman migrasi.html untuk menyalin SEMUA tab + Script Properties
   ke sistem baru di Supabase, dengan verifikasi hash per potongan.
   - Hanya Owner aktif (atau developer terdaftar) yang bisa memanggil.
   - Nilai sel dikirim apa adanya; tanggal dikirim sebagai {"$d": epoch ms}
     supaya tidak bergeser zona waktu.
   - hash = SHA-256 dari JSON.stringify(nilai) -> dicocokkan di Supabase setelah
     data ditulis & dibaca ulang. Hash sama = isi identik sel per sel.
   ============================================================ */
var MIGRASI_MAKS_BARIS_ = 2000;

function migrasiWajibOwner_(email) {
  if (isDeveloperEmail_(email)) return;
  var s = getStaffByEmail(email);
  if (!s || !s.aktif || String(s.role || '').trim().toLowerCase() !== 'owner') {
    throw new Error('Ekspor migrasi hanya untuk akun Owner.');
  }
}

function migrasiEnkodeSel_(v) {
  if (v instanceof Date) return isNaN(v.getTime()) ? '' : { $d: v.getTime() };
  if (v === null || v === undefined) return '';
  if (typeof v === 'number' && !isFinite(v)) return String(v);
  return v;
}

function migrasiHash_(teks) {
  var b = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, teks, Utilities.Charset.UTF_8);
  var h = '';
  for (var i = 0; i < b.length; i++) {
    var x = b[i] < 0 ? b[i] + 256 : b[i];
    h += (x < 16 ? '0' : '') + x.toString(16);
  }
  return h;
}

// -> daftar semua tab + ukurannya (untuk progres & verifikasi jumlah baris/kolom)
function prosesMigrasiDaftarSheet(data) {
  try {
    migrasiWajibOwner_(data.email);
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var daftar = ss.getSheets().map(function (sh, i) {
      var tersembunyi = false;
      try { tersembunyi = sh.isSheetHidden(); } catch (e) { }
      return {
        nama: sh.getName(), urutan: i,
        lastRow: sh.getLastRow(), lastCol: sh.getLastColumn(),
        maksBaris: sh.getMaxRows(), maksKolom: sh.getMaxColumns(),
        barisBeku: sh.getFrozenRows(), tersembunyi: tersembunyi
      };
    });
    var jumlahProperti = Object.keys(PropertiesService.getScriptProperties().getProperties()).length;
    return { success: true, sheet: daftar, jumlahProperti: jumlahProperti, zonaWaktu: Session.getScriptTimeZone(), waktu: Date.now() };
  } catch (err) {
    return { success: false, error: err.message || String(err) };
  }
}

// -> isi 1 potongan tab: { sheet, barisMulai, jumlah, lebar }
function prosesMigrasiAmbilPotongan(data) {
  try {
    migrasiWajibOwner_(data.email);
    var nama = String(data.sheet || '');
    var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(nama);
    if (!sh) throw new Error('Tab "' + nama + '" tidak ditemukan.');
    var mulai = Math.max(1, parseInt(data.barisMulai, 10) || 1);
    var jumlah = Math.min(MIGRASI_MAKS_BARIS_, Math.max(1, parseInt(data.jumlah, 10) || 1000));
    var lastRow = sh.getLastRow();
    var lebar = parseInt(data.lebar, 10) || sh.getLastColumn();
    var nilai = [];
    if (lebar > 0 && mulai <= lastRow) {
      var n = Math.min(jumlah, lastRow - mulai + 1);
      var mentah = sh.getRange(mulai, 1, n, lebar).getValues();
      for (var i = 0; i < mentah.length; i++) {
        var baris = new Array(mentah[i].length);
        for (var j = 0; j < mentah[i].length; j++) baris[j] = migrasiEnkodeSel_(mentah[i][j]);
        nilai.push(baris);
      }
    }
    return { success: true, sheet: nama, barisMulai: mulai, lebar: lebar, lastRow: lastRow, nilai: nilai, hash: migrasiHash_(JSON.stringify(nilai)) };
  } catch (err) {
    return { success: false, error: err.message || String(err) };
  }
}

// -> semua Script Properties (token marketplace, API key, SESSION_SECRET, PASSWORD_PEPPER, dll.)
function prosesMigrasiAmbilProperti(data) {
  try {
    migrasiWajibOwner_(data.email);
