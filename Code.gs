/* ============================================================
   BERANDA CEPAT - REKAP HARIAN (pre-calculated daily summary)
   ------------------------------------------------------------
   Masalah lama: setiap klik rentang tanggal, server membaca ULANG semua sheet pesanan (6 channel),
   Resi Keluar, dan Stock Ledger lalu menghitung dari nol -> 20-40 detik, sering timeout
   sehingga tombol terlihat "tidak merespons".

   Arsitektur baru:
   1. REKAP (tulis, di belakang layar): rekapBerandaPerbarui_() membaca data mentah SEKALI, lalu menulis
      ringkasan per HARI ke 2 sheet kecil:
        - "Rekap Harian Beranda": 1 baris per (tanggal, channel) + 1 baris "_HARI" per tanggal
          (resi keluar, item terjual, kunci pelanggan unik ter-hash).
        - "Rekap Harian Produk" : 1 baris per (tanggal, SKU) = qty terjual.
      Dijalankan trigger tiap 10 menit (3 hari terakhir, karena status pesanan baru masih berubah)
      + tiap malam 02:30 (bangun ulang penuh). Trigger dipasang OTOMATIS dari web, tidak perlu ke Sheets.
   2. BACA (dasbor): aksi dashboard_rekap mengirim rekap harian ~120 hari sekaligus (ringan, cuma
      ratusan baris). Frontend menghitung rentang (Hari Ini/Kemarin/7/30 hari/custom) DI BROWSER ->
      klik tombol rentang = instan, tanpa panggil server. Data juga disimpan di localStorage sehingga
      Beranda langsung tampil saat dibuka, lalu diperbarui diam-diam di belakang.
   3. Metrik "saat ini" (stok rendah, selisih invoice) di-cache 5 menit.
   Angka tetap identik dengan Laporan Penjualan: sumber sama (prosesLihatSemuaPesananGabungan),
   aturan batal sama (KATA_BATAL_PENJUALAN), label channel sama (kanalLaporanPesanan_).
   ============================================================ */
var REKAP_SHEET_HARIAN = 'Rekap Harian Beranda';
var REKAP_SHEET_PRODUK = 'Rekap Harian Produk';
var REKAP_HEADER_HARIAN = ['Tanggal', 'Kanal', 'Omzet', 'Jumlah Pesanan', 'Jumlah Batal', 'Nilai Batal', 'Resi Keluar', 'Item Terjual', 'Kunci Pelanggan', 'Diperbarui', 'Resi Per Kanal'];
var REKAP_HEADER_PRODUK = ['Tanggal', 'SKU', 'Qty Terjual'];
var REKAP_KANAL = ['TikTok Shop', 'Tokopedia', 'Shopee', 'Website', 'PO Sales', 'Conner Hardware'];
var REKAP_HARI_KIRIM_DEFAULT = 120;   // hari yang dikirim ke browser (cukup untuk 30 hari + custom 3 bulan)
var REKAP_BASI_MENIT = 60;            // v2026.10-C: dasbor diperbarui 1 jam sekali (snapshot per jam) -> loading instan; data detik ini lewat tombol Live
//            // lebih tua dari ini -> frontend minta perbarui di belakang layar

// Izin khusus proses SISTEM (trigger) - hanya bisa diset dari kode server, tidak bisa dikirim dari browser.
var IZIN_SISTEM_ = false;
function denganIzinSistem_(fn) {
  var lama = IZIN_SISTEM_;
  IZIN_SISTEM_ = true;
  try { return fn(); } finally { IZIN_SISTEM_ = lama; }
}

function rekapSheet_(nama, header) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(nama);
  if (!sh) {
    sh = ss.insertSheet(nama);
    sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
    sh.getRange('A:B').setNumberFormat('@'); // tanggal disimpan TEKS yyyy-MM-dd, bukan Date (anti geser zona)
    sh.setFrozenRows(1);
  }
  return sh;
}

function rekapHashPelanggan_(teks) {
  var h = 5381;
  for (var i = 0; i < teks.length; i++) h = ((h << 5) + h + teks.charCodeAt(i)) | 0;
  return (h >>> 0).toString(36);
}

// Bangun / perbarui rekap. hariMundur = N -> hanya N hari terakhir yang dihitung ulang
// (baris lebih lama dipertahankan). hariMundur null/0 -> bangun ulang penuh.
function rekapBerandaPerbarui_(hariMundur) {
  var lock = kunciModul_('rekap');
  if (!lock.tryLock(25000)) return { success: false, error: 'Rekap sedang diperbarui proses lain, coba lagi sebentar.' };
  var t0 = Date.now();
  try {
    var tz = Session.getScriptTimeZone();
    var hariIniStr = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
    var batasStr = hariMundur ? Utilities.formatDate(new Date(Utilities.parseDate(hariIniStr, tz, 'yyyy-MM-dd').getTime() - (hariMundur - 1) * 86400000 + 12 * 3600000), tz, 'yyyy-MM-dd') : '0000-00-00';

    var hari = {};   // { 'yyyy-MM-dd': { kanal: {Shopee:[omzet,n,batal,nilaiBatal]}, resi, item, pel:{} } }
    var produk = {}; // { 'yyyy-MM-dd': { sku: qty } }
    function slot(tgl) {
      if (!hari[tgl]) hari[tgl] = { kanal: {}, resi: 0, item: 0, pel: {} };
      return hari[tgl];
    }

    // 1) Pesanan semua channel (izin sistem, karena trigger tidak punya email)
    var gab = denganIzinSistem_(function () {
      return prosesLihatSemuaPesananGabungan({ email: '', segar: true });
    });
    if (!gab.success) throw new Error('Gagal membaca pesanan gabungan: ' + gab.error);
    var aktif = 0, nilaiAktif = 0;
    // v2026.10-C: snapshot PER JAM (3 hari terakhir) untuk grafik Hari Ini / Kemarin + pembanding
    var batasJamStr = Utilities.formatDate(new Date(Utilities.parseDate(hariIniStr, tz, 'yyyy-MM-dd').getTime() - 2 * 86400000 + 12 * 3600000), tz, 'yyyy-MM-dd');
    var jamPeta = {};
    var KATA_SUDAH_JALAN = ['COMPLETED', 'SELESAI', 'DITERIMA', 'DELIVERED', 'SHIPPED', 'TRANSIT', 'COLLECTION', 'DIKIRIM', 'RETUR', 'RETURN', 'KOMPLAIN'];
    (gab.daftar || []).forEach(function (o) {
      var st = String(o.status || '').toUpperCase();
      var total = parseFloat(o.total) || 0;
      var batal = KATA_BATAL_PENJUALAN.some(function (k) { return st.indexOf(k) !== -1; });
      if (!batal && (st.indexOf('BELUM') !== -1 || !KATA_SUDAH_JALAN.some(function (k) { return st.indexOf(k) !== -1; }))) { aktif++; nilaiAktif += total; }

      var ms = msTanggalPesanan_(o);
      if (!ms) return;
      var tgl = Utilities.formatDate(new Date(ms), tz, 'yyyy-MM-dd');
      var kanal = kanalLaporanPesanan_(o);
      // v2026.10.108 (DN-461): snapshot per jam 3 hari SELALU dihitung - dulu rekap 1 hari (tarikan iklan per jam)
      // menghapus data per jam kemarin sehingga pembanding "Hari ini" di Beranda jadi Rp 0.
      if (!batal && tgl >= batasJamStr) rekapJamTambah_(jamPeta, tgl, parseInt(Utilities.formatDate(new Date(ms), tz, 'H'), 10), kanal, total, 1, 0);
      if (tgl < batasStr) return;
      var s = slot(tgl);
      var k = s.kanal[kanal] || (s.kanal[kanal] = [0, 0, 0, 0]);
      if (batal) { k[2]++; k[3] += total; return; }
      k[0] += total; k[1]++;
      var hp = String(o.hpManual || '').replace(/\D/g, '').replace(/^62/, '0');
      var nama = String(o.pembeli || '').trim().toLowerCase();
      var kunci = hp.length >= 8 ? 'hp:' + hp : ((nama && nama !== '-' && nama !== '(tersamar)') ? 'nm:' + kanal + ':' + nama : '');
      if (kunci) s.pel[rekapHashPelanggan_(kunci)] = true;
    });

    // 2) Resi keluar per hari (+ jumlah Pending saat ini)
    var infoKeluar = getSheetInfo('keluar');
    var shKeluar = infoKeluar.sheet;
    var lrK = shKeluar.getLastRow();
    var resiPending = 0;
    if (lrK > 1) {
      var tglResi = shKeluar.getRange(2, infoKeluar.dateCol, lrK - 1, 1).getValues();
      var noResiKol = shKeluar.getRange(2, 1, lrK - 1, 1).getValues();
      var petaResiRekap = null;
      try { petaResiRekap = bangunPetaResiKeSemuaPesananCache_(); } catch (ePR) { petaResiRekap = null; }
      var pend = shKeluar.getRange(2, 11, lrK - 1, 1).getValues();
      for (var i = 0; i < tglResi.length; i++) {
        if (String(pend[i][0] || '').trim() === 'Pending') { resiPending++; continue; }
        var tr = tglResi[i][0];
        if (!(tr instanceof Date)) continue;
        var ts = Utilities.formatDate(tr, tz, 'yyyy-MM-dd');
        if (ts >= batasJamStr) rekapJamTambah_(jamPeta, ts, parseInt(Utilities.formatDate(tr, tz, 'H'), 10), '_RESI', 0, 0, 1);
        if (ts < batasStr) continue;
        slot(ts).resi++;
        // v2026.10-C: resi per channel (popover Resi Terkirim) + resi per jam
        var kanalR = 'Belum Terhubung';
        if (petaResiRekap) { var cR = petaResiRekap[kunciResi_(noResiKol[i][0])]; if (cR) kanalR = cR.jenis === 'transfer' ? 'Pengiriman Kilat' : (cR.toko === 'Conner' ? 'Conner Hardware' : (cR.sumber || 'Lainnya')); }
        var sR = slot(ts); sR.resiK = sR.resiK || {}; sR.resiK[kanalR] = (sR.resiK[kanalR] || 0) + 1;
      }
    }

    // 3) Item terjual per hari per SKU (Stock Ledger "Terjual..." kedua toko)
    // FIX: namaSheetToko() saat ini mengembalikan nama sheet yang SAMA untuk kedua toko -> dulu Stock Ledger
    // terbaca 2x dan "Item Terjual" jadi dobel. Sekarang tiap sheet fisik hanya dibaca sekali.
    var ledgerSudahDibaca = {};
    ['Waterground', 'Conner Hardware'].forEach(function (toko) {
      try {
        var shL = getStockLedgerSheet(toko);
        if (ledgerSudahDibaca[shL.getName()]) return;
        ledgerSudahDibaca[shL.getName()] = true;
        var lrL = shL.getLastRow();
        if (lrL < 2) return;
        shL.getRange(2, 1, lrL - 1, 4).getValues().forEach(function (r) {
          var t = r[0], sku = String(r[1] || '').trim(), jenis = String(r[2] || '');
          if (!sku || jenis.indexOf('Terjual') !== 0 || !(t instanceof Date)) return;
          var tl = Utilities.formatDate(t, tz, 'yyyy-MM-dd');
          if (tl < batasStr) return;
          var q = parseFloat(r[3]) || 0;
          slot(tl).item += q;
          var p = produk[tl] || (produk[tl] = {});
          p[sku] = (p[sku] || 0) + q;
        });
      } catch (eL) { /* toko ini dilewati */ }
    });

    // 4) Tulis sheet: pertahankan baris lama (< batas), ganti sisanya
    var sekarang = new Date();
    var shH = rekapSheet_(REKAP_SHEET_HARIAN, REKAP_HEADER_HARIAN);
    var shP = rekapSheet_(REKAP_SHEET_PRODUK, REKAP_HEADER_PRODUK);
    function barisLama(sh, nKol) {
      var lr = sh.getLastRow();
      if (lr < 2 || !hariMundur) return [];
      return sh.getRange(2, 1, lr - 1, nKol).getValues().filter(function (r) { return String(r[0]) && String(r[0]) < batasStr; });
    }
    var barisH = barisLama(shH, REKAP_HEADER_HARIAN.length);
    Object.keys(hari).sort().forEach(function (tgl) {
      var s = hari[tgl];
      Object.keys(s.kanal).forEach(function (kn) {
        var v = s.kanal[kn];
        barisH.push([tgl, kn, v[0], v[1], v[2], v[3], '', '', '', sekarang, '']);
      });
      barisH.push([tgl, '_HARI', '', '', '', '', s.resi, s.item, Object.keys(s.pel).join(','), sekarang, s.resiK ? JSON.stringify(s.resiK) : '']);
    });
    var barisP = barisLama(shP, REKAP_HEADER_PRODUK.length);
    Object.keys(produk).sort().forEach(function (tgl) {
      Object.keys(produk[tgl]).forEach(function (sku) { barisP.push([tgl, sku, produk[tgl][sku]]); });
    });
    [[shH, barisH, REKAP_HEADER_HARIAN.length], [shP, barisP, REKAP_HEADER_PRODUK.length]].forEach(function (x) {
      var sh = x[0], rows = x[1], n = x[2];
      rows.sort(function (a, b) { return String(a[0]) < String(b[0]) ? -1 : (String(a[0]) > String(b[0]) ? 1 : 0); });
      var lr = sh.getLastRow();
      if (lr > 1) sh.getRange(2, 1, lr - 1, n).clearContent();
      if (rows.length) {
        sh.getRange(2, 1, rows.length, 2).setNumberFormat('@');
        sh.getRange(2, 1, rows.length, n).setValues(rows);
      }
    });

    var props = PropertiesService.getScriptProperties();
    props.setProperty('REKAP_BERANDA_DIPERBARUI', String(sekarang.getTime()));
    props.setProperty('REKAP_BERANDA_SNAPSHOT', JSON.stringify({ pesananAktif: aktif, nilaiAktif: nilaiAktif, resiPending: resiPending }));
    try { rekapJamTulis_(jamPeta); } catch (eJam) { Logger.log('Rekap per jam gagal: ' + eJam); }
    return { success: true, durasiMs: Date.now() - t0, hari: Object.keys(hari).length, diperbarui: sekarang.getTime() };
  } catch (err) {
    Logger.log('❌ Rekap Beranda gagal: ' + err);
    return { success: false, error: err.toString() };
  } finally {
    lepasKunci_(lock);
  }
}

// Handler trigger (tanpa parameter)
function rekapBerandaTriggerCepat() {
  // Ada penjualan lampau (backdate) -> rekap dihitung ulang sampai tanggal itu, lalu data Finance dibangun ulang
  var props = PropertiesService.getScriptProperties();
  var mundur = Number(props.getProperty('REKAP_PERLU_MUNDUR') || 0);
  var hasil = rekapBerandaPerbarui_(Math.max(3, mundur));
  if (mundur && (!hasil || hasil.success !== false)) { props.deleteProperty('REKAP_PERLU_MUNDUR'); try { finInvalidasi_(); } catch (e) { } }
  finPanaskanCache_();
}
function rekapBerandaTriggerMalam() { rekapBerandaPerbarui_(0); }

// Pasang trigger sekali (dipanggil otomatis dari dasbor; aman dipanggil berulang)
function pastikanTriggerRekapBeranda_() {
  var cache = CacheService.getScriptCache();
  if (cache.get('REKAP_TRIGGER_OK')) return;
  try {
    var ada = {};
    ScriptApp.getProjectTriggers().forEach(function (t) { ada[t.getHandlerFunction()] = true; });
    if (!ada.rekapBerandaTriggerCepat) ScriptApp.newTrigger('rekapBerandaTriggerCepat').timeBased().everyMinutes(10).create();
    if (!ada.rekapBerandaTriggerMalam) ScriptApp.newTrigger('rekapBerandaTriggerMalam').timeBased().everyDays(1).atHour(2).nearMinute(30).create();
    cache.put('REKAP_TRIGGER_OK', '1', 1800); // cek ulang tiap 30 menit - trigger yang hilang/nonaktif langsung dipasang lagi
  } catch (e) { Logger.log('⚠️ Trigger rekap belum terpasang: ' + e); }
}

// Jalankan SEKALI dari editor kalau mau langsung membangun rekap penuh + memasang trigger.
function aktifkanRekapBeranda() {
  CacheService.getScriptCache().remove('REKAP_TRIGGER_OK');
  pastikanTriggerRekapBeranda_();
  var r = rekapBerandaPerbarui_(0);
  Logger.log(r.success ? '✅ Rekap Beranda dibangun (' + r.hari + ' hari, ' + r.durasiMs + ' ms). Trigger 10 menit & 02:30 aktif.' : '❌ ' + r.error);
}

// Baca rekap untuk rentang [mulai, akhir] (teks yyyy-MM-dd). Ringkas: siap dikirim ke browser.
function rekapBerandaBaca_(mulaiStr, akhirStr, izinPenjualan) {
  var shH = rekapSheet_(REKAP_SHEET_HARIAN, REKAP_HEADER_HARIAN);
  var shP = rekapSheet_(REKAP_SHEET_PRODUK, REKAP_HEADER_PRODUK);
  var hari = {};
  var lr = shH.getLastRow();
  if (lr > 1) shH.getRange(2, 1, lr - 1, 11).getValues().forEach(function (r) {
    var t = String(r[0]);
    if (!t || t < mulaiStr || t > akhirStr) return;
    var h = hari[t] || (hari[t] = { t: t, k: {}, r: 0, i: 0, p: '' });
    if (r[1] === '_HARI') { h.r = Number(r[6]) || 0; h.i = Number(r[7]) || 0; if (izinPenjualan) h.p = String(r[8] || ''); if (r[10]) { try { h.rk = JSON.parse(String(r[10])); } catch (eRk) { } } }
    else if (izinPenjualan) h.k[String(r[1])] = [Number(r[2]) || 0, Number(r[3]) || 0, Number(r[4]) || 0, Number(r[5]) || 0];
  });
  var produk = {}, skuDipakai = {};
  var lp = shP.getLastRow();
  if (lp > 1) shP.getRange(2, 1, lp - 1, 3).getValues().forEach(function (r) {
    var t = String(r[0]);
    if (!t || t < mulaiStr || t > akhirStr) return;
    var sku = String(r[1]);
    (produk[t] || (produk[t] = {}))[sku] = Number(r[2]) || 0;
    skuDipakai[sku] = true;
  });
  var nama = {};
  if (Object.keys(skuDipakai).length) ['Waterground', 'Conner Hardware'].forEach(function (toko) {
    try {
      var shM = getMasterProdukSheet(toko);
      var lrM = shM.getLastRow();
      if (lrM > 1) shM.getRange(2, 1, lrM - 1, 2).getValues().forEach(function (r) {
        var s = String(r[0] || '').trim();
        if (skuDipakai[s] && !nama[s]) nama[s] = String(r[1] || s).trim();
      });
    } catch (e) { }
  });
  return { hari: Object.keys(hari).sort().map(function (k) { return hari[k]; }), produk: produk, nama: nama };
}

// Metrik "saat ini" (tidak terikat rentang): stok rendah & selisih invoice supplier. Cache 5 menit per toko.
function ovSnapshotStok_(toko) {
  var cache = CacheService.getScriptCache();
  var key = 'OV_SNAPSHOT_STOK_' + String(toko || 'default');
  var c = cache.get(key);
  if (c) { try { return JSON.parse(c); } catch (e) { } }

  var shLedger = getStockLedgerSheet(toko);
  var lastRowLedger = shLedger.getLastRow();
  var stockRendahList = [];
  if (lastRowLedger > 1) {
    var vals = shLedger.getRange(2, 1, lastRowLedger - 1, 4).getValues();
    var grouped = {};
    for (var g = 0; g < vals.length; g++) {
      var skuG = String(vals[g][1] || '').trim();
      if (!skuG) continue;
      if (!grouped[skuG]) grouped[skuG] = [];
      grouped[skuG].push({ tgl: vals[g][0], jenis: vals[g][2], qty: parseFloat(vals[g][3]) || 0 });
    }
    var shMaster = getMasterProdukSheet(toko);
    var namaMap = {};
    var lastRowMaster = shMaster.getLastRow();
    if (lastRowMaster > 1) {
      var masterVals = shMaster.getRange(2, 1, lastRowMaster - 1, 2).getValues();
      for (var m = 0; m < masterVals.length; m++) namaMap[String(masterVals[m][0]).trim()] = String(masterVals[m][1] || '').trim();
    }
    Object.keys(grouped).forEach(function (sku) {
      var entries = grouped[sku];
      entries.sort(function (a, b) { return a.tgl - b.tgl; });
      var baseline = 0, sudahOpname = false, masukSesudah = 0;
      for (var j = 0; j < entries.length; j++) {
        var e = entries[j];
        if (e.jenis === 'Opname') { baseline = e.qty; sudahOpname = true; masukSesudah = 0; }
        else if (e.jenis === 'Masuk') { if (sudahOpname) masukSesudah += e.qty; else baseline += e.qty; }
        else if (e.jenis === 'Rusak/Hilang' || e.jenis === 'Terjual Online' || e.jenis === 'Terjual PO Sales' || e.jenis === 'Transfer Gudang Shopee' || e.jenis === 'Pemakaian Produksi') { if (sudahOpname) masukSesudah -= e.qty; else baseline -= e.qty; }
      }
      var stockAkhir = baseline + masukSesudah;
      if (stockAkhir <= 5) stockRendahList.push({ sku: sku, nama: namaMap[sku] || sku, stock: stockAkhir });
    });
  }
  stockRendahList.sort(function (a, b) { return a.stock - b.stock; });

  var shInvoice = getInvoiceSupplierSheets().header;
  var lastRowInvoice = shInvoice.getLastRow();
  var countSelisihInvoice = 0;
  if (lastRowInvoice > 1) {
    shInvoice.getRange(2, 7, lastRowInvoice - 1, 1).getValues().forEach(function (r) { if (String(r[0]).trim() === 'Ada Selisih') countSelisihInvoice++; });
  }
  var hasil = { stockRendah: stockRendahList.slice(0, 10), jumlahStockRendah: stockRendahList.length, selisihInvoice: countSelisihInvoice };
  try { cache.put(key, JSON.stringify(hasil), 300); } catch (e) { }
  return hasil;
}

// Pastikan rekap ada; bangun penuh kalau belum pernah (sekali saja, pertama kali).
function rekapBerandaSiap_() {
  var props = PropertiesService.getScriptProperties();
  var diperbarui = parseInt(props.getProperty('REKAP_BERANDA_DIPERBARUI') || '0', 10);
  if (!diperbarui) {
    var r = rekapBerandaPerbarui_(0);
    if (!r.success) throw new Error(r.error);
    diperbarui = r.diperbarui;
  }
  return diperbarui;
}

// ===== AKSI: dashboard_rekap (dipakai Beranda web; frontend yang menghitung rentang) =====
function prosesDashboardRekap(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    pastikanTriggerRekapBeranda_();
    var tz = Session.getScriptTimeZone();
    var hariIniStr = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
    var akhir = String(data.sampai || hariIniStr).slice(0, 10);
    var mulai = String(data.dari || Utilities.formatDate(new Date(Date.now() - (REKAP_HARI_KIRIM_DEFAULT - 1) * 86400000), tz, 'yyyy-MM-dd')).slice(0, 10);
    var izinPenjualan = cekIzin(data.email, 'buatInvoice');

    var diperbarui = rekapBerandaSiap_();
    var r = rekapBerandaBaca_(mulai, akhir, izinPenjualan);
    var snap = {};
    try { snap = JSON.parse(PropertiesService.getScriptProperties().getProperty('REKAP_BERANDA_SNAPSHOT') || '{}'); } catch (e) { }
    var stok = ovSnapshotStok_(data.toko);

    result.success = true;
    result.dari = mulai;
    result.sampai = akhir;
    result.hariIni = hariIniStr;
    result.hari = r.hari;
    result.produk = r.produk;
    result.nama = r.nama;
    result.kanal = REKAP_KANAL;
    result.izinPenjualan = izinPenjualan;
    result.penjualanCatatan = izinPenjualan ? '' : 'Metrik penjualan hanya untuk akun dengan izin Buat Invoice / Penjualan.';
    result.diperbarui = diperbarui;
    result.umurMenit = Math.floor((Date.now() - diperbarui) / 60000);
    result.basiMenit = REKAP_BASI_MENIT;
    try { result.perJam = rekapJamBaca_(izinPenjualan); } catch (eJ) { result.perJam = []; }
    result.snapshot = {
      stockRendah: stok.stockRendah, jumlahStockRendah: stok.jumlahStockRendah, selisihInvoice: stok.selisihInvoice,
      resiPending: snap.resiPending || 0,
      pesananAktif: izinPenjualan ? (snap.pesananAktif || 0) : null, nilaiAktif: izinPenjualan ? (snap.nilaiAktif || 0) : null
    };
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: dashboard_rekap_perbarui (tombol "Perbarui" / otomatis kalau data basi) =====
function prosesDashboardRekapPerbarui(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var r = rekapBerandaPerbarui_(data.penuh === true ? 0 : 3);
    if (!r.success) throw new Error(r.error);
    try { CacheService.getScriptCache().remove('OV_SNAPSHOT_STOK_' + String(data.toko || 'default')); } catch (e) { }
    result = prosesDashboardRekap(data);
    result.durasiRekapMs = r.durasiMs;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI LAMA: dashboard_overview - bentuk output TETAP (dipakai Insight, Chat AI, dst.),
// sekarang dihitung dari rekap harian -> cepat. =====
function prosesDashboardOverview(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tz = Session.getScriptTimeZone();
    var todayStr = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
    var mulai = String(data.tanggalMulai || todayStr).slice(0, 10);
    var akhir = String(data.tanggalAkhir || todayStr).slice(0, 10);
    var izinPenjualan = cekIzin(data.email, 'buatInvoice');
    rekapBerandaSiap_();
    var r = rekapBerandaBaca_(mulai, akhir, izinPenjualan);

    var perChannel = {};
    REKAP_KANAL.forEach(function (k) { perChannel[k] = { total: 0, jumlah: 0 }; });
    var total = 0, jumlah = 0, batal = 0, nilaiBatal = 0, resi = 0, item = 0, pel = {};
    var perHari = {};
    r.hari.forEach(function (h) {
      var pj = 0;
      Object.keys(h.k).forEach(function (kn) {
        var v = h.k[kn];
        if (!perChannel[kn]) perChannel[kn] = { total: 0, jumlah: 0 };
        perChannel[kn].total += v[0]; perChannel[kn].jumlah += v[1];
        total += v[0]; jumlah += v[1]; batal += v[2]; nilaiBatal += v[3]; pj += v[0];
      });
      resi += h.r; item += h.i;
      if (h.p) h.p.split(',').forEach(function (x) { if (x) pel[x] = true; });
      perHari[h.t] = h;
      h.pj = pj;
    });
    var trenHarian = [];
    var t0 = Utilities.parseDate(mulai, tz, 'yyyy-MM-dd').getTime();
    var nHari = Math.min(366, Math.round((Utilities.parseDate(akhir, tz, 'yyyy-MM-dd').getTime() - t0) / 86400000));
    for (var d = 0; d <= nHari; d++) {
      var tgl = new Date(t0 + d * 86400000 + 12 * 3600000);
      var s = Utilities.formatDate(tgl, tz, 'yyyy-MM-dd');
      var h = perHari[s];
      var pc = {};
      if (h) Object.keys(h.k).forEach(function (kn) { pc[kn] = h.k[kn][0]; });
      trenHarian.push({ tanggal: Utilities.formatDate(tgl, tz, 'dd MMM'), resi: h ? h.r : 0, penjualan: h ? h.pj : 0, perChannel: pc });
    }
    var qty = {};
    Object.keys(r.produk).forEach(function (t) { Object.keys(r.produk[t]).forEach(function (sku) { qty[sku] = (qty[sku] || 0) + r.produk[t][sku]; }); });
    var produkTerlaris = Object.keys(qty).filter(function (s) { return qty[s] > 0; }).sort(function (a, b) { return qty[b] - qty[a]; }).slice(0, 5)
      .map(function (s) { return { sku: s, nama: r.nama[s] || s, qty: qty[s] }; });

    var snap = {};
    try { snap = JSON.parse(PropertiesService.getScriptProperties().getProperty('REKAP_BERANDA_SNAPSHOT') || '{}'); } catch (e) { }
    var stok = ovSnapshotStok_(data.toko);

    result.success = true;
    result.resiRentang = resi;
    result.resiPending = snap.resiPending || 0;
    result.trenHarian = trenHarian;
    result.pesananAktifSaatIni = izinPenjualan ? (snap.pesananAktif || 0) : 0;
    result.totalNilaiAktifSaatIni = izinPenjualan ? (snap.nilaiAktif || 0) : 0;
    result.totalPenjualanRentang = total;
    result.jumlahPesananRentang = jumlah;
    result.rataRataNilaiPesanan = jumlah > 0 ? total / jumlah : 0;
    result.jumlahPelangganAktif = Object.keys(pel).length;
    result.totalItemTerjual = item;
    result.produkTerlaris = produkTerlaris;
    result.stockRendah = stok.stockRendah;
    result.selisihInvoice = stok.selisihInvoice;
    result.jumlahPesananBatal = batal;
    result.totalNilaiPesananBatal = nilaiBatal;
    result.perChannelRentang = perChannel;
    result.penjualanTersedia = izinPenjualan;
    result.penjualanCatatan = izinPenjualan ? '' : 'Metrik penjualan hanya untuk akun dengan izin Buat Invoice / Penjualan.';
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

// Insight sederhana berbasis aturan (rule-based) dari data yang ada -
// belum pakai AI generatif penuh, tapi udah kasih saran yang actionable
function prosesDashboardInsight(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var overview = prosesDashboardOverview(data);
    if (!overview.success) throw new Error(overview.error);

    var insight = [];

    if (overview.stockRendah.length > 0) {
      var top = overview.stockRendah[0];
      insight.push({
        tipe: 'warning',
        teks: overview.stockRendah.length + ' produk stoknya rendah (\u2264 5 unit), paling kritis: ' + top.nama + ' (sisa ' + top.stock + ').',
        aksi: 'Lihat Stock'
      });
    }

    if (overview.selisihInvoice > 0) {
      insight.push({
        tipe: 'danger',
        teks: overview.selisihInvoice + ' invoice supplier ada selisih sama data stock masuk - perlu ditinjau.',
        aksi: 'Riwayat Invoice Supplier'
      });
    }

    if (overview.resiPending > 0) {
      insight.push({
        tipe: 'warning',
        teks: overview.resiPending + ' resi masih berstatus Pending, belum kekirim.',
        aksi: 'Scan Resi Keluar'
      });
    }

    if (overview.trenResi.length >= 2) {
      var kemarin = overview.trenResi[overview.trenResi.length - 2].jumlah;
      var hariIni = overview.trenResi[overview.trenResi.length - 1].jumlah;
      if (kemarin > 0 && hariIni < kemarin * 0.5) {
        insight.push({ tipe: 'info', teks: 'Resi keluar hari ini (' + hariIni + ') jauh lebih sedikit dari kemarin (' + kemarin + ').', aksi: null });
      }
    }

    if (insight.length === 0) {
      insight.push({ tipe: 'success', teks: 'Semua kelihatan normal - nggak ada yang butuh perhatian khusus saat ini.', aksi: null });
    }

    result.success = true;
    result.insight = insight;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   FITUR: RIWAYAT PEMBELIAN PER PEMBELI (buat web - panel & Repeat Order)
   ============================================================ */
function prosesRiwayatPembeli(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var nama = String(data.nama || '').trim().toLowerCase();
    var noHp = String(data.noHp || '').trim();
    if (!nama && !noHp) { result.success = true; result.daftar = []; return result; }

    var sheets = getPesananManualSheets();
    var sh = sheets.header;
    var lastRow = sh.getLastRow();
    var daftarHeader = [];

    if (lastRow > 1) {
      var values = sh.getRange(2, 1, lastRow - 1, 15).getValues();
      for (var i = 0; i < values.length; i++) {
        var noInvoice = String(values[i][0] || '').trim();
        if (!noInvoice) continue;
        var namaCocok = String(values[i][2] || '').trim().toLowerCase() === nama;
        var hpCocok = noHp && String(values[i][4] || '').trim() === noHp;
        if (!namaCocok && !hpCocok) continue;

        daftarHeader.push({
          row: i + 2, noInvoice: noInvoice,
          tanggal: values[i][1] instanceof Date ? Utilities.formatDate(values[i][1], Session.getScriptTimeZone(), 'dd MMM yyyy') : String(values[i][1] || ''),
          namaPenerima: values[i][2], alamat: values[i][3], noHp: values[i][4], kurir: values[i][5],
          ongkosKirim: values[i][7], biayaLainnya: values[i][8], total: values[i][9],
          diskon: values[i][13] || 0, pajak: values[i][14] || 0
        });
      }
    }

    daftarHeader.reverse();
    daftarHeader = daftarHeader.slice(0, 10); // 10 riwayat terakhir cukup

    // Ambil rincian item tiap invoice yang ketemu (hanya baris milik maks. 10 invoice ini - bukan seluruh sheet)
    var noInvoiceSet = {};
    daftarHeader.forEach(function (h) { noInvoiceSet[h.noInvoice] = h; h.items = []; });
    var detailVals = pmBacaDetailInvoice_(sheets.detail, Object.keys(noInvoiceSet), 5);
    for (var d = 0; d < detailVals.length; d++) {
      var noInv = String(detailVals[d][0]).trim();
      if (noInvoiceSet[noInv]) {
        noInvoiceSet[noInv].items.push({ sku: detailVals[d][1], nama: detailVals[d][2], qty: detailVals[d][3], harga: detailVals[d][4] });
      }
    }

    result.success = true;
    result.daftar = daftarHeader;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============ CARI PRODUK PARTIAL (buat autocomplete SKU di web) ============ */
/* ============================================================
   DAFTAR PRODUK RINGAN (SKU, Nama, Harga) - produk Arsip tidak ikut.
   Disimpan di CacheService (gzip, 5 menit) supaya Pesanan Manual & Memo Gudang tidak membaca seluruh
   Master Produk di setiap ketikan. Cache dibuang otomatis tiap ada perubahan harga/katalog
   (invalidasiCacheKatalogHarga) dan kedaluwarsa sendiri maksimal 5 menit.
   ============================================================ */
var PRODUK_RINGAN_KUNCI_ = 'PRODUK_RINGAN_V2_'; // V2: + URL Foto (thumbnail Order Manual)
function produkRinganDaftar_(toko) {
  var kunci = PRODUK_RINGAN_KUNCI_ + (toko || 'default');
  var ada = cacheBesarGet_(kunci);
  if (ada && Array.isArray(ada)) return ada;
  var sh = getMasterProdukSheet(toko);
  var lastRow = sh.getLastRow();
  var daftar = [];
  if (lastRow > 1) {
    var values = sh.getRange(2, 1, lastRow - 1, 9).getValues(); // kolom 9 = URL Foto
    var arsip = katPetaArsip_(toko);
    for (var i = 0; i < values.length; i++) {
      var sku = String(values[i][0] || '').trim();
      if (!sku || arsip[sku]) continue;
      daftar.push([sku, String(values[i][1] || '').trim(), parseFloat(values[i][2]) || 0, String(values[i][8] || '').trim()]);
    }
  }
  cacheBesarPut_(kunci, daftar, 300);
  return daftar;
}
function invalidasiCacheProdukRingan_(toko) {
  try {
    var c = CacheService.getScriptCache();
    if (toko) c.remove(PRODUK_RINGAN_KUNCI_ + toko + '__meta');
    c.removeAll(['Waterground', 'Conner', 'default'].map(function (t) { return PRODUK_RINGAN_KUNCI_ + t + '__meta'; }));
  } catch (e) { /* tidak fatal */ }
}
function prosesLihatProdukRingan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice') && !cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'adminPembelian')) {
      throw new Error('Anda tidak punya izin untuk aksi ini.');
    }
    result.daftar = produkRinganDaftar_(data.toko).map(function (r) { return { sku: r[0], nama: r[1], harga: r[2], foto: r[3] || '' }; });
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesCariProdukPartial(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice') && !cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'adminPembelian')) {
      throw new Error('Anda tidak punya izin untuk aksi ini.');
    }
    var query = String(data.query || '').trim().toLowerCase();
    if (query.length < 1) { result.success = true; result.hasil = []; return result; }

    // Memakai daftar produk ringan yang di-cache (produk arsip sudah tersaring)
    var hasil = [];
    var daftarR = produkRinganDaftar_(data.toko);
    for (var i = 0; i < daftarR.length; i++) {
      var r = daftarR[i];
      if (r[0].toLowerCase().indexOf(query) !== -1 || r[1].toLowerCase().indexOf(query) !== -1) {
        hasil.push({ sku: r[0], nama: r[1], harga: r[2], foto: r[3] || '' });
        if (hasil.length >= 8) break;
      }
    }
    result.success = true;
    result.hasil = hasil;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============ REMINDER CUSTOMER YANG LAMA NGGAK REPEAT ORDER (buat Saran AI di Daftar Pesanan) ============ */
function prosesReminderRepeatOrder(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var sheets = getPesananManualSheets();
    var sh = sheets.header;
    var lastRow = sh.getLastRow();
    if (lastRow < 2) { result.success = true; result.daftar = []; return result; }

    var values = sh.getRange(2, 1, lastRow - 1, 12).getValues();
    var perPembeli = {}; // { "nama|nohp": { nama, noHp, tanggalTerakhir, jumlahOrder } }

    for (var i = 0; i < values.length; i++) {
      var noInvoice = String(values[i][0] || '').trim();
      if (!noInvoice) continue;
      if (String(values[i][11] || '').trim() === 'Dibatalkan') continue; // skip yang dibatalkan
      var nama = String(values[i][2] || '').trim();
      var noHp = String(values[i][4] || '').trim();
      if (!nama) continue;
      var tgl = values[i][1];
      if (!(tgl instanceof Date)) continue;

      var key = nama.toLowerCase() + '|' + noHp;
      if (!perPembeli[key] || tgl > perPembeli[key].tanggalTerakhir) {
        if (!perPembeli[key]) perPembeli[key] = { nama: nama, noHp: noHp, jumlahOrder: 0 };
        perPembeli[key].tanggalTerakhir = tgl;
      }
      perPembeli[key].jumlahOrder = (perPembeli[key].jumlahOrder || 0) + 1;
    }

    var sekarang = new Date();
    var msPerHari = 24 * 60 * 60 * 1000;
    var daftar = [];

    Object.keys(perPembeli).forEach(function (key) {
      var p = perPembeli[key];
      // Cuma munculin buat pembeli yang udah PERNAH order lebih dari 1x (baru relevan disebut "repeat")
      if (p.jumlahOrder < 2) return;
      var hariBerlalu = Math.floor((sekarang - p.tanggalTerakhir) / msPerHari);
      if (hariBerlalu >= 30) {
        daftar.push({
          nama: p.nama, noHp: p.noHp, jumlahOrder: p.jumlahOrder, hariBerlalu: hariBerlalu,
          tanggalTerakhir: Utilities.formatDate(p.tanggalTerakhir, Session.getScriptTimeZone(), 'dd MMM yyyy')
        });
      }
    });

    daftar.sort(function (a, b) { return b.hariBerlalu - a.hariBerlalu; });
    result.success = true;
    result.daftar = daftar.slice(0, 10);
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   FITUR: SARAN AI KHUSUS HALAMAN STOCK (web)
   ============================================================ */
function prosesStockInsight(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var sh = getStockLedgerSheet(data.toko);
    var lastRow = sh.getLastRow();
    var insight = [];

    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 4).getValues();
      var shMaster = getMasterProdukSheet(data.toko);
      var namaMap = {};
      var lastRowMaster = shMaster.getLastRow();
      if (lastRowMaster > 1) {
        var masterVals = shMaster.getRange(2, 1, lastRowMaster - 1, 2).getValues();
        for (var m = 0; m < masterVals.length; m++) namaMap[String(masterVals[m][0]).trim()] = String(masterVals[m][1] || '').trim();
      }

      var grouped = {};
      for (var i = 0; i < vals.length; i++) {
        var sku = String(vals[i][1] || '').trim();
        if (!sku) continue;
        if (!grouped[sku]) grouped[sku] = [];
        grouped[sku].push({ tgl: vals[i][0], jenis: vals[i][2], qty: parseFloat(vals[i][3]) || 0 });
      }

      var stockRendahList = [];
      var belumOpnameLamaList = [];
      var sekarang = new Date();
      var msPerHari = 24 * 60 * 60 * 1000;

      Object.keys(grouped).forEach(function (sku) {
        var entries = grouped[sku];
        entries.sort(function (a, b) { return a.tgl - b.tgl; });
        var baseline = 0, sudahOpname = false, masukSesudah = 0, tglOpnameTerakhir = null;
        for (var j = 0; j < entries.length; j++) {
          var e = entries[j];
          if (e.jenis === 'Opname') { baseline = e.qty; sudahOpname = true; tglOpnameTerakhir = e.tgl; masukSesudah = 0; }
          else if (e.jenis === 'Masuk') { if (sudahOpname) masukSesudah += e.qty; else baseline += e.qty; }
          else if (e.jenis === 'Rusak/Hilang' || e.jenis === 'Terjual Online' || e.jenis === 'Terjual PO Sales' || e.jenis === 'Transfer Gudang Shopee' || e.jenis === 'Pemakaian Produksi') { if (sudahOpname) masukSesudah -= e.qty; else baseline -= e.qty; }
        }
        var stockAkhir = baseline + masukSesudah;
        var nama = namaMap[sku] || sku;

        if (stockAkhir <= 5) stockRendahList.push({ sku: sku, nama: nama, stock: stockAkhir });

        var hariSejakOpname = tglOpnameTerakhir ? Math.floor((sekarang - tglOpnameTerakhir) / msPerHari) : null;
        if (hariSejakOpname === null || hariSejakOpname >= 30) {
          belumOpnameLamaList.push({ sku: sku, nama: nama, hari: hariSejakOpname });
        }
      });

      stockRendahList.sort(function (a, b) { return a.stock - b.stock; });
      if (stockRendahList.length > 0) {
        var top3 = stockRendahList.slice(0, 3).map(function (s) { return s.nama + ' (' + s.stock + ')'; }).join(', ');
        insight.push({ tipe: 'danger', teks: stockRendahList.length + ' SKU stoknya kritis (\u2264 5): ' + top3 + (stockRendahList.length > 3 ? ', dan lainnya' : ''), aksi: 'Lihat Stock Rendah', aksiTipe: 'filter_rendah' });
      }

      if (belumOpnameLamaList.length > 0) {
        insight.push({ tipe: 'warning', teks: belumOpnameLamaList.length + ' SKU belum di-opname 30+ hari (atau belum pernah sama sekali) - akurasi datanya perlu dicek ulang.', aksi: 'Catat Stock', aksiTipe: 'buka_form' });
      }
    }

    // Selisih invoice supplier (reuse logic yang udah ada)
    var sheetsInv = getInvoiceSupplierSheets();
    var shInv = sheetsInv.header;
    var lastRowInv = shInv.getLastRow();
    var countSelisih = 0;
    if (lastRowInv > 1) {
      var invVals = shInv.getRange(2, 7, lastRowInv - 1, 1).getValues();
      for (var v = 0; v < invVals.length; v++) {
        if (String(invVals[v][0]).trim() === 'Ada Selisih') countSelisih++;
      }
    }
    if (countSelisih > 0) {
      insight.push({ tipe: 'danger', teks: countSelisih + ' invoice supplier ada selisih sama data stock masuk - perlu ditinjau.', aksi: 'Rekonsiliasi Mutasi', aksiTipe: 'filter_rekonsiliasi' });
    }

    if (insight.length === 0) {
      insight.push({ tipe: 'success', teks: 'Semua data stock kelihatan sehat - nggak ada yang butuh perhatian khusus saat ini.' });
    }

    result.success = true;
    result.insight = insight;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   FITUR: TANYA AI (chat singkat, teks doang, konteks data ringkas)
   ============================================================ */
// role = agent pemilik tugas: 'jaya' (default) | 'rehan' (lewat AI Framework gratis + pembatas kuota) | 'budi'
function panggilGeminiText(promptText, role) {
  role = role || 'jaya';
  if (role === 'rehan') return aifPanggilLangsung_({ prompt: promptText, suhu: 0.3 });
  var agen = aiAgentKey_(role), def = aiAgentDef_(role);
  if (!agen.key) throw new Error('API key agent ' + def.nama + ' belum diisi - atur di menu AI Agent > 🔑 Agent Keys.');
  if (agen.provider !== 'gemini') {
    var hasilU;
    for (var cobaU = 1; ; cobaU++) {
      try { hasilU = aiPanggilUniversal_(agen, { prompt: promptText, suhu: 0.3 }); break; }
      catch (eU) {
        if ((eU.httpKode === 429 || eU.httpKode >= 500) && cobaU < 3) { Utilities.sleep(2000 * cobaU); continue; }
        throw new Error(aiProviderLabel_(agen.provider) + ' (' + def.nama + ') gagal: ' + String(eU.message || eU).slice(0, 300));
      }
    }
    try { aiwCatatToken_(hasilU.usage); } catch (eTokU) { }
    return hasilU.teks;
  }
  var url = 'https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(agen.model) + ':generateContent';
  var payload = {
    contents: [{ parts: [{ text: promptText }] }],
    generationConfig: { temperature: 0.3 }
  };

  var percobaanMaks = 3;
  var kode, isiRespons;
  for (var percobaan = 1; percobaan <= percobaanMaks; percobaan++) {
    var res = fetchHemat(url, {
      method: 'post', contentType: 'application/json', headers: { 'x-goog-api-key': agen.key },
      payload: JSON.stringify(payload), muteHttpExceptions: true
    });
    kode = res.getResponseCode();
    isiRespons = res.getContentText();
    if (kode === 200) break;
    if ((kode === 503 || kode === 429) && percobaan < percobaanMaks) { Utilities.sleep(2000 * percobaan); continue; }
    throw new Error('Gemini API (' + def.nama + ') gagal (kode ' + kode + '): ' + isiRespons.substring(0, 300));
  }

  var data = JSON.parse(isiRespons);
  var teksHasil = data.candidates && data.candidates[0] && data.candidates[0].content
    && data.candidates[0].content.parts && data.candidates[0].content.parts[0]
    ? data.candidates[0].content.parts[0].text : '';
  return teksHasil;
}

function prosesTanyaAI(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var pertanyaan = String(data.pertanyaan || '').trim();
    var konteksHalaman = String(data.konteks || 'umum').trim();
    if (!pertanyaan) throw new Error('Pertanyaan kosong');

    // Kumpulin data ringkas sesuai konteks halaman, biar AI jawab berdasarkan data ASLI, bukan ngarang
    var ringkasanData = '';
    if (konteksHalaman === 'stock') {
      var stockData = prosesLihatStock({ email: data.email });
      if (stockData.success) {
        var daftarStock = stockData.daftar.slice(0, 40); // batasi biar prompt nggak kepanjangan
        ringkasanData = 'Data stock saat ini (SKU, nama, stock, opname terakhir):\n' +
          daftarStock.map(function (d) { return d.sku + ' | ' + d.nama + ' | stock: ' + d.stockSaatIni + ' | opname: ' + d.opnameTerakhir; }).join('\n');
      }
    } else if (konteksHalaman === 'overview') {
      var overviewData = prosesDashboardOverview({ email: data.email });
      if (overviewData.success) {
        ringkasanData = 'Ringkasan hari ini (semua channel): Penjualan Rp' + overviewData.totalPenjualanRentang + ' dari ' + overviewData.jumlahPesananRentang +
          ' pesanan, Resi keluar ' + overviewData.resiRentang + ', Pesanan aktif ' + overviewData.pesananAktifSaatIni +
          ' (nilai Rp' + overviewData.totalNilaiAktifSaatIni + '), Resi pending ' + overviewData.resiPending +
          ', SKU stock rendah: ' + overviewData.stockRendah.length + ', Invoice supplier ada selisih: ' + overviewData.selisihInvoice;
      }
    }

    var prompt = 'Kamu adalah asisten buat sistem manajemen gudang & toko online bernama "Waterground Coffee & Roastery". ' +
      'Jawab pertanyaan user dalam Bahasa Indonesia, singkat, jelas, dan HANYA berdasarkan data yang diberikan di bawah ini. ' +
      'Kalau datanya nggak cukup buat jawab, bilang terus terang nggak ada datanya (jangan ngarang angka).\n\n' +
      (ringkasanData ? 'DATA:\n' + ringkasanData + '\n\n' : '') +
      'PERTANYAAN: ' + pertanyaan;

    var jawaban = panggilGeminiText(prompt);
    result.success = true;
    result.jawaban = jawaban;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   FITUR: KELOLA STAFF (web) - daftar staff + performa kerja
   ============================================================ */
function prosesLihatSemuaStaff(data) {
  var result = { success: false };
  try {
    var staffPeminta = getStaffByEmail(data.email);
    if (!staffPeminta || staffPeminta.role !== 'Owner' || !staffPeminta.aktif) {
      throw new Error('Cuma Owner yang bisa lihat daftar staff.');
    }

    var sh = getStaffSheet();
    var lastRow = sh.getLastRow();
    var daftarStaff = [];
    var tz = Session.getScriptTimeZone();
    var adaKolomIzin = !!sh.getRange(1, 7).getValue();
    // Baca SELEBAR sheet (dulu cuma 13 kolom -> izin ke-8 & ke-9 [batalPesanan, lihatTagihan]
    // selalu kebaca false, dan ikut ketimpa false saat Owner klik Simpan di panel Edit).
    var lebarKolom = Math.max(sh.getLastColumn(), 6 + DAFTAR_IZIN.length);
    var idxHp = staffCariKolomHeader_(sh, KOLOM_STAFF_HP, false);
    var idxAlamat = staffCariKolomHeader_(sh, KOLOM_STAFF_ALAMAT, false);
    // v2026.10.33 (Paket 17): foto profil (foto akun Google saat login / foto yang diunggah) untuk kartu staf
    var petaFoto = {};
    try {
      var shK = getKredensialSheet_(), lrK = shK.getLastRow();
      if (lrK > 1) shK.getRange(2, 1, lrK - 1, 5).getValues().forEach(function (r) { var e = String(r[0] || '').trim().toLowerCase(); if (e && r[4]) petaFoto[e] = String(r[4]); });
    } catch (eFoto) { }
    if (lastRow > 1) {
      var values = sh.getRange(2, 1, lastRow - 1, Math.min(lebarKolom, sh.getMaxColumns())).getValues();
      for (var i = 0; i < values.length; i++) {
        var email = String(values[i][0] || '').trim();
        if (!email) continue;
        var izinStaffIni = {};
        var ownerIni = String(values[i][2] || '').trim().toLowerCase() === 'owner';
        DAFTAR_IZIN.forEach(function (key, idx) { izinStaffIni[key] = ownerIni ? true : (adaKolomIzin ? (values[i][6 + idx] === true) : false); });
        daftarStaff.push({
          row: i + 2, email: email, nama: String(values[i][1] || '').trim(), role: String(values[i][2] || '').trim(), aktif: values[i][3] === true,
          tanggalBergabung: values[i][4] instanceof Date ? Utilities.formatDate(values[i][4], tz, 'dd MMM yyyy') : '-',
          terakhirLogin: values[i][5] instanceof Date ? Utilities.formatDate(values[i][5], tz, 'dd MMM yyyy, HH:mm') : '-',
          noHp: idxHp > 0 ? String(values[i][idxHp - 1] || '').trim() : '',
          alamat: idxAlamat > 0 ? String(values[i][idxAlamat - 1] || '').trim() : '',
          foto: petaFoto[email.toLowerCase()] || '',
          izin: izinStaffIni
        });
      }
    }

    // Hitung performa: jumlah resi keluar discan per nama staff (kolom 9 = "Dicatat Oleh")
    var infoKeluar = getSheetInfo('keluar');
    var shKeluar = infoKeluar.sheet;
    var lastRowKeluar = shKeluar.getLastRow();
    var countResiPerNama = {};
    if (lastRowKeluar > 1) {
      var namaVals = shKeluar.getRange(2, 9, lastRowKeluar - 1, 1).getValues();
      for (var r = 0; r < namaVals.length; r++) {
        var nama = String(namaVals[r][0] || '').trim();
        if (!nama) continue;
        countResiPerNama[nama] = (countResiPerNama[nama] || 0) + 1;
      }
    }

    // Hitung performa: jumlah pesanan manual dibuat per nama staff (kolom 13 = "Dibuat Oleh")
    var sheetsPesanan = getPesananManualSheets();
    var shPesanan = sheetsPesanan.header;
    var lastRowPesanan = shPesanan.getLastRow();
    var countPesananPerNama = {};
    if (lastRowPesanan > 1) {
      var namaPesananVals = shPesanan.getRange(2, 13, lastRowPesanan - 1, 1).getValues();
      for (var p = 0; p < namaPesananVals.length; p++) {
        var namaP = String(namaPesananVals[p][0] || '').trim();
        if (!namaP) continue;
        countPesananPerNama[namaP] = (countPesananPerNama[namaP] || 0) + 1;
      }
    }

    daftarStaff.forEach(function (s) {
      s.jumlahResiScan = countResiPerNama[s.nama] || 0;
      s.jumlahPesananDibuat = countPesananPerNama[s.nama] || 0;
    });

    result.success = true;
    result.daftar = daftarStaff;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

