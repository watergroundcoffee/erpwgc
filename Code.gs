// Isi field kosong dari gambar (dipanggil setelah spbGabung_) - HANYA bila AI dinyalakan (SPB_OCR_AI = 1)
function spbOcrTerapkan_(h, sn) {
  if (!spbOcrAktif_()) return null;
  if (!h || !h.gambar || !Object.keys(h.gambar).length) return null;
  var kurang = SPB_OCR_FIELD_.filter(function (f) { return h.gambar[f] && !h[f]; });
  if (!kurang.length) return null;
  var cache = CacheService.getScriptCache();
  try { if (sn && cache.get('SPB_OCR_X_' + sn)) return null; } catch (e) { }
  var g = {}; kurang.forEach(function (f) { g[f] = h.gambar[f]; });
  var r = spbOcrBaca_(g);
  if (r.ok) {
    h.sumber = h.sumber || {};
    Object.keys(r.data).forEach(function (f) {
      if (h[f]) return;
      h[f] = r.data[f];
      if (/^(nama|hp|alamat)$/.test(f)) { h.sumber[f] = 'dokumen kirim (gambar dibaca AI)'; if (h.tersamarField) h.tersamarField[f] = false; }
    });
    // Alamat dari gambar sering tanpa kota -> lengkapi seperti shopeeEkstrakPembeli_
    if (h.alamat && r.data.alamat) spbLengkapiAlamat_(h);
  } else if (sn && !/tidak ada gambar|dimatikan|belum diatur/.test(r.pesan || '')) { try { cache.put('SPB_OCR_X_' + sn, '1', 1200); } catch (e) { } }
  return r;
}
function spbGabungPenagihan_(h, inv) {
  if (!inv) return;
  var k = inv.kumpul || {};
  var peta = { namaPenagihan: 'nama', hpPenagihan: 'hp', emailPenagihan: 'email', alamatPenagihan: 'alamat', npwp: 'npwp' };
  Object.keys(peta).forEach(function (dst) {
    var p = spbPilih_(k[peta[dst]]);
    if (p && p.status === 'terisi' && !h[dst]) h[dst] = dst === 'hpPenagihan' ? p.nilai.replace(/[^\d+]/g, '') : p.nilai;
  });
  // alamat penagihan bisa terpecah (address_breakdown) -> rakit bila full_address tidak ada
  if (!h.alamatPenagihan) {
    var bagian = ['kelurahan', 'kecamatan', 'kota', 'provinsi', 'kodePos'].map(function (f) { var p = spbPilih_(k[f]); return p && p.status === 'terisi' ? p.nilai : ''; }).filter(Boolean);
    if (bagian.length >= 2) h.alamatPenagihan = bagian.join(', ');
  }
  if (h.namaPenagihan || h.alamatPenagihan) { h.sumber = h.sumber || {}; h.sumber.penagihan = 'get_buyer_invoice_info'; }
}
function spbHitungUlangTanda_(h) {
  h.tersamarField = h.tersamarField || {};
  ['nama', 'hp', 'alamat'].forEach(function (f) { if (h[f]) h.tersamarField[f] = false; });
  h.tersamarSebagian = !!(h.tersamarField.nama || h.tersamarField.hp || h.tersamarField.alamat) && !(h.nama && h.hp && h.alamat);
  h.tersamar = !(h.nama || h.hp || h.alamat);
}
// Dipanggil shopeeAmbilPembeliBatch_ untuk pesanan yang masih kurang data
function spbLengkapiCadangan_(hasil, orders, kred, batasMs) {
  var cache = CacheService.getScriptCache();
  var perlu = Object.keys(hasil).filter(function (sn) {
    var h = hasil[sn];
    if (h.nama && h.hp && h.alamat) return false;
    if (/^(UNPAID|CANCELLED|IN_CANCEL)$/.test(String(h.status || ''))) return false;
    if (orders[sn] && shopeeEkspor_(orders[sn].buyer_username, '')) return false; // pesanan ekspor
    try { if (cache.get('SPB_X_' + sn)) return false; } catch (e) { }
    return true;
  }).slice(0, SPB_MAKS_CADANGAN_);
  if (!perlu.length) return 0;
  var dibantu = 0, antre = [];
  // Bentuk permintaan dokumen yang berhasil belum diketahui -> tiap jalan hanya 2 pesanan yang dicoba semua bentuk (hemat kuota API)
  var jatahCoba = PropertiesService.getScriptProperties().getProperty('SPB_SDD_VARIAN') ? 9999 : 2;
  perlu.forEach(function (sn) {
    if (Date.now() > batasMs) return;
    var h = hasil[sn], o = orders[sn] || {};
    if (!SPB_STATUS_DOKUMEN_[String(h.status || '')]) return;
    // Pengiriman Kilat / Gudang Shopee (advance_package): label & data penerima dikelola Shopee
    if (o.advance_package === true) return;
    if (jatahCoba-- <= 0) return;
    var paket = (o.package_list && o.package_list[0] && o.package_list[0].package_number) || '';
    try {
      var d = spbDokumenKirim_(kred, sn, paket);
      var sebelum = !!(h.nama && h.hp && h.alamat);
      if (d.r && d.r.ok) {
        spbGabung_(h, d.kumpul, 'get_shipping_document_data_info');
        if (Date.now() < batasMs) spbOcrTerapkan_(h, sn);
        // v2026.10.42: gambar yang belum terbaca -> antrean OCR browser (data dokumen bisa tertutup setelah dikirim)
        if (h.gambar && SPB_OCR_FIELD_.some(function (f) { return h.gambar[f] && !h[f]; })) antre.push({ sn: sn, gambar: h.gambar });
      }
      if (!sebelum && h.nama && h.hp && h.alamat) dibantu++;
      if (!d.r || !d.r.ok) { try { cache.put('SPB_X_' + sn, '1', p79SddKilat_(d.r) ? 21600 : (d.belumBisaDibuka ? 900 : 3600)); } catch (e) { } } // v2026.10.98 (DN-465): pesanan Gudang Shopee tidak dicoba ulang // v2026.10.59 (DN-478): belum bisa dibuka -> 15 menit
    } catch (eD) { }
  });
  if (Date.now() < batasMs) {
    try {
      var inv = spbInvoiceBatch_(kred, perlu, null);
      perlu.forEach(function (sn) { spbGabungPenagihan_(hasil[sn], inv[sn]); });
    } catch (eI) { }
  }
  perlu.forEach(function (sn) { spbHitungUlangTanda_(hasil[sn]); });
  if (antre.length) { try { spbAntreTambah_(antre); } catch (eA) { console.error('spbAntreTambah_: ' + eA); } }
  // v2026.10.54 (DN-261022-192438-596): masih belum lengkap & tanpa gambar -> antrean label resmi (dibaca browser)
  try { spblDariCadangan_(hasil, perlu, orders); } catch (eL) { console.error('spblDariCadangan_: ' + eL); }
  return dibantu;
}

function getPembeliShopeeLengkapSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SPB_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(SPB_SHEET_);
    sh.getRange(1, 1, 1, SPB_HEADER_.length).setValues([SPB_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('A:A').setNumberFormat('@'); sh.getRange('C:C').setNumberFormat('@');
    sh.getRange('E:E').setNumberFormat('@'); sh.getRange('K:K').setNumberFormat('@'); sh.getRange('M:M').setNumberFormat('@');
  }
  return sh;
}
// Simpan / perbarui baris per pesanan. Nilai kosong / tersamar TIDAK menimpa nilai lama.
function spbSimpanLengkap_(hasil) {
  var daftar = Object.keys(hasil || {}).filter(function (sn) {
    var h = hasil[sn];
    return h && (h.username || h.nama || h.hp || h.alamat || h.alamatPenagihan || h.namaPenagihan);
  });
  if (!daftar.length) return 0;
  var lock = kunciModul_('penjualan');
  if (!lock.tryLock(15000)) return 0;
  var jumlah = 0;
  try {
    var sh = getPembeliShopeeLengkapSheet_(), lr = sh.getLastRow(), lebar = SPB_HEADER_.length;
    var peta = {};
    if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r, i) { var k = String(r[0] || '').trim(); if (k && !peta[k]) peta[k] = i + 2; });
    var kini = new Date(), baru = [];
    daftar.forEach(function (sn) {
      var h = hasil[sn];
      var isi = [sn, h.username || '', h.buyerId || '', h.nama || '', h.hp || '', h.alamat || '', h.kelurahan || '', h.kecamatan || '',
        h.kota || '', h.provinsi || '', h.kodePos || '', h.namaPenagihan || '', h.hpPenagihan || '', h.emailPenagihan || '',
        h.alamatPenagihan || '', h.npwp || '', h.status || '', JSON.stringify(h.sumber || {}), kini, kini];
      if (peta[sn]) {
        var rg = sh.getRange(peta[sn], 1, 1, lebar), lama = rg.getValues()[0], ubah = false;
        for (var c = 1; c < 17; c++) {
          if (c === 16) { if (isi[c] && String(lama[c]) !== String(isi[c])) { lama[c] = isi[c]; ubah = true; } continue; }
          if (isi[c] && !shopeeTersamar_(isi[c]) && String(lama[c] || '').trim() !== String(isi[c]).trim()) { lama[c] = isi[c]; ubah = true; }
        }
        if (ubah) {
          var sumberLama = {}; try { sumberLama = JSON.parse(lama[17] || '{}'); } catch (e) { }
          lama[17] = JSON.stringify(Object.assign(sumberLama, h.sumber || {}));
          if (!lama[18]) lama[18] = kini;
          lama[19] = kini;
          rg.setNumberFormat('@'); rg.setValues([lama.map(function (x, i) { return i >= 18 ? x : String(x === null || x === undefined ? '' : x); })]);
          sh.getRange(peta[sn], 19, 1, 2).setNumberFormat('dd/MM/yyyy HH:mm');
          jumlah++;
        }
      } else { baru.push(isi); peta[sn] = -1; }
    });
    if (baru.length) {
      var awal = sh.getLastRow() + 1;
      sh.getRange(awal, 1, baru.length, 18).setNumberFormat('@');
      sh.getRange(awal, 1, baru.length, lebar).setValues(baru.map(function (r) { return r.map(function (x, i) { return i >= 18 ? x : String(x); }); }));
      sh.getRange(awal, 19, baru.length, 2).setNumberFormat('dd/MM/yyyy HH:mm');
      jumlah += baru.length;
    }
    SpreadsheetApp.flush();
  } catch (e) { console.error('spbSimpanLengkap_: ' + e); }
  finally { lepasKunci_(lock); }
  return jumlah;
}

function spbBacaLengkap_(daftarSn) {
  var sh = getPembeliShopeeLengkapSheet_(), lr = sh.getLastRow(), hasil = {};
