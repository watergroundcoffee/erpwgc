/* ---------- 2) Stok: menipis, fast moving, dead stock ---------- */
function copilotKonteksStok_(D) {
  var mon = prosesLihatMonitorStok({});
  if (!mon.success) throw new Error(mon.error || 'Monitor stok gagal');
  var tz = Session.getScriptTimeZone(), hariIni = finTglStr_(new Date(), tz);
  var batas30 = finTambahHari_(hariIni, -30), batas60 = finTambahHari_(hariIni, -60);
  var laku30 = {};
  if (D && D.jualSku) Object.keys(D.jualSku).forEach(function (t) {
    if (t < batas30 || t > hariIni) return;
    var m = D.jualSku[t]; Object.keys(m).forEach(function (s) { laku30[s] = (laku30[s] || 0) + m[s]; });
  });
  var terakhir = (D && D.terakhirJual) || {};
  var daftar = (mon.daftar || []).filter(function (p) { return !p.arsip; }).map(function (p) {
    var q30 = Math.round(laku30[p.sku] || 0), perHari = q30 / 30;
    return { sku: p.sku, nama: p.nama || p.sku, stok: p.onAvailable, onHand: p.onHand, q30: q30,
      hariCukup: perHari > 0 ? Math.floor(Math.max(0, p.onAvailable) / perHari) : null, terakhir: terakhir[p.sku] || '' };
  });
  var menipis = daftar.filter(function (p) { return p.q30 > 0 && (p.stok <= 0 || p.hariCukup < 14); })
    .sort(function (a, b) { return (a.hariCukup || 0) - (b.hariCukup || 0) || b.q30 - a.q30; }).slice(0, 12);
  var fast = daftar.filter(function (p) { return p.q30 > 0; }).sort(function (a, b) { return b.q30 - a.q30; }).slice(0, 10);
  var dead = daftar.filter(function (p) { return p.onHand > 0 && (!p.terakhir || p.terakhir < batas60); })
    .sort(function (a, b) { return b.onHand - a.onHand; }).slice(0, 12);
  var f = function (p) { return p.nama + ' [' + p.sku + ']'; };
  var baris = ['## STOK (' + daftar.length + ' SKU aktif; laku = unit terjual 30 hari terakhir)'];
  baris.push('### Menipis / habis (stok < 14 hari penjualan): ' + menipis.length + ' SKU');
  menipis.forEach(function (p) { baris.push('- ' + f(p) + ': stok ' + p.stok + ', laku30 ' + p.q30 + ', cukup ±' + (p.hariCukup === null ? '-' : p.hariCukup) + ' hari'); });
  baris.push('### Fast moving (top 10)');
  fast.forEach(function (p) { baris.push('- ' + f(p) + ': laku30 ' + p.q30 + ', stok ' + p.stok); });
  baris.push('### Dead stock (ada stok, tidak terjual ≥60 hari): ' + dead.length + ' SKU (ditampilkan maks 12)');
  dead.forEach(function (p) { baris.push('- ' + f(p) + ': stok ' + p.onHand + ', terakhir laku ' + (p.terakhir || 'belum pernah')); });
  return baris.join('\n');
}

/* ---------- 3) Pesanan & penjualan (data layer laporan penjualan, skema omniai.sales_report.v1) ---------- */
function copilotKonteksPesanan_(email) {
  var r = prosesLihatDataLayerPenjualan({ email: email });
