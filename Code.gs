  var ada = { 'Shopee': {}, 'TikTok Shop': {} };
  Object.keys(listing).forEach(function (pf) { listing[pf].forEach(function (c) { ada[pf][c.toUpperCase()] = c; }); });
  var out = { usulan: [], takBertuan: [], bentrok: [], tidakAda: [], terhubung: 0, jumlahListing: { 'Shopee': listing['Shopee'].length, 'TikTok Shop': listing['TikTok Shop'].length } };
