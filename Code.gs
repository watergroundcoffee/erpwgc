/* ---------- DN-124: Riwayat stok per memo ---------- */
function p100KunciEvent_(e, tgl) {
  var ket = String(e.ket || ''), sumber = String(e.sumber || ''), m;
  if ((m = ket.match(/^Validasi Masuk (\S+)(?: \| Memo ([^|]+))?/))) return { k: 'VAL|' + m[1], jenis: 'masuk', judul: 'Barang masuk · ' + m[1] + (m[2] ? ' (memo ' + m[2].trim() + ')' : '') };
  if ((m = ket.match(/^Stok Langsung HP (\S+)/))) return { k: 'MEMO|' + m[1], jenis: 'masuk', judul: 'Memo barang masuk ' + m[1], tunggu: true };
  if ((m = ket.match(/^Catat Barang Masuk (\S+)/))) return { k: 'MEMO|' + m[1], jenis: 'masuk', judul: 'Memo barang masuk ' + m[1] };
  if (/^Scan Resi \(|tanpa scan\)$/.test(sumber) && !/PO Sales/.test(sumber)) {
    var lbl = sumber.replace(/^Scan Resi \(|\)$/g, '').replace(/ \(tanpa scan\)$/, '');
    return { k: 'JUAL|' + tgl + '|' + lbl, jenis: 'keluar', judul: 'Penjualan ' + lbl + ' · resi discan keluar', resiDariKet: true };
  }
  if (/PO Sales/.test(sumber)) { m = ket.match(/(?:PO Sales|Invoice|INV)[^\w]*([A-Z0-9][\w\-\/]{3,})/i) || ket.match(/\b([A-Z]{2,}[-\/]?\d[\w\-\/]*)/); return { k: 'PO|' + (m ? m[1] : tgl), jenis: 'keluar', judul: 'PO Sales ' + (m ? m[1] : tgl) }; }
  m = ket.match(/\b([A-Z]{2,6}[-\/]?\d[\w\-\/.]{2,})/);
  var jenis = e.kategori === 'masuk' ? 'masuk' : (e.kategori === 'keluar' ? 'keluar' : 'penyesuaian');
  var lbl2 = sumber === 'Produksi' ? 'Pemakaian produksi' : sumber === 'Transfer Gudang Shopee' ? 'Transfer gudang Shopee' : (jenis === 'masuk' ? 'Barang masuk' : jenis === 'keluar' ? 'Barang keluar' : 'Rusak / hilang / koreksi');
  return { k: 'LAIN|' + jenis + '|' + (m ? m[1] : tgl + '|' + lbl2), jenis: jenis, judul: lbl2 + (m ? ' · ' + m[1] : '') };
}
function prosesP100Riwayat(data) {
  try {
    data = data || {};
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tz = Session.getScriptTimeZone(), kini = Date.now();
    var hari = Math.min(Math.max(parseInt(data.hari, 10) || 7, 1), 120), dariMs = kini - hari * 86400000;
    var tglDari = Utilities.formatDate(new Date(dariMs), tz, 'yyyy-MM-dd');
    var mesin = smHitungMesinStok({ timeline: true }), grup = {};
    function ambilGrup(info, t) {
      var g = grup[info.k];
      if (!g) g = grup[info.k] = { kunci: info.k, jenis: info.jenis, judul: info.judul, tunggu: !!info.tunggu, ms: t, oleh: '', items: {}, resi: {} };
      if (t > g.ms) g.ms = t;
      return g;
    }
    mesin.daftar.forEach(function (p) {
      (p.timeline || []).forEach(function (e) {
        if (e.t < dariMs) return;
        var tgl = Utilities.formatDate(new Date(e.t), tz, 'yyyy-MM-dd'), info = p100KunciEvent_(e, tgl), g = ambilGrup(info, e.t);
        var it = g.items[p.sku] || (g.items[p.sku] = { sku: p.sku, nama: p.nama || '', qty: 0, n: 0 });
        it.qty += e.qty; it.n++;
        if (info.resiDariKet) { var mr = String(e.ket).match(/^Resi (\S+)/); if (mr) g.resi[mr[1]] = 1; }
        if (e.diabaikan) g.sebelumOpname = true;
      });
    });
    // Opname dari Log_Opname: per memo SO, selain itu per kiriman (baris berurutan, staff sama, < 3 jam)
    var lalu = null;
    smBacaSheet(SM_SHEET_LOG_OPNAME, 13).forEach(function (r) {
      var ms = parseFloat(r[3]) || smMs(r[1]), ket = String(r[9] || '');
      if (!ms || ms < dariMs || ket.indexOf(SM_TANDA_OPNAME_AWAL_) === 0) { lalu = null; return; }
      var mm = ket.match(/Memo SO (\S+)/), oleh = String(r[10] || ''), k;
      if (mm) k = 'SO|' + mm[1];
      else if (lalu && lalu.oleh === oleh && !lalu.memo && Math.abs(ms - lalu.ms) < 3 * 3600000) k = lalu.k;
      else k = 'SO|' + String(r[0] || ms);
      lalu = { k: k, oleh: oleh, ms: ms, memo: !!mm };
      var g = ambilGrup({ k: k, jenis: 'opname', judul: mm ? 'Stock opname · memo ' + mm[1] : 'Stock opname · ' + String(r[0] || '') }, ms);
      g.oleh = oleh;
      var sku = String(r[4] || ''), it = g.items[sku] || (g.items[sku] = { sku: sku, nama: String(r[5] || ''), qty: 0, n: 0 });
      it.fisik = parseFloat(r[6]) || 0; it.sistem = parseFloat(r[7]) || 0; it.qty = parseFloat(r[8]) || 0; it.n = 1;
    });
    var cari = smKey(data.cari), jenisF = String(data.jenis || '');
    var daftar = Object.keys(grup).map(function (k) {
      var g = grup[k], items = Object.keys(g.items).map(function (s) { return g.items[s]; });
      items.sort(function (a, b) { return Math.abs(b.qty) - Math.abs(a.qty) || a.sku.localeCompare(b.sku); });
      return { kunci: g.kunci, jenis: g.jenis, judul: g.judul, tunggu: g.tunggu, ms: g.ms, waktu: Utilities.formatDate(new Date(g.ms), tz, 'dd MMM yyyy HH:mm:ss'), tgl: Utilities.formatDate(new Date(g.ms), tz, 'yyyy-MM-dd'),
        oleh: g.oleh, nSku: items.length, nResi: Object.keys(g.resi).length, total: items.reduce(function (t, x) { return t + (Number(x.qty) || 0); }, 0),
        sebelumOpname: !!g.sebelumOpname, items: items.slice(0, 400) };
    }).filter(function (g) {
      if (g.tgl < tglDari) return false;
      if (jenisF && g.jenis !== jenisF) return false;
      if (cari && smKey(g.judul).indexOf(cari) < 0 && !g.items.some(function (x) { return smKey(x.sku).indexOf(cari) >= 0 || smKey(x.nama).indexOf(cari) >= 0; })) return false;
      return true;
    });
    daftar.sort(function (a, b) { return b.ms - a.ms; });
    return { success: true, hari: hari, daftar: daftar.slice(0, 600), jumlah: daftar.length, dihitung: Utilities.formatDate(new Date(kini), tz, 'dd MMM yyyy HH:mm:ss') };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

/* ---------- Pesan staff 8 Sep: edit nama, harga modal & link supplier dari Kartu Stok ----------
   - Nama (kolom 2) & link (kolom 5) : izin mintaStock. Link yang SUDAH terisi terkunci (tidak bisa diubah dari sini).
   - Harga modal (kolom 4 "Harga Supplier") : khusus Owner. Tetap diperbarui otomatis oleh batch AI harga supplier dari link. */
function prosesP100StokEdit(data) {
  try {
    data = data || {};
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim(); if (!sku) throw new Error('SKU kosong');
    var sh = getMasterProdukSheet(data.toko), row = katCariBarisSku_(sh, sku);
    if (!(row > 1)) throw new Error('SKU ' + sku + ' belum ada di Produk Master');
    var cur = sh.getRange(row, 1, 1, 5).getValues()[0], ubah = [];
    if (data.nama != null) {
      var nama = String(data.nama).replace(/\s+/g, ' ').trim();
      if (!nama) throw new Error('Nama tidak boleh kosong');
      if (nama !== String(cur[1] || '').trim()) { sh.getRange(row, 2).setValue(nama); ubah.push('nama'); }
    }
    if (data.hargaModal != null && String(data.hargaModal) !== '') {
      var h = parseInt(String(data.hargaModal).replace(/[^0-9]/g, ''), 10) || 0; // rupiah bulat, titik = pemisah ribuan
      if (h !== (parseFloat(cur[3]) || 0)) {
        if (!mgApakahOwner_(data.email)) throw new Error('Harga modal hanya bisa diubah Owner.');
        sh.getRange(row, 4).setValue(h); ubah.push('harga modal');
      }
    }
    if (data.url != null && String(data.url).trim()) {
      var url = String(data.url).trim();
      if (!/^https?:\/\//i.test(url)) throw new Error('Link harus diawali http:// atau https://');
      if (String(cur[4] || '').trim()) { if (String(cur[4]).trim() !== url) throw new Error('Link supplier sudah terkunci - tidak bisa diubah.'); }
      else { sh.getRange(row, 5).setValue(url); ubah.push('link'); }
    }
    if (ubah.length) { katInvalidasiCacheKatalog_(data.toko); try { invalidasiCacheKatalogHarga(data.toko); } catch (e) { } }
    var akhir = sh.getRange(row, 1, 1, 5).getValues()[0];
    return { success: true, diubah: ubah, nama: String(akhir[1] || ''), hargaModal: parseFloat(akhir[3]) || 0, url: String(akhir[4] || '') };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

