      hkT[kn] = (hkT[kn] || 0) - tot;
    });
  });
  Object.keys(rusak).forEach(function (t) {
    var tot = 0, m = rusak[t];
    Object.keys(m).forEach(function (s) { tot += m[s] * hargaModal(s); });
    var slot = D.hari[t] || (D.hari[t] = { o: {}, h: 0, r: 0, b: 0, x: {}, l: 0 });
    slot.r = tot;
