var CSK_MEMO_DETAIL_ = null;
function cskTemukan_(q) {
  var kq = cskNorm_(q);
  var res = { q: String(q || '').trim(), kunci: kq, hasil: [], tidakTerhubung: [] };
  if (kq.length < 3) return res;
  var p = petaSkuInduk_(), master = ptMasterRingkas_();
  var peta = {}; // UPPER sku master -> hasil
  function catat(induk, kode, jenis, persis) {
    var k = String(induk || '').toUpperCase(); if (!k) return;
    var m = master[k];
    var h = peta[k] || (peta[k] = { sku: m ? m.sku : induk, nama: m ? m.nama : '', arsip: m ? !!m.arsip : false, diMaster: !!m, persis: false, cocok: [] });
    if (persis) h.persis = true;
    if (h.cocok.length < 8 && !h.cocok.some(function (c) { return c.kode === kode && c.jenis === jenis; })) h.cocok.push({ kode: kode, jenis: jenis, persis: !!persis });
  }
  Object.keys(master).forEach(function (k) { var n = cskNorm_(master[k].sku); if (n.indexOf(kq) >= 0) catat(master[k].sku, master[k].sku, 'Produk Master', n === kq); });
  Object.keys(p.perInduk || {}).forEach(function (induk) {
    (p.perInduk[induk] || []).forEach(function (x) { var n = cskNorm_(x.kode); if (n.indexOf(kq) >= 0) catat(induk, x.kode, x.jenis, n === kq); });
  });
  // Kode yang pernah dipakai di pesanan tetapi tidak menunjuk ke Produk Master mana pun
  var lepas = {};
  cskBarisDetail_().forEach(function (b) {
    var n = cskNorm_(b.sku); if (n.indexOf(kq) < 0) return;
    var induk = resolveSkuJualCepat_(b.sku);
    if (master[String(induk).toUpperCase()]) { catat(induk, b.sku, 'Kode di pesanan ' + b.kanal, n === kq); return; }
    var L = lepas[n] || (lepas[n] = { kode: b.sku, kanal: {}, pesanan: {}, persis: n === kq });
    L.kanal[b.kanal] = 1; L.pesanan[b.id] = 1;
  });
  res.hasil = Object.keys(peta).map(function (k) { return peta[k]; }).sort(function (a, b) {
    return (b.persis - a.persis) || (a.arsip - b.arsip) || String(a.nama || a.sku).localeCompare(String(b.nama || b.sku));
  }).slice(0, 40);
  res.tidakTerhubung = Object.keys(lepas).map(function (n) {
    var L = lepas[n];
    return { kode: L.kode, kanal: Object.keys(L.kanal), jumlahPesanan: Object.keys(L.pesanan).length, persis: L.persis };
  }).sort(function (a, b) { return (b.persis - a.persis) || (b.jumlahPesanan - a.jumlahPesanan); }).slice(0, 20);
  return res;
}
function cskBolehLihat_(email) { return cekIzin(email, 'mintaStock') || cekIzin(email, 'buatInvoice'); }

// ===== AKSI: cari_sku_semua { q } -> { hasil:[{sku,nama,arsip,diMaster,persis,cocok:[{kode,jenis}]}], tidakTerhubung:[...] } =====
function prosesCariSkuSemua(data) {
