}

// Cari wewenang staff berdasarkan email - pakai wewenang individual kalau udah pernah di-set,
// atau fallback ke default role kalau belum (misal staff lama sebelum fitur ini ada)
function getIzinByEmail(email) {
  var staffIni = getStaffByEmail(email);
  if (staffIni && staffIni.aktif && String(staffIni.role || '').trim().toLowerCase() === 'owner') return izinPenuhOwner_();
  var snap = staffSnapshot_(), b = staffBaris_(email);
  if (!b) return {};
  if (snap.adaKolomIzin) {
    var izin = {};
    DAFTAR_IZIN.forEach(function (key, idx) { izin[key] = b[4][idx] === true; });
    return izin;
  }
  return getPermissionsForRole(b[2]); // fallback staff lama
}

function prosesUpdateStaff(data) {
  return withTransaction(data.email, null, 'akses', function () {
    var result = { success: false };
    var staffPeminta = getStaffByEmail(data.email);
    if (!staffPeminta || staffPeminta.role !== 'Owner' || !staffPeminta.aktif) {
      throw new Error('Cuma Owner yang bisa ubah data staff.');
    }
    var row = parseInt(data.row, 10);
    if (!row || row < 2) throw new Error('Baris tidak valid');

    var sh = getStaffSheet();
    if (row > sh.getLastRow()) throw new Error('Staff tidak ditemukan.');

    var roleBaru = String(data.role || '').trim();
    var aktifBaru = data.aktif === true;

    sh.getRange(row, 3).setValue(roleBaru);
    sh.getRange(row, 4).setValue(aktifBaru);

    if (!sh.getRange(1, 7).getValue()) {
      sh.getRange(1, 7, 1, DAFTAR_IZIN.length).setValues([DAFTAR_IZIN]).setFontWeight('bold');
      sh.getRange(2, 7, sh.getLastRow() - 1, DAFTAR_IZIN.length).insertCheckboxes();
    }

    // Kalau data.izin dikirim (dari centang manual di web), pakai itu persis.
    // Kalau nggak dikirim (misal cuma ganti aktif/role doang), biarin wewenang yang sudah ada.
    if (data.izin) {
      var barisIzin = DAFTAR_IZIN.map(function (key) { return data.izin[key] === true; });
      sh.getRange(row, 7, 1, DAFTAR_IZIN.length).setValues([barisIzin]);
    }

    // No HP & Alamat: cuma ditulis kalau dikirim (tombol Nonaktifkan nggak ngirim ini -> data aman)
    if (data.noHp !== undefined) {
      var kolHp = staffCariKolomHeader_(sh, KOLOM_STAFF_HP, true);
      sh.getRange(row, kolHp).setNumberFormat('@').setValue(String(data.noHp || '').trim());
    }
    if (data.alamat !== undefined) {
      var kolAlamat = staffCariKolomHeader_(sh, KOLOM_STAFF_ALAMAT, true);
      sh.getRange(row, kolAlamat).setValue(String(data.alamat || '').trim());
    }

    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

/* ============================================================
   FITUR: KELOLA SUPPLIER (web) - daftar supplier + statistik ringkas
   ============================================================ */
function prosesLihatSupplierDenganStats(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var shSupplier = getDataSupplierSheet();
    var lastRowSupplier = shSupplier.getLastRow();
    var daftarSupplier = [];
    if (lastRowSupplier > 1) {
      var valsSupplier = shSupplier.getRange(2, 1, lastRowSupplier - 1, 3).getValues();
      for (var i = 0; i < valsSupplier.length; i++) {
        var nama = String(valsSupplier[i][0] || '').trim();
        if (!nama) continue;
        daftarSupplier.push({
          row: i + 2, nama: nama, kontak: valsSupplier[i][1], catatan: valsSupplier[i][2],
          jumlahInvoice: 0, totalBelanja: 0, terakhirTransaksi: null, jumlahCabang: 0
        });
      }
    }
    var mapSupplier = {};
    daftarSupplier.forEach(function (s) { mapSupplier[s.nama.toLowerCase()] = s; });

    // Hitung jumlah cabang per supplier
    var shCabang = getCabangSupplierSheet();
    var lastRowCabang = shCabang.getLastRow();
    if (lastRowCabang > 1) {
      var valsCabang = shCabang.getRange(2, 1, lastRowCabang - 1, 1).getValues();
      valsCabang.forEach(function (row) {
        var key = String(row[0] || '').trim().toLowerCase();
        if (mapSupplier[key]) mapSupplier[key].jumlahCabang++;
      });
    }

    // Hitung jumlah invoice, total belanja, transaksi terakhir per supplier
    var shInvoice = getInvoiceSupplierSheets().header;
    var lastRowInvoice = shInvoice.getLastRow();
    if (lastRowInvoice > 1) {
      var valsInvoice = shInvoice.getRange(2, 1, lastRowInvoice - 1, 5).getValues(); // No Invoice, Tanggal, Nama Supplier, Nama Cabang, Total
      valsInvoice.forEach(function (row) {
        var namaSupplierInvoice = String(row[2] || '').trim();
        if (!namaSupplierInvoice) return;
        var key = namaSupplierInvoice.toLowerCase();
        if (!mapSupplier[key]) return; // invoice-nya nyebut nama supplier yang belum/nggak ada di Data Supplier
        var s = mapSupplier[key];
        s.jumlahInvoice++;
        s.totalBelanja += parseFloat(row[4]) || 0;
        if (row[1] instanceof Date && (!s.terakhirTransaksi || row[1] > s.terakhirTransaksi)) {
          s.terakhirTransaksi = row[1];
        }
      });
    }

    var tz = Session.getScriptTimeZone();
    daftarSupplier.forEach(function (s) {
      s.terakhirTransaksi = s.terakhirTransaksi ? Utilities.formatDate(s.terakhirTransaksi, tz, 'dd MMM yyyy') : '-';
    });

    daftarSupplier.sort(function (a, b) { return b.jumlahInvoice - a.jumlahInvoice; });
    result.success = true;
    result.daftar = daftarSupplier;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

// Detail 1 supplier: info dasar + daftar cabang + daftar invoice-nya
function prosesDetailSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var namaSupplier = String(data.nama || '').trim();
    if (!namaSupplier) throw new Error('Nama supplier kosong');

    var cabangResult = prosesLihatCabangSupplier({ namaSupplier: namaSupplier, email: data.email });
    var daftarCabang = cabangResult.success ? cabangResult.daftar : [];

    var invoiceResult = prosesLihatInvoiceSupplier({ email: data.email });
    var daftarInvoice = invoiceResult.success
      ? invoiceResult.daftar.filter(function (inv) { return inv.namaSupplier.toLowerCase() === namaSupplier.toLowerCase(); })
      : [];

    result.success = true;
    result.cabang = daftarCabang;
    result.invoice = daftarInvoice;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   MODUL FINANCE - Bagan Akun, Jurnal Transaksi, Laporan Laba Rugi
   ============================================================ */

function getBaganAkunSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Bagan Akun');
  if (!sh) {
    sh = ss.insertSheet('Bagan Akun');
    sh.getRange(1, 1, 1, 3).setValues([['Nama Akun', 'Kategori', 'Catatan']]);
    sh.getRange(1, 1, 1, 3).setFontWeight('bold');
    // Bagan akun standar buat bisnis dagang/F&B kecil-menengah - bisa ditambah/edit nanti
    var akunStandar = [
      ['Kas', 'Aset', 'Uang tunai di tangan'],
      ['Bank', 'Aset', 'Saldo rekening bank'],
      ['Persediaan', 'Aset', 'Nilai stock barang'],
      ['Piutang Usaha', 'Aset', 'Tagihan ke pembeli yang belum lunas'],
      ['Utang Usaha', 'Liabilitas', 'Tagihan dari supplier yang belum dibayar'],
      ['Modal Pemilik', 'Ekuitas', 'Modal awal & tambahan dari pemilik'],
      ['Pendapatan Penjualan', 'Pendapatan', 'Penjualan produk (otomatis dari Pesanan Manual)'],
      ['Harga Pokok Penjualan (HPP)', 'Beban', 'Biaya produk yang terjual (otomatis dari Invoice Supplier)'],
      ['Beban Ongkos Kirim', 'Beban', 'Biaya pengiriman ke pembeli'],
      ['Beban Gaji', 'Beban', 'Gaji staff'],
      ['Beban Sewa', 'Beban', 'Sewa tempat/gudang'],
      ['Beban Operasional Lain', 'Beban', 'Listrik, internet, dll']
    ];
    sh.getRange(2, 1, akunStandar.length, 3).setValues(akunStandar);
  }
  return sh;
}

function getJurnalTransaksiSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Jurnal Transaksi');
  if (!sh) {
    sh = ss.insertSheet('Jurnal Transaksi');
    sh.getRange(1, 1, 1, 8).setValues([['Tanggal', 'Akun', 'Kategori', 'Jenis', 'Jumlah', 'Keterangan', 'Sumber', 'Link Foto']]);
    sh.getRange(1, 1, 1, 8).setFontWeight('bold');
  } else if (sh.getLastColumn() < 8) {
    sh.getRange(1, 8).setValue('Link Foto').setFontWeight('bold');
  }
  // Kolom 9: Info Sistem (JSON: jenis transaksi modal/aset/pinjaman, umur manfaat, grup) - ditambahkan otomatis
  // Kolom 10: No Nota (anti dobel biaya), kolom 11: Riwayat Edit (jejak perubahan dari menu Finance)
  // Kolom 12: Rembes Oleh (nama yang menalangi pakai uang pribadi), kolom 13: Status Rembes (Belum Dibayar / Sudah Dibayar · tgl · oleh)
  if (sh.getMaxColumns() < 13) sh.insertColumnsAfter(sh.getMaxColumns(), 13 - sh.getMaxColumns());
  var judul = sh.getRange(1, 9, 1, 5).getValues()[0];
  if (!String(judul[0]).trim() || !String(judul[1]).trim() || !String(judul[2]).trim() || !String(judul[3]).trim() || !String(judul[4]).trim()) {
    sh.getRange(1, 9, 1, 5).setValues([[String(judul[0]).trim() || 'Info Sistem', String(judul[1]).trim() || 'No Nota', String(judul[2]).trim() || 'Riwayat Edit',
      String(judul[3]).trim() || 'Rembes Oleh', String(judul[4]).trim() || 'Status Rembes']]).setFontWeight('bold');
    sh.getRange(2, 10, Math.max(1, sh.getMaxRows() - 1), 1).setNumberFormat('@');
  }
  return sh;
}

function getLaporanDiterbitkanSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Laporan Diterbitkan');
  if (!sh) {
    sh = ss.insertSheet('Laporan Diterbitkan');
    sh.getRange(1, 1, 1, 8).setValues([['Tanggal Terbit', 'Periode Mulai', 'Periode Akhir', 'Total Pendapatan', 'Total HPP', 'Total Beban', 'Laba Bersih', 'Diterbitkan Oleh']]);
    sh.getRange(1, 1, 1, 8).setFontWeight('bold');
  }
  return sh;
}

/* ===== Bagan Akun ===== */
function prosesLihatBaganAkun(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getBaganAkunSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 3).getValues();
      for (var i = 0; i < vals.length; i++) {
        var nama = String(vals[i][0] || '').trim();
        if (!nama) continue;
        daftar.push({ row: i + 2, nama: nama, kategori: vals[i][1], catatan: vals[i][2] });
      }
    }
    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesSimpanAkun(data) {
  var nama, kategori;
  return withTransaction(data.email, 'buatInvoice', 'keuangan', function () {
    var result = { success: false };
    var sh = getBaganAkunSheet();
