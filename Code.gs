/* ============================================================
   HAPUS STOK (khusus Owner) v2026.10.16
   Untuk produk salah input / stok yang memang harus dibuang. TIDAK menghapus riwayat:
   dicatat sebagai Smart Opname (stok fisik = stok sekarang - qty dihapus) dengan catatan "HAPUS STOK (Owner): <alasan>",
   jadi tetap terlihat di Riwayat Stok & bisa diaudit.
   ============================================================ */
function prosesHapusStokOwner(data) {
  try {
    if (!mgApakahOwner_(data.email)) throw new Error('Hapus Stok hanya bisa dilakukan akun Owner.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('SKU kosong');
    var alasan = String(data.alasan || '').trim().slice(0, 200);
    if (!alasan) throw new Error('Alasan wajib diisi');
    var snap = smHitungPetaStok_();
    var x = snap.peta[sku];
    if (!x) throw new Error('SKU ' + sku + ' tidak ditemukan di data stok');
    var sekarang = Number(x.onHand) || 0;
    var qtyHapus = data.semua ? sekarang : Math.max(0, Number(data.qty) || 0);
    if (!(qtyHapus > 0) && !data.semua) throw new Error('Qty yang dihapus harus lebih dari 0');
    if (qtyHapus > sekarang && sekarang >= 0) throw new Error('Qty dihapus (' + qtyHapus + ') melebihi stok sekarang (' + sekarang + ')');
    var fisik = data.semua ? 0 : sekarang - qtyHapus;
    var r = prosesSmartOpnameSimpanMassal({ email: data.email, toko: data.toko, waktuKirimMs: Date.now(),
      items: [{ sku: sku, qtyFisik: fisik, catatan: 'HAPUS STOK (Owner): ' + alasan + ' | sebelum ' + sekarang + ', dihapus ' + (sekarang - fisik), waktuHitungMs: Date.now() }] });
    if (!r || !r.success) throw new Error((r && r.error) || 'Gagal menyimpan penyesuaian stok');
    return { success: true, sku: sku, stokSebelum: sekarang, stokSesudah: fisik, dihapus: sekarang - fisik };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

/* ============================================================
   LOKASI RAK v2026.10.16
   Sheet "Lokasi Rak": SKU | Rak | Diubah | Oleh. Format rak bebas, disarankan Zona-Rak-Tingkat (mis. A-03-2).
   Dipakai Monitor Stok (chip rak + edit) & Daftar Opname per Rak (urut rak untuk opname berurutan).
   ============================================================ */
var RAK_HEADER = ['SKU', 'Rak', 'Diubah', 'Oleh'];
function getLokasiRakSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Lokasi Rak');
  if (!sh) {
    sh = ss.insertSheet('Lokasi Rak');
    sh.getRange(1, 1, 1, RAK_HEADER.length).setValues([RAK_HEADER]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('A:B').setNumberFormat('@');
  }
  return sh;
}
function rakNormal_(v) { return String(v || '').trim().toUpperCase().replace(/\s+/g, '').slice(0, 30); }
function prosesRakLihat(data) {
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getLokasiRakSheet_(), lr = sh.getLastRow(), peta = {};
    if (lr > 1) sh.getRange(2, 1, lr - 1, 2).getValues().forEach(function (r) { var k = String(r[0] || '').trim(); if (k && String(r[1] || '').trim()) peta[k] = String(r[1]).trim(); });
    return { success: true, peta: peta };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}
function prosesRakSimpan(data) {
  var lock = kunciModul_('katalog');
  if (!lock.tryLock(20000)) return { success: false, error: 'Sistem sibuk, coba lagi.' };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var daftar = Array.isArray(data.daftar) ? data.daftar : [{ sku: data.sku, rak: data.rak }];
    var sh = getLokasiRakSheet_(), lr = sh.getLastRow(), posisi = {};
    if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r, i) { var k = String(r[0] || '').trim(); if (k) posisi[k] = i + 2; });
    var oleh = getNamaStaff(data.email) || data.email || '', kini = new Date(), baru = [], n = 0;
    daftar.slice(0, 2000).forEach(function (d) {
      var sku = String(d.sku || '').trim(); if (!sku) return;
      var rak = rakNormal_(d.rak);
      if (posisi[sku]) { sh.getRange(posisi[sku], 2, 1, 3).setValues([[rak, kini, oleh]]); n++; }
      else if (rak) { baru.push([sku, rak, kini, oleh]); n++; }
    });
    if (baru.length) {
      var mulai = sh.getLastRow() + 1;
      sh.getRange(mulai, 1, baru.length, 2).setNumberFormat('@');
      sh.getRange(mulai, 1, baru.length, 4).setValues(baru);
    }
    SpreadsheetApp.flush();
    return { success: true, disimpan: n };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
  finally { lepasKunci_(lock); }
}

/* ============================================================
   LABEL RESMI MARKETPLACE v2026.10.18 (Penjualan > centang pesanan > "Cetak Label Resmi")
   - TikTok Shop & Conner: Fulfillment API shipping_documents (SHIPPING_LABEL, ukuran A6) -> PDF.
   - Shopee: create_shipping_document (THERMAL_AIR_WAYBILL) -> tunggu READY -> download_shipping_document -> PDF.
   - PDF dikirim ke browser (base64); browser mengecilkan jadi 75%, menaruhnya di kiri atas kertas 10x15 cm
     dan menggabungkan semua label jadi 1 PDF siap print.
   - Tanda "sudah dicetak" disimpan di sheet "Label Dicetak" (Sumber, No Pesanan, Dicetak Pada, Oleh, Jumlah Cetak).
   ============================================================ */
var LBL_MAKS_SEKALI = 30;

function lblCariPackageTikTok_(sh, idPesanan) {
  var lr = sh.getLastRow();
  if (lr < 2) return '';
  var v = sh.getRange(2, 1, lr - 1, 15).getValues();
  for (var i = v.length - 1; i >= 0; i--) {
    var id = typeof v[i][0] === 'number' ? kunciResi_(v[i][0]) : String(v[i][0] || '').trim();
    if (id === idPesanan) { var p = String(v[i][14] || '').trim(); return p && p !== '-' ? p : ''; }
  }
  return '';
}
function lblPdfTikTok_(cfg, packageId) {
  var path = '/fulfillment/202309/packages/' + packageId + '/shipping_documents';
  var ts = String(Math.floor(Date.now() / 1000));
  var params = { app_key: cfg.appKey, timestamp: ts, shop_cipher: cfg.shopCipher, version: '202309', document_type: 'SHIPPING_LABEL', document_size: 'A6' };
  var url = 'https://open-api.tiktokglobalshop.com' + path + '?app_key=' + encodeURIComponent(cfg.appKey) + '&shop_cipher=' + encodeURIComponent(cfg.shopCipher) +
    '&timestamp=' + ts + '&version=202309&document_type=SHIPPING_LABEL&document_size=A6&sign=' + buatSignatureTikTok(path, params, '', cfg.appSecret);
  var res = fetchHemat(url, { method: 'get', headers: { 'x-tts-access-token': cfg.accessToken }, muteHttpExceptions: true });
  var teks = res.getContentText();
  if (res.getResponseCode() !== 200) throw new Error('TikTok HTTP ' + res.getResponseCode() + ': ' + teks.slice(0, 160));
  var j = JSON.parse(teks);
  var docUrl = j.data && (j.data.doc_url || j.data.url);
  if (!docUrl) throw new Error((j.message || 'TikTok tidak memberi label') + (j.code ? ' (kode ' + j.code + ')' : '') + ' - pastikan pesanan sudah "Atur Pengiriman".');
  var pdf = fetchHemat(docUrl, { method: 'get', muteHttpExceptions: true });
  if (pdf.getResponseCode() !== 200) throw new Error('Gagal mengunduh PDF label TikTok (HTTP ' + pdf.getResponseCode() + ')');
  return Utilities.base64Encode(pdf.getContent());
}
function lblShopeePanggil_(kred, path, body) {
  var ts = Math.floor(Date.now() / 1000);
  var url = getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts + '&sign=' + buatSignatureShopee(path, ts, kred.accessToken, kred.shopId) +
    '&access_token=' + kred.accessToken + '&shop_id=' + kred.shopId;
  return fetchHemat(url, { method: 'post', contentType: 'application/json', payload: JSON.stringify(body), muteHttpExceptions: true });
}
// Semua pesanan Shopee sekaligus -> 1 PDF berisi beberapa halaman label
function lblPdfShopee_(daftarSn, hasil) {
  var kred = ambilKredensialShopee();
  if (!kred.accessToken || !kred.shopId) throw new Error('Shopee belum terhubung');
  // package_number tiap pesanan
  var path0 = '/api/v2/order/get_order_detail', ts0 = Math.floor(Date.now() / 1000);
  var url0 = getShopeeHost() + path0 + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts0 + '&sign=' + buatSignatureShopee(path0, ts0, kred.accessToken, kred.shopId) +
    '&access_token=' + kred.accessToken + '&shop_id=' + kred.shopId + '&order_sn_list=' + encodeURIComponent(daftarSn.join(',')) + '&response_optional_fields=package_list';
  var det = JSON.parse(fetchHemat(url0, { method: 'get', muteHttpExceptions: true }).getContentText());
  var daftar = [];
  ((det.response && det.response.order_list) || []).forEach(function (o) {
    var pk = (o.package_list && o.package_list[0] && o.package_list[0].package_number) || '';
    daftar.push(pk ? { order_sn: o.order_sn, package_number: pk } : { order_sn: o.order_sn });
  });
  daftarSn.forEach(function (sn) { if (!daftar.some(function (d) { return d.order_sn === sn; })) hasil.push({ sumber: 'Shopee', no: sn, ok: false, pesan: 'Pesanan tidak ditemukan di Shopee' }); });
  if (!daftar.length) return null;
  var jenis = 'THERMAL_AIR_WAYBILL';
  var buat = JSON.parse(lblShopeePanggil_(kred, '/api/v2/logistics/create_shipping_document',
    { order_list: daftar.map(function (d) { return Object.assign({ shipping_document_type: jenis }, d); }) }).getContentText());
  var gagal = {};
  ((buat.response && buat.response.result_list) || []).forEach(function (r) { if (r.fail_error || r.fail_message) gagal[r.order_sn] = r.fail_message || r.fail_error; });
  var siap = daftar.filter(function (d) { return !gagal[d.order_sn]; });
  for (var c = 0; c < 6 && siap.length; c++) {
    Utilities.sleep(c ? 1500 : 800);
    var cek = JSON.parse(lblShopeePanggil_(kred, '/api/v2/logistics/get_shipping_document_result',
      { order_list: siap.map(function (d) { return Object.assign({ shipping_document_type: jenis }, d); }) }).getContentText());
    var proses = 0;
    ((cek.response && cek.response.result_list) || []).forEach(function (r) {
      if (r.status === 'FAILED' || r.fail_error) gagal[r.order_sn] = r.fail_message || r.fail_error || 'Gagal membuat label';
      else if (r.status !== 'READY') proses++;
    });
    siap = siap.filter(function (d) { return !gagal[d.order_sn]; });
    if (!proses) break;
  }
  Object.keys(gagal).forEach(function (sn) { hasil.push({ sumber: 'Shopee', no: sn, ok: false, pesan: String(gagal[sn]) + ' - pastikan pesanan sudah "Atur Pengiriman".' }); });
  if (!siap.length) return null;
  var unduh = lblShopeePanggil_(kred, '/api/v2/logistics/download_shipping_document', { shipping_document_type: jenis, order_list: siap });
  var tipe = String((unduh.getHeaders() || {})['Content-Type'] || (unduh.getHeaders() || {})['content-type'] || '');
  if (unduh.getResponseCode() !== 200 || /json/i.test(tipe)) throw new Error('Shopee: ' + unduh.getContentText().slice(0, 200));
  siap.forEach(function (d) { hasil.push({ sumber: 'Shopee', no: d.order_sn, ok: true, gabung: true }); });
  return Utilities.base64Encode(unduh.getContent());
}

function prosesLabelResmiAmbil(data) {
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var daftar = (Array.isArray(data.daftar) ? data.daftar : []).slice(0, LBL_MAKS_SEKALI);
    if (!daftar.length) throw new Error('Pilih minimal 1 pesanan dulu.');
    var props = PropertiesService.getScriptProperties();
    var hasil = [], pdf = [], sn = [];
    try { pastikanTokenTikTokMasihValid(); } catch (e1) { }
    try { pastikanTokenConnerMasihValid(); } catch (e2) { }
    daftar.forEach(function (d) {
      var sumber = String(d.sumber || ''), no = String(d.no || '').trim();
      if (/shopee/i.test(sumber)) { sn.push(no); return; }
      var conner = /conner/i.test(sumber);
      if (!/tiktok|tokopedia|conner/i.test(sumber)) { hasil.push({ sumber: sumber, no: no, ok: false, pesan: 'Label resmi hanya untuk Shopee / TikTok Shop / Tokopedia' }); return; }
      try {
        var cfg = conner
          ? { appKey: connerAppKey_(), appSecret: connerAppSecret_(), accessToken: props.getProperty('CONNER_ACCESS_TOKEN'), shopCipher: props.getProperty('CONNER_SHOP_CIPHER') }
          : { appKey: getTiktokAppKey(), appSecret: getTiktokAppSecret(), accessToken: props.getProperty('TIKTOK_ACCESS_TOKEN'), shopCipher: props.getProperty('TIKTOK_SHOP_CIPHER') };
        var pkg = d.packageId || lblCariPackageTikTok_(conner ? getPesananConnerSheet() : getPesananTikTokShopSheet(), no);
        if (!pkg) throw new Error('Package ID belum ada - pesanan belum diatur pengirimannya');
        pdf.push({ sumber: sumber, no: no, base64: lblPdfTikTok_(cfg, pkg) });
        hasil.push({ sumber: sumber, no: no, ok: true });
      } catch (e) { hasil.push({ sumber: sumber, no: no, ok: false, pesan: e.message || String(e) }); }
