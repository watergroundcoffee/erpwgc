/* =====================================================================
   UBAH SCRIPT PROPERTIES LEWAT KODE
   (Editor Apps Script tidak bisa mengedit Script Properties kalau jumlahnya > 50)
   Cara pakai:
   1. Isi nilai di UBAH_SCRIPT_PROPERTIES di bawah. Nilai yang dibiarkan '' (kosong) DILEWATI, tidak diubah.
   2. Kalau ada property yang mau dihapus, tulis namanya di HAPUS_SCRIPT_PROPERTIES.
   3. Pilih fungsi aturScriptProperties di toolbar editor > Run > buka Execution log.
   4. Setelah sukses, kosongkan lagi nilainya di sini (biar secret tidak tertinggal di kode), simpan.
   ===================================================================== */
var UBAH_SCRIPT_PROPERTIES = {
  'TIKTOK_APP_KEY': '',
  'TIKTOK_APP_SECRET': '',
  'TIKTOK_SERVICE_ID': '',
  'CONNER_APP_KEY': '',
  'CONNER_APP_SECRET': '',
  'CONNER_SERVICE_ID': ''
};
var HAPUS_SCRIPT_PROPERTIES = [];

function aturScriptProperties() {
  var props = PropertiesService.getScriptProperties();
  var sensor = function (v) { v = String(v || ''); return v.length > 10 ? v.slice(0, 4) + '...' + v.slice(-3) : v; };
  var ubah = {}, jml = 0;
  Object.keys(UBAH_SCRIPT_PROPERTIES).forEach(function (nama) {
    var nilai = String(UBAH_SCRIPT_PROPERTIES[nama] == null ? '' : UBAH_SCRIPT_PROPERTIES[nama]).trim();
    if (!nilai) return;
    var lama = props.getProperty(nama);
    ubah[nama] = nilai; jml++;
    Logger.log('✅ ' + nama + ': ' + (lama ? sensor(lama) : '(belum ada)') + '  ->  ' + sensor(nilai));
  });
  if (jml) props.setProperties(ubah, false);   // false = property lain TIDAK dihapus
  (HAPUS_SCRIPT_PROPERTIES || []).forEach(function (nama) {
    nama = String(nama || '').trim();
    if (!nama) return;
    if (props.getProperty(nama) === null) { Logger.log('➖ ' + nama + ' memang tidak ada.'); return; }
    props.deleteProperty(nama);
    Logger.log('🗑️  ' + nama + ' dihapus.');
  });
  if (!jml && !(HAPUS_SCRIPT_PROPERTIES || []).length) Logger.log('Tidak ada yang diubah - isi dulu nilai di UBAH_SCRIPT_PROPERTIES.');
  Logger.log('Total Script Properties sekarang: ' + Object.keys(props.getProperties()).length);
  Logger.log('Jangan lupa kosongkan lagi nilai di UBAH_SCRIPT_PROPERTIES lalu simpan.');
}

// Lihat semua nama Script Properties (nilai disensor) - untuk cek ejaan / menemukan property lama yang tidak terpakai
function lihatSemuaScriptProperties() {
  var semua = PropertiesService.getScriptProperties().getProperties();
  var nama = Object.keys(semua).sort();
  Logger.log('Jumlah: ' + nama.length);
