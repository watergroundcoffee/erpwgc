// ===== AKSI: siklus_resi_data_lapor { noResi, noPesanan, sumber, kurir, tanggalScan, statusTerakhir, umurHari, instan }
// Menyusun semua data yang dibutuhkan untuk mengajukan komplain (tanpa API: Owner tinggal salin & tempel).
function prosesSiklusResiDataLapor(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiKeluar') && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noResi = String(data.noResi || '').trim();
    if (!kunciResi_(noResi)) throw new Error('No Resi kosong');
    var noPesanan = String(data.noPesanan || '').trim(), sumber = String(data.sumber || '').trim();
    var pesanan = null, kR = kunciResi_(noResi), kP = kunciResi_(noPesanan);
    kumpulkanPesananUntukResi_().some(function (p) {
      var cocok = (kP && kunciResi_(p.noInvoice) === kP) || (!kP && p.resi.some(function (r) { return kunciResi_(r) === kR; }));
      if (cocok) { pesanan = p; return true; }
      return false;
    });
    if (pesanan) { noPesanan = noPesanan || String(pesanan.noInvoice); sumber = sumber || pesanan.sumber; }
    var scan = null;
    try {
      var shR = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Resi Keluar');
      if (shR && shR.getLastRow() > 1) {
        var lebar = Math.min(10, shR.getLastColumn());
        var v = shR.getRange(2, 1, shR.getLastRow() - 1, lebar).getValues();
        for (var i = v.length - 1; i >= 0; i--) if (kunciResi_(v[i][0]) === kR) { scan = v[i]; break; }
      }
    } catch (eS) { }
    var tz = Session.getScriptTimeZone();
    var tglScan = '';
    if (scan) { for (var j = 1; j < scan.length; j++) if (scan[j] instanceof Date) { tglScan = Utilities.formatDate(scan[j], tz, 'dd MMM yyyy HH:mm'); break; } }
    tglScan = tglScan || String(data.tanggalScan || '');
    var items = siklusItemPesanan_(noPesanan);
    var nilaiModal = items.reduce(function (t, it) { return t + it.qty * (it.modal || 0); }, 0);
    var nilaiJual = pesanan ? ccAngkaRupiah_(pesanan.total) : (Number(data.nilai) || 0);
    var kurir = String(data.kurir || (pesanan && pesanan.kurir) || '').trim();
    var umur = Number(data.umurHari) || 0;
    var baris = [];
    baris.push('Halo tim ' + (sumber || 'marketplace') + ', kami ingin melaporkan paket yang belum sampai / tidak ada kepastian status.');
    baris.push('');
    baris.push('No Pesanan : ' + (noPesanan || '-'));
    baris.push('No Resi    : ' + noResi);
    baris.push('Kurir      : ' + (kurir || '-'));
    baris.push('Diserahkan ke kurir : ' + (tglScan || '-') + (umur ? ' (' + Math.floor(umur) + ' hari lalu)' : ''));
    baris.push('Status terakhir     : ' + (String(data.statusTerakhir || '') || (pesanan && pesanan.status) || '-'));
    if (pesanan && pesanan.pembeli) baris.push('Pembeli    : ' + pesanan.pembeli);
    if (items.length) {
      baris.push('Isi paket  :');
      items.forEach(function (it) { baris.push('  - ' + it.nama + ' (' + it.sku + ') x' + it.qty); });
    }
    if (nilaiJual) baris.push('Nilai pesanan : Rp ' + Math.round(nilaiJual).toLocaleString('id-ID'));
    baris.push('');
    baris.push('Paket sudah kami serahkan ke kurir dan tercatat di sistem gudang kami, namun sampai hari ini belum ada kepastian diterima pembeli maupun dikembalikan. ' +
      'Mohon bantuan pengecekan ke pihak logistik dan kompensasi sesuai ketentuan bila paket dinyatakan hilang / rusak. Bukti serah terima & foto paket terlampir.');
    result.teks = baris.join('\n');
    result.ringkas = { noResi: noResi, noPesanan: noPesanan, sumber: sumber, kurir: kurir, tanggalScan: tglScan, pembeli: pesanan ? pesanan.pembeli : '', status: pesanan ? pesanan.status : '',
      nilaiJual: Math.round(nilaiJual || 0), nilaiModal: Math.round(nilaiModal), dicatatOleh: scan && scan.length > 3 ? String(scan[3] || '') : '' };
    result.items = items;
    result.panduan = (SIKLUS_PANDUAN_[sumber] || SIKLUS_PANDUAN_._).concat(['Setelah diajukan: ubah tahap jadi "Komplain diajukan" dan isi No Laporan. Bila kompensasi cair: pilih "Kompensasi diterima" + nominal -> otomatis tercatat Pendapatan Klaim.',
      'Jangan menulis klaim yang tidak benar / melebihi nilai barang - mengikuti SnK marketplace.']);
    result.bukti = ['Foto label resi & paket saat diserahkan', 'Video packing (bila ada)', 'Screenshot tracking terakhir dari aplikasi kurir', 'Bukti serah terima / tanda terima drop-off'];
    var siklus = siklusBacaSemua_()[kR];
    result.siklus = siklus ? siklusPublik_(siklus) : null;
    result.success = true;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}

// ---------- D. Memo Barang Masuk bersama antar-HP ----------
// State di CacheService (12 jam): { rev, items: { SKU: { sku, nama, qty, catatan, qtyTarget, noInvoiceAsal, rev, oleh, t, hapus } }, aktif: { nama: t }, selesai }
var MEMO_SESI_PREFIX_ = 'MGB_SESI_V1_';
function memoSesiKunci_(k) {
  var bersih = String(k || '').toUpperCase().split(/[,;|\s]+/).map(function (x) { return x.trim(); }).filter(Boolean);
  bersih = bersih.filter(function (x, i) { return bersih.indexOf(x) === i; }).sort();
  if (!bersih.length) return '';
  return MEMO_SESI_PREFIX_ + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, bersih.join('|'))).slice(0, 22);
}
// ===== AKSI: memo_sesi_sinkron { kunci: "INV-1, INV-2", perubahan: [{ sku, nama, qty, catatan, qtyTarget, noInvoiceAsal, hapus }], selesai: { noMemo }, sejakRev }
function prosesMemoSesiSinkron(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'scanResiMasuk') && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var kunci = memoSesiKunci_(data.kunci);
    if (!kunci) throw new Error('Kunci sesi (No Invoice) kosong');
    var nama = getNamaStaff(data.email) || data.email || 'Staf';
    var perangkat = String(data.perangkatId || '').slice(0, 40);
    var cache = CacheService.getScriptCache();
    var perubahan = Array.isArray(data.perubahan) ? data.perubahan.slice(0, 200) : [];
    var perluTulis = !!(perubahan.length || data.selesai);
    var lock = kunciModul_('memoSesi');
    if (!lock.tryLock(8000)) return { success: true, sibuk: true };
    try {
      var st = null;
      try { st = JSON.parse(cache.get(kunci) || 'null'); } catch (e0) { st = null; }
      if (!st || typeof st !== 'object') st = { rev: 0, items: {}, aktif: {}, selesai: null, dibuat: Date.now() };
      // v2026.10.45 (DN-261021-112659-580): checklist yang dimuat ULANG setelah sesi lama sudah dikirim (selesai)
      // memulai sesi baru - dulu sisa sesi lama (qty lama + baris yang dihapus) ikut diterapkan ke checklist baru.
      if (data.mulaiBaru && st.selesai) st = { rev: 0, items: {}, aktif: {}, selesai: null, dibuat: Date.now() };
      var sekarang = Date.now();
      st.aktif = st.aktif || {};
      st.aktif[nama + (perangkat ? '|' + perangkat : '')] = sekarang;
      Object.keys(st.aktif).forEach(function (n) { if (sekarang - st.aktif[n] > 120000) delete st.aktif[n]; });
      var diterima = 0;
      perubahan.forEach(function (p) {
        var sku = String(p.sku || '').trim();
        if (!sku) return;
        var K = sku.toUpperCase(), lama = st.items[K] || {};
        st.rev++;
        st.items[K] = {
          sku: sku, nama: String(p.nama || lama.nama || '').slice(0, 120),
          qty: Math.max(0, Number(p.qty) || 0), catatan: String(p.catatan !== undefined ? p.catatan : (lama.catatan || '')).slice(0, 200),
          qtyTarget: p.qtyTarget !== undefined ? p.qtyTarget : lama.qtyTarget, noInvoiceAsal: String(p.noInvoiceAsal || lama.noInvoiceAsal || '').slice(0, 300),
          dariChecklist: p.dariChecklist !== undefined ? !!p.dariChecklist : !!lama.dariChecklist,
          hapus: !!p.hapus, rev: st.rev, oleh: nama, perangkat: perangkat, t: sekarang
        };
        diterima++;
      });
      if (data.selesai && !st.selesai) { st.rev++; st.selesai = { oleh: nama, perangkat: perangkat, t: sekarang, noMemo: String(data.selesai.noMemo || '').slice(0, 60) }; }
      // heartbeat (siapa sedang mengerjakan) disimpan maks 1x / 15 dtk bila tidak ada perubahan - hemat tulis
      if (perluTulis || !st._hb || sekarang - st._hb > 15000) { st._hb = sekarang; cache.put(kunci, JSON.stringify(st), 43200); }
      var sejak = Number(data.sejakRev) || 0, items = [];
      Object.keys(st.items).forEach(function (K) { var it = st.items[K]; if (it.rev > sejak) items.push(it); });
      var lain = Object.keys(st.aktif).filter(function (n) { return n !== nama + (perangkat ? '|' + perangkat : ''); }).map(function (n) { return n.split('|')[0]; });
      result.rev = st.rev; result.items = items; result.diterima = diterima; result.selesai = st.selesai;
      result.staf = lain.filter(function (n, i) { return lain.indexOf(n) === i; });
      result.success = true;
    } finally { lepasKunci_(lock); }
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}

// ---------- B. Agenda promo 3 tahap -> butir "Perlu Perhatian" ----------
function p12ButirAgendaPromo_() {
  var out = { dijadwalkan: [], tayang: [], gagal: [] };
  try {
    var batas = Date.now() - 3 * 86400000;
    sptBacaSemua_().forEach(function (t) {
      if (t.action !== 'CREATE_DISCOUNT') return;
      var p = t.params || {}, tgl = sptFmt_(p.mulai_promo_ms || t.waktu);
      var label = t.sku + ' -' + (p.diskon_persen || '?') + '% (' + eksRp_(p.harga_dasar || 0) + ' → ' + eksRp_(p.harga_promo || 0) + ') tayang ' + tgl;
      var diperb = t.diperbarui instanceof Date ? t.diperbarui.getTime() : Date.now();
      if (t.status === 'PENDING' || t.status === 'PROCESSING') out.dijadwalkan.push(label);
      else if (t.status === 'DONE' && diperb >= batas) out.tayang.push(t.sku + ' -' + (p.diskon_persen || '?') + '% sejak ' + tgl);
      else if (t.status === 'FAILED' && diperb >= batas) out.gagal.push(t.sku + ': ' + String(t.hasil || '').slice(0, 80));
    });
  } catch (e) { }
  return out;
}

