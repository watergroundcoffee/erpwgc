// Bayar gaji BEBERAPA staff sekaligus dalam 1 aksi - masing-masing jadi 1 baris di Jurnal Transaksi
function prosesBayarGajiMassal(data) {
  return withTransaction(data.email, 'buatInvoice', 'keuangan', function () {
    var result = { success: false };
    var daftarGaji = data.daftarGaji || []; // [{ namaStaff, jumlah }]
    var tanggal = data.tanggal ? new Date(data.tanggal) : new Date();
    if (daftarGaji.length === 0) throw new Error('Belum ada staff yang diisi gajinya.');

    // Pastikan akun "Beban Gaji" ada
    if (!getKategoriAkun('Beban Gaji')) {
      getBaganAkunSheet().appendRow(['Beban Gaji', 'Beban', 'Gaji staff (otomatis)']);
    }

    var sh = getJurnalTransaksiSheet();
    var baris = [];
    var totalDibayar = 0;
    daftarGaji.forEach(function (g) {
      var jumlah = parseFloat(g.jumlah) || 0;
      if (jumlah <= 0) return;
      baris.push([tanggal, 'Beban Gaji', 'Beban', 'Masuk', jumlah, 'Gaji ' + g.namaStaff, 'Gaji Pegawai']);
      totalDibayar += jumlah;
    });
    if (baris.length === 0) throw new Error('Nggak ada jumlah gaji yang valid.');

    sh.getRange(sh.getLastRow() + 1, 1, baris.length, 7).setValues(baris);

    result.success = true;
    result.jumlahStaffDibayar = baris.length;
    result.totalDibayar = totalDibayar;
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// Catat biaya operasional - lebih cepat dari Jurnal umum karena kategori sudah disiapkan
