function ovxCariAngka_(obj, re, kedalaman) {
  kedalaman = kedalaman || 0;
  if (!obj || typeof obj !== 'object' || kedalaman > 4) return null;
  var kunci = Object.keys(obj);
  for (var i = 0; i < kunci.length; i++) {
    var k = kunci[i], v = obj[k];
    if (re.test(k)) {
      if (typeof v === 'number') return { nilai: v, field: k };
      if (typeof v === 'string' && v !== '' && isFinite(Number(v))) return { nilai: Number(v), field: k };
      if (v && typeof v === 'object' && !Array.isArray(v)) {
        var x = v.value !== undefined ? v.value : (v.amount !== undefined ? v.amount : v.count);
        if (x !== undefined && isFinite(Number(x))) return { nilai: Number(x), field: k };
      }
