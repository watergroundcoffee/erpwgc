      ['waterground', 'Waterground', 'Waterground', String(props.getProperty('LOGO_URL') || ''), '#16a34a', 1, now, 'sistem'],
      ['conner', 'Conner Official', 'Conner', String(props.getProperty('LOGO_URL_CONNER') || ''), '#7c3aed', 2, now, 'sistem']
    ]);
  }
  return sh;
}
function tokoDaftar_() {
  var c = CacheService.getScriptCache();
  try { var ada = c.get(TOKO_CACHE_KUNCI_); if (ada) return JSON.parse(ada); } catch (e) { }
  var sh = getTokoSheet_(), lr = sh.getLastRow(), daftar = [];
  if (lr > 1) sh.getRange(2, 1, lr - 1, TOKO_HEADER_.length).getValues().forEach(function (r) {
