/* ============================================================
   RESI MASUK (RETUR) - KELOLA KOMPLAIN
   ------------------------------------------------------------
   Data tambahan per resi retur disimpan di sheet "Retur Detail" (kunci = No Resi), supaya struktur
   sheet "Retur & Komplain" (dipakai modul lain) tidak berubah:
     ID Pesanan Manual · No Laporan · Status Pengecekan (Diterima Baik / Komplain Rusak / Tidak Terima)
     Isi paket aktual (JSON: sku, nama, qty, status Sesuai/Rusak/Hilang/Tidak Terima) · Foto & Video (JSON)
   Foto/video unboxing -> Google Drive: "OmniAI - File Upload/Retur Unboxing/<No Resi>/".
   ============================================================ */
var RETUR_DETAIL_HEADER = ['No Resi', 'ID Pesanan Manual', 'No Laporan', 'Status Pengecekan', 'Isi Paket Aktual (JSON)', 'Foto (JSON)', 'Video (JSON)', 'Diperbarui', 'Oleh', 'Catatan'];
var RETUR_STATUS_CEK = ['Diterima Baik', 'Komplain Rusak', 'Tidak Terima'];

function getReturDetailSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Retur Detail');
  if (!sh) {
    sh = ss.insertSheet('Retur Detail');
    sh.getRange(1, 1, 1, RETUR_DETAIL_HEADER.length).setValues([RETUR_DETAIL_HEADER]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('A:C').setNumberFormat('@');
  }
  return sh;
}

function returJson_(v) { try { var x = JSON.parse(String(v || '')); return Array.isArray(x) ? x : []; } catch (e) { return []; } }
// v2026.10.23 (Paket 10): kolom 11-12 di sheet "Retur Detail" (kolom 1-10 tidak berubah)
var RETUR_DETAIL_EKSTRA = ['Penerimaan Stok (JSON)', 'Klaim Marketplace (JSON)'];
function returObj_(v) { try { var x = JSON.parse(String(v || '')); return (x && typeof x === 'object' && !Array.isArray(x)) ? x : null; } catch (e) { return null; } }
function returPastikanKolomEkstra_(sh) {
  var h = sh.getRange(1, 11, 1, 2).getValues()[0];
  if (String(h[0] || '') !== RETUR_DETAIL_EKSTRA[0] || String(h[1] || '') !== RETUR_DETAIL_EKSTRA[1]) sh.getRange(1, 11, 1, 2).setValues([RETUR_DETAIL_EKSTRA]).setFontWeight('bold');
}

// Peta No Resi -> data tambahan
function returBacaDetail_() {
  var sh = getReturDetailSheet_(), lr = sh.getLastRow(), peta = {};
  var eks = lr > 1 ? sh.getRange(2, 11, lr - 1, 2).getValues() : [];
  if (lr > 1) sh.getRange(2, 1, lr - 1, RETUR_DETAIL_HEADER.length).getValues().forEach(function (r, i) {
    var k = kunciResi_(r[0]);
    if (!k) return;
    peta[k] = { row: i + 2, noResi: String(r[0]).trim(), idManual: String(r[1] || '').trim(), noLaporan: String(r[2] || '').trim(), statusCek: String(r[3] || '').trim(),
      itemAktual: returJson_(r[4]), foto: returJson_(r[5]), video: returJson_(r[6]), catatan: String(r[9] || ''),
      terima: returObj_(eks[i] && eks[i][0]), klaim: returObj_(eks[i] && eks[i][1]) };
  });
  return peta;
}

// ===== AKSI: lihat_log_resi_masuk (versi baru) - dari/sampai: 'yyyy-MM-dd' (opsional)
function prosesLihatLogResiMasuk(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiMasuk')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getSheetInfo('retur').sheet, lastRow = sh.getLastRow(), tz = Session.getScriptTimeZone();
    var daftar = [];
    var dari = /^\d{4}-\d{2}-\d{2}$/.test(String(data.dari || '')) ? String(data.dari) : '';
    var sampai = /^\d{4}-\d{2}-\d{2}$/.test(String(data.sampai || '')) ? String(data.sampai) : '';
    if (lastRow > 1) {
      var peta = bangunPetaResiKeSemuaPesananCache_(); // cache 2 menit (dulu dibangun penuh tiap buka)
      var detail = returBacaDetail_();
      var pola = muatDaftarPolaPelajari();              // pola kurir dimuat SEKALI untuk semua baris
      var lebar = Math.min(7, sh.getMaxColumns());      // FIX: dulu hanya 5 kolom -> Dicatat Oleh & Kurir selalu kosong
      var vals = sh.getRange(2, 1, lastRow - 1, lebar).getValues();
      vals.forEach(function (row, i) {
        var noResi = String(row[0] || '').trim();
        if (!noResi) return;
        var tgl = row[1] instanceof Date ? row[1] : null;
        if (tgl && (dari || sampai)) {
          var t = Utilities.formatDate(tgl, tz, 'yyyy-MM-dd');
          if ((dari && t < dari) || (sampai && t > sampai)) return;
        }
        var k = kunciResi_(noResi), cocok = peta[k], d = detail[k] || {};
        var kurirTersimpan = String(row[6] || '').trim();
        daftar.push({
          row: i + 2, noResiScan: noResi, tanggal: tgl ? Utilities.formatDate(tgl, tz, 'dd MMM yyyy, HH:mm') : '-', tanggalMs: tgl ? tgl.getTime() : 0,
          keterangan: String(row[2] || ''), dicatatOleh: String(row[5] || ''),
          kurir: kurirTersimpan || deteksiKurirCepat(noResi, pola), kurirOtomatis: !kurirTersimpan,
          idSistem: cocok ? String(cocok.noInvoice || '') : '', sumberSistem: cocok ? String(cocok.sumber || '') : '', pembeli: cocok ? String(cocok.pembeli || '') : '',
          statusPesanan: normalisasiStatusPesanan(cocok ? cocok.status : 'Retur'),
          idManual: d.idManual || '', noLaporan: d.noLaporan || '', statusCek: d.statusCek || '',
          jumlahFoto: (d.foto || []).length, jumlahVideo: (d.video || []).length,
          stokDiproses: !!(d.terima && d.terima.t), klaimTahap: d.klaim ? String(d.klaim.tahap || '') : '', klaimHasil: d.klaim ? String(d.klaim.hasil || '') : ''
        });
      });
    }
    // Teks produk (SKU + nama) per resi untuk kotak cari di web: dari isi pesanan + isi paket aktual yang tersimpan
    try {
      if (daftar.length) {
        var petaProduk = returPetaProdukPesanan_(daftar.map(function (x) { return x.idManual || x.idSistem; }).filter(function (v) { return !!v; }));
        daftar.forEach(function (x) {
          var kp = kunciResi_(x.idManual || x.idSistem);
          var teks = (kp && petaProduk[kp]) || '';
          var dd = detail[kunciResi_(x.noResiScan)];
          if (dd && dd.itemAktual) dd.itemAktual.forEach(function (it) {
            var s = (String(it.sku || '') + ' ' + String(it.nama || '')).trim();
            if (s && teks.indexOf(s) === -1) teks += (teks ? ' | ' : '') + s;
          });
          x.produk = teks.slice(0, 600);
        });
      }
    } catch (eProduk) { /* pencarian produk opsional - daftar resi tetap tampil */ }
    daftar.sort(function (a, b) { return (b.tanggalMs - a.tanggalMs) || (b.row - a.row); });
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Peta No Pesanan (kunci) -> "SKU Nama | SKU Nama" HANYA untuk pesanan yang ada di daftar retur.
// Membaca sheet detail pesanan sekali, di-cache 5 menit (dibangun ulang bila ada No Pesanan baru di daftar).
function returPetaProdukPesanan_(daftarId) {
  var perlu = {};
  (daftarId || []).forEach(function (x) { var k = kunciResi_(x); if (k) perlu[k] = 1; });
  var semuaKunci = Object.keys(perlu);
  if (!semuaKunci.length) return {};
  var KUNCI = 'RETUR_PRODUK_CARI_V1', peta = null;
  try { peta = cacheBesarGet_(KUNCI); } catch (e) { peta = null; }
  if (peta && semuaKunci.every(function (k) { return Object.prototype.hasOwnProperty.call(peta, k); })) return peta;
  peta = {};
  semuaKunci.forEach(function (k) { peta[k] = ''; });
  var idTeks = function (v) { return typeof v === 'number' ? kunciResi_(v) : String(v || '').trim(); };
  var master = {};
  try { var shM = getMasterProdukSheet(), lrM = shM.getLastRow(); if (lrM > 1) shM.getRange(2, 1, lrM - 1, 2).getValues().forEach(function (r) { master[String(r[0]).trim().toUpperCase()] = String(r[1] || ''); }); } catch (e) {}
  var tambah = function (no, sku, nama) {
    var k = kunciResi_(idTeks(no));
    if (!k || !Object.prototype.hasOwnProperty.call(peta, k)) return;
    sku = String(sku || '').trim();
    var t = (sku + ' ' + (String(nama || '').trim() || master[sku.toUpperCase()] || '')).trim();
    if (!t || peta[k].indexOf(t) !== -1) return;
    peta[k] += (peta[k] ? ' | ' : '') + t;
  };
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  ['Pesanan Shopee Detail', 'Pesanan TikTok Shop Detail', 'Pesanan Conner Detail'].forEach(function (nm) {
    try {
      var sh = ss.getSheetByName(nm);
      if (!sh || sh.getLastRow() < 2) return;
      sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues().forEach(function (r) { tambah(r[0], r[1], ''); });
    } catch (e) {}
  });
  try {
    var sm = getPesananManualSheets(), lrD = sm.detail.getLastRow();
    if (lrD > 1) sm.detail.getRange(2, 1, lrD - 1, 3).getValues().forEach(function (r) { tambah(r[0], r[1], r[2]); });
  } catch (e) {}
  // Ringkasan nama produk di header pesanan marketplace (cadangan kalau sheet detail belum terisi)
  [function () { return getPesananShopeeSheet(); }, function () { return getPesananTikTokShopSheet(); }].forEach(function (ambil) {
    try {
      var sh = ambil(), lr = sh.getLastRow();
      if (lr < 2) return;
      sh.getRange(2, 1, lr - 1, 3).getValues().forEach(function (r) {
        var k = kunciResi_(idTeks(r[0]));
        if (!k || !Object.prototype.hasOwnProperty.call(peta, k)) return;
        var t = String(r[2] || '').trim();
        if (t && peta[k].indexOf(t) === -1) peta[k] += (peta[k] ? ' | ' : '') + t;
      });
    } catch (e) {}
  });
  try { cacheBesarPut_(KUNCI, peta, 300); } catch (e) {}
  return peta;
}

// ===== AKSI: retur_simpan - simpan ID Pesanan manual / No Laporan / Status Pengecekan / isi paket aktual
function prosesReturSimpan(data) {
  var noResi;
  return withTransaction(data.email, 'scanResiMasuk', 'pengiriman', function () {
    var result = { success: false };
    if (data.statusCek !== undefined && data.statusCek !== '' && RETUR_STATUS_CEK.indexOf(String(data.statusCek)) === -1) throw new Error('Status pengecekan tidak dikenal');
    var sh = getReturDetailSheet_(), peta = returBacaDetail_(), d = peta[kunciResi_(noResi)];
    var row = d ? d.row : sh.getLastRow() + 1;
    var nilai = d ? sh.getRange(row, 1, 1, RETUR_DETAIL_HEADER.length).getValues()[0] : [noResi, '', '', '', '[]', '[]', '[]', '', '', ''];
    if (data.idManual !== undefined) nilai[1] = String(data.idManual || '').trim();
    if (data.noLaporan !== undefined) nilai[2] = String(data.noLaporan || '').trim();
    if (data.statusCek !== undefined) nilai[3] = String(data.statusCek || '');
    if (data.itemAktual !== undefined) nilai[4] = JSON.stringify((data.itemAktual || []).slice(0, 200).map(function (x) {
      return { sku: String(x.sku || ''), nama: String(x.nama || ''), qty: Number(x.qty) || 0, status: String(x.status || '') };
    }));
    if (data.catatan !== undefined) nilai[9] = String(data.catatan || '');
    nilai[7] = new Date();
    nilai[8] = getNamaStaff(data.email) || data.email || '';
    if (!d) sh.getRange(row, 1, 1, 3).setNumberFormat('@');
    sh.getRange(row, 1, 1, RETUR_DETAIL_HEADER.length).setValues([nilai]);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      noResi = String(data.noResi || '').trim();
      if (!noResi) throw new Error('No Resi kosong');
    }
  });
}

// ===== AKSI: retur_hapus - hapus 1 resi retur (salah scan dll) + WAJIB alasan.
// Jejaknya tidak hilang: baris lama + data Retur Detail disalin dulu ke sheet "Log Hapus Resi Retur".
// Tanda "sudah discan" di sheet Retur TikTok Shop ikut dikembalikan, supaya resi bisa discan ulang dengan bersih.
// Foto/video unboxing di Drive TIDAK dihapus (tetap di folder Retur Unboxing/<No Resi>).
var LOG_HAPUS_RETUR_HEADER = ['Waktu Hapus', 'No Resi', 'Tanggal Scan', 'Dicatat Oleh', 'Kurir', 'Alasan', 'Dihapus Oleh', 'Data Retur Detail (JSON)'];
function getLogHapusReturSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Log Hapus Resi Retur');
  if (!sh) {
    sh = ss.insertSheet('Log Hapus Resi Retur');
    sh.getRange(1, 1, 1, LOG_HAPUS_RETUR_HEADER.length).setValues([LOG_HAPUS_RETUR_HEADER]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('B:B').setNumberFormat('@');
  }
  return sh;
}

function prosesReturHapus(data) {
  return withTransaction(data.email, 'scanResiMasuk', 'pengiriman', function () {
    var result = { success: false };
    var noResi = String(data.noResi || '').trim();
    var k = kunciResi_(noResi);
    if (!k) throw new Error('No Resi kosong');
    var alasan = String(data.alasan || '').trim().slice(0, 300);
    if (!alasan) throw new Error('Alasan hapus wajib diisi');

    var sh = getSheetInfo('retur').sheet, lastRow = sh.getLastRow();
    // Pakai row dari frontend HANYA kalau isinya memang resi ini (row bisa bergeser kalau ada yang hapus duluan)
    var row = parseInt(data.row, 10);
    if (!(row >= 2 && row <= lastRow && kunciResi_(sh.getRange(row, 1).getValue()) === k)) {
      row = 0;
      if (lastRow > 1) {
        var kol = sh.getRange(2, 1, lastRow - 1, 1).getValues();
        for (var i = 0; i < kol.length; i++) if (kunciResi_(kol[i][0]) === k) { row = i + 2; break; }
      }
    }
    if (!row) throw new Error('Resi ' + noResi + ' tidak ditemukan (mungkin sudah dihapus).');

    var lebar = Math.min(7, sh.getMaxColumns());
    var lama = sh.getRange(row, 1, 1, lebar).getValues()[0];
    var detail = returBacaDetail_()[k] || null;
    var oleh = getNamaStaff(data.email) || data.email || '';

    // 1) Catat jejak dulu (kalau langkah ini gagal, tidak ada yang terhapus)
    var shLog = getLogHapusReturSheet_(), rLog = shLog.getLastRow() + 1;
    shLog.getRange(rLog, 2).setNumberFormat('@');
    shLog.getRange(rLog, 1, 1, LOG_HAPUS_RETUR_HEADER.length).setValues([[
      new Date(), String(lama[0] || noResi), lama[1] instanceof Date ? lama[1] : String(lama[1] || ''),
      String(lama[5] || ''), String(lama[6] || ''), alasan, oleh,
      detail ? JSON.stringify({ idManual: detail.idManual, noLaporan: detail.noLaporan, statusCek: detail.statusCek, itemAktual: detail.itemAktual, foto: detail.foto, video: detail.video, catatan: detail.catatan }) : ''
    ]]);

    // 2) Kembalikan tanda "sudah discan" di Retur TikTok Shop (kolom 7 = resi, 10 = sudah discan, 11 = waktu scan)
    try {
      var shRT = getReturTikTokSheet(), lrRT = shRT.getLastRow();
      if (lrRT > 1) shRT.getRange(2, 7, lrRT - 1, 1).getValues().forEach(function (v, ix) {
        if (kunciResi_(v[0]) === k) { shRT.getRange(ix + 2, 10).setValue(false); shRT.getRange(ix + 2, 11).setValue(''); }
      });
    } catch (eRT) { /* bukan alasan buat gagalin hapus */ }
    try {
      var shRS = getReturShopeeSheet(), lrRS = shRS.getLastRow();
      if (lrRS > 1) shRS.getRange(2, 7, lrRS - 1, 1).getValues().forEach(function (v, ix) {
        if (kunciResi_(v[0]) === k) { shRS.getRange(ix + 2, 10).setValue(false); shRS.getRange(ix + 2, 11).setValue(''); }
      });
    } catch (eRS) { /* bukan alasan buat gagalin hapus */ }
    try {
      var shRC = getReturConnerSheet(), lrRC = shRC.getLastRow();
      if (lrRC > 1) shRC.getRange(2, 7, lrRC - 1, 1).getValues().forEach(function (v, ix) {
        if (kunciResi_(v[0]) === k) { shRC.getRange(ix + 2, 10).setValue(false); shRC.getRange(ix + 2, 11).setValue(''); }
      });
    } catch (eRC) { /* bukan alasan buat gagalin hapus */ }

    // 3) Hapus baris retur + data tambahannya
    sh.deleteRow(row);
    if (detail && detail.row) getReturDetailSheet_().deleteRow(detail.row);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}


/* ####################################################################################
   KOMPLAIN PELANGGAN (Shopee, TikTok Shop, Tokopedia, Manual Order, Website)
   1 baris = 1 komplain. Cukup No Pesanan -> data pembeli & barang ditarik otomatis (returCariPesanan_).
   Jenis Kendala : Barang Rusak | Kurang Kirim | Salah Kirim
   Status        : Menunggu | Selesai
   Solusi terintegrasi (dijalankan SEKALI, dicatat di kolom Ref supaya tidak pernah dobel):
     - kirim_ulang -> barang yang dikirim ulang dipotong dari stok gudang (Stock Ledger \"Rusak/Hilang\",
                      keterangan \"Kirim ulang komplain\"), masuk Laporan Keuangan sebagai kerugian persediaan.
     - refund      -> nilai refund/kompensasi dicatat sebagai beban di Jurnal Transaksi
                      (akun \"Beban Refund & Kompensasi Pelanggan\"); nominal yang diubah ikut menyesuaikan.
   #################################################################################### */
var KMP_SHEET = 'Komplain Pelanggan';
var KMP_HEADER = ['ID', 'Tanggal', 'No Pesanan', 'Channel', 'Pembeli', 'No HP', 'Barang Pesanan (JSON)', 'Jenis Kendala', 'Keterangan',
  'Solusi', 'Status', 'Nilai Refund', 'Barang Kirim Ulang (JSON)', 'Resi Kirim Ulang', 'Ref Stok', 'Ref Finance', 'Dibuat Oleh', 'Diubah', 'Tanggal Selesai'];
var KMP_JENIS = ['Barang Rusak', 'Kurang Kirim', 'Salah Kirim'];
var KMP_SOLUSI = { kirim_ulang: 'Kirim Ulang Barang', refund: 'Refund / Kompensasi', tanpa: 'Belum / tanpa solusi' };
var KMP_AKUN_REFUND = 'Beban Refund & Kompensasi Pelanggan';

function getKomplainSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(KMP_SHEET);
  if (!sh) {
    sh = ss.insertSheet(KMP_SHEET);
    sh.getRange(1, 1, 1, KMP_HEADER.length).setValues([KMP_HEADER]).setFontWeight('bold');
    sh.getRange('A:A').setNumberFormat('@'); sh.getRange('C:C').setNumberFormat('@'); sh.getRange('F:F').setNumberFormat('@'); sh.getRange('N:N').setNumberFormat('@');
    sh.setFrozenRows(1);
  }
  return sh;
}
function kmpJson_(v, cadangan) { try { var x = JSON.parse(String(v || '')); return x == null ? cadangan : x; } catch (e) { return cadangan; } }
function kmpBaris_(r, row, tz) {
  return {
    row: row, id: String(r[0] || ''), tanggal: r[1] instanceof Date ? Utilities.formatDate(r[1], tz, 'yyyy-MM-dd') : String(r[1] || '').slice(0, 10),
    ms: r[1] instanceof Date ? r[1].getTime() : 0, noPesanan: String(r[2] || ''), channel: String(r[3] || ''), pembeli: String(r[4] || ''),
    hp: formatNoHpIntl_(r[5]), barang: kmpJson_(r[6], []), jenis: String(r[7] || ''), keterangan: String(r[8] || ''),
    solusi: String(r[9] || 'tanpa'), status: String(r[10] || 'Menunggu'), nilaiRefund: Number(r[11]) || 0,
    kirimUlang: kmpJson_(r[12], []), resiKirimUlang: String(r[13] || ''), refStok: String(r[14] || ''), refFinance: String(r[15] || ''),
    oleh: String(r[16] || ''), diubah: r[17] instanceof Date ? Utilities.formatDate(r[17], tz, 'dd MMM yyyy HH:mm') : String(r[17] || ''),
    tanggalSelesai: r[18] instanceof Date ? Utilities.formatDate(r[18], tz, 'dd MMM yyyy') : String(r[18] || '')
  };
}

// ===== AKSI: komplain_cari_pesanan { noPesanan } =====
function prosesKomplainCariPesanan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var no = String(data.noPesanan || '').trim();
    if (no.length < 4) throw new Error('Isi No Pesanan (minimal 4 karakter)');
    var p = returCariPesanan_(no);
    if (!p) {
      // Coba juga sebagai No Resi
      try { var cocok = bangunPetaResiKeSemuaPesananCache_()[kunciResi_(no)]; if (cocok && cocok.noInvoice) p = returCariPesanan_(String(cocok.noInvoice)); } catch (eR) { }
    }
    if (!p) throw new Error('Pesanan ' + no + ' tidak ditemukan di Shopee, TikTok Shop, Tokopedia, Conner maupun Manual Order. Pastikan sudah tersinkron.');
    p.hp = formatNoHpIntl_(p.hp);
    // Harga satuan dari Produk Master (untuk saran nilai refund)
    try {
      var shM = getMasterProdukSheet(), lrM = shM.getLastRow(), harga = {};
      if (lrM > 1) shM.getRange(2, 1, lrM - 1, 3).getValues().forEach(function (r) { harga[String(r[0]).trim().toUpperCase()] = Number(r[2]) || 0; });
      (p.items || []).forEach(function (it) { it.harga = harga[String(it.sku || '').trim().toUpperCase()] || 0; });
    } catch (eH) { }
    // Komplain lain untuk pesanan yang sama
    var sh = getKomplainSheet_(), lr = sh.getLastRow(), tz = Session.getScriptTimeZone(), ada = [];
    if (lr > 1) sh.getRange(2, 1, lr - 1, KMP_HEADER.length).getValues().forEach(function (r, i) {
      if (kunciResi_(r[2]) === kunciResi_(p.noPesanan)) ada.push(kmpBaris_(r, i + 2, tz));
    });
    result.success = true; result.pesanan = p; result.komplainLain = ada;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}

// ===== AKSI: lihat_komplain {} =====
function prosesLihatKomplain(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getKomplainSheet_(), lr = sh.getLastRow(), tz = Session.getScriptTimeZone(), daftar = [];
    if (lr > 1) sh.getRange(2, 1, lr - 1, KMP_HEADER.length).getValues().forEach(function (r, i) { if (String(r[0] || '').trim()) daftar.push(kmpBaris_(r, i + 2, tz)); });
    daftar.sort(function (a, b) { return (b.ms - a.ms) || (b.row - a.row); });
    result.success = true; result.daftar = daftar; result.jenis = KMP_JENIS; result.solusi = KMP_SOLUSI;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}

// ===== AKSI: komplain_simpan { id?, noPesanan, channel, pembeli, hp, barang[], jenis, keterangan, solusi, status,
//                               nilaiRefund, kirimUlang[{sku,nama,qty}], resiKirimUlang, tanggal } =====
function prosesKomplainSimpan(data) {
  return withTransaction(data.email, 'buatInvoice', ['penjualan', 'stok', 'keuangan'], function () {
    var result = { success: false };
    var tz = Session.getScriptTimeZone(), oleh = getNamaStaff(data.email) || data.email || '', sekarang = new Date();
    var noPesanan = String(data.noPesanan || '').trim();
    if (!noPesanan) throw new Error('No Pesanan wajib diisi');
    var jenis = KMP_JENIS.indexOf(String(data.jenis)) !== -1 ? String(data.jenis) : '';
    if (!jenis) throw new Error('Pilih Jenis Kendala');
    var solusi = KMP_SOLUSI[data.solusi] ? String(data.solusi) : 'tanpa';
    var status = data.status === 'Selesai' ? 'Selesai' : 'Menunggu';
    var nilaiRefund = Math.max(0, Math.round(Number(data.nilaiRefund) || 0));
    var kirimUlang = (Array.isArray(data.kirimUlang) ? data.kirimUlang : []).map(function (it) {
      return { sku: String(it.sku || '').trim(), nama: String(it.nama || '').trim().slice(0, 120), qty: Math.max(0, parseInt(it.qty, 10) || 0) };
    }).filter(function (it) { return it.sku && it.qty > 0; });
    if (solusi === 'refund' && !(nilaiRefund > 0)) throw new Error('Isi nilai refund / kompensasi');
    if (solusi === 'kirim_ulang' && !kirimUlang.length) throw new Error('Pilih barang & jumlah yang dikirim ulang');
    var tanggal = finValidTgl_(data.tanggal) ? finParseTanggalInput_(data.tanggal) : sekarang;

    var sh = getKomplainSheet_(), lr = sh.getLastRow(), row = 0, lama = null;
    var id = String(data.id || '').trim();
    if (id && lr > 1) {
      var ids = sh.getRange(2, 1, lr - 1, 1).getValues();
      for (var i = 0; i < ids.length; i++) if (String(ids[i][0]) === id) { row = i + 2; break; }
      if (row) lama = kmpBaris_(sh.getRange(row, 1, 1, KMP_HEADER.length).getValues()[0], row, tz);
    }
    if (!row) {
      if (!/^KMP-[A-Z0-9-]{4,30}$/.test(id)) id = 'KMP-' + Utilities.formatDate(sekarang, tz, 'yyMMdd') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase();
      row = sh.getLastRow() + 1;
    }
    var refStok = lama ? lama.refStok : '', refFinance = lama ? lama.refFinance : '';
    var label = 'komplain ' + id + ' · pesanan ' + noPesanan + (data.pembeli ? ' · ' + String(data.pembeli).slice(0, 40) : '');

    // ---- (1) Kirim ulang: potong stok SEKALI ----
    if (solusi === 'kirim_ulang' && !refStok) {
      var barisL = kirimUlang.map(function (it) { return [sekarang, it.sku, 'Rusak/Hilang', it.qty, 'Kirim ulang ' + label + ' (' + jenis + ')', oleh]; });
      var shL = getStockLedgerSheet();
      var awal = shL.getLastRow() + 1;
      shL.getRange(awal, 1, barisL.length, 6).setValues(barisL);
      refStok = 'Ledger baris ' + awal + (barisL.length > 1 ? '-' + (awal + barisL.length - 1) : '') + ' · ' + Utilities.formatDate(sekarang, tz, 'dd MMM yyyy HH:mm');
      hitungUlangSaldoStok_(); try { smInvalidasiCache(); } catch (eS) { }
      try { finInvalidasi_(); } catch (eF) { }
      result.stokDipotong = barisL.length;
    } else if (lama && lama.refStok && solusi === 'kirim_ulang') {
      kirimUlang = lama.kirimUlang; // barang yang sudah dipotong tidak bisa diubah (cegah selisih stok)
    }

    // ---- (2) Refund / kompensasi: catat / sesuaikan beban di Finance ----
    var shJ = getJurnalTransaksiSheet();
    var rowJ = parseInt(String(refFinance).replace(/\D/g, ''), 10) || 0;
    var jAktif = rowJ >= 2 && rowJ <= shJ.getLastRow() && String(shJ.getRange(rowJ, 4).getValue()).trim() === 'Masuk' &&
      String(shJ.getRange(rowJ, 7).getValue()).trim() === 'Komplain Pelanggan';
    if (solusi === 'refund') {
      var akun = finPastikanAkunBeban_(KMP_AKUN_REFUND);
      var ketJ = 'Refund/kompensasi ' + label + ' (' + jenis + ')';
      if (jAktif) {
        var jmlLama = Math.round(Number(shJ.getRange(rowJ, 5).getValue()) || 0);
        if (jmlLama !== nilaiRefund) {
          shJ.getRange(rowJ, 5, 1, 2).setValues([[nilaiRefund, ketJ]]);
          finPatchBiaya_(rowJ, { tanggal: shJ.getRange(rowJ, 1).getValue(), akun: akun, jumlah: nilaiRefund, ket: ketJ, row: rowJ });
        }
      } else {
        rowJ = shJ.getLastRow() + 1;
        shJ.getRange(rowJ, 1, 1, 8).setValues([[tanggal, akun, 'Beban', 'Masuk', nilaiRefund, ketJ, 'Komplain Pelanggan', '']]);
        finPatchBiaya_(0, { tanggal: tanggal, akun: akun, jumlah: nilaiRefund, ket: ketJ, row: rowJ });
        refFinance = 'Jurnal baris ' + rowJ;
        result.financeDicatat = true;
      }
    } else if (jAktif) {
      // Solusi diganti dari refund -> beban dibatalkan (jejak tetap di sheet)
      shJ.getRange(rowJ, 4).setValue('Dihapus');
      shJ.getRange(rowJ, 6).setValue(String(shJ.getRange(rowJ, 6).getValue()) + ' [dibatalkan ' + Utilities.formatDate(sekarang, tz, 'dd MMM yyyy HH:mm') + ' oleh ' + oleh + ']');
      finPatchBiaya_(rowJ, null);
      refFinance = refFinance + ' (dibatalkan)';
    }

    var barang = Array.isArray(data.barang) ? data.barang.slice(0, 60).map(function (it) { return { sku: String(it.sku || ''), nama: String(it.nama || '').slice(0, 120), qty: Number(it.qty) || 0 }; }) : (lama ? lama.barang : []);
    var nilai = [[
      id, lama && lama.ms ? new Date(lama.ms) : tanggal, noPesanan, String(data.channel || (lama && lama.channel) || '').slice(0, 40),
      String(data.pembeli || (lama && lama.pembeli) || '').slice(0, 80), formatNoHpIntl_(data.hp || (lama && lama.hp) || ''),
      JSON.stringify(barang), jenis, String(data.keterangan || '').slice(0, 1000), solusi, status, solusi === 'refund' ? nilaiRefund : '',
      solusi === 'kirim_ulang' ? JSON.stringify(kirimUlang) : '', String(data.resiKirimUlang || '').trim().slice(0, 60), refStok, refFinance,
      lama ? lama.oleh : oleh, sekarang, status === 'Selesai' ? (lama && lama.status === 'Selesai' && lama.tanggalSelesai ? lama.tanggalSelesai : sekarang) : ''
    ]];
    sh.getRange(row, 1, 1, KMP_HEADER.length).setValues(nilai);
    result.success = true;
    result.item = kmpBaris_(sh.getRange(row, 1, 1, KMP_HEADER.length).getValues()[0], row, tz);
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// Cari 1 pesanan (semua channel) berdasarkan ID -> isi paket & data pembeli
function returCariPesanan_(id) {
  var k = kunciResi_(id);
  if (!k) return null;
  var idTeks = function (v) { return typeof v === 'number' ? kunciResi_(v) : String(v || '').trim(); };
  var master = {};
  try { var shM = getMasterProdukSheet(), lrM = shM.getLastRow(); if (lrM > 1) shM.getRange(2, 1, lrM - 1, 2).getValues().forEach(function (r) { master[String(r[0]).trim().toUpperCase()] = String(r[1] || ''); }); } catch (e) {}
  var pilih = function () { for (var i = 0; i < arguments.length; i++) { var v = String(arguments[i] || '').trim(); if (v) return v; } return ''; };
  function itemDariDetail(namaSheet, noOrder) {
    var shD = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(namaSheet), out = [];
    if (!shD || shD.getLastRow() < 2) return out;
    shD.getRange(2, 1, shD.getLastRow() - 1, 3).getValues().forEach(function (r) {
      if (kunciResi_(idTeks(r[0])) !== kunciResi_(noOrder)) return;
      var sku = String(r[1] || '').trim();
      if (sku) out.push({ sku: sku, nama: master[sku.toUpperCase()] || sku, qty: Number(r[2]) || 0 });
    });
    return out;
  }
  // PO Sales / Pesanan Manual
  var sm = getPesananManualSheets(), lr = sm.header.getLastRow();
  if (lr > 1) {
    var vh = sm.header.getRange(2, 1, lr - 1, Math.min(17, sm.header.getMaxColumns())).getValues();
    for (var i = 0; i < vh.length; i++) if (kunciResi_(idTeks(vh[i][0])) === k) {
      var r = vh[i], items = [];
      var lrD = sm.detail.getLastRow();
      if (lrD > 1) sm.detail.getRange(2, 1, lrD - 1, 4).getValues().forEach(function (x) { if (kunciResi_(idTeks(x[0])) === k) items.push({ sku: String(x[1] || ''), nama: String(x[2] || '') || master[String(x[1]).toUpperCase()] || '', qty: Number(x[3]) || 0 }); });
      return { sumber: 'PO Sales', noPesanan: idTeks(r[0]), status: String(r[11] || '') || 'Belum Dikirim', username: '-', nama: pilih(r[15], r[2]) || '-', hp: pilih(r[16], r[4]) || '-', alamat: pilih(r[3]) || '-', items: items };
    }
  }
  // TikTok Shop / Tokopedia
  var shT = getPesananTikTokShopSheet(); lr = shT.getLastRow();
  if (lr > 1) {
    var vt = shT.getRange(2, 1, lr - 1, 17).getValues();
    for (var t = 0; t < vt.length; t++) if (kunciResi_(idTeks(vt[t][0])) === k) {
      var a = vt[t];
      return { sumber: a[16] === 'TOKOPEDIA' ? 'Tokopedia' : 'TikTok Shop', noPesanan: idTeks(a[0]), status: String(a[4] || ''), username: pilih(a[15]) || '-',
        nama: pilih(a[10], a[7]) || '-', hp: pilih(a[11], a[8]) || '-', alamat: pilih(a[12], a[9]) || '-', items: itemDariDetail('Pesanan TikTok Shop Detail', a[0]), ringkasProduk: String(a[2] || '') };
    }
  }
  // Shopee
  var shS = getPesananShopeeSheet(); lr = shS.getLastRow();
  if (lr > 1) {
    var vs = shS.getRange(2, 1, lr - 1, 16).getValues();
    for (var s = 0; s < vs.length; s++) if (kunciResi_(idTeks(vs[s][0])) === k) {
      var b = vs[s];
      // v2026.10.43 (DN-261021-085640-808): kolom Manual kosong -> data yang pernah ditangkap (API / OCR) di "Pembeli Shopee Lengkap"
      var lk = {};
      if (!String(b[10] || '').trim() || !String(b[11] || '').trim() || !String(b[12] || '').trim()) { try { lk = spbBacaLengkap_([idTeks(b[0])])[idTeks(b[0])] || {}; } catch (eLk) { lk = {}; } }
      var bukanSamar = function (v) { v = String(v || '').trim(); return v && !shopeeTersamar_(v) ? v : ''; };
      return { sumber: 'Shopee', noPesanan: idTeks(b[0]), status: String(b[4] || ''), username: pilih(b[14], lk.username) || '-',
        nama: pilih(b[10], lk.nama, bukanSamar(b[7]), b[7]) || '-', hp: pilih(b[11], lk.hp, bukanSamar(b[8]), b[8]) || '-',
        alamat: pilih(b[12], lk.alamat, bukanSamar(b[9]), b[9]) || '-', items: itemDariDetail('Pesanan Shopee Detail', b[0]), ringkasProduk: String(b[2] || '') };
    }
  }
  // Conner Hardware
  try {
    var shC = getPesananConnerSheet(); lr = shC.getLastRow();
    if (lr > 1) {
      var vc = shC.getRange(2, 1, lr - 1, 8).getValues();
      for (var c = 0; c < vc.length; c++) if (kunciResi_(idTeks(vc[c][0])) === k) {
        return { sumber: 'Conner Hardware', noPesanan: idTeks(vc[c][0]), status: String(vc[c][4] || ''), username: '-', nama: pilih(vc[c][7]) || '-', hp: '-', alamat: '-', items: itemDariDetail('Pesanan Conner Detail', vc[c][0]) };
      }
    }
  } catch (eC) {}
  // v2026.10.23 (DN-192558-248): No Reservasi Pengiriman Kilat (Transfer Gudang Shopee) - boleh juga resinya
  try {
    var tg = tgsBacaSemua_().filter(function (t) { return kunciResi_(t.noReservasi) === k || (t.noResi && kunciResi_(t.noResi) === k); })[0];
    if (tg) return { sumber: 'Pengiriman Kilat (No Reservasi)', noPesanan: tg.noReservasi, status: tg.status || '-', username: '-', nama: 'Gudang Shopee' + (tg.gudang ? ' ' + tg.gudang : ''), hp: '-', alamat: '-',
      kilat: true, items: tg.item.filter(function (it) { return it.sku && it.qtyKirim > 0; }).map(function (it) { return { sku: it.sku, nama: it.nama || master[it.sku.toUpperCase()] || it.sku, qty: it.qtyKirim }; }) };
  } catch (eTg) {}
  return null;
}

// ===== AKSI: retur_detail - isi paket seharusnya + isi paket aktual + media + info pembeli
function prosesReturDetail(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiMasuk')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noResi = String(data.noResi || '').trim();
    var d = returBacaDetail_()[kunciResi_(noResi)] || { itemAktual: [], foto: [], video: [] };
    var id = String(data.idPesanan || d.idManual || '').trim();
    if (!id) { var cocok = bangunPetaResiKeSemuaPesananCache_()[kunciResi_(noResi)]; if (cocok) id = String(cocok.noInvoice || ''); }
    result.pesanan = id ? returCariPesanan_(id) : null;
    result.idDipakai = id;
    result.itemAktual = d.itemAktual || [];
    result.foto = d.foto || [];
    result.video = d.video || [];
    result.statusCek = d.statusCek || '';
    result.catatan = d.catatan || '';
    result.terima = d.terima || null;
    result.klaim = d.klaim || null;
    result.bolehKlaim = cekIzin(data.email, 'buatInvoice');
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: retur_upload_media - 1 file foto/video unboxing per panggilan (tanpa batas jumlah)
function prosesReturUploadMedia(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiMasuk')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noResi = String(data.noResi || '').trim();
    if (!noResi) throw new Error('No Resi kosong');
    var jenis = data.jenis === 'video' ? 'video' : 'foto';
    var mime = String(data.mimeType || (jenis === 'video' ? 'video/mp4' : 'image/jpeg'));
    if (jenis === 'foto' && !/^image\//.test(mime)) throw new Error('File foto harus berupa gambar');
    if (jenis === 'video' && !/^video\//.test(mime)) throw new Error('File video tidak dikenali');
    var base64 = String(data.base64 || '');
    var blobSumber = null;
    if (!base64 && /^https:\/\//i.test(String(data.urlSumber || ''))) {
      // Gambar ditarik dari halaman web lain: server yang mengambil file aslinya
      var respWeb = UrlFetchApp.fetch(String(data.urlSumber), { muteHttpExceptions: true, followRedirects: true });
      if (respWeb.getResponseCode() !== 200) throw new Error('Gambar dari web tidak bisa diambil (HTTP ' + respWeb.getResponseCode() + '). Simpan gambarnya dulu lalu tarik dari folder.');
      blobSumber = respWeb.getBlob();
      var tipeWeb = String(blobSumber.getContentType() || '').split(';')[0].trim().toLowerCase();
      if (!/^image\//.test(tipeWeb)) throw new Error('Tautan yang ditarik bukan file gambar');
      if (blobSumber.getBytes().length > 30 * 1024 * 1024) throw new Error('Gambar dari web terlalu besar (maks 30 MB)');
      mime = tipeWeb;
      data.nama = 'gambar-web.' + ((tipeWeb.split('/')[1] || 'jpg').replace('jpeg', 'jpg').replace(/[^a-z0-9]/g, '') || 'jpg');
    }
    if (!base64 && !blobSumber) throw new Error('File kosong');

    var aman = function (t) { return String(t || '').replace(/[\\/:*?"<>|#%]+/g, '-').replace(/\s+/g, ' ').trim(); };
    var induk = getSubfolderUpload('Retur Unboxing');
    var namaFolder = aman(noResi);
    var it = induk.getFoldersByName(namaFolder);
    var folder = it.hasNext() ? it.next() : induk.createFolder(namaFolder);

    var lock = kunciModul_('pengiriman');
    lock.waitLock(20000);
    try {
      var sh = getReturDetailSheet_(), peta = returBacaDetail_(), d = peta[kunciResi_(noResi)];
      var daftar = d ? (jenis === 'video' ? d.video : d.foto) : [];
      var urutan = daftar.length + 1;
