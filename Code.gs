        var lama = String(r[15] || '').trim();
        r[13] = 'Selesai'; r[14] = kini; r[15] = devTeks_(lama ? lama + '\n' + ket : ket, 2000);
        var cek = sh.getRange(i + 2, 1, 1, 1).getValues()[0];
        if (String(cek[0]) !== id) return; // baris bergeser -> lewati, dicoba lagi lain kali
        sh.getRange(i + 2, 1, 1, r.length).setValues([r]);
        n++;
      });
    });
    props.setProperty('DEV_PAKET_DITERAPKAN', sudah.concat(antre.map(function (p) { return p.versi; })).join(','));
    if (n) SpreadsheetApp.flush();
