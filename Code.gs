}

function aiSamarkanKey_(k) { k = String(k || ''); return k ? (k.length > 10 ? k.slice(0, 4) + '••••••' + k.slice(-4) : '••••') : ''; }
function aiAgentStatusSemua_() { try { return JSON.parse(PropertiesService.getScriptProperties().getProperty('AI_AGENT_STATUS') || '{}'); } catch (e) { return {}; } }

function aiAgentRingkas_(role) {
  var def = aiAgentDef_(role), pakai = aiAgentKey_(role), st = aiAgentStatusSemua_()[role] || null;
  var p = PropertiesService.getScriptProperties();
  var label, kelas;
  if (!pakai.key) { label = 'Belum diisi'; kelas = 'err'; }
  else if (st && st.ok && st.keyCek === aiSidikKey_(pakai.key) && st.model === pakai.model) { label = def.labelOk; kelas = 'ok'; }
  else if (st && !st.ok && st.keyCek === aiSidikKey_(pakai.key)) { label = 'Error'; kelas = 'err'; }
  else { label = 'Belum dites'; kelas = 'warn'; }
  var r = { role: role, nama: def.nama, ikon: def.ikon, peran: def.peran, tugas: def.tugas, labelOk: def.labelOk,
    terpasang: !!String(p.getProperty(def.propKey) || '').trim(), keyTersamar: aiSamarkanKey_(pakai.key), sumber: pakai.sumber,
    model: pakai.model, modelDefault: def.modelDefault, modelSendiri: String(p.getProperty(def.propModel) || ''),
    status: label, kelas: kelas, teks: def.nama + ' - ' + label,
    tes: st ? { ok: !!st.ok, waktu: st.waktu || '', ms: st.ms || 0, pesan: st.pesan || '' } : null,
    provider: pakai.provider, providerLabel: aiProviderLabel_(pakai.provider),
    providerSendiri: aiNormalProvider_(p.getProperty(def.propKey + '_PROVIDER')), baseUrlSendiri: String(p.getProperty(def.propKey + '_BASEURL') || ''),
    baseUrl: pakai.baseUrl };
  if (role === 'rehan') {
    var cfg = aifKonfig_(), pk = aifPemakaian_();
    r.rpm = cfg.rpm; r.rpd = cfg.rpd; r.hariIni = pk.n; r.habis = !!pk.habis;
  }
  if (role === 'budi' && pakai.sumber === 'cadangan-jaya') r.catatan = 'Belum punya key sendiri - sementara memakai key Jaya.';
  if (role === 'jaya' && pakai.sumber === 'cadangan-lama') r.catatan = 'Memakai GEMINI_API_KEY lama. Isi key Jaya untuk mengganti.';
  return r;
}
// Sidik key (bukan key-nya) untuk mencocokkan hasil tes dengan key yang sedang terpasang
function aiSidikKey_(k) {
  var b = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(k || ''));
  return Utilities.base64EncodeWebSafe(b).slice(0, 16);
}

function getAIApiKeys(data) {
  var result = { success: false };
  try {
    integrasiWajibOwner_(data.email);
    result.agents = AI_AGENT_ROLES_.map(aiAgentRingkas_);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// data.agents = { jaya: {key, model, hapus}, rehan: {key, model, rpm, rpd, hapus}, budi: {...} }
// key kosong = tidak diubah. hapus:true = key agent dihapus.
function saveAIApiKeys(data) {
  return withTransaction(data.email, null, 'token', function () {
    var result = { success: false };
    integrasiWajibOwner_(data.email);
    var input = data.agents || {}, p = PropertiesService.getScriptProperties(), diubah = [], peringatan = [];
    AI_AGENT_ROLES_.forEach(function (role) {
      var x = input[role]; if (!x) return;
      var def = aiAgentDef_(role);
      if (x.hapus === true) { p.deleteProperty(def.propKey); p.deleteProperty(def.propKey + '_PROVIDER'); p.deleteProperty(def.propKey + '_BASEURL'); diubah.push(def.nama + ': key dihapus'); return; }
      if (x.provider != null) {
        var prov = aiNormalProvider_(x.provider); // '' / 'auto' = deteksi otomatis dari awalan key
        if (prov) p.setProperty(def.propKey + '_PROVIDER', prov); else p.deleteProperty(def.propKey + '_PROVIDER');
        diubah.push(def.nama + ': provider ' + (prov ? aiProviderLabel_(prov) : 'otomatis'));
      }
      if (x.baseUrl != null) {
        var baseU = aiBaseUrlBersih_(x.baseUrl);
        if (baseU && !/^https:\/\/[^\s]+$/i.test(baseU)) throw new Error('Base URL ' + def.nama + ' harus diawali https://');
        if (baseU) p.setProperty(def.propKey + '_BASEURL', baseU); else p.deleteProperty(def.propKey + '_BASEURL');
      }
      var key = String(x.key || '').replace(/\s+/g, '');
      if (key) {
        // Format key Google bisa berbeda-beda (mis. "AIza..." atau format baru yang mengandung titik), jadi yang ditolak
        // hanya isian yang jelas rusak: terlalu pendek, atau berisi karakter non-ASCII (mis. "•" hasil salin key tersamar).
        // Keabsahan key yang sebenarnya dicek lewat Test Connection ke Google.
        if (key.length < 20 || key.length > 512) throw new Error('API key ' + def.nama + ' terlalu ' + (key.length < 20 ? 'pendek' : 'panjang') + ' - salin ulang dari dashboard provider.');
        if (!/^[\x21-\x7E]+$/.test(key)) throw new Error('API key ' + def.nama + ' berisi karakter yang tidak valid (mungkin tersalin "•" dari key tersamar) - salin ulang dari dashboard provider.');
        p.setProperty(def.propKey, key); diubah.push(def.nama + ': key baru');
      }
      if (x.model != null) {
        var model = String(x.model || '').trim();
        // Nama model bebas (mis. gemini-2.5-pro, claude-sonnet-4-5, gpt-4.1-mini, meta-llama/llama-3.3-70b:free, model@versi)
        if (model && !/^[A-Za-z0-9][\w.\-\/:@+]{1,150}$/.test(model)) throw new Error('Nama model ' + def.nama + ' berisi karakter yang tidak valid.');
        if (model && model !== def.modelDefault) p.setProperty(def.propModel, model); else p.deleteProperty(def.propModel);
      }
      if (role === 'rehan') {
        [['rpm', 'GEMINI_FREE_RPM', 1, 1000], ['rpd', 'GEMINI_FREE_RPD', 1, 100000]].forEach(function (b) {
          if (x[b[0]] == null || x[b[0]] === '') return;
          var n = parseInt(x[b[0]], 10);
          if (!(n >= b[2] && n <= b[3])) throw new Error('Batas ' + b[0].toUpperCase() + ' Rehan harus ' + b[2] + '-' + b[3] + '.');
          p.setProperty(b[1], String(n));
        });
      }
    });
    AI_AGENT_ROLES_.forEach(function (role) {
      var a = aiAgentKey_(role);
      if (a.key && a.provider !== 'gemini' && !a.model) peringatan.push(aiAgentDef_(role).nama + ': provider ' + aiProviderLabel_(a.provider) + ' perlu nama model - isi kolom Model.');
      if (a.key && a.provider === 'custom' && !a.baseUrl) peringatan.push(aiAgentDef_(role).nama + ': provider kustom perlu Base URL.');
    });
    try { CacheService.getScriptCache().remove(AIW_CACHE_HEALTH_); } catch (e) { }
    result.diubah = diubah; result.peringatan = peringatan;
    result.agents = AI_AGENT_ROLES_.map(aiAgentRingkas_);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// Tes koneksi: cek key + model ke Google (GET models/<model>) - TIDAK memakai kuota generate.
// data.key / data.model opsional = uji isian yang belum disimpan; kosong = uji yang tersimpan.
function testAIApiKey(data) {
  var result = { success: false };
  try {
    integrasiWajibOwner_(data.email);
    var role = String(data.role || ''), def = aiAgentDef_(role);
    if (!def) throw new Error('Agent tidak dikenal.');
    var cfgUji = aiCfgUji_(role, data), pakai = cfgUji.pakai;
    var keyUji = cfgUji.key, modelUji = cfgUji.model;
    if (!keyUji) throw new Error('Key ' + def.nama + ' belum diisi.');
    var hasilTes = aiTesKoneksi_(cfgUji);
    var ok = hasilTes.ok, pesan = hasilTes.pesan, ms = hasilTes.ms;
    var dariTersimpan = keyUji === pakai.key && modelUji === pakai.model && cfgUji.provider === pakai.provider && cfgUji.baseUrl === pakai.baseUrl;
    if (dariTersimpan) {
      var semua = aiAgentStatusSemua_();
      semua[role] = { ok: ok, ms: ms, pesan: pesan, model: modelUji, keyCek: aiSidikKey_(keyUji),
        waktu: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm') };
      PropertiesService.getScriptProperties().setProperty('AI_AGENT_STATUS', JSON.stringify(semua));
      try { CacheService.getScriptCache().remove(AIW_CACHE_HEALTH_); } catch (e) { }
    }
    result.ok = ok; result.pesan = pesan; result.ms = ms; result.belumDisimpan = !dariTersimpan;
    result.provider = cfgUji.provider; result.providerLabel = aiProviderLabel_(cfgUji.provider);
    result.agent = aiAgentRingkas_(role);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

