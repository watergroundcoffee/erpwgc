function prosesCariProduk(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice') && !cekIzin(data.email, 'mintaStock')) {
      throw new Error('Anda tidak punya izin untuk aksi ini.');
    }
    var sku = String(data.sku || '').trim().toUpperCase();
    if (!sku) throw new Error('SKU kosong');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var values = sh.getRange(2, 1, lastRow - 1, 3).getValues();
      for (var i = 0; i < values.length; i++) {
        if (String(values[i][0]).trim().toUpperCase() === sku) {
          result.success = true;
          result.ditemukan = true;
          result.namaProduk = values[i][1];
          result.harga = values[i][2];
          result.arsip = !!katPetaArsip_(data.toko)[String(values[i][0]).trim()];
          return result;
        }
      }
    }
    result.success = true;
    result.ditemukan = false; // SKU tidak ada di Master Produk, biarkan diisi manual di frontend
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function buatNomorInvoice(shHeader) {
  var existing = {};
  var lastRow = shHeader.getLastRow();
  if (lastRow > 1) {
    var vals = shHeader.getRange(2, 1, lastRow - 1, 1).getValues();
    for (var i = 0; i < vals.length; i++) existing[String(vals[i][0])] = true;
  }

  var kode, upaya = 0;
  do {
    var huruf = '';
    for (var h = 0; h < 2; h++) {
      huruf += String.fromCharCode(65 + Math.floor(Math.random() * 26));
    }
    var angka = Math.floor(Math.random() * 10000);
    var angkaStr = ('0000' + angka).slice(-4);
    kode = huruf + angkaStr;
    upaya++;
  } while (existing[kode] && upaya < 50);

  return kode;
}

// Tanggal transaksi lampau (backdate) -> Date jam 12:00 di zona skrip, atau null kalau hari ini / tidak diisi
function pjTanggalLampau_(data) {
  var s = String((data && data.tanggalTransaksi) || '').trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return null;
  var tz = Session.getScriptTimeZone();
  var hariIni = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  if (s > hariIni) throw new Error('Tanggal transaksi tidak boleh di masa depan');
  if (s === hariIni) return null;
  if (s < '2015-01-01') throw new Error('Tanggal transaksi terlalu lama - cek lagi');
  return new Date(Utilities.parseDate(s, tz, 'yyyy-MM-dd').getTime() + 12 * 3600000);
}
// Minta trigger rekap 10 menit menghitung ulang rekap harian sampai tanggal lampau tsb (omzet Beranda & Finance)
function pjMintaRekapMundur_(tanggal) {
  try {
    var hari = Math.ceil((Date.now() - tanggal.getTime()) / 86400000) + 2;
    var props = PropertiesService.getScriptProperties();
    var ada = Number(props.getProperty('REKAP_PERLU_MUNDUR') || 0);
    if (hari > ada) props.setProperty('REKAP_PERLU_MUNDUR', String(Math.min(hari, 4000)));
  } catch (e) { }
}

function prosesBuatInvoice(data) {
  var result = { success: false };
  var lampauAwal = null;
  try { lampauAwal = pjTanggalLampau_(data); } catch (eTgl) { return { success: false, error: String(eTgl.message || eTgl) }; }
  var lock = kunciModul_(lampauAwal && data.sudahSelesai !== false ? ['penjualan', 'stok'] : 'penjualan');
  try {
    lock.waitLock(15000);
  } catch (lockErr) {
    result.error = 'Sistem sedang sibuk, coba lagi.';
    return result;
  }

  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk membuat invoice.');
    var namaStaff = getNamaStaff(data.email);

    var namaPenerima = String(data.namaPenerima || '').trim();
    var alamat = String(data.alamat || '').trim();
    var noHp = formatNoHpIntl_(String(data.noHp || '').trim());
    var namaPembeli = String(data.namaPembeli || '').trim() || namaPenerima; // default sama kalau nggak diisi beda
    var noHpPembeli = formatNoHpIntl_(String(data.noHpPembeli || '').trim()) || noHp;
    var items = data.items || [];
    var ongkosKirim = parseFloat(data.ongkosKirim) || 0;
    var biayaLainnya = parseFloat(data.biayaLainnya) || 0;
    var diskon = parseFloat(data.diskon) || 0;
    var pajak = parseFloat(data.pajak) || 0;
    var kurir = String(data.kurir || '').trim();

    if (!namaPenerima) throw new Error('Nama penerima kosong');
    if (!alamat) throw new Error('Alamat kosong');
    if (items.length === 0) throw new Error('Belum ada produk ditambahkan');

    // Barang boleh TANPA SKU (nama saja) - SKU bisa diisi belakangan lewat Edit Pesanan.
    // Barang tanpa SKU tidak memotong stok saat resi discan (dilewati otomatis).
    items = items.map(function (item) {
      return { sku: String(item.sku || '').trim(), nama: String(item.nama || '').trim() || String(item.sku || '').trim(), qty: parseInt(item.qty, 10) || 0, harga: parseFloat(item.harga) || 0 };
    }).filter(function (item) { return item.nama && item.qty > 0; });
    if (items.length === 0) throw new Error('Belum ada produk yang valid (nama & qty)');
    if (diskon < 0) throw new Error('Diskon tidak boleh minus');

    var sheets = getPesananManualSheets();
    var subtotalProduk = 0;
    items.forEach(function (item) {
      subtotalProduk += (parseFloat(item.harga) || 0) * (parseInt(item.qty, 10) || 0);
    });
    var total = subtotalProduk + ongkosKirim + biayaLainnya - diskon + pajak;

    // No Invoice dibuat di HP (supaya invoice & label bisa langsung tampil sebelum tersimpan).
    // Kirim ulang (sinyal putus / klik dobel) dengan No Invoice yang sama -> TIDAK disimpan dobel.
    var noInvoice = '', lastRowH = sheets.header.getLastRow();
    var noDiminta = String(data.noInvoice || '').trim().toUpperCase();
    if (/^[A-Z]{2}\d{4}$/.test(noDiminta)) {
      var barisAda = -1;
      if (lastRowH > 1) {
        var semuaNo = sheets.header.getRange(2, 1, lastRowH - 1, 1).getValues();
        for (var ni = semuaNo.length - 1; ni >= 0; ni--) if (String(semuaNo[ni][0]).trim().toUpperCase() === noDiminta) { barisAda = ni + 2; break; }
      }
      if (barisAda > 0) {
        var ada = sheets.header.getRange(barisAda, 1, 1, 10).getValues()[0];
        if (String(ada[2]).trim() === namaPenerima && Math.abs((parseFloat(ada[9]) || 0) - total) < 1) {
          return { success: true, duplikat: true, noInvoice: noDiminta, total: total, subtotalProduk: subtotalProduk, ongkosKirim: ongkosKirim, biayaLainnya: biayaLainnya, kurir: kurir,
            tanggal: ada[1] instanceof Date ? Utilities.formatDate(ada[1], Session.getScriptTimeZone(), 'dd MMMM yyyy, HH:mm') : String(ada[1]) };
        }
        noInvoice = buatNomorInvoice(sheets.header); // kode sama dipakai invoice lain (sangat jarang) -> buat kode baru
      } else noInvoice = noDiminta;
    } else {
      noInvoice = buatNomorInvoice(sheets.header);
    }

    var tanggal = new Date();
    var wDibuat = parseFloat(data.waktuDibuat);
    if (wDibuat > 0 && wDibuat <= Date.now() + 120000 && wDibuat > Date.now() - 3 * 86400000) tanggal = new Date(Math.min(wDibuat, Date.now()));
    // PENJUALAN LAMPAU (backdate): tanggal invoice = tanggal yang dipilih. Kalau ditandai sudah selesai,
    // status langsung "Selesai" & stok dipotong di Stock Ledger PADA TANGGAL ITU (urutan kronologis),
    // sehingga omzet, HPP & kartu stok masuk ke periode yang benar.
    var lampau = lampauAwal;
    var lampauSelesai = !!lampau && data.sudahSelesai !== false;
    if (lampau) tanggal = lampau;

    // Simpan header invoice
    if (!sheets.header.getRange(1, 13).getValue()) {
      sheets.header.getRange(1, 13).setValue('Dibuat Oleh').setFontWeight('bold');
    }
    if (!sheets.header.getRange(1, 14).getValue()) {
      sheets.header.getRange(1, 14).setValue('Diskon').setFontWeight('bold');
      sheets.header.getRange(1, 15).setValue('Pajak (VAT)').setFontWeight('bold');
    }
    var headerRow = sheets.header.getLastRow() + 1;
    sheets.header.getRange(headerRow, 1).setNumberFormat('@'); // No Invoice tetap teks
    sheets.header.getRange(headerRow, 11).setNumberFormat('@'); // No Resi tetap teks
    sheets.header.getRange(headerRow, 1, 1, 12).setValues([[
      noInvoice, tanggal, namaPenerima, alamat, noHp, kurir, subtotalProduk, ongkosKirim, biayaLainnya, total, '', lampauSelesai ? 'Selesai' : ''
    ]]);
    if (lampauSelesai) sheets.header.getRange(headerRow, 19).setValue(tanggal); // Tanggal Jadi Selesai
    sheets.header.getRange(headerRow, 13).setValue(namaStaff);
    sheets.header.getRange(headerRow, 14, 1, 2).setValues([[diskon, pajak]]);
    sheets.header.getRange(headerRow, 16, 1, 2).setValues([[namaPembeli, noHpPembeli]]);
    sheets.header.getRange(headerRow, 18).setValue(data.toko || 'Waterground');

    // Simpan rincian barang
    var detailStartRow = sheets.detail.getLastRow() + 1;
    var detailRows = items.map(function (item) {
      return [noInvoice, item.sku, item.nama, item.qty, item.harga];
    });
    sheets.detail.getRange(detailStartRow, 1, detailRows.length, 5).setNumberFormat('@');
    sheets.detail.getRange(detailStartRow, 1, detailRows.length, 5).setValues(detailRows);

    // Simpan/perbarui data PEMBELI (bukan penerima) otomatis - biar CRM Kontak Pelanggan
    // ngelacak yang beneran belanja, bukan cuma alamat kirimnya doang.
    simpanAtauUpdatePembeli(namaPembeli, alamat, noHpPembeli);

    if (lampauSelesai) {
      var barisLedger = items.filter(function (it) { return it.sku && it.qty > 0; }).map(function (it) {
        return [tanggal, it.sku, 'Terjual PO Sales', it.qty, 'Penjualan lampau (backdate) ' + noInvoice + ' - ' + namaPembeli, namaStaff || data.email || ''];
      });
      if (barisLedger.length) { sisipkanLedgerKronologis_(getStockLedgerSheet(), barisLedger, 6); hitungUlangSaldoStok_(); try { smInvalidasiCache(); } catch (eS) { } }
      pjMintaRekapMundur_(tanggal);
      try { finInvalidasi_(); } catch (eF) { }
      result.backdate = true;
      result.stokDipotong = barisLedger.length;
    }


    result.success = true;
    result.noInvoice = noInvoice;
    result.status = lampauSelesai ? 'Selesai' : '';
    result.noInvoiceBerubah = !!noDiminta && noDiminta !== noInvoice;
    result.tanggal = Utilities.formatDate(tanggal, Session.getScriptTimeZone(), 'dd MMMM yyyy, HH:mm');
    result.subtotalProduk = subtotalProduk;
    result.ongkosKirim = ongkosKirim;
    result.biayaLainnya = biayaLainnya;
    result.diskon = diskon;
    result.total = total;
    result.kurir = kurir;
  } catch (err) {
    result.error = err.toString();
  } finally {
    lepasKunci_(lock);
  }
  return result;
}

/* ============ DAFTAR PESANAN: lihat, kirim, batal ============ */
/* ===== PESANAN MANUAL: cache daftar + batal otomatis 7 hari =====
   Daftar lengkap disimpan di cache (gzip, dipecah) selama PM_CACHE_DETIK dan DIBUANG setiap ada
   penulisan pesanan manual (buat / ubah / kirim / batal), jadi data yang tampil selalu terbaru.
   Urutan pasti: waktu dibuat (timestamp) terbaru dulu, lalu nomor baris - pesanan yang dibuat pada
   detik yang sama oleh beberapa staff tetap berurutan sesuai urutan masuknya ke Sheets. */
var PM_CACHE_KUNCI = 'PM_DAFTAR_V3';
var PM_CACHE_DETIK = 300;
var PM_AUTO_BATAL_HARI = 7;
var PM_AUTO_BATAL_ALASAN = 'Otomatis: tidak diproses dalam 7 hari';

function pmInvalidasiCache_() {
  try { CacheService.getScriptCache().removeAll([PM_CACHE_KUNCI + '__meta']); } catch (e) {}
}

// Cari baris pesanan berdasarkan No Invoice (baris dari browser bisa usang setelah ada baris yang dihapus)
function pmCariBaris_(sh, rowPerkiraan, noInvoice) {
  var no = String(noInvoice || '').trim(), lr = sh.getLastRow();
  if (!no || lr < 2) return 0;
  var r = parseInt(rowPerkiraan, 10);
  if (r >= 2 && r <= lr && String(sh.getRange(r, 1).getValue()).trim() === no) return r;
  var vals = sh.getRange(2, 1, lr - 1, 1).getValues();
  for (var i = vals.length - 1; i >= 0; i--) if (String(vals[i][0]).trim() === no) return i + 2;
  return 0;
}
function getLogHapusPesananSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName('Log Hapus Pesanan');
  if (!sh) { sh = ss.insertSheet('Log Hapus Pesanan'); sh.getRange(1, 1, 1, 6).setValues([['Waktu Hapus', 'No Invoice', 'Penerima', 'Total', 'Dihapus Oleh', 'Salinan Data (JSON)']]).setFontWeight('bold'); }
  return sh;
}
function pmBolehHapusPermanen_(email) {
  var staff = getStaffByEmail(email);
  return cekIzin(email, 'batalPesanan') || !!(staff && staff.role === 'Owner');
}
// Hapus baris header + detail untuk sekumpulan No Invoice (yang SUDAH Dibatalkan). Salinan disimpan di log.
function pmHapusInvoiceDibatalkan_(sheets, daftarNo, oleh, batasWaktu) {
  var sh = sheets.header, tz = Session.getScriptTimeZone(), lr = sh.getLastRow();
  var target = {}; daftarNo.forEach(function (n) { target[String(n).trim()] = 1; });
  var lebar = Math.min(22, sh.getMaxColumns());
  var vals = lr > 1 ? sh.getRange(2, 1, lr - 1, lebar).getValues() : [];
  var barisH = [], salinan = {};
  vals.forEach(function (r, i) {
    var no = String(r[0]).trim();
    if (!target[no] || String(r[11]).trim() !== 'Dibatalkan') return;
    barisH.push(i + 2);
    salinan[no] = { header: r.map(function (v) { return v instanceof Date ? Utilities.formatDate(v, tz, 'yyyy-MM-dd HH:mm:ss') : v; }), detail: [] };
  });
  if (!barisH.length) return { dihapus: 0, nomor: [] };
  var lrD = sheets.detail.getLastRow(), barisD = [];
  if (lrD > 1) sheets.detail.getRange(2, 1, lrD - 1, 5).getValues().forEach(function (r, i) {
    var no = String(r[0]).trim();
    if (salinan[no]) { barisD.push(i + 2); salinan[no].detail.push(r.slice(1)); }
  });
  // 1) Log dulu (jaga-jaga)
  var log = getLogHapusPesananSheet_(), waktu = new Date();
  var barisLog = Object.keys(salinan).map(function (no) { var h = salinan[no].header; return [waktu, no, h[2], h[9], oleh, JSON.stringify(salinan[no]).slice(0, 49000)]; });
  log.getRange(log.getLastRow() + 1, 1, barisLog.length, 6).setValues(barisLog);
  // 2) Hapus per blok berurutan dari bawah ke atas
  function hapusBlok(shX, rows) {
    rows.sort(function (a, b) { return b - a; });
    var k = 0;
    while (k < rows.length) {
      if (batasWaktu && Date.now() > batasWaktu) throw new Error('WAKTU_HABIS');
      var akhir = rows[k], awal = akhir;
      while (k + 1 < rows.length && rows[k + 1] === awal - 1) { k++; awal--; }
      shX.deleteRows(awal, akhir - awal + 1);
      k++;
    }
  }
  hapusBlok(sheets.detail, barisD);
  hapusBlok(sh, barisH);
  return { dihapus: barisH.length, nomor: Object.keys(salinan) };
}

// ===== AKSI: hapus_permanen_pesanan { row, noInvoice } - hanya pesanan yang SUDAH Dibatalkan =====
function prosesHapusPermanenPesanan(data) {
  return withTransaction(data.email, null, 'penjualan', function () {
    var result = { success: false };
    if (!pmBolehHapusPermanen_(data.email)) throw new Error('Hapus permanen hanya untuk Owner / staff yang boleh membatalkan pesanan.');
    var no = String(data.noInvoice || '').trim();
    if (!no) throw new Error('No Invoice kosong');
    var sheets = getPesananManualSheets();
    var row = pmCariBaris_(sheets.header, data.row, no);
    if (!row) { result.success = true; result.sudahTerhapus = true; return result; } // kirim ulang -> sudah tidak ada
    if (String(sheets.header.getRange(row, 12).getValue()).trim() !== 'Dibatalkan') throw new Error('Batalkan pesanan dulu sebelum hapus permanen.');
    var h = pmHapusInvoiceDibatalkan_(sheets, [no], getNamaStaff(data.email) || data.email || '');
    result.success = true;
    result.dihapus = h.dihapus;
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.'
  });
}

// ===== AKSI: hapus_pesanan_batal_massal { mode: 'dobel' | 'semua' } - bersihkan pesanan yang sudah dibatalkan =====
function prosesHapusPesananBatalMassal(data) {
  return withTransaction(data.email, null, 'penjualan', function () {
    var result = { success: false };
    if (!pmBolehHapusPermanen_(data.email)) throw new Error('Hanya Owner / staff yang boleh membatalkan pesanan.');
    var sheets = getPesananManualSheets(), sh = sheets.header, lr = sh.getLastRow();
    var lebar = Math.min(22, sh.getMaxColumns());
    var daftar = [];
    if (lr > 1) sh.getRange(2, 1, lr - 1, lebar).getValues().forEach(function (r) {
      if (String(r[11]).trim() !== 'Dibatalkan') return;
      var alasan = lebar >= 20 ? String(r[19] || '') : '';
      if (data.mode === 'dobel' && !/dua kali|dobel|double|ganda/i.test(alasan)) return;
      daftar.push(String(r[0]).trim());
    });
    var h = { dihapus: 0 };
    if (daftar.length) {
      try { h = pmHapusInvoiceDibatalkan_(sheets, daftar.slice(0, 400), getNamaStaff(data.email) || data.email || '', Date.now() + 4 * 60 * 1000); }
      catch (eW) { if (String(eW.message || eW).indexOf('WAKTU_HABIS') === -1) throw eW; result.belumSelesai = true; }
    }
    result.success = true;
    result.dihapus = h.dihapus || 0;
    result.sisa = Math.max(0, daftar.length - (h.dihapus || 0));
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.'
  });
}

function pmUrutkan_(items) {
  return items.sort(function (a, b) { return (b.tanggalMs - a.tanggalMs) || (b.row - a.row); });
}

// Pesanan Offline/PO Sales yang masih "Belum Dikirim" lebih dari 7 hari -> otomatis Dibatalkan.
// Dijalankan paling sering 1x per 30 menit (dipicu saat daftar dibuka), bisa juga dipasang sebagai trigger harian.
function autoBatalPesananManualKadaluarsa_(paksa) {
  var cache = CacheService.getScriptCache();
  if (!paksa && cache.get('PM_AUTO_BATAL_CEK')) return 0;
  cache.put('PM_AUTO_BATAL_CEK', '1', 1800);
  var lock = kunciModul_('penjualan');
  try { lock.waitLock(5000); } catch (e) { return 0; }
  var jumlah = 0;
  try {
    var sh = getPesananManualSheets().header;
    var lastRow = sh.getLastRow();
    if (lastRow < 2) return 0;
    var batasMs = Date.now() - PM_AUTO_BATAL_HARI * 24 * 3600 * 1000;
    var vals = sh.getRange(2, 1, lastRow - 1, 23).getValues(); // v2026.10.48: kolom 23 = Dihidupkan Lagi
    var sekarang = new Date();
    for (var i = 0; i < vals.length; i++) {
      var status = String(vals[i][11] || '').trim();
      if (!String(vals[i][0] || '').trim() || !(vals[i][1] instanceof Date)) continue;
      if (status && status !== 'Belum Dikirim' && status !== 'Menunggu') continue; // Dikirim / Selesai / Dibatalkan: lewati
      if (vals[i][1].getTime() >= batasMs) continue;
      if (p13SudahLunas_(String(vals[i][0] || '').trim())) continue; // v2026.10.26: sudah lunas -> jangan dibatalkan otomatis
      if (String(vals[i][22] || '').trim()) continue; // v2026.10.48 (DN-398): pesanan yang sengaja dihidupkan lagi tidak dibatalkan otomatis
      if (!sh.getRange(1, 20).getValue()) sh.getRange(1, 20, 1, 3).setValues([['Alasan Batal', 'Dibatalkan Pada', 'Dibatalkan Oleh']]).setFontWeight('bold');
      sh.getRange(i + 2, 12).setValue('Dibatalkan');
      sh.getRange(i + 2, 20, 1, 3).setValues([[PM_AUTO_BATAL_ALASAN, sekarang, 'Sistem']]);
      jumlah++;
    }
    if (jumlah) { SpreadsheetApp.flush(); pmInvalidasiCache_(); }
  } catch (err) {
    Logger.log('Auto batal pesanan manual gagal: ' + err);
  } finally { lepasKunci_(lock); }
  return jumlah;
}

// Pasang sebagai trigger harian (opsional): Edit > Triggers > jalankanAutoBatalPesananManual, time-driven, harian
function jalankanAutoBatalPesananManual() {
  var n = autoBatalPesananManualKadaluarsa_(true);
  Logger.log(n + ' pesanan manual dibatalkan otomatis.');
}

function prosesLihatPesanan(data) {
  var result = { success: false };
  try {
    var email = data.email || '';
    var bolehLihatHarga = cekIzin(email, 'buatInvoice');
    var bolehLihatLabelSaja = cekIzin(email, 'printLabel');
    if (!bolehLihatHarga && !bolehLihatLabelSaja) throw new Error('Anda tidak punya izin untuk melihat daftar pesanan.');

    try { autoBatalPesananManualKadaluarsa_(false); } catch (eAuto) {}
    try { p13SapuLunasSelesai_(false); } catch (eSapu) {}

    var dariCache = cacheBesarGet_(PM_CACHE_KUNCI);
    if (dariCache && dariCache.items) {
      var itemsC = dariCache.items.map(function (it) {
        var salin = {};
        for (var k in it) if (it.hasOwnProperty(k)) salin[k] = it[k];
        if (!bolehLihatHarga) delete salin.total;
        return salin;
      });
      result.success = true;
      result.items = data.semua ? itemsC : itemsC.slice(0, 50);
      result.bolehLihatHarga = bolehLihatHarga;
      result.dariCache = true;
      return result;
    }

    var sheets = getPesananManualSheets();
    var sh = sheets.header;
    var lastRow = sh.getLastRow();
    var items = [];

    if (lastRow > 1) {
      var lebarPm = Math.min(22, sh.getMaxColumns());
      var values = sh.getRange(2, 1, lastRow - 1, lebarPm).getValues();
      for (var i = 0; i < values.length; i++) {
        var noInvoice = String(values[i][0] || '').trim();
        if (!noInvoice) continue;
        var item = {
          row: i + 2,
          noInvoice: noInvoice,
          tanggal: values[i][1] instanceof Date
            ? Utilities.formatDate(values[i][1], Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm')
            : String(values[i][1] || ''),
          namaPenerima: values[i][2],
          noResi: resiTeks_(values[i][10], values[i][5]),
          status: values[i][11],
          toko: values[i][17] || 'Waterground',
          tanggalMs: values[i][1] instanceof Date ? values[i][1].getTime() : 0,
          hp: String(values[i][4] || ''), kurir: String(values[i][5] || ''), alamat: String(values[i][3] || ''),
          namaPembeli: String(values[i][15] || ''), hpPembeli: String(values[i][16] || ''),
          alasanBatal: lebarPm >= 20 ? String(values[i][19] || '') : ''
        };
        item.total = values[i][9];
        items.push(item);
      }
    }

    try { var petaPk = pkPeta_(); items.forEach(function (it) { var k = petaPk[it.noInvoice]; if (k) { if (k.bayar) it.bayarDiterima = k.bayar; if (k.kurir) it.kurirToko = k.kurir; } }); } catch (ePk) { }
    pmUrutkan_(items); // terbaru duluan (timestamp, lalu baris)
    cacheBesarPut_(PM_CACHE_KUNCI, { items: items }, PM_CACHE_DETIK);
    if (!bolehLihatHarga) items.forEach(function (it) { delete it.total; }); // harga hanya untuk yang berizin
    result.success = true;
    // data.semua = true dipakai Transaksi Penjualan & Laporan (butuh SEMUA pesanan, bukan 50 terakhir)
    result.items = data.semua ? items : items.slice(0, 50);
    result.bolehLihatHarga = bolehLihatHarga;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesKirimPesanan(data) {
  var row, noResi;
  return withTransaction(data.email, 'kirimResi', 'penjualan', function () {
    var result = { success: false };
    var sheets = getPesananManualSheets();
    var sh = sheets.header;
    if (row > sh.getLastRow()) throw new Error('Baris sudah tidak ada');

    var noInv = String(sh.getRange(row, 1).getValue() || '').trim();
    if (data.noInvoice && noInv !== String(data.noInvoice).trim()) throw new Error('Baris pesanan bergeser - muat ulang daftar lalu coba lagi.');
    tulisResiTeks_(sh.getRange(row, 11), noResi);
    sh.getRange(row, 12).setValue('Dikirim');
    // S2: stok keluar saat Dikirim (tidak lagi menunggu scan resi - mencegah stok "hantu" Kurir Toko)
    try { result.stokDipotong = poTulisKeluarDikirim_(noInv, new Date(), getNamaStaff(data.email) || data.email || '', 'Dikirim'); } catch (eS) { result.peringatanStok = String(eS.message || eS); }
    result.status = p13SelesaiBilaLunas_(sh, row, noInv) ? 'Selesai' : 'Dikirim'; // v2026.10.26 (DN-703)
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.',
    pesanTanpaIzin: 'Anda tidak punya izin untuk mengirim pesanan.',
    validasi: function () {
      row = parseInt(data.row, 10);
      noResi = String(data.noResi || '').trim();
      if (!row || row < 2) throw new Error('Baris tidak valid');
      if (!noResi) throw new Error('No Resi kosong');
    }
  });
}

function prosesBatalPesanan(data) {
  var row;
  return withTransaction(data.email, 'batalPesanan', 'penjualan', function () {
    var result = { success: false };
    var sheets = getPesananManualSheets();
    var sh = sheets.header;
    if (row > sh.getLastRow()) throw new Error('Baris sudah tidak ada');

    var alasan = String(data.alasan || '').trim();
    if (data.wajibAlasan && !alasan) throw new Error('Alasan pembatalan wajib diisi.');
    if (data.noInvoice) {
      row = pmCariBaris_(sh, row, data.noInvoice); // baris bisa bergeser setelah ada pesanan yang dihapus permanen
      if (!row) throw new Error('Pesanan ' + data.noInvoice + ' tidak ditemukan (mungkin sudah dihapus).');
    }
    if (String(sh.getRange(row, 12).getValue()).trim() === 'Dibatalkan') { result.success = true; result.sudahBatal = true; return result; } // kirim ulang -> tidak dobel
    // v2026.10.26 (DN-261019-115301-703): pesanan yang sudah ditandai LUNAS tidak bisa dibatalkan
    var noBatal_ = String(sh.getRange(row, 1).getValue() || '').trim();
    if (p13SudahLunas_(noBatal_)) throw new Error('Pesanan ' + noBatal_ + ' sudah ditandai LUNAS - tidak bisa dibatalkan. Bila salah klik, Owner bisa membatalkan tanda lunas dulu di detail pesanan.');

    // Ditandai batal saja, TIDAK dihapus dari Sheets. Alasan + waktu + pembatal dicatat di kolom 20-22.
    if (!sh.getRange(1, 20).getValue()) sh.getRange(1, 20, 1, 3).setValues([['Alasan Batal', 'Dibatalkan Pada', 'Dibatalkan Oleh']]).setFontWeight('bold');
    var statusSebelum = String(sh.getRange(row, 12).getValue()).trim();
    sh.getRange(row, 12).setValue('Dibatalkan');
    sh.getRange(row, 20, 1, 3).setValues([[alasan, new Date(), getNamaStaff(data.email) || data.email || '']]);
    // S2: pesanan Dikirim yang dibatalkan SEBELUM resinya discan -> potongan otomatis "Dikirim" dibalik
    // (tidak ada bukti fisik barang keluar). Kalau sudah discan, barang dianggap keluar -> lewat alur Retur.
    if (SM_STATUS_PO_KELUAR[statusSebelum]) {
      try { result.stokDikembalikan = poBalikPotonganDikirim_(String(sh.getRange(row, 1).getValue() || '').trim(), getNamaStaff(data.email) || data.email || ''); } catch (eB) { }
    }
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.',
    pesanTanpaIzin: 'Anda tidak punya izin untuk membatalkan pesanan.',
    validasi: function () {
      row = parseInt(data.row, 10);
      if (!row || row < 2) throw new Error('Baris tidak valid');
    }
  });
}

// No HP disamakan: cuma angka, awalan 62 -> 0 (0812.. == +62812.. == 62812..)
// No HP disamakan ke "inti" nomor: angka saja, tanpa awalan 62 / 0.
// (Sheets sering menyimpan No HP sebagai ANGKA -> 0 di depan hilang: 0812.. jadi 812..)
function pmNormHp_(v) {
  var d = String(v == null ? '' : v).replace(/\D/g, '');
  if (d.indexOf('62') === 0) d = d.slice(2);
  d = d.replace(/^0+/, '');
  return d.length >= 6 ? d : '';
}

// ===== AKSI: riwayat_pesanan_pembeli - pesanan manual sebelumnya dari 1 pembeli (untuk Repeat Order)
// Dicocokkan lewat No HP (pembeli / penerima); kalau No HP kosong, lewat nama.
function prosesRiwayatPesananPembeli(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk melihat riwayat pesanan.');
    var hp = pmNormHp_(data.noHp);
    var nama = String(data.nama || '').trim().toLowerCase();
    if (!hp && !nama) throw new Error('Nama / No HP pembeli kosong');
    var batas = Math.min(parseInt(data.batas, 10) || 20, 50);

    var sheets = getPesananManualSheets();
    var sh = sheets.header;
    var lastRow = sh.getLastRow();
    var cocok = [];
    var tz = Session.getScriptTimeZone();
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, Math.min(20, sh.getMaxColumns())).getValues();
      for (var i = vals.length - 1; i >= 0 && cocok.length < batas; i--) {
        var r = vals[i];
        var noInv = String(r[0] || '').trim();
        if (!noInv) continue;
        var hpBaris = [pmNormHp_(r[16]), pmNormHp_(r[4])];
        var namaBaris = [String(r[15] || '').trim().toLowerCase(), String(r[2] || '').trim().toLowerCase()];
        // Cocok kalau No HP sama ATAU nama sama persis (tidak peka huruf besar/kecil)
        var sama = (hp && hpBaris.indexOf(hp) !== -1) || (nama && namaBaris.indexOf(nama) !== -1);
        if (!sama) continue;
        cocok.push({
          row: i + 2, noInvoice: noInv,
          tanggal: r[1] instanceof Date ? Utilities.formatDate(r[1], tz, 'dd MMM yyyy, HH:mm') : String(r[1] || ''),
          namaPenerima: String(r[2] || ''), alamat: String(r[3] || ''), noHp: String(r[4] || ''),
          kurir: String(r[5] || ''), subtotal: Number(r[6]) || 0, ongkosKirim: Number(r[7]) || 0,
          biayaLainnya: Number(r[8]) || 0, total: Number(r[9]) || 0, status: String(r[11] || '') || 'Belum Dikirim',
          tanggalMs: r[1] instanceof Date ? r[1].getTime() : 0,
          alasanBatal: r.length > 19 ? String(r[19] || '') : '', items: []
        });
      }
    }

    if (cocok.length) {
      var peta = {};
      cocok.forEach(function (o) { peta[o.noInvoice] = o; });
      var lrD = sheets.detail.getLastRow();
      if (lrD > 1) {
        sheets.detail.getRange(2, 1, lrD - 1, 5).getValues().forEach(function (d) {
          var o = peta[String(d[0] || '').trim()];
          if (o) o.items.push({ sku: String(d[1] || ''), nama: String(d[2] || ''), qty: parseInt(d[3], 10) || 0, harga: parseFloat(d[4]) || 0 });
        });
      }
    }
    result.success = true;
    result.items = cocok;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: laporan_penjualan_manual - daftar + total omzet pesanan manual dalam rentang tanggal
// dari/sampai: 'yyyy-MM-dd' (inklusif). Pesanan "Dibatalkan" tidak dihitung ke omzet.
function prosesLaporanPenjualanManual(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk melihat laporan penjualan.');
    try { autoBatalPesananManualKadaluarsa_(false); } catch (eAuto) {}
    var tz = Session.getScriptTimeZone();
    var hariIni = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
    var dari = /^\d{4}-\d{2}-\d{2}$/.test(String(data.dari || '')) ? String(data.dari) : hariIni;
    var sampai = /^\d{4}-\d{2}-\d{2}$/.test(String(data.sampai || '')) ? String(data.sampai) : dari;
    if (sampai < dari) { var tmp = dari; dari = sampai; sampai = tmp; }

    var sh = getPesananManualSheets().header;
    var lastRow = sh.getLastRow();
    var items = [];
    var omzet = 0, subtotal = 0, ongkir = 0, jumlahTransaksi = 0, jumlahBatal = 0, nilaiBatal = 0;
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 12).getValues();
      for (var i = vals.length - 1; i >= 0; i--) {
        var r = vals[i];
        if (!String(r[0] || '').trim() || !(r[1] instanceof Date)) continue;
        var tgl = Utilities.formatDate(r[1], tz, 'yyyy-MM-dd');
        if (tgl < dari || tgl > sampai) continue;
        var status = String(r[11] || '') || 'Belum Dikirim';
        var total = Number(r[9]) || 0;
        var batal = status === 'Dibatalkan';
        if (batal) { jumlahBatal++; nilaiBatal += total; }
        else { jumlahTransaksi++; omzet += total; subtotal += Number(r[6]) || 0; ongkir += Number(r[7]) || 0; }
        items.push({
          row: i + 2, noInvoice: String(r[0]).trim(), tanggal: Utilities.formatDate(r[1], tz, 'dd MMM yyyy, HH:mm'),
          tanggalMs: r[1].getTime(), namaPenerima: String(r[2] || ''), total: total, status: status
        });
      }
    }
    pmUrutkan_(items);
    result.success = true;
    result.dari = dari; result.sampai = sampai;
    result.items = items;
    result.ringkasan = { omzet: omzet, subtotalProduk: subtotal, ongkosKirim: ongkir, jumlahTransaksi: jumlahTransaksi, jumlahBatal: jumlahBatal, nilaiBatal: nilaiBatal };
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============ DETAIL & EDIT PESANAN ============ */
function prosesDetailPesanan(data) {
  var result = { success: false };
  try {
    var email = data.email || '';
    var bolehLihatHarga = cekIzin(email, 'buatInvoice');
    var bolehLihatLabelSaja = cekIzin(email, 'printLabel');
    if (!bolehLihatHarga && !bolehLihatLabelSaja) throw new Error('Anda tidak punya izin untuk melihat pesanan ini.');

    var row = parseInt(data.row, 10);
    if (!row || row < 2) throw new Error('Baris tidak valid');

    var sheets = getPesananManualSheets();
    var sh = sheets.header;
    if (row > sh.getLastRow()) throw new Error('Pesanan tidak ditemukan');

    var headerVals = sh.getRange(row, 1, 1, 18).getValues()[0];
    var noInvoice = String(headerVals[0] || '');

    var order = {
      row: row,
      noInvoice: noInvoice,
      tanggal: headerVals[1] instanceof Date
        ? Utilities.formatDate(headerVals[1], Session.getScriptTimeZone(), 'dd MMMM yyyy, HH:mm')
        : String(headerVals[1] || ''),
      namaPenerima: headerVals[2],
      alamat: headerVals[3],
      noHp: headerVals[4],
      kurir: headerVals[5],
      noResi: headerVals[10],
      status: headerVals[11],
      namaPembeli: headerVals[15] || headerVals[2],
      noHpPembeli: headerVals[16] || headerVals[4],
      toko: headerVals[17] || 'Waterground',
      bolehLihatHarga: bolehLihatHarga
    };

    // Data harga HANYA disertakan kalau memang punya izin - bukan cuma disembunyikan di tampilan,
    // tapi memang tidak dikirim sama sekali dari server
    if (bolehLihatHarga) {
      order.subtotalProduk = headerVals[6];
      order.ongkosKirim = headerVals[7];
      order.biayaLainnya = headerVals[8];
      order.total = headerVals[9];
      order.diskon = headerVals[13] || 0;
      order.pajak = headerVals[14] || 0;
    }

    // Ambil rincian barang dari tab Detail berdasarkan No Invoice.
    // OPTIMASI: dulu SELURUH sheet Detail (5 kolom x ribuan baris) dibaca untuk mencari 1 invoice.
    // Sekarang TextFinder melompat langsung ke baris invoice itu, lalu hanya blok baris tersebut yang dibaca.
    var items = [];
    pmBacaDetailInvoice_(sheets.detail, [noInvoice], 5).forEach(function (r) {
      var item = { sku: r[1], nama: r[2], qty: r[3] };
      if (bolehLihatHarga) item.harga = r[4];
      items.push(item);
    });
    order.items = items;

    result.success = true;
    try { var kPk = pkPeta_()[noInvoice]; if (kPk) { if (kPk.bayar) order.bayarDiterima = kPk.bayar; if (kPk.kurir) order.kurirToko = kPk.kurir; } } catch (ePk2) { }
    result.order = order;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* Baca baris tab Detail milik daftar No Invoice tertentu SAJA.
   - 1 invoice  : TextFinder (pencarian sisi server Google, tanpa memindahkan seluruh sheet ke script).
   - banyak     : baca kolom A saja (1 kolom), lalu ambil blok baris yang cocok.
   Baris yang berdekatan digabung jadi 1 pembacaan (detail 1 invoice selalu ditulis berurutan). */
function pmBacaDetailInvoice_(shDetail, daftarNo, lebar) {
  var lr = shDetail.getLastRow(), hasil = [];
  if (lr < 2 || !daftarNo || !daftarNo.length) return hasil;
  var setNo = {}, baris = [];
  daftarNo.forEach(function (n) { var k = String(n || '').trim(); if (k) setNo[k] = true; });
  var kunci = Object.keys(setNo);
  if (!kunci.length) return hasil;
  try {
    if (kunci.length === 1) {
      shDetail.getRange(2, 1, lr - 1, 1).createTextFinder(kunci[0]).matchEntireCell(true).findAll().forEach(function (rg) { baris.push(rg.getRow()); });
    } else {
      shDetail.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r, i) { if (setNo[String(r[0]).trim()]) baris.push(i + 2); });
    }
  } catch (eT) {
    baris = [];
    shDetail.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r, i) { if (setNo[String(r[0]).trim()]) baris.push(i + 2); });
  }
  if (!baris.length) return hasil;
  baris.sort(function (a, b) { return a - b; });
  var mulai = baris[0], akhir = baris[0];
  function ambil(a, b) {
    shDetail.getRange(a, 1, b - a + 1, lebar).getValues().forEach(function (r) { if (setNo[String(r[0]).trim()]) hasil.push(r); });
  }
  for (var i = 1; i < baris.length; i++) {
    if (baris[i] - akhir <= 3) { akhir = baris[i]; continue; }
    ambil(mulai, akhir); mulai = akhir = baris[i];
  }
  ambil(mulai, akhir);
  return hasil;
}

function prosesUpdatePesanan(data) {
  var row;
  return withTransaction(data.email, 'buatInvoice', 'penjualan', function () {
    var result = { success: false };
    var sheets = getPesananManualSheets();
    var sh = sheets.header;
    if (row > sh.getLastRow()) throw new Error('Pesanan tidak ditemukan');

    var namaPenerima = String(data.namaPenerima || '').trim();
    var alamat = String(data.alamat || '').trim();
    var noHp = String(data.noHp || '').trim();
    var kurir = String(data.kurir || '').trim();
    var ongkosKirim = parseFloat(data.ongkosKirim) || 0;
    var biayaLainnya = parseFloat(data.biayaLainnya) || 0;

    if (!namaPenerima) throw new Error('Nama penerima kosong');
    if (!alamat) throw new Error('Alamat kosong');

    var subtotalProduk = parseFloat(sh.getRange(row, 7).getValue()) || 0;
    var total = subtotalProduk + ongkosKirim + biayaLainnya;

    sh.getRange(row, 3, 1, 8).setValues([[namaPenerima, alamat, noHp, kurir, subtotalProduk, ongkosKirim, biayaLainnya, total]]);

    result.success = true;
    result.total = total;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.',
    pesanTanpaIzin: 'Anda tidak punya izin untuk mengubah pesanan.',
    validasi: function () {
      row = parseInt(data.row, 10);
      if (!row || row < 2) throw new Error('Baris tidak valid');
    }
  });
}

