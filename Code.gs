    } finally { lepasKunci_(lock); }
    if (labelOcrGagal.length) { try { spblAntreTambah_(labelOcrGagal); } catch (eL) { } }
    try { CacheService.getScriptCache().remove('WA_FU_PESANAN_V1__meta'); } catch (eW) { }
    return { success: true, terbaca: Object.keys(oke).length, gagal: Object.keys(gagal).length, tersimpan: tersimpan, pesananTerisi: terisi };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

