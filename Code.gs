    var diminta = (data.daftar || []).map(function (x) { return String(x || '').trim(); }).filter(function (x) { return x; }).slice(0, 5);
    var laporan = [], labels = [], jatahLabel = data.label === false ? 0 : 3, simpan = {};
    ['Waterground', 'Conner'].forEach(function (toko) {
      var cfg = ttbCfg_(toko);
      if (!cfg) return;
      var ids;
      if (diminta.length) { var peta = petaBarisPerId_(cfg.sheet); ids = diminta.filter(function (x) { return peta[x]; }); }
      else ids = ttbPilihContoh_(cfg, toko === 'Waterground' ? 4 : 2);
      if (!ids.length) return;
      var r1 = ttbApi_(cfg, 'get', '/order/202309/orders', { ids: ids.join(',') }), petaO = {};
      if (r1.ok) ((r1.json.data && r1.json.data.orders) || []).forEach(function (o) { petaO[String(o.id)] = o; });
      ids.forEach(function (id) {
        var o = petaO[id], sumber = [], akhir = {};
        var m1 = o ? ttbEkstrakAlamat_(o.recipient_address) : null;
        sumber.push({ api: 'Get Order Detail', ok: r1.ok && !!o, error: r1.error, pesan: o ? '' : (r1.pesan || 'pesanan tidak ada di jawaban'), field: m1,
          mentah: o ? JSON.stringify({ status: o.status, commerce_platform: o.commerce_platform, user_id: o.user_id, buyer_email: o.buyer_email, recipient_address: o.recipient_address, packages: o.packages }).slice(0, 4000) : String(r1.teks || '').slice(0, 1500) });
        if (m1) ttbGabung_(akhir, m1, 'Get Order Detail');
        var paket = o && o.packages && o.packages[0] && o.packages[0].id ? String(o.packages[0].id) : '';
        if (paket) {
          var r2 = ttbApi_(cfg, 'get', '/fulfillment/202309/packages/' + encodeURIComponent(paket), {});
          var m2 = r2.ok ? ttbMatriksUmum_(r2.json.data || {}) : null;
          sumber.push({ api: 'Get Package Detail', ok: r2.ok, error: r2.error, pesan: r2.pesan, field: m2, mentah: String(r2.teks || '').slice(0, 4000) });
          if (m2) ttbGabung_(akhir, m2, 'Get Package Detail');
          if (jatahLabel > 0) {
            jatahLabel--;
            try { labels.push({ no: id, toko: toko, kunci: toko + '|' + id, ok: true, pdf: lblPdfTikTok_(cfg, paket) }); }
            catch (eL) { labels.push({ no: id, toko: toko, kunci: toko + '|' + id, ok: false, pesan: String(eL && eL.message || eL).slice(0, 200) }); }
          }
        } else sumber.push({ api: 'Get Package Detail', ok: false, error: '', pesan: 'belum ada Package ID (pesanan belum Atur Pengiriman)', field: null, mentah: '' });
        var akhirTampil = {};
