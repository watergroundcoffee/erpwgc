/* ============================================================
   PESANAN PO (barang tidak ada di gudang - dibelikan khusus untuk pesanan ini)
   ------------------------------------------------------------
   Tanpa SKU & tanpa gerak stok. Wajib 3 dokumen agar dianggap LENGKAP:
     1. Invoice Penjualan (ke pembeli)   2. Nota-nota Pembelian (ke supplier)   3. Bukti Transfer Pembeli
   Masuk ke laporan keuangan otomatis:
     - Omzet  : akun "Penjualan Pesanan PO" pada tanggal pesanan
     - HPP    : modal barang (+ biaya lain untuk menyukseskan pesanan) = Harga Pokok Penjualan
     - Kas    : uang pembeli diakui pada Tanggal Bayar (sebelum itu = Piutang Usaha)
   Sheet: "Pesanan PO" - 1 baris per pesanan; barang disimpan sebagai JSON (tanpa SKU).
   ============================================================ */
var PO_SHEET = 'Pesanan PO';
var PO_HEADER = ['No PO', 'Tanggal', 'Pembeli', 'No Invoice Penjualan', 'Keterangan', 'Nilai Penjualan', 'Modal Barang', 'Biaya Lain', 'Laba Kotor',
  'Status', 'Tanggal Bayar', 'Dok Invoice Penjualan', 'Dok Nota Pembelian', 'Dok Bukti Transfer', 'Barang (JSON)', 'Dicatat Oleh', 'Diubah', 'ID Kirim'];
var PO_KANAL = 'Pesanan PO';
function getPesananPoSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(PO_SHEET);
  if (!sh) {
    sh = ss.insertSheet(PO_SHEET);
    sh.getRange(1, 1, 1, PO_HEADER.length).setValues([PO_HEADER]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}
function poBacaSemua_() {
  var sh = getPesananPoSheet_(), lr = sh.getLastRow(), tz = Session.getScriptTimeZone(), out = [];
  if (lr < 2) return out;
  sh.getRange(2, 1, lr - 1, PO_HEADER.length).getValues().forEach(function (r, i) {
    var no = String(r[0] || '').trim(); if (!no) return;
    var dok = function (v) { return String(v || '').split(/\n+/).map(function (u) { return u.trim(); }).filter(function (u) { return u; }); };
    var items = []; try { items = JSON.parse(String(r[14] || '[]')) || []; } catch (e) { items = []; }
    var t = r[1] instanceof Date ? Utilities.formatDate(r[1], tz, 'yyyy-MM-dd') : String(r[1] || '').slice(0, 10);
    var tb = r[10] instanceof Date ? Utilities.formatDate(r[10], tz, 'yyyy-MM-dd') : String(r[10] || '').slice(0, 10);
    var o = {
      row: i + 2, noPo: no, tanggal: t, pembeli: String(r[2] || ''), noInvoice: String(r[3] || ''), keterangan: String(r[4] || ''),
      jual: finAngka_(r[5]), modal: finAngka_(r[6]), biayaLain: finAngka_(r[7]), laba: finAngka_(r[8]),
      status: String(r[9] || 'Aktif'), tanggalBayar: finValidTgl_(tb) ? tb : '',
      dokInvoice: dok(r[11]), dokNota: dok(r[12]), dokTransfer: dok(r[13]), items: items,
      dicatatOleh: String(r[15] || ''), idKirim: String(r[17] || '')
    };
    o.dokLengkap = o.dokInvoice.length > 0 && o.dokNota.length > 0 && o.dokTransfer.length > 0;
    o.jumlahDok = (o.dokInvoice.length ? 1 : 0) + (o.dokNota.length ? 1 : 0) + (o.dokTransfer.length ? 1 : 0);
    out.push(o);
  });
  return out;
}

// ===== AKSI: lihat_pesanan_po =====
function prosesLihatPesananPo(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var daftar = poBacaSemua_();
    daftar.sort(function (a, b) { return a.tanggal < b.tanggal ? 1 : a.tanggal > b.tanggal ? -1 : b.row - a.row; });
    var petaNota = {};
    try {
      bpoBacaLog_().forEach(function (l) {
        if (l.status === 'Batal') return;
        (petaNota[l.noPo] = petaNota[l.noPo] || []).push({ noInvoice: l.noInvoice, supplier: l.supplier, tanggal: l.tanggal, total: l.total });
      });
    } catch (eNota) { }
    daftar.forEach(function (o) { o.pembelian = petaNota[o.noPo] || []; });
    result.daftar = daftar;
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: simpan_pesanan_po { noPo? (edit), tanggal, pembeli, noInvoice, keterangan, items:[{nama, qty, hargaJual, hargaModal}],
//        biayaLain, tanggalBayar, dokInvoice[], dokNota[], dokTransfer[], idPermintaan } =====
function prosesSimpanPesananPo(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tz = Session.getScriptTimeZone();
    var pembeli = String(data.pembeli || '').replace(/\s+/g, ' ').trim().slice(0, 100);
    if (!pembeli) throw new Error('Nama pembeli wajib diisi');
    var items = (Array.isArray(data.items) ? data.items : []).map(function (it) {
      return {
        nama: String(it.nama || '').replace(/\s+/g, ' ').trim().slice(0, 150), qty: Math.max(0, parseFloat(it.qty) || 0),
        hargaJual: Math.max(0, parseFloat(it.hargaJual) || 0), hargaModal: Math.max(0, parseFloat(it.hargaModal) || 0)
      };
    }).filter(function (it) { return it.nama && it.qty > 0; });
    if (!items.length) throw new Error('Isi minimal 1 barang (nama & qty)');
    if (items.length > 200) throw new Error('Maksimal 200 barang per pesanan');
    var jual = 0, modal = 0;
    items.forEach(function (it) { jual += it.qty * it.hargaJual; modal += it.qty * it.hargaModal; });
    jual = Math.round(jual); modal = Math.round(modal);
    var biayaLain = Math.max(0, Math.round(finAngka_(data.biayaLain)));
    if (!(jual > 0)) throw new Error('Nilai penjualan masih 0 - isi harga jual barang');
    var tanggal = finParseTanggalInput_(data.tanggal);
    if (tanggal.getTime() > Date.now() + 2 * 86400000) throw new Error('Tanggal tidak boleh di masa depan');
    var dokInvoice = dokumenBersihkan_(data.dokInvoice), dokNota = dokumenBersihkan_(data.dokNota), dokTransfer = dokumenBersihkan_(data.dokTransfer);
    var tglBayar = finValidTgl_(data.tanggalBayar) ? String(data.tanggalBayar) : (dokTransfer.length ? finTglStr_(tanggal, tz) : '');
    var idKirim = String(data.idPermintaan || '').slice(0, 80);
    var oleh = getNamaStaff(data.email) || data.email || '';
  } catch (errV) { result.error = errV.toString(); return result; }

  var lock = kunciModul_('pembelian');
  try { lock.waitLock(20000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  try {
    var sh = getPesananPoSheet_(), lr = sh.getLastRow();
    var semua = lr > 1 ? sh.getRange(2, 1, lr - 1, PO_HEADER.length).getValues() : [];
    var rowTarget = -1, noPo = String(data.noPo || '').trim();
    if (noPo) {
      for (var i = 0; i < semua.length; i++) if (String(semua[i][0]).trim() === noPo) { rowTarget = i + 2; break; }
      if (rowTarget < 0) throw new Error('Pesanan PO ' + noPo + ' tidak ditemukan');
      if (String(semua[rowTarget - 2][9]) === 'Batal') throw new Error('Pesanan PO ini sudah dibatalkan');
    } else if (idKirim) {
      for (var j = 0; j < semua.length; j++) if (String(semua[j][17]) === idKirim) return { success: true, noPo: String(semua[j][0]), duplikat: true };
    }
    if (!noPo) {
      var awalan = 'PO-' + Utilities.formatDate(new Date(), tz, 'yyMMdd') + '-', maks = 0;
      semua.forEach(function (r) { var s = String(r[0]); if (s.indexOf(awalan) === 0) maks = Math.max(maks, parseInt(s.slice(awalan.length), 10) || 0); });
      noPo = awalan + ('0' + (maks + 1)).slice(-2);
    }
    var baris = [noPo, tanggal, pembeli, String(data.noInvoice || '').trim().slice(0, 60), String(data.keterangan || '').trim().slice(0, 300),
      jual, modal, biayaLain, jual - modal - biayaLain, 'Aktif', tglBayar, dokInvoice.join('\n'), dokNota.join('\n'), dokTransfer.join('\n'),
      JSON.stringify(items).slice(0, 45000), rowTarget > 0 ? semua[rowTarget - 2][15] : oleh, new Date(), rowTarget > 0 ? semua[rowTarget - 2][17] : idKirim];
    if (rowTarget < 0) rowTarget = lr + 1;
    sh.getRange(rowTarget, 1, 1, PO_HEADER.length).setValues([baris]);
    SpreadsheetApp.flush();
    finInvalidasi_();
    result.success = true;
    result.noPo = noPo;
    result.lengkap = dokInvoice.length > 0 && dokNota.length > 0 && dokTransfer.length > 0;
    result.jual = jual; result.modal = modal; result.laba = jual - modal - biayaLain;
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

// ===== AKSI: batalkan_pesanan_po { noPo } =====
function prosesBatalkanPesananPo(data) {
  return withTransaction(data.email, 'mintaStock', 'pembelian', function () {
    var result = { success: false };
    var sh = getPesananPoSheet_(), lr = sh.getLastRow(), noPo = String(data.noPo || '').trim();
    if (lr < 2 || !noPo) throw new Error('Pesanan PO tidak ditemukan');
    var nos = sh.getRange(2, 1, lr - 1, 1).getValues();
    for (var i = 0; i < nos.length; i++) {
      if (String(nos[i][0]).trim() !== noPo) continue;
      sh.getRange(i + 2, 10).setValue('Batal');
      sh.getRange(i + 2, 17).setValue(new Date());
      SpreadsheetApp.flush();
      finInvalidasi_();
      result.success = true;
      return result;
    }
    throw new Error('Pesanan PO tidak ditemukan');
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

/* ============================================================
   PEMBELIAN UNTUK PESANAN PO (input dari form "Input Pembelian" yang sama dengan pembelian stok)
   ------------------------------------------------------------
   Barang tanpa SKU yang dibelikan khusus untuk 1 Pesanan PO. Stok TIDAK berubah.
   Setiap nota ditautkan ke 1 No PO lalu pembukuan PO disinkronkan otomatis:
     - Barang yang dipetakan ke barang PO  -> Harga Modal barang PO = total belanja barang itu (dari SEMUA
       nota yang tertaut) / qty pesanan. Modal PO = Σ qty × harga modal (masuk HPP Laporan Keuangan).
     - Barang yang tidak dipetakan + ongkir + biaya lain - diskon -> menambah "Biaya Lain" PO (ikut HPP).
     - Dokumen nota otomatis ditambahkan ke dokumen "Nota Pembelian" PO.
   Log setiap nota disimpan di sheet "Pembelian PO" (idempotensi + riwayat).
   ============================================================ */
var BPO_SHEET = 'Pembelian PO';
var BPO_HEADER = ['Waktu', 'No PO', 'No Invoice', 'Supplier', 'Tanggal', 'Barang (JSON)', 'Subtotal Barang', 'Biaya Pendukung', 'Total',
  'Dokumen', 'Dicatat Oleh', 'ID Kirim', 'Status'];
function getPembelianPoSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(BPO_SHEET);
  if (!sh) {
    sh = ss.insertSheet(BPO_SHEET);
    sh.getRange(1, 1, 1, BPO_HEADER.length).setValues([BPO_HEADER]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('B:C').setNumberFormat('@');
  }
  return sh;
}
function bpoNormNama_(t) { return String(t || '').toLowerCase().replace(/\s+/g, ' ').trim(); }
function bpoBacaLog_() {
  var sh = getPembelianPoSheet_(), lr = sh.getLastRow(), tz = Session.getScriptTimeZone(), out = [];
  if (lr < 2) return out;
  sh.getRange(2, 1, lr - 1, BPO_HEADER.length).getValues().forEach(function (r, i) {
    var noPo = String(r[1] || '').trim();
    if (!noPo) return;
    var items = [];
    try { items = JSON.parse(String(r[5] || '[]')) || []; } catch (e) { items = []; }
    var t = r[4] instanceof Date ? Utilities.formatDate(r[4], tz, 'yyyy-MM-dd') : String(r[4] || '').slice(0, 10);
    out.push({
      row: i + 2, noPo: noPo, noInvoice: String(r[2] || '').trim(), supplier: String(r[3] || ''), tanggal: t, items: items,
      subtotal: finAngka_(r[6]), biayaPendukung: finAngka_(r[7]), total: finAngka_(r[8]), idKirim: String(r[11] || ''), status: String(r[12] || 'Aktif')
    });
  });
  return out;
}

// ===== AKSI: simpan_pembelian_po { noPo, noInvoice, namaSupplier, tanggal, items:[{nama, qty, harga, poNama}],
//        ongkosKirim, biayaLain, diskon, dokumen[], idKirim } =====
function prosesSimpanPembelianPo(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noPo = String(data.noPo || '').trim();
    var noInvoice = String(data.noInvoice || '').trim().slice(0, 80);
    var supplier = String(data.namaSupplier || '').replace(/\s+/g, ' ').trim().slice(0, 100);
    if (!noPo) throw new Error('Pilih ID Pesanan PO terlebih dahulu');
    if (!noInvoice) throw new Error('No Invoice wajib diisi');
    if (!supplier) throw new Error('Nama Supplier wajib diisi');
    var items = (Array.isArray(data.items) ? data.items : []).map(function (it) {
      return {
        nama: String((it && it.nama) || '').replace(/\s+/g, ' ').trim().slice(0, 150),
        qty: Math.max(0, parseFloat(it && it.qty) || 0),
        harga: Math.max(0, parseFloat(it && it.harga) || 0),
        poNama: String((it && it.poNama) || '').replace(/\s+/g, ' ').trim().slice(0, 150)
      };
    }).filter(function (it) { return it.nama && it.qty > 0; });
    if (!items.length) throw new Error('Isi minimal 1 barang (nama & qty) untuk Pesanan PO');
    if (items.length > 200) throw new Error('Maksimal 200 barang per nota');
    var ongkir = parseFloat(data.ongkosKirim) || 0, biayaLain = parseFloat(data.biayaLain) || 0, diskon = parseFloat(data.diskon) || 0;
    if (ongkir < 0 || biayaLain < 0 || diskon < 0) throw new Error('Ongkir / biaya / diskon tidak boleh minus');
    var subtotal = 0;
    items.forEach(function (it) { subtotal += it.qty * it.harga; });
    subtotal = Math.round(subtotal);
    if (diskon > subtotal + ongkir + biayaLain) throw new Error('Diskon Supplier lebih besar dari total belanja');
    var tz = Session.getScriptTimeZone();
    var tanggal = finParseTanggalInput_(data.tanggal);
    var dokumen = dokumenBersihkan_(data.dokumen);
    var idKirim = String(data.idKirim || '').slice(0, 80);
    var oleh = getNamaStaff(data.email) || data.email || '';
  } catch (errV) { result.error = errV.toString(); return result; }

  var lock = kunciModul_('pembelian');
  try { lock.waitLock(20000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  try {
    var log = bpoBacaLog_();
    if (idKirim) {
      for (var a = 0; a < log.length; a++) {
        if (log[a].idKirim === idKirim) return { success: true, duplikat: true, noPo: log[a].noPo, noInvoice: log[a].noInvoice };
      }
    }
    var noInvLower = noInvoice.toLowerCase();
    log.forEach(function (l) {
      if (l.status !== 'Batal' && l.noPo === noPo && l.noInvoice.toLowerCase() === noInvLower) throw new Error('Nota ' + noInvoice + ' sudah pernah ditautkan ke ' + noPo);
    });

    var shPo = getPesananPoSheet_(), lrPo = shPo.getLastRow();
    if (lrPo < 2) throw new Error('Pesanan PO ' + noPo + ' tidak ditemukan');
    var semuaPo = shPo.getRange(2, 1, lrPo - 1, PO_HEADER.length).getValues();
    var idx = -1;
    for (var i = 0; i < semuaPo.length; i++) if (String(semuaPo[i][0]).trim() === noPo) { idx = i; break; }
    if (idx < 0) throw new Error('Pesanan PO ' + noPo + ' tidak ditemukan');
    var r = semuaPo[idx];
    if (String(r[9]) === 'Batal') throw new Error('Pesanan PO ' + noPo + ' sudah dibatalkan');
    var poItems = [];
    try { poItems = JSON.parse(String(r[14] || '[]')) || []; } catch (eJ) { poItems = []; }

    // Barang PO yang dipetakan -> total belanja dari SEMUA nota aktif yang tertaut (idempoten, tidak dobel)
    var petaNamaPo = {};
    poItems.forEach(function (it) { petaNamaPo[bpoNormNama_(it.nama)] = true; });
    var totalPerBarang = {};
    function tampung(it) {
      var k = bpoNormNama_(it.poNama);
      if (!k || !petaNamaPo[k]) return false;
      totalPerBarang[k] = (totalPerBarang[k] || 0) + (Number(it.qty) || 0) * (Number(it.harga) || 0);
      return true;
    }
    log.forEach(function (l) { if (l.status !== 'Batal' && l.noPo === noPo) (l.items || []).forEach(tampung); });
    var biayaPendukung = ongkir + biayaLain - diskon, jumlahTerpetakan = 0;
    items.forEach(function (it) {
      if (tampung(it)) jumlahTerpetakan++;
      else { it.poNama = ''; biayaPendukung += it.qty * it.harga; }
    });
    biayaPendukung = Math.round(biayaPendukung);
    poItems.forEach(function (it) {
      var k = bpoNormNama_(it.nama), q = Number(it.qty) || 0;
      if (totalPerBarang[k] !== undefined && q > 0) it.hargaModal = Math.round(totalPerBarang[k] / q * 100) / 100;
    });
    var jual = 0, modal = 0;
    poItems.forEach(function (it) { jual += (Number(it.qty) || 0) * (Number(it.hargaJual) || 0); modal += (Number(it.qty) || 0) * (Number(it.hargaModal) || 0); });
    jual = Math.round(jual); modal = Math.round(modal);
    var biayaLainPo = Math.max(0, Math.round(finAngka_(r[7]) + biayaPendukung));
    var dokNota = String(r[12] || '').split(/\n+/).map(function (u) { return u.trim(); }).filter(function (u) { return u; });
    dokumen.forEach(function (u) { if (dokNota.indexOf(u) === -1) dokNota.push(u); });
    var rowPo = idx + 2;
    shPo.getRange(rowPo, 6, 1, 4).setValues([[jual, modal, biayaLainPo, jual - modal - biayaLainPo]]);
    shPo.getRange(rowPo, 13).setValue(dokNota.join('\n'));
    shPo.getRange(rowPo, 15).setValue(JSON.stringify(poItems).slice(0, 45000));
    shPo.getRange(rowPo, 17).setValue(new Date());

    var shLog = getPembelianPoSheet_(), rowLog = shLog.getLastRow() + 1;
    shLog.getRange(rowLog, 2, 1, 2).setNumberFormat('@');
    shLog.getRange(rowLog, 1, 1, BPO_HEADER.length).setValues([[new Date(), noPo, noInvoice, supplier, tanggal, JSON.stringify(items).slice(0, 45000),
      subtotal, biayaPendukung, Math.round(subtotal + ongkir + biayaLain - diskon), dokumen.join('\n'), oleh, idKirim, 'Aktif']]);
    SpreadsheetApp.flush();
    finInvalidasi_();
    result.success = true;
    result.noPo = noPo;
    result.noInvoice = noInvoice;
    result.jual = jual; result.modal = modal; result.biayaLain = biayaLainPo; result.laba = jual - modal - biayaLainPo;
    result.jumlahTerpetakan = jumlahTerpetakan;
    result.biayaPendukung = biayaPendukung;
    result.tanggal = Utilities.formatDate(tanggal, tz, 'yyyy-MM-dd');
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

/* ============================================================
   FINANCE - MUTASI KAS RIIL (Rekening Bank + Saldo Marketplace)
   ------------------------------------------------------------
   Sumber data:
     1. Saldo & mutasi marketplace ditarik otomatis lewat API:
        - TikTok Shop / Tokopedia : Finance API 202309 (statements = dana penjualan masuk ke saldo,
          payments = dana dikirim ke rekening). Biaya marketplace dipisah dari pendapatan.
        - Shopee                  : v2.payment.get_wallet_transaction_list (mutasi & saldo dompet penjual).
     2. Mutasi rekening bank: upload CSV (BCA, Mandiri, BRI, BNI, dll - kolom dipetakan di browser).
   Setiap baris diberi KATEGORI FINANCE (dipilih manual, dibantu saran otomatis) -> menyusun
   Laporan Arus Kas RIIL (operasi / investasi / pendanaan). Transfer antar akun sendiri (mis. tarik
   saldo Shopee ke BCA) dikategorikan "Transfer" sehingga tidak dihitung dobel.
   Sheet: "Mutasi Kas" - 1 baris = 1 mutasi. ID unik per baris -> impor/sinkron ulang tidak dobel.
   ============================================================ */
var MK_SHEET = 'Mutasi Kas';
var MK_HEADER = ['ID', 'Tanggal', 'Akun Kas', 'Sumber', 'Keterangan', 'Masuk', 'Keluar', 'Saldo', 'Kategori', 'Ref', 'Batch', 'Diimpor', 'Diubah Oleh'];
var MK_CACHE = 'FIN_MUTASI_V1';
var MK_KATEGORI = [
  { k: 'op_terima', grup: 'op', label: 'Penerimaan dari penjualan / pelanggan', arah: 'masuk' },
  { k: 'op_lain_masuk', grup: 'op', label: 'Penerimaan lain (bunga, cashback, refund supplier)', arah: 'masuk' },
  { k: 'op_supplier', grup: 'op', label: 'Pembayaran ke supplier / beli stok', arah: 'keluar' },
  { k: 'op_beban', grup: 'op', label: 'Biaya operasional (gaji, listrik, ongkir, sewa…)', arah: 'keluar' },
  { k: 'op_marketplace', grup: 'op', label: 'Biaya & potongan marketplace / iklan', arah: 'keluar' },
  { k: 'op_refund', grup: 'op', label: 'Refund ke pembeli', arah: 'keluar' },
  { k: 'op_pajak', grup: 'op', label: 'Pembayaran pajak', arah: 'keluar' },
  { k: 'op_reimburse', grup: 'op', label: 'Bayar reimburse ke Owner (talangan CC pribadi)', arah: 'keluar' },
  { k: 'op_admin_bank', grup: 'op', label: 'Biaya admin bank', arah: 'keluar' },
  { k: 'op_kompensasi', grup: 'op', label: 'Pendapatan kompensasi marketplace (klaim asuransi, kehilangan, kemasan)', arah: 'masuk' },
  { k: 'inv_aset', grup: 'inv', label: 'Pembelian aset tetap', arah: 'keluar' },
  { k: 'inv_jual_aset', grup: 'inv', label: 'Penjualan aset tetap', arah: 'masuk' },
  { k: 'fin_modal', grup: 'fin', label: 'Setoran modal pemilik', arah: 'masuk' },
  { k: 'fin_prive', grup: 'fin', label: 'Prive / ambil pribadi', arah: 'keluar' },
  { k: 'fin_pinjam', grup: 'fin', label: 'Terima pinjaman', arah: 'masuk' },
  { k: 'fin_cicil', grup: 'fin', label: 'Bayar pokok pinjaman', arah: 'keluar' },
  { k: 'transfer', grup: 'transfer', label: 'Transfer antar rekening / tarik saldo sendiri', arah: '' },
  { k: 'abaikan', grup: 'abaikan', label: 'Abaikan (bukan transaksi usaha / dobel)', arah: '' }
];
// Kategori = bawaan + kategori buatan sendiri (Script Properties 'MK_KATEGORI_CUSTOM').
// Kategori buatan disisipkan sebelum "Transfer" & "Abaikan" supaya urutan grup tetap rapi.
var MK_KATEGORI_MEMO_ = null;
function mkKategoriCustom_() {
  try { var x = JSON.parse(PropertiesService.getScriptProperties().getProperty('MK_KATEGORI_CUSTOM') || '[]'); return Array.isArray(x) ? x : []; } catch (e) { return []; }
}
function mkDaftarKategori_() {
  if (MK_KATEGORI_MEMO_) return MK_KATEGORI_MEMO_;
  var custom = mkKategoriCustom_().filter(function (c) { return c && c.k && c.label && /^(op|inv|fin)$/.test(c.grup) && !finAdalahKartuKredit_(c.label); })
    .map(function (c) { return { k: String(c.k), grup: c.grup, label: String(c.label), arah: c.arah === 'masuk' ? 'masuk' : c.arah === 'keluar' ? 'keluar' : '', custom: true }; });
  var dasar = MK_KATEGORI.filter(function (k) { return k.grup !== 'transfer' && k.grup !== 'abaikan'; });
  var akhir = MK_KATEGORI.filter(function (k) { return k.grup === 'transfer' || k.grup === 'abaikan'; });
  MK_KATEGORI_MEMO_ = dasar.concat(custom, akhir);
  return MK_KATEGORI_MEMO_;
}
function mkInfoKategori_(k) { var d = mkDaftarKategori_(); for (var i = 0; i < d.length; i++) if (d[i].k === k) return d[i]; return null; }

function getMutasiKasSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(MK_SHEET);
  if (!sh) {
    sh = ss.insertSheet(MK_SHEET);
    sh.getRange(1, 1, 1, MK_HEADER.length).setValues([MK_HEADER]).setFontWeight('bold');
    sh.getRange('B:B').setNumberFormat('@'); // tanggal disimpan teks yyyy-MM-dd HH:mm (anti geser zona)
    sh.setFrozenRows(1);
  }
  return sh;
}
// PERBAIKAN: dulu yang dihapus kunci MK_CACHE, padahal cache besar disimpan di MK_CACHE + '__meta'
// -> data lama terus dipakai sampai 5 menit. Sekarang meta yang dibuang + versi tampilan dinaikkan.
function mkInvalidasi_() {
  try { CacheService.getScriptCache().remove(MK_CACHE + '__meta'); } catch (e) { }
  mkNaikVersi_();
}
function mkVersi_() { try { return CacheService.getScriptCache().get('MK_VER') || '0'; } catch (e) { return '0'; } }
function mkNaikVersi_() {
  try { CacheService.getScriptCache().put('MK_VER', String(Date.now()) + Math.floor(Math.random() * 1000), 21600); } catch (e) { }
  try { finInvalidasiLaporan_(); } catch (e2) { }
}
function mkTanggal_(v, tz) {
  if (v instanceof Date) return Utilities.formatDate(v, tz, 'yyyy-MM-dd HH:mm');
  var s = String(v || '').trim();
  return /^\d{4}-\d{2}-\d{2}/.test(s) ? s.slice(0, 16) : '';
}
// Baca semua mutasi (di-cache 5 menit; dibuang tiap ada tulis)
function mkBacaSemua_() {
  var cache = CacheService.getScriptCache();
  try { var c = cacheBesarGet_(MK_CACHE); if (c) return c; } catch (e) { }
  var sh = getMutasiKasSheet_(), lr = sh.getLastRow(), tz = Session.getScriptTimeZone(), rows = [];
  if (lr > 1) sh.getRange(2, 1, lr - 1, MK_HEADER.length).getValues().forEach(function (r, i) {
    var id = String(r[0] || '').trim(); if (!id) return;
    var t = mkTanggal_(r[1], tz); if (!t) return;
    rows.push({
      row: i + 2, id: id, t: t, akun: String(r[2] || '').trim() || '-', sumber: String(r[3] || ''), ket: String(r[4] || ''),
      masuk: finAngka_(r[5]), keluar: finAngka_(r[6]), saldo: r[7] === '' || r[7] === null ? null : finAngka_(r[7]),
      kat: String(r[8] || ''), ref: String(r[9] || ''), batch: String(r[10] || '')
    });
  });
  try { cacheBesarPut_(MK_CACHE, rows, 300); } catch (e) { }
  return rows;
}
// Urutan kronologis stabil: tanggal, lalu urutan baris di sheet
function mkUrut_(rows) { return rows.slice().sort(function (a, b) { return a.t < b.t ? -1 : a.t > b.t ? 1 : a.row - b.row; }); }

// Saran kategori: (1) belajar dari baris sejenis yang sudah dikategorikan user, (2) aturan kata kunci
function mkSidikKet_(ket) {
  return String(ket || '').toUpperCase().replace(/\d+/g, ' ').replace(/[^A-Z ]+/g, ' ').replace(/\s+/g, ' ').trim().split(' ')
    .filter(function (w) { return w.length >= 3 && !/^(TRF|TRANSFER|DARI|KE|BIF|MBANKING|TGL|PAY|IDR|DB|CR)$/.test(w); }).slice(0, 3).join(' ');
}
function mkSaranAturan_(r, adaMarketplaceApi) {
  var k = String(r.ket || '').toUpperCase(), masuk = r.masuk > 0;
  if (/SHOPEE|TIKTOK|TOKOPEDIA|LAZADA|BUKALAPAK|BLIBLI/.test(k)) return masuk ? (adaMarketplaceApi ? 'transfer' : 'op_terima') : 'op_marketplace';
  if (/BUNGA|JASA GIRO|INTEREST|CASHBACK/.test(k) && masuk) return 'op_lain_masuk';
  if (/PAJAK|PPH|PPN|DJP|MPN/.test(k) && !masuk) return 'op_pajak';
  if (/BIAYA ADM|ADM BANK|BIAYA ADMIN|ADMIN FEE|BIAYA TRANSFER|BIAYA KARTU|BIAYA BULANAN|MONTHLY FEE/.test(k) && !masuk) return 'op_admin_bank';
  if (/KOMPENSASI|COMPENSAT|KLAIM|CLAIM|ASURANSI|INSURANCE|GANTI RUGI|KEHILANGAN|LOST/.test(k) && masuk) return 'op_kompensasi';
  if (/PLN|LISTRIK|PDAM|TELKOM|INDIHOME|PULSA|GAJI|PAYROLL|SEWA|JNE|J&T|SICEPAT|GOJEK|GRAB|ANTERAJA/.test(k) && !masuk) return 'op_beban';
  if (/ANGSURAN|CICILAN|KREDIT|KUR /.test(k) && !masuk) return 'fin_cicil';
  if (/SETOR TUNAI|SETORAN/.test(k) && masuk) return 'fin_modal';
  return '';
}

/* ---------- AI KATEGORI: belajar dari pilihan kategori Anda sendiri ----------
   Model Naive Bayes sederhana: setiap mutasi yang SUDAH dikategorikan = 1 contoh belajar.
   Fitur: kata-kata keterangan (tanpa angka), arah (masuk/keluar), rekening/sumber, kisaran nominal.
   Makin banyak mutasi yang Anda kategorikan, makin tepat sarannya (pola pencairan marketplace,
   gaji rutin, supplier langganan, dll otomatis dikenali). */
var MK_KATA_UMUM = { TRF: 1, TRANSFER: 1, DARI: 1, KE: 1, BIF: 1, MBANKING: 1, TGL: 1, PAY: 1, IDR: 1, DB: 1, CR: 1, KR: 1, DR: 1, THE: 1, AND: 1, VIA: 1, BANK: 1, REF: 1, NO: 1, BIFAST: 1 };
function mkFitur_(r) {
  var kata = String(r.ket || '').toUpperCase().replace(/\d+/g, ' ').replace(/[^A-Z ]+/g, ' ').split(/\s+/)
    .filter(function (w) { return w.length >= 3 && !MK_KATA_UMUM[w]; });
  var f = {}, jml = r.masuk > 0 ? r.masuk : r.keluar;
  kata.forEach(function (w) { f['W:' + w] = 1; });
  for (var i = 0; i + 1 < kata.length && i < 6; i++) f['B:' + kata[i] + '_' + kata[i + 1]] = 1; // pasangan kata (pola lebih spesifik)
  f['D:' + (r.masuk > 0 ? 'M' : 'K')] = 1;
  f['A:' + String(r.akun || '').toUpperCase()] = 1;
  f['S:' + String(r.sumber || '')] = 1;
  f['N:' + (r.masuk > 0 ? 'M' : 'K') + Math.round(Math.log(jml + 1) / Math.LN10 * 2)] = 1; // kisaran nominal
  return Object.keys(f);
}
function mkLatihModel_(rows) {
  var M = { nKat: {}, tok: {}, tokTotal: {}, vocab: {}, N: 0 };
  rows.forEach(function (r) {
    if (!r.kat || r.kat === 'abaikan') return;
    M.N++; M.nKat[r.kat] = (M.nKat[r.kat] || 0) + 1;
    var t = M.tok[r.kat] || (M.tok[r.kat] = {});
    mkFitur_(r).forEach(function (f) { t[f] = (t[f] || 0) + 1; M.tokTotal[r.kat] = (M.tokTotal[r.kat] || 0) + 1; M.vocab[f] = (M.vocab[f] || 0) + 1; });
  });
  M.V = Object.keys(M.vocab).length || 1;
  return M;
}
function mkPrediksi_(M, r) {
  if (!M || M.N < 3) return null;
  var fitur = mkFitur_(r).filter(function (f) { return M.vocab[f]; });
  var kataKenal = fitur.filter(function (f) { return f.charAt(0) === 'W' || f.charAt(0) === 'B'; });
  if (!kataKenal.length) return null; // tidak ada kata yang pernah dilihat -> jangan menebak
  var kats = Object.keys(M.nKat), skor = {}, maks = -Infinity, terbaik = '';
  kats.forEach(function (k) {
    var s = Math.log((M.nKat[k] + 1) / (M.N + kats.length)), t = M.tok[k], tot = (M.tokTotal[k] || 0) + M.V;
    fitur.forEach(function (f) { s += Math.log(((t[f] || 0) + 1) / tot); });
    skor[k] = s;
    if (s > maks) { maks = s; terbaik = k; }
  });
  var jumlah = 0; kats.forEach(function (k) { jumlah += Math.exp(skor[k] - maks); });
  var yakin = 1 / jumlah;
  var dukung = kataKenal.filter(function (f) { return (M.tok[terbaik][f] || 0) > 0; }).length;
  if (!dukung || yakin < 0.55 || M.nKat[terbaik] < 2) return null;
  return { k: terbaik, yakin: Math.round(yakin * 100) };
}
// Model ringkas untuk browser (menebak kategori mutasi yang baru diimpor, sebelum sampai ke server)
function mkModelRingkas_(M) {
  var out = {}, n = 0;
  Object.keys(M.vocab).forEach(function (f) {
    if (f.charAt(0) !== 'W' || M.vocab[f] < 2 || n >= 600) return;
    var best = '', c = 0;
    Object.keys(M.tok).forEach(function (k) { var x = M.tok[k][f] || 0; if (x > c) { c = x; best = k; } });
    if (best && c / M.vocab[f] >= 0.75) { out[f.slice(2)] = [best, c]; n++; }
  });
  return out;
}

// ===== AKSI: lihat_fin_mutasi { dari, sampai, akun, status: ''|'belum'|'sudah', cari, hal } =====
function prosesLihatFinMutasi(data) {
  // Hasil per filter di-cache 10 menit, kuncinya ikut versi data -> buka ulang / pindah halaman instan
  var kunciView = '';
  try {
    if (!cekIzin(data.email, 'buatInvoice')) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
    kunciView = 'MK_VIEW_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5,
      [mkVersi_(), data.dari, data.sampai, data.akun, data.status, data.cari, data.hal].join('|'))).slice(0, 22);
    var c = cacheBesarGet_(kunciView);
    if (c && c.success) { c.mpStatus = mkStatusMp_(); return c; }
  } catch (eC) { kunciView = ''; }
  var hasil = prosesLihatFinMutasi_inti_(data);
  if (hasil && hasil.success && kunciView) cacheBesarPut_(kunciView, hasil, 600);
  return hasil;
}
function mkStatusMp_() {
  try { return JSON.parse(PropertiesService.getScriptProperties().getProperty('FIN_MP_STATUS') || '{}') || {}; } catch (e) { return {}; }
}
function prosesLihatFinMutasi_inti_(data) {
  var result = { success: false };
  try {
    var semua = mkUrut_(mkBacaSemua_());
    var dari = finValidTgl_(data.dari) ? String(data.dari) : '', sampai = finValidTgl_(data.sampai) ? String(data.sampai) : '';
    var adaApi = semua.some(function (r) { return r.sumber === 'TikTok Shop' || r.sumber === 'Shopee'; });
    // AI: belajar dari SEMUA mutasi yang sudah Anda kategorikan
    var model = mkLatihModel_(semua);
    var belajar = {};
    semua.forEach(function (r) { if (r.kat && r.sumber === 'Bank') { var s = mkSidikKet_(r.ket) + (r.masuk > 0 ? '|M' : '|K'); if (s.length > 2) belajar[s] = r.kat; } });
    function saranUntuk(r) {
      var p = mkPrediksi_(model, r);
      if (p) return { k: p.k, yakin: p.yakin, dari: 'ai' };
      var b = belajar[mkSidikKet_(r.ket) + (r.masuk > 0 ? '|M' : '|K')];
      if (b) return { k: b, yakin: 70, dari: 'pola' };
      var a = mkSaranAturan_(r, adaApi);
      return a ? { k: a, yakin: 50, dari: 'aturan' } : null;
    }
    // Ringkasan per akun (saldo terakhir)
    var akun = {};
    semua.forEach(function (r) {
      var a = akun[r.akun] || (akun[r.akun] = { akun: r.akun, sumber: r.sumber, jumlah: 0, belum: 0, saldo: null, hitung: 0, terakhir: '' });
      a.jumlah++; if (!r.kat) a.belum++;
      a.hitung += r.masuk - r.keluar;
      if (r.saldo !== null) a.saldo = r.saldo;
      a.terakhir = r.t;
    });
    var daftarAkun = Object.keys(akun).map(function (k) { var a = akun[k]; a.saldoTampil = a.saldo !== null ? a.saldo : a.hitung; a.saldoDihitung = a.saldo === null; return a; });
    var cari = String(data.cari || '').trim().toLowerCase();
    var tersaring = semua.filter(function (r) {
      var tgl = r.t.slice(0, 10);
      if (dari && tgl < dari) return false;
      if (sampai && tgl > sampai) return false;
      if (data.akun && r.akun !== data.akun) return false;
      if (data.status === 'belum' && r.kat) return false;
      if (data.status === 'sudah' && !r.kat) return false;
      if (cari && (r.ket + ' ' + r.akun + ' ' + r.ref).toLowerCase().indexOf(cari) === -1) return false;
      return true;
    }).reverse(); // terbaru di atas
    var tot = { masuk: 0, keluar: 0, belum: 0 };
    tersaring.forEach(function (r) { tot.masuk += r.masuk; tot.keluar += r.keluar; if (!r.kat) tot.belum++; });
    var per = 100, nHal = Math.max(1, Math.ceil(tersaring.length / per)), hal = Math.min(Math.max(1, parseInt(data.hal, 10) || 1), nHal);
    result.baris = tersaring.slice((hal - 1) * per, hal * per).map(function (r) {
      var s = r.kat ? null : saranUntuk(r);
      return { id: r.id, t: r.t, akun: r.akun, sumber: r.sumber, ket: r.ket, masuk: r.masuk, keluar: r.keluar, saldo: r.saldo, kat: r.kat,
        saran: s ? s.k : '', saranYakin: s ? s.yakin : 0, saranDari: s ? s.dari : '', ref: r.ref, batch: r.batch };
    });
    // Saran untuk SEMUA baris belum dikategorikan di filter ini (dipakai tombol "Terapkan semua saran")
    result.saranSemua = tersaring.filter(function (r) { return !r.kat; }).slice(0, 2000).map(function (r) {
      var s = saranUntuk(r); return s ? { id: r.id, k: s.k, yakin: s.yakin } : null;
    }).filter(function (x) { return x; });
    result.ai = { belajar: model.N, model: mkModelRingkas_(model) };
    result.jumlah = tersaring.length; result.hal = hal; result.nHal = nHal; result.total = tot;
    result.akun = daftarAkun;
    result.kategori = mkDaftarKategori_();
    var batch = {};
    semua.forEach(function (r) { if (r.batch) { var b = batch[r.batch] || (batch[r.batch] = { batch: r.batch, akun: r.akun, sumber: r.sumber, jumlah: 0, dari: r.t, sampai: r.t }); b.jumlah++; if (r.t < b.dari) b.dari = r.t; if (r.t > b.sampai) b.sampai = r.t; } });
    result.batch = Object.keys(batch).map(function (k) { return batch[k]; }).sort(function (a, b) { return a.batch < b.batch ? 1 : -1; }).slice(0, 30);
    var props = PropertiesService.getScriptProperties();
    var st = {}; try { st = JSON.parse(props.getProperty('FIN_MP_STATUS') || '{}') || {}; } catch (eS) { }
    result.mpStatus = st;
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

