    if (!laporan.length) throw new Error('Tidak ada pesanan TikTok / Tokopedia / Conner yang bisa diuji (toko belum terhubung atau sheet kosong).');
    return { success: true, laporan: laporan, labels: labels, tersimpan: tersimpan };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

