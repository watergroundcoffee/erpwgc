// ----- Status semua koneksi (registri + token tersimpan) -----
function prosesLihatStatusIntegrasiMarketplace(data) {
  var result = { success: false };
  try {
    integrasiWajibOwner_(data.email);
    var props = PropertiesService.getScriptProperties().getProperties();
    var tz = Session.getScriptTimeZone();
    var fmt = function (ms) { return ms ? Utilities.formatDate(new Date(ms), tz, 'dd MMM yyyy, HH:mm') : null; };
    result.koneksi = oauthBacaRegistri_().map(function (k) {
      var exp = parseInt(props[k.slot + 'TOKEN_EXPIRED_AT'] || '0', 10);
      var sync = parseInt(props[k.slot + 'WAKTU_SYNC_TERAKHIR'] || '0', 10);
      if (sync && sync < 1e12) sync *= 1000;
      var terhubung = !!props[k.slot + 'ACCESS_TOKEN'];
      var gagal = null;
      try { gagal = props['OAUTH_GAGAL_' + k.idKoneksi] ? JSON.parse(props['OAUTH_GAGAL_' + k.idKoneksi]) : null; } catch (e) { }
      return {
        idKoneksi: k.idKoneksi, tokoId: k.tokoId, tokoNama: k.tokoNama, platform: k.platform,
        terhubung: terhubung, sudahExpired: terhubung && exp ? Date.now() > exp : false,
        berlakuSampai: fmt(exp), syncTerakhir: fmt(sync),
        shopId: props[k.slot + 'SHOP_ID'] || k.shopId || '', namaMarketplace: k.namaMarketplace,
        terhubungPada: k.terhubungPada instanceof Date ? fmt(k.terhubungPada.getTime()) : null,
        oleh: k.oleh, syncOtomatis: !!OAUTH_SLOT_SYNC_AKTIF[k.slot],
        appSiap: oauthAppSiap_(k.platform, k.slot), appKhusus: k.platform === 'tiktok' && tiktokAppSendiriTersedia_(k.slot),
        bisaAppKhusus: k.platform === 'tiktok' && k.slot !== 'TIKTOK_',
        appKhususKey: (k.platform === 'tiktok' && k.slot !== 'TIKTOK_') ? oauthSensorKey_(tiktokAppSendiri_(k.slot).appKey) : '',
        appKhususAdaSecret: (k.platform === 'tiktok' && k.slot !== 'TIKTOK_') ? !!tiktokAppSendiri_(k.slot).appSecret : false,
        appKhususAdaServiceId: (k.platform === 'tiktok' && k.slot !== 'TIKTOK_') ? !!tiktokAppSendiri_(k.slot).serviceId : false,
        authVia: props[k.slot + 'AUTH_VIA'] || '',
        statusRegistri: k.status, gagalTerakhir: gagal ? { pesan: gagal.pesan, waktu: fmt(gagal.waktu) } : null
      };
    });
    result.masterSiap = { shopee: masterSiap_('shopee'), tiktok: masterSiap_('tiktok') };
    result.masterKurang = { shopee: masterKurang_('shopee'), tiktok: masterKurang_('tiktok') };
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function oauthSensorKey_(v) { v = String(v || ''); return v ? (v.length > 8 ? v.slice(0, 4) + '•••' + v.slice(-3) : v) : ''; }

// Simpan / hapus "app khusus toko" (TikTok Shop) dari dasbor. Hanya Owner. Disimpan di Script Properties:
// <SLOT>APP_KEY, <SLOT>APP_SECRET, <SLOT>SERVICE_ID. Slot Waterground (TIKTOK_) selalu memakai app master.
// App Secret tidak pernah dikirim balik ke frontend. Secret dikosongkan = pakai secret lama (kalau App Key sama).
function prosesSimpanAppKhususToko(data) {
  return withTransaction(data.email, null, 'token', function () {
    var result = { success: false };
    integrasiWajibOwner_(data.email);
    var k = oauthBacaRegistri_().filter(function (x) { return x.idKoneksi === String(data.idKoneksi || ''); })[0];
    if (!k) throw new Error('Koneksi tidak ditemukan.');
    if (k.platform !== 'tiktok') throw new Error('App khusus toko hanya untuk TikTok Shop.');
    if (k.slot === 'TIKTOK_') throw new Error('Toko utama (Waterground) selalu memakai aplikasi master OmniAI.');
    var props = PropertiesService.getScriptProperties();
    if (data.hapus === true) {
      ['APP_KEY', 'APP_SECRET', 'SERVICE_ID'].forEach(function (s) { props.deleteProperty(k.slot + s); });
      props.deleteProperty('OAUTH_GAGAL_' + k.idKoneksi);
      result.success = true;
      result.pesan = 'App khusus dihapus - toko ini kembali memakai aplikasi master.' +
        (props.getProperty(k.slot + 'AUTH_VIA') === 'SENDIRI' ? ' Token lama berasal dari app khusus, jadi Sambungkan Ulang toko ini.' : '');
      return result;
    }
    var bersih = function (v) { return String(v == null ? '' : v).replace(/\s+/g, ''); };
    var appKey = bersih(data.appKey), appSecret = bersih(data.appSecret), serviceId = bersih(data.serviceId);
    var lama = tiktokAppSendiri_(k.slot);
    if (!appKey) throw new Error('App Key wajib diisi.');
    if (!/^[A-Za-z0-9]{6,40}$/.test(appKey)) throw new Error('Format App Key tidak valid (hanya huruf & angka).');
    if (appKey === masterConfig_('tiktok', 'appKey')) throw new Error('App Key ini sama dengan aplikasi master (dipakai Waterground). Isi App Key milik aplikasi yang dibuat dari akun ' + (k.tokoNama || 'toko ini') + '.');
    if (!appSecret) {
      if (lama.appSecret && lama.appKey === appKey) appSecret = lama.appSecret;
      else throw new Error('App Secret wajib diisi.');
    }
    if (!/^[A-Za-z0-9]{10,100}$/.test(appSecret)) throw new Error('Format App Secret tidak valid (hanya huruf & angka).');
    if (serviceId && !/^\d{5,30}$/.test(serviceId)) throw new Error('Service ID harus berupa angka saja.');
    var set = {};
    set[k.slot + 'APP_KEY'] = appKey;
    set[k.slot + 'APP_SECRET'] = appSecret;
    props.setProperties(set, false);
    if (serviceId) props.setProperty(k.slot + 'SERVICE_ID', serviceId); else props.deleteProperty(k.slot + 'SERVICE_ID');
    props.deleteProperty('OAUTH_GAGAL_' + k.idKoneksi);
    result.success = true;
    result.pesan = 'App khusus tersimpan. Tekan Hubungkan / Sambungkan Ulang lalu login dengan akun Seller Center ' + (k.tokoNama || 'toko ini') + '.';
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

function prosesPutuskanKoneksiMarketplace(data) {
  return withTransaction(data.email, null, 'token', function () {
    var result = { success: false };
    integrasiWajibOwner_(data.email);
    if (data.konfirmasi !== true) throw new Error('Konfirmasi diperlukan.');
    var k = oauthBacaRegistri_().filter(function (x) { return x.idKoneksi === String(data.idKoneksi || ''); })[0];
    if (!k) throw new Error('Koneksi tidak ditemukan.');
    var props = PropertiesService.getScriptProperties();
    ['ACCESS_TOKEN', 'REFRESH_TOKEN', 'TOKEN_EXPIRED_AT', 'REFRESH_EXPIRED_AT', 'SHOP_ID', 'SHOP_CIPHER', 'SCOPES', 'AUTH_VIA'].forEach(function (s) { props.deleteProperty(k.slot + s); });
    props.deleteProperty('OAUTH_GAGAL_' + k.idKoneksi);
    if (k.slot === 'SHOPEE_' && typeof hapusCacheKredensialShopee === 'function') hapusCacheKredensialShopee();
    k.status = 'Terputus'; k.berlakuSampai = ''; k.oleh = data.email;
    oauthSimpanRegistri_(k);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// Refresh token untuk koneksi toko BARU (slot generik). Slot lama (SHOPEE_/TIKTOK_/CONNER_) tetap
// ditangani fungsi refresh masing-masing yang sudah ada. Pasang trigger per jam: aktifkanRefreshSemuaKoneksi().
function refreshTokenSemuaKoneksi() {
  var props = PropertiesService.getScriptProperties();
  oauthBacaRegistri_().forEach(function (k) {
    if (OAUTH_SLOT_SYNC_AKTIF[k.slot]) return;
    var refresh = props.getProperty(k.slot + 'REFRESH_TOKEN');
    var exp = parseInt(props.getProperty(k.slot + 'TOKEN_EXPIRED_AT') || '0', 10);
    var jeda = k.platform === 'shopee' ? 30 * 60 * 1000 : 24 * 60 * 60 * 1000;
    if (!refresh || (exp && exp - Date.now() > jeda)) return;
    try {
      var set = {};
      if (k.platform === 'shopee') {
        var path = '/api/v2/auth/access_token/get', ts = Math.floor(Date.now() / 1000);
        var res = fetchHemat(getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts + '&sign=' + buatSignatureShopee(path, ts),
          { method: 'post', contentType: 'application/json', muteHttpExceptions: true,
            payload: JSON.stringify({ refresh_token: refresh, shop_id: parseInt(props.getProperty(k.slot + 'SHOP_ID'), 10), partner_id: parseInt(getShopeePartnerId(), 10) }) });
        var d = JSON.parse(res.getContentText());
        if (!d.access_token) throw new Error(res.getContentText().substring(0, 200));
        set[k.slot + 'ACCESS_TOKEN'] = d.access_token; set[k.slot + 'REFRESH_TOKEN'] = d.refresh_token;
        set[k.slot + 'TOKEN_EXPIRED_AT'] = String(Date.now() + d.expire_in * 1000);
      } else {
        var appSlot = tiktokAppUntukSlot_(k.slot);
        var r2 = fetchHemat(tiktokAuthHost_() + '/api/v2/token/refresh?app_key=' + encodeURIComponent(appSlot.appKey) +
          '&app_secret=' + encodeURIComponent(appSlot.appSecret) + '&refresh_token=' + encodeURIComponent(refresh) + '&grant_type=refresh_token',
          { method: 'get', muteHttpExceptions: true });
        var d2 = JSON.parse(r2.getContentText());
        if (!d2.data || !d2.data.access_token) throw new Error(r2.getContentText().substring(0, 200));
        set[k.slot + 'ACCESS_TOKEN'] = d2.data.access_token; set[k.slot + 'REFRESH_TOKEN'] = d2.data.refresh_token;
        set[k.slot + 'TOKEN_EXPIRED_AT'] = String(d2.data.access_token_expire_in * 1000);
      }
      props.setProperties(set);
    } catch (e) { Logger.log('❌ Refresh token ' + k.idKoneksi + ' gagal: ' + e); }
  });
}

function aktifkanRefreshSemuaKoneksi() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'refreshTokenSemuaKoneksi') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('refreshTokenSemuaKoneksi').timeBased().everyHours(1).create();
  Logger.log('✅ Auto-refresh token koneksi toko baru (tiap 1 jam) aktif.');
}

