    if (!mapPembeli[key]) {
      mapPembeli[key] = { nama: nama, alamat: alamat || '', noHp: String(hp || '').trim(), sumberKontak: sumber, segmen: segmen,
        adaDataLengkap: !!(hp || alamat), jumlahPesanan: 0, totalBelanja: 0, terakhirBeli: null, username: username || '' };
