// Batalkan PO - Request Stock yang terhubung ke PO ini otomatis dibalikin jadi pending lagi
// (Status dikosongkan) biar bisa diproses ulang.
function prosesBatalkanPO(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'adminPembelian')) throw new Error('Anda tidak punya izin Admin Pembelian.');
    var noPO = String(data.noPO || '').trim();
    if (!noPO) throw new Error('No PO kosong');

    var sheets = getPurchaseOrderSheets();
    var lastRowHeader = sheets.header.getLastRow();
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 1).getValues();
      for (var h = 0; h < valsHeader.length; h++) {
        if (String(valsHeader[h][0]).trim() === noPO) { sheets.header.getRange(h + 2, 4).setValue('Dibatalkan'); break; }
      }
    }

    // Balikin Request Stock yang terhubung ke PO ini jadi pending lagi (Status dikosongkan)
    var shRequest = getStockRequestSheet();
    var lastRowRequest = shRequest.getLastRow();
    var jumlahDikembalikan = 0;
    if (lastRowRequest > 1) {
      var valsRequest = shRequest.getRange(2, 1, lastRowRequest - 1, 7).getValues();
      valsRequest.forEach(function (row, idx) {
        if (String(row[6]).trim() !== noPO) return; // kolom 7 = No PO
        shRequest.getRange(idx + 2, 6, 1, 2).setValues([['', '']]); // kosongkan Status & No PO
        jumlahDikembalikan++;
      });
    }

    result.success = true;
    result.jumlahDikembalikan = jumlahDikembalikan;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   MODUL PRODUKSI (ROASTERY) - terpisah dari Katalog/Persediaan sales.
   Bahan Baku Roastery -> Resep Produksi -> Cetak Label (otomatis potong
   bahan baku + tambah stock SKU jual yang siap dijual di Waterground Coffee).
   ============================================================ */
/* ============================================================
   PRODUKSI UNIVERSAL: BAHAN BAKU -> FORMULA (BoM, MULTI-LEVEL) -> PERINTAH PRODUKSI (WORK ORDER)
   ------------------------------------------------------------
   Standar ERP, tidak spesifik kopi:
   - BAHAN BAKU  : barang mentah yang TIDAK dijual (SKU bahan, satuan bebas: kg/gram/pcs/...).
                   Stok disimpan di sheet "Bahan Baku", setiap perubahan dicatat di "Mutasi Bahan Baku".
   - FORMULA/BoM : 1 formula = 1 Produk Jadi/Setengah Jadi (dari Produk Master) + daftar komposisi.
                   Komposisi boleh BAHAN BAKU atau PRODUK MASTER -> produksi bertingkat (multi-level):
                     Tahap 1 Roasting : Green Bean (bahan) 1,2 kg  -> Roasted Bean Curah (produk) 1 kg
                     Tahap 2 Packing  : Roasted Bean Curah (produk) 0,2 kg + Pouch + Stiker -> Kopi 200g (produk) 1 pcs
                   Qty komposisi = kebutuhan KOTOR per "Qty Output" formula (susut/penyusutan sudah termasuk).
                   Kolom Susut % hanya pencatat/penghitung (qty = output / (1 - susut)).
   - WORK ORDER  : pilih formula + target -> estimasi kebutuhan (target / qtyOutput x qty komposisi).
                   "Selesaikan Produksi" (1 lock, 1 kali tulis per sheet):
                     bahan baku  -> stok sheet Bahan Baku berkurang + Mutasi "Pakai Produksi"
                     produk      -> Stock Ledger "Pemakaian Produksi" (mengurangi stok)
                     hasil       -> Stock Ledger "Masuk" + Harga Modal Satuan = total biaya bahan / qty hasil
   ============================================================ */
var PROD2_SH_BAHAN = 'Bahan Baku';
var PROD2_SH_MUTASI = 'Mutasi Bahan Baku';
var PROD2_SH_FORMULA = 'Formula Produksi';
var PROD2_SH_FORMULA_D = 'Formula Produksi Detail';
var PROD2_SH_WO = 'Perintah Produksi';
var PROD2_SH_WO_D = 'Perintah Produksi Detail';
var PROD2_HDR_BAHAN = ['SKU Bahan', 'Nama Bahan', 'Satuan', 'Stok', 'Harga per Satuan', 'Stok Minimum', 'Kategori', 'Aktif', 'Diperbarui', 'Catatan'];
var PROD2_HDR_MUTASI = ['Tanggal', 'SKU Bahan', 'Jenis', 'Qty (+/-)', 'Stok Setelah', 'Referensi', 'Oleh'];
var PROD2_HDR_FORMULA = ['Kode Formula', 'Nama Formula', 'Tahap', 'SKU Output', 'Nama Output', 'Qty Output', 'Satuan Output', 'Catatan', 'Aktif', 'Diperbarui', 'Oleh'];
var PROD2_HDR_FORMULA_D = ['Kode Formula', 'Tipe Item', 'SKU Item', 'Nama Item', 'Qty', 'Satuan', 'Susut (%)'];
var PROD2_HDR_WO = ['No WO', 'Tanggal', 'Kode Formula', 'Nama Formula', 'Tahap', 'SKU Output', 'Nama Output', 'Target Qty', 'Qty Hasil', 'Satuan Output', 'Status', 'Total Biaya Bahan', 'HPP per Unit', 'Dibuat Oleh', 'Catatan'];
var PROD2_HDR_WO_D = ['No WO', 'Tipe Item', 'SKU Item', 'Nama Item', 'Qty Rencana', 'Qty Aktual', 'Satuan', 'Biaya Satuan', 'Subtotal Biaya'];

function prod2Sheet_(nama, header, kolomTeks) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(nama);
  if (!sh) {
    sh = ss.insertSheet(nama);
    sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
    sh.setFrozenRows(1);
    (kolomTeks || []).forEach(function (c) { sh.getRange(2, c, 2000, 1).setNumberFormat('@'); });
    if (nama === PROD2_SH_BAHAN) prod2ImporBahanLama_(sh);
  }
  return sh;
}

// Sekali saja: bahan dari modul lama "Bahan Baku Roastery" (satuan gram) ikut dipindah
function prod2ImporBahanLama_(sh) {
  try {
    var lama = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Bahan Baku Roastery');
    if (!lama || lama.getLastRow() < 2) return;
    var baris = lama.getRange(2, 1, lama.getLastRow() - 1, 2).getValues().filter(function (r) { return String(r[0] || '').trim(); })
      .map(function (r, i) { return ['BB-' + ('00' + (i + 1)).slice(-3), String(r[0]).trim(), 'gram', Number(r[1]) || 0, 0, 0, 'Impor Roastery', true, new Date(), 'Diimpor dari Bahan Baku Roastery']; });
    if (baris.length) sh.getRange(2, 1, baris.length, PROD2_HDR_BAHAN.length).setValues(baris);
  } catch (e) { Logger.log('Impor bahan lama dilewati: ' + e); }
}

function prod2Izin_(email) {
  return cekIzin(email, 'buatInvoice') || cekIzin(email, 'mintaStock') || cekIzin(email, 'adminPembelian');
}
function prod2Num_(v) { var n = parseFloat(String(v === undefined || v === null ? '' : v).replace(',', '.')); return isNaN(n) ? 0 : n; }
function prod2Bulat_(n) { return Math.round((Number(n) || 0) * 10000) / 10000; }

function prod2BacaBahan_() {
  var sh = prod2Sheet_(PROD2_SH_BAHAN, PROD2_HDR_BAHAN, [1]), lr = sh.getLastRow(), out = [];
  if (lr > 1) sh.getRange(2, 1, lr - 1, PROD2_HDR_BAHAN.length).getValues().forEach(function (r, i) {
    var sku = String(r[0] || '').trim();
    if (!sku) return;
    out.push({ row: i + 2, sku: sku, nama: String(r[1] || ''), satuan: String(r[2] || 'pcs'), stok: prod2Bulat_(r[3]), harga: Number(r[4]) || 0,
      stokMin: Number(r[5]) || 0, kategori: String(r[6] || ''), aktif: r[7] !== false && String(r[7]).toUpperCase() !== 'FALSE', catatan: String(r[9] || '') });
  });
  return out;
}

function prod2BacaFormula_() {
  var sh = prod2Sheet_(PROD2_SH_FORMULA, PROD2_HDR_FORMULA, [1, 4]), shD = prod2Sheet_(PROD2_SH_FORMULA_D, PROD2_HDR_FORMULA_D, [1, 3]);
  var lr = sh.getLastRow(), out = [], per = {};
  if (lr > 1) sh.getRange(2, 1, lr - 1, PROD2_HDR_FORMULA.length).getValues().forEach(function (r, i) {
    var kode = String(r[0] || '').trim();
    if (!kode) return;
    var f = { row: i + 2, kode: kode, nama: String(r[1] || ''), tahap: String(r[2] || ''), skuOutput: String(r[3] || '').trim(), namaOutput: String(r[4] || ''),
      qtyOutput: Number(r[5]) || 1, satuanOutput: String(r[6] || 'pcs'), catatan: String(r[7] || ''), aktif: r[8] !== false && String(r[8]).toUpperCase() !== 'FALSE', item: [] };
    out.push(f); per[kode] = f;
  });
  var lrD = shD.getLastRow();
  if (lrD > 1) shD.getRange(2, 1, lrD - 1, PROD2_HDR_FORMULA_D.length).getValues().forEach(function (r, i) {
    var f = per[String(r[0] || '').trim()];
    if (f) f.item.push({ row: i + 2, tipe: String(r[1] || 'BAHAN').toUpperCase() === 'PRODUK' ? 'PRODUK' : 'BAHAN', sku: String(r[2] || '').trim(), nama: String(r[3] || ''), qty: Number(r[4]) || 0, satuan: String(r[5] || ''), susut: r[6] === '' ? null : Number(r[6]) || 0 });
  });
  return out;
}

function prod2BacaWo_(batas) {
  var sh = prod2Sheet_(PROD2_SH_WO, PROD2_HDR_WO, [1, 3, 6]), lr = sh.getLastRow(), out = [], tz = Session.getScriptTimeZone();
  if (lr < 2) return out;
  var n = Math.min(lr - 1, batas || 100);
  sh.getRange(lr - n + 1, 1, n, PROD2_HDR_WO.length).getValues().forEach(function (r) {
    if (!String(r[0] || '').trim()) return;
    out.push({ noWo: String(r[0]), tanggal: r[1] instanceof Date ? Utilities.formatDate(r[1], tz, 'dd MMM yyyy, HH:mm') : String(r[1] || ''), tanggalMs: r[1] instanceof Date ? r[1].getTime() : 0,
      kodeFormula: String(r[2] || ''), namaFormula: String(r[3] || ''), tahap: String(r[4] || ''), skuOutput: String(r[5] || ''), namaOutput: String(r[6] || ''),
      target: Number(r[7]) || 0, hasil: Number(r[8]) || 0, satuanOutput: String(r[9] || ''), status: String(r[10] || ''), totalBiaya: Number(r[11]) || 0, hppUnit: Number(r[12]) || 0, oleh: String(r[13] || ''), catatan: String(r[14] || '') });
  });
  return out.reverse();
}

// Produk Master ringkas: sku -> { nama, hpp }
function prod2MasterRingkas_() {
  var peta = {};
  var sh = getMasterProdukSheet(), lr = sh.getLastRow();
  if (lr > 1) sh.getRange(2, 1, lr - 1, 4).getValues().forEach(function (r) {
    var sku = String(r[0] || '').trim();
    if (sku) peta[sku.toUpperCase()] = { sku: sku, nama: String(r[1] || ''), hpp: Number(r[3]) || 0 };
  });
  return peta;
}

// ===== AKSI: prod2_data - semua data halaman Produksi dalam 1 request
function prosesProd2Data(data) {
  var result = { success: false };
  try {
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    result.bahan = prod2BacaBahan_();
    result.formula = prod2BacaFormula_();
    result.wo = prod2BacaWo_(60);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: prod2_simpan_bahan - tambah / ubah master bahan baku (stok awal hanya saat tambah)
function prosesProd2SimpanBahan(data) {
  return withTransaction(data.email, null, ['produksi', 'stok'], function () {
    var result = { success: false };
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    var b = data.bahan || {};
    var sku = String(b.sku || '').trim().toUpperCase(), nama = String(b.nama || '').trim(), satuan = String(b.satuan || '').trim() || 'pcs';
    if (!sku || !nama) throw new Error('SKU bahan dan Nama bahan wajib diisi.');
    if (!/^[A-Z0-9._\-\/]+$/.test(sku)) throw new Error('SKU bahan hanya boleh huruf, angka, titik, strip, garis bawah.');
    var master = prod2MasterRingkas_();
    if (master[sku]) throw new Error('SKU ' + sku + ' sudah dipakai di Produk Master. Pakai SKU lain untuk bahan baku (misal awalan BB-).');
    var sh = prod2Sheet_(PROD2_SH_BAHAN, PROD2_HDR_BAHAN, [1]);
    var semua = prod2BacaBahan_();
    var ada = semua.filter(function (x) { return x.sku.toUpperCase() === sku; })[0];
    var oleh = getNamaStaff(data.email) || data.email, sekarang = new Date();
    if (ada) {
      sh.getRange(ada.row, 2, 1, 2).setValues([[nama, satuan]]);
      sh.getRange(ada.row, 5, 1, 6).setValues([[prod2Num_(b.harga), prod2Num_(b.stokMin), String(b.kategori || ''), b.aktif !== false, sekarang, String(b.catatan || '')]]);
    } else {
      var stokAwal = prod2Num_(b.stok);
      var row = sh.getLastRow() + 1;
      sh.getRange(row, 1).setNumberFormat('@');
      sh.getRange(row, 1, 1, PROD2_HDR_BAHAN.length).setValues([[sku, nama, satuan, stokAwal, prod2Num_(b.harga), prod2Num_(b.stokMin), String(b.kategori || ''), true, sekarang, String(b.catatan || '')]]);
      if (stokAwal) prod2Sheet_(PROD2_SH_MUTASI, PROD2_HDR_MUTASI, [2]).appendRow([sekarang, sku, 'Stok Awal', stokAwal, stokAwal, 'Tambah bahan baru', oleh]);
    }
    result.success = true;
    result.bahan = prod2BacaBahan_();
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// ===== AKSI: prod2_mutasi_bahan - stok masuk (pembelian) / penyesuaian (+/-) / set hasil hitung fisik
function prosesProd2MutasiBahan(data) {
  return withTransaction(data.email, null, ['produksi', 'stok'], function () {
    var result = { success: false };
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    var sku = String(data.sku || '').trim().toUpperCase(), jenis = String(data.jenis || 'Masuk'), qty = prod2Num_(data.qty);
    var b = prod2BacaBahan_().filter(function (x) { return x.sku.toUpperCase() === sku; })[0];
    if (!b) throw new Error('Bahan ' + sku + ' tidak ditemukan.');
    var baru;
    if (jenis === 'Opname') baru = qty;                 // qty = hasil hitung fisik
    else if (jenis === 'Masuk') baru = b.stok + Math.abs(qty);
    else baru = b.stok + qty;                            // Penyesuaian: qty boleh minus
    if (baru < 0) throw new Error('Stok ' + b.nama + ' tidak boleh minus (sekarang ' + b.stok + ' ' + b.satuan + ').');
    var sh = prod2Sheet_(PROD2_SH_BAHAN, PROD2_HDR_BAHAN, [1]);
    sh.getRange(b.row, 4).setValue(prod2Bulat_(baru));
    sh.getRange(b.row, 9).setValue(new Date());
    if (jenis === 'Masuk' && prod2Num_(data.harga) > 0) sh.getRange(b.row, 5).setValue(prod2Num_(data.harga));
    prod2Sheet_(PROD2_SH_MUTASI, PROD2_HDR_MUTASI, [2]).appendRow([new Date(), b.sku, jenis, prod2Bulat_(baru - b.stok), prod2Bulat_(baru), String(data.referensi || ''), getNamaStaff(data.email) || data.email]);
    result.success = true;
    result.bahan = prod2BacaBahan_();
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// ===== AKSI: prod2_simpan_formula - tambah / ubah formula (BoM) beserta komposisinya
function prosesProd2SimpanFormula(data) {
  return withTransaction(data.email, null, ['produksi'], function () {
    var result = { success: false };
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    var f = data.formula || {};
    var skuOut = String(f.skuOutput || '').trim(), nama = String(f.nama || '').trim();
    var master = prod2MasterRingkas_();
    var mOut = master[skuOut.toUpperCase()];
    if (!mOut) throw new Error('Produk hasil (' + (skuOut || 'kosong') + ') harus dipilih dari Produk Master.');
    var qtyOut = prod2Num_(f.qtyOutput);
    if (qtyOut <= 0) throw new Error('Qty Output harus lebih dari 0.');
    var bahanPeta = {};
    prod2BacaBahan_().forEach(function (x) { bahanPeta[x.sku.toUpperCase()] = x; });
    var item = (f.item || []).map(function (it) {
      var sku = String(it.sku || '').trim(), tipe = String(it.tipe || '').toUpperCase() === 'PRODUK' ? 'PRODUK' : 'BAHAN';
      var sumber = tipe === 'PRODUK' ? master[sku.toUpperCase()] : bahanPeta[sku.toUpperCase()];
      if (!sumber) throw new Error('Komposisi ' + sku + ' tidak ditemukan di ' + (tipe === 'PRODUK' ? 'Produk Master' : 'Bahan Baku') + '.');
      var qty = prod2Num_(it.qty);
      if (qty <= 0) throw new Error('Qty komposisi ' + sku + ' harus lebih dari 0.');
      if (tipe === 'PRODUK' && sumber.sku.toUpperCase() === mOut.sku.toUpperCase()) throw new Error('Produk hasil tidak boleh menjadi komposisinya sendiri.');
      return [tipe, sumber.sku, sumber.nama, qty, String(it.satuan || (tipe === 'BAHAN' ? sumber.satuan : 'pcs')), it.susut === '' || it.susut === null || it.susut === undefined ? '' : prod2Num_(it.susut)];
    });
    if (!item.length) throw new Error('Tambahkan minimal 1 komposisi (bahan / produk).');
    var dupe = {};
    item.forEach(function (x) { var k = x[0] + '|' + x[1].toUpperCase(); if (dupe[k]) throw new Error('Komposisi ' + x[1] + ' dimasukkan 2 kali.'); dupe[k] = 1; });

    var semua = prod2BacaFormula_();
    var kode = String(f.kode || '').trim();
    var lama = kode ? semua.filter(function (x) { return x.kode === kode; })[0] : null;
    if (kode && !lama) throw new Error('Formula ' + kode + ' tidak ditemukan (mungkin sudah dihapus).');
    // Cegah lingkaran multi-level: A butuh B, B butuh A
    var perOutput = {};
    semua.forEach(function (x) { if (x.aktif && (!lama || x.kode !== lama.kode)) (perOutput[x.skuOutput.toUpperCase()] = perOutput[x.skuOutput.toUpperCase()] || []).push(x); });
    function pakai(skuCari, sudah) {
      var list = perOutput[skuCari] || [];
      for (var i = 0; i < list.length; i++) for (var j = 0; j < list[i].item.length; j++) {
        var it = list[i].item[j];
        if (it.tipe !== 'PRODUK') continue;
        var k = it.sku.toUpperCase();
        if (k === mOut.sku.toUpperCase()) return true;
        if (!sudah[k]) { sudah[k] = 1; if (pakai(k, sudah)) return true; }
      }
      return false;
    }
    item.forEach(function (x) { if (x[0] === 'PRODUK' && pakai(x[1].toUpperCase(), {})) throw new Error('Formula melingkar: ' + x[1] + ' (langsung / tidak langsung) dibuat dari ' + mOut.sku + '.'); });

    var sh = prod2Sheet_(PROD2_SH_FORMULA, PROD2_HDR_FORMULA, [1, 4]), shD = prod2Sheet_(PROD2_SH_FORMULA_D, PROD2_HDR_FORMULA_D, [1, 3]);
    var oleh = getNamaStaff(data.email) || data.email;
    if (!kode) {
      var maks = 0;
      semua.forEach(function (x) { var m = /^BOM-(\d+)$/.exec(x.kode); if (m) maks = Math.max(maks, parseInt(m[1], 10)); });
      kode = 'BOM-' + ('000' + (maks + 1)).slice(-4);
    }
    var baris = [kode, nama || ('Formula ' + mOut.nama), String(f.tahap || '').trim(), mOut.sku, mOut.nama, qtyOut, String(f.satuanOutput || 'pcs'), String(f.catatan || ''), f.aktif !== false, new Date(), oleh];
    if (lama) sh.getRange(lama.row, 1, 1, baris.length).setValues([baris]);
    else { var r = sh.getLastRow() + 1; sh.getRange(r, 1, 1, 4).setNumberFormat('@'); sh.getRange(r, 1, 1, baris.length).setValues([baris]); }
    // Komposisi lama dihapus (dari bawah ke atas agar nomor baris tidak bergeser), lalu ditulis ulang
    if (lama) lama.item.map(function (x) { return x.row; }).sort(function (a, b) { return b - a; }).forEach(function (rw) { shD.deleteRow(rw); });
    var mulai = shD.getLastRow() + 1;
    shD.getRange(mulai, 1, item.length, 3).setNumberFormat('@');
    shD.getRange(mulai, 1, item.length, PROD2_HDR_FORMULA_D.length).setValues(item.map(function (x) { return [kode].concat(x); }));
    result.success = true;
    result.kode = kode;
    result.formula = prod2BacaFormula_();
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// ===== AKSI: prod2_hapus_formula - dinonaktifkan (riwayat Work Order tetap utuh)
function prosesProd2HapusFormula(data) {
  return withTransaction(data.email, null, ['produksi'], function () {
    var result = { success: false };
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    var f = prod2BacaFormula_().filter(function (x) { return x.kode === String(data.kode || '').trim(); })[0];
    if (!f) throw new Error('Formula tidak ditemukan.');
    prod2Sheet_(PROD2_SH_FORMULA, PROD2_HDR_FORMULA, [1, 4]).getRange(f.row, 9, 1, 3).setValues([[false, new Date(), getNamaStaff(data.email) || data.email]]);
    result.success = true;
    result.formula = prod2BacaFormula_();
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// Hitung kebutuhan + ketersediaan + biaya (dipakai estimasi & eksekusi)
function prod2Hitung_(f, target, aktualPerSku, stokProdukSegar, email) {
  var bahanPeta = {};
  prod2BacaBahan_().forEach(function (x) { bahanPeta[x.sku.toUpperCase()] = x; });
  var master = prod2MasterRingkas_();
  var stokProduk = {};
  if (f.item.some(function (it) { return it.tipe === 'PRODUK'; })) {
    try { smNaikkanVersiStok_(); } catch (eV) { }
    if (stokProdukSegar) { try { CacheService.getScriptCache().removeAll(['POSISI_STOCK_default__meta', 'POSISI_STOCK_default']); } catch (e) {} }
    // Izin modul Produksi sudah dicek di pemanggil; posisi stok dibaca sebagai proses sistem
    var izinLama = IZIN_SISTEM_;
    IZIN_SISTEM_ = true;
    var pos;
    try { pos = prosesLihatStock({ email: email || '' }); } finally { IZIN_SISTEM_ = izinLama; }
    if (pos && pos.success) pos.daftar.forEach(function (d) { stokProduk[String(d.sku).toUpperCase()] = Number(d.stockSaatIni) || 0; });
  }
  var faktor = target / (f.qtyOutput || 1);
  var semuaFormula = null;
  var baris = f.item.map(function (it) {
    var k = it.sku.toUpperCase();
    var rencana = prod2Bulat_(it.qty * faktor);
    var aktual = aktualPerSku && aktualPerSku[it.tipe + '|' + k] !== undefined && aktualPerSku[it.tipe + '|' + k] !== '' ? prod2Bulat_(prod2Num_(aktualPerSku[it.tipe + '|' + k])) : rencana;
    var stok, biaya, satuan = it.satuan;
    if (it.tipe === 'BAHAN') { var b = bahanPeta[k] || {}; stok = b.stok || 0; biaya = b.harga || 0; satuan = satuan || b.satuan || ''; }
    else { stok = stokProduk[k] !== undefined ? stokProduk[k] : 0; biaya = (master[k] || {}).hpp || 0; }
    var kurang = Math.max(0, prod2Bulat_(aktual - stok));
    var subFormula = null;
    if (it.tipe === 'PRODUK') {
      semuaFormula = semuaFormula || prod2BacaFormula_();
      var sf = semuaFormula.filter(function (x) { return x.aktif && x.skuOutput.toUpperCase() === k; })[0];
      if (sf) subFormula = { kode: sf.kode, nama: sf.nama, tahap: sf.tahap, qtyOutput: sf.qtyOutput, satuanOutput: sf.satuanOutput };
    }
    return { tipe: it.tipe, sku: it.sku, nama: it.nama, satuan: satuan, qtyPerBatch: it.qty, susut: it.susut, rencana: rencana, aktual: aktual,
      stok: prod2Bulat_(stok), kurang: kurang, cukup: kurang <= 0, biayaSatuan: biaya, subtotal: Math.round(biaya * aktual), subFormula: subFormula,
      ditemukan: it.tipe === 'BAHAN' ? !!bahanPeta[k] : !!master[k] };
  });
  var total = baris.reduce(function (s, x) { return s + x.subtotal; }, 0);
  return { faktor: faktor, baris: baris, totalBiaya: total, semuaCukup: baris.every(function (x) { return x.cukup; }) };
}

// ===== AKSI: prod2_estimasi - estimasi bahan terpotong untuk target tertentu
function prosesProd2Estimasi(data) {
  var result = { success: false };
  try {
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    var f = prod2BacaFormula_().filter(function (x) { return x.kode === String(data.kode || '').trim(); })[0];
    if (!f) throw new Error('Formula tidak ditemukan.');
    var target = prod2Num_(data.target);
    if (target <= 0) throw new Error('Target produksi harus lebih dari 0.');
    var h = prod2Hitung_(f, target, data.aktual || null, false, data.email);
    var hasil = prod2Num_(data.hasilAktual) || target;
    result = { success: true, formula: f, target: target, hasilAktual: hasil, baris: h.baris, totalBiaya: h.totalBiaya, hppUnit: hasil ? Math.round(h.totalBiaya / hasil) : 0, semuaCukup: h.semuaCukup };
  } catch (err) { result = { success: false, error: err.toString() }; }
  return result;
}

// ===== AKSI: prod2_selesaikan - SELESAIKAN PRODUKSI: potong bahan + tambah stok hasil (1 transaksi)
function prosesProd2Selesaikan(data) {
  var result = { success: false };
  var cache = CacheService.getScriptCache();
  var idp = String(data.idPermintaan || '').trim();
  if (idp) { var sudah = cache.get('PROD2_ID_' + idp); if (sudah) return JSON.parse(sudah); } // tombol ditekan 2x / retry jaringan
  var lock = kunciModul_(['produksi', 'stok']);
  try { lock.waitLock(20000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  try {
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    var f = prod2BacaFormula_().filter(function (x) { return x.kode === String(data.kode || '').trim(); })[0];
    if (!f) throw new Error('Formula tidak ditemukan.');
    if (!f.aktif) throw new Error('Formula ' + f.kode + ' sudah dinonaktifkan.');
    var target = prod2Num_(data.target);
    if (target <= 0) throw new Error('Target produksi harus lebih dari 0.');
    var hasilQty = prod2Num_(data.hasilAktual) || target;
    if (hasilQty <= 0) throw new Error('Qty hasil harus lebih dari 0.');

    var h = prod2Hitung_(f, target, data.aktual || null, true, data.email); // stok produk dihitung SEGAR di dalam lock
    var hilang = h.baris.filter(function (x) { return !x.ditemukan; });
    if (hilang.length) throw new Error('Komposisi tidak ditemukan lagi: ' + hilang.map(function (x) { return x.sku; }).join(', ') + '. Perbarui formula.');
    var kurang = h.baris.filter(function (x) { return !x.cukup; });
    if (kurang.length && !data.izinkanMinus) {
      result.kurang = kurang;
      throw new Error('Stok tidak cukup: ' + kurang.map(function (x) { return x.nama + ' kurang ' + x.kurang + ' ' + x.satuan; }).join(' · '));
    }

    var sekarang = new Date(), oleh = getNamaStaff(data.email) || data.email, tz = Session.getScriptTimeZone();
    var shWo = prod2Sheet_(PROD2_SH_WO, PROD2_HDR_WO, [1, 3, 6]);
    var awalan = 'WO' + Utilities.formatDate(sekarang, tz, 'yyMMdd') + '-', urut = 0;
    var lrWo = shWo.getLastRow();
    if (lrWo > 1) shWo.getRange(Math.max(2, lrWo - 300), 1, Math.min(lrWo - 1, 301), 1).getValues().forEach(function (r) {
      var v = String(r[0] || '');
      if (v.indexOf(awalan) === 0) urut = Math.max(urut, parseInt(v.slice(awalan.length), 10) || 0);
    });
    var noWo = awalan + ('0' + (urut + 1)).slice(-2);
    var ref = 'Produksi ' + noWo + ' (' + f.nama + ')';

    // 1) Bahan baku: kurangi stok (1 kali tulis kolom Stok) + mutasi
    var bahanDipakai = h.baris.filter(function (x) { return x.tipe === 'BAHAN' && x.aktual > 0; });
    if (bahanDipakai.length) {
      var shB = prod2Sheet_(PROD2_SH_BAHAN, PROD2_HDR_BAHAN, [1]);
      var semuaB = prod2BacaBahan_(), perSku = {};
      semuaB.forEach(function (b) { perSku[b.sku.toUpperCase()] = b; });
      var mutasi = [];
      bahanDipakai.forEach(function (x) {
        var b = perSku[x.sku.toUpperCase()];
        b.stok = prod2Bulat_(b.stok - x.aktual);
        shB.getRange(b.row, 4).setValue(b.stok);
        shB.getRange(b.row, 9).setValue(sekarang);
        mutasi.push([sekarang, b.sku, 'Pakai Produksi', -x.aktual, b.stok, ref, oleh]);
      });
      var shM = prod2Sheet_(PROD2_SH_MUTASI, PROD2_HDR_MUTASI, [2]);
      shM.getRange(shM.getLastRow() + 1, 1, mutasi.length, PROD2_HDR_MUTASI.length).setValues(mutasi);
    }

    // 2) Stock Ledger: produk komposisi keluar ("Pemakaian Produksi") + produk hasil masuk
    var hppUnit = hasilQty ? Math.round(h.totalBiaya / hasilQty) : 0;
    var ledger = h.baris.filter(function (x) { return x.tipe === 'PRODUK' && x.aktual > 0; })
      .map(function (x) { return [sekarang, x.sku, 'Pemakaian Produksi', x.aktual, ref, oleh, '', x.biayaSatuan || '']; });
    ledger.push([sekarang, f.skuOutput, 'Masuk', hasilQty, 'Hasil ' + ref, oleh, '', hppUnit || '']);
    var shL = getStockLedgerSheet();
    shL.getRange(shL.getLastRow() + 1, 1, ledger.length, 8).setValues(ledger);

    // 3) Catat Work Order + rincian
    var catatan = String(data.catatan || '') + (kurang.length ? ' [dipaksa walau stok kurang: ' + kurang.map(function (x) { return x.sku; }).join(', ') + ']' : '');
    var rowWo = shWo.getLastRow() + 1;
    shWo.getRange(rowWo, 1).setNumberFormat('@');
    shWo.getRange(rowWo, 1, 1, PROD2_HDR_WO.length).setValues([[noWo, sekarang, f.kode, f.nama, f.tahap, f.skuOutput, f.namaOutput, target, hasilQty, f.satuanOutput, 'Selesai', h.totalBiaya, hppUnit, oleh, catatan]]);
    var shWd = prod2Sheet_(PROD2_SH_WO_D, PROD2_HDR_WO_D, [1, 3]);
    shWd.getRange(shWd.getLastRow() + 1, 1, h.baris.length, PROD2_HDR_WO_D.length).setValues(h.baris.map(function (x) {
      return [noWo, x.tipe, x.sku, x.nama, x.rencana, x.aktual, x.satuan, x.biayaSatuan, x.subtotal];
    }));
    SpreadsheetApp.flush();
    try { smNaikkanVersiStok_(); } catch (eV) { }
    try { CacheService.getScriptCache().removeAll(['POSISI_STOCK_default__meta', 'POSISI_STOCK_default', 'POSISI_STOK_LENGKAP_default', SM_CACHE_MONITOR]); } catch (eC) {}

    result = { success: true, noWo: noWo, hasilQty: hasilQty, skuOutput: f.skuOutput, namaOutput: f.namaOutput, satuanOutput: f.satuanOutput, totalBiaya: h.totalBiaya, hppUnit: hppUnit,
      dipotong: h.baris.map(function (x) { return { tipe: x.tipe, sku: x.sku, nama: x.nama, qty: x.aktual, satuan: x.satuan }; }), bahan: prod2BacaBahan_(), wo: prod2BacaWo_(60) };
    if (idp) cache.put('PROD2_ID_' + idp, JSON.stringify({ success: true, noWo: noWo, duplikat: true }), 600);
  } catch (err) { result.success = false; result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

