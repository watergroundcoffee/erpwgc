// ===== AKSI: cari_pesanan_sku { q } -> pesanan yang berisi produk dengan SKU itu (jenis SKU apa pun) =====
// Sasaran: SKU Produk Master yang cocok PERSIS; kalau tidak ada yang persis, yang mengandung kata kunci (maks 10 produk).
// Pesanan diambil dari rincian SKU per pesanan (Shopee / TikTok Shop / Conner / PO Sales); SKU lama di rincian
// ikut diterjemahkan ke SKU Produk Master saat dicari, jadi mapping yang dibuat belakangan tetap terhitung.
function prosesCariPesananSku(data) {
  try {
    data = data || {};
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var kq = cskNorm_(data.q);
    var out = { success: true, q: String(data.q || ''), kunci: kq, sasaran: [], pesanan: {}, jumlahPesanan: 0, jumlahQty: 0 };
    if (kq.length < 3) return out;
    var cache = CacheService.getScriptCache(), kunci = 'CPS_V1_' + kq.slice(0, 60);
    var c = cache.get(kunci);
    if (c) { try { var o = JSON.parse(c); o.dariCache = true; return o; } catch (eC) { } }
    var t = cskTemukan_(data.q);
    var persis = t.hasil.filter(function (h) { return h.persis; });
    var pilih = persis.length ? persis : (t.hasil.length <= 10 ? t.hasil : []);
    var target = {};
    pilih.forEach(function (h) { target[String(h.sku).toUpperCase()] = h; });
    out.sasaran = pilih.map(function (h) { return { sku: h.sku, nama: h.nama, arsip: h.arsip, persis: h.persis }; });
    out.terlaluBanyak = !persis.length && t.hasil.length > 10 ? t.hasil.length : 0;
    out.tidakTerhubung = t.tidakTerhubung.filter(function (x) { return x.persis; });
    cskBarisDetail_().forEach(function (b) {
      var induk = String(resolveSkuJualCepat_(b.sku) || '').toUpperCase();
      var cocok = target[induk] || (!persis.length && cskNorm_(b.sku) === kq);
      if (!cocok) return;
      var e = out.pesanan[b.id] || (out.pesanan[b.id] = { qty: 0, kanal: b.kanal, sku: target[induk] ? target[induk].sku : b.sku });
      e.qty += b.qty; out.jumlahQty += b.qty;
    });
    out.jumlahPesanan = Object.keys(out.pesanan).length;
    if (out.jumlahPesanan > 3000) { // jaga ukuran jawaban
      var ids = Object.keys(out.pesanan).slice(-3000), kecil = {};
      ids.forEach(function (id) { kecil[id] = out.pesanan[id]; });
      out.pesanan = kecil; out.dipotong = true;
    }
    try { var js = JSON.stringify(out); if (js.length < 90000) cache.put(kunci, js, 120); } catch (eP) { }
    return out;
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

