function finKanalLedger_(jenis, keterangan, idTokopedia) {
  var j = String(jenis || ''), k = String(keterangan || '');
  if (/PO Sales/i.test(j)) return 'PO Sales';
  if (/conner/i.test(k)) return 'Conner Hardware';
  if (/shopee/i.test(k)) return 'Shopee';
