    baris.push('  - ' + (b.label || b.nama) + ': ' + copilotRp_(b.nilai));
  });
  baris.push('- Laba bersih: ' + copilotRp_(lr.labaBersih) + ' (margin bersih ' + copilotPct_(lr.marginBersih) + ')');
  var omzetMp = (lr.pendapatan || []).filter(function (p) { return /shopee|tiktok|tokopedia/i.test(p.kanal || p.nama); })
    .reduce(function (s, p) { return s + p.nilai; }, 0);
  baris.push('- Biaya iklan & promosi bulan ini: ' + copilotRp_(iklan) + (iklan ? ' | ROAS marketplace ≈ ' + (Math.round(omzetMp / iklan * 10) / 10) + 'x (omzet marketplace ' + copilotRp_(omzetMp) + ')' : ' | ROAS: belum ada data biaya iklan (sinkron di Finance > Mutasi Kas > ⟳ Sinkron Biaya Iklan)'));
