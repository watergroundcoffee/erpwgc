    if (idx.kunci[k]) { var lama = idx.kunci[k]; if (!lama.alamat && c.alamat) { lama.alamat = c.alamat; lama.wilN = c.wilN; } if (!lama.userN && c.userN) lama.userN = c.userN; return; }
