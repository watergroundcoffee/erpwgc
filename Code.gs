function promoTarikAffiliateTiktok_(hariMundur, batasWaktu) {
  var akhir = Math.floor(Date.now() / 1000), awal = akhir - hariMundur * 86400;
  var orders, peringatan = [];
  try {
    orders = promoTiktokCariSemua_(promoPath_('TTS_AFF_ORDER_SEARCH'), { create_time_ge: awal, create_time_lt: akhir }, ['orders', 'order_list', 'affiliate_orders'], 20, batasWaktu);
  } catch (e) {
    if (/param|create_time/i.test(e.message)) orders = promoTiktokCariSemua_(promoPath_('TTS_AFF_ORDER_SEARCH'), {}, ['orders', 'order_list', 'affiliate_orders'], 20, batasWaktu);
    else throw new Error('Order affiliate: ' + e.message);
  }
  var barisOrder = [];
  orders.forEach(function (o) {
    var oid = String(o.order_id || o.id || '');
    var tgl = promoDetik_(o.create_time || o.order_create_time || o.paid_time);
    var creatorO = String(promoCari_(o, ['creator_username', 'username', 'creator_nickname', 'nickname', 'creator_user_id', 'creator_id']) || '-');
    var items = o.skus || o.items || o.line_items || o.order_lines || [o];
    items.forEach(function (it, i) {
      var creator = String(promoCari_(it, ['creator_username', 'username', 'creator_nickname', 'nickname'], 1) || creatorO);
      var rate = promoAngka_(promoCari_(it, ['commission_rate', 'standard_commission_rate', 'actual_commission_rate', 'open_collaboration_commission_rate']));
      if (rate > 100) rate = rate / 100; // basis poin (1000 = 10%)
      var qty = promoAngka_(promoCari_(it, ['quantity', 'qty', 'sku_quantity'])) || 1;
      var gmv = promoAngka_(promoCari_(it, ['gmv', 'payment_amount', 'sale_price', 'price', 'total_amount']));
      var kom = promoAngka_(promoCari_(it, ['actual_commission', 'actual_commission_amount', 'estimated_commission', 'estimated_commission_amount', 'commission_amount', 'commission']));
      if (!kom && rate && gmv) kom = Math.round(gmv * rate / 100);
      barisOrder.push(['TikTok Shop', oid, promoFmtWaktu_(tgl), creator, String(promoCari_(it, ['product_name', 'product_title', 'title', 'sku_name']) || '-'),
        String(promoCari_(it, ['seller_sku', 'sku_id', 'sku', 'product_id']) || ''), qty, gmv, rate || '', kom,
        String(promoCari_(o, ['order_status', 'status', 'commission_status']) || ''), oid + '#' + i]);
    });
  });
  var barisSampel = [];
  try {
    promoTiktokCariSemua_(promoPath_('TTS_AFF_SAMPLE_SEARCH'), {}, ['sample_applications', 'applications', 'sample_application_list'], 10, batasWaktu).forEach(function (a) {
      var t = promoDetik_(a.create_time || a.apply_time || a.application_time);
      barisSampel.push(['TikTok Shop', String(a.id || a.application_id || ''), promoFmtWaktu_(t),
        String(promoCari_(a, ['creator_username', 'username', 'nickname', 'creator_nickname', 'creator_user_id']) || '-'),
        promoAngka_(promoCari_(a, ['follower_count', 'followers', 'fans_count'])) || '',
        String(promoCari_(a, ['product_title', 'product_name', 'title']) || '-'),
        String(a.status || a.application_status || a.review_status || '-'),
        String(promoCari_(a, ['reject_reason', 'fulfillment_status', 'shipping_status', 'tracking_number']) || '')]);
    });
  } catch (e) { peringatan.push('Sampel: ' + e.message); }
  return { order: barisOrder, sampel: barisSampel, peringatan: peringatan.join(' | ') };
}

/* ---------- AKSI: promo_sinkron { jenis: kode|bundling|kalender|affiliate, hariMundur? } ---------- */
function prosesPromoSinkron(data) {
  if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  var jenis = String(data.jenis || 'kode');
  if (['kode', 'bundling', 'kalender', 'affiliate'].indexOf(jenis) < 0) return { success: false, error: 'Jenis sinkron tidak dikenal: ' + jenis };
  var mutex = kunciSinkronAmbil_('PROMO_' + jenis.toUpperCase(), 600);
  if (!mutex) return { success: true, sedangJalan: true, pesan: 'Sinkron ' + jenis + ' sedang berjalan di proses lain.' };
  var batasWaktu = Date.now() + 4.5 * 60 * 1000, hasil = {};
  try {
    if (data.segar) CacheService.getScriptCache().remove('PROMO_TTS_AKTIVITAS');
    var tugas = {
      kode: [['Shopee', function () { return { key: 'kode', baris: promoTarikKodeShopee_(batasWaktu) }; }],
             ['TikTok Shop', function () { var r = promoTarikKodeTiktok_(batasWaktu); return { key: 'kode', baris: r.baris, peringatan: r.peringatan }; }]],
      bundling: [['Shopee', function () { return { key: 'bundling', baris: promoTarikBundlingShopee_(batasWaktu) }; }],
                 ['TikTok Shop', function () { return { key: 'bundling', baris: promoTarikBundlingTiktok_(batasWaktu) }; }]],
      kalender: [['Shopee', function () { return { key: 'kampanye', baris: promoTarikKampanyeShopee_(batasWaktu), jaga: function (r) { return r[7] === 'Manual'; } }; }],
                 ['TikTok Shop', function () { return { key: 'kampanye', baris: promoTarikKampanyeTiktok_(batasWaktu), jaga: function (r) { return r[7] === 'Manual'; } }; }]],
      affiliate: [['TikTok Shop', function () {
        var r = promoTarikAffiliateTiktok_(Math.max(1, Math.min(180, parseInt(data.hariMundur, 10) || 30)), batasWaktu);
        promoGantiBaris_('affSampel', 'TikTok Shop', r.sampel);
        return { key: 'affOrder', baris: r.order, peringatan: r.peringatan };
      }], ['TikTok Shop · Conner', function () {
        // v2026.10.123 (DN-668): affiliator Conner Official terpisah (akun TikTok Conner)
        var cfgC = ovxCfgTiktok_('Conner'); if (!cfgC.token || !cfgC.cipher) throw new Error('TikTok Conner Official belum terhubung');
        PROMO_TOKO_ = 'Conner';
        try {
          var r = promoTarikAffiliateTiktok_(Math.max(1, Math.min(180, parseInt(data.hariMundur, 10) || 30)), batasWaktu);
          r.order.forEach(function (b) { b[0] = 'TikTok Shop · Conner'; }); r.sampel.forEach(function (b) { b[0] = 'TikTok Shop · Conner'; });
          promoGantiBaris_('affSampel', 'TikTok Shop · Conner', r.sampel);
          return { key: 'affOrder', baris: r.order, peringatan: r.peringatan };
        } finally { PROMO_TOKO_ = ''; }
      }]]
    }[jenis];
    tugas.forEach(function (t) {
      var platform = t[0];
      try {
        var r = t[1]();
        promoGantiBaris_(r.key, platform, r.baris, r.jaga);
        hasil[platform] = { ok: true, jumlah: r.baris.length, pesan: r.peringatan || '' };
      } catch (e) {
        hasil[platform] = { ok: false, jumlah: 0, pesan: e.message };
        promoLog_('Gagal sinkron ' + jenis + ' ' + platform, e.message);
      }
    });
    var meta = { waktu: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm'), hasil: hasil };
    PropertiesService.getScriptProperties().setProperty('PROMO_SYNC_' + jenis, JSON.stringify(meta));
    var adaOk = Object.keys(hasil).some(function (k) { return hasil[k].ok; });
    return { success: adaOk, hasil: hasil, sinkron: meta, error: adaOk ? '' : Object.keys(hasil).map(function (k) { return k + ': ' + hasil[k].pesan; }).join(' | ') };
  } finally { kunciSinkronLepas_('PROMO_' + jenis.toUpperCase(), mutex); }
}

function promoObjek_(key, r) {
  var o = {}; PROMO_SHEET_[key].header.forEach(function (h, i) { o[h] = r[i]; }); return o;
}
function promoMetaSync_(jenis) {
  try { return JSON.parse(PropertiesService.getScriptProperties().getProperty('PROMO_SYNC_' + jenis) || 'null'); } catch (e) { return null; }
}
function promoStatusUlang_(o, kolMulai, kolAkhir, kolStatus) {
  if (o[kolStatus] === 'Nonaktif' || o[kolStatus] === 'Draft') return;
  o[kolStatus] = promoStatus_(promoDetik_(o[kolMulai]), promoDetik_(o[kolAkhir]), '');
}

/* ---------- AKSI: lihat_promo { jenis } ---------- */
function prosesLihatPromo(data) {
  if (!data.email) return { success: false, error: 'Silakan login ulang.' };
  var jenis = String(data.jenis || 'kode'), meta = promoMetaSync_(jenis), now = Math.floor(Date.now() / 1000);
  var perluSinkron = !meta || (Date.now() - promoDetik_(meta.waktu) * 1000) > 6 * 3600 * 1000;
  if (jenis === 'kode' || jenis === 'bundling') {
    var key = jenis === 'kode' ? 'kode' : 'bundling';
    var list = promoBaca_(key).map(function (r) { var o = promoObjek_(key, r); promoStatusUlang_(o, 'Mulai', 'Berakhir', 'Status'); return o; })
      .filter(function (o) { return o.Status !== 'Berakhir'; });
    list.sort(function (a, b) { return (a.Status === 'Aktif' ? 0 : 1) - (b.Status === 'Aktif' ? 0 : 1) || String(a.Berakhir).localeCompare(String(b.Berakhir)); });
    return { success: true, jenis: jenis, data: list, sinkron: meta, perluSinkron: perluSinkron };
  }
  if (jenis === 'kalender') {
    var ev = promoBaca_('kampanye').map(function (r) { var o = promoObjek_('kampanye', r); promoStatusUlang_(o, 'Mulai', 'Berakhir', 'Status'); return o; });
    // Promo toko terjadwal (voucher/diskon/bundling) ikut tampil di kalender
    promoBaca_('kode').forEach(function (r) {
      var o = promoObjek_('kode', r); promoStatusUlang_(o, 'Mulai', 'Berakhir', 'Status');
      if (o.Status === 'Berakhir' || o.Status === 'Nonaktif') return;
      ev.push({ Platform: o.Platform, ID: o.ID, Nama: (o.Kode ? o.Kode + ' · ' : '') + o.Nama, Tipe: o.Kategori, Mulai: o.Mulai, Berakhir: o.Berakhir, Status: o.Status, Sumber: 'Promo Toko', Catatan: o['Jenis Diskon'] });
    });
    promoBaca_('bundling').forEach(function (r) {
      var o = promoObjek_('bundling', r); promoStatusUlang_(o, 'Mulai', 'Berakhir', 'Status');
      if (o.Status === 'Berakhir' || o.Status === 'Nonaktif') return;
      ev.push({ Platform: o.Platform, ID: o.ID, Nama: o.Nama, Tipe: o.Tipe, Mulai: o.Mulai, Berakhir: o.Berakhir, Status: o.Status, Sumber: 'Promo Toko', Catatan: o.Aturan });
    });
    var batasLalu = now - 45 * 86400;
    ev = ev.filter(function (e) { var ak = promoDetik_(e.Berakhir) || promoDetik_(e.Mulai); return !ak || ak >= batasLalu; });
    ev.sort(function (a, b) { return String(a.Mulai).localeCompare(String(b.Mulai)); });
    return { success: true, jenis: jenis, data: ev, sinkron: meta, perluSinkron: perluSinkron };
  }
  if (jenis === 'affiliate_order') {
    var tkO = String(data.toko || ''), pfO = String(data.platformAff || '');
    var daftar = promoBaca_('affOrder').map(function (r) { return promoObjek_('affOrder', r); }).filter(function (o) {
      var pf = String(o.Platform || ''), cn = /conner/i.test(pf); // v2026.10.123 (DN-668 / DN-829)
      if (tkO === 'Conner' ? !cn : (tkO && cn)) return false;
      if (pfO === 'Shopee' && !/shopee/i.test(pf)) return false;
      if (pfO === 'TikTok Shop' && /shopee/i.test(pf)) return false;
      return true;
    });
    daftar.sort(function (a, b) { return String(b.Tanggal).localeCompare(String(a.Tanggal)); });
    return { success: true, jenis: jenis, data: daftar, sinkron: promoMetaSync_('affiliate') };
  }
  if (jenis === 'affiliate') {
    // v2026.10.123 (DN-668 / DN-829): data per toko (Waterground / Conner) & per platform (TikTok Shop / Shopee)
    var tokoF = String(data.toko || ''), pfF = String(data.platformAff || '');
    var lolosAff = function (o) {
      var pf = String(o.Platform || ''), conner = /conner/i.test(pf);
      if (tokoF === 'Conner' && !conner) return false;
      if (tokoF && tokoF !== 'Conner' && conner) return false;
      if (pfF === 'Shopee' && !/shopee/i.test(pf)) return false;
      if (pfF === 'TikTok Shop' && /shopee/i.test(pf)) return false;
      return true;
    };
    var orders = promoBaca_('affOrder').map(function (r) { return promoObjek_('affOrder', r); }).filter(lolosAff);
    var sampel = promoBaca_('affSampel').map(function (r) { return promoObjek_('affSampel', r); }).filter(lolosAff);
    var peta = {}, batasAktif = now - 30 * 86400;
    orders.forEach(function (o) {
      if (/CANCEL|BATAL|REFUND/i.test(o['Status Order'])) return;
      var c = o.Creator || '-', p = peta[c] || (peta[c] = { creator: c, platform: o.Platform, order: {}, qty: 0, gmv: 0, komisi: 0, rateTotal: 0, rateN: 0, terakhir: '' });
      p.order[o['Order ID']] = 1; p.qty += promoAngka_(o.Qty); p.gmv += promoAngka_(o.GMV); p.komisi += promoAngka_(o.Komisi);
      if (promoAngka_(o['Rate Komisi (%)'])) { p.rateTotal += promoAngka_(o['Rate Komisi (%)']); p.rateN++; }
      if (String(o.Tanggal) > p.terakhir) p.terakhir = String(o.Tanggal);
    });
    sampel.forEach(function (s) { var c = s.Creator || '-'; if (!peta[c]) peta[c] = { creator: c, platform: s.Platform, order: {}, qty: 0, gmv: 0, komisi: 0, rateTotal: 0, rateN: 0, terakhir: '' }; peta[c].sampel = (peta[c].sampel || 0) + 1; });
    var creators = Object.keys(peta).map(function (k) {
      var p = peta[k];
      return { creator: p.creator, platform: p.platform, jumlahOrder: Object.keys(p.order).length, qty: p.qty, gmv: p.gmv, komisi: p.komisi,
        rate: p.rateN ? Math.round(p.rateTotal / p.rateN * 10) / 10 : '', terakhir: p.terakhir, sampel: p.sampel || 0,
        status: p.terakhir && promoDetik_(p.terakhir) >= batasAktif ? 'Aktif' : (Object.keys(p.order).length ? 'Pasif' : 'Belum Ada Penjualan') };
    }).sort(function (a, b) { return b.gmv - a.gmv; });
    sampel.sort(function (a, b) { return String(b.Tanggal).localeCompare(String(a.Tanggal)); });
    var tot = creators.reduce(function (s, c) { s.gmv += c.gmv; s.komisi += c.komisi; s.order += c.jumlahOrder; if (c.status === 'Aktif') s.aktif++; return s; }, { gmv: 0, komisi: 0, order: 0, aktif: 0 });
    var sampelMenunggu = sampel.filter(function (s) { return /PENDING|WAIT|REVIEW|APPLY|MENUNGGU/i.test(s.Status); }).length;
    var shopeeAff = null;
    if (pfF === 'Shopee') { try { shopeeAff = cacheBesarGet_('P103_SHOPEE_AFF') || null; } catch (eSA) { shopeeAff = null; } if (!shopeeAff) { try { shopeeAff = JSON.parse(PropertiesService.getScriptProperties().getProperty('P103_SHOPEE_AFF_META') || 'null'); } catch (eSM) { } } }
    return { success: true, jenis: jenis, shopeeAff: shopeeAff, creators: creators, sampel: sampel, ringkasan: { creatorAktif: tot.aktif, gmv: tot.gmv, komisi: tot.komisi, order: tot.order, sampelMenunggu: sampelMenunggu }, sinkron: meta, perluSinkron: perluSinkron };
  }
  return { success: false, error: 'Jenis tidak dikenal: ' + jenis };
}

/* ---------- AKSI: promo_buat_voucher (Shopee add_voucher) ---------- */
function prosesPromoBuatVoucher(data) {
  if (!cekIzin(data.email, 'buatInvoice')) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  var platform = String(data.platform || 'Shopee');
  if (platform !== 'Shopee') return { success: false, error: 'Pembuatan kupon TikTok Shop belum dibuka di Open API publik - buat lewat Seller Center TikTok, lalu klik Sinkron.' };
  var nama = String(data.nama || '').trim(), kode = String(data.kode || '').trim().toUpperCase();
  var mulai = promoDetik_(data.mulai), akhir = promoDetik_(data.berakhir), now = Math.floor(Date.now() / 1000);
  var jenis = String(data.jenisDiskon || 'Nominal'), nilai = promoAngka_(data.nilai), kuota = parseInt(data.kuota, 10) || 0;
  if (!nama) return { success: false, error: 'Nama voucher wajib diisi.' };
  if (!/^[A-Z0-9]{1,5}$/.test(kode)) return { success: false, error: 'Kode voucher Shopee: 1-5 karakter huruf/angka (awalan toko ditambahkan otomatis oleh Shopee).' };
  if (!mulai || !akhir || akhir <= mulai) return { success: false, error: 'Periode voucher tidak valid.' };
  if (mulai < now + 60) mulai = now + 300; // Shopee menolak waktu mulai di masa lalu
  if (!nilai || nilai < 0) return { success: false, error: 'Nilai diskon wajib diisi.' };
  if (jenis === 'Persen' && nilai > 100) return { success: false, error: 'Persentase maksimal 100.' };
  if (kuota < 1) return { success: false, error: 'Kuota pemakaian minimal 1.' };
  var body = {
    voucher_name: nama, voucher_code: kode, start_time: mulai, end_time: akhir,
    voucher_type: 1, reward_type: jenis === 'Persen' ? 2 : 1, usage_quantity: kuota,
    min_basket_price: promoAngka_(data.minBelanja), display_channel_list: [1]
  };
  if (jenis === 'Persen') { body.percentage = nilai; if (promoAngka_(data.maksDiskon)) body.max_price = promoAngka_(data.maksDiskon); }
  else body.discount_amount = nilai;
  var r = promoShopeePost_(promoPath_('SHP_VOUCHER_ADD'), body);
  promoLog_('Shopee add_voucher', { body: body, hasil: r.json });
  if (!r.ok) return { success: false, error: 'Shopee menolak: ' + r.pesan };
  try { prosesPromoSinkron({ email: data.email, jenis: 'kode', dariSistem: true }); } catch (e) { }
  return { success: true, voucherId: r.resp.voucher_id || '', pesan: 'Voucher ' + kode + ' berhasil dibuat di Shopee.' };
}

/* ---------- AKSI: promo_akhiri_voucher (Shopee end_voucher - hanya voucher yang sedang berjalan) ---------- */
function prosesPromoAkhiriVoucher(data) {
  if (!cekIzin(data.email, 'buatInvoice')) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  var id = String(data.id || '').replace(/^V-/, '');
  if (!/^\d+$/.test(id)) return { success: false, error: 'Hanya voucher Shopee yang bisa diakhiri dari OmniAI.' };
  var r = promoShopeePost_(promoPath_('SHP_VOUCHER_END'), { voucher_id: Number(id) });
  promoLog_('Shopee end_voucher', { id: id, hasil: r.json });
  if (!r.ok) return { success: false, error: 'Shopee menolak: ' + r.pesan };
  try { prosesPromoSinkron({ email: data.email, jenis: 'kode', dariSistem: true }); } catch (e) { }
  return { success: true };
}

/* ---------- AKSI: promo_simpan_kampanye / promo_hapus_kampanye (jadwal manual) ---------- */
function prosesPromoSimpanKampanye(data) {
  if (!cekIzin(data.email, 'buatInvoice')) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  var nama = String(data.nama || '').trim(), mulai = promoDetik_(data.mulai), akhir = promoDetik_(data.berakhir) || mulai;
  if (!nama || !mulai) return { success: false, error: 'Nama kampanye & tanggal mulai wajib diisi.' };
  if (akhir < mulai) return { success: false, error: 'Tanggal berakhir sebelum tanggal mulai.' };
  var platform = String(data.platform || 'Semua Channel');
  var row = [platform, 'M-' + Utilities.getUuid().slice(0, 8), nama, String(data.tipe || 'Kampanye Platform'), promoFmtWaktu_(mulai), promoFmtWaktu_(akhir),
    promoStatus_(mulai, akhir, ''), 'Manual', String(data.catatan || ''), String(data.email || '')];
  denganKunciTulis_(function () { promoSheet_('kampanye').appendRow(row.map(String)); }, 20000, 'promosi');
  return { success: true };
}

function prosesPromoHapusKampanye(data) {
  if (!cekIzin(data.email, 'buatInvoice')) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  var id = String(data.id || '');
  if (id.indexOf('M-') !== 0) return { success: false, error: 'Hanya jadwal manual yang bisa dihapus.' };
  return denganKunciTulis_(function () {
    var sh = promoSheet_('kampanye'), lr = sh.getLastRow();
    if (lr < 2) return { success: false, error: 'Data tidak ditemukan.' };
    var ids = sh.getRange(2, 2, lr - 1, 1).getDisplayValues();
    for (var i = 0; i < ids.length; i++) if (ids[i][0] === id) { sh.deleteRow(i + 2); return { success: true }; }
    return { success: false, error: 'Data tidak ditemukan.' };
  }, 20000, 'promosi');
}

// Opsional: jalankan dari editor sekali untuk sinkron otomatis tiap 6 jam
function promoSinkronOtomatis() {
  ['kode', 'bundling', 'kalender', 'affiliate'].forEach(function (j) {
    try { denganIzinSistem_(function () { prosesPromoSinkron({ jenis: j, dariSistem: true }); }); } catch (e) { promoLog_('Trigger promo ' + j, e.message); }
  });
}
function aktifkanSinkronPromoOtomatis() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'promoSinkronOtomatis') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('promoSinkronOtomatis').timeBased().everyHours(6).create();
  Logger.log('Trigger sinkron Promosi tiap 6 jam aktif.');
}

/* ======================================================================================
   BIAYA IKLAN MARKETPLACE -> JURNAL FINANCE (otomatis)
   - Shopee Ads   : Shopee Open Platform v2 /api/v2/ads/get_all_cpc_ads_daily_performance (token toko Shopee yang sama)
   - TikTok Ads   : TikTok Business (Marketing) API /open_api/v1.3/report/integrated/get/
                    Script Properties wajib: TIKTOK_ADS_ACCESS_TOKEN, TIKTOK_ADS_ADVERTISER_ID (boleh beberapa, pisah koma)
                    Opsional GMV Max: TIKTOK_ADS_STORE_ID (ID toko TikTok Shop di Ads Manager)
   Setiap hari per platform = 1 baris di sheet "Jurnal Transaksi" (akun "Beban Iklan & Promosi", sumber "Iklan Marketplace",
   No Nota "ADS-<PLATFORM>-yyyyMMdd"). Sinkron ulang MENIMPA nominal hari yang sama (tidak dobel) -> Laba Rugi ikut terbarui.
   ====================================================================================== */
var IKLAN_AKUN_ = 'Beban Iklan & Promosi';
var IKLAN_SUMBER_ = 'Iklan Marketplace';

function iklanDaftarTanggal_(hariMundur) {
  var tz = Session.getScriptTimeZone(), hasil = [], now = new Date();
  for (var i = hariMundur - 1; i >= 0; i--) hasil.push(Utilities.formatDate(new Date(now.getTime() - i * 86400000), tz, 'yyyy-MM-dd'));
  return hasil;
}
// Pecah daftar tanggal (yyyy-MM-dd, urut) jadi potongan maksimal n hari
function iklanPotong_(tanggal, n) {
  var hasil = [];
  for (var i = 0; i < tanggal.length; i += n) hasil.push(tanggal.slice(i, i + n));
  return hasil;
}

/* ---------- Shopee Ads ---------- */
function iklanTarikShopee_(tanggal, batasWaktu) {
  var kred = ambilKredensialShopee();
  if (!kred || !kred.accessToken || !kred.shopId) throw new Error('Shopee belum terhubung (Pengaturan > Integrasi).');
  var peta = {}, contoh = false;
  iklanPotong_(tanggal, 30).forEach(function (blok) {
    if (Date.now() > batasWaktu) return;
    var ubah = function (t) { var p = t.split('-'); return p[2] + '-' + p[1] + '-' + p[0]; }; // Shopee: DD-MM-YYYY
    var r = shopeeGet_('/api/v2/ads/get_all_cpc_ads_daily_performance', { start_date: ubah(blok[0]), end_date: ubah(blok[blok.length - 1]) }, kred);
    if (!r.ok) throw new Error('Shopee Ads: ' + ((r.error || '') + ' ' + (r.pesan || '')).trim());
    var resp = r.json && r.json.response;
    var list = Array.isArray(resp) ? resp : (resp && (resp.daily_performance_list || resp.performance_list || resp.list)) || [];
    if (!contoh && list.length) { promoLog_('Shopee Ads harian', list.slice(0, 3)); contoh = true; }
    list.forEach(function (x) {
      var d = String(x.date || x.stat_date || '').trim(), t;
      if (/^\d{2}-\d{2}-\d{4}$/.test(d)) { var p = d.split('-'); t = p[2] + '-' + p[1] + '-' + p[0]; }
      else if (/^\d{4}-\d{2}-\d{2}/.test(d)) t = d.slice(0, 10);
      else return;
      var biaya = parseFloat(x.expense !== undefined ? x.expense : (x.cost !== undefined ? x.cost : x.spend));
      if (isFinite(biaya)) peta[t] = (peta[t] || 0) + biaya;
    });
  });
  return peta; // { 'yyyy-MM-dd': rupiah }
}

/* ---------- TikTok Ads (Business API) ---------- */
function iklanTiktokGet_(path, params, token) {
  var q = Object.keys(params).map(function (k) {
    var v = params[k]; if (typeof v !== 'string') v = JSON.stringify(v);
    return encodeURIComponent(k) + '=' + encodeURIComponent(v);
  }).join('&');
  var res = fetchHemat('https://business-api.tiktok.com' + path + '?' + q, { method: 'get', headers: { 'Access-Token': token }, muteHttpExceptions: true });
  var j = null; try { j = JSON.parse(res.getContentText()); } catch (e) { }
  if (!j) return { ok: false, pesan: 'Respons bukan JSON (HTTP ' + res.getResponseCode() + ')', data: {} };
  return { ok: j.code === 0, pesan: j.code === 0 ? '' : (j.message || 'kode ' + j.code), data: j.data || {} };
}

function iklanTarikTiktok_(tanggal, batasWaktu) {
  var props = PropertiesService.getScriptProperties();
  var token = String(props.getProperty('TIKTOK_ADS_ACCESS_TOKEN') || '').trim();
  var advIds = String(props.getProperty('TIKTOK_ADS_ADVERTISER_ID') || '').split(',').map(function (s) { return s.trim(); }).filter(String);
  var storeId = String(props.getProperty('TIKTOK_ADS_STORE_ID') || '').trim();
  if (!token || !advIds.length) throw new Error('TikTok Ads belum diatur: isi Script Properties TIKTOK_ADS_ACCESS_TOKEN & TIKTOK_ADS_ADVERTISER_ID.');
  var peta = {}, peringatan = [], contoh = false;
  function tambah(list, kunciBiaya) {
    (list || []).forEach(function (row) {
      var dim = row.dimensions || {}, met = row.metrics || {};
      var t = String(dim.stat_time_day || dim.stat_time || '').slice(0, 10);
      var v = parseFloat(met[kunciBiaya] !== undefined ? met[kunciBiaya] : (met.spend !== undefined ? met.spend : met.cost));
      if (/^\d{4}-\d{2}-\d{2}$/.test(t) && isFinite(v)) peta[t] = (peta[t] || 0) + v;
    });
  }
  advIds.forEach(function (adv) {
    iklanPotong_(tanggal, 30).forEach(function (blok) {
      if (Date.now() > batasWaktu) return;
      var hal = 1, totalHal = 1;
      do {
        var r = iklanTiktokGet_('/open_api/v1.3/report/integrated/get/', {
          advertiser_id: adv, report_type: 'BASIC', data_level: 'AUCTION_ADVERTISER', dimensions: ['stat_time_day'], metrics: ['spend'],
          start_date: blok[0], end_date: blok[blok.length - 1], page: String(hal), page_size: '100'
        }, token);
        if (!r.ok) throw new Error('TikTok Ads (' + adv + '): ' + r.pesan);
        if (!contoh && (r.data.list || []).length) { promoLog_('TikTok Ads harian', r.data.list.slice(0, 3)); contoh = true; }
        tambah(r.data.list, 'spend');
        totalHal = (r.data.page_info && r.data.page_info.total_page) || 1;
        hal++;
      } while (hal <= totalHal && hal <= 10);
      // GMV Max (iklan toko TikTok Shop) - dilaporkan terpisah dari laporan Auction
      if (storeId) {
        var g = iklanTiktokGet_('/open_api/v1.3/gmv_max/report/get/', {
          advertiser_id: adv, store_ids: [storeId], dimensions: ['stat_time_day'], metrics: ['cost'],
          start_date: blok[0], end_date: blok[blok.length - 1], page: '1', page_size: '100'
        }, token);
        if (g.ok) { if ((g.data.list || []).length) promoLog_('TikTok GMV Max harian', g.data.list.slice(0, 3)); tambah(g.data.list, 'cost'); }
        else peringatan.push('GMV Max: ' + g.pesan);
      }
    });
  });
  return { peta: peta, peringatan: peringatan.join(' | ') };
}

/* ---------- Tulis / timpa jurnal harian ---------- */
function iklanTulisJurnal_(platform, kodeNota, peta, tanggalDiminta) {
  var tz = Session.getScriptTimeZone(), hasil = { baru: 0, diubah: 0, total: 0 };
  var lock = kunciModul_('keuangan');
  lock.waitLock(20000);
  try {
    var akun = finPastikanAkunBeban_(IKLAN_AKUN_);
    var sh = getJurnalTransaksiSheet(), lr = sh.getLastRow();
    var petaBaris = {};
    if (lr > 1) sh.getRange(2, 10, lr - 1, 1).getDisplayValues().forEach(function (r, i) {
      var n = String(r[0] || '').trim(); if (n.indexOf('ADS-' + kodeNota + '-') === 0) petaBaris[n] = i + 2;
    });
    var barisBaru = [];
    tanggalDiminta.forEach(function (t) {
      if (!(t in peta)) return; // hari tanpa data dari API -> biarkan apa adanya
      var jumlah = Math.round(peta[t] || 0), nota = 'ADS-' + kodeNota + '-' + t.replace(/-/g, '');
      var p = t.split('-'), tgl = new Date(+p[0], +p[1] - 1, +p[2], 12, 0, 0);
      var ket = 'Biaya iklan ' + platform + ' ' + Utilities.formatDate(tgl, tz, 'dd MMM yyyy') + ' (sinkron otomatis)';
      var info = JSON.stringify({ ads: 1, p: platform, t: t, diperbarui: Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd HH:mm') });
      hasil.total += jumlah;
      if (petaBaris[nota]) {
        var row = petaBaris[nota];
        if (Math.round(finAngka_(sh.getRange(row, 5).getValue())) !== jumlah) {
          sh.getRange(row, 1, 1, 10).setValues([[tgl, akun, 'Beban', 'Masuk', jumlah, ket, IKLAN_SUMBER_, '', info, nota]]);
          hasil.diubah++;
        }
      } else if (jumlah > 0) {
        barisBaru.push([tgl, akun, 'Beban', 'Masuk', jumlah, ket, IKLAN_SUMBER_, '', info, nota]);
      }
    });
    if (barisBaru.length) {
      sh.getRange(sh.getLastRow() + 1, 1, barisBaru.length, 10).setValues(barisBaru);
      hasil.baru = barisBaru.length;
    }
    if (hasil.baru || hasil.diubah) { SpreadsheetApp.flush(); finInvalidasi_(); }
  } finally { lepasKunci_(lock); }
  return hasil;
}

/* ---------- AKSI: fin_sinkron_iklan { hariMundur? (1-90, default 7) } ---------- */
function prosesFinSinkronIklan(data) {
  if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  try { pastikanTriggerIklan_(); } catch (eTr) { }
  var mutex = kunciSinkronAmbil_('FIN_IKLAN', 600);
  if (!mutex) return { success: true, sedangJalan: true, pesan: 'Sinkron biaya iklan sedang berjalan di proses lain.' };
  var batasWaktu = Date.now() + 100 * 1000 /* v2026.10.64+1 (P47): batas Edge Function */, hasil = {};
  try {
    var hari = Math.max(1, Math.min(90, parseInt(data.hariMundur, 10) || 7));
    var tanggal = iklanDaftarTanggal_(hari);
    [['Shopee', 'SHOPEE', function () { return { peta: iklanTarikShopee_(tanggal, batasWaktu), peringatan: '' }; }],
     ['TikTok Shop', 'TIKTOK', function () { return iklanTarikTiktok_(tanggal, batasWaktu); }]].forEach(function (t) {
      try {
        var r = t[2]();
        var w = iklanTulisJurnal_(t[0], t[1], r.peta, tanggal);
        hasil[t[0]] = { ok: true, total: w.total, baru: w.baru, diubah: w.diubah, hari: Object.keys(r.peta).length, pesan: r.peringatan || '' };
      } catch (e) {
        hasil[t[0]] = { ok: false, total: 0, baru: 0, diubah: 0, pesan: e.message };
        promoLog_('Gagal sinkron iklan ' + t[0], e.message);
      }
    });
    var meta = { waktu: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm'), hariMundur: hari, hasil: hasil };
    PropertiesService.getScriptProperties().setProperty('FIN_IKLAN_SYNC', JSON.stringify(meta));
    var adaOk = Object.keys(hasil).some(function (k) { return hasil[k].ok; });
    return {
      success: adaOk, hasil: hasil, sinkron: meta,
      totalBiaya: Object.keys(hasil).reduce(function (s, k) { return s + (hasil[k].total || 0); }, 0),
      error: adaOk ? '' : Object.keys(hasil).map(function (k) { return k + ': ' + hasil[k].pesan; }).join(' | ')
    };
  } finally { kunciSinkronLepas_('FIN_IKLAN', mutex); }
}

