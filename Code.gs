// ===== AKSI: laporan_margin_kanal { dari, sampai, segar } =====
// Omzet, HPP, potongan marketplace & margin PER CHANNEL (sumber sama dengan Laporan Keuangan).
function prosesLaporanMarginKanal(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk melihat HPP & margin.');
    var rg = finRentangDariData_(data || {});
    var D = finBangunData_(data.segar === true);
    var a = finAgregat_(D, rg.dari, rg.sampai);
    var URUT = ['Shopee', 'Tokopedia', 'TikTok Shop', 'PO Sales', 'Website', 'Conner Hardware', 'Lainnya'];
    var semua = {};
    ['Shopee', 'Tokopedia', 'TikTok Shop', 'PO Sales'].forEach(function (k) { semua[k] = 1; });
    Object.keys(a.kanal).forEach(function (k) { semua[k] = 1; });
    Object.keys(a.hppKanal).forEach(function (k) { if (a.hppKanal[k] > 0) semua[k] = 1; });
    var daftar = Object.keys(semua).map(function (kn) {
      var om = a.kanal[kn] ? a.kanal[kn][0] : 0, n = a.kanal[kn] ? a.kanal[kn][1] : 0;
      var hpp = Math.round(a.hppKanal[kn] || 0), pot = Math.round(a.potonganKanal[kn] || 0);
      var lk = om - hpp, lb = om - hpp - pot;
      return {
        kanal: kn, omzet: Math.round(om), pesanan: n, hpp: hpp, potongan: pot,
        labaKotor: Math.round(lk), labaBersih: Math.round(lb),
        marginKotorPct: om > 0 ? Math.round(lk / om * 1000) / 10 : null,
        marginBersihPct: om > 0 ? Math.round(lb / om * 1000) / 10 : null,
        hppPct: om > 0 ? Math.round(hpp / om * 1000) / 10 : null
      };
    }).sort(function (x, y) {
      var ix = URUT.indexOf(x.kanal), iy = URUT.indexOf(y.kanal);
      return (ix < 0 ? 99 : ix) - (iy < 0 ? 99 : iy);
    });
    var tot = daftar.reduce(function (t, x) { t.omzet += x.omzet; t.hpp += x.hpp; t.potongan += x.potongan; t.pesanan += x.pesanan; return t; }, { omzet: 0, hpp: 0, potongan: 0, pesanan: 0 });
    tot.labaKotor = tot.omzet - tot.hpp; tot.labaBersih = tot.labaKotor - tot.potongan;
    tot.marginKotorPct = tot.omzet > 0 ? Math.round(tot.labaKotor / tot.omzet * 1000) / 10 : null;
    tot.marginBersihPct = tot.omzet > 0 ? Math.round(tot.labaBersih / tot.omzet * 1000) / 10 : null;
    result.success = true;
    result.dari = rg.dari; result.sampai = rg.sampai;
    result.daftar = daftar; result.total = tot;
    result.hppTotalLaporan = Math.round(a.hpp); // pembanding: HPP total di Laporan Keuangan
    result.tanpaHpp = (D.tanpaHpp || []).slice(0, 10);
    result.dibuat = D.dibuat || Date.now();
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   PRODUK TERJUAL v2026.10.19 (web > Finance > Produk Terjual)
   ------------------------------------------------------------
   Tidak menghitung ulang apa pun - memakai mesin yang SAMA dengan Laba Rugi:
     - finBangunData_()  : qty terjual per SKU per hari & per channel (Stock Ledger "Terjual ..."),
                           HPP per SKU (finTerapkanHpp_ = Harga Modal Supplier Utama / rata-rata pembelian).
     - finAgregat_()     : omzet ASLI per channel di periode (Rekap Harian).
     - prosesLihatStock(): stok saat ini (mesin stok yang sama dengan Monitor Stok).
   Omzet per SKU = omzet asli tiap channel dibagi ke SKU sebanding (qty x harga jual Produk Master),
   sehingga total omzet halaman ini SAMA dengan Laporan Keuangan (ditandai "estimasi" di layar).
   Label: Bintang / Andalan (SKU penyumbang 50% omzet teratas; Bintang = tren naik), Lambat (stok cukup
   > 90 hari), Tidak laku (30 hari tanpa penjualan, stok masih ada).
   ============================================================ */
var PT_CACHE_DETIK_ = 600;
var PT_TOP_PERSEN_ = 50;      // SKU penyumbang 50% omzet pertama = kelompok teratas
var PT_LAMBAT_HARI_ = 90;     // stok cukup lebih dari 90 hari = lambat
var PT_BINTANG_TREN_ = 10;    // kelompok teratas + qty naik >= 10% = bintang
var PT_BATAS_HARGA_ = 1.5;    // omzet per pcs hasil bagi maks 1,5x harga jual Produk Master

function ptTglKeUtc_(t) { var p = String(t).split('-'); return Date.UTC(Number(p[0]), Number(p[1]) - 1, Number(p[2])); }
function ptUtcKeTgl_(ms) {
  var d = new Date(ms), b = d.getUTCMonth() + 1, h = d.getUTCDate();
  return d.getUTCFullYear() + '-' + (b < 10 ? '0' : '') + b + '-' + (h < 10 ? '0' : '') + h;
}
function ptGeserTgl_(t, hari) { return ptUtcKeTgl_(ptTglKeUtc_(t) + hari * 86400000); }
function ptJumlahHari_(dari, sampai) { return Math.round((ptTglKeUtc_(sampai) - ptTglKeUtc_(dari)) / 86400000) + 1; }

// Produk Master ringkas: SKU (huruf besar) -> nama, foto, URL supplier, harga jual default & Shopee, arsip
function ptMasterRingkas_() {
  var peta = {};
  try {
    var sh = getMasterProdukSheet(), lr = sh.getLastRow();
    if (lr < 2) return peta;
    var lebar = Math.max(9, Math.min(sh.getLastColumn(), KAT_KOL_STATUS));
    sh.getRange(2, 1, lr - 1, lebar).getValues().forEach(function (r) {
      var sku = String(r[0] || '').replace(/^'+/, '').trim();
      if (!sku) return;
      var arsip = r.length >= KAT_KOL_STATUS && String(r[KAT_KOL_STATUS - 1] || '').trim() === KAT_STATUS_ARSIP;
      var k = sku.toUpperCase();
      if (peta[k] && arsip) return; // SKU dobel: yang aktif menang
      peta[k] = {
        sku: sku, nama: String(r[1] || '').trim(), hargaJual: finAngka_(r[2]), hargaShopee: finAngka_(r[6]),
        url: String(r[4] || '').trim(), foto: String(r[8] || '').trim(), arsip: arsip
      };
    });
  } catch (e) { Logger.log('ptMasterRingkas_: ' + e); }
  return peta;
}

// Harga acuan pembagi omzet: Harga Shopee untuk channel Shopee, selain itu Harga Jual default.
function ptHargaAcuan_(m, hpp, kanal) {
  if (m && kanal === 'Shopee' && m.hargaShopee > 0) return m.hargaShopee;
  if (m && m.hargaJual > 0) return m.hargaJual;
  if (m && m.hargaShopee > 0) return m.hargaShopee;
  if (hpp > 0) return hpp * 1.3;
  return 1;
}

function ptHitung_(D, rg, email) {
  var tz = Session.getScriptTimeZone();
  var hariIni = finTglStr_(new Date(), tz);
  var nHari = ptJumlahHari_(rg.dari, rg.sampai);
  var dariSblm = ptGeserTgl_(rg.dari, -nHari), sampaiSblm = ptGeserTgl_(rg.dari, -1);
  var awal30 = ptGeserTgl_(hariIni, -29);
  var a = finAgregat_(D, rg.dari, rg.sampai);
  var unit = D.unit || {}, terakhir = D.terakhirJual || {};
  var master = ptMasterRingkas_();

  // 1) Qty: periode, periode sebelumnya (panjang sama), 30 hari terakhir, per channel
  var qSku = {}, qSblm = {}, q30 = {}, qKanal = {};
  Object.keys(D.jualSku || {}).forEach(function (t) {
    var dlm = t >= rg.dari && t <= rg.sampai, sb = t >= dariSblm && t <= sampaiSblm, b30 = t >= awal30 && t <= hariIni;
    if (!dlm && !sb && !b30) return;
    var m = D.jualSku[t];
    Object.keys(m).forEach(function (s) {
      if (dlm) qSku[s] = (qSku[s] || 0) + m[s];
      if (sb) qSblm[s] = (qSblm[s] || 0) + m[s];
      if (b30) q30[s] = (q30[s] || 0) + m[s];
    });
  });
  Object.keys(D.jualKanal || {}).forEach(function (t) {
    if (t < rg.dari || t > rg.sampai) return;
    var hk = D.jualKanal[t];
    Object.keys(hk).forEach(function (kn) {
      var m = hk[kn], tk = qKanal[kn] || (qKanal[kn] = {});
      Object.keys(m).forEach(function (s) { tk[s] = (tk[s] || 0) + m[s]; });
    });
  });

  // 2) Omzet asli per channel -> dibagi HANYA ke SKU yang terjual di channel YANG SAMA, sebanding qty x harga acuan.
  //    FIX v2026.10.19-b: dulu omzet channel tanpa rincian SKU "dipasangkan" ke SKU dari channel lain yang tidak punya
  //    omzet (mis. "Lainnya" = beli sendiri / koreksi stok) -> 1 pcs bisa dapat omzet jutaan. Sekarang:
  //    - omzet channel tanpa rincian SKU   -> baris "Omzet tanpa rincian produk" (per channel), TIDAK dibebankan ke SKU mana pun
  //    - SKU terjual di channel tanpa omzet -> omzet 0 + tanda "omzet tidak tercatat" (HPP tetap dihitung, sama dengan Laba Rugi)
  //    - pagar harga: hasil bagi maks PT_BATAS_HARGA_ x harga acuan per pcs; kelebihannya juga masuk "tanpa rincian"
  //      (terjadi kalau sebagian pesanan channel itu belum tercatat terjual di Stock Ledger).
  var omzetSku = {}, tanpaRincian = {}, skuTanpaOmzet = {}, omzetSkuKanal = {}; // P76 DN-771: omzet per SKU per channel
  var semuaKanal = {};
  Object.keys(a.kanal).forEach(function (k) { semuaKanal[k] = 1; });
  Object.keys(qKanal).forEach(function (k) { semuaKanal[k] = 1; });
  Object.keys(semuaKanal).forEach(function (kn) {
    var om = a.kanal[kn] ? a.kanal[kn][0] : 0, m = qKanal[kn] || {};
    var bobot = {}, tot = 0;
    Object.keys(m).forEach(function (s) {
      if (!(m[s] > 0)) return;
      var w = m[s] * ptHargaAcuan_(master[s.toUpperCase()], unit[s], kn);
      if (w > 0) { bobot[s] = w; tot += w; }
    });
    if (!(om > 0)) { Object.keys(bobot).forEach(function (s) { skuTanpaOmzet[s] = (skuTanpaOmzet[s] || []).concat([kn]); }); return; }
    if (!(tot > 0)) { tanpaRincian[kn] = (tanpaRincian[kn] || 0) + om; return; }
    var faktor = Math.min(om / tot, PT_BATAS_HARGA_);
    var terbagi = 0;
    Object.keys(bobot).forEach(function (s) { var v = bobot[s] * faktor; omzetSku[s] = (omzetSku[s] || 0) + v; terbagi += v; var ok = omzetSkuKanal[s] || (omzetSkuKanal[s] = {}); ok[kn] = (ok[kn] || 0) + v; });
    if (om - terbagi > 0.5) tanpaRincian[kn] = (tanpaRincian[kn] || 0) + (om - terbagi);
  });
  var omzetTanpaSku = 0;
  var rincianTanpaSku = Object.keys(tanpaRincian).map(function (kn) { omzetTanpaSku += tanpaRincian[kn]; return { kanal: kn, omzet: Math.round(tanpaRincian[kn]) }; })
    .sort(function (x, y) { return y.omzet - x.omzet; });

  // 3) Stok saat ini (mesin stok Monitor Stok)
  var stok = {};
  try {
    var pos = prosesLihatStock({ email: email });
    if (pos && pos.success) (pos.daftar || []).forEach(function (x) { stok[String(x.sku || '').trim().toUpperCase()] = Number(x.stockSaatIni) || 0; });
  } catch (eS) { Logger.log('Produk Terjual: stok dilewati - ' + eS); }
  var adaStok = Object.keys(stok).length > 0;

  function kurang(m, s) {
    var x = [];
    if (!m || !m.foto) x.push('foto');
    if (!(unit[s] > 0)) x.push('harga modal');
    if (!m || !m.url) x.push('URL supplier');
    return x;
  }

  // 4) Baris per SKU
  var totOmzet = 0, totHpp = 0, totQty = 0;
  var baris = Object.keys(qSku).filter(function (s) { return qSku[s] > 0; }).map(function (s) {
    var m = master[s.toUpperCase()] || null;
    var q = qSku[s], om = omzetSku[s] || 0, h = q * (unit[s] || 0);
    var st = stok.hasOwnProperty(s.toUpperCase()) ? stok[s.toUpperCase()] : null;
    var laju = (q30[s] || 0) / 30;
    var sb = qSblm[s] || 0;
    totOmzet += om; totHpp += h; totQty += q;
    return {
      sku: s, nama: (m && m.nama) || s, foto: m ? m.foto : '', qty: q, omzet: Math.round(om), hpp: Math.round(h),
      hppSatuan: Math.round(unit[s] || 0), margin: Math.round(om - h), marginPct: om > 0 && unit[s] > 0 ? Math.round((om - h) / om * 1000) / 10 : null,
      qtySebelum: sb, trenPct: sb > 0 ? Math.round((q - sb) / sb * 1000) / 10 : null, baru: sb === 0,
      stok: st, qty30: q30[s] || 0, cukupHari: st !== null && laju > 0 ? Math.round(st / laju) : null,
      terakhirLaku: terakhir[s] || '', kurang: kurang(m, s), diMaster: !!m, label: '',
      omzetTakTercatat: skuTanpaOmzet[s] && !(om > 0) ? skuTanpaOmzet[s] : null,
      perKanal: (function () { var o = {}; Object.keys(qKanal).forEach(function (kn) { var q2 = qKanal[kn][s] || 0; if (q2 > 0) o[kn] = [q2, Math.round((omzetSkuKanal[s] || {})[kn] || 0)]; }); return o; })()
    };
  });
  baris.sort(function (x, y) { return y.omzet - x.omzet || y.qty - x.qty; });
  var kum = 0;
  baris.forEach(function (b) {
    b.kontribusiPct = totOmzet > 0 ? Math.round(b.omzet / totOmzet * 1000) / 10 : 0;
    var top = totOmzet > 0 && b.omzet > 0 && kum < totOmzet * PT_TOP_PERSEN_ / 100;
    kum += b.omzet;
    if (top) b.label = (b.baru || (b.trenPct !== null && b.trenPct >= PT_BINTANG_TREN_)) ? 'bintang' : 'andalan';
    else if (b.stok !== null && b.stok > 0 && (b.cukupHari === null || b.cukupHari > PT_LAMBAT_HARI_)) b.label = 'lambat';
  });

  // 5) Tidak laku 30 hari: stok masih ada, tidak diarsipkan, tidak terjual 30 hari terakhir
  var tidakLaku = [];
  if (adaStok) Object.keys(master).forEach(function (k) {
    var m = master[k];
    if (m.arsip || !(stok[k] > 0)) return;
    var s = m.sku;
    if ((q30[s] || 0) > 0 || (terakhir[s] && terakhir[s] >= awal30)) return;
    tidakLaku.push({
      sku: s, nama: m.nama || s, foto: m.foto, stok: stok[k], hppSatuan: Math.round(unit[s] || 0),
      nilaiStok: Math.round(stok[k] * (unit[s] || 0)), terakhirLaku: terakhir[s] || '', kurang: kurang(m, s), label: 'tidaklaku'
    });
  });
  tidakLaku.sort(function (x, y) { return y.nilaiStok - x.nilaiStok || y.stok - x.stok; });
  var nTidakLaku = tidakLaku.length, nilaiTidakLaku = tidakLaku.reduce(function (t, x) { return t + x.nilaiStok; }, 0);

  var hitungLabel = { bintang: 0, andalan: 0, lambat: 0 };
  baris.forEach(function (b) { if (hitungLabel[b.label] !== undefined) hitungLabel[b.label]++; });
  var belumLengkap = baris.filter(function (b) { return b.kurang.length; }).length + tidakLaku.filter(function (b) { return b.kurang.length; }).length;

  return {
    success: true, dari: rg.dari, sampai: rg.sampai, dariSebelum: dariSblm, sampaiSebelum: sampaiSblm,
    ringkas: {
      omzet: Math.round(totOmzet + omzetTanpaSku), omzetPerSku: Math.round(totOmzet), omzetTanpaSku: Math.round(omzetTanpaSku),
      omzetLaporan: Math.round(a.omzet), hpp: Math.round(totHpp), hppLaporan: Math.round(a.hpp), rincianTanpaSku: rincianTanpaSku,
      hppTanpaOmzet: Math.round(baris.reduce(function (t, b) { return t + (b.omzetTakTercatat ? b.hpp : 0); }, 0)),
      margin: Math.round(totOmzet - totHpp), marginPct: totOmzet > 0 ? Math.round((totOmzet - totHpp) / totOmzet * 1000) / 10 : null,
      qty: totQty, skuLaku: baris.length, label: hitungLabel, tidakLaku: nTidakLaku, nilaiTidakLaku: nilaiTidakLaku,
      belumLengkap: belumLengkap, stokTersedia: adaStok
    },
    daftar: baris, tidakLaku: tidakLaku.slice(0, 300),
    aturan: { topPersen: PT_TOP_PERSEN_, lambatHari: PT_LAMBAT_HARI_, bintangTren: PT_BINTANG_TREN_, batasHarga: PT_BATAS_HARGA_ },
    dibuat: D.dibuat || Date.now()
  };
}

