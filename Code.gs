  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.',
    validasi: function () {
      row = parseInt(data.row, 10);
      if (!row || row < 2) throw new Error('Baris tidak valid');
    }
  });
}

/* ============================================================
   FITUR: RESI PENDING (khusus Resi Keluar)
   Kolom 11 = Status Pending ("Pending" / kosong)
   Kolom 12 = Tanggal Pending (kapan pertama kali ditandai)
   ============================================================ */
function prosesTandaiPending(data) {
  var noResi;
  return withTransaction(data.email, 'scanResiKeluar', 'pengiriman', function () {
    var result = { success: false };
    var noResiKey = noResi.toUpperCase();
    var namaStaff = getNamaStaff(data.email);

    var info = getSheetInfo('keluar');
    var sh = info.sheet;

    if (!sh.getRange(1, 11).getValue()) {
      sh.getRange(1, 11).setValue('Status Pending').setFontWeight('bold');
      sh.getRange(1, 12).setValue('Tanggal Pending').setFontWeight('bold');
    }

    var lastRow = sh.getLastRow();
    var rowDitemukan = -1;
    if (lastRow > 1) {
      var resiVals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < resiVals.length; i++) {
        if (resiSama_(resiVals[i][0], noResi)) {
          rowDitemukan = i + 2;
          break;
        }
      }
    }

    if (rowDitemukan === -1) {
      // Belum ada sama sekali -> buat baris baru langsung berstatus Pending
      var newRow = lastRow + 1;
      sh.getRange(newRow, 1).setNumberFormat('@');
      sh.getRange(newRow, 1, 1, 8).setValues([[noResi, '', new Date(), '', '', '', '', '']]);
      sh.getRange(newRow, 9).setValue(namaStaff);
      sh.getRange(newRow, 10).setValue(deteksiKurir(noResi));
      sh.getRange(newRow, 11).setValue('Pending');
      sh.getRange(newRow, 12).setValue(new Date());
      result.statusBaru = 'Pending';
    } else {
      var statusSekarang = String(sh.getRange(rowDitemukan, 11).getValue() || '').trim();
      if (statusSekarang === 'Pending') {
        // Sudah pending sebelumnya -> nggak masalah, biarin aja (idempotent)
        result.sudahPendingSebelumnya = true;
      } else {
        // Sudah pernah discan normal sebelumnya -> tetap boleh ditarik jadi Pending
        // (misal ternyata harus ditarik balik / batal kirim)
        sh.getRange(rowDitemukan, 11).setValue('Pending');
        sh.getRange(rowDitemukan, 12).setValue(new Date());
      }
      result.statusBaru = 'Pending';
    }

    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.',
    validasi: function () {
      noResi = String(data.noResi || '').trim();
      if (!noResi) throw new Error('No Resi kosong');
    }
  });
}

function prosesLihatPending(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiKeluar')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var info = getSheetInfo('keluar');
    var sh = info.sheet;
    var lastRow = sh.getLastRow();
    var pendingItems = [];

    if (lastRow > 1 && sh.getMaxColumns() >= 12) {
      var numRows = lastRow - 1;
      // FIX LAMBAT: dulu 4x baca kolom penuh (resi, status, tgl pending, kurir) seluruh riwayat.
      // Sekarang cuma kolom Status yang dibaca penuh, lalu detail diambil KHUSUS baris Pending.
      var statusVals = sh.getRange(2, 11, numRows, 1).getValues();
      var idxPending = [];
      for (var s0 = 0; s0 < numRows; s0++) {
        if (String(statusVals[s0][0] || '').trim() === 'Pending') idxPending.push(s0);
      }
      var detailPending = rhBacaBarisBerkelompok_(sh, idxPending, 12, 30);
      var tz = Session.getScriptTimeZone();
      var todayStr = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');

      for (var p0 = 0; p0 < idxPending.length; p0++) {
        var i = idxPending[p0];
        var baris = detailPending[i];
        if (!baris) continue;
        var noResi = String(baris[0] || '').trim();
        if (!noResi) continue;

        var tglPending = baris[11];
        var hariPending = 0;
        if (tglPending instanceof Date) {
          var tglPendingStr = Utilities.formatDate(tglPending, tz, 'yyyy-MM-dd');
          var msPerHari = 24 * 60 * 60 * 1000;
          var tglHariIni = new Date(todayStr);
          var tglMulai = new Date(tglPendingStr);
          hariPending = Math.max(0, Math.round((tglHariIni - tglMulai) / msPerHari));
        }

        pendingItems.push({
          row: i + 2, noResi: noResi, kurir: String(baris[9] || '').trim() || 'Tidak Diketahui',
          hariPending: hariPending
        });
      }
    }

    pendingItems.sort(function (a, b) { return b.hariPending - a.hariPending; });
    result.success = true;
    result.pendingItems = pendingItems;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   FITUR: STOCK OPNAME & STOCK IN (ledger berbasis waktu)
   Stock saat ini = Opname TERAKHIR + semua Stock In SETELAH opname itu.
   Stock In SEBELUM opname terakhir diabaikan (udah kehitung pas opname).
   ============================================================ */
/* ============================================================================
   MEMO GUDANG - 3 tab: Minta Stock, Catat Barang Masuk, Lapor Hilang/Rusak.
   UX prioritas: minim klik, cart lokal di browser sebelum submit, nomor
   otomatis format PREFIX+YYMMDD-NN.
   ============================================================================ */

// Generate nomor memo format PREFIX+YYMMDD-NN (misal MS260919-01), reset urutan
// tiap hari. Dikunci pakai LockService biar nggak tabrakan kalau 2 orang submit
// bersamaan di detik yang sama.
function bikinNomorMemo(sheet, prefix) {
  var tz = Session.getScriptTimeZone();
  var tanggalKode = Utilities.formatDate(new Date(), tz, 'yyMMdd');
  var awalan = prefix + tanggalKode + '-';
  var lastRow = sheet.getLastRow();
  var urutanTerbesar = 0;
  if (lastRow > 1) {
    var kolomNomor = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
    kolomNomor.forEach(function (row) {
      var nomor = String(row[0] || '');
      if (nomor.indexOf(awalan) === 0) {
        var urutan = parseInt(nomor.substring(awalan.length), 10);
        if (!isNaN(urutan) && urutan > urutanTerbesar) urutanTerbesar = urutan;
      }
    });
  }
  var urutanBaru = urutanTerbesar + 1;
  return awalan + (urutanBaru < 10 ? '0' + urutanBaru : String(urutanBaru));
}

// Lookup stock BANYAK SKU sekaligus (dipanggil pas cart di frontend berubah,
// biar kolom "Sisa Stok Real-time" selalu akurat tanpa nunggu submit).
/* S1 - SATU ANGKA STOK DI SEMUA TEMPAT: Memo Gudang (Minta Stock / Stock Opname), Katalog & mobile kini
   memakai MESIN STOK YANG SAMA dengan Monitor Stok (smHitungMesinStok), bukan lagi ledger lama.
   Performa: snapshot gzip di cache besar + nomor versi stok. Bila ada mutasi stok, snapshot lama tetap
   DIKIRIM SEKETIKA (basi: true) supaya layar langsung terisi, lalu frontend meminta versi segar di latar
   belakang (stale-while-revalidate). Hitung ulang penuh hanya terjadi bila memang perlu. */
var SM_CACHE_PETA_STOK = 'STOK_PETA_V3';
var SM_STOK_LAMA_PAKAI_MESIN_BARU = true; // S1 - ubah ke false untuk kembali ke perhitungan ledger lama
var SM_CACHE_VERSI_STOK = 'SM_VERSI_STOK';
var SM_PETA_SEGAR_DETIK = 120;
function smVersiStok_() { try { return CacheService.getScriptCache().get(SM_CACHE_VERSI_STOK) || '0'; } catch (e) { return '0'; } }
function smNaikkanVersiStok_() { try { CacheService.getScriptCache().put(SM_CACHE_VERSI_STOK, String(Date.now()), 21600); } catch (e) { } }
function smHitungPetaStok_(mesinSiap) {
  var mesin = mesinSiap || smHitungMesinStok({}); // mesinSiap: hasil smHitungMesinStok yang sudah dihitung pemanggil (Ringkasan Gudang)
  var peta = {};
  mesin.daftar.forEach(function (p) {
    peta[p.sku] = {
      nama: p.nama, stockSaatIni: p.onHand, onHand: p.onHand, onReserve: p.onReserve, onAvailable: p.onAvailable,
      onOrder: p.onOrder, opnameTerakhir: p.anchorMs && !p.anchorOtomatis ? smFmt(p.anchorMs) : '', terdaftar: p.terdaftar, arsip: !!p.arsip
    };
  });
  var snap = { peta: peta, versi: smVersiStok_(), dihitungMs: Date.now() };
  cacheBesarPut_(SM_CACHE_PETA_STOK, snap, 21600);
  return snap;
}
function prosesLihatStokBanyakSku(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var snap = data.segarkan ? null : cacheBesarGet_(SM_CACHE_PETA_STOK);
    var basi = false;
    if (snap) {
      var umurDetik = (Date.now() - (snap.dihitungMs || 0)) / 1000;
      basi = snap.versi !== smVersiStok_() || umurDetik > SM_PETA_SEGAR_DETIK;
      if (basi && !data.bolehBasi) snap = null; // pemanggil lama (tanpa SWR) -> hitung ulang
    }
    if (!snap) { snap = smHitungPetaStok_(); basi = false; }
    result.peta = snap.peta;
    result.basi = basi;
    result.dihitungPada = smFmt(snap.dihitungMs);
    result.dihitungMs = snap.dihitungMs;
    result.sumber = 'mesin-stok-v2';
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ===== TAB 1: MINTA STOCK =====
   Memo dikirim dari HP sebagai 1 paket JSON (antrean kirim di HP, idPermintaan unik per memo).
   Server: lock khusus 'memo_ms' (tidak ikut antre di belakang proses stok), 1x tulis header + 1x tulis detail,
   anti dobel 2 lapis: cache idPermintaan (idemMulai_) + kolom "ID Kirim" permanen di sheet. */
var MS_HEADER_ = ['No Memo', 'Tanggal', 'Status', 'Dibuat Oleh', 'Diproses Oleh', 'Tanggal Diproses', 'Items JSON', 'ID Kirim'];
function getMemoMintaStockSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var shHeader = ss.getSheetByName('Memo Minta Stock');
  if (!shHeader) {
    shHeader = ss.insertSheet('Memo Minta Stock');
    shHeader.getRange(1, 1, 1, 8).setValues([MS_HEADER_]).setFontWeight('bold');
  } else if (shHeader.getLastColumn() < 8) {
    if (shHeader.getMaxColumns() < 8) shHeader.insertColumnsAfter(shHeader.getMaxColumns(), 8 - shHeader.getMaxColumns());
    shHeader.getRange(1, 7, 1, 2).setValues([['Items JSON', 'ID Kirim']]).setFontWeight('bold');
  }
  var shDetail = ss.getSheetByName('Memo Minta Stock Detail');
  if (!shDetail) {
    shDetail = ss.insertSheet('Memo Minta Stock Detail');
    shDetail.getRange(1, 1, 1, 8).setValues([['No Memo', 'SKU', 'Nama Produk', 'Sisa Stok Saat Itu', 'Qty Minta', 'Catatan', 'Status Item', 'SKU Diisi Oleh']]);
    shDetail.getRange(1, 1, 1, 8).setFontWeight('bold');
  } else if (shDetail.getLastColumn() < 8) {
    // Kolom 7: Status Item ('' | 'Tidak Tersedia'), kolom 8: jejak pengisian SKU belakangan (produk tanpa SKU dari HP)
    if (shDetail.getMaxColumns() < 8) shDetail.insertColumnsAfter(shDetail.getMaxColumns(), 8 - shDetail.getMaxColumns());
    shDetail.getRange(1, 7, 1, 2).setValues([['Status Item', 'SKU Diisi Oleh']]).setFontWeight('bold');
  }
  return { header: shHeader, detail: shDetail };
}

function prosesSimpanMemoMintaStock(data) {
  var result = { success: false };
  // Validasi & susun paket DI LUAR lock
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var items = (Array.isArray(data.items) ? data.items : []).map(function (it) {
      return {
        sku: String(it.sku || '').trim().slice(0, 60), nama: String(it.nama || '').trim().slice(0, 150),
        sisaStok: parseFloat(it.sisaStok) || 0, qtyMinta: parseFloat(it.qtyMinta) || 0, catatan: String(it.catatan || '').trim().slice(0, 200)
      };
    }).filter(function (it) { return (it.sku || it.nama) && it.qtyMinta > 0; }); // produk baru boleh tanpa SKU (cukup Nama Produk) - SKU diisi belakangan dari web
    if (items.length === 0) throw new Error('Belum ada item di keranjang.');
    if (items.length > 300) throw new Error('Maksimal 300 item per memo.');
    var idKirim = String(data.idPermintaan || '').trim().slice(0, 80);
    var waktu = new Date();
    var wDibuat = parseFloat(data.waktuDibuat);
    // Memo yang tertahan di antrean HP (sinyal jelek) tetap tercatat di waktu staff membuatnya
    if (wDibuat > 0 && wDibuat <= Date.now() + 120000 && wDibuat > Date.now() - 14 * 86400000) waktu = new Date(Math.min(wDibuat, Date.now()));
    var namaStaff = getNamaStaff(data.email);
  } catch (errV) { result.error = errV.toString(); return result; }

  var lock = kunciModul_('memo_ms');
  try { lock.waitLock(20000); } catch (e) { result.error = 'Sistem sibuk, coba lagi.'; return result; }
  try {
    var sheets = getMemoMintaStockSheets();
    var lr = sheets.header.getLastRow();
    // Anti dobel permanen: ID Kirim yang sama sudah tersimpan -> kembalikan memo yang sudah ada
    if (idKirim && lr > 1) {
      var awal = Math.max(2, lr - 499);
      var cek = sheets.header.getRange(awal, 1, lr - awal + 1, 8).getValues();
      for (var i = cek.length - 1; i >= 0; i--) {
        if (String(cek[i][7] || '') === idKirim) return { success: true, noMemo: String(cek[i][0]), duplikat: true, jumlahItem: items.length };
      }
    }
    var noMemo = bikinNomorMemo(sheets.header, 'MS');
    sheets.header.getRange(lr + 1, 1, 1, 8).setValues([[noMemo, waktu, 'Pending', namaStaff, '', '', JSON.stringify(items).slice(0, 49000), idKirim]]);
    var barisDetail = items.map(function (it) { return [noMemo, it.sku, it.nama, it.sisaStok, it.qtyMinta, it.catatan]; });
    sheets.detail.getRange(sheets.detail.getLastRow() + 1, 1, barisDetail.length, 6).setValues(barisDetail);
    result.success = true;
    result.noMemo = noMemo;
    result.jumlahItem = items.length;
    result.diterima = Date.now();
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

// Status memo Minta Stock -> kelompok tampilan
function msKelompokStatus_(status) {
  var s = String(status || '');
  if (s === 'Sudah Dipesan') return 'dipesan';
  if (s === 'Diabaikan') return 'abaikan';
  if (s.indexOf('Dibatalkan') === 0) return 'batal';
  return 'menunggu'; // Pending / Bisa PO Stock
}

// ===== AKSI: lihat_memo_minta_stock_pembelian - daftar memo + itemnya (1 panggilan) untuk web Pembelian =====
function prosesLihatMemoMintaStockPembelian(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'adminPembelian')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sheets = getMemoMintaStockSheets(), tz = Session.getScriptTimeZone();
    var lrH = sheets.header.getLastRow(), lrD = sheets.detail.getLastRow();
    var memos = [], peta = {};
    if (lrH > 1) sheets.header.getRange(2, 1, lrH - 1, 8).getValues().forEach(function (r, i) {
      var no = String(r[0] || '').trim(); if (!no) return;
      var m = {
        row: i + 2, noMemo: no, status: String(r[2] || 'Pending'), kelompok: msKelompokStatus_(r[2]),
        tanggal: r[1] instanceof Date ? Utilities.formatDate(r[1], tz, 'dd MMM yyyy HH:mm') : String(r[1] || '-'),
        ms: r[1] instanceof Date ? r[1].getTime() : 0, dibuatOleh: String(r[3] || '-'),
        diprosesOleh: String(r[4] || ''), tanggalProses: r[5] instanceof Date ? Utilities.formatDate(r[5], tz, 'dd MMM yyyy HH:mm') : '',
        items: [], _json: r[6]
      };
      memos.push(m); peta[no] = m;
    });
    // Batasi: semua yang masih menunggu + 80 memo selesai terbaru
    memos.sort(function (a, b) { return (b.ms - a.ms) || (b.row - a.row); });
    var nSelesai = 0;
    memos = memos.filter(function (m) { if (m.kelompok === 'menunggu') return true; nSelesai++; return nSelesai <= 80; });
    var dipakai = {}; memos.forEach(function (m) { dipakai[m.noMemo] = m; });
    var lebarD = Math.min(8, Math.max(6, sheets.detail.getLastColumn()));
    if (lrD > 1) sheets.detail.getRange(2, 1, lrD - 1, lebarD).getValues().forEach(function (r, iD) {
      var m = dipakai[String(r[0] || '').trim()]; if (!m) return;
      var statusItem = lebarD >= 7 ? String(r[6] || '').trim() : '';
      var diisiOleh = lebarD >= 8 ? String(r[7] || '').trim() : '';
      var skuD = String(r[1] || '').trim();
      m.items.push({ drow: iD + 2, sku: skuD, nama: String(r[2] || ''), sisa: parseFloat(r[3]) || 0, qty: parseFloat(r[4]) || 0, catatan: String(r[5] || ''),
        statusItem: statusItem, tidakTersedia: statusItem === 'Tidak Tersedia', tanpaSku: !skuD, skuDiisiOleh: diisiOleh });
    });
    memos.forEach(function (m) {
      if (!m.items.length && m._json) { try { m.items = JSON.parse(m._json).map(function (it) { return { sku: it.sku, nama: it.nama, sisa: it.sisaStok, qty: it.qtyMinta, catatan: it.catatan }; }); } catch (e) { } }
      delete m._json;
    });
    result.success = true;
    result.memos = memos;
    result.jumlahMenunggu = memos.filter(function (m) { return m.kelompok === 'menunggu'; }).length;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: lihat_memo_gudang_lain_pembelian - memo Barang Masuk, Hilang/Rusak & Stock Opname (+ item) =====
// Dipakai panel "Cek Memo Gudang" di web Pembelian supaya SEMUA jenis memo gudang terlihat (bukan hanya Minta Stock).
function prosesLihatMemoGudangLainPembelian(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'adminPembelian')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tz = Session.getScriptTimeZone(), batas = 250; // v2026.10.97 (DN-849): riwayat memo lebih panjang
    var namaMap = {};
    try { smBacaSheet(namaSheetToko('Master Produk'), 2).forEach(function (r) { namaMap[smKey(r[0])] = String(r[1] || ''); }); } catch (eN) { }
    var fmt = function (v) { return v instanceof Date ? Utilities.formatDate(v, tz, 'dd MMM yyyy HH:mm') : String(v || '-'); };
    var kelompok = function (st) {
      var s = String(st || '');
      if (s.indexOf('Dibatalkan') === 0) return 'batal';
      if (/Dieksekusi|Disetujui|Terverifikasi|Selesai|Divalidasi/i.test(s)) return 'selesai';
      if (/Ditolak/i.test(s)) return 'ditolak';
      return 'menunggu';
    };
    var semua = [];
    var muat = function (jenis, sheets, nKolH, nKolD, petaItem) {
      var lrH = sheets.header.getLastRow(), lrD = sheets.detail.getLastRow();
      if (lrH < 2) return;
      var memos = [];
      sheets.header.getRange(2, 1, lrH - 1, Math.min(nKolH, sheets.header.getLastColumn())).getValues().forEach(function (r, i) {
        var no = String(r[0] || '').trim(); if (!no) return;
        memos.push({
          jenis: jenis, row: i + 2, noMemo: no, status: String(r[2] || '-'), kelompok: kelompok(r[2]),
          tanggal: fmt(r[1]), ms: r[1] instanceof Date ? r[1].getTime() : 0, dibuatOleh: String(r[3] || '-'),
          diprosesOleh: String(r[4] || ''), tanggalProses: r[5] instanceof Date ? fmt(r[5]) : '',
          noInvoiceTerkait: jenis === 'barangmasuk' ? String(r[6] || '') : '', noSuratJalan: jenis === 'barangmasuk' ? String(r[7] || '') : '', items: []
        });
      });
      memos.sort(function (a, b) { return (b.ms - a.ms) || (b.row - a.row); });
      var nLain = 0;
      memos = memos.filter(function (m) { if (m.kelompok === 'menunggu') return true; nLain++; return nLain <= batas; });
      var peta = {}; memos.forEach(function (m) { peta[m.noMemo] = m; });
      if (lrD > 1) sheets.detail.getRange(2, 1, lrD - 1, Math.min(nKolD, sheets.detail.getLastColumn())).getValues().forEach(function (r) {
        var m = peta[String(r[0] || '').trim()]; if (!m) return;
        var it = petaItem(r);
        if (!it.nama) it.nama = namaMap[smKey(it.sku)] || '';
        m.items.push(it);
      });
      semua = semua.concat(memos);
    };
    muat('barangmasuk', getMemoBarangMasukSheets(), 9, 4, function (r) { return { sku: String(r[1] || '').trim(), nama: '', qty: parseFloat(r[2]) || 0, catatan: String(r[3] || '') }; });
    muat('hilangrusak', getMemoHilangRusakSheets(), 6, 5, function (r) { return { sku: String(r[1] || '').trim(), nama: '', qty: parseFloat(r[2]) || 0, catatan: String(r[3] || ''), foto: String(r[4] || '') }; });
    muat('stockopname', getMemoStockOpnameSheets(), 6, 6, function (r) {
      var sistem = parseFloat(r[3]) || 0, fisik = parseFloat(r[4]) || 0;
      return { sku: String(r[1] || '').trim(), nama: String(r[2] || ''), sisa: sistem, qty: fisik, selisih: fisik - sistem, catatan: String(r[5] || '') };
    });
    semua.sort(function (a, b) { return b.ms - a.ms; });
    result.success = true;
    result.memos = semua;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: ms_update_item { noMemo, drow, sku?, tidakTersedia? } =====
// Item Memo Minta Stock yang dikirim gudang TANPA SKU (produk belum terdaftar): Admin Pembelian mengisi SKU-nya
// dari web, atau menandai item "Tidak Tersedia" supaya diabaikan (tidak ikut disalin ke pesanan PO supplier).
function prosesMsUpdateItem(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'adminPembelian')) throw new Error('Anda tidak punya izin untuk aksi ini.');
  } catch (eI) { result.error = eI.toString(); return result; }
  var lock = kunciModul_('memo_ms');
  try { lock.waitLock(15000); } catch (e) { result.error = 'Sistem sibuk, coba lagi.'; return result; }
  try {
    var noMemo = String(data.noMemo || '').trim(), drow = parseInt(data.drow, 10);
    if (!noMemo || !(drow >= 2)) throw new Error('Item memo tidak valid.');
    var sheets = getMemoMintaStockSheets();
    if (drow > sheets.detail.getLastRow()) throw new Error('Item memo tidak ditemukan - muat ulang panel.');
    var r = sheets.detail.getRange(drow, 1, 1, 8).getValues()[0];
    if (String(r[0] || '').trim() !== noMemo) throw new Error('Item tidak cocok dengan memo ' + noMemo + ' - muat ulang panel.');
    var oleh = getNamaStaff(data.email) || data.email || '';
    var waktu = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm');
    var skuBaru = String(r[1] || '').trim(), namaBaru = String(r[2] || ''), statusBaru = String(r[6] || '').trim(), jejak = String(r[7] || '');
    result.terdaftar = true;
    if (data.sku !== undefined && data.sku !== null) {
      skuBaru = String(data.sku || '').replace(/\s+/g, '').slice(0, 60); // aturan SKU OmniAI: tanpa spasi
      if (skuBaru) {
        var namaMaster = '';
        try {
          smBacaSheet(namaSheetToko('Master Produk'), 2).forEach(function (m) { if (!namaMaster && smKey(m[0]) === smKey(skuBaru)) namaMaster = String(m[1] || ''); });
        } catch (eM) { }
        result.terdaftar = !!namaMaster;
        result.namaMaster = namaMaster;
        statusBaru = ''; // sudah punya SKU -> otomatis tersedia lagi
        jejak = 'SKU diisi ' + waktu + ' oleh ' + oleh;
      } else {
        jejak = 'SKU dikosongkan ' + waktu + ' oleh ' + oleh;
      }
    }
    if (data.tidakTersedia !== undefined && data.tidakTersedia !== null) {
      statusBaru = data.tidakTersedia ? 'Tidak Tersedia' : '';
      jejak = (data.tidakTersedia ? 'Ditandai Tidak Tersedia ' : 'Ditandai tersedia lagi ') + waktu + ' oleh ' + oleh;
    }
    sheets.detail.getRange(drow, 2).setValue(skuBaru);
    sheets.detail.getRange(drow, 7, 1, 2).setValues([[statusBaru, jejak]]);
    result.success = true;
    result.item = { drow: drow, sku: skuBaru, nama: namaBaru, statusItem: statusBaru, tidakTersedia: statusBaru === 'Tidak Tersedia', tanpaSku: !skuBaru, skuDiisiOleh: jejak };
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

// ===== AKSI: tandai_memo_minta_stock { noMemo, keputusan: 'dipesan' | 'abaikan' | 'kembalikan' } =====
function prosesTandaiMemoMintaStock(data) {
  return withTransaction(data.email, null, 'memo_ms', function () {
    var result = { success: false };
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'adminPembelian')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var statusBaru = ({ dipesan: 'Sudah Dipesan', abaikan: 'Diabaikan', kembalikan: 'Pending' })[data.keputusan];
    if (!statusBaru) throw new Error('Aksi tidak dikenali');
    var daftarNo = (Array.isArray(data.noMemo) ? data.noMemo : [data.noMemo]).map(function (x) { return String(x || '').trim(); }).filter(function (x) { return x; });
    if (!daftarNo.length) throw new Error('No memo kosong');
    var sheets = getMemoMintaStockSheets(), lr = sheets.header.getLastRow();
    if (lr < 2) throw new Error('Memo tidak ditemukan.');
    var vals = sheets.header.getRange(2, 1, lr - 1, 3).getValues();
    var oleh = getNamaStaff(data.email) || data.email || '', sekarang = new Date(), n = 0;
    daftarNo.forEach(function (no) {
      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][0]).trim() !== no) continue;
        if (String(vals[i][2] || '').indexOf('Dibatalkan') === 0) throw new Error('Memo ' + no + ' sudah dibatalkan gudang.');
        sheets.header.getRange(i + 2, 3).setValue(statusBaru);
        sheets.header.getRange(i + 2, 5, 1, 2).setValues([[statusBaru === 'Pending' ? '' : oleh, statusBaru === 'Pending' ? '' : sekarang]]);
        n++; return;
      }
      throw new Error('Memo ' + no + ' tidak ditemukan.');
    });
    result.success = true;
    result.status = statusBaru;
    result.jumlah = n;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

function prosesLihatDaftarMemoMintaStock(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sheets = getMemoMintaStockSheets();
    var lastRow = sheets.header.getLastRow();
    var daftar = [];
    var tz = Session.getScriptTimeZone();
    if (lastRow > 1) {
      sheets.header.getRange(2, 1, lastRow - 1, 6).getValues().forEach(function (row, idx) {
        if (!row[0]) return;
        daftar.push({
          row: idx + 2, noMemo: row[0],
          tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy HH:mm') : String(row[1] || '-'),
          status: row[2], dibuatOleh: row[3], disetujuiOleh: row[4] || '-'
        });
      });
    }
    daftar.reverse();
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesLihatDetailMemoMintaStock(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noMemo = String(data.noMemo || '').trim();
    var sheets = getMemoMintaStockSheets();
    var lastRow = sheets.detail.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var lebarDt = Math.min(8, Math.max(6, sheets.detail.getLastColumn()));
      sheets.detail.getRange(2, 1, lastRow - 1, lebarDt).getValues().forEach(function (row, idx) {
        if (String(row[0]).trim() !== noMemo) return;
        daftar.push({ row: idx + 2, sku: row[1], nama: row[2], sisaStokSaatItu: row[3], qtyMinta: row[4], catatan: row[5], statusItem: lebarDt >= 7 ? String(row[6] || '').trim() : '' });
      });
    }
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Kantor review, boleh edit qty per item, lalu konfirmasi -> status jadi "Bisa PO Stock".
// TIDAK PERNAH mengubah stock - ini murni sinyal buat next-step pembelian.
function prosesApproveMemoMintaStock(data) {
  return withTransaction(data.email, 'mintaStock', 'stok', function () {
    var result = { success: false };
    var noMemo = String(data.noMemo || '').trim();
    var itemsEdit = data.items || []; // [{row, qtyMinta}] - opsional, kalau kantor mau ubah qty dulu

    var sheets = getMemoMintaStockSheets();
    itemsEdit.forEach(function (it) {
      if (it.row) sheets.detail.getRange(it.row, 5).setValue(it.qtyMinta);
    });

    var lastRowHeader = sheets.header.getLastRow();
    var rowTarget = -1;
    if (lastRowHeader > 1) {
      var vals = sheets.header.getRange(2, 1, lastRowHeader - 1, 1).getValues();
      for (var i = 0; i < vals.length; i++) { if (String(vals[i][0]).trim() === noMemo) { rowTarget = i + 2; break; } }
    }
    if (rowTarget === -1) throw new Error('Memo tidak ditemukan.');

    sheets.header.getRange(rowTarget, 3, 1, 3).setValues([['Bisa PO Stock', getNamaStaff(data.email), new Date()]]);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

/* ===== TAB 2: CATAT BARANG MASUK (langsung eksekusi stock, TANPA approval) ===== */
function getMemoBarangMasukSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var shHeader = ss.getSheetByName('Memo Catat Barang Masuk');
  var headerBaru = ['No Memo', 'Tanggal', 'Status', 'Dicatat Oleh', 'Dieksekusi Oleh', 'Tanggal Dieksekusi', 'No Invoice Terkait'];
  if (!shHeader) {
    shHeader = ss.insertSheet('Memo Catat Barang Masuk');
    shHeader.getRange(1, 1, 1, 7).setValues([headerBaru]);
    shHeader.getRange(1, 1, 1, 7).setFontWeight('bold');
  } else if (shHeader.getLastColumn() < 6) {
    // Migrasi dari 3 kolom lama (belum ada Status) - data lama semua dianggap "Dieksekusi"
    // karena versi sebelumnya emang langsung eksekusi stock pas disimpan.
    var lastRow = shHeader.getLastRow();
    shHeader.getRange(1, 1, 1, 7).setValues([headerBaru]);
    shHeader.getRange(1, 1, 1, 7).setFontWeight('bold');
    if (lastRow > 1) {
      var dataLama = shHeader.getRange(2, 1, lastRow - 1, 3).getValues(); // No Memo, Tanggal, DicatatOleh (kolom lama)
      var dataBaru = dataLama.map(function (r) { return [r[0], r[1], 'Dieksekusi', r[2], r[2], r[1], '']; });
      shHeader.getRange(2, 1, dataBaru.length, 7).setValues(dataBaru);
    }
  } else if (shHeader.getLastColumn() < 7) {
    // Migrasi tambahan kolom No Invoice Terkait - data lama dikosongkan aja (nggak ada info itu)
    shHeader.getRange(1, 7).setValue('No Invoice Terkait').setFontWeight('bold');
  }
  // Kolom tambahan alur Validasi Masuk: No Surat Jalan (input gudang) & No Validasi (hasil back-office)
  if (shHeader.getLastColumn() < 8) shHeader.getRange(1, 8).setValue('No Surat Jalan').setFontWeight('bold');
  if (shHeader.getLastColumn() < 9) shHeader.getRange(1, 9).setValue('No Validasi').setFontWeight('bold');
  var shDetail = ss.getSheetByName('Memo Catat Barang Masuk Detail');
  if (!shDetail) {
    shDetail = ss.insertSheet('Memo Catat Barang Masuk Detail');
    shDetail.getRange(1, 1, 1, 4).setValues([['No Memo', 'SKU', 'Qty Masuk', 'Catatan']]);
    shDetail.getRange(1, 1, 1, 4).setFontWeight('bold');
  }
  return { header: shHeader, detail: shDetail };
}

// Murni catat draft - TIDAK menyentuh Stock Ledger sama sekali. Stock baru berubah
// setelah Back Office mengeksekusi lewat prosesEksekusiMemoBarangMasuk() di bawah.
function prosesSimpanMemoBarangMasuk(data) {
  var items;
  return withTransaction(data.email, 'mintaStock', 'stok', function () {
    var result = { success: false };
    var sheets = getMemoBarangMasukSheets();
    // ACTION LOG: kiriman ulang dari HP (ID sama) mengembalikan memo yang sudah ada, tidak membuat memo baru
    var idKirim = String(data.idPermintaan || '').trim().slice(0, 80);
    if (sheets.header.getLastColumn() < 10) sheets.header.getRange(1, 10).setValue('ID Kirim').setFontWeight('bold');
    if (idKirim) {
      var lrBM = sheets.header.getLastRow();
      if (lrBM > 1) {
        var awalBM = Math.max(2, lrBM - 499);
        var cekBM = sheets.header.getRange(awalBM, 1, lrBM - awalBM + 1, 10).getValues();
        for (var hb = cekBM.length - 1; hb >= 0; hb--) {
          if (String(cekBM[hb][9] || '') === idKirim) return { success: true, noMemo: String(cekBM[hb][0]).trim(), duplikat: true };
        }
      }
    }
    var noMemo = bikinNomorMemo(sheets.header, 'CSM');
    var namaStaff = getNamaStaff(data.email);
    var sekarang = new Date();
    var noInvoiceTerkait = String(data.noInvoiceTerkait || '').trim();
    var noSuratJalan = String(data.noSuratJalan || '').trim();
    // Antrean HP: Tanggal = saat barang dicatat di gudang (bukan saat sinyal kembali)
    var wDibuatBM = parseFloat(data.waktuDibuat);
    if (wDibuatBM > 0 && wDibuatBM <= Date.now() + 120000 && wDibuatBM > Date.now() - 14 * 86400000) sekarang = new Date(Math.min(wDibuatBM, Date.now()));

    // Fase Gudang: cuma catat fisik. Stock BELUM bertambah sampai divalidasi di menu "Validasi Masuk" (web).
    sheets.header.appendRow([noMemo, sekarang, 'Menunggu Verifikasi', namaStaff, '', '', noInvoiceTerkait, noSuratJalan, '', idKirim]);
    // Kolom 5 "Nama Produk" (opsional) - diisi bila admin mengetik nama manual (SKU belum ada di Master Produk)
    var adaNama = items.some(function (it) { return String(it.nama || '').trim(); });
    if (adaNama && !String(sheets.detail.getRange(1, 5).getValue() || '').trim()) sheets.detail.getRange(1, 5).setValue('Nama Produk').setFontWeight('bold');
    var barisDetail = items.map(function (it) {
      var b = [noMemo, String(it.sku || '').trim(), it.qtyMasuk || 0, it.catatan || ''];
      if (adaNama) b.push(String(it.nama || '').trim().slice(0, 150));
      return b;
    });
    sheets.detail.getRange(sheets.detail.getLastRow() + 1, 1, barisDetail.length, adaNama ? 5 : 4).setValues(barisDetail);

    result.success = true;
    result.noMemo = noMemo;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      items = data.items || [];
      if (items.length === 0) throw new Error('Belum ada item di keranjang.');
    }
  });
}

// Back Office eksekusi memo -> BARU di sini Stock Ledger kesentuh.
function prosesEksekusiMemoBarangMasuk(data) {
  return withTransaction(data.email, 'mintaStock', 'stok', function () {
    var result = { success: false };
    var noMemo = String(data.noMemo || '').trim();
    var sheets = getMemoBarangMasukSheets();

    var lastRowHeader = sheets.header.getLastRow();
    var rowTarget = -1, statusSaatIni = '';
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 3).getValues();
      for (var i = 0; i < valsHeader.length; i++) {
        if (String(valsHeader[i][0]).trim() === noMemo) { rowTarget = i + 2; statusSaatIni = valsHeader[i][2]; break; }
      }
    }
    if (rowTarget === -1) throw new Error('Memo tidak ditemukan.');
    if (statusSaatIni === 'Dieksekusi') throw new Error('Memo ini udah dieksekusi sebelumnya.');
    if (statusSaatIni === 'Tervalidasi' || String(statusSaatIni).indexOf('Selesai') === 0) throw new Error('Memo ini udah divalidasi lewat menu Validasi Masuk - stock-nya sudah masuk.');

    var namaStaff = getNamaStaff(data.email);
    var sekarang = new Date();
    var waktuMemo = sheets.header.getRange(rowTarget, 2).getValue();
    if (!(waktuMemo instanceof Date)) waktuMemo = sekarang; // waktu fisik barang tiba = waktu memo dibuat
    var lastRowDetail = sheets.detail.getLastRow();
    var shLedger = getStockLedgerSheet();
    var barisLedger = [];
    if (lastRowDetail > 1) {
      sheets.detail.getRange(2, 1, lastRowDetail - 1, 4).getValues().forEach(function (row) {
        if (String(row[0]).trim() !== noMemo) return;
        barisLedger.push([waktuMemo, row[1], 'Masuk', row[2], 'Catat Barang Masuk ' + noMemo + (row[3] ? ' (' + row[3] + ')' : ''), namaStaff, 0, 0]);
      });
    }
    if (barisLedger.length > 0) sisipkanLedgerKronologis_(shLedger, barisLedger, 8);
    hitungUlangSaldoStok_();

    sheets.header.getRange(rowTarget, 3, 1, 3).setValues([['Dieksekusi', namaStaff, sekarang]]);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

function prosesLihatDaftarMemoBarangMasuk(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sheets = getMemoBarangMasukSheets();
    var lastRow = sheets.header.getLastRow();
    var daftar = [];
    var tz = Session.getScriptTimeZone();
    if (lastRow > 1) {
      sheets.header.getRange(2, 1, lastRow - 1, 9).getValues().forEach(function (row) {
        if (!row[0]) return;
        daftar.push({
          noMemo: row[0],
          tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy HH:mm') : String(row[1] || '-'),
          status: row[2], dicatatOleh: row[3], noInvoiceTerkait: row[6] || '-',
          noSuratJalan: row[7] || '', noValidasi: row[8] || ''
        });
      });
    }
    daftar.reverse();
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Detail 1 memo Barang Masuk (dipakai modal Detail Memo web & mobile - termasuk tombol Batalkan Memo)
function prosesLihatDetailMemoBarangMasuk(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noMemo = String(data.noMemo || '').trim();
    var sheets = getMemoBarangMasukSheets();
    var tz = Session.getScriptTimeZone();
    var lr = sheets.header.getLastRow(), nKol = Math.max(9, Math.min(10, sheets.header.getLastColumn()));
    var h = null;
    if (lr > 1) sheets.header.getRange(2, 1, lr - 1, nKol).getValues().some(function (r) { if (String(r[0]).trim() === noMemo) { h = r; return true; } return false; });
    if (!h) throw new Error('Memo ' + noMemo + ' tidak ditemukan.');
    var nama = {};
    try {
      var shM = getMasterProdukSheet(data.toko);
      var lm = shM.getLastRow();
      if (lm > 1) shM.getRange(2, 1, lm - 1, 2).getValues().forEach(function (r) { nama[String(r[0]).trim()] = String(r[1] || ''); });
    } catch (e) { }
    var item = [];
    var ld = sheets.detail.getLastRow(), lebarD = Math.min(5, Math.max(4, sheets.detail.getLastColumn()));
    if (ld > 1) sheets.detail.getRange(2, 1, ld - 1, lebarD).getValues().forEach(function (r, iD) {
      if (String(r[0]).trim() !== noMemo) return;
      var sku = String(r[1] || '').trim();
      // Kolom 5 "Nama Produk" (diisi lewat Edit Memo di web) menang atas nama Master Produk
      var namaManual = lebarD >= 5 ? String(r[4] || '').trim() : '';
      item.push({ row: iD + 2, sku: sku, nama: namaManual || nama[sku] || '', namaManual: !!namaManual, qty: parseFloat(r[2]) || 0, catatan: String(r[3] || '') });
    });
    var staff = getStaffByEmail(data.email);
    var status = String(h[2] || '');
    result.memo = {
      noMemo: noMemo, tanggal: h[1] instanceof Date ? Utilities.formatDate(h[1], tz, 'dd MMM yyyy HH:mm') : String(h[1] || ''),
      status: status, dicatatOleh: String(h[3] || ''), dieksekusiOleh: String(h[4] || ''),
      tanggalDieksekusi: h[5] instanceof Date ? Utilities.formatDate(h[5], tz, 'dd MMM yyyy HH:mm') : '',
      noInvoiceTerkait: String(h[6] || ''), noSuratJalan: String(h[7] || ''), noValidasi: String(h[8] || ''), catatanBatal: String(h[9] || '')
    };
    result.item = item;
    // Hak batal (aturan sama dengan prosesBatalkanMemoGudang)
    var menunggu = !!VM_STATUS_MENUNGGU[status];
    var isOwner = !!(staff && staff.role === 'Owner');
    result.bolehForceClose = isOwner && menunggu;
    result.bolehVoid = (isOwner && (menunggu || status === 'Dieksekusi')) || (menunggu && String(h[3] || '').trim() === getNamaStaff(data.email));
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* =====================================================================
   KELOLA MEMO GUDANG (web) - EDIT / INPUT MANUAL No SKU, Nama Produk & Jumlah
   AKSI: edit_item_memo_gudang { jenis: 'mintastock'|'barangmasuk'|'hilangrusak', noMemo,
         items: [{ sku, nama, qty, stokFisik?, catatan }] }
   - Hanya memo yang BELUM diproses (stok belum berubah) yang boleh diedit.
   - Baris detail diubah DI TEMPAT (foto bukti Hilang/Rusak & jejak lain tetap menempel), sisa baris
     dihapus, baris tambahan ditulis di bawah. Isi sebelum & sesudah dicatat di sheet "Log Edit Memo Gudang".
   ===================================================================== */
var MEMO_EDIT_LOG_SHEET_ = 'Log Edit Memo Gudang';
function memoEditLogSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(MEMO_EDIT_LOG_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(MEMO_EDIT_LOG_SHEET_);
    sh.getRange(1, 1, 1, 6).setValues([['Waktu', 'Jenis Memo', 'No Memo', 'Diubah Oleh', 'Sebelum (JSON)', 'Sesudah (JSON)']]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}
function prosesEditItemMemoGudang(data) {
  var result = { success: false };
  var jenis = String(data.jenis || '').trim();
  var noMemo = String(data.noMemo || '').trim();
  var items;
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    if (['mintastock', 'barangmasuk', 'hilangrusak', 'stockopname'].indexOf(jenis) === -1) throw new Error('Jenis memo tidak dikenal.');
    if (!noMemo) throw new Error('No Memo kosong.');
    items = (Array.isArray(data.items) ? data.items : []).map(function (it) {
      var stokFisik = it.stokFisik === '' || it.stokFisik === null || it.stokFisik === undefined ? null : parseFloat(it.stokFisik);
      return {
        sku: String(it.sku || '').replace(/\s+/g, '').trim().slice(0, 60), nama: String(it.nama || '').replace(/\s+/g, ' ').trim().slice(0, 150),
        qty: Math.max(0, parseFloat(it.qty) || 0), stokFisik: isNaN(stokFisik) ? null : stokFisik, catatan: String(it.catatan || '').trim().slice(0, 300),
        asal: parseInt(it.asal, 10) || 0
      };
    }).filter(function (it) { return (it.sku || it.nama) && (jenis === 'stockopname' ? it.qty >= 0 : it.qty > 0); });
    if (!items.length) throw new Error(jenis === 'stockopname' ? 'Minimal 1 baris berisi SKU / nama.' : 'Minimal 1 baris dengan qty lebih dari 0.');
    if (items.length > 300) throw new Error('Maksimal 300 baris per memo.');
    if (jenis !== 'mintastock' && jenis !== 'stockopname') items.forEach(function (it) { if (!it.sku) throw new Error('No SKU wajib diisi untuk "' + (it.nama || 'baris tanpa nama') + '".'); });
    // Stock Opname: stok sistem untuk SKU yang baru diisi/diganti - dibaca di luar lock (berat)
    var petaStokSO = null;
    if (jenis === 'stockopname' && items.some(function (it) { return it.sku; })) {
      petaStokSO = {};
      try {
        var posisiSO = prosesLihatStock({ email: data.email, toko: data.toko });
        if (posisiSO.success) posisiSO.daftar.forEach(function (d) { petaStokSO[String(d.sku).trim()] = d.stockSaatIni; });
      } catch (eSO) { }
    }
  } catch (eV) { result.error = eV.toString(); return result; }

  var lock = kunciModul_('stok');
  try { lock.waitLock(15000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  try {
    var sheets = jenis === 'mintastock' ? getMemoMintaStockSheets() : (jenis === 'barangmasuk' ? getMemoBarangMasukSheets() : (jenis === 'stockopname' ? getMemoStockOpnameSheets() : getMemoHilangRusakSheets()));
    // 1) Header + status: hanya memo yang belum diproses
    var lrH = sheets.header.getLastRow(), rowH = -1, status = '';
    if (lrH > 1) {
      var vh = sheets.header.getRange(2, 1, lrH - 1, 3).getValues();
      for (var i = 0; i < vh.length; i++) if (String(vh[i][0]).trim() === noMemo) { rowH = i + 2; status = String(vh[i][2] || '').trim(); break; }
    }
    if (rowH === -1) throw new Error('Memo ' + noMemo + ' tidak ditemukan.');
    var bolehEdit = jenis === 'mintastock' ? (status === '' || status === 'Pending' || status === 'Bisa PO Stock')
      : (jenis === 'barangmasuk' ? !!VM_STATUS_MENUNGGU[status]
        : (jenis === 'stockopname' ? (status === '' || status === 'Menunggu Verifikasi') : (status === '' || status === 'Menunggu')));
    if (!bolehEdit) throw new Error('Memo berstatus "' + status + '" sudah diproses - tidak bisa diedit lagi.');

    // 2) Kolom detail per jenis memo
    var lebar = jenis === 'mintastock' ? 6 : (jenis === 'barangmasuk' ? 5 : (jenis === 'stockopname' ? 8 : 4));
    if (jenis === 'barangmasuk' && !String(sheets.detail.getRange(1, 5).getValue() || '').trim()) sheets.detail.getRange(1, 5).setValue('Nama Produk').setFontWeight('bold');
    var lrD = sheets.detail.getLastRow(), lama = [];
    if (lrD > 1) sheets.detail.getRange(2, 1, lrD - 1, lebar).getValues().forEach(function (r, iD) { if (String(r[0]).trim() === noMemo) lama.push({ row: iD + 2, v: r }); });

    function barisBaru(it, ref) {
      if (jenis === 'mintastock') {
        var sisa = it.stokFisik !== null ? it.stokFisik : (ref ? (parseFloat(ref[3]) || 0) : 0);
        return [noMemo, it.sku, it.nama || it.sku, sisa, it.qty, it.catatan];
      }
      if (jenis === 'barangmasuk') return [noMemo, it.sku, it.qty, it.catatan, it.nama];
      if (jenis === 'stockopname') {
        // Stok sistem lama dipertahankan bila SKU tidak berubah (akurat sesuai momen hitung); SKU baru -> stok sistem sekarang
        var refSku = ref ? String(ref[1] || '').trim() : null;
        var sistem = '';
        if (it.sku) sistem = (ref && refSku === it.sku && ref[3] !== '' && ref[3] !== null) ? ref[3] : (petaStokSO && petaStokSO[it.sku] !== undefined ? petaStokSO[it.sku] : 0);
        return [noMemo, it.sku, it.nama || '', sistem, it.qty, it.catatan, ref ? (ref[6] || '') : '', it.sku ? '' : 'Ya'];
      }
      return [noMemo, it.sku, it.qty, it.catatan];
    }
    // Stock Opname: baris asal dicocokkan lewat nomor barisnya (it.asal) supaya foto tidak tertukar saat baris dihapus
    function refUntuk(it, posisi) {
      if (jenis === 'stockopname' && it.asal) {
        for (var z = 0; z < lama.length; z++) if (lama[z].row === it.asal) return lama[z].v;
        return null;
      }
      return lama[posisi] ? lama[posisi].v : null;
    }
    // 3) Ubah di tempat -> hapus sisa (dari bawah) -> tambah baris baru
    var nSama = Math.min(lama.length, items.length);
    for (var a = 0; a < nSama; a++) {
      var rgS = sheets.detail.getRange(lama[a].row, 1, 1, lebar);
      rgS.offset(0, 1, 1, 1).setNumberFormat('@');
      rgS.setValues([barisBaru(items[a], refUntuk(items[a], a))]);
    }
    for (var b = lama.length - 1; b >= nSama; b--) sheets.detail.deleteRow(lama[b].row);
    if (items.length > nSama) {
      var tambah = items.slice(nSama).map(function (it) { return barisBaru(it, jenis === 'stockopname' ? refUntuk(it, -1) : null); });
      var m = sheets.detail.getLastRow() + 1;
      sheets.detail.getRange(m, 2, tambah.length, 1).setNumberFormat('@');
      sheets.detail.getRange(m, 1, tambah.length, lebar).setValues(tambah);
    }
    // 4) Minta Stock: kolom "Items JSON" ikut diperbarui (cadangan pembaca lama)
    if (jenis === 'mintastock' && sheets.header.getLastColumn() >= 7) {
      sheets.header.getRange(rowH, 7).setValue(JSON.stringify(items.map(function (it) {
        return { sku: it.sku, nama: it.nama, sisaStok: it.stokFisik !== null ? it.stokFisik : 0, qtyMinta: it.qty, catatan: it.catatan };
      })).slice(0, 49000));
    }
    var oleh = getNamaStaff(data.email) || data.email || '';
    memoEditLogSheet_().appendRow([new Date(), jenis, noMemo, oleh, JSON.stringify(lama.map(function (x) { return x.v.slice(1); })).slice(0, 45000), JSON.stringify(items).slice(0, 45000)]);
    result.success = true;
    result.noMemo = noMemo;
    result.jumlahBaris = items.length;
    result.status = status;
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

