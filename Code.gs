// Dipanggil dari halaman toko online publik - list semua produk yang ditandai
// "Tampil di Website" = TRUE di Produk Master. Read-only, aman diakses siapapun.
function prosesLihatKatalogPublik(data) {
  var result = { success: false };
  try {
    var toko = data.toko || 'Waterground';
    var sh = getMasterProdukSheet(toko);
    var lastRow = sh.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 18).getValues();
      vals.forEach(function (row) {
        var sku = String(row[0] || '').trim();
        if (!sku || row[17] !== true) return; // skip yang nggak ditandai tampil di website
        if (katPetaArsip_(toko)[sku]) return;  // produk arsip tidak dijual di website
        daftar.push({
          sku: sku,
          nama: String(row[1] || '').trim(),
          harga: parseFloat(row[2]) || 0,
          kategori: String(row[7] || '').trim() || 'Lainnya',
          urlFoto: String(row[8] || '').trim(),
          deskripsi: String(row[9] || '').trim(),
          brand: String(row[10] || '').trim()
        });
      });
    }
    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

// Dipanggil pas pengunjung checkout di toko online. Harga dihitung ULANG di server
// dari Produk Master (BUKAN percaya angka yang dikirim browser) - biar nggak bisa
// dimanipulasi orang iseng lewat DevTools/console browser.
function prosesBuatPesananWebsite(data) {
  var nama, hp, alamat, catatan, items;
  return withTransaction(data.email, null, 'penjualan', function () {
    var result = { success: false };
    var toko = data.toko || 'Waterground';
    var shMaster = getMasterProdukSheet(toko);
    var lastRowMaster = shMaster.getLastRow();
    var mapProduk = {};
    if (lastRowMaster > 1) {
      var valsMaster = shMaster.getRange(2, 1, lastRowMaster - 1, 18).getValues();
      valsMaster.forEach(function (row) {
        var sku = String(row[0] || '').trim();
        if (sku) mapProduk[sku] = { nama: String(row[1] || '').trim(), harga: parseFloat(row[2]) || 0, tampil: row[17] === true && !katPetaArsip_(toko)[sku] };
      });
    }

    var totalPesanan = 0;
    var ringkasanProduk = [];
    items.forEach(function (item) {
      var sku = String(item.sku || '').trim();
      var qty = parseInt(item.qty, 10) || 0;
      var p = mapProduk[sku];
      if (!p || !p.tampil || qty <= 0) return; // skip item yang nggak valid/nggak beneran tampil di website
      totalPesanan += p.harga * qty;
      ringkasanProduk.push(p.nama + ' x' + qty);
    });
    if (ringkasanProduk.length === 0) throw new Error('Produk di keranjang tidak valid atau sudah tidak tersedia.');

    var sh = getPesananWebsiteSheet();
    var tz = Session.getScriptTimeZone();
    var sekarang = new Date();
    var nomorUrut = String(sh.getLastRow()).padStart(4, '0');
    var orderId = 'WS-' + Utilities.formatDate(sekarang, tz, 'yyyyMMdd') + '-' + nomorUrut;

    sh.appendRow([orderId, sekarang, nama, hp, alamat, ringkasanProduk.join(', '), totalPesanan, 'Menunggu Pembayaran', catatan]);
    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();

    result.success = true;
    result.orderId = orderId;
    result.total = totalPesanan;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem lagi sibuk, coba lagi sebentar.',
    validasi: function () {
      nama = String(data.nama || '').trim();
      hp = String(data.hp || '').trim();
      alamat = String(data.alamat || '').trim();
      catatan = String(data.catatan || '').trim();
      items = data.items || [];
      if (!nama || !hp || !alamat) throw new Error('Nama, No HP, dan Alamat wajib diisi.');
      if (!items.length) throw new Error('Keranjang belanja kosong.');
    }
  });
}

/* v2026.10.22 (Paket 9): susun baris sheet "Pesanan Conner" + ledger + rincian SKU dari 1 objek order API.
   Dipakai sinkron biasa DAN pencarian langsung ke API Conner (cnCariPesananRentang_) -> hasilnya identik. */
function cnRencanaDariOrder_(o) {
  var idO = String(o.id);
  var ringkasProduk = (o.line_items || []).map(function (li) { return li.product_name + (li.sku_name ? ' (' + li.sku_name + ')' : ''); }).join('; ');
  var totalOrder = o.payment ? parseFloat(o.payment.total_amount) || 0 : 0;
  var addr = o.recipient_address || {};
  // Auto-potong stock (SAMA seperti Waterground - stock fisik dianggap SATU KESATUAN Master Produk)
  var ledger = [], detail = [];
  (o.line_items || []).forEach(function (li) {
    var sellerSkuAsli = String(li.seller_sku || '').trim();
    if (!sellerSkuAsli) return;
    var qtyTerjual = parseFloat(li.qty || 1) || 1;
    // sama kayak Waterground - pakai SKU Jual internal, SKU bundling dipecah per SKU Gudang induk
    pecahSkuPesananBundling_(sellerSkuAsli, qtyTerjual).forEach(function (b) {
      ledger.push([new Date(o.create_time * 1000), b.sku, 'Terjual Online', b.qty, 'Auto: terjual Conner Order ' + o.id + (b.bundling ? ' (bundling ' + sellerSkuAsli + ')' : ''), 'Sistem (Auto Conner)']);
      detail.push([o.id, b.sku, b.qty]);
    });
  });
  var resiO = o.tracking_number || '';
  if (!resiO) (o.line_items || []).some(function (li) { if (String(li.tracking_number || '').trim()) { resiO = String(li.tracking_number).trim(); return true; } return false; });
  var baris = [idO, new Date(o.create_time * 1000), ringkasProduk, totalOrder, o.status || '-', o.shipping_provider || '-', resiO || '-', addr.name || '-', addr.phone_number || '-', addr.full_address || '-'];
  baris[6] = resiTeks_(baris[6], baris[5]) || '-';
  return { id: idO, baris: baris, ledger: ledger, detail: detail };
}
// Tulis rencana pesanan baru (dedup ULANG terhadap isi sheet terbaru di dalam kunci) -> jumlah baris baru
function cnTulisRencanaBaru_(sh, rencanaBaru) {
  var jumlahBaru = 0;
  if (!rencanaBaru.length) return 0;
  denganKunciTulis_(function () {
    var lr = sh.getLastRow();
    var adaSekarang = {};
    if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r) { adaSekarang[ovxIdTeks_(r[0])] = true; });
    var dobel = {};
    var tulisBaru = rencanaBaru.filter(function (r) { if (adaSekarang[r.id] || dobel[r.id]) return false; dobel[r.id] = true; return true; });
    if (!tulisBaru.length) return;
    var barisBaru = tulisBaru.map(function (r) { return r.baris; });
    var ledgerSemua = [], detailSemua = [];
    tulisBaru.forEach(function (r) { ledgerSemua = ledgerSemua.concat(r.ledger); detailSemua = detailSemua.concat(r.detail); });
    var awal = sh.getLastRow() + 1;
    sh.getRange(awal, 1, barisBaru.length, 1).setNumberFormat('@'); // Order ID 18 digit = teks (anti presisi hilang)
    sh.getRange(awal, 7, barisBaru.length, 1).setNumberFormat('@'); // No Resi = teks
    sh.getRange(awal, 1, barisBaru.length, 10).setValues(barisBaru);
    try { tambahBarisBatch_(getStockLedgerSheet('Conner'), ledgerSemua); } catch (eDeduct) { }
    try { tambahBarisBatch_(getPesananMarketplaceDetailSheet('Pesanan Conner Detail'), detailSemua); } catch (eDetail) { }
    jumlahBaru = barisBaru.length;
    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();
  }, 20000, ['penjualan', 'stok']);
  if (jumlahBaru) { try { smInvalidasiCache(); } catch (eS) { } try { invalidasiPetaResiRingkas_(); } catch (eP) { } }
  return jumlahBaru;
}

var CN_SYNC_MAKS_HALAMAN_ = 10;      // v2026.10.22: sinkron berhalaman (dulu hanya 1 halaman = maks 100 pesanan)
var CN_SYNC_TUMPANG_DETIK_ = 600;
var CN_SYNC_JEDA_MS_ = 300000;      // tarik pesanan Conner otomatis paling sering tiap 5 menit (di lengkapiResiTerjadwal)    // tumpang-tindih 10 menit dengan sinkron sebelumnya (dedup mencegah dobel)
function prosesSyncPesananConner(data) {
  var result = { success: false };
  if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; }
  // OPTIMASI: mutex khusus sync Conner - ScriptLock tidak lagi dipegang selama UrlFetch
  var mutex = kunciSinkronAmbil_('ORDER_CONNER');
  if (!mutex) { result.success = true; result.sedangJalan = true; result.jumlahBaru = 0; result.pesan = 'Sinkron Conner sedang berjalan di proses lain - dilewati.'; return result; }
  try {
    var props = PropertiesService.getScriptProperties();
    var appKey = connerAppKey_();
    var appSecret = connerAppSecret_();
    var accessToken = props.getProperty('CONNER_ACCESS_TOKEN');
    var shopCipher = props.getProperty('CONNER_SHOP_CIPHER');
    if (!appKey || !appSecret || !accessToken || !shopCipher) throw new Error('Conner Hardware belum terhubung penuh (App Key/Secret/Token/Shop Cipher).');

    var path = '/order/202309/orders/search';
    var mulaiDetik = Math.floor(Date.now() / 1000);
    var waktuSyncTerakhir = props.getProperty('CONNER_WAKTU_SYNC_TERAKHIR');
    // Belum pernah sinkron -> mulai 30 hari terakhir (bukan seluruh riwayat toko)
    var filterCreateTimeGe = waktuSyncTerakhir ? Math.max(0, parseInt(waktuSyncTerakhir, 10) - CN_SYNC_TUMPANG_DETIK_) : mulaiDetik - 30 * 86400;

    var bodyObjek = {};
    if (filterCreateTimeGe) bodyObjek.create_time_ge = filterCreateTimeGe;
    // ===== FASE 1 (TANPA LOCK): tarik dari API, berhalaman, urut dari pesanan TERLAMA =====
    // v2026.10.22 FIX: dulu hanya halaman pertama (100 pesanan) lalu waktu sinkron langsung dimajukan ke "sekarang"
    // -> pesanan sesudah 100 pertama tidak pernah masuk sheet (resi J&T Conner "Belum terhubung" selamanya).
    var orders = [], pageToken = '', halaman = 0, tuntas = false, createTerakhir = 0;
    while (halaman < CN_SYNC_MAKS_HALAMAN_) {
      var q = { page_size: 100, sort_field: 'create_time', sort_order: 'ASC' };
      if (pageToken) q.page_token = pageToken;
      var d = cnApi_('post', path, q, bodyObjek, { target: 'sinkron pesanan' });
      var isi = d.orders || [];
      isi.forEach(function (o) { orders.push(o); if (Number(o.create_time) > createTerakhir) createTerakhir = Number(o.create_time); });
      halaman++;
      pageToken = String(d.next_page_token || '');
      if (!pageToken || !isi.length) { tuntas = true; break; }
    }

    // ===== FASE 2 (TANPA LOCK): susun rencana tulis =====
    var sh = getPesananConnerSheet();
    var rencanaBaru = [], sudahDiRencana = {};
    var lastRow = sh.getLastRow();
    if (lastRow > 1) sh.getRange(2, 1, lastRow - 1, 1).getValues().forEach(function (row) { sudahDiRencana[ovxIdTeks_(row[0])] = true; }); // dedup awal (baca saja)
    orders.forEach(function (o) {
      var idO = String(o.id);
      if (sudahDiRencana[idO]) return;
      sudahDiRencana[idO] = true;
      rencanaBaru.push(cnRencanaDariOrder_(o));
    });

    // ===== FASE 3 (LOCK SINGKAT): dedup terhadap sheet terbaru + tulis sekaligus =====
    var jumlahBaru = cnTulisRencanaBaru_(sh, rencanaBaru);

    // Belum tuntas (lebih dari CN_SYNC_MAKS_HALAMAN_ halaman) -> lanjut dari pesanan terakhir yang sudah terbaca
    var waktuBaru = tuntas ? mulaiDetik : (createTerakhir || mulaiDetik);
    props.setProperty('CONNER_WAKTU_SYNC_TERAKHIR', String(waktuBaru));
    result.success = true;
    result.jumlahBaru = jumlahBaru;
    result.jumlahTotal = orders.length;
    result.halaman = halaman;
    result.tuntas = tuntas;
  } catch (err) { result.error = err.toString(); }
  finally { kunciSinkronLepas_('ORDER_CONNER', mutex); }
  return result;
}

/* v2026.10.22 (Paket 9) - CARI PESANAN CONNER LANGSUNG KE API (DN-261015-182410-162)
   Resi J&T (JY...) Conner tidak terhubung karena pesanannya belum pernah masuk sheet "Pesanan Conner" (sinkron otomatis
   Conner tidak aktif + dulu hanya 1 halaman). Fungsi ini menarik SEMUA pesanan Conner N hari terakhir (orders/search,
   berhalaman, terbaru dulu), lalu:
   - pesanan yang belum ada di sheet & statusnya sudah dibayar/dikirim -> ditambahkan (baris + ledger + rincian SKU,
     SAMA dengan sinkron biasa, dedup di dalam kunci -> tidak dobel);
   - pesanan yang sudah ada tetapi resinya masih kosong / statusnya berubah -> kolom Status & No Resi diperbarui;
   - SEMUA resi paket dikembalikan untuk dicocokkan dengan resi scan. */
var CN_CARI_STATUS_TAMBAH_ = { AWAITING_SHIPMENT: 1, AWAITING_COLLECTION: 1, PARTIALLY_SHIPPING: 1, IN_TRANSIT: 1, DELIVERED: 1, COMPLETED: 1 };
function cnCariPesananRentang_(opsi) {
  opsi = opsi || {};
  var hari = Math.min(Math.max(parseInt(opsi.hari, 10) || 30, 1), 60);
  var maksHal = opsi.maksHalaman || 6, t0 = Date.now(), batasMs = opsi.batasMs || 90000;
  var hasil = { dicek: 0, ditambah: 0, diperbarui: 0, paket: [], halaman: 0, tuntas: false, error: '' };
  var cfg = ovxCfgTiktok_('Conner');
  if (!cfg.token || !cfg.cipher || !cfg.appKey) { hasil.error = 'belum terhubung'; return hasil; }
  var body = { create_time_ge: Math.floor(Date.now() / 1000) - hari * 86400 };
  var orders = [], pageToken = '';
  try {
    while (hasil.halaman < maksHal && Date.now() - t0 < batasMs) {
      var q = { page_size: 100, sort_field: 'create_time', sort_order: 'DESC' };
      if (pageToken) q.page_token = pageToken;
      var d = cnApi_('post', '/order/202309/orders/search', q, body, { target: 'cari pesanan (resi belum terhubung)' });
      var isi = d.orders || [];
      orders = orders.concat(isi);
      hasil.halaman++;
      pageToken = String(d.next_page_token || '');
      if (!pageToken || !isi.length) { hasil.tuntas = true; break; }
    }
  } catch (e) { hasil.error = String(e.message || e); if (!orders.length) return hasil; }
  hasil.dicek = orders.length;
  var sh = getPesananConnerSheet(), lr = sh.getLastRow(), adaDiSheet = {};
  if (lr > 1) sh.getRange(2, 1, lr - 1, 7).getValues().forEach(function (r, i) {
    var id = ovxIdTeks_(r[0]); if (id && !adaDiSheet[id]) adaDiSheet[id] = { row: i + 2, status: String(r[4] || '').trim(), resi: resiTeks_(r[6], r[5]) };
  });
  var rencana = [], ubahStatus = {}, ubahResi = {};
  orders.forEach(function (o) {
    var id = String(o.id || ''); if (!id) return;
    var st = String(o.status || '').toUpperCase();
    var semuaResi = [o.tracking_number].concat((o.line_items || []).map(function (li) { return li.tracking_number; }))
      .concat((o.packages || []).map(function (pk) { return pk.tracking_number; }));
    var unik = {};
    semuaResi.forEach(function (t) { t = String(t || '').trim(); if (t && !unik[t]) { unik[t] = 1; hasil.paket.push({ t: t, sumber: 'Conner Hardware', no: id }); } });
    var x = adaDiSheet[id];
    if (!x) { if (cnStatusBolehTambah_(st)) rencana.push(cnRencanaDariOrder_(o)); return; }
    if (st && st !== String(x.status).toUpperCase()) ubahStatus[x.row] = st;
    var resiApi = Object.keys(unik)[0] || '';
    if (resiApi && (!x.resi || x.resi === '-')) ubahResi[x.row] = resiTeks_(resiApi, o.shipping_provider);
  });
  try { hasil.ditambah = cnTulisRencanaBaru_(sh, rencana); } catch (eT) { hasil.error = (hasil.error ? hasil.error + ' · ' : '') + 'tulis: ' + (eT.message || eT); }
  if (Object.keys(ubahStatus).length || Object.keys(ubahResi).length) {
    try {
      denganKunciTulis_(function () {
        if (Object.keys(ubahStatus).length) tulisSelPerBlok_(sh, 5, ubahStatus, false);
        if (Object.keys(ubahResi).length) tulisSelPerBlok_(sh, 7, ubahResi, true);
        SpreadsheetApp.flush();
      }, 20000, 'penjualan');
      hasil.diperbarui = Object.keys(ubahStatus).length + Object.keys(ubahResi).length;
      invalidasiCacheGabunganPesanan();
      try { invalidasiPetaResiRingkas_(); } catch (eP) { }
      try { smInvalidasiCache(); } catch (eS) { }
    } catch (eU) { hasil.error = (hasil.error ? hasil.error + ' · ' : '') + 'perbarui: ' + (eU.message || eU); }
  }
  return hasil;
}
function cnStatusBolehTambah_(st) { return !!CN_CARI_STATUS_TAMBAH_[String(st || '').toUpperCase()]; }

function prosesSyncPesananConnerOtomatis() {
  if (urlFetchSedangDiblokir()) { Logger.log('⏸ Sync Conner dilewati - kuota UrlFetch lagi habis (rem darurat aktif).'); return; }
  pastikanTokenConnerMasihValid();
  var hasil = prosesSyncPesananConner({ dariSistem: true });
  Logger.log('Sync otomatis Pesanan Conner: ' + JSON.stringify(hasil));
  // Lengkapi resi kosong (TikTok, Conner, Shopee) - maksimal 1x per 10 menit, pesanan terbaru dulu
  try { Logger.log('Lengkapi resi: ' + JSON.stringify(lengkapiResiKosongSemua_())); } catch (eR) { Logger.log('Lengkapi resi gagal: ' + eR); }
}

// JALANKAN SEKALI SAJA buat mengaktifkan sync otomatis Conner tiap 5 menit (sama kayak Waterground)
function aktifkanSyncOtomatisConner() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'prosesSyncPesananConnerOtomatis') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('prosesSyncPesananConnerOtomatis').timeBased().everyMinutes(5).create();
