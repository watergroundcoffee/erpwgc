// Sync daftar produk dari TikTok Shop, cocokkan seller_sku sama SKU kita (Master Produk)
function prosesSyncProdukTikTokShop(data) {
  return withTransaction(data.email, null, 'katalog', function () {
    var result = { success: false };
    if (!data.dariSistem && !cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var props = PropertiesService.getScriptProperties();
    var accessToken = props.getProperty('TIKTOK_ACCESS_TOKEN');
    var shopCipher = props.getProperty('TIKTOK_SHOP_CIPHER');
    if (!accessToken || !shopCipher) throw new Error('TikTok Shop belum terhubung.');

    var path = '/product/202309/products/search';
    var bodyString = JSON.stringify({});
    var paramsUntukSign = {
      app_key: getTiktokAppKey(), timestamp: String(Math.floor(Date.now() / 1000)),
      shop_cipher: shopCipher, version: '202309', page_size: '100'
    };
    var signature = buatSignatureTikTok(path, paramsUntukSign, bodyString);
    var url = 'https://open-api.tiktokglobalshop.com' + path +
      '?app_key=' + encodeURIComponent(getTiktokAppKey()) + '&shop_cipher=' + encodeURIComponent(shopCipher) +
      '&timestamp=' + paramsUntukSign.timestamp + '&version=' + paramsUntukSign.version +
      '&page_size=' + paramsUntukSign.page_size + '&sign=' + signature;

    var res = fetchHemat(url, {
      method: 'post', contentType: 'application/json', payload: bodyString,
      headers: { 'x-tts-access-token': accessToken }, muteHttpExceptions: true
    });
    if (res.getResponseCode() !== 200) throw new Error('Gagal ambil daftar produk: ' + res.getContentText());

    var parsed = JSON.parse(res.getContentText());
    var produk = (parsed.data && parsed.data.products) || [];

    var sh = getProdukTikTokShopSheet();
    var lastRow = sh.getLastRow();
    if (lastRow > 1) sh.getRange(2, 1, lastRow - 1, 7).clearContent(); // refresh total tiap sync (data produk nggak sebanyak pesanan)

    var tz = Session.getScriptTimeZone();
    var baris = [];
    var jumlahCocok = 0;
    produk.forEach(function (p) {
      (p.skus || []).forEach(function (sku) {
        var sellerSku = String(sku.seller_sku || '').trim();
        if (sellerSku) jumlahCocok++;
        var hargaTiktok = (sku.price && (sku.price.sale_price || sku.price.original_price)) || 0;
        baris.push([
          sellerSku, p.id, sku.id, p.title || '-',
          (sku.inventory && sku.inventory[0]) ? sku.inventory[0].quantity : 0,
          Utilities.formatDate(new Date(), tz, 'dd MMM yyyy HH:mm'),
          hargaTiktok
        ]);
      });
    });
    if (baris.length > 0) {
      sh.getRange(2, 1, baris.length, 3).setNumberFormat('@'); // SKU + Product ID + SKU ID = TEKS (ID 19 digit tidak boleh dibulatkan Sheets)
      baris.forEach(function (b) { b[1] = String(b[1]); b[2] = String(b[2]); });
      sh.getRange(2, 1, baris.length, 7).setValues(baris);
    }

    result.success = true;
    result.jumlahProduk = produk.length;
    result.jumlahSkuCocok = jumlahCocok;
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

