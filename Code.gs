    }
  } catch (eM) { Logger.log('finTerapkanHpp_ master: ' + eM); }
  // Sheet pemetaan: SKU Marketplace Terhubung, SKU Supplier Terhubung, Arsip Merge Produk
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    [['SKU Marketplace Terhubung', 0, 1], ['SKU Supplier Terhubung', 0, 1], [KAT_SHEET_ARSIP_MERGE, 2, 1]].forEach(function (cfg) {
      var sh = ss.getSheetByName(cfg[0]); if (!sh || sh.getLastRow() < 2) return;
      sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues().forEach(function (r) {
        var induk = nrm(r[cfg[1]]); if (!induk) return;
        String(r[cfg[2]] == null ? '' : r[cfg[2]]).split(/[\s,;]+/).forEach(function (kode) { tambahAlias(kode, induk); });
      });
    });
  } catch (eA) { Logger.log('finTerapkanHpp_ pemetaan: ' + eA); }
  Object.keys(aliasFin).sort().forEach(function (k) { sig.push(k + '>' + aliasFin[k].join(',')); });
  var tanda = Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, sig.join('|'))).slice(0, 16);
  if (!paksa && D.hppSig === tanda && D.unit) return D;

  var rata = D.unitRata || {}, sumberRata = D.sumberRata || {};
  var unit = {}, sumberPakai = {}, petaHasil = {};
  function hargaMaster(k) {
    if (!k) return 0;
    if (master[k] > 0) return master[k];
    return masterBesar[String(k).toUpperCase()] || 0;
  }
  // Kumpulkan kandidat SKU berurutan: SKU jual (induk resmi) -> kode asli -> induk dari pemetaan (maks 4 lompatan)
  function rantaiKandidat(asli) {
    var hasil = [], sudah = {};
    function masuk(k) { k = nrm(k); if (!k || sudah[k.toUpperCase()]) return; sudah[k.toUpperCase()] = true; hasil.push(k); }
    var induk = asli;
    try { induk = resolveSkuJualCepat_(asli) || asli; } catch (eR) { }
    masuk(induk); masuk(asli);
    for (var i = 0; i < hasil.length && hasil.length < 25; i++) {
      (aliasFin[hasil[i].toUpperCase()] || []).forEach(function (x) {
        masuk(x);
        try { masuk(resolveSkuJualCepat_(x)); } catch (eR2) { }
      });
    }
    return hasil;
  }
  function hargaModal(skuJual) {
    if (petaHasil[skuJual] !== undefined) return petaHasil[skuJual];
    var asli = nrm(skuJual);
    var calon = rantaiKandidat(asli);
    var u = 0, sumber = '', kunci = calon[0] || asli;
    // 1) Harga Modal Master Produk - utamakan SKU yang AKTIF (bukan arsip)
    for (var lap = 0; lap < 2 && !(u > 0); lap++) {
      for (var i = 0; i < calon.length && !(u > 0); i++) {
        var aktif = !arsipBesar[calon[i].toUpperCase()];
        if (lap === 0 && !aktif) continue;
        var h = hargaMaster(calon[i]);
