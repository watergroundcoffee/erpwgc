      { nama: 'Buku Besar', header: ['Tanggal', 'No. Bukti', 'Keterangan', 'Debet', 'Kredit', 'Saldo'], rows: rB.length ? rB : [['', '', 'Tidak ada transaksi', '', '', '']], formatAngka: [4, 5, 6] }
    ]);
