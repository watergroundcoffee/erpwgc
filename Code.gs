      out.langkah.push(Cp !== C ? 'Harga dasar listing TikTok dikirim ' + rp(C) + ' → ' + rp(Cp) + ' (Sync Harga).' : 'Harga dasar listing TikTok tetap ' + rp(C) + '.');
