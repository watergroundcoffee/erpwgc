var SPB_ANTRE_SHEET_ = 'Antrean OCR Pembeli Shopee';
var SPB_ANTRE_HEADER_ = ['No Pesanan', 'Gambar (JSON)', 'Masuk', 'Percobaan', 'Status', 'Dipinjam Sampai (ms)', 'Catatan', 'Selesai'];
var SPB_ANTRE_MAKS_COBA_ = 3;
var SPB_ANTRE_PINJAM_MS_ = 5 * 60 * 1000;
function getSpbAntreSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SPB_ANTRE_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(SPB_ANTRE_SHEET_);
    sh.getRange(1, 1, 1, SPB_ANTRE_HEADER_.length).setValues([SPB_ANTRE_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1); sh.getRange('A:A').setNumberFormat('@');
  }
  return sh;
}
function spbAntreBaca_(sh) {
  var lr = sh.getLastRow(), peta = {}, baris = [];
  if (lr < 2) return { peta: peta, baris: baris };
  baris = sh.getRange(2, 1, lr - 1, SPB_ANTRE_HEADER_.length).getValues();
  baris.forEach(function (r, i) { var k = String(r[0] || '').trim(); if (k) peta[k] = i + 2; });
  return { peta: peta, baris: baris };
}
// daftar = [{ sn, gambar:{nama:'data:image/png;base64,...', ...} }]
function spbAntreTambah_(daftar) {
  daftar = (daftar || []).filter(function (d) { return d && d.sn && d.gambar && Object.keys(d.gambar).length; });
  if (!daftar.length) return 0;
  var lock = kunciModul_('penjualan');
  if (!lock.tryLock(15000)) return 0;
  var n = 0;
  try {
    var sh = getSpbAntreSheet_(), a = spbAntreBaca_(sh), baru = [], kini = new Date();
    daftar.forEach(function (d) {
      var sn = String(d.sn), json = JSON.stringify(d.gambar);
      if (json.length > 45000) return; // pengaman ukuran sel
      var row = a.peta[sn];
      if (row) {
        var r = a.baris[row - 2];
        if (String(r[4]) === 'Selesai') return;
        if (String(r[4]) === 'Gagal' && String(r[1] || '') === json) return;
        sh.getRange(row, 2, 1, 6).setValues([[json, kini, String(r[4]) === 'Gagal' ? 0 : (Number(r[3]) || 0), 'Menunggu', 0, String(r[6] || '')]]);
        n++;
      } else { baru.push([sn, json, kini, 0, 'Menunggu', 0, '', '']); a.peta[sn] = -1; }
    });
    if (baru.length) {
      var awal = sh.getLastRow() + 1;
      sh.getRange(awal, 1, baru.length, 1).setNumberFormat('@');
      sh.getRange(awal, 1, baru.length, SPB_ANTRE_HEADER_.length).setValues(baru);
      n += baru.length;
    }
    SpreadsheetApp.flush();
  } finally { lepasKunci_(lock); }
  return n;
}
function prosesSpbOcrAntrean(data) {
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var maks = Math.max(1, Math.min(15, parseInt(data.maks, 10) || 8));
    var lock = kunciModul_('penjualan');
    if (!lock.tryLock(15000)) return { success: true, daftar: [], sibuk: true };
    try {
      var sh = getSpbAntreSheet_(), a = spbAntreBaca_(sh), kini = Date.now(), pilih = [], sisa = 0;
      for (var i = a.baris.length - 1; i >= 0; i--) {
        var r = a.baris[i];
        if (String(r[4]) !== 'Menunggu' || (Number(r[3]) || 0) >= SPB_ANTRE_MAKS_COBA_) continue;
        if ((Number(r[5]) || 0) > kini) continue;
        if (pilih.length >= maks) { sisa++; continue; }
        var g = {}; try { g = JSON.parse(r[1] || '{}'); } catch (e) { g = {}; }
        if (!Object.keys(g).length) continue;
        pilih.push({ sn: String(r[0]), gambar: g, baris: i + 2 });
      }
      pilih.forEach(function (p) { sh.getRange(p.baris, 6).setValue(kini + SPB_ANTRE_PINJAM_MS_); });
      if (pilih.length) SpreadsheetApp.flush();
      return { success: true, daftar: pilih.map(function (p) { return { sn: p.sn, gambar: p.gambar }; }), sisa: sisa };
    } finally { lepasKunci_(lock); }
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}
// Kolom Manual Pesanan Shopee (11 Nama, 12 HP, 13 Alamat) yang masih kosong diisi
function spbTulisKePesanan_(hasil) {
  var sn = Object.keys(hasil || {});
  if (!sn.length) return 0;
  var sh = getPesananShopeeSheet(), lr = sh.getLastRow();
  if (lr < 2) return 0;
  var peta = {}, terisi = 0;
  sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (x, i) { var k = String(x[0] || '').trim(); if (k && !peta[k]) peta[k] = i + 2; });
  sn.forEach(function (k) {
    var h = hasil[k], row = peta[k];
    if (!row) return;
    var rg = sh.getRange(row, 11, 1, 3), blok = rg.getValues()[0], ubah = false;
    if (!String(blok[0]).trim() && h.nama) { blok[0] = h.nama; ubah = true; }
    if (!String(blok[1]).trim() && h.hp) { blok[1] = h.hp; ubah = true; }
    if (!String(blok[2]).trim() && h.alamat) { blok[2] = h.alamat; ubah = true; }
    if (ubah) { rg.setNumberFormat('@'); rg.setValues([blok]); terisi++; }
  });
  if (terisi) { try { invalidasiCacheGabunganPesanan(); } catch (e) { } }
  return terisi;
}
function prosesSpbOcrSimpan(data) {
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var daftar = (Array.isArray(data.hasil) ? data.hasil : []).slice(0, 30);
    var oke = {}, gagal = {}, labelOcrGagal = [];
    daftar.forEach(function (x) {
      var sn = String(x && x.sn || '').trim();
      if (!sn) return;
      var d = x.gagal ? {} : spbOcrBersihkan_(x.data || {}, SPB_OCR_FIELD_);
      if (d.nama || d.hp || d.alamat) {
        var h = { status: '', sumber: {} };
        Object.keys(d).forEach(function (f) { h[f] = d[f]; });
        spbLengkapiAlamat_(h);
        ['nama', 'hp', 'alamat'].forEach(function (f) { if (h[f]) h.sumber[f] = 'dokumen kirim (OCR browser)'; });
        oke[sn] = h;
