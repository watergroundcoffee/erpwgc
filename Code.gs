}

/* ---------- Pencarian ID listing Shopee (item_id + model_id) - RINGAN, tanpa indeks massal ----------
   Hanya SKU yang benar-benar ada & aktif di toko yang di-update:
     1) Sheet lokal "ID Produk Shopee" (0 panggilan API; boleh diisi manual: SKU | Item ID | Model ID)
     2) search_item?item_sku=... (maks 2 panggilan) -> kalau induknya bervarian, model_sku dicocokkan
   Tidak ketemu -> listing DILEWATI (bukan error), tanpa menyisir seluruh katalog toko.
   paksaSegar = true -> lewati sheet lokal (dipakai saat ID lokal ternyata sudah tidak berlaku). */
var SHOPEE_ID_MEMO_ = null;
var SHOPEE_ID_HEADER_ = ['SKU Shopee (item_sku / model_sku)', 'Item ID', 'Model ID', 'Nama Produk Shopee', 'Update Terakhir', 'Sumber'];
function getIdProdukShopeeSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('ID Produk Shopee');
  if (!sh) {
    sh = ss.insertSheet('ID Produk Shopee');
    sh.getRange(1, 1, 1, SHOPEE_ID_HEADER_.length).setValues([SHOPEE_ID_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1);
  } else if (sh.getLastColumn() < 6) {
    // Kolom F "Sumber": API / INDEKS / MANUAL (isi MANUAL untuk baris ketik tangan supaya tidak pernah dibuang otomatis)
    sh.getRange(1, 6).setValue('Sumber').setFontWeight('bold');
  }
  return sh;
}
// SKU -> DAFTAR listing { item_id, model_id, nama, sumberBaris }. 1 SKU boleh >1 listing (duplikat) -> semua di-update.
function syncPetaIdShopeeLokal_() {
  if (SHOPEE_ID_MEMO_) return SHOPEE_ID_MEMO_;
  var peta = {};
  try {
    var sh = getIdProdukShopeeSheet_(), lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 1, lr - 1, 6).getDisplayValues().forEach(function (r) {
      var k = String(r[0] || '').trim();
      if (!k || !syncIdValid_(r[1])) return;
      var it = { item_id: Number(r[1]), model_id: syncIdValid_(r[2]) ? Number(r[2]) : 0, nama: r[3] || '', sumberBaris: String(r[5] || '').trim().toUpperCase() };
      var d = peta[k] = peta[k] || [];
      if (!d.some(function (x) { return x.item_id === it.item_id && x.model_id === it.model_id; })) d.push(it);
    });
  } catch (e) { }
  SHOPEE_ID_MEMO_ = peta;
  return peta;
}
function syncPanggilShopee_(kred, path, query) {
  var ts = Math.floor(Date.now() / 1000);
  var url = getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts +
    '&sign=' + buatSignatureShopee(path, ts, kred.accessToken, kred.shopId) + '&access_token=' + kred.accessToken + '&shop_id=' + kred.shopId + (query || '');
  var res = UrlFetchApp.fetch(url, { method: 'get', muteHttpExceptions: true });
  var json = {};
  try { json = JSON.parse(res.getContentText() || '{}'); } catch (e) { }
  if (res.getResponseCode() !== 200 || json.error) {
    apiErrCatat_('Shopee', path, '', query || '', res.getResponseCode(), json, res.getContentText());
    throw new Error('Shopee ' + path + ': ' + (json.error ? json.error + ' - ' : '') + (json.message || ('HTTP ' + res.getResponseCode())) + (json.request_id ? ' [request_id ' + json.request_id + ']' : ''));
  }
  return json.response || {};
}
// Tulis ulang seluruh isi sheet "ID Produk Shopee" lewat fnUbah(rows) -> rows baru (6 kolom). Di dalam lock.
function syncTulisUlangIdShopee_(fnUbah) {
  katDenganLock_(function () {
    var sh = getIdProdukShopeeSheet_(), lr = sh.getLastRow();
    var rows = lr > 1 ? sh.getRange(2, 1, lr - 1, 6).getDisplayValues() : [];
    var baru = fnUbah(rows) || [];
    if (lr > 1) sh.getRange(2, 1, lr - 1, 6).clearContent();
    if (baru.length) sh.getRange(2, 1, baru.length, 6).setNumberFormat('@').setValues(baru);
  }, 30000);
  SHOPEE_ID_MEMO_ = null;
}
// baris = [{ sku, item_id, model_id, nama, sumber }]. opsi.gantiSku: ID lama SKU tsb (selain MANUAL) yang tidak ada di hasil baru dibuang.
function syncSimpanIdShopee_(baris, opsi) {
  if (!baris.length) return;
  opsi = opsi || {};
  var kunci = function (s, i, m) { return String(s).trim() + '|' + String(i).trim() + '|' + String(Number(m) || 0); };
  try {
    syncTulisUlangIdShopee_(function (rows) {
      var waktu = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm'), baru = {}, ganti = {};
      baris.forEach(function (b) { baru[kunci(b.sku, b.item_id, b.model_id)] = b; if (opsi.gantiSku) ganti[String(b.sku).trim()] = true; });
      var hasil = [];
      rows.forEach(function (r) {
        var s = String(r[0] || '').trim(); if (!s) return;
        if (baru[kunci(s, r[1], r[2])]) return;                                              // diganti data terbaru
        if (ganti[s] && String(r[5] || '').trim().toUpperCase() !== 'MANUAL') return;        // ID lama SKU ini sudah tidak berlaku
        hasil.push([r[0], r[1], r[2], r[3], r[4], r[5] || '']);
      });
      Object.keys(baru).forEach(function (k) { var b = baru[k]; hasil.push([String(b.sku).trim(), String(b.item_id), String(b.model_id || 0), b.nama || '', waktu, b.sumber || 'API']); });
      return hasil;
    });
  } catch (e) { Logger.log('Gagal simpan ID Shopee lokal: ' + e); }
}
/* Cari SEMUA listing Shopee (item_id + model_id) untuk 1 SKU marketplace:
     1) sheet lokal "ID Produk Shopee" (0 panggilan API; termasuk hasil Indeks SKU Shopee)
     2) search_item?item_sku= (SKU INDUK) -> diverifikasi PERSIS lewat get_item_base_info / get_model_list
     3) belum ketemu -> Indeks SKU Shopee (semua listing NORMAL + SKU varian/model_sku), maks 1x per eksekusi
   Dulu langkah 3 tidak ada -> SKU VARIAN (mis. 7RHXP2BR) selalu "tidak ditemukan", padahal listingnya ada. */
function syncResolveIdShopeeSemua_(itemSku, paksaSegar) {
  var kred = ambilKredensialShopee();
  if (!kred.accessToken || !kred.shopId) throw new Error('Token Shopee belum tersedia / kedaluwarsa - hubungkan ulang Shopee di Pengaturan.');
  if (!paksaSegar) {
    var lokal = syncPetaIdShopeeLokal_()[itemSku];
    if (lokal && lokal.length) return lokal.map(function (x) { return { item_id: x.item_id, model_id: x.model_id, sumber: 'lokal' }; });
  }
  var hasil = [];
  var ids = (syncPanggilShopee_(kred, '/api/v2/product/search_item', '&offset=0&page_size=10&item_sku=' + encodeURIComponent(itemSku)).item_id_list || []).slice(0, 10);
  if (ids.length) {
    var info = syncPanggilShopee_(kred, '/api/v2/product/get_item_base_info', '&item_id_list=' + ids.join(','));
    (info.item_list || []).forEach(function (it) {
      if (!it.has_model) { if (String(it.item_sku || '').trim() === itemSku) hasil.push({ item_id: it.item_id, model_id: 0 }); return; }
      var model = syncPanggilShopee_(kred, '/api/v2/product/get_model_list', '&item_id=' + it.item_id);
      (model.model || []).forEach(function (m) { if (String(m.model_sku || '').trim() === itemSku) hasil.push({ item_id: it.item_id, model_id: m.model_id }); });
    });
  }
  if (hasil.length) {
    syncSimpanIdShopee_(hasil.map(function (h) { return { sku: itemSku, item_id: h.item_id, model_id: h.model_id, nama: '', sumber: 'API' }; }), { gantiSku: true });
    return hasil.map(function (h) { return { item_id: h.item_id, model_id: h.model_id, sumber: 'api' }; });
  }
  var idx = shopeeIndeksCariSku_(itemSku, kred, paksaSegar);
  if (idx.cocok.length) return idx.cocok.map(function (x) { return { item_id: x.item_id, model_id: x.model_id, sumber: 'indeks' }; });
  throw syncErrorDilewati_('SKU "' + itemSku + '" tidak ditemukan / tidak aktif di Shopee (dicek: sheet lokal, search_item, varian, Indeks SKU Shopee' +
    (idx.dibangun ? ' baru dibangun' : idx.umurMenit !== null ? ' umur ' + idx.umurMenit + ' menit' : ' belum pernah dibangun') + (idx.error ? ' - indeks gagal: ' + idx.error : '') + ') - dilewati. Jalankan CHECK_SKU_MAPPING untuk diagnosa.');
}
// Kompatibilitas pemanggil lama (bundle, dll.): listing PERTAMA + daftar lengkap di .semua
function syncResolveIdShopee_(itemSku, paksaSegar) {
  var semua = syncResolveIdShopeeSemua_(itemSku, paksaSegar);
  return Object.assign({ semua: semua }, semua[0]);
}

/* ---------- Penyusun request UPDATE HARGA (ID sudah pasti ada dari syncResolveId_) ---------- */
// Shopee: POST /api/v2/product/update_price - price_list[].original_price = HARGA CORET
// Semua listing (duplikat) untuk 1 SKU marketplace -> 1 request per listing
function syncSusunRequestShopeeSemua_(itemSku, hargaCoret, mode, paksaSegar) {
  if (mode !== 'LIVE') return [syncSusunRequestShopee_(itemSku, hargaCoret, mode, paksaSegar)];
  return syncResolveIdShopeeSemua_(itemSku, paksaSegar).map(function (t) { return syncSusunRequestShopee_(itemSku, hargaCoret, mode, paksaSegar, t); });
}
function syncSusunRequestShopee_(itemSku, hargaCoret, mode, paksaSegar, targetPasti) {
  var path = '/api/v2/product/update_price';
  var target = targetPasti || (mode === 'LIVE' ? syncResolveIdShopee_(itemSku, paksaSegar) : { item_id: '<dicari dari item_sku / model_sku "' + itemSku + '">', model_id: 0 });
  // model_id WAJIB ada: 0 untuk produk tanpa varian, model_id varian untuk produk bervarian
  var body = {
    item_id: Number(target.item_id) || target.item_id,
    price_list: [{ model_id: Number(target.model_id) || 0, original_price: Math.round(hargaCoret) }] // HARGA CORET - bukan harga jual final
  };
  var kred = mode === 'LIVE' ? ambilKredensialShopee() : { accessToken: '<ACCESS_TOKEN>', shopId: '<SHOP_ID>' };
  var timestamp = Math.floor(Date.now() / 1000);
  var sign = mode === 'LIVE' ? buatSignatureShopee(path, timestamp, kred.accessToken, kred.shopId) : '<SIGN>';
  return {
    platform: 'Shopee', item_sku: itemSku, idSumber: target.sumber,
    url: getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + timestamp + '&sign=' + sign + '&access_token=' + kred.accessToken + '&shop_id=' + kred.shopId,
    options: { method: 'post', contentType: 'application/json', payload: JSON.stringify(body), muteHttpExceptions: true },
    body: body
  };
}

// LIVE: cari item_id (+ model_id) dari item_sku / model_sku. Wajib ketemu TEPAT 1 - kalau tidak, dibatalkan.
function syncCariItemShopee_(itemSku) {
  var kred = ambilKredensialShopee();
  if (!kred.accessToken || !kred.shopId) throw new Error('Token Shopee belum tersedia - selesaikan otorisasi Shopee dulu.');
  var panggil = function (path, query) {
    var ts = Math.floor(Date.now() / 1000);
    var url = getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts +
      '&sign=' + buatSignatureShopee(path, ts, kred.accessToken, kred.shopId) + '&access_token=' + kred.accessToken + '&shop_id=' + kred.shopId + query;
    var res = UrlFetchApp.fetch(url, { method: 'get', muteHttpExceptions: true });
    var json = JSON.parse(res.getContentText() || '{}');
    if (res.getResponseCode() !== 200 || json.error) throw new Error('Shopee ' + path + ': ' + (json.message || json.error || res.getResponseCode()));
    return json.response || {};
  };
  var cari = panggil('/api/v2/product/search_item', '&offset=0&page_size=10&item_sku=' + encodeURIComponent(itemSku));
  var ids = cari.item_id_list || [];
  if (ids.length !== 1) throw new Error('Gagal Sync: item_sku Shopee "' + itemSku + '" ditemukan ' + ids.length + ' produk (harus tepat 1). Periksa SKU Terhubung.');
  var itemId = ids[0];
  var model = panggil('/api/v2/product/get_model_list', '&item_id=' + itemId);
  var daftarModel = model.model || [];
  if (!daftarModel.length) return { item_id: itemId, model_id: null };
  var cocok = daftarModel.filter(function (m) { return String(m.model_sku || '').trim() === itemSku; });
  if (cocok.length !== 1) throw new Error('Gagal Sync: produk Shopee "' + itemSku + '" bervarian tapi model_sku yang cocok ada ' + cocok.length + ' (harus tepat 1).');
  return { item_id: itemId, model_id: cocok[0].model_id };
}
// TikTok: POST /product/202309/products/{product_id}/prices/update - price.amount = HARGA CORET
function syncSusunRequestTiktok_(sellerSku, hargaCoret, mode, id) {
  var props = PropertiesService.getScriptProperties();
  var path = '/product/202309/products/' + id.productId + '/prices/update';
  var body = { skus: [{ id: String(id.skuId), price: { amount: String(Math.round(hargaCoret)), currency: 'IDR' } }] }; // HARGA CORET
  var bodyString = JSON.stringify(body);
  var q = { app_key: getTiktokAppKey(), shop_cipher: props.getProperty('TIKTOK_SHOP_CIPHER') || '<SHOP_CIPHER>', timestamp: String(Math.floor(Date.now() / 1000)), version: '202309' };
  var sign = '<SIGN>';
  if (mode === 'LIVE') sign = buatSignatureTikTok(path, q, bodyString);
  return {
    platform: 'TikTok Shop', seller_sku: sellerSku, product_id: id.productId, sku_id: id.skuId,
    url: 'https://open-api.tiktokglobalshop.com' + path + '?app_key=' + encodeURIComponent(q.app_key) + '&shop_cipher=' + encodeURIComponent(q.shop_cipher) +
      '&timestamp=' + q.timestamp + '&version=' + q.version + '&sign=' + sign,
    options: { method: 'post', contentType: 'application/json', headers: { 'x-tts-access-token': props.getProperty('TIKTOK_ACCESS_TOKEN') || '<ACCESS_TOKEN>' }, payload: bodyString, muteHttpExceptions: true },
    body: body
  };
}

// Eksekusi: DRY_RUN -> hanya log (tanpa jaringan). LIVE -> UrlFetchApp.fetch sungguhan.
function syncEksekusiRequest_(req, mode) {
  var aman = JSON.parse(JSON.stringify({ platform: req.platform, url: req.url, method: req.options.method, body: req.body }));
  aman.url = String(aman.url).replace(/(access_token=)[^&]+/, '$1***');
  if (mode !== 'LIVE') {
    Logger.log('[SYNC HARGA DRY-RUN] ' + JSON.stringify(aman));
    console.log('[SYNC HARGA DRY-RUN]', JSON.stringify(aman));
    return { dryRun: true, request: aman };
  }
  try {
    var res = UrlFetchApp.fetch(req.url, req.options);   // <- TEMBAKAN SUNGGUHAN (mode LIVE)
    var kode = res.getResponseCode();
    var isi = res.getContentText() || '';
    var json = {};
    try { json = JSON.parse(isi); } catch (eJson) { }
    var gagal, pesan;
    if (req.platform === 'Shopee') {
      gagal = kode !== 200 || !!json.error;
      // Pesan ASLI Shopee dipertahankan: "Shopee Reject: <error> - <message>" (mis. product.error_update_price_in_campaign)
      pesan = gagal ? 'Shopee Reject: ' + (json.error || ('HTTP ' + kode)) + (json.message ? ' - ' + json.message : '') : '';
      // Shopee membalas HTTP 200 walaupun harganya DITOLAK - alasannya ada di response.failure_list
      // (mis. produk sedang ikut promosi / harga di luar batas). Dulu ini dianggap "Terkirim".
      var daftarGagal = (json.response && json.response.failure_list) || [];
      if (!gagal && daftarGagal.length) {
        gagal = true;
        pesan = 'Shopee Reject: ' + daftarGagal.map(function (f) { return (f.model_id ? 'model ' + f.model_id + ': ' : '') + (f.failed_reason || f.reason || 'ditolak'); }).join('; ');
      }
    }
    else { gagal = kode !== 200 || (json.code !== undefined && json.code !== 0); pesan = gagal ? 'TikTok Reject: kode ' + json.code + (json.message ? ' - ' + json.message : '') : ''; }
    if (gagal) {
      apiErrCatat_(req.platform, req.platform === 'Shopee' ? 'v2.product.update_price' : 'product.202309.prices.update', req.item_sku || req.seller_sku || '', req.body, kode, json, isi);
      var eTolak = new Error(req.platform + ' menolak (HTTP ' + kode + '): ' + (pesan || isi.substring(0, 200)) + (json.request_id ? ' [request_id ' + json.request_id + ']' : ''));
      eTolak.promo = SYNC_REGEX_PROMO_.test(pesan + ' ' + isi);       // -> ditangani Task Scheduler (lepas promo / tunggu selesai)
      eTolak.apiError = { http: kode, error: json.error, code: json.code, message: json.message, request_id: json.request_id, failure_list: daftarGagal };
      throw eTolak;
    }
    return { dryRun: false, kode: kode, respon: json };
  } catch (err) {
    console.error('[SYNC HARGA LIVE] gagal: ' + err + ' | ' + JSON.stringify(aman));
    throw err;
  }
}
function syncCatatLog_(sku, channel, kodeMp, mode, hargaCoret, hargaFinal, status, pesan, req) {
  try {
    var reqAman = req ? { url: String(req.url).replace(/(access_token=)[^&]+/, '$1***'), body: req.body } : '';
    getLogSyncHargaSheet_().appendRow([new Date(), sku, channel, kodeMp, mode, hargaCoret, hargaFinal, status, pesan, reqAman ? JSON.stringify(reqAman).substring(0, 45000) : '']);
  } catch (e) { Logger.log('Gagal catat Log Sync Harga: ' + e); }
}

