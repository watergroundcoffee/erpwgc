    if (pU) { if (c.userN) { if (!pU.re.test(c.userN)) continue; bukti.push('username'); } else if (!pN) continue; }
    if (pH && pH.terlihat >= 4 && c.hp) { if (!p88CocokHp_(pH, c.hp)) continue; bukti.push(pH.terlihat + ' digit HP'); }
    if (wil.length && c.wilN) { if (!wil.every(function (w) { return c.wilN.indexOf(w) >= 0; })) continue; bukti.push('wilayah'); }
    if (bukti.length < 2) continue;
    if (hasil.some(function (x) { return x.c.namaN === c.namaN; })) continue; // orang yang sama (kontak ganda)
