}

// ===== AKSI: retur_media_salin { noResi } - salin file Google Drive lama ke Supabase Storage (maks 4 file per panggilan)
function prosesReturMediaSalin(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiMasuk')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noResi = String(data.noResi || '').trim();
    var d = returBacaDetail_()[kunciResi_(noResi)];
    if (!d) throw new Error('Data retur ' + noResi + ' tidak ditemukan.');
    var aman = function (t) { return String(t || '').replace(/[\\/:*?"<>|#%]+/g, '-').replace(/\s+/g, ' ').trim(); };
    var folder = null, t0 = Date.now(), hasilFile = {}, nSalin = 0, nGagal = 0;
    ['foto', 'video'].forEach(function (jenis) {
      (d[jenis] || []).forEach(function (m) {
        var id = String(m.id || '');
        if (!id || id.indexOf('/') !== -1 || nSalin + nGagal >= 4 || Date.now() - t0 > 90000) return;
        try {
          folder = folder || (function () { var ind = getSubfolderUpload('Retur Unboxing'), it = ind.getFoldersByName(aman(noResi)); return it.hasNext() ? it.next() : ind.createFolder(aman(noResi)); })();
          var blob = DriveApp.getFileById(id).getBlob();
          var mime = String(m.mime || blob.getContentType() || (jenis === 'video' ? 'video/mp4' : 'image/jpeg'));
          var f = folder.createFile(Utilities.newBlob(blob.getBytes(), mime, String(m.nama || (jenis + '-' + id))));
          hasilFile[id] = { id: f.getId(), nama: m.nama || f.getName(), mime: mime, url: f.getUrl(), thumb: jenis === 'foto' ? f.getUrl() : '', t: m.t || Date.now(), driveId: id };
          nSalin++;
        } catch (eF) { hasilFile[id] = { gagal: String(eF.message || eF).slice(0, 160) }; nGagal++; }
      });
    });
    var lock = kunciModul_('pengiriman');
    lock.waitLock(20000);
    try {
      var sh = getReturDetailSheet_(), dd = returBacaDetail_()[kunciResi_(noResi)];
      var ganti = function (list) { return (list || []).map(function (m) { var h = hasilFile[String(m.id || '')]; if (!h) return m; if (h.gagal) { var c = JSON.parse(JSON.stringify(m)); c.salinGagal = h.gagal; return c; } return h; }); };
      dd.foto = ganti(dd.foto); dd.video = ganti(dd.video);
      sh.getRange(dd.row, 6, 1, 2).setValues([[JSON.stringify(dd.foto), JSON.stringify(dd.video)]]);
      result.foto = dd.foto; result.video = dd.video;
    } finally { lepasKunci_(lock); }
    result.disalin = nSalin; result.gagal = nGagal;
    result.sisa = result.foto.concat(result.video).filter(function (m) { return m.id && String(m.id).indexOf('/') === -1 && !m.salinGagal; }).length;
