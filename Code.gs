/* ---------- CHECK_SKU_MAPPING: diagnosa mapping SKU <-> item_id/model_id (Shopee) & product_id/sku_id (TikTok) ---------- */
function cekMappingSku(skuInput, platform, opsi) {
  opsi = opsi || {};
  var sku = String(skuInput || '').trim();
  var out = { target: 'Cek mapping ' + sku, status: 'SUCCESS', bacaSaja: true, data: { shopee: [], tiktok: [] } };
  if (!sku) { out.status = 'FAILED'; out.pesan = 'sku wajib diisi.'; return out; }
  // Pakai RESOLVER yang sama dengan Sync -> hasil diagnosa = yang benar-benar dikirim saat Sync
  var kodeS = [], kodeT = [], pemilik = '', catatan = [];
  var adaDiMaster = true;
  try { eksBacaProduk_(sku, opsi.toko); pemilik = sku; } catch (e) { adaDiMaster = false; }
  if (!adaDiMaster) {
    var pem = syncCariPemilikKode_(sku, opsi.toko);
    if (pem.length) {
      pemilik = pem[0].sku;
      pem.forEach(function (x) { catatan.push('• Terdaftar di ' + x.asal + ' milik SKU Gudang ' + x.sku + ' sebagai platform ' + x.platform); });
    }
  }
  if (pemilik) {
    var mS = syncKodeTerhubung_(pemilik, ['Shopee'], opsi.toko), mT = syncKodeTerhubung_(pemilik, ['TikTok Shop', 'Tokopedia'], opsi.toko);
    kodeS = mS.kode; kodeT = mT.kode;
    catatan.push('• Mapping Shopee yang dipakai Sync: ' + mS.kode.map(function (k) { return k + ' [' + mS.asal[k] + ']'; }).join(', '));
    catatan.push('• Mapping TikTok/Tokopedia yang dipakai Sync: ' + mT.kode.map(function (k) { return k + ' [' + mT.asal[k] + ']'; }).join(', '));
    if (mS.platformLain.length) catatan.push('  ⚠ Kode berlabel platform lain (TIDAK dikirim ke Shopee): ' + mS.platformLain.join(', ') + ' - kalau sebenarnya kode Shopee, perbaiki lewat [✎ SKU].');
    // Yang ditanyakan SKU marketplace -> yang diperiksa ke API cukup kode itu sendiri (label platform bisa salah)
    if (!adaDiMaster) { kodeS = [sku]; kodeT = [sku]; }
  } else { kodeS = [sku]; kodeT = [sku]; }
  var b = ['🔎 CEK MAPPING "' + sku + '"' + (pemilik ? (pemilik === sku ? ' (SKU Gudang)' : ' (terhubung ke SKU Gudang ' + pemilik + ')') : ' (tidak terhubung ke SKU Gudang mana pun - dicek sebagai SKU marketplace)')].concat(catatan);
  if (!platform || /shopee/i.test(platform)) kodeS.forEach(function (k) { var d = cekMappingShopee_(k); out.data.shopee.push(d); b = b.concat(d.baris); });
  if (!platform || /tiktok|tokopedia/i.test(platform)) kodeT.forEach(function (k) { var d = cekMappingTiktok_(k); out.data.tiktok.push(d); b = b.concat(d.baris); });
  out.pesan = b.join('\n');
  return out;
}
function cekMappingShopee_(kode) {
  var d = { kode: kode, valid: [], baris: ['— SHOPEE "' + kode + '"'] }, b = d.baris;
  var kred = ambilKredensialShopee();
  if (!kred || !kred.accessToken || !kred.shopId) { b.push('✗ Token Shopee belum tersedia / kedaluwarsa.'); return d; }
  SHOPEE_ID_MEMO_ = null;
  var lokal = syncPetaIdShopeeLokal_()[kode] || [];
  b.push('• Sheet "ID Produk Shopee": ' + (lokal.length ? lokal.map(function (x) { return 'item ' + x.item_id + '/model ' + x.model_id + (x.sumberBaris ? ' [' + x.sumberBaris + ']' : ''); }).join(', ') : 'belum ada baris'));
  var cari = [];
  try {
    cari = syncPanggilShopee_(kred, '/api/v2/product/search_item', '&offset=0&page_size=10&item_sku=' + encodeURIComponent(kode)).item_id_list || [];
    b.push('• search_item(item_sku): ' + (cari.length ? cari.join(', ') : 'TIDAK ADA hasil → kemungkinan "' + kode + '" adalah SKU VARIAN (model_sku), bukan SKU induk'));
  } catch (e) { b.push('• search_item gagal: ' + e.message); }
  var kandidat = [];
  lokal.forEach(function (x) { if (kandidat.indexOf(Number(x.item_id)) === -1) kandidat.push(Number(x.item_id)); });
  cari.forEach(function (x) { if (kandidat.indexOf(Number(x)) === -1) kandidat.push(Number(x)); });
  var periksa = function (ids) {
    if (!ids.length) return;
    try {
      var info = syncPanggilShopee_(kred, '/api/v2/product/get_item_base_info', '&item_id_list=' + ids.slice(0, 50).join(','));
      var ada = {};
      (info.item_list || []).forEach(function (it) {
        ada[it.item_id] = true;
        var teks = '  ▸ item ' + it.item_id + ' "' + String(it.item_name || '').slice(0, 45) + '" | status ' + it.item_status + ' | item_sku "' + (it.item_sku || '') + '"';
        if (it.has_model) {
          var m = syncPanggilShopee_(kred, '/api/v2/product/get_model_list', '&item_id=' + it.item_id);
          var cocok = (m.model || []).filter(function (md) { return String(md.model_sku || '').trim() === kode; });
          cocok.forEach(function (md) { d.valid.push({ item_id: it.item_id, model_id: md.model_id, status: it.item_status }); });
          teks += ' | varian cocok: ' + (cocok.length ? cocok.map(function (md) { return 'model ' + md.model_id; }).join(', ') : 'TIDAK ADA model_sku "' + kode + '"');
        } else if (String(it.item_sku || '').trim() === kode) { d.valid.push({ item_id: it.item_id, model_id: 0, status: it.item_status }); teks += ' | ✓ tanpa varian, model_id 0'; }
        else teks += ' | ✗ item_sku tidak sama persis';
        var pr = sptInfoPromoItem_(it.item_id);
        teks += ' | promo: ' + (pr.ok ? ((pr.diskonToko.map(function (x) { return 'Diskon toko ' + x.id; }).concat(pr.lain)).join(', ') || 'tidak ada') : 'tidak terbaca');
        b.push(teks);
      });
      ids.forEach(function (id) { if (!ada[id]) b.push('  ▸ item ' + id + ': ✗ tidak dikembalikan Shopee (dihapus / bukan milik toko ini) - ID di sheet lokal BASI'); });
    } catch (e) { b.push('  ▸ verifikasi gagal: ' + e.message); }
  };
  periksa(kandidat);
  if (!d.valid.length) {
    b.push('• Belum ada mapping valid → membangun Indeks SKU Shopee (scan semua listing NORMAL + varian)...');
    try {
      var h = bangunIndeksSkuShopee_({ batasMs: 150000, kred: kred });
      SHOPEE_ID_MEMO_ = null;
      var idx = (syncPetaIdShopeeLokal_()[kode] || []).filter(function (x) { return x.sumberBaris === 'INDEKS'; });
      b.push('  indeks: ' + h.jumlahListing + ' listing, ' + h.jumlahSku + ' SKU' + (h.terpotong ? ' (TERPOTONG batas waktu - jalankan lagi)' : '') + ' → ' + (idx.length ? '✓ ditemukan: ' + idx.map(function (x) { return 'item ' + x.item_id + '/model ' + x.model_id; }).join(', ') : '✗ "' + kode + '" tidak ada di listing NORMAL'));
      idx.forEach(function (x) { d.valid.push({ item_id: x.item_id, model_id: x.model_id, status: 'NORMAL' }); });
    } catch (e) { b.push('  indeks gagal: ' + e.message); }
  }
  b.push(d.valid.length ? '✅ KESIMPULAN: ' + d.valid.length + ' listing valid (' + d.valid.map(function (v) { return v.item_id + '/' + v.model_id; }).join(', ') + ')' + (d.valid.length > 1 ? ' - duplikat, semua akan di-update.' : '.')
    : '❌ KESIMPULAN: tidak ada listing aktif dengan SKU persis "' + kode + '". Cek di Seller Centre: ejaan/spasi SKU, listing diarsipkan/diturunkan (UNLIST/BANNED), atau SKU ada di level varian dengan teks berbeda.');
  return d;
}
function cekMappingTiktok_(kode) {
  var d = { kode: kode, valid: [], baris: ['— TIKTOK SHOP "' + kode + '"'] }, b = d.baris;
