}

/* ---------- Sync Harga: klasifikasi kegagalan per listing + penanganan PROMO ---------- */
function syncLabelTarget_(req) {
  if (!req || !req.body) return '';
  if (req.platform === 'Shopee') return 'item ' + req.body.item_id + (req.body.price_list && req.body.price_list[0] && req.body.price_list[0].model_id ? '/model ' + req.body.price_list[0].model_id : '');
  return 'product ' + req.product_id + '/sku ' + req.sku_id;
}
function syncKlasifikasiGagal_(st, err, c) {
  var mentah = String(err && err.message || err);
  if (err && err.dilewati) {
    // SKU tidak ada / tidak aktif di marketplace -> dilewati, tidak dihitung gagal
    st.dilewati = true;
    st.alasanSingkat = 'tidak ada / tidak aktif di ' + c.cfg.label;
    st.pesan = mentah;
    syncCatatLog_(c.sku, c.cfg.label, c.kodeMp, c.mode, c.hargaCoret, c.hargaFinal, 'DILEWATI', mentah, null);
    return st;
  }
  // Ditolak marketplace -> alasan diterjemahkan + pesan ASLI disertakan (tampil di tabel Harga & chat OmniAI)
  st.alasanSingkat = syncTerjemahkanAlasan_(mentah) || (c.cfg.alasanSingkat && c.cfg.alasanSingkat(mentah)) || '';
  st.pesanAsli = mentah;
  st.pesan = st.alasanSingkat ? st.alasanSingkat + ' — ' + mentah : mentah;
  if (err && err.apiError) st.apiError = err.apiError;
  // Shopee mengunci harga dasar karena listing ikut promo -> serahkan ke Task Scheduler
  if (err && err.promo && c.cfg.platform === 'Shopee' && c.mode === 'LIVE' && c.req && c.req.body) {
    try {
      var j = sptTanganiBlokirPromoShopee_({ sku: c.sku, kodeMp: c.kodeMp, item_id: c.req.body.item_id, model_id: (c.req.body.price_list[0] || {}).model_id,
        hargaCoret: c.hargaCoret, email: c.data && c.data.email, toko: c.data && c.data.toko, pesan: mentah });
      if (j && j.taskId) { st.dijadwalkan = true; st.taskId = j.taskId; st.alasanSingkat = j.ringkas; st.pesan = j.ringkas + ' — ' + mentah; }
      else if (j && j.ringkas) { st.alasanSingkat = j.ringkas; st.pesan = j.ringkas + ' — ' + mentah; } // ditolak permanen: perlu tindakan manual
    } catch (eJ) { st.pesan += ' (gagal menjadwalkan penanganan promo: ' + eJ.message + ')'; }
  }
  syncCatatLog_(c.sku, c.cfg.label, c.kodeMp + (st.target ? ' [' + st.target + ']' : ''), c.mode, c.hargaCoret, c.hargaFinal, st.dijadwalkan ? 'DIJADWALKAN' : 'GAGAL', st.pesan + ' (listing ' + st.urutan + ')', null);
  return st;
}

/* ======================================================================================
   RESOLVER SKU MAPPING  (SKU Gudang -> SKU Marketplace) - dipakai SEMUA jalur ke API marketplace:
   Sync Harga Shopee / TikTok & Tokopedia, Harga Live, push stok TikTok, AUTOMATE_PRICE_RESTRUCTURE, CHECK_SKU_MAPPING.
   Sumber (digabung, duplikat dibuang, huruf besar/kecil diabaikan):
     A) kolom "SKU Terhubung Shopee / TikTok / Tokopedia" di Produk Master   (diisi lewat [✎ SKU] menu Harga)
     B) sheet "SKU Marketplace Terhubung"                                     (diisi lewat menu Katalog)
        - baris ber-Platform sesuai  -> dipakai untuk platform itu
        - baris Platform KOSONG      -> dipakai untuk semua platform (ID tetap diverifikasi PERSIS ke API)
        - baris platform lain        -> TIDAK dipakai (dilaporkan di infoPlatformLain)
   Tidak ada mapping sama sekali -> fallback SKU Gudang.
   ====================================================================================== */
var SYNC_PETA_KODE_MEMO_ = {};
function syncNormPlatform_(teks) {
  var t = String(teks || '').trim();
  if (!t) return '_TANPA_';
  for (var i = 0; i < SKUP_PLATFORM.length; i++) if (SKUP_PLATFORM[i].cocok.test(t)) return SKUP_PLATFORM[i].platform;
  return t;
}
function syncPetaKodeTerhubung_(toko) {
  var kunci = String(toko || '_default');
  if (SYNC_PETA_KODE_MEMO_[kunci]) return SYNC_PETA_KODE_MEMO_[kunci];
  var peta = {}; // skuGudang -> { platform -> [{ kode, asal }] }
  var tambah = function (sku, pf, kode, asal) {
    sku = String(sku || '').trim(); kode = String(kode || '').trim();
    if (!sku || !kode) return;
    var d = (peta[sku] = peta[sku] || {})[pf] = (peta[sku][pf] || []);
    if (!d.some(function (x) { return x.kode.toUpperCase() === kode.toUpperCase(); })) d.push({ kode: kode, asal: asal });
  };
  try { // A) kolom Produk Master
    var sh = getMasterProdukSheet(toko), lr = sh.getLastRow(), kol = syncKolomSkuTerhubungMaster_(toko);
    if (lr > 1) {
      var vals = sh.getRange(2, 1, lr - 1, sh.getLastColumn()).getDisplayValues();
      vals.forEach(function (r) {
        SKUP_PLATFORM.forEach(function (p) {
          var c = kol[p.platform]; if (!c || c.dobel) return;
          skupPecah_(r[c.nomor - 1]).forEach(function (k) { tambah(r[0], p.platform, k, 'kolom ' + c.judul); });
        });
      });
    }
  } catch (eA) { Logger.log('Resolver: kolom Produk Master tidak terbaca - ' + eA); }
  try { // B) sheet Katalog "SKU Marketplace Terhubung"
    var shL = getSkuMarketplaceTerhubungSheet(), lrL = shL.getLastRow();
    if (lrL > 1) shL.getRange(2, 1, lrL - 1, 3).getDisplayValues().forEach(function (r) {
      var pf = syncNormPlatform_(r[2]);
      skupPecah_(r[1]).forEach(function (k) { tambah(r[0], pf, k, pf === '_TANPA_' ? 'Katalog (tanpa platform)' : 'Katalog'); });
    });
  } catch (eB) { Logger.log('Resolver: sheet SKU Marketplace Terhubung tidak terbaca - ' + eB); }
  SYNC_PETA_KODE_MEMO_[kunci] = peta;
  return peta;
}
// return { kode:[...], asal:{kode:asal}, sumber:[...], fallback:bool, platformLain:[ 'KODE (Platform)' ] }
function syncKodeTerhubung_(skuGudang, daftarPlatform, toko) {
  var sku = String(skuGudang || '').trim();
  var milik = syncPetaKodeTerhubung_(toko)[sku] || {};
  var out = { kode: [], asal: {}, sumber: [], fallback: false, platformLain: [] };
  var masuk = function (x) {
    if (out.kode.some(function (k) { return k.toUpperCase() === x.kode.toUpperCase(); })) return;
    out.kode.push(x.kode); out.asal[x.kode] = x.asal;
    if (out.sumber.indexOf(x.asal) === -1) out.sumber.push(x.asal);
  };
  daftarPlatform.concat(['_TANPA_']).forEach(function (pf) { (milik[pf] || []).forEach(masuk); });
  Object.keys(milik).forEach(function (pf) {
    if (daftarPlatform.indexOf(pf) !== -1 || pf === '_TANPA_') return;
    milik[pf].forEach(function (x) { if (out.kode.map(function (k) { return k.toUpperCase(); }).indexOf(x.kode.toUpperCase()) === -1) out.platformLain.push(x.kode + ' (' + pf + ')'); });
  });
  if (!out.kode.length && sku) { out.kode = [sku]; out.asal[sku] = 'SKU Gudang (fallback)'; out.fallback = true; }
  return out;
}
// SKU marketplace -> SKU Gudang pemiliknya (semua platform & sumber). '' bila tidak ada.
function syncCariPemilikKode_(kode, toko) {
  var k = String(kode || '').trim().toUpperCase(), peta = syncPetaKodeTerhubung_(toko), hasil = [];
  Object.keys(peta).forEach(function (sku) {
    Object.keys(peta[sku]).forEach(function (pf) {
      peta[sku][pf].forEach(function (x) { if (x.kode.toUpperCase() === k) hasil.push({ sku: sku, platform: pf === '_TANPA_' ? '(tanpa platform)' : pf, asal: x.asal }); });
    });
  });
  return hasil;
}

/* ======================================================================================
   AI AGENT WORKSPACE & TASK CENTER (halaman penuh: menu AI Agent > Workspace Chat / Daftar Tugas & Log AI)
   - Thread chat per topik  : sheet AI_Sessions + AI_Messages. Tiap thread punya konteks sendiri;
                              ringkasan bergulir (kolom Ringkasan) + jendela 8 pesan terakhir -> prompt tetap kecil.
   - Otak & guardrail       : TETAP memakai yang sudah ada - tanyaCopilot() (konteks ERP + aturan aksi),
                              executeAiAction() (izin + guardrail harga + Execution_Logs), Scheduled_Tasks + worker.
   - Action Card            : disimpan DI SERVER (kolom Action_Cards). Saat dikonfirmasi, parameter diambil dari
