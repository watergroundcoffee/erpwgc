/* ---------- AKSI: rst_proses - catat ROASTING (banyak batch) atau OLAH/CAMPUR (setengah jadi 2, dst)
   Roasting: data.batch = [{ skuMentah, skuHasil | namaHasilBaru, profil, masuk(g), keluar(g), chaff, suhuMasuk, suhuKeluar, jam, catatan }]
   Olah    : data.olah = { input:[{sku, gram}], skuHasil | namaHasilBaru, keluar(g), nama (mis. Blend House), catatan }
   Kejadian: data.gantiTabung / data.servisMesin (dicatat di Roastery Log; tabung dipakai menghitung batch per tabung) */
function prosesRstProses(data) {
  var cache = CacheService.getScriptCache(), idp = String(data.idPermintaan || '').trim();
  if (idp) { var sudah = cache.get('RST_ID_' + idp); if (sudah) return JSON.parse(sudah); }
  var lock = kunciModul_(['produksi', 'stok']);
  try { lock.waitLock(20000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  var result = { success: false };
  try {
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    var oleh = rstNamaOleh_(data.email), tgl = rstTanggal_(data.tanggal), boleh = rstBolehHarga_(data.email);
    var semua = rstBacaBahan_(), peta = {};
    semua.forEach(function (b) { peta[b.sku.toUpperCase()] = b; });
    var biaya = rstBacaBiaya_();
    var shLog = rstSheet_(RST_SH_LOG, RST_HDR_LOG, [1, 6, 7]);
    var nomor = rstNoProses_(shLog, 'RS', 1);
    var logBaris = [], mutasi = [], pakai = {}, diHasilkan = {}, ringkas = [];
    var nextNo = function () { nomor.urut++; return nomor.awalan + ('0' + nomor.urut).slice(-2); };
    var catatBahan = function (b, gramPakai) { var k = b.sku.toUpperCase(); pakai[k] = (pakai[k] || 0) + gramPakai; };

    if (data.gantiTabung) logBaris.push([nextNo(), tgl, 'Roasting', 'Ganti Tabung Gas', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', String(data.catatanKejadian || ''), oleh, 'Input', '']);
    if (data.servisMesin) logBaris.push([nextNo(), tgl, 'Roasting', 'Servis Mesin', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', String(data.catatanKejadian || ''), oleh, 'Input', '']);

    var rencana = []; // { input:[{b, gram}], hasil:b, keluar, tahap, meta }
