/* ============================================================
   ANALISA PERFORMA STAFF (AI) - bandingkan staff dengan ROLE SAMA
   ============================================================ */
function prosesAnalisaPerformaStaff(data) {
  var result = { success: false };
  try {
    var staffData = prosesLihatSemuaStaff(data);
    if (!staffData.success) throw new Error(staffData.error);

    var daftarAktif = staffData.daftar.filter(function (s) { return s.aktif; });
    var perRole = {}; // { roleName: [staff, ...] }
    daftarAktif.forEach(function (s) {
      if (!perRole[s.role]) perRole[s.role] = [];
      perRole[s.role].push(s);
    });

    var roleUntukDianalisa = null;
    Object.keys(perRole).forEach(function (role) {
      if (perRole[role].length > 1 && !roleUntukDianalisa) roleUntukDianalisa = role;
    });

    if (!roleUntukDianalisa) {
      result.success = true;
      result.adaPerbandingan = false;
      result.pesan = 'Belum ada role dengan lebih dari 1 staff aktif, jadi belum bisa dibandingkan. Analisa perbandingan baru muncul kalau ada minimal 2 staff dengan jabatan yang sama (misal 2 Admin Gudang).';
      return result;
    }

    var staffDibandingkan = perRole[roleUntukDianalisa];
    var ringkasanData = staffDibandingkan.map(function (s) {
      return s.nama + ': ' + s.jumlahResiScan + ' resi discan, ' + s.jumlahPesananDibuat + ' pesanan dibuat, bergabung sejak ' + s.tanggalBergabung;
    }).join('\n');

    var prompt = 'Kamu asisten analisa performa kerja buat gudang/toko online kecil. Berikut data staff dengan jabatan yang sama ("' +
      roleUntukDianalisa + '"):\n\n' + ringkasanData +
      '\n\nBuat analisa singkat (maksimal 4-5 kalimat, Bahasa Indonesia) - siapa yang lebih produktif dan kenapa, ' +
      'berdasarkan data di atas. Jangan menghakimi terlalu keras, sebutkan juga kalau datanya masih terbatas ' +
      'buat kesimpulan pasti. Jangan mengarang angka di luar yang dikasih.';

    var analisa = panggilGeminiText(prompt);

    result.success = true;
    result.adaPerbandingan = true;
    result.role = roleUntukDianalisa;
    result.staffDibandingkan = staffDibandingkan;
    result.analisa = analisa;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   STOCK BAYANGAN - izinkan stock minus (backorder), dengan batas yang bisa disetel
   ============================================================ */

function prosesLihatPengaturanStock(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var props = PropertiesService.getScriptProperties();
    var batas = props.getProperty('BATAS_STOCK_BAYANGAN');
    result.success = true;
    result.batasStockBayangan = batas !== null ? parseInt(batas, 10) : 20; // default 20 kalau belum pernah disetel
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesSimpanPengaturanStock(data) {
  var result = { success: false };
  try {
    var staffPeminta = getStaffByEmail(data.email);
    if (!staffPeminta || staffPeminta.role !== 'Owner' || !staffPeminta.aktif) {
      throw new Error('Cuma Owner yang bisa ubah pengaturan ini.');
    }
    var batas = parseInt(data.batasStockBayangan, 10);
    if (isNaN(batas) || batas < 0) throw new Error('Batas harus angka 0 atau lebih.');
    PropertiesService.getScriptProperties().setProperty('BATAS_STOCK_BAYANGAN', String(batas));
    result.success = true;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

// Bandingkan total Pesanan Manual AKTIF (belum dibatalkan) per SKU vs stock fisik tercatat (dari ledger).
// Kalau totalDipesan > stockFisik, SKU itu "masuk Stock Bayangan" (defisit).
function prosesCekStockBayangan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var stockData = prosesLihatStock({ email: data.email });
    if (!stockData.success) throw new Error(stockData.error);
    var stockFisikPerSku = {};
    stockData.daftar.forEach(function (d) { stockFisikPerSku[d.sku] = { stock: d.stockSaatIni, nama: d.nama }; });

    var sheetsPesanan = getPesananManualSheets();
    var shHeader = sheetsPesanan.header;
    var shDetail = sheetsPesanan.detail;
    var lastRowHeader = shHeader.getLastRow();

    // Bikin lookup No Invoice -> statusnya (buat skip yang Dibatalkan)
    var statusPerInvoice = {};
    if (lastRowHeader > 1) {
      var valsHeader = shHeader.getRange(2, 1, lastRowHeader - 1, 12).getValues();
      valsHeader.forEach(function (row) {
        var noInv = String(row[0] || '').trim();
        if (noInv) statusPerInvoice[noInv] = String(row[11] || '').trim();
      });
    }

    var totalDipesanPerSku = {};
    var lastRowDetail = shDetail.getLastRow();
    if (lastRowDetail > 1) {
      var valsDetail = shDetail.getRange(2, 1, lastRowDetail - 1, 4).getValues(); // No Invoice, SKU, Nama, Qty
      valsDetail.forEach(function (row) {
        var noInv = String(row[0] || '').trim();
        if (statusPerInvoice[noInv] === 'Dibatalkan') return; // pesanan batal, jangan dihitung
        var sku = String(row[1] || '').trim();
        if (!sku) return;
        totalDipesanPerSku[sku] = (totalDipesanPerSku[sku] || 0) + (parseFloat(row[3]) || 0);
      });
    }

    var pengaturan = prosesLihatPengaturanStock(data);
    var batas = pengaturan.success ? pengaturan.batasStockBayangan : 20;

    var daftarDefisit = [];
    Object.keys(totalDipesanPerSku).forEach(function (sku) {
      var totalDipesan = totalDipesanPerSku[sku];
      var infoStock = stockFisikPerSku[sku] || { stock: 0, nama: sku };
      var defisit = totalDipesan - infoStock.stock;
      if (defisit > 0) {
        daftarDefisit.push({
          sku: sku, nama: infoStock.nama, stockFisik: infoStock.stock,
          totalDipesan: totalDipesan, defisit: defisit,
          melebihiBatas: defisit > batas
        });
      }
    });
    daftarDefisit.sort(function (a, b) { return b.defisit - a.defisit; });

    result.success = true;
    result.daftar = daftarDefisit;
    result.batasStockBayangan = batas;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

