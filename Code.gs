          if (asli) (hits[asli] = hits[asli] || {})[src.fnSumber(r) + '|' + no] = { no: no, sumber: src.fnSumber(r), kolom: String(head[c] || ('Kolom ' + (c + 1))) };
          var dk = k.replace(/^0+/, '');
