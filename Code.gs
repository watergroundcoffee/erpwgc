/* ====================================================================================
   MONITOR STOK - [+ Master] UPSERT (Update or Insert) 1 SKU ke Master Produk
   Dipanggil KHUSUS dari halaman Persediaan > Monitor Stok. Fungsi-fungsi Katalog >
   Produk Master (prosesTambahProdukBaru, edit_produk_master, dst) TIDAK disentuh.
   - Cari SKU pakai TextFinder (seluruh sel, tidak case-sensitive, bukan regex)
   - Ada   -> UPDATE Nama (kolom 2) + Harga Supplier/Modal (kolom 4, hanya kalau diisi)
   - Belum -> INSERT baris baru dengan urutan kolom standar Master Produk
   ==================================================================================== */

// Parser harga gaya Indonesia (server side - jaring pengaman, walau browser sudah kirim angka murni).
// "Rp 45.000" -> 45000 | "Rp45.000,50" -> 45000.5 | "45,000" -> 45000 | "45rb"/"45k" -> 45000 | "1,5jt" -> 1500000
function smParseRupiah(nilai) {
  if (nilai === null || nilai === undefined || nilai === '') return null;
  if (typeof nilai === 'number') return isNaN(nilai) ? null : nilai;
  var t = String(nilai).toLowerCase().replace(/rp\.?/g, '').replace(/idr/g, '').replace(/\s+/g, '');
  var pengali = 1;
  var suf = t.match(/(rb|ribu|k|jt|juta)$/);
  if (suf) { pengali = (suf[1] === 'jt' || suf[1] === 'juta') ? 1000000 : 1000; t = t.slice(0, -suf[1].length); }
  t = t.replace(/[^0-9.,]/g, '').replace(/[.,]+$/, '');
  if (!t) return null;
  var adaTitik = t.indexOf('.') !== -1, adaKoma = t.indexOf(',') !== -1;
  if (adaTitik && adaKoma) {
    // pemisah yang muncul TERAKHIR = desimal
    if (t.lastIndexOf(',') > t.lastIndexOf('.')) t = t.replace(/\./g, '').replace(',', '.');
    else t = t.replace(/,/g, '');
  } else if (adaTitik) {
    if (/^\d{1,3}(\.\d{3})+$/.test(t)) t = t.replace(/\./g, '');
  } else if (adaKoma) {
    t = /^\d{1,3}(,\d{3})+$/.test(t) ? t.replace(/,/g, '') : t.replace(',', '.');
  }
  var n = parseFloat(t);
  return isNaN(n) ? null : Math.round(n * pengali * 100) / 100;
}

function prosesMonitorUpsertSkuMaster(data) {
  var result = { success: false };
  var sku, nama, hargaModal, toko;
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    sku = String(data.sku || '').trim();
    nama = String(data.namaProduk || '').replace(/\s+/g, ' ').trim();
    hargaModal = smParseRupiah(data.hargaModal);
    toko = String(data.toko || '').trim();
    if (!sku) throw new Error('SKU wajib diisi.');
    if (/[\r\n\t]/.test(sku)) throw new Error('SKU tidak boleh berisi baris baru / tab.');
    if (sku.length > 80) throw new Error('SKU terlalu panjang (maks 80 karakter).');
    if (!nama) throw new Error('Nama Produk wajib diisi.');
    if (hargaModal !== null && hargaModal < 0) throw new Error('Harga Modal tidak boleh minus.');
  } catch (errValidasi) { result.error = errValidasi.toString(); return result; }

  var lock = kunciModul_('katalog');
  try { lock.waitLock(15000); } catch (eLock) { result.error = 'Sistem sedang sibuk, coba lagi.'; return result; }
  try {
    var sh = getMasterProdukSheet(toko);
    var lastRow = sh.getLastRow();
    var sel = null;
    if (lastRow > 1) {
      sel = sh.getRange(2, 1, lastRow - 1, 1)
        .createTextFinder(sku)
        .matchCase(false)
        .matchEntireCell(true)
        .useRegularExpression(false)
        .findNext();
    }

    if (sel) {
      // ===== UPDATE =====
      var row = sel.getRow();
      var skuDiSheet = String(sel.getValue()).trim();
      if (hargaModal !== null) katCekHppVsHarga_(skuDiSheet || sku, hargaModal, parseFloat(sh.getRange(row, 3).getValue()) || 0);
      sh.getRange(row, 2).setValue(nama);
      if (hargaModal !== null) sh.getRange(row, 4).setValue(hargaModal);
      result.mode = 'update';
      result.row = row;
      result.sku = skuDiSheet || sku;
    } else {
      // ===== INSERT ===== urutan kolom standar Master Produk (1-22):
      // SKU, Nama, Harga, HargaSupplier, URLSupplier, BatasStokMenipis, HargaShopee, Kategori, URLFoto,
      // Deskripsi, Brand, Tipe, Material, Volume, Warna, MarginCustom, Toko, TampilDiWebsite, Berat,
      // Dimensi, SpesifikasiTambahan(JSON), GaleriFotoTambahan(JSON)
      var baris = [sku, nama, 0, hargaModal === null ? 0 : hargaModal, '', '', 0, '', '', '',
        'NO BRAND', '', '', '', '', '', toko, false, '', '', '[]', '[]'];
      var rowBaru = lastRow + 1;
      sh.getRange(rowBaru, 1).setNumberFormat('@'); // SKU tetap teks (nol di depan aman)
      sh.getRange(rowBaru, 1, 1, baris.length).setValues([baris]);
      result.mode = 'insert';
      result.row = rowBaru;
      result.sku = sku;
    }
    result.success = true;
    result.namaProduk = nama;
    result.hargaModal = hargaModal;
  } catch (err) {
    result.error = String(err && err.message || err);
  } finally { lepasKunci_(lock); }

  if (result.success) {
    smInvalidasiCache();
    // Hanya MENGHAPUS cache supaya Katalog membaca data segar saat dibuka berikutnya (kode Katalog tidak diubah)
    try {
      var kunci = [];
      ['default', 'Waterground', 'Conner', toko || 'default'].forEach(function (t) { kunci.push('KATALOG_PRODUK_' + t, 'KATALOG_HARGA_' + t, 'LAPORAN_KATALOG_' + t); });
      CacheService.getScriptCache().removeAll(kunci);
    } catch (eC) { }
  }
  return result;
}


/* ====================================================================================
   MONITOR STOK - INPUT MASTER MASSAL (monitor_bulk_upsert_sku_master)
   Batch murni: Master Produk dibaca SEKALI (kolom SKU + Nama) ke memori, dicocokkan lewat
   peta (bukan TextFinder di dalam loop), lalu ditulis maksimal 2x setValues:
     - 1x tulis ulang blok kolom Nama (hanya kalau ada SKU yang ternyata sudah ada + nama baru)
     - 1x tulis semua baris baru sekaligus di bawah
   Aturan:
     - SKU sudah ada di Master  -> nama diperbarui HANYA kalau nama dikirim; kalau kosong dibiarkan
     - SKU belum ada            -> baris baru; kalau nama kosong, nama sementara = SKU (bisa
                                   dirapikan nanti di Katalog)
   ==================================================================================== */
var SM_BULK_MAKS_ITEM = 1000;

function prosesMonitorBulkUpsertSkuMaster(data) {
  var result = { success: false };
  var items = [], dilewati = [];
  var toko;
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    toko = String(data.toko || '').trim();
    var mentah = Array.isArray(data.items) ? data.items : (Array.isArray(data.dataArray) ? data.dataArray : []);
    if (mentah.length === 0) throw new Error('Tidak ada SKU yang dikirim.');
    if (mentah.length > SM_BULK_MAKS_ITEM) throw new Error('Maksimal ' + SM_BULK_MAKS_ITEM + ' SKU per proses (dikirim ' + mentah.length + ').');
    var sudahDilihat = {};
    mentah.forEach(function (it) {
      var sku = String((it && it.sku) || '').trim();
      var nama = String((it && (it.namaProduk || it.nama)) || '').replace(/\s+/g, ' ').trim();
      if (!sku) return;
      if (/[\r\n\t]/.test(sku) || sku.length > 80) { dilewati.push({ sku: sku.substring(0, 80), alasan: 'Format SKU tidak valid' }); return; }
      var k = sku.toUpperCase();
      if (sudahDilihat[k]) return; // duplikat dalam kiriman yang sama
      sudahDilihat[k] = true;
      items.push({ sku: sku, kunci: k, nama: nama });
    });
    if (items.length === 0) throw new Error('Semua SKU yang dikirim tidak valid.');
  } catch (errValidasi) { result.error = errValidasi.toString(); return result; }

  var lock = kunciModul_('katalog');
  try { lock.waitLock(30000); } catch (eLock) { result.error = 'Sistem sedang sibuk, coba lagi.'; return result; }
  var ditambah = [], diperbarui = [], sudahAda = [];
  try {
    var sh = getMasterProdukSheet(toko);
    var lastRow = sh.getLastRow();

    // 1) Baca SEKALI: kolom SKU + Nama -> peta SKU(upper) -> index baris
    var blok = lastRow > 1 ? sh.getRange(2, 1, lastRow - 1, 2).getValues() : [];
    var petaIndex = {};
    for (var i = 0; i < blok.length; i++) {
      var kSheet = String(blok[i][0] || '').trim().toUpperCase();
      if (kSheet && !petaIndex.hasOwnProperty(kSheet)) petaIndex[kSheet] = i;
    }

    // 2) Pisahkan UPDATE vs INSERT di memori
    var kolomNama = blok.map(function (r) { return [r[1]]; });
    var adaUpdateNama = false, barisBaru = [];
    items.forEach(function (it) {
      if (petaIndex.hasOwnProperty(it.kunci)) {
        var idx = petaIndex[it.kunci];
        var skuSheet = String(blok[idx][0]).trim();
        if (it.nama && String(kolomNama[idx][0] || '').trim() !== it.nama) {
          kolomNama[idx][0] = it.nama;
          adaUpdateNama = true;
          diperbarui.push(skuSheet);
        } else {
          sudahAda.push(skuSheet);
        }
      } else {
        // Urutan kolom standar Master Produk (1-22) - sama dengan insert tunggal [+ Master]
        barisBaru.push([it.sku, it.nama || it.sku, 0, 0, '', '', 0, '', '', '',
          'NO BRAND', '', '', '', '', '', toko, false, '', '', '[]', '[]']);
        ditambah.push({ sku: it.sku, nama: it.nama || it.sku, namaSementara: !it.nama });
        petaIndex[it.kunci] = -1; // jaga-jaga duplikat
      }
    });

    // 3) Tulis: maksimal 2x setValues
    if (adaUpdateNama) sh.getRange(2, 2, kolomNama.length, 1).setValues(kolomNama);
    if (barisBaru.length) {
      var rowMulai = lastRow + 1;
      sh.getRange(rowMulai, 1, barisBaru.length, 1).setNumberFormat('@'); // SKU tetap teks
      sh.getRange(rowMulai, 1, barisBaru.length, barisBaru[0].length).setValues(barisBaru);
    }
    result.success = true;
  } catch (err) {
    result.error = err.toString();
  } finally { lepasKunci_(lock); }

  if (result.success) {
    smInvalidasiCache();
    try {
      var kunciCache = [];
      ['default', 'Waterground', 'Conner', toko || 'default'].forEach(function (t) { kunciCache.push('KATALOG_PRODUK_' + t, 'KATALOG_HARGA_' + t, 'LAPORAN_KATALOG_' + t); });
      CacheService.getScriptCache().removeAll(kunciCache);
    } catch (eC) { }
    result.ditambah = ditambah;
    result.diperbarui = diperbarui;
    result.sudahAda = sudahAda;
    result.dilewati = dilewati;
    result.jumlah = { ditambah: ditambah.length, diperbarui: diperbarui.length, sudahAda: sudahAda.length, dilewati: dilewati.length,
      namaSementara: ditambah.filter(function (d) { return d.namaSementara; }).length };
  }
  return result;
}


/* ====================================================================================
   KATALOG > PRODUK MASTER v2
   - Edit Produk Massal (batch setValues, dicocokkan per SKU)
   - Hubungkan SKU (tautkan SKU "tak bertuan" ke produk master lain) + auto-gabung
   - Sapu Bersih: auto-merge SKU tak bertuan yang identik dengan SKU Terhubung produk lain
   Baris master yang digabung TIDAK hilang begitu saja: disalin utuh dulu ke sheet
   "Arsip Merge Produk" (bisa dipulihkan manual kapan saja).
   ==================================================================================== */
var KAT_SHEET_ARSIP_MERGE = 'Arsip Merge Produk';
var KAT_MAKS_EDIT_MASSAL = 1000;

function katPecahKode_(nilai) {
  return String(nilai || '').split(/[\s,;]+/).map(function (x) { return x.trim(); }).filter(function (x) { return x; });
}
function katBersihkanSku_(nilai) { return String(nilai || '').replace(/\s+/g, ''); } // SKU tidak boleh ada spasi

function katInvalidasiCacheKatalog_(toko) {
  try {
    var kunci = [];
    ['default', 'Waterground', 'Conner', toko || 'default'].forEach(function (t) { kunci.push('KATALOG_PRODUK_' + t, 'KATALOG_HARGA_' + t, 'LAPORAN_KATALOG_' + t); });
    CacheService.getScriptCache().removeAll(kunci);
  } catch (e) { }
  smInvalidasiCache();
  CACHE_PETA_SKU_MARKETPLACE = null;
  SM_MEMO_SKU_JUAL_ = null;
  invalidasiCacheProdukRingan_(toko); // v2026.10.53 (DN-261022-150515-627): SKU baru langsung bisa dicari di nota penjualan
}

function getArsipMergeProdukSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(KAT_SHEET_ARSIP_MERGE);
  if (!sh) {
    sh = ss.insertSheet(KAT_SHEET_ARSIP_MERGE);
    sh.getRange(1, 1, 1, 6).setValues([['Waktu', 'SKU Digabung', 'Digabung Ke SKU', 'Nama Produk (lama)', 'Oleh', 'Data Baris Asli (JSON - untuk pemulihan)']]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

// Baca sheet link (Supplier/Marketplace) sekali -> { vals, lebar, pemilik: kode -> skuJual }
function katBacaLink_(sh, lebarMin) {
  var lastRow = sh.getLastRow();
  var lebar = Math.max(lebarMin, sh.getLastColumn());
  var vals = lastRow > 1 ? sh.getRange(2, 1, lastRow - 1, lebar).getValues() : [];
  var pemilik = {};
  vals.forEach(function (r) {
    var skuJual = String(r[0] || '').trim();
    if (!skuJual) return;
    katPecahKode_(r[1]).forEach(function (k) { if (!pemilik[k]) pemilik[k] = skuJual; });
  });
  return { sh: sh, vals: vals, lebar: lebar, lastRow: lastRow, pemilik: pemilik };
}

// Tulis ulang isi sheet link dalam SATU setValues (+ clearContent sisa baris kalau jadi lebih pendek)
function katTulisUlangLink_(info, valsBaru) {
  var sh = info.sh;
  if (valsBaru.length) sh.getRange(2, 1, valsBaru.length, info.lebar).setValues(valsBaru);
  if (info.vals.length > valsBaru.length) sh.getRange(2 + valsBaru.length, 1, info.vals.length - valsBaru.length, info.lebar).clearContent();
}

/* ---------- EDIT PRODUK MASSAL: ambil data segar (pre-fill grid) ---------- */
function prosesKatalogAmbilDataEditMassal(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuList = (data.skuList || []).map(function (x) { return String(x || '').trim(); }).filter(function (x) { return x; });
    if (!skuList.length) throw new Error('Belum ada produk yang dipilih.');
    if (skuList.length > KAT_MAKS_EDIT_MASSAL) throw new Error('Maksimal ' + KAT_MAKS_EDIT_MASSAL + ' produk per edit massal.');
    var diminta = {};
    skuList.forEach(function (x, i) { diminta[x] = i; });

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = lastRow > 1 ? sh.getRange(2, 1, lastRow - 1, 9).getValues() : [];
    var hasil = [];
    var petaArsipEdit = katPetaArsip_(data.toko);
    vals.forEach(function (r) {
      var sku = String(r[0] || '').trim();
      if (!diminta.hasOwnProperty(sku) || petaArsipEdit[sku]) return;
      hasil.push({ sku: sku, nama: String(r[1] || ''), hargaDefault: parseFloat(r[2]) || 0, hpp: parseFloat(r[3]) || 0,
        kategori: String(r[7] || ''), urlFoto: String(r[8] || ''), skuSupplier: [], skuMarketplace: [], _urut: diminta[sku] });
    });
    var peta = {};
    hasil.forEach(function (h) { peta[h.sku] = h; });
    katBacaLink_(getSkuSupplierTerhubungSheet(), 5).vals.forEach(function (r) {
      var h = peta[String(r[0] || '').trim()];
      if (h) katPecahKode_(r[1]).forEach(function (k) { if (h.skuSupplier.indexOf(k) === -1) h.skuSupplier.push(k); });
    });
    katBacaLink_(getSkuMarketplaceTerhubungSheet(), 4).vals.forEach(function (r) {
      var h = peta[String(r[0] || '').trim()];
      if (h) katPecahKode_(r[1]).forEach(function (k) { h.skuMarketplace.push({ sku: k, platform: String(r[2] || '').trim() || 'TikTok Shop' }); });
    });
    hasil.sort(function (a, b) { return a._urut - b._urut; });
    hasil.forEach(function (h) { delete h._urut; });
    result.success = true;
    result.daftar = hasil;
    result.tidakDitemukan = skuList.filter(function (x) { return !peta[x]; });
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ---------- EDIT PRODUK MASSAL: simpan (batch) ----------
   items: [{ sku, nama, kategori, hpp, hargaDefault, urlFoto,
             skuSupplier: [kode] | null, skuMarketplace: [{sku, platform}] | null }]
   null = daftar SKU terhubung tidak diubah -> sheet link tidak disentuh untuk produk itu. */
function prosesKatalogSimpanEditMassal(data) {
  var result = { success: false };
  var lock = null;
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var items = Array.isArray(data.items) ? data.items : [];
    if (!items.length) throw new Error('Tidak ada perubahan untuk disimpan.');
    if (items.length > KAT_MAKS_EDIT_MASSAL) throw new Error('Maksimal ' + KAT_MAKS_EDIT_MASSAL + ' produk per simpan.');
    var errorPerBaris = [];
    var bersih = items.map(function (it, i) {
      var sku = String(it.sku || '').trim();
      var nama = String(it.nama || '').replace(/^\s+/, '').replace(/\s+$/, '');
      var hpp = parseFloat(it.hpp), harga = parseFloat(it.hargaDefault);
      if (!sku) errorPerBaris.push({ baris: i + 1, pesan: 'SKU kosong' });
      if (!nama) errorPerBaris.push({ baris: i + 1, pesan: 'Nama Produk wajib diisi' });
      if (isNaN(hpp) || hpp < 0) errorPerBaris.push({ baris: i + 1, pesan: 'HPP tidak valid' });
      if (isNaN(harga) || harga < 0) errorPerBaris.push({ baris: i + 1, pesan: 'Harga Default tidak valid' });
      if (it.urlFoto !== undefined) { try { katValidasiUrlFoto_(it.urlFoto, ''); } catch (eFoto) { errorPerBaris.push({ baris: i + 1, pesan: String(eFoto.message) }); } }
      return {
        no: i + 1, sku: sku, nama: nama.substring(0, 250), kategori: String(it.kategori || '').trim().substring(0, 80),
        hpp: hpp, harga: harga, urlFoto: it.urlFoto === undefined ? null : String(it.urlFoto || '').trim(),
        supplier: Array.isArray(it.skuSupplier) ? it.skuSupplier.map(katBersihkanSku_).filter(function (x) { return x; }) : null,
        market: Array.isArray(it.skuMarketplace) ? it.skuMarketplace.map(function (m) { return { sku: katBersihkanSku_(m && m.sku), platform: String((m && m.platform) || 'TikTok Shop').trim() }; }).filter(function (m) { return m.sku; }) : null
      };
    });
    if (errorPerBaris.length) { result.errorPerBaris = errorPerBaris; throw new Error(errorPerBaris.length + ' baris belum valid. Tidak ada yang disimpan.'); }

    var sh = getMasterProdukSheet(data.toko);
    var shKat = getKategoriProdukSheet();
    var shSupp = getSkuSupplierTerhubungSheet();
    var shMarket = getSkuMarketplaceTerhubungSheet();

    lock = kunciModul_('katalog');
    try { lock.waitLock(30000); } catch (eLock) { lock = null; throw new Error('Server sedang sibuk (antrean > 30 detik). Coba simpan lagi sebentar - belum ada yang tersimpan.'); }

    // 1) Master Produk: baca kolom 1-9 SEKALI, ubah di memori, tulis 2 blok (B:D dan H:I)
    var lastRow = sh.getLastRow();
    var vals = lastRow > 1 ? sh.getRange(2, 1, lastRow - 1, 9).getValues() : [];
    var idxPerSku = {};
    vals.forEach(function (r, i) { var k = String(r[0] || '').trim(); if (k && !idxPerSku.hasOwnProperty(k)) idxPerSku[k] = i; });
    var tidakAda = [], diubah = 0, kategoriDipakai = {};
    // PENGAMAN HARGA (dicek DI DALAM lock terhadap nilai terkini di sheet): kalau HPP atau Harga
    // Default berubah dan hasil akhirnya HPP >= Harga Jual -> SELURUH simpan ditolak (tidak ada yang tertulis).
    var tolakHarga = [];
    bersih.forEach(function (b) {
      if (!idxPerSku.hasOwnProperty(b.sku)) return;
      var rLama = vals[idxPerSku[b.sku]];
      if (b.hpp !== (parseFloat(rLama[3]) || 0) || b.harga !== (parseFloat(rLama[2]) || 0)) {
        var pesan = katPesanHppMelebihiHarga_(b.sku, b.hpp, b.harga);
        if (pesan) tolakHarga.push({ baris: b.no, pesan: pesan });
      }
    });
    if (tolakHarga.length) { result.errorPerBaris = tolakHarga; throw new Error(tolakHarga.length === 1 ? tolakHarga[0].pesan : tolakHarga.length + ' produk ditolak: Harga Modal >= Harga Jual (ditandai merah). Tidak ada yang disimpan.'); }
    bersih.forEach(function (b) {
      if (!idxPerSku.hasOwnProperty(b.sku)) { tidakAda.push(b.sku); return; }
      var r = vals[idxPerSku[b.sku]];
      r[1] = b.nama; r[2] = b.harga; r[3] = b.hpp; r[7] = b.kategori;
      if (b.urlFoto !== null) r[8] = b.urlFoto;
      if (b.kategori) kategoriDipakai[b.kategori.toLowerCase()] = b.kategori;
      diubah++;
    });
    if (diubah) {
      sh.getRange(2, 2, vals.length, 3).setValues(vals.map(function (r) { return [r[1], r[2], r[3]]; }));
      sh.getRange(2, 8, vals.length, 2).setValues(vals.map(function (r) { return [r[7], r[8]]; }));
    }

    // 2) Kategori baru (1x baca, maks 1x tulis) - pola sama dengan Tambah Produk Massal
    var kategoriBaru = [];
    var namaKat = Object.keys(kategoriDipakai);
    if (namaKat.length) {
      var lastRowKat = shKat.getLastRow(), katAda = {};
      if (lastRowKat > 1) shKat.getRange(2, 1, lastRowKat - 1, 1).getValues().forEach(function (r) { katAda[String(r[0]).trim().toLowerCase()] = true; });
      namaKat.forEach(function (k) { if (!katAda[k]) kategoriBaru.push([kategoriDipakai[k], '']); });
      if (kategoriBaru.length) shKat.getRange(lastRowKat + 1, 1, kategoriBaru.length, 2).setValues(kategoriBaru);
    }

    // 3) SKU Terhubung: tulis ulang tiap sheet link maksimal 1x
    var peringatan = [];
    var targetSupp = {}, targetMarket = {};
    bersih.forEach(function (b) {
      if (!idxPerSku.hasOwnProperty(b.sku)) return;
      if (b.supplier) targetSupp[b.sku] = b.supplier;
      if (b.market) targetMarket[b.sku] = b.market;
    });
    var jumlahLink = { supplierTambah: 0, supplierHapus: 0, marketTambah: 0, marketHapus: 0 };
    var petaArsipLink = katPetaArsip_(data.toko);
    if (Object.keys(targetSupp).length) {
      var infoS = katBacaLink_(shSupp, 5);
      var r1 = katTerapkanTargetLink_(infoS, targetSupp, false, peringatan, petaArsipLink);
      katTulisUlangLink_(infoS, r1.vals);
      jumlahLink.supplierTambah = r1.tambah; jumlahLink.supplierHapus = r1.hapus;
    }
    if (Object.keys(targetMarket).length) {
      var infoM = katBacaLink_(shMarket, 4);
      var r2 = katTerapkanTargetLink_(infoM, targetMarket, true, peringatan, petaArsipLink);
      katTulisUlangLink_(infoM, r2.vals);
      jumlahLink.marketTambah = r2.tambah; jumlahLink.marketHapus = r2.hapus;
    }

    result.success = true;
    result.jumlahDiubah = diubah;
    result.tidakDitemukan = tidakAda;
    result.kategoriBaru = kategoriBaru.map(function (k) { return k[0]; });
    result.link = jumlahLink;
    result.peringatan = peringatan;
  } catch (err) {
    result.error = String(err && err.message || err);
  } finally { if (lock) lepasKunci_(lock); }
  if (result.success) katInvalidasiCacheKatalog_(data.toko);
  return result;
}

// Terapkan daftar target SKU terhubung per SKU Jual ke isi sheet link (di memori).
// - Kode yang tidak ada lagi di target -> dibuang dari selnya (baris dihapus kalau jadi kosong)
// - Kode baru -> baris baru. Kode yang sudah dipakai SKU Jual LAIN -> dilewati + peringatan
function katTerapkanTargetLink_(info, target, isMarket, peringatan, petaArsip) {
  var tambah = 0, hapus = 0;
  var sudahAdaPerSku = {};
  var valsBaru = [];
  petaArsip = petaArsip || {};
  // Kode yang diminta produk aktif tapi masih "dimiliki" produk ARSIP -> diambil alih (dilepas dari arsip)
  var diambilAlih = {};
  Object.keys(target).forEach(function (skuJual) {
    target[skuJual].forEach(function (t) {
      var kode = isMarket ? t.sku : t;
      var pemilik = info.pemilik[kode];
      if (pemilik && pemilik !== skuJual && petaArsip[pemilik]) { diambilAlih[kode] = pemilik; delete info.pemilik[kode]; }
    });
  });
  info.vals.forEach(function (r) {
    var skuJual = String(r[0] || '').trim();
    if (skuJual && petaArsip[skuJual] && !target.hasOwnProperty(skuJual)) {
      var kodeArsip = katPecahKode_(r[1]);
      var sisaArsip = kodeArsip.filter(function (k) { return diambilAlih[k] !== skuJual; });
      if (sisaArsip.length !== kodeArsip.length) {
        if (!sisaArsip.length) return; // semua kodenya diambil alih -> baris link arsip dibuang
        var salinArsip = r.slice(); salinArsip[1] = sisaArsip.join(' '); valsBaru.push(salinArsip); return;
      }
    }
    if (!skuJual || !target.hasOwnProperty(skuJual)) { valsBaru.push(r); return; }
    var kodeTarget = target[skuJual].map(function (t) { return isMarket ? t.sku : t; });
    var kodeLama = katPecahKode_(r[1]);
    var sisa = kodeLama.filter(function (k) { return kodeTarget.indexOf(k) !== -1; });
    hapus += kodeLama.length - sisa.length;
    var ada = sudahAdaPerSku[skuJual] = sudahAdaPerSku[skuJual] || {};
    sisa = sisa.filter(function (k) { if (ada[k]) return false; ada[k] = true; return true; });
    if (!sisa.length) return; // baris jadi kosong -> dihapus
    var salin = r.slice();
    salin[1] = sisa.join(' ');
    valsBaru.push(salin);
  });
  Object.keys(target).forEach(function (skuJual) {
    var ada = sudahAdaPerSku[skuJual] = sudahAdaPerSku[skuJual] || {};
    target[skuJual].forEach(function (t) {
      var kode = isMarket ? t.sku : t;
      if (!kode || ada[kode]) return;
      var pemilikLain = info.pemilik[kode];
      if (pemilikLain && pemilikLain !== skuJual) { peringatan.push('"' + kode + '" sudah terhubung ke ' + pemilikLain + ' - dilewati (untuk ' + skuJual + ')'); return; }
      ada[kode] = true;
      var baris = [];
      for (var i = 0; i < info.lebar; i++) baris.push('');
      baris[0] = skuJual; baris[1] = kode;
      if (isMarket) { baris[2] = t.platform || 'TikTok Shop'; baris[3] = 'Edit Massal'; }
      else { baris[4] = 'Edit Massal'; }
      valsBaru.push(baris);
      tambah++;
    });
  });
  return { vals: valsBaru, tambah: tambah, hapus: hapus };
}

/* ---------- GABUNG (merge) SKU tak bertuan ke produk master tujuan ----------
   pasangan: [{ dari: SKU yang digabung (baris master-nya diarsip & dihapus), ke: SKU tujuan }]
   Dipanggil SAAT LOCK SUDAH DIPEGANG pemanggil. */
function katGabungSku_(pasangan, namaStaff, toko) {
  var hasil = { digabung: [], dilewati: [] };
  if (!pasangan.length) return hasil;
  var sh = getMasterProdukSheet(toko);
  var lastRow = sh.getLastRow(), lastCol = sh.getLastColumn();
  if (lastRow < 2) return hasil;
  var vals = sh.getRange(2, 1, lastRow - 1, lastCol).getValues();
  var idxPerSku = {};
  vals.forEach(function (r, i) { var k = String(r[0] || '').trim(); if (k && !idxPerSku.hasOwnProperty(k)) idxPerSku[k] = i; });

  var dariSet = {}, barisHapus = [], arsip = [], petaPindah = {}; // barisHapus: hanya penanda jumlah (tidak ada lagi deleteRow)
  // Semua nilai yang dibutuhkan disiapkan SEBELUM penulisan pertama -> tidak ada kegagalan di tengah jalan
  var cap = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm');
  var blokStatus = sh.getRange(2, KAT_KOL_STATUS, lastRow - 1, 2).getValues();
  pasangan.forEach(function (p) {
    if (!idxPerSku.hasOwnProperty(p.dari)) { hasil.dilewati.push({ sku: p.dari, alasan: 'Tidak ada di Produk Master' }); return; }
    if (!idxPerSku.hasOwnProperty(p.ke)) { hasil.dilewati.push({ sku: p.dari, alasan: 'Produk tujuan ' + p.ke + ' tidak ada' }); return; }
    if (p.dari === p.ke || dariSet[p.dari]) return;
    if (dariSet[p.ke]) { hasil.dilewati.push({ sku: p.dari, alasan: 'Tujuan ' + p.ke + ' sendiri sedang digabung - jalankan Sapu Bersih sekali lagi' }); return; }
    var r = vals[idxPerSku[p.dari]];
    if (String(r[22] || '').trim()) { hasil.dilewati.push({ sku: p.dari, alasan: 'Bagian dari grup varian - gabungkan manual' }); return; }
    if (katApakahArsip_(r[KAT_KOL_STATUS - 1])) { hasil.dilewati.push({ sku: p.dari, alasan: 'Sudah diarsipkan sebelumnya' }); return; }
    if (katApakahArsip_(vals[idxPerSku[p.ke]][KAT_KOL_STATUS - 1])) { hasil.dilewati.push({ sku: p.dari, alasan: 'Produk tujuan ' + p.ke + ' sedang diarsipkan' }); return; }
    dariSet[p.dari] = true;
    petaPindah[p.dari] = p.ke;
    barisHapus.push(idxPerSku[p.dari] + 2);
    arsip.push([new Date(), p.dari, p.ke, String(r[1] || ''), namaStaff || 'Sistem', JSON.stringify(r)]);
    hasil.digabung.push({ sku: p.dari, ke: p.ke, nama: String(r[1] || '') });
  });
  if (!barisHapus.length) return hasil;

  // 1) Arsip dulu (1x setValues)
  var shArsip = getArsipMergeProdukSheet();
  shArsip.getRange(shArsip.getLastRow() + 1, 1, arsip.length, 6).setValues(arsip);

  // 2) Pindahkan kepemilikan link: kolom "SKU Jual" = dari -> ke (1x setValues per sheet)
  [getSkuSupplierTerhubungSheet(), getSkuMarketplaceTerhubungSheet()].forEach(function (shLink) {
    var lr = shLink.getLastRow();
    if (lr < 2) return;
    var kolA = shLink.getRange(2, 1, lr - 1, 1).getValues();
    var berubah = false;
    kolA.forEach(function (r) { var k = String(r[0] || '').trim(); if (petaPindah[k]) { r[0] = petaPindah[k]; berubah = true; } });
    if (berubah) shLink.getRange(2, 1, kolA.length, 1).setValues(kolA);
  });

  // 3) SOFT DELETE (Level 1): baris master TIDAK dihapus - ditandai "Arsip" + info tujuan gabung.
  //    Nomor baris produk lain tidak bergeser, histori stok/penjualan tetap punya induk.
  hasil.digabung.forEach(function (d) {
    var i = idxPerSku[d.sku];
    blokStatus[i][0] = KAT_STATUS_ARSIP;
    blokStatus[i][1] = 'Digabung ke ' + d.ke + ' - ' + cap + ' oleh ' + (namaStaff || 'Sistem');
  });
  sh.getRange(2, KAT_KOL_STATUS, blokStatus.length, 2).setValues(blokStatus);
  KAT_MEMO_ARSIP_ = null;
  return hasil;
}

/* ---------- HUBUNGKAN SKU: jadikan skuSumber sebagai SKU Terhubung milik skuTujuan ---------- */
function prosesKatalogHubungkanSku(data) {
  var result = { success: false };
  var lock = null;
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var dari = katBersihkanSku_(data.skuSumber);
    var ke = String(data.skuTujuan || '').trim();
    var jenis = data.jenis === 'supplier' ? 'supplier' : 'marketplace';
    var platform = String(data.platform || 'TikTok Shop').trim();
    if (!dari || !ke) throw new Error('SKU sumber & tujuan wajib diisi.');
    if (dari === ke) throw new Error('Tidak bisa menghubungkan SKU ke dirinya sendiri.');

    lock = kunciModul_('katalog');
    try { lock.waitLock(20000); } catch (eLock) { lock = null; throw new Error('Server sedang sibuk, coba lagi.'); }

    var shMaster = getMasterProdukSheet(data.toko);
    var lr = shMaster.getLastRow();
    var skuMaster = {};
    if (lr > 1) shMaster.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r) { skuMaster[String(r[0] || '').trim()] = true; });
    if (!skuMaster[ke]) throw new Error('Produk tujuan "' + ke + '" tidak ada di Produk Master.');
    KAT_MEMO_ARSIP_ = null;
    var petaArsipHub = katPetaArsip_(data.toko);
    if (petaArsipHub[ke]) throw new Error('Produk tujuan "' + ke + '" sedang diarsipkan - pulihkan dulu atau pilih produk lain.');

    // 1) Tambah link (tolak kalau kode sudah dipakai produk lain)
    var info = katBacaLink_(jenis === 'supplier' ? getSkuSupplierTerhubungSheet() : getSkuMarketplaceTerhubungSheet(), jenis === 'supplier' ? 5 : 4);
    var pemilik = info.pemilik[dari];
    if (pemilik && pemilik !== ke && pemilik !== dari && petaArsipHub[pemilik]) {
      // Pemilik lama sudah diarsipkan -> kode diambil alih: buang dari baris link produk arsip itu
      var lepas = false;
      info.vals.forEach(function (r, i) {
        if (String(r[0] || '').trim() !== pemilik) return;
        var sisaKode = katPecahKode_(r[1]).filter(function (k) { return k !== dari; });
        if (sisaKode.length === katPecahKode_(r[1]).length) return;
        if (sisaKode.length) info.sh.getRange(i + 2, 2).setValue(sisaKode.join(' '));
        else info.sh.getRange(i + 2, 1, 1, info.lebar).clearContent(); // baris link kosong -> diabaikan semua pembaca
        lepas = true;
      });
      if (lepas) pemilik = null;
    }
    if (pemilik && pemilik !== ke && pemilik !== dari) throw new Error('"' + dari + '" sudah terhubung ke produk ' + pemilik + '.');
    if (pemilik !== ke) {
      var baris = jenis === 'supplier' ? [ke, dari, '', '', 'Hubungkan SKU'] : [ke, dari, platform, 'Hubungkan SKU'];
      while (baris.length < info.lebar) baris.push('');
      info.sh.getRange(info.lastRow + 1, 1, 1, info.lebar).setValues([baris.slice(0, info.lebar)]);
    }

    // 2) Auto-gabung: kalau SKU sumber punya baris sendiri di Produk Master -> arsip + hapus, link-nya pindah ke tujuan
    var gabung = { digabung: [], dilewati: [] };
    if (skuMaster[dari]) gabung = katGabungSku_([{ dari: dari, ke: ke }], getNamaStaff(data.email), data.toko);

    result.success = true;
    result.skuSumber = dari;
    result.skuTujuan = ke;
    result.jenis = jenis;
    result.platform = platform;
    result.digabung = gabung.digabung.length > 0;
    result.dilewati = gabung.dilewati;
  } catch (err) {
    result.error = err.toString();
  } finally { if (lock) lepasKunci_(lock); }
  if (result.success) katInvalidasiCacheKatalog_(data.toko);
  return result;
}

/* ---------- SAPU BERSIH: pindai & gabungkan SKU tak bertuan ----------
   Kandidat = baris Produk Master (S) yang kode SKU-nya IDENTIK (persis, tanpa beda huruf)
   dengan SKU Terhubung (Supplier / Marketplace) milik TEPAT SATU produk master lain (T).
   data.eksekusi = false -> hanya pratinjau; true -> gabungkan. */
function prosesKatalogSapuBersihSku(data) {
  var result = { success: false };
  var lock = null;
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var pindai = function () {
      var sh = getMasterProdukSheet(data.toko);
      var lr = sh.getLastRow();
      var master = {}, urut = [];
      if (lr > 1) sh.getRange(2, 1, lr - 1, KAT_KOL_STATUS).getValues().forEach(function (r) {
        var k = String(r[0] || '').trim();
        if (!k || master[k]) return;
        if (katApakahArsip_(r[KAT_KOL_STATUS - 1])) return; // sudah diarsip/digabung - bukan kandidat & bukan tujuan
        master[k] = { nama: String(r[1] || ''), varian: String(r[22] || '').trim() };
        urut.push(k);
      });
      var pemilik = {}; // kode -> { skuJual: jenis }
      [[getSkuSupplierTerhubungSheet(), 5, 'Supplier'], [getSkuMarketplaceTerhubungSheet(), 4, 'Marketplace']].forEach(function (x) {
        katBacaLink_(x[0], x[1]).vals.forEach(function (r) {
          var skuJual = String(r[0] || '').trim();
          if (!skuJual) return;
          var label = x[2] === 'Marketplace' ? 'Marketplace' + (r[2] ? ' (' + String(r[2]).trim() + ')' : '') : 'Supplier';
          katPecahKode_(r[1]).forEach(function (k) {
            if (k === skuJual) return; // link ke diri sendiri bukan tanda duplikat
            pemilik[k] = pemilik[k] || {};
            pemilik[k][skuJual] = label;
          });
        });
      });
      var kandidat = [], ambigu = [];
      urut.forEach(function (s) {
        var own = pemilik[s];
        if (!own) return;
        var tujuan = Object.keys(own).filter(function (t) { return master[t]; });
        if (!tujuan.length) return;
        if (tujuan.length > 1) { ambigu.push({ sku: s, nama: master[s].nama, alasan: 'Terhubung ke beberapa produk: ' + tujuan.join(', ') }); return; }
        if (master[s].varian) { ambigu.push({ sku: s, nama: master[s].nama, alasan: 'Bagian dari grup varian' }); return; }
        kandidat.push({ dari: s, namaDari: master[s].nama, ke: tujuan[0], namaKe: master[tujuan[0]].nama, via: own[tujuan[0]] });
      });
      // Rantai (tujuan juga kandidat) -> tunda ke putaran berikutnya
      var dariSet = {};
      kandidat.forEach(function (k) { dariSet[k.dari] = true; });
      var aman = kandidat.filter(function (k) {
        if (dariSet[k.ke]) { ambigu.push({ sku: k.dari, nama: k.namaDari, alasan: 'Tujuan ' + k.ke + ' juga akan digabung - jalankan sekali lagi' }); return false; }
        return true;
      });
      return { kandidat: aman, ambigu: ambigu };
    };

    if (!data.eksekusi) {
      var pratinjau = pindai();
      result.success = true;
      result.kandidat = pratinjau.kandidat;
      result.ambigu = pratinjau.ambigu;
      return result;
    }

    lock = kunciModul_('katalog');
    try { lock.waitLock(30000); } catch (eLock) { lock = null; throw new Error('Server sedang sibuk, coba lagi.'); }
    var scan = pindai(); // pindai ulang DI DALAM lock - data mungkin berubah sejak pratinjau
    var gabung = katGabungSku_(scan.kandidat.map(function (k) { return { dari: k.dari, ke: k.ke }; }), getNamaStaff(data.email), data.toko);
    result.success = true;
    result.digabung = gabung.digabung;
    result.dilewati = gabung.dilewati.concat(scan.ambigu);
  } catch (err) {
    result.error = err.toString();
  } finally { if (lock) lepasKunci_(lock); }
  if (result.success && data.eksekusi && result.digabung && result.digabung.length) katInvalidasiCacheKatalog_(data.toko);
  return result;
}


/* ####################################################################################
   LEVEL 1 "MAKE IT WORK" - FONDASI DATA KATALOG
   1) LockService + pencarian baris DINAMIS di dalam lock untuk semua penulis Katalog
   2) Soft Delete Produk Master (kolom 30 "Status Produk" = Arsip) + hapus Kategori berkaskade
   3) Validasi URL foto (tolak data:/blob:, wajib https://) + batas ukuran upload
   4) Pengaman harga: HPP baru >= Harga Jual Default -> penyimpanan DITOLAK
   #################################################################################### */
var KAT_KOL_STATUS = 30;        // "Status Produk": kosong / Aktif = aktif, "Arsip" = diarsipkan
var KAT_KOL_INFO_ARSIP = 31;    // "Info Arsip": siapa, kapan, alasan (mis. "Digabung ke SKU X")
var KAT_STATUS_ARSIP = 'Arsip';
var KAT_LOCK_TIMEOUT_MS = 20000;
var KAT_MAKS_FOTO_BYTES = 10 * 1024 * 1024; // 10 MB per foto
// Kalau Harga Jual Default masih 0 (belum diset), HPP boleh disimpan? false = boleh (harga belum
// diset bukan harga jual; menu Harga sudah menandai "⚠️ Rp 0"). Ganti ke true untuk ikut menolak.
var KAT_TOLAK_HPP_JIKA_HARGA_KOSONG = false;

/* ---------- 1) LOCK ---------- */
// Kedalaman lock dalam 1 eksekusi: fungsi terkunci yang memanggil fungsi terkunci lain tidak
// mengambil lock kedua kali (mencegah deadlock menunggu dirinya sendiri).
var KAT_LOCK_DALAM_ = 0;

function katDenganLock_(fn, timeoutMs) {
  if (KAT_LOCK_DALAM_ > 0) return fn();
  var lock = kunciModul_('katalog');
  if (!lock.tryLock(timeoutMs || KAT_LOCK_TIMEOUT_MS)) throw new Error('KAT_LOCK_SIBUK');
  KAT_LOCK_DALAM_++;
  try { return fn(); }
  finally { KAT_LOCK_DALAM_--; lepasKunci_(lock); }
}

// Pembungkus aksi doPost: SELURUH fungsi inti (termasuk pencarian barisnya) jalan di dalam lock.
function katJalankanTerkunci_(fnInti, data) {
  try {
    var hasil = katDenganLock_(function () { return fnInti(data); });
    // Rapikan pesan: "Error: Gagal: ..." -> "Gagal: ..." (supaya UI tidak menampilkan "Error:" dobel)
    if (hasil && typeof hasil.error === 'string') hasil.error = hasil.error.replace(/^Error:\s*/, '');
    return hasil;
  }
  catch (e) {
    if (String(e && e.message) === 'KAT_LOCK_SIBUK') {
      return { success: false, error: 'Sistem sedang sibuk memproses penyimpanan lain. Tunggu beberapa detik lalu coba lagi - belum ada data yang berubah.' };
    }
    return { success: false, error: String(e) };
  }
}

// Cari nomor baris SKU secara dinamis (dipanggil DI DALAM lock). -1 = tidak ada.
function katCariBarisSku_(sh, sku) {
  var target = String(sku || '').trim();
  var lastRow = sh.getLastRow();
  if (!target || lastRow < 2) return -1;
  var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
  for (var i = 0; i < vals.length; i++) if (String(vals[i][0]).trim() === target) return i + 2;
  return -1;
}

// Untuk fungsi yang punya proses LAMBAT (AI / ambil halaman supplier / upload Drive): proses lambatnya
// jalan TANPA lock, lalu penulisan akhirnya lewat sini -> lock singkat, cari ulang baris, tulis.
function katTulisDiBarisSku_(sh, sku, fnTulis) {
  return katDenganLock_(function () {
    var row = katCariBarisSku_(sh, sku);
    if (row === -1) throw new Error('Produk "' + sku + '" tidak ditemukan lagi (mungkin baru saja diubah SKU-nya oleh admin lain). Muat ulang halaman lalu coba lagi.');
    fnTulis(row);
    return row;
  });
}

