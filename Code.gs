    var lama = String(data.skuLama || '').trim().toUpperCase();
    var adaKode = daftar.filter(function (b) { return b.sku.toUpperCase() === kode; })[0];
    if (adaKode && adaKode.sku.toUpperCase() !== lama && !data.timpa) throw new Error('Kode ' + kode + ' sudah dipakai bundling "' + (adaKode.nama || adaKode.sku) + '".');
    var m = master[kode];
    if (m && !m.arsip && !data.ubahDariMaster) throw new Error('Kode ' + kode + ' adalah produk di Produk Master. Centang "ubah jadi bundling" bila memang kode bundling, atau ganti kodenya.');
    var nama = String(data.nama || '').trim() || isi.map(function (x) { var mm = master[x.sku.toUpperCase()]; return (x.qty > 1 ? x.qty + 'x ' : '') + (mm ? mm.nama : x.sku); }).join(' + ');
    var teks = isi.map(function (x) { return x.sku + (x.qty > 1 ? '*' + x.qty : ''); }).join(', ');
    var baris = [kode, teks, nama, new Date()];
    var barisLama = lama ? daftar.filter(function (b) { return b.sku.toUpperCase() === lama; })[0] : null;
    var target = adaKode || barisLama;
    if (target) bdl.getRange(target.row, 1, 1, 4).setValues([baris]);
    else { var r = bdl.getLastRow() + 1; bdl.getRange(r, 1, 1, 2).setNumberFormat('@'); bdl.getRange(r, 1, 1, 4).setValues([baris]); }
    if (barisLama && adaKode && barisLama.row !== adaKode.row) bdl.deleteRow(barisLama.row);
    CACHE_BUNDLING_ = null;
    result.diarsipkan = false;
    if (m && !m.arsip && data.ubahDariMaster) {
      katUbahStatusArsip_([m.sku], true, 'Diubah jadi SKU Bundling - stok dipotong dari isi: ' + teks, getNamaStaff(data.email), data.toko);
      katInvalidasiCacheKatalog_(data.toko);
      result.diarsipkan = true;
    }
    result.success = true; result.sku = kode; result.nama = nama;
  } catch (err) { result.error = err.message || String(err); }
  return result;
}

/* ---------- AKSI: bundling_hapus { skuBundle } - hanya daftar bundling (produk isi tidak berubah) ---------- */
function prosesBundlingHapus(data) { return katJalankanTerkunci_(prosesBundlingHapus_inti_, data); }
function prosesBundlingHapus_inti_(data) {
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var k = String(data.skuBundle || '').trim().toUpperCase();
    var b = bdlBacaSheet_().filter(function (x) { return x.sku.toUpperCase() === k; })[0];
