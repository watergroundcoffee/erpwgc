// Simpan pemetaan SKU (Supplier + Marketplace) SEKALIGUS dalam 1 klik - model "local state
// di frontend, sync sekali pas Simpan". REPLACE-ALL: hapus semua baris lama punya SKU Jual
// ini, ganti total sama daftar yang dikirim dari form (baik yang ditambah maupun dihapus di
// sisi frontend udah kebawa otomatis lewat daftar final ini).
function prosesSimpanPemetaanSku_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuJual = String(data.skuJual || '').trim();
    if (!skuJual) throw new Error('SKU Jual kosong');

    var shSupp = getSkuSupplierTerhubungSheet();
    hapusSemuaBarisUntukSkuJual(shSupp, skuJual);
    // URUTAN DIPERTAHANKAN: baris dikirim sesuai urutan di layar (hasil drag & drop) -> baris pertama = SKU Utama.
    var barisSupp = [];
    (data.daftarSkuSupplier || []).forEach(function (item) {
      // Terima 2 bentuk: string polos (kompatibel sama pemanggil lama) atau objek {sku, namaSupplier, url, hargaModal}.
      var skuBersih, namaSupplierBersih, urlBersih = '', hargaModal = '';
      if (item && typeof item === 'object') {
        skuBersih = String(item.sku || '').trim();
        namaSupplierBersih = String(item.namaSupplier || '').trim();
        urlBersih = String(item.url || '').trim().slice(0, 2000);
        if (urlBersih && !/^https?:\/\//i.test(urlBersih)) urlBersih = 'https://' + urlBersih;
        var h = parseFloat(item.hargaModal !== undefined ? item.hargaModal : item.harga);
        hargaModal = (h > 0) ? Math.round(h * 100) / 100 : '';
      } else {
        skuBersih = String(item || '').trim();
        namaSupplierBersih = '';
      }
      if (skuBersih) barisSupp.push([skuJual, skuBersih, namaSupplierBersih, hargaModal, '', urlBersih]);
    });
    if (barisSupp.length) shSupp.getRange(shSupp.getLastRow() + 1, 1, barisSupp.length, 6).setValues(barisSupp);

    var shMarket = getSkuMarketplaceTerhubungSheet();
    hapusSemuaBarisUntukSkuJual(shMarket, skuJual);
    var barisMarket = [];
    (data.daftarMarketplace || []).forEach(function (m) {
      var skuBersih = String((m && m.sku) || '').trim();
      if (skuBersih) barisMarket.push([skuJual, skuBersih, String((m && m.platform) || '').trim(), '']);
    });
    if (barisMarket.length) shMarket.getRange(shMarket.getLastRow() + 1, 1, barisMarket.length, 4).setValues(barisMarket);

    // SKU Utama -> Master Produk: Harga Supplier (Harga Modal, kolom 4) & URL Supplier (kolom 5) ikut SKU Utama,
    // sehingga Katalog > Harga, HPP & laporan memakai acuan yang sama.
    var utama = barisSupp[0];
    if (utama && (utama[3] !== '' || utama[5])) {
      try {
        var shMaster = getMasterProdukSheet(data.toko);
        var rowMaster = katCariBarisSku_(shMaster, skuJual);
        if (rowMaster > 0) {
          if (utama[3] !== '') shMaster.getRange(rowMaster, 4).setValue(utama[3]);
          if (utama[5]) shMaster.getRange(rowMaster, 5).setValue(utama[5]);
          result.masterDiselaraskan = true;
        }
      } catch (eMaster) { result.peringatan = 'Pemetaan tersimpan, tapi Master Produk belum terselaraskan: ' + eMaster; }
    }
    invalidasiCacheKatalogHarga(data.toko);

    result.success = true;
    result.skuUtama = utama ? { sku: utama[1], hargaModal: utama[3] === '' ? 0 : utama[3], url: utama[5] } : null;
  } catch (err) { result.error = err.toString(); }
  return result;
}

