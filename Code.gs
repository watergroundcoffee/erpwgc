function prosesReturHapusMedia(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiMasuk')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noResi = String(data.noResi || '').trim();
    if (!noResi) throw new Error('No Resi kosong');
    var jenis = data.jenis === 'video' ? 'video' : 'foto', idx = parseInt(data.i, 10);
    var lock = kunciModul_('pengiriman');
    lock.waitLock(20000);
    try {
      var sh = getReturDetailSheet_(), d = returBacaDetail_()[kunciResi_(noResi)];
      if (!d) throw new Error('Data resi ini tidak ditemukan - muat ulang halaman.');
      var daftar = jenis === 'video' ? d.video : d.foto;
      var cocok = function (m) { return m && (!data.nama || String(m.nama || '') === String(data.nama)) && (!data.id || String(m.id || m.url || '') === String(data.id)); };
      if (!(idx >= 0 && idx < daftar.length && cocok(daftar[idx]))) {
        idx = -1;
        for (var i = 0; i < daftar.length; i++) if (cocok(daftar[i])) { idx = i; break; }
      }
      if (idx < 0) throw new Error('File ini sudah tidak ada di daftar (mungkin sudah dihapus) - muat ulang.');
      var hapus = daftar.splice(idx, 1)[0];
      sh.getRange(d.row, jenis === 'video' ? 7 : 6).setValue(JSON.stringify(daftar));
      sh.getRange(d.row, 8, 1, 2).setValues([[new Date(), getNamaStaff(data.email) || data.email || '']]);
      result.success = true; result.dihapus = hapus ? String(hapus.nama || '') : ''; result.sisa = daftar;
    } finally { lepasKunci_(lock); }
  } catch (err) { result.error = err.message || String(err); }
  return result;
}

