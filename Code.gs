        var dibayar = lebar >= 13 && finRembesDibayar_(r[12]);
        var tgl = finTglStr_(d, tz);
        p.total += jml; p.n++;
        if (dibayar) p.sudah += jml; else { p.belum += jml; p.nBelum++; }
        if (tgl > p.terakhir) p.terakhir = tgl;
        var info = finInfoKategori_(finAkunNormal_(r[1]));
        p.item.push({
          row: i + 2, tanggal: tgl, tanggalLabel: Utilities.formatDate(d, tz, 'dd MMM yyyy'), label: info.label, ikon: info.ikon,
          jumlah: jml, keterangan: String(r[5] || '').slice(0, 120), noNota: lebar >= 10 ? String(r[9] || '').trim() : '',
          merchant: lebar >= 14 ? String(r[13] || '').trim() : '', dibayar: dibayar, status: lebar >= 13 ? String(r[12] || '').trim() : ''
        });
      });
    }
    var daftar = Object.keys(per).map(function (k) {
