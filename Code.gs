// FAILSAFE MUTLAK (lapis 2, back-end): dipanggil SEBELUM Harga Jual Final ditulis ke sheet
// ataupun dikirim ke API marketplace. Kosong / NaN / Infinity / <= 0 -> throw, proses di-abort.
function assertHargaJualFinalValid(harga, label) {
  var teks = (harga === null || harga === undefined) ? '' : String(harga).trim();
  var n = Number(teks);
  // Cek SETELAH dibulatkan juga - 0.4 dibulatkan jadi 0, itu tetap harus ditolak.
  if (teks === '' || isNaN(n) || !isFinite(n) || n <= 0 || Math.round(n) <= 0) {
    throw new Error('DITOLAK: Harga Jual Final ' + (label || '') + ' harus lebih dari Rp 0 (nilai diterima: "' + teks + '"). Proses dibatalkan, tidak ada data yang disimpan/dikirim.');
  }
  return Math.round(n);
}

// Simpan perubahan dari Tabel Harga Jual. data.items = [{ sku, hpp?, marginCustom?, hargaDefault?,
// hargaShopee?, hargaTiktok?, hargaCoretShopee?, hargaCoretTiktok? }] - hanya field yang BERUBAH.
// SEMUA item divalidasi DULU; kalau ada 1 saja yang invalid, SELURUH batch di-abort (all-or-nothing).
//
// PERBAIKAN TIMEOUT LOCK: versi lama menulis dengan setValue() PER SEL di dalam loop (N produk x
// sampai 7 kolom = ratusan-ribuan panggilan API Spreadsheet) SAMBIL memegang ScriptLock. Satu simpan
// massal bisa menahan lock puluhan detik; request berikutnya (retry otomatis postJson / batch ke-2 /
// aksi lain) menunggu waitLock(20000) lalu gagal "Batas waktu penguncian habis".
// Sekarang: validasi di luar lock -> di dalam lock cukup 1x getValues + 1x getFormulas + 1x setValues.
var HJF_KOLOM_AWAL = 3;   // kolom pertama yang mungkin ditulis (Harga Default)
var HJF_KOLOM_AKHIR = 29; // kolom terakhir (Harga Coret TikTok Shop)
var HJF_PETA_KOLOM = {    // field payload -> nomor kolom Master Produk
  hargaDefault: 3, hpp: 4, hargaShopee: 7, marginCustom: 16, hargaTiktok: 25, hargaCoretShopee: 28, hargaCoretTiktok: 29
};

function prosesSimpanHargaJualFinal(data) {
  var result = { success: false };
  var lock = null;
  var tahap = 'validasi';
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var items = Array.isArray(data.items) ? data.items : [];
    if (items.length === 0) throw new Error('Tidak ada perubahan untuk disimpan.');
    if (items.length > 3000) throw new Error('Maksimal 3000 produk per sekali simpan.');

    // --- Tahap 1: validasi menyeluruh di MEMORY (tanpa lock, tanpa menyentuh sheet) ---
    var perSku = {};
    items.forEach(function (it) {
      var sku = String((it && it.sku) || '').trim();
      if (!sku) throw new Error('DITOLAK: ada baris tanpa SKU.');
      var out = perSku[sku] || { sku: sku }; // SKU dobel di payload digabung (yang terakhir menang)
      if (it.hpp !== undefined) {
        var hpp = Number(it.hpp);
        if (it.hpp === '' || it.hpp === null || isNaN(hpp) || !isFinite(hpp) || Math.round(hpp) <= 0) {
          throw new Error('DITOLAK: HPP ' + sku + ' harus lebih dari Rp 0.');
        }
        out.hpp = Math.round(hpp);
      }
      if (it.marginCustom !== undefined) {
        if (it.marginCustom === '' || it.marginCustom === null) out.marginCustom = '';
        else {
          var m = Number(it.marginCustom);
          if (isNaN(m) || !isFinite(m) || m < 0 || m >= 100) throw new Error('DITOLAK: Target Margin ' + sku + ' harus 0 sampai kurang dari 100%.');
          out.marginCustom = Math.round(m * 100) / 100;
        }
      }
      if (it.hargaDefault !== undefined) out.hargaDefault = assertHargaJualFinalValid(it.hargaDefault, 'Offline/Default (' + sku + ')');
      if (it.hargaShopee !== undefined) out.hargaShopee = assertHargaJualFinalValid(it.hargaShopee, 'Shopee (' + sku + ')');
      if (it.hargaTiktok !== undefined) out.hargaTiktok = assertHargaJualFinalValid(it.hargaTiktok, 'TikTok Shop (' + sku + ')');
      // Harga Coret: '' = dihapus (tidak pakai harga coret). Kalau diisi, WAJIB > 0 (angka 0 tidak boleh lolos).
      if (it.hargaCoretShopee !== undefined) out.hargaCoretShopee = (it.hargaCoretShopee === '' || it.hargaCoretShopee === null) ? '' : assertHargaJualFinalValid(it.hargaCoretShopee, 'Harga Coret Shopee (' + sku + ')');
      if (it.hargaCoretTiktok !== undefined) out.hargaCoretTiktok = (it.hargaCoretTiktok === '' || it.hargaCoretTiktok === null) ? '' : assertHargaJualFinalValid(it.hargaCoretTiktok, 'Harga Coret TikTok Shop (' + sku + ')');
      perSku[sku] = out;
    });
    var bersih = Object.keys(perSku).map(function (k) { return perSku[k]; });
    var sh = getMasterProdukSheet(data.toko); // (juga memastikan kolom 25-29 sudah ada, di luar lock)

    // --- Tahap 2: lock SINGKAT -> 1x baca, olah di memory, 1x tulis ---
    tahap = 'menunggu antrean simpan';
    lock = kunciModul_('katalog');
    try {
      lock.waitLock(30000);
    } catch (eLock) {
      lock = null; // tidak pernah dapat lock -> jangan di-release
      throw new Error('Server sedang sibuk memproses simpan lain (antrean > 30 detik). Tunggu sebentar lalu klik Simpan lagi - data aman, tidak ada yang tersimpan setengah.');
    }

    tahap = 'membaca Master Produk';
    var lastRow = sh.getLastRow();
    if (lastRow < 2) throw new Error('Master Produk masih kosong.');
    // Cari baris tiap SKU di memory (baca kolom SKU sekali)
    var kolomSku = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var mapBaris = {};
    kolomSku.forEach(function (r, i) {
      var s = String(r[0]).trim();
      if (s && mapBaris[s] === undefined) mapBaris[s] = i + 2;
    });
    var barisMin = Infinity, barisMaks = -Infinity;
    bersih.forEach(function (b) {
      var r = mapBaris[b.sku];
      if (r === undefined) throw new Error('DITOLAK: SKU ' + b.sku + ' tidak ditemukan di Master Produk.');
      if (r < barisMin) barisMin = r;
      if (r > barisMaks) barisMaks = r;
    });

    // Blok 2D yang ditulis: baris barisMin..barisMaks, kolom 3..29. Isinya = nilai lama (dibaca
    // barusan di dalam lock) - hanya sel field yang berubah yang diganti. Sel berisi RUMUS dipertahankan
    // (setValues dengan string "=..." menulis ulang rumus yang sama), jadi aman.
    var jmlBaris = barisMaks - barisMin + 1;
    var jmlKolom = HJF_KOLOM_AKHIR - HJF_KOLOM_AWAL + 1;
    var rangeTulis = sh.getRange(barisMin, HJF_KOLOM_AWAL, jmlBaris, jmlKolom);
    var blok = rangeTulis.getValues();
    var rumus = rangeTulis.getFormulas();
    for (var bi = 0; bi < jmlBaris; bi++) {
      for (var ki = 0; ki < jmlKolom; ki++) { if (rumus[bi][ki]) blok[bi][ki] = rumus[bi][ki]; }
    }
    bersih.forEach(function (b) {
      var baris = blok[mapBaris[b.sku] - barisMin];
      Object.keys(HJF_PETA_KOLOM).forEach(function (field) {
        if (b[field] !== undefined) baris[HJF_PETA_KOLOM[field] - HJF_KOLOM_AWAL] = b[field];
      });
    });

    // PENGAMAN HARGA (Level 1 #4): SKU yang HPP / Harga Default-nya diubah dicek dengan nilai AKHIR
    // (gabungan nilai baru + nilai lama di sheet). Satu saja melanggar -> seluruh simpan dibatalkan.
    tahap = 'cek HPP vs Harga Jual';
    var tolakHargaHjf = [];
    bersih.forEach(function (b) {
      if (b.hpp === undefined && b.hargaDefault === undefined) return;
      var baris = blok[mapBaris[b.sku] - barisMin];
      var pesan = katPesanHppMelebihiHarga_(b.sku, parseFloat(baris[4 - HJF_KOLOM_AWAL]) || 0, parseFloat(baris[3 - HJF_KOLOM_AWAL]) || 0);
      if (pesan) tolakHargaHjf.push(pesan);
    });
    if (tolakHargaHjf.length) {
      result.ditolakHarga = tolakHargaHjf;
      throw new Error(tolakHargaHjf.length === 1 ? tolakHargaHjf[0] : tolakHargaHjf[0] + ' (+' + (tolakHargaHjf.length - 1) + ' produk lain juga ditolak). Tidak ada yang disimpan.');
    }

    tahap = 'menulis Master Produk';
    rangeTulis.setValues(blok); // SATU-SATUNYA operasi tulis
    SpreadsheetApp.flush();

    invalidasiCacheKatalogHarga(data.toko);
    try { CacheService.getScriptCache().remove('KATALOG_PRODUK_' + (data.toko || 'default')); } catch (eCache) { /* biarin */ }
    result.success = true;
    result.tersimpan = bersih;
  } catch (err) {
    result.success = false;
    result.error = (err && err.message) ? err.message : String(err);
    result.errorDetail = detailErrorBackend_(err, 'simpan_harga_jual_final - tahap: ' + tahap);
    console.error('prosesSimpanHargaJualFinal gagal (' + tahap + '): ' + result.error);
  } finally {
    if (lock) { try { lepasKunci_(lock); } catch (eRel) { /* abaikan */ } } // SELALU dilepas
  }
  return result;
}

// GERBANG TUNGGAL push harga ke API marketplace. Fungsi push harga Shopee/TikTok APA PUN yang
// dibuat nanti WAJIB lewat sini, supaya validasi harga > 0 nggak mungkin terlewat.
// Saat ini endpoint update harga Shopee/TikTok BELUM diimplementasikan, jadi setelah lolos
// validasi fungsi ini tetap menolak dengan pesan jelas (tidak ada request yang dikirim).
function pushHargaKeMarketplace(platform, sku, harga) {
  // DIKUNCI (aturan Harga Coret): endpoint update harga dasar marketplace TIDAK BOLEH menerima Harga
  // Jual Final. Jalur sync sekarang modular: syncShopeeOnly / syncTikTokOnly (Harga Coret).
  throw new Error('DITOLAK: jalur push harga lama dinonaktifkan. Gunakan tombol "Sync Harga" (syncPriceToMarketplace) yang mengirim Harga Coret sebagai harga dasar.');
  var hargaValid = assertHargaJualFinalValid(harga, String(platform || '') + ' (' + String(sku || '') + ')');
  if (!String(sku || '').trim()) throw new Error('DITOLAK: SKU kosong.');
  if (platform !== 'Shopee' && platform !== 'TikTok Shop') throw new Error('DITOLAK: platform "' + platform + '" tidak dikenal.');
  // Saat push API sudah diimplementasikan: setelah request ke marketplace SUKSES, tulis waktu
  // sync ke kolom 27 Master Produk (Terakhir Sync Marketplace), misalnya:
  //   sh.getRange(barisSku, 27).setValue(new Date()); invalidasiCacheKatalogHargaSemuaToko();
  throw new Error('Push harga ke API ' + platform + ' belum diaktifkan. Harga Rp ' + hargaValid + ' untuk ' + sku + ' lolos validasi, tapi tidak dikirim.');
}

function prosesPushHargaMarketplace(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    result.hasil = pushHargaKeMarketplace(String(data.platform || '').trim(), String(data.sku || '').trim(), data.harga);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Tambah produk BARU dari nol ke Master Produk - sebelumnya cuma bisa EDIT produk yang udah
// ada, belum ada jalur buat bikin produk baru dari kosong lewat form.
function prosesTambahProdukBaru_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    var namaProduk = String(data.namaProduk || '').trim();
    var toko = String(data.toko || '').trim();
    if (!sku) throw new Error('SKU wajib diisi');
    if (!namaProduk) throw new Error('Nama Produk wajib diisi');

    var sh = getMasterProdukSheet(toko);
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var skuSemua = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < skuSemua.length; i++) {
        if (String(skuSemua[i][0]).trim().toLowerCase() === sku.toLowerCase()) {
          if (katPetaArsip_(toko)[String(skuSemua[i][0]).trim()]) throw new Error('SKU "' + sku + '" dipakai produk yang DIARSIPKAN. Pulihkan dari arsip (centang "Tampilkan Arsip" di Produk Master) atau pakai SKU lain.');
          throw new Error('SKU "' + sku + '" udah dipakai produk lain - pakai SKU yang beda.');
        }
      }
    }

    // Level 1: validasi foto (tolak data:/blob:) + pengaman harga (HPP < Harga Jual)
    var urlFotoAman = katValidasiUrlFoto_(data.urlFoto, 'utama');
    var galeriAman = katValidasiGaleriFoto_(data.galeriFotoTambahan);
    katCekHppVsHarga_(sku, parseFloat(data.hargaSupplier) || 0, parseFloat(data.harga) || 0);

    // Urutan kolom (1-20): SKU, Nama, Harga, HargaSupplier, URLSupplier, BatasStokMenipis,
    // HargaShopee, Kategori, URLFoto, Deskripsi, Brand, Tipe, Material, Volume, Warna,
    // MarginCustom, Toko, TampilDiWebsite, Berat, Dimensi.
    var barisBaru = [
      sku, namaProduk,
      parseFloat(data.harga) || 0, parseFloat(data.hargaSupplier) || 0,
      String(data.urlSupplier || '').trim(), String(data.batasStokMenipis || '').trim(),
      parseFloat(data.hargaShopee) || 0, String(data.kategori || '').trim(),
      urlFotoAman, String(data.deskripsi || '').trim(),
      String(data.merk || '').trim() || 'NO BRAND', String(data.tipe || '').trim(),
      String(data.material || '').trim(), String(data.volume || '').trim(),
      String(data.warna || '').trim(), data.marginCustom !== undefined && data.marginCustom !== '' ? parseFloat(data.marginCustom) : '',
      toko, data.tampilWebsite === true,
      String(data.berat || '').trim(), String(data.dimensi || '').trim(),
      JSON.stringify(data.spesifikasiTambahan || []),
      JSON.stringify(galeriAman)
    ];
    var rowTambah = sh.getLastRow() + 1;
    sh.getRange(rowTambah, 1).setNumberFormat('@'); // SKU tetap teks
    sh.getRange(rowTambah, 1, 1, barisBaru.length).setValues([barisBaru]);

    result.success = true;
    result.sku = sku;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   TAMBAH PRODUK BARU MASSAL (Bulk Add Products)
   ------------------------------------------------------------
   Front-end mengirim: { kolom: ['urlFoto','sku','nama','kategori','hpp','hargaDefault'], baris: [[...], ...] }
   (array 2D persis urutan kolom grid). Back-end memetakan ke URUTAN STANDAR Master Produk
   (29 kolom) lalu menulis SEMUA produk baru dengan SATU setValues di dalam LockService.
   Urutan kolom Master Produk:
     1 SKU | 2 Nama Produk | 3 Harga (Default) | 4 Harga Supplier (HPP) | 5 URL Supplier |
     6 Batas Stok Menipis | 7 Harga Shopee | 8 Kategori | 9 URL Foto | 10 Deskripsi |
     11 Brand | 12 Tipe | 13 Material | 14 Volume | 15 Warna | 16 Margin Custom (%) | 17 Toko |
     18 Tampil di Website | 19 Berat | 20 Dimensi | 21 Spesifikasi Tambahan | 22 Galeri Foto Tambahan |
     23 ID Varian | 24 Label Varian | 25 Harga TikTok Shop | 26 Last_Checked_URL |
     27 Terakhir Sync Marketplace | 28 Harga Coret Shopee | 29 Harga Coret TikTok Shop
   ============================================================ */
var BULK_PRODUK_KOLOM_MASTER = 29;
var BULK_PRODUK_MAKS_BARIS = 1000;
var BULK_PRODUK_KOLOM_INPUT = ['urlFoto', 'sku', 'nama', 'kategori', 'hpp', 'hargaDefault'];

// "Rp 12.500" / "12,500" / 12500 -> 12500 (angka bulat Rupiah). Kosong -> 0. Teks ngawur -> NaN.
function parseRupiahBulk_(v) {
  if (v === null || v === undefined || v === '') return 0;
  if (typeof v === 'number') return isFinite(v) ? Math.round(v) : NaN;
  var t = String(v).trim();
  if (t === '') return 0;
  if (/^-\s*\d/.test(t)) return NaN; // angka minus ditolak
  if (/[^\d\s.,Rrp-]/.test(t)) return NaN;
  var digit = t.replace(/\D/g, '');
  return digit === '' ? NaN : Number(digit);
}

// Wrapper doPost (aksi 'simpan_produk_baru_massal')
function prosesSimpanProdukBaruMassal(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var kolom = Array.isArray(data.kolom) ? data.kolom : BULK_PRODUK_KOLOM_INPUT;
    if (kolom.join('|') !== BULK_PRODUK_KOLOM_INPUT.join('|')) throw new Error('Format kolom payload tidak dikenali: ' + kolom.join(', '));
    result = simpanProdukBaruMassal(data.baris, { toko: String(data.toko || '').trim() });
    if (result && result.success) { try { katInvalidasiCacheKatalog_(data.toko); invalidasiCacheKatalogHarga(data.toko); } catch (eI) { } } // v2026.10.53 (DN-627)
  } catch (err) {
    result = { success: false, error: (err && err.message) ? err.message : String(err), errorDetail: detailErrorBackend_(err, 'simpan_produk_baru_massal') };
  }
  return result;
}

// dataArray = array 2D [[urlFoto, sku, nama, kategori, hpp, hargaDefault], ...]
function simpanProdukBaruMassal(dataArray, opsi) {
  var result = { success: false };
  var lock = null;
  var tahap = 'validasi';
  opsi = opsi || {};
  try {
    if (!Array.isArray(dataArray) || dataArray.length === 0) throw new Error('Tidak ada produk untuk disimpan.');
    if (dataArray.length > BULK_PRODUK_MAKS_BARIS) throw new Error('Maksimal ' + BULK_PRODUK_MAKS_BARIS + ' produk per sekali simpan.');

    // ---------- 1) Validasi & susun array 2D Master Produk di MEMORY ----------
    var errorPerBaris = [];            // [{ baris: nomorBarisGrid, pesan }]
    var skuDiBatch = {};
    var kategoriDipakai = {};
    var barisMaster = [];
    dataArray.forEach(function (r, idx) {
      var no = idx + 1;
      if (!Array.isArray(r) || r.length < BULK_PRODUK_KOLOM_INPUT.length) { errorPerBaris.push({ baris: no, pesan: 'Format baris tidak valid' }); return; }
      var urlFoto = String(r[0] || '').trim();
      var sku = String(r[1] || '').trim();
      var nama = String(r[2] || '').trim();
      var kategori = String(r[3] || '').trim().substring(0, 80);
      var hpp = parseRupiahBulk_(r[4]);
      var hargaDefault = parseRupiahBulk_(r[5]);
      var salah = [];
      if (!sku) salah.push('SKU wajib diisi');
      else if (sku.length > 60) salah.push('SKU terlalu panjang');
      else if (skuDiBatch[sku.toLowerCase()]) salah.push('SKU dobel dengan baris ' + skuDiBatch[sku.toLowerCase()]);
      if (!nama) salah.push('Nama Produk wajib diisi');
      if (isNaN(hpp) || hpp < 0) salah.push('HPP harus angka >= 0');
      if (isNaN(hargaDefault) || hargaDefault < 0) salah.push('Harga Default harus angka >= 0');
      if (urlFoto) { try { katValidasiUrlFoto_(urlFoto, ''); } catch (eFoto) { salah.push(String(eFoto.message)); } }
      if (!isNaN(hpp) && !isNaN(hargaDefault)) { var pesanHarga = katPesanHppMelebihiHarga_(sku, hpp, hargaDefault); if (pesanHarga) salah.push(pesanHarga); }
      if (sku) skuDiBatch[sku.toLowerCase()] = skuDiBatch[sku.toLowerCase()] || no;
      if (salah.length) { errorPerBaris.push({ baris: no, pesan: salah.join('; ') }); return; }
      if (kategori) kategoriDipakai[kategori.toLowerCase()] = kategori;

      var baris = new Array(BULK_PRODUK_KOLOM_MASTER);
      for (var k = 0; k < BULK_PRODUK_KOLOM_MASTER; k++) baris[k] = '';
      baris[0] = sku;                 // 1  SKU
      baris[1] = nama;                // 2  Nama Produk
      baris[2] = hargaDefault;        // 3  Harga (Default)
      baris[3] = hpp;                 // 4  Harga Supplier (HPP)
      baris[6] = 0;                   // 7  Harga Shopee (belum diset)
      baris[7] = kategori;            // 8  Kategori
      baris[8] = urlFoto;             // 9  URL Foto
      baris[10] = 'NO BRAND';         // 11 Brand (default sama dengan Tambah Produk satuan)
      baris[16] = opsi.toko || '';    // 17 Toko
      baris[17] = false;              // 18 Tampil di Website
      baris[20] = '[]';               // 21 Spesifikasi Tambahan
      baris[21] = '[]';               // 22 Galeri Foto Tambahan
      baris[24] = 0;                  // 25 Harga TikTok Shop (belum diset)
      barisMaster.push({ no: no, skuLower: sku.toLowerCase(), data: baris });
    });
    if (errorPerBaris.length) {
      result.errorPerBaris = errorPerBaris;
      throw new Error(errorPerBaris.length + ' baris belum valid. Tidak ada produk yang disimpan.');
    }

    var sh = getMasterProdukSheet(opsi.toko); // memastikan 29 kolom ada (di luar lock)
    var shKat = getKategoriProdukSheet();

    // ---------- 2) Lock singkat: cek SKU vs database + tulis batch ----------
    tahap = 'menunggu antrean simpan';
    lock = kunciModul_('katalog');
    try { lock.waitLock(30000); }
    catch (eLock) { lock = null; throw new Error('Server sedang sibuk memproses simpan lain (antrean > 30 detik). Coba klik Simpan lagi sebentar lagi - belum ada produk yang tersimpan.'); }

    tahap = 'cek SKU di Master Produk';
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var skuAda = {};
      sh.getRange(2, 1, lastRow - 1, 1).getValues().forEach(function (r) { skuAda[String(r[0]).trim().toLowerCase()] = true; });
      barisMaster.forEach(function (b) { if (skuAda[b.skuLower]) errorPerBaris.push({ baris: b.no, pesan: 'SKU "' + b.data[0] + '" sudah ada di Master Produk (termasuk produk yang diarsipkan)' }); });
      if (errorPerBaris.length) {
        result.errorPerBaris = errorPerBaris;
        throw new Error(errorPerBaris.length + ' SKU sudah terdaftar. Tidak ada produk yang disimpan.');
      }
    }

    tahap = 'menulis Master Produk';
    var dataTulis = barisMaster.map(function (b) { return b.data; });
    var numRows = dataTulis.length;
    var numCols = dataTulis[0].length;
    var barisAwal = lastRow + 1;
    sh.getRange(barisAwal, 1, numRows, 1).setNumberFormat('@'); // SKU tetap teks (nol di depan tidak hilang)
    sh.getRange(barisAwal, 1, numRows, numCols).setValues(dataTulis); // SATU kali tulis untuk semua produk

    // Kategori baru -> Sheet Kategori Produk (1x baca, maks 1x tulis)
    tahap = 'menambah kategori baru';
    var kategoriBaru = [];
    var namaKat = Object.keys(kategoriDipakai);
    if (namaKat.length) {
      var lastRowKat = shKat.getLastRow();
      var katAda = {};
      if (lastRowKat > 1) shKat.getRange(2, 1, lastRowKat - 1, 1).getValues().forEach(function (r) { katAda[String(r[0]).trim().toLowerCase()] = true; });
      namaKat.forEach(function (k) { if (!katAda[k]) kategoriBaru.push([kategoriDipakai[k], '']); });
      if (kategoriBaru.length) shKat.getRange(lastRowKat + 1, 1, kategoriBaru.length, 2).setValues(kategoriBaru);
    }
    SpreadsheetApp.flush();

    try {
      var cache = CacheService.getScriptCache();
      cache.remove('KATALOG_PRODUK_' + (opsi.toko || 'default'));
      cache.remove('KATALOG_HARGA_' + (opsi.toko || 'default'));
    } catch (eCache) { /* biarin */ }

    result.success = true;
    result.jumlahTersimpan = numRows;
    result.kategoriBaru = kategoriBaru.map(function (k) { return k[0]; });
  } catch (err) {
    result.success = false;
    result.error = (err && err.message) ? err.message : String(err);
    if (!result.errorPerBaris) result.errorDetail = detailErrorBackend_(err, 'simpanProdukBaruMassal - tahap: ' + tahap);
  } finally {
    if (lock) { try { lepasKunci_(lock); } catch (eRel) { /* abaikan */ } }
  }
  return result;
}

// Edit LENGKAP dari modal form (beda dari prosesEditProdukMaster yang lama - itu tetap
// dipertahankan buat inline-edit per-field yang udah ada). Ini nerima SEMUA kolom sekaligus,
// dan boleh ganti SKU juga (dicek unik dulu, sama kayak versi tambah baru).
function prosesEditProdukMasterLengkap_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuLama = String(data.skuLama || '').trim();
    var skuBaru = String(data.sku || '').trim();
    var namaProduk = String(data.namaProduk || '').trim();
    if (!skuLama) throw new Error('SKU lama nggak ketemu - coba refresh halaman.');
    if (!skuBaru) throw new Error('SKU wajib diisi');
    if (!namaProduk) throw new Error('Nama Produk wajib diisi');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 22).getValues();
    var rowTarget = -1;
    var barisLama = null;
    for (var i = 0; i < vals.length; i++) {
      var skuBaris = String(vals[i][0]).trim();
      if (skuBaris === skuLama) { rowTarget = i + 2; barisLama = vals[i]; }
      else if (skuBaris === skuBaru && skuBaru !== skuLama) throw new Error('SKU "' + skuBaru + '" udah dipakai produk lain.');
    }
    if (rowTarget === -1) throw new Error('Produk nggak ditemukan (mungkin udah dihapus/diubah orang lain).');

    // Field yang UDAH NGGAK ADA di form (Harga Shopee, Batas Stok Menipis, Margin Custom -
    // sekarang diatur lewat submenu Harga) - PERTAHANKAN nilai lama, JANGAN di-wipe ke 0/kosong
    // cuma karena form ini nggak lagi ngirim field itu.
    var hargaShopee = data.hargaShopee !== undefined ? (parseFloat(data.hargaShopee) || 0) : (parseFloat(barisLama[6]) || 0);
    var batasStokMenipis = data.batasStokMenipis !== undefined ? String(data.batasStokMenipis || '').trim() : barisLama[5];
    var marginCustom = data.marginCustom !== undefined ? (data.marginCustom !== '' ? parseFloat(data.marginCustom) : '') : barisLama[15];
    var spesifikasiTambahan = data.spesifikasiTambahan !== undefined ? JSON.stringify(data.spesifikasiTambahan || []) : (barisLama[20] || '');
    var galeriFotoTambahan = data.galeriFotoTambahan !== undefined ? JSON.stringify(katValidasiGaleriFoto_(data.galeriFotoTambahan)) : (barisLama[21] || '');
    var urlFotoAman = katValidasiUrlFoto_(data.urlFoto, 'utama');

    // PENGAMAN HARGA: dicek kalau HPP atau Harga Jual Default berubah dari nilai di sheet
    var hppBaruForm = parseFloat(data.hargaSupplier) || 0, hargaBaruForm = parseFloat(data.harga) || 0;
    if (hppBaruForm !== (parseFloat(barisLama[3]) || 0) || hargaBaruForm !== (parseFloat(barisLama[2]) || 0)) {
      katCekHppVsHarga_(skuBaru, hppBaruForm, hargaBaruForm);
    }

    var barisBaru = [
      skuBaru, namaProduk,
      parseFloat(data.harga) || 0, parseFloat(data.hargaSupplier) || 0,
      String(data.urlSupplier || '').trim(), batasStokMenipis,
      hargaShopee, String(data.kategori || '').trim(),
      urlFotoAman, String(data.deskripsi || '').trim(),
      String(data.merk || '').trim() || 'NO BRAND', String(data.tipe || '').trim(),
      String(data.material || '').trim(), String(data.volume || '').trim(),
      String(data.warna || '').trim(), marginCustom,
      String(data.toko || '').trim(), data.tampilWebsite === true,
      String(data.berat || '').trim(), String(data.dimensi || '').trim(),
      spesifikasiTambahan, galeriFotoTambahan
    ];
    sh.getRange(rowTarget, 1, 1, 22).setValues([barisBaru]);

    // Kalau kategori ini belum ada di daftar, daftarin otomatis (sama pola fungsi lain)
    var kategoriBaru = String(data.kategori || '').trim();
    if (kategoriBaru) {
      var shKat = getKategoriProdukSheet();
      var lastRowKat = shKat.getLastRow();
      var sudahAdaKat = false;
      if (lastRowKat > 1) {
        shKat.getRange(2, 1, lastRowKat - 1, 1).getValues().forEach(function (r) { if (String(r[0]).trim() === kategoriBaru) sudahAdaKat = true; });
      }
      if (!sudahAdaKat) shKat.appendRow([kategoriBaru]);
    }

    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesLihatKategori(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var shKat = getKategoriProdukSheet();
    var lastRowKat = shKat.getLastRow();
    var daftarKategori = [];
    if (lastRowKat > 1) {
      var valsKat = shKat.getRange(2, 1, lastRowKat - 1, 2).getValues();
      valsKat.forEach(function (row) {
        var nama = String(row[0] || '').trim();
        if (nama) daftarKategori.push({ nama: nama, deskripsi: String(row[1] || '').trim() });
      });
    }

    var shMaster = getMasterProdukSheet(data.toko);
    var lastRowMaster = shMaster.getLastRow();
    var jumlahProdukPerKategori = {};
    var semuaProduk = [];
    if (lastRowMaster > 1) {
      var valsMaster = shMaster.getRange(2, 1, lastRowMaster - 1, 8).getValues();
      var petaArsipKat = katPetaArsip_(data.toko);
      valsMaster.forEach(function (row) {
        var sku = String(row[0] || '').trim();
        if (!sku || petaArsipKat[sku]) return;
        var kat = String(row[7] || '').trim();
        if (kat) jumlahProdukPerKategori[kat] = (jumlahProdukPerKategori[kat] || 0) + 1;
        semuaProduk.push({ sku: sku, nama: String(row[1] || '').trim(), kategori: kat });
      });
    }
    daftarKategori.forEach(function (k) { k.jumlahProduk = jumlahProdukPerKategori[k.nama] || 0; });

    result.success = true;
    result.kategori = daftarKategori;
    result.semuaProduk = semuaProduk;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesBuatKategori_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var nama = String(data.nama || '').trim();
    if (!nama) throw new Error('Nama kategori kosong');
    var sh = getKategoriProdukSheet();
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][0]).trim().toLowerCase() === nama.toLowerCase()) throw new Error('Kategori ini udah ada');
      }
    }
    sh.appendRow([nama, String(data.deskripsi || '').trim()]);
    result.success = true;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesSimpanProdukKategori_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var namaKategori = String(data.namaKategori || '').trim();
    var skuList = data.skuList || []; // daftar SKU yang MASUK kategori ini (dari picker)
    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 8).getValues();
      for (var i = 0; i < vals.length; i++) {
        var sku = String(vals[i][0]).trim();
        if (!sku) continue;
        var kategoriSaatIni = String(vals[i][7] || '').trim();
        var seharusnyaMasuk = skuList.indexOf(sku) !== -1;
        if (seharusnyaMasuk && kategoriSaatIni !== namaKategori) {
          sh.getRange(i + 2, 8).setValue(namaKategori);
        } else if (!seharusnyaMasuk && kategoriSaatIni === namaKategori) {
          sh.getRange(i + 2, 8).setValue(''); // dikeluarin dari kategori ini
        }
      }
    }
    result.success = true;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   PURCHASE ORDER (PO) SEDERHANA - biar "On Order" ada datanya.
   Beda dari "Invoice Supplier" (yang dicatat SETELAH barang datang buat rekonsiliasi) -
   PO ini dicatat SEBELUM barang datang, buat tau apa aja yang lagi "dalam perjalanan".
   ============================================================ */
// Bikin nomor PO format PO-YYYYMMDD-XX (tanggal + urutan ke-berapa hari itu) - dipakai
// di semua tempat yang bikin PO baru, biar formatnya konsisten.
function generateNoPOHarian() {
  var tz = Session.getScriptTimeZone();
  var tanggalHariIni = Utilities.formatDate(new Date(), tz, 'yyyyMMdd');
  var sheets = getPurchaseOrderSheets();
  var lastRow = sheets.header.getLastRow();
  var urutanTertinggi = 0;
  if (lastRow > 1) {
    var vals = sheets.header.getRange(2, 1, lastRow - 1, 1).getValues();
    vals.forEach(function (row) {
      var noPO = String(row[0] || '').trim();
      var cocok = noPO.match(new RegExp('^PO-' + tanggalHariIni + '-(\\d+)$'));
      if (cocok) {
        var urutan = parseInt(cocok[1], 10);
        if (urutan > urutanTertinggi) urutanTertinggi = urutan;
      }
    });
  }
  return 'PO-' + tanggalHariIni + '-' + String(urutanTertinggi + 1).padStart(2, '0');
}

function getPurchaseOrderSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var shHeader = ss.getSheetByName('Purchase Order');
  if (!shHeader) {
    shHeader = ss.insertSheet('Purchase Order');
    shHeader.getRange(1, 1, 1, 5).setValues([['No PO', 'Tanggal', 'Nama Supplier', 'Status', 'Dicatat Oleh']]);
    shHeader.getRange(1, 1, 1, 5).setFontWeight('bold');
  }
  var shDetail = ss.getSheetByName('Purchase Order Detail');
  if (!shDetail) {
    shDetail = ss.insertSheet('Purchase Order Detail');
    shDetail.getRange(1, 1, 1, 5).setValues([['No PO', 'SKU', 'Nama Produk', 'Qty Dipesan', 'Qty Diterima']]);
    shDetail.getRange(1, 1, 1, 5).setFontWeight('bold');
  }
  return { header: shHeader, detail: shDetail };
}

/* ============================================================
   CHECKLIST STOCK MASUK (mobile) - staf gudang cocokkan qty fisik yang BENERAN diterima
   vs qty yang dipesan di PO. Kalau ada selisih, otomatis kecatet sebagai Claim Kurang/Rusak
   biar bisa ditindaklanjuti ke supplier - nggak keburu keinput ke stock kalau ternyata kurang.
   ============================================================ */
function getClaimKurangRusakSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Claim Kurang Rusak');
  if (!sh) {
    sh = ss.insertSheet('Claim Kurang Rusak');
    sh.getRange(1, 1, 1, 8).setValues([[
      'No Invoice', 'No PO', 'Tanggal', 'SKU', 'Nama Produk', 'Status', 'Qty', 'Dicatat Oleh'
    ]]);
    sh.getRange(1, 1, 1, 8).setFontWeight('bold');
  }
  return sh;
}

// List PO yang masih ada sisa belum diterima penuh (buat dipilih di Checklist mobile)
function prosesLihatDaftarPOChecklist(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sheets = getPurchaseOrderSheets();
    var lastRowHeader = sheets.header.getLastRow();
    var daftarPO = [];
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 5).getValues();
      valsHeader.forEach(function (row) {
        var noPO = String(row[0] || '').trim();
        if (!noPO) return;
        if (String(row[3]).trim() === 'Dibatalkan') return;
        daftarPO.push({ noPO: noPO, tanggal: row[1], namaSupplier: row[2], status: row[3] });
      });
    }

    var lastRowDetail = sheets.detail.getLastRow();
    var sisaPerPO = {};
    if (lastRowDetail > 1) {
      var valsDetail = sheets.detail.getRange(2, 1, lastRowDetail - 1, 5).getValues();
      valsDetail.forEach(function (row) {
        var noPO = String(row[0] || '').trim();
        var sisa = (parseFloat(row[3]) || 0) - (parseFloat(row[4]) || 0);
        if (sisa > 0) sisaPerPO[noPO] = (sisaPerPO[noPO] || 0) + sisa;
      });
    }

    var tz = Session.getScriptTimeZone();
    var daftar = daftarPO
      .filter(function (po) { return sisaPerPO[po.noPO] > 0; }) // cuma yang masih ada sisa
      .map(function (po) {
        return {
          noPO: po.noPO,
          tanggal: po.tanggal instanceof Date ? Utilities.formatDate(po.tanggal, tz, 'dd MMM yyyy') : String(po.tanggal || '-'),
          namaSupplier: po.namaSupplier, sisaItem: sisaPerPO[po.noPO]
        };
      });

    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Detail 1 PO - list item yang MASIH ada sisa belum diterima, buat ditampilin di Checklist
function prosesLihatDetailPOChecklist(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noPO = String(data.noPO || '').trim();
    if (!noPO) throw new Error('No PO kosong');

    var sheets = getPurchaseOrderSheets();
    var lastRowDetail = sheets.detail.getLastRow();
    var daftar = [];
    if (lastRowDetail > 1) {
      var valsDetail = sheets.detail.getRange(2, 1, lastRowDetail - 1, 5).getValues();
      valsDetail.forEach(function (row, idx) {
        if (String(row[0]).trim() !== noPO) return;
        var qtyDipesan = parseFloat(row[3]) || 0;
        var qtyDiterimaSebelumnya = parseFloat(row[4]) || 0;
        var sisa = qtyDipesan - qtyDiterimaSebelumnya;
        if (sisa <= 0) return; // udah diterima penuh, nggak perlu ditampilin lagi
        daftar.push({ rowDetail: idx + 2, sku: row[1], nama: row[2], qtyDipesan: qtyDipesan, qtyDiterimaSebelumnya: qtyDiterimaSebelumnya, sisa: sisa });
      });
    }
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// INTI FITUR: staf konfirmasi qty AKTUAL yang diterima (bisa beda dari yang dipesan).
// Otomatis: (1) tambah Stock Ledger sesuai qty aktual, (2) update "Qty Diterima" di PO Detail,
// (3) kalau ada selisih (qty aktual < sisa yang seharusnya), catat ke Claim Kurang/Rusak,
// (4) update status PO header (Selesai kalau semua item udah penuh, Diterima Sebagian kalau belum).
function prosesKonfirmasiStokMasukChecklist(data) {
  var noPO, noInvoice, items;
  return withTransaction(data.email, 'mintaStock', ['pembelian', 'stok'], function () {
    var result = { success: false };
    var sheets = getPurchaseOrderSheets();
    var namaStaff = getNamaStaff(data.email);
    var sekarang = new Date();
    var shLedger = getStockLedgerSheet();
    var shClaim = getClaimKurangRusakSheet();

    var jumlahClaim = 0;
    items.forEach(function (item) {
      var qtyAktual = Math.max(0, parseFloat(item.qtyAktual) || 0);
      var sisaSebelumnya = parseFloat(item.qtyDipesan) || 0; // ini SISA yang ditampilin ke staff, bukan qty pesanan awal

      // (1) Tambah stock fisik sesuai yang BENERAN diterima
      if (qtyAktual > 0) {
        shLedger.appendRow([sekarang, item.sku, 'Masuk', qtyAktual, 'Terima PO ' + noPO + (noInvoice ? ' (Invoice ' + noInvoice + ')' : ''), namaStaff, '', 0]);
      }

      // (2) Update "Qty Diterima" kumulatif di PO Detail
      if (item.rowDetail) {
        var qtyDiterimaLama = parseFloat(sheets.detail.getRange(item.rowDetail, 5).getValue()) || 0;
        sheets.detail.getRange(item.rowDetail, 5).setValue(qtyDiterimaLama + qtyAktual);
      }

      // (3) Selisih (kurang dari yang seharusnya diterima kali ini) -> otomatis jadi Claim
      var selisih = sisaSebelumnya - qtyAktual;
      if (selisih > 0) {
        var alasan = (item.alasanSelisih === 'Rusak') ? 'Rusak' : 'Kurang';
        shClaim.appendRow([noInvoice || '-', noPO, sekarang, item.sku, item.nama, alasan, selisih, namaStaff]);
        jumlahClaim++;
      }
    });

    // (4) Update status PO header - Selesai kalau SEMUA item udah diterima penuh
    var lastRowDetailAll = sheets.detail.getLastRow();
    var masihAdaSisa = false;
    if (lastRowDetailAll > 1) {
      var valsDetailAll = sheets.detail.getRange(2, 1, lastRowDetailAll - 1, 5).getValues();
      valsDetailAll.forEach(function (row) {
        if (String(row[0]).trim() !== noPO) return;
        if ((parseFloat(row[3]) || 0) - (parseFloat(row[4]) || 0) > 0) masihAdaSisa = true;
      });
    }
    var lastRowHeader = sheets.header.getLastRow();
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 1).getValues();
      for (var i = 0; i < valsHeader.length; i++) {
        if (String(valsHeader[i][0]).trim() === noPO) {
          sheets.header.getRange(i + 2, 4).setValue(masihAdaSisa ? 'Diterima Sebagian' : 'Selesai');
          break;
        }
      }
    }

    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();

    result.success = true;
    result.jumlahClaim = jumlahClaim;
    result.poSelesai = !masihAdaSisa;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      noPO = String(data.noPO || '').trim();
      noInvoice = String(data.noInvoice || '').trim();
      items = data.items || []; // [{ rowDetail, sku, nama, qtyDipesan(sisa), qtyAktual, alasanSelisih }]
      if (!noPO) throw new Error('No PO kosong');
      if (items.length === 0) throw new Error('Nggak ada item yang dikonfirmasi');
    }
  });
}

/* ============================================================
   CHECKLIST INVOICE MANUAL (mobile) - sama polanya kayak Checklist PO, tapi sumbernya dari
   "Pembelian Manual" (invoice yang diinput admin di web). Staff cocokkan qty fisik vs qty
   yang tertera di invoice, baru stock beneran ketambah. Kalau ada selisih, otomatis jadi
   Claim Kurang/Rusak (sama kayak Checklist PO).
   ============================================================ */
function prosesLihatDaftarInvoiceManualChecklist(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sheets = getPembelianManualSheets();
    var lastRow = sheets.header.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var tz = Session.getScriptTimeZone();
      var vals = sheets.header.getRange(2, 1, lastRow - 1, 10).getValues();
      vals.forEach(function (row) {
        var noInvoice = String(row[0] || '').trim();
        if (!noInvoice) return;
        if ((row[9] || 'Aktif') === 'Dibatalkan') return; // udah dibatalkan, nggak usah ditampilin lagi buat dicek
        var statusDicek = row[8] || 'Belum Dicek';
        daftar.push({
          noInvoice: noInvoice,
          tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy') : String(row[1] || '-'),
          tanggalObj: row[1] instanceof Date ? row[1].getTime() : 0,
          namaSupplier: row[2], cabang: row[3] || '-', total: parseFloat(row[6]) || 0, statusDicek: statusDicek
        });
      });
    }
    daftar.sort(function (a, b) { return b.tanggalObj - a.tanggalObj; });
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesLihatDetailInvoiceManualChecklist(data) {
  // Mendukung 1 invoice (data.noInvoice, cara lama) ATAU banyak invoice sekaligus
  // (data.noInvoices = array, atau data.noInvoice berisi "INV-1, INV-2").
  // SKU yang sama dari beberapa invoice DIGABUNG jadi 1 baris (qty dijumlah) + dicatat asal invoice-nya.
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var daftarNo = [];
    var sumber = Array.isArray(data.noInvoices) ? data.noInvoices : String(data.noInvoice || '').split(/[,;\n]+/);
    sumber.forEach(function (n) {
      var s = String(n || '').trim();
      if (s && daftarNo.indexOf(s) === -1) daftarNo.push(s);
    });
    if (daftarNo.length === 0) throw new Error('No Invoice kosong');

    var sheets = getPembelianManualSheets();
    var lastRow = sheets.detail.getLastRow();

    // CARA LAMA (dipakai layar Checklist Input ke Stock & web): 1 invoice, 1 baris detail = 1 item,
    // format respons persis seperti sebelumnya supaya fitur yang sudah jalan nggak berubah.
    if (!Array.isArray(data.noInvoices) && daftarNo.length === 1) {
      var daftarLama = [];
      if (lastRow > 1) {
        sheets.detail.getRange(2, 1, lastRow - 1, 6).getValues().forEach(function (row) {
          if (String(row[0]).trim() !== daftarNo[0]) return;
          daftarLama.push({ sku: row[1], nama: row[2], qtyInvoice: parseFloat(row[3]) || 0, hargaSatuan: parseFloat(row[4]) || 0 });
        });
      }
      result.success = true;
      result.daftar = daftarLama;
      return result;
    }

    var target = {};
    daftarNo.forEach(function (n) { target[n] = true; });

    var urutanSku = [];
    var petaSku = {};
    var invoiceKetemu = {};
    if (lastRow > 1) {
      // 1x baca sheet detail untuk SEMUA invoice (bukan 1x per invoice)
      sheets.detail.getRange(2, 1, lastRow - 1, 6).getValues().forEach(function (row) {
        var noInv = String(row[0]).trim();
        if (!target[noInv]) return;
        invoiceKetemu[noInv] = true;
        var sku = String(row[1] || '').trim();
        if (!sku) return;
        var qty = parseFloat(row[3]) || 0;
        if (!petaSku[sku]) {
          petaSku[sku] = { sku: sku, nama: row[2], qtyInvoice: 0, hargaSatuan: parseFloat(row[4]) || 0, noInvoices: [], rincian: [] };
          urutanSku.push(sku);
        }
        var it = petaSku[sku];
        it.qtyInvoice += qty;
        if (it.noInvoices.indexOf(noInv) === -1) it.noInvoices.push(noInv);
        it.rincian.push({ noInvoice: noInv, qty: qty });
      });
    }
    result.success = true;
    result.daftar = urutanSku.map(function (s) { return petaSku[s]; });
    result.invoiceDimuat = daftarNo.filter(function (n) { return invoiceKetemu[n]; });
    result.tidakDitemukan = daftarNo.filter(function (n) { return !invoiceKetemu[n]; });
  } catch (err) { result.error = err.toString(); }
  return result;
}

// INTI: staf konfirmasi qty AKTUAL yang diterima. (1) tambah Stock Ledger sesuai qty aktual,
// (2) selisih (qty aktual < qty invoice) otomatis jadi Claim Kurang/Rusak, (3) tandai invoice
// "Sudah Dicek" biar nggak muncul lagi di daftar checklist & biar web tau statusnya.
function prosesKonfirmasiStokMasukChecklistInvoiceManual(data) {
  var noInvoice, items;
  return withTransaction(data.email, 'mintaStock', ['pembelian', 'stok'], function () {
    var result = { success: false };
    var sheets = getPembelianManualSheets();
    var namaStaff = getNamaStaff(data.email);
    var sekarang = new Date();
    var shLedger = getStockLedgerSheet();
    var shClaim = getClaimKurangRusakSheet();

    // Cari nama supplier & status dari header (buat catatan Stock Ledger + cegah konfirmasi dobel)
    var lastRowHeader = sheets.header.getLastRow();
    var namaSupplier = '', rowHeaderTarget = -1, statusSaatIni = '', statusPembelianSaatIni = '';
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 10).getValues();
      for (var hi = 0; hi < valsHeader.length; hi++) {
        if (String(valsHeader[hi][0]).trim() === noInvoice) { namaSupplier = valsHeader[hi][2]; statusSaatIni = valsHeader[hi][8] || 'Belum Dicek'; statusPembelianSaatIni = valsHeader[hi][9] || 'Aktif'; rowHeaderTarget = hi + 2; break; }
      }
    }
    if (rowHeaderTarget === -1) throw new Error('Invoice ini nggak ketemu');
    if (statusPembelianSaatIni === 'Dibatalkan') throw new Error('Invoice ini udah dibatalkan, nggak bisa dikonfirmasi.');
    if (statusSaatIni === 'Sudah Dicek') throw new Error('Invoice ini udah dikonfirmasi sebelumnya - nggak bisa dikonfirmasi ulang (biar stock nggak ketambah dobel).');

    var jumlahClaim = 0;
    items.forEach(function (item) {
      var sku = String(item.sku || '').trim();
      if (!sku) return;
      var qtyAktual = Math.max(0, parseFloat(item.qtyAktual) || 0);
      var qtyInvoice = parseFloat(item.qtyInvoice) || 0;

      if (qtyAktual > 0) {
        shLedger.appendRow([sekarang, sku, 'Masuk', qtyAktual, 'Terima Invoice Manual ' + noInvoice + ' (' + namaSupplier + ')', namaStaff, item.hargaSatuan || 0, 0]);
      }

      var selisih = qtyInvoice - qtyAktual;
      if (selisih > 0) {
        var alasan = (item.alasanSelisih === 'Rusak') ? 'Rusak' : 'Kurang';
        shClaim.appendRow([noInvoice, noInvoice, sekarang, sku, item.nama, alasan, selisih, namaStaff]);
        jumlahClaim++;
      }
    });

    sheets.header.getRange(rowHeaderTarget, 9).setValue('Sudah Dicek');
    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();

    result.success = true;
    result.jumlahClaim = jumlahClaim;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      noInvoice = String(data.noInvoice || '').trim();
      items = data.items || []; // [{ sku, nama, qtyInvoice, qtyAktual, alasanSelisih }]
      if (!noInvoice) throw new Error('No Invoice kosong');
      if (items.length === 0) throw new Error('Nggak ada item yang dikonfirmasi');
    }
  });
}

function prosesLihatClaimKurangRusak(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getClaimKurangRusakSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var tz = Session.getScriptTimeZone();
      var vals = sh.getRange(2, 1, lastRow - 1, 8).getValues();
      vals.forEach(function (row, idx) {
        if (!String(row[3]).trim()) return; // SKU kosong = baris kosong
        daftar.push({
          row: idx + 2, noInvoice: row[0], noPO: row[1],
          tanggal: row[2] instanceof Date ? Utilities.formatDate(row[2], tz, 'dd MMM yyyy HH:mm') : String(row[2] || '-'),
          tanggalObj: row[2] instanceof Date ? row[2].getTime() : 0,
          sku: row[3], nama: row[4], status: row[5], qty: parseFloat(row[6]) || 0, dicatatOleh: row[7]
        });
      });
    }
    daftar.sort(function (a, b) { return b.tanggalObj - a.tanggalObj; });
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesBuatPO(data) {
  var namaSupplier, items;
  return withTransaction(data.email, 'mintaStock', 'pembelian', function () {
    var result = { success: false };
    var sheets = getPurchaseOrderSheets();
    var noPO = generateNoPOHarian();

    sheets.header.appendRow([noPO, new Date(), namaSupplier, 'Dipesan', getNamaStaff(data.email)]);
    items.forEach(function (it) {
      sheets.detail.appendRow([noPO, it.sku, it.nama, parseFloat(it.qty) || 0, 0]);
    });

    result.success = true;
    result.noPO = noPO;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      namaSupplier = String(data.namaSupplier || '').trim();
      items = data.items || []; // [{sku, nama, qty}]
      if (!namaSupplier) throw new Error('Nama supplier kosong');
      if (items.length === 0) throw new Error('Belum ada produk di PO ini');
    }
  });
}

function prosesLihatDaftarPO(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sheets = getPurchaseOrderSheets();
    var lastRowHeader = sheets.header.getLastRow();
    var daftar = [];
    var tz = Session.getScriptTimeZone();
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 5).getValues();
      valsHeader.forEach(function (row) {
        var noPO = String(row[0] || '').trim();
        if (!noPO) return;
        daftar.push({
          noPO: noPO, tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy') : '-',
          namaSupplier: row[2], status: row[3], dicatatOleh: row[4], items: []
        });
      });
    }
    var mapByNoPO = {};
    daftar.forEach(function (d) { mapByNoPO[d.noPO] = d; });

    var lastRowDetail = sheets.detail.getLastRow();
    if (lastRowDetail > 1) {
      var valsDetail = sheets.detail.getRange(2, 1, lastRowDetail - 1, 5).getValues();
      valsDetail.forEach(function (row) {
        var noPO = String(row[0] || '').trim();
        if (mapByNoPO[noPO]) {
          mapByNoPO[noPO].items.push({ sku: row[1], nama: row[2], qtyDipesan: row[3], qtyDiterima: row[4] });
        }
      });
    }
    daftar.reverse();
    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

// Tandai barang di PO udah diterima - otomatis nambah Stock Ledger jenis 'Masuk' juga
function prosesTerimaBarangPO(data) {
  var noPO, sku, qtyDiterimaBaru;
  return withTransaction(data.email, 'mintaStock', ['pembelian', 'stok'], function () {
    var result = { success: false };
    var sheets = getPurchaseOrderSheets();
    var lastRowDetail = sheets.detail.getLastRow();
    var valsDetail = sheets.detail.getRange(2, 1, lastRowDetail - 1, 5).getValues();
    var rowTarget = -1, qtyDipesan = 0, qtyDiterimaLama = 0;
    for (var i = 0; i < valsDetail.length; i++) {
      if (String(valsDetail[i][0]).trim() === noPO && String(valsDetail[i][1]).trim() === sku) {
        rowTarget = i + 2; qtyDipesan = valsDetail[i][3]; qtyDiterimaLama = valsDetail[i][4]; break;
      }
    }
    if (rowTarget === -1) throw new Error('Item PO tidak ditemukan');
    if (qtyDiterimaBaru > qtyDipesan) throw new Error('Qty diterima nggak boleh lebih dari qty dipesan (' + qtyDipesan + ')');

    var selisihDiterima = qtyDiterimaBaru - qtyDiterimaLama;
    sheets.detail.getRange(rowTarget, 5).setValue(qtyDiterimaBaru);

    // Catat ke Stock Ledger cuma buat SELISIH-nya (yang baru diterima kali ini)
    if (selisihDiterima > 0) {
      var shLedger = getStockLedgerSheet(data.toko);
      shLedger.appendRow([new Date(), sku, 'Masuk', selisihDiterima, 'Terima barang dari PO ' + noPO, getNamaStaff(data.email)]);
    }

    // Update status header PO: cek semua item udah diterima penuh apa belum
    var lastRowDetailBaru = sheets.detail.getLastRow();
    var semuaDetail = sheets.detail.getRange(2, 1, lastRowDetailBaru - 1, 5).getValues();
    var semuaPenuh = true, adaYangDiterima = false;
    semuaDetail.forEach(function (row) {
      if (String(row[0]).trim() === noPO) {
        if (row[4] < row[3]) semuaPenuh = false;
        if (row[4] > 0) adaYangDiterima = true;
      }
    });
    var statusBaru = semuaPenuh ? 'Diterima Semua' : (adaYangDiterima ? 'Diterima Sebagian' : 'Dipesan');

    var lastRowHeader = sheets.header.getLastRow();
    var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 1).getValues();
    for (var j = 0; j < valsHeader.length; j++) {
      if (String(valsHeader[j][0]).trim() === noPO) { sheets.header.getRange(j + 2, 4).setValue(statusBaru); break; }
    }

    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      noPO = String(data.noPO || '').trim();
      sku = String(data.sku || '').trim();
      qtyDiterimaBaru = parseFloat(data.qtyDiterima);
      if (!noPO || !sku || isNaN(qtyDiterimaBaru) || qtyDiterimaBaru < 0) throw new Error('Data tidak valid');
    }
  });
}

/* ============================================================
   PERSEDIAAN - Posisi Stok (On Hand/On Order/On Reserve/On Available)
   ============================================================ */
function prosesLihatPosisiStok(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var cache = CacheService.getScriptCache();
    var cacheKey = 'POSISI_STOK_LENGKAP_' + (data.toko || 'default');
    var dariCache = cache.get(cacheKey);
    if (dariCache) {
      try { return JSON.parse(dariCache); } catch (eParseCache) { /* cache korup, lanjut fresh */ }
    }

    // On Hand - dari fungsi stock yang udah ada
    var stockData = prosesLihatStock({ email: data.email });
    if (!stockData.success) throw new Error(stockData.error);
    var posisi = {};
    stockData.daftar.forEach(function (d) {
      posisi[d.sku] = { sku: d.sku, nama: d.nama, onHand: d.stockSaatIni, onOrder: 0, onReserve: 0 };
    });

    // On Order - dari Purchase Order yang belum diterima penuh
    var sheets = getPurchaseOrderSheets();
    var lastRowHeaderPO = sheets.header.getLastRow();
    var statusPOMap = {};
    if (lastRowHeaderPO > 1) {
      var valsHeaderPO = sheets.header.getRange(2, 1, lastRowHeaderPO - 1, 4).getValues();
      valsHeaderPO.forEach(function (row) { statusPOMap[String(row[0]).trim()] = String(row[3]).trim(); });
    }
    var lastRowDetailPO = sheets.detail.getLastRow();
    if (lastRowDetailPO > 1) {
      var valsDetailPO = sheets.detail.getRange(2, 1, lastRowDetailPO - 1, 5).getValues();
      valsDetailPO.forEach(function (row) {
        var noPO = String(row[0]).trim();
        var sku = String(row[1]).trim();
        var statusPO = statusPOMap[noPO];
        if (statusPO === 'Dibatalkan') return;
        var sisaBelumDiterima = (parseFloat(row[3]) || 0) - (parseFloat(row[4]) || 0);
        if (sisaBelumDiterima > 0) {
          if (!posisi[sku]) posisi[sku] = { sku: sku, nama: row[2], onHand: 0, onOrder: 0, onReserve: 0 };
          posisi[sku].onOrder += sisaBelumDiterima;
        }
      });
    }

    // On Reserve - dari pesanan AKTIF (PO Sales belum dikirim + TikTok belum selesai/dibatalkan)
    var sheetsPesanan = getPesananManualSheets();
    var lastRowHeaderPesanan = sheetsPesanan.header.getLastRow();
    var noInvoiceAktifSet = {};
    if (lastRowHeaderPesanan > 1) {
      var valsHeaderPesanan = sheetsPesanan.header.getRange(2, 1, lastRowHeaderPesanan - 1, 12).getValues();
      valsHeaderPesanan.forEach(function (row) {
        var noInv = String(row[0] || '').trim();
        var status = String(row[11] || '').trim();
        if (noInv && status === '') noInvoiceAktifSet[noInv] = true; // status kosong = masih aktif/belum dikirim
      });
    }
    var lastRowDetailPesanan = sheetsPesanan.detail.getLastRow();
    if (lastRowDetailPesanan > 1) {
      var valsDetailPesanan = sheetsPesanan.detail.getRange(2, 1, lastRowDetailPesanan - 1, 4).getValues();
      valsDetailPesanan.forEach(function (row) {
        var noInv = String(row[0] || '').trim();
        var sku = String(row[1] || '').trim();
        var qty = parseFloat(row[3]) || 0;
        if (noInvoiceAktifSet[noInv] && sku) {
          if (!posisi[sku]) posisi[sku] = { sku: sku, nama: row[2], onHand: 0, onOrder: 0, onReserve: 0 };
          posisi[sku].onReserve += qty;
        }
      });
    }
    // Catatan: sebelumnya reserve dari TikTok Shop/Conner belum diikutkan (data cuma ringkasan
    // teks) - sekarang udah ada Sheet Detail per-SKU, jadi bisa dihitung juga.
    function tambahReserveDariMarketplace(sheetGetterHeader, namaSheetDetail) {
      var shHeaderMP = sheetGetterHeader();
      var lastRowHeaderMP = shHeaderMP.getLastRow();
      var statusAktifSet = {};
      if (lastRowHeaderMP > 1) {
        var valsHeaderMP = shHeaderMP.getRange(2, 1, lastRowHeaderMP - 1, 5).getValues();
        valsHeaderMP.forEach(function (row) {
          var orderId = String(row[0] || '').trim();
          var status = String(row[4] || '').trim();
          if (orderId && status !== 'COMPLETED' && status !== 'CANCELLED') statusAktifSet[orderId] = true;
        });
      }
      var shDetailMP = getPesananMarketplaceDetailSheet(namaSheetDetail);
      var lastRowDetailMP = shDetailMP.getLastRow();
      if (lastRowDetailMP > 1) {
        var valsDetailMP = shDetailMP.getRange(2, 1, lastRowDetailMP - 1, 3).getValues();
        valsDetailMP.forEach(function (row) {
          var orderId = String(row[0] || '').trim();
          if (!statusAktifSet[orderId]) return;
          var sku = String(row[1] || '').trim();
          var qty = parseFloat(row[2]) || 0;
          if (!sku) return;
          if (!posisi[sku]) posisi[sku] = { sku: sku, nama: sku, onHand: 0, onOrder: 0, onReserve: 0 };
          posisi[sku].onReserve += qty;
        });
      }
    }
    tambahReserveDariMarketplace(getPesananTikTokShopSheet, 'Pesanan TikTok Shop Detail');
    tambahReserveDariMarketplace(getPesananConnerSheet, 'Pesanan Conner Detail');

    var daftar = Object.keys(posisi).map(function (sku) {
      var p = posisi[sku];
      p.onAvailable = p.onHand - p.onReserve;
      return p;
    });

    result.success = true;
    result.daftar = daftar;
    try { cache.put(cacheKey, JSON.stringify(result), 20); } catch (eCachePut) { /* kegedean buat cache, lewati */ }
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   SIMPAN DETAIL KONTAK PELANGGAN (Email, PIC, Kategori, Keterangan)
   ============================================================ */
function prosesSimpanDetailKontak(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var nama = String(data.nama || '').trim();
    if (!nama) throw new Error('Nama kosong');

    var sh = getDataPembeliSheet();
    var lastRow = sh.getLastRow();
    var rowTarget = -1;
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][0]).trim().toLowerCase() === nama.toLowerCase()) { rowTarget = i + 2; break; }
      }
    }
    if (rowTarget === -1) {
      // Belum ada di Data Pembeli (misal pelanggan dari TikTok Shop) - bikin baris baru
      rowTarget = lastRow + 1;
      sh.getRange(rowTarget, 1).setValue(nama);
      sh.getRange(rowTarget, 8, 1, 2).setValues([[data.sumberKontak || 'Manual', new Date()]]);
    }

    if (data.noHp !== undefined) sh.getRange(rowTarget, 3).setNumberFormat('@').setValue(formatNoHpIntl_(data.noHp));
    if (data.alamat !== undefined) sh.getRange(rowTarget, 2).setValue(data.alamat);
    if (data.emailKontak !== undefined) sh.getRange(rowTarget, 4).setValue(data.emailKontak);
    if (data.pic !== undefined) sh.getRange(rowTarget, 5).setValue(data.pic);
    if (data.kategori !== undefined) sh.getRange(rowTarget, 6).setValue(data.kategori);
    if (data.keterangan !== undefined) sh.getRange(rowTarget, 7).setValue(data.keterangan);

    result.success = true;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   PENGIRIMAN - resi keluar harus difinalisasi jadi Selesai (penghasilan) atau Retur.
   Kalau status masih "Dikirim" lebih dari 7 hari, dianggap PERLU DITINDAKLANJUTI.
   ============================================================ */
function prosesLihatPengiriman(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getPesananManualSheets().header;
    var lastRow = sh.getLastRow();
    var daftar = [];
    var tz = Session.getScriptTimeZone();
    var sekarang = new Date();
    var msPerHari = 24 * 60 * 60 * 1000;
    var AMBANG_HARI = 7;

    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 12).getValues();
      vals.forEach(function (row) {
        var noInvoice = String(row[0] || '').trim();
        var noResi = String(row[10] || '').trim();
        if (!noInvoice || !noResi) return; // cuma yang UDAH ada resi keluar
        var status = String(row[11] || '').trim();
        if (status === 'Dibatalkan') return;

        var tglPesanan = row[1];
        var hariSejakDikirim = (status === 'Dikirim' && tglPesanan instanceof Date) ? Math.floor((sekarang - tglPesanan) / msPerHari) : null;
        var perluTindakLanjut = status === 'Dikirim' && hariSejakDikirim !== null && hariSejakDikirim >= AMBANG_HARI;

        daftar.push({
          noInvoice: noInvoice,
          tanggal: tglPesanan instanceof Date ? Utilities.formatDate(tglPesanan, tz, 'dd MMM yyyy') : '-',
          pembeli: row[2], noResi: noResi, total: row[9] || 0,
          status: status || 'Belum Dikirim', hariSejakDikirim: hariSejakDikirim, perluTindakLanjut: perluTindakLanjut
        });
      });
    }
    daftar.sort(function (a, b) { return (b.perluTindakLanjut ? 1 : 0) - (a.perluTindakLanjut ? 1 : 0); });

    result.success = true;
    result.daftar = daftar;
    result.jumlahPerluTindakLanjut = daftar.filter(function (d) { return d.perluTindakLanjut; }).length;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesFinalisasiPengiriman(data) {
  var noInvoice, statusBaru;
  return withTransaction(data.email, 'buatInvoice', ['penjualan', 'stok'], function () {
    var result = { success: false };
    var sheets = getPesananManualSheets();
    var lastRowHeader = sheets.header.getLastRow();
    var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 1).getValues();
    var rowTarget = -1;
    for (var i = 0; i < valsHeader.length; i++) {
      if (String(valsHeader[i][0]).trim() === noInvoice) { rowTarget = i + 2; break; }
    }
    if (rowTarget === -1) throw new Error('Pesanan tidak ditemukan');

    sheets.header.getRange(rowTarget, 12).setValue(statusBaru);
    if (statusBaru === 'Selesai') sheets.header.getRange(rowTarget, 19).setValue(new Date());

    // Kalau Retur, kembalikan stock-nya (baca item dari Pesanan Manual Detail)
    if (statusBaru === 'Retur') {
      var lastRowDetail = sheets.detail.getLastRow();
      if (lastRowDetail > 1) {
        var valsDetail = sheets.detail.getRange(2, 1, lastRowDetail - 1, 4).getValues();
        var shLedger = getStockLedgerSheet(data.toko);
        valsDetail.forEach(function (row) {
          if (String(row[0]).trim() === noInvoice) {
            var sku = String(row[1]).trim();
            var qty = parseFloat(row[3]) || 0;
            if (sku && qty > 0) {
              shLedger.appendRow([new Date(), sku, 'Masuk', qty, 'Retur dari pesanan ' + noInvoice, getNamaStaff(data.email)]);
            }
          }
        });
      }
    }

    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      noInvoice = String(data.noInvoice || '').trim();
      statusBaru = String(data.statusBaru || '').trim(); // 'Selesai' atau 'Retur'
      if (!noInvoice || (statusBaru !== 'Selesai' && statusBaru !== 'Retur')) throw new Error('Data tidak valid');
    }
  });
}

/* ============================================================
   MASTER PRODUK - upload foto (via Drive, sama pola kayak Logo Perusahaan)
   + edit SKU/Nama/Kategori langsung dari Katalog > Produk.
   ============================================================ */
function prosesUploadFotoProduk(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    var base64Data = String(data.base64 || '');
    var mimeType = String(data.mimeType || 'image/png');
    if (!sku) throw new Error('SKU kosong');
    if (!base64Data) throw new Error('Tidak ada gambar yang dikirim');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var rowTarget = -1;
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][0]).trim() === sku) { rowTarget = i + 2; break; }
    }
    if (rowTarget === -1) throw new Error('SKU tidak ditemukan');

    katValidasiUkuranBase64_(base64Data);
    var bytes = Utilities.base64Decode(base64Data);
    var blob = Utilities.newBlob(bytes, mimeType, 'foto-produk-' + sku);
    var file = getSubfolderUpload('Foto Produk').createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var urlFoto = 'https://lh3.googleusercontent.com/d/' + file.getId();

    // Upload Drive (lambat) di luar lock; tulis ke sheet di dalam lock + cari ulang barisnya
    katTulisDiBarisSku_(sh, sku, function (row) { sh.getRange(row, 9).setValue(urlFoto); });

    result.success = true;
    result.urlFoto = urlFoto;
  } catch (err) {
    result.error = String(err && err.message || err);
  }
  return result;
}

// Upload foto STANDALONE - dipakai modal Tambah/Edit Produk, nggak butuh baris produk udah
// ada di sheet (beda dari prosesUploadFotoProduk yang langsung nulis ke baris SKU tertentu).
// Cuma upload ke Drive & balikin URL - baris produknya sendiri baru kesimpen pas tombol
// "Simpan" di modal diklik.
// Cari/bikin folder utama "Waterground_Produk_Aset", terus cari/bikin subfolder "[SKU] -
// [Nama Produk]" di dalamnya. Kalau udah ada, dipakai lagi (nggak duplikat).
function getFolderAsetProduk(sku, namaProduk) {
  var namaFolderUtama = 'Waterground_Produk_Aset';
  var folderUtama;
  var iterUtama = DriveApp.getFoldersByName(namaFolderUtama);
  if (iterUtama.hasNext()) folderUtama = iterUtama.next();
  else folderUtama = DriveApp.createFolder(namaFolderUtama);

  var namaSubfolder = (sku || 'TANPA-SKU') + ' - ' + (namaProduk || 'Tanpa Nama');
  if (namaSubfolder.length > 120) namaSubfolder = namaSubfolder.substring(0, 120); // jaga-jaga nama kepanjangan

  var folderProduk;
  var iterSub = folderUtama.getFoldersByName(namaSubfolder);
  if (iterSub.hasNext()) folderProduk = iterSub.next();
  else folderProduk = folderUtama.createFolder(namaSubfolder);

  return folderProduk;
}

function prosesUploadFotoStandalone(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var base64Data = String(data.base64 || '');
    var mimeType = String(data.mimeType || 'image/png');
    if (!base64Data) throw new Error('Tidak ada gambar yang dikirim');

    var sku = String(data.sku || '').trim();
    var namaProduk = String(data.namaProduk || '').trim();

    katValidasiUkuranBase64_(base64Data);
    var bytes = Utilities.base64Decode(base64Data);
    var blob = Utilities.newBlob(bytes, mimeType, 'foto-' + new Date().getTime());
    // Kalau SKU/Nama udah diisi di form, taruh di folder khusus produk itu. Kalau belum
    // (edge case - upload foto sebelum ngetik SKU/Nama sama sekali), fallback ke folder
    // umum biar upload tetap jalan, bukan gagal total.
    var folderTarget = (sku || namaProduk) ? getFolderAsetProduk(sku, namaProduk) : getSubfolderUpload('Foto Produk');
    var file = folderTarget.createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    result.success = true;
    result.urlFoto = 'https://lh3.googleusercontent.com/d/' + file.getId();
  } catch (err) {
    result.error = String(err && err.message || err);
  }
  return result;
}

// Update SATU slot galeri foto (foto ke-2 s.d ke-5, slotIndex 0-3) - dipakai halaman Detail
// Produk. Beda dari upload_foto_standalone (buat modal Tambah/Edit yang nyimpen semuanya
// bareng pas Simpan) - ini LANGSUNG nulis ke sheet begitu upload selesai, sama pola kayak
// upload_foto_produk buat foto utama.
function prosesUpdateFotoGaleriSlot(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    var slotIndex = parseInt(data.slotIndex, 10); // 0-3 = foto ke-2 s.d ke-5
    var base64Data = String(data.base64 || '');
    var mimeType = String(data.mimeType || 'image/png');
    if (!sku) throw new Error('SKU kosong');
    if (isNaN(slotIndex) || slotIndex < 0 || slotIndex > 8) throw new Error('Slot foto nggak valid'); // v2026.10.98: 10 foto
    if (!base64Data) throw new Error('Tidak ada gambar yang dikirim');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 22).getValues();
    var rowTarget = -1, namaProduk = '', galeriLama = [];
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][0]).trim() === sku) {
        rowTarget = i + 2;
        namaProduk = String(vals[i][1] || '').trim();
        try { galeriLama = vals[i][21] ? JSON.parse(vals[i][21]) : []; } catch (eParse) { galeriLama = []; }
        break;
      }
    }
    if (rowTarget === -1) throw new Error('SKU nggak ditemukan');

    katValidasiUkuranBase64_(base64Data);
    var bytes = Utilities.base64Decode(base64Data);
    var blob = Utilities.newBlob(bytes, mimeType, 'foto-' + new Date().getTime());
    var file = getFolderAsetProduk(sku, namaProduk).createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var urlBaru = 'https://lh3.googleusercontent.com/d/' + file.getId();

    // Galeri dibaca ULANG di dalam lock (bukan pakai galeriLama dari awal request) - kalau ada
    // slot lain yang di-upload bersamaan, perubahannya tidak tertimpa.
    katTulisDiBarisSku_(sh, sku, function (row) {
      var galeriTerkini = [];
      try { var isi = sh.getRange(row, 22).getValue(); galeriTerkini = isi ? JSON.parse(isi) : []; } catch (eParse) { galeriTerkini = []; }
      while (galeriTerkini.length <= slotIndex) galeriTerkini.push('');
      galeriTerkini[slotIndex] = urlBaru;
      sh.getRange(row, 22).setValue(JSON.stringify(galeriTerkini));
    });

    result.success = true;
    result.urlFoto = urlBaru;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}

// Hapus 1 foto (utama ATAU salah satu galeri) - ngosongin referensinya di sheet DAN coba
// hapus file aslinya di Drive (best-effort - kalau gagal hapus file Drive-nya, tetap sukses
// ngosongin referensi di sheet, biar nggak macet gara-gara hal kecil).
function prosesHapusFotoSlot_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    var slotType = String(data.slotType || ''); // 'utama' | 'galeri'
    if (!sku) throw new Error('SKU kosong');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 22).getValues();
    var rowTarget = -1, urlDihapus = '', galeriLama = [];
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][0]).trim() === sku) {
        rowTarget = i + 2;
        try { galeriLama = vals[i][21] ? JSON.parse(vals[i][21]) : []; } catch (eParse) { galeriLama = []; }
        if (slotType === 'utama') urlDihapus = String(vals[i][8] || '');
        else urlDihapus = galeriLama[parseInt(data.slotIndex, 10)] || '';
        break;
      }
    }
    if (rowTarget === -1) throw new Error('SKU nggak ditemukan');

    if (slotType === 'utama') {
      sh.getRange(rowTarget, 9).setValue('');
    } else {
      var slotIndex = parseInt(data.slotIndex, 10);
      if (isNaN(slotIndex) || slotIndex < 0 || slotIndex > 8) throw new Error('Slot foto nggak valid'); // v2026.10.98: 10 foto
      while (galeriLama.length < 4) galeriLama.push('');
      galeriLama[slotIndex] = '';
      sh.getRange(rowTarget, 22).setValue(JSON.stringify(galeriLama));
    }

    if (urlDihapus) {
      var mFileId = urlDihapus.match(/\/d\/([a-zA-Z0-9_-]+)/);
      if (mFileId) { try { DriveApp.getFileById(mFileId[1]).setTrashed(true); } catch (eDrive) { /* biarin - referensi tetap kehapus dari sheet */ } }
    }

    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ===== Aksi Massal Produk Master (dipanggil dari toolbar Katalog > Produk Master) ===== */
function prosesUbahKategoriMassal_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuList = data.skuList || [];
    var kategoriBaru = String(data.kategoriBaru || '').trim();
    if (skuList.length === 0) throw new Error('Nggak ada produk yang dipilih.');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    if (lastRow < 2) throw new Error('Belum ada produk di Master Produk.');
    var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var petaSkuKeRow = {};
    vals.forEach(function (row, idx) { petaSkuKeRow[String(row[0]).trim()] = idx + 2; });

    var jumlahBerhasil = 0;
    skuList.forEach(function (sku) {
      var row = petaSkuKeRow[String(sku).trim()];
      if (row) { sh.getRange(row, 8).setValue(kategoriBaru); jumlahBerhasil++; }
    });

    // Kalau kategori ini belum ada di daftar Kategori, daftarin otomatis (sama pola edit satuan)
    if (kategoriBaru) {
      var shKat = getKategoriProdukSheet();
      var lastRowKat = shKat.getLastRow();
      var sudahAdaKat = false;
      if (lastRowKat > 1) {
        shKat.getRange(2, 1, lastRowKat - 1, 1).getValues().forEach(function (r) { if (String(r[0]).trim() === kategoriBaru) sudahAdaKat = true; });
      }
      if (!sudahAdaKat) shKat.appendRow([kategoriBaru]);
    }

    result.success = true;
    result.jumlahBerhasil = jumlahBerhasil;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// C3: Ubah nama kategori (rename) - sekaligus cascade ke SEMUA produk yang masih pakai nama
// lama, biar nggak ada produk yang "nyangkut" di kategori yang udah nggak ada namanya lagi.
// Toko yang dipindai ikut data.toko (kalau kosong = toko default), sama seperti aksi massal lain.
function prosesUbahNamaKategori_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var namaLama = String(data.namaLama || '').trim();
    var namaBaru = String(data.namaBaru || '').trim();
    if (!namaLama) throw new Error('Nama kategori lama kosong.');
    if (!namaBaru) throw new Error('Nama kategori baru tidak boleh kosong.');
    if (namaLama === namaBaru) { result.success = true; result.jumlahProdukDiupdate = 0; return result; }

    var shKat = getKategoriProdukSheet();
    var lastRowKat = shKat.getLastRow();
    var rowKatLama = -1;
    if (lastRowKat > 1) {
      var valsKat = shKat.getRange(2, 1, lastRowKat - 1, 1).getValues();
      for (var i = 0; i < valsKat.length; i++) {
        var nm = String(valsKat[i][0]).trim();
        if (nm === namaBaru) throw new Error('Nama kategori "' + namaBaru + '" sudah dipakai kategori lain.');
        if (nm === namaLama) rowKatLama = i + 2;
      }
    }
    if (rowKatLama === -1) throw new Error('Kategori "' + namaLama + '" tidak ditemukan di daftar Kategori.');
    shKat.getRange(rowKatLama, 1).setValue(namaBaru);

    // Cascade: semua produk (kolom H = Kategori) yang masih pakai nama lama, ikut diganti.
    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var jumlahProdukDiupdate = 0;
    if (lastRow > 1) {
      var rangeKategori = sh.getRange(2, 8, lastRow - 1, 1);
      var valsKategori = rangeKategori.getValues();
      for (var j = 0; j < valsKategori.length; j++) {
        if (String(valsKategori[j][0]).trim() === namaLama) { valsKategori[j][0] = namaBaru; jumlahProdukDiupdate++; }
      }
      if (jumlahProdukDiupdate > 0) rangeKategori.setValues(valsKategori);
    }

    result.success = true;
    result.jumlahProdukDiupdate = jumlahProdukDiupdate;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   VARIAN BERTINGKAT - MODEL "PRODUK INDEPENDEN TERHUBUNG" (maks 2 tingkat)
   ------------------------------------------------------------
   Setiap varian = produk INDEPENDEN (baris sendiri di Master Produk, halaman Detail sendiri, bisa
   di-search, stok/harga/SKU marketplace sendiri). Yang menghubungkan hanya kolom pengelompokan:
     kolom 23 ID Grup Varian  (sama untuk semua SKU dalam 1 grup)
     kolom 24 Label Varian    (otomatis: "Hitam - 51 mm")
     kolom 32 Tipe Variasi 1  (sama satu grup, mis. "Warna")   | kolom 33 Nilai Variasi 1 ("Hitam")
     kolom 34 Tipe Variasi 2  (sama satu grup, mis. "Ukuran")  | kolom 35 Nilai Variasi 2 ("51 mm")
   Sheet kecil "Grup Varian" hanya menyimpan URUTAN pilihan (Hitam, Silver / 51, 53, 58 mm) supaya
   tampilan pill & matriks urut seperti di Seller Center - bukan data produk.
   Editor: matriks kombinasi, tiap slot = kolom pencarian untuk MENAUTKAN SKU yang sudah ada,
   atau tombol "Buat SKU Baru" (baris produk baru dibuat langsung, meniru atribut produk asal).
   ============================================================ */
var VB_KOL_TIPE1 = 32, VB_KOL_NILAI1 = 33, VB_KOL_TIPE2 = 34, VB_KOL_NILAI2 = 35;
var VB_SHEET_GRUP = 'Grup Varian';
var VB_HEADER_GRUP = ['ID Grup Varian', 'Nama Produk Induk', 'Tipe Variasi 1', 'Opsi Variasi 1', 'Tipe Variasi 2', 'Opsi Variasi 2', 'SKU Asal', 'Jumlah SKU Terhubung', 'Diperbarui', 'Oleh'];
var VB_MAKS_KOMBINASI = 200;

function vbPastikanKolom_(sh) {
  if (sh.getMaxColumns() < VB_KOL_NILAI2) sh.insertColumnsAfter(sh.getMaxColumns(), VB_KOL_NILAI2 - sh.getMaxColumns());
  var head = sh.getRange(1, VB_KOL_TIPE1, 1, 4).getValues()[0];
  var nama = ['Tipe Variasi 1', 'Nilai Variasi 1', 'Tipe Variasi 2', 'Nilai Variasi 2'];
  if (head.join('|') !== nama.join('|')) sh.getRange(1, VB_KOL_TIPE1, 1, 4).setValues([nama]).setFontWeight('bold');
  // Header kolom 23 diperjelas (kode membaca per NOMOR kolom, jadi aman diganti)
  if (String(sh.getRange(1, 23).getValue()).trim() === 'ID Varian') sh.getRange(1, 23).setValue('ID Grup Varian');
  return sh;
}
function vbSheetGrup_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(VB_SHEET_GRUP);
  if (!sh) {
    sh = ss.insertSheet(VB_SHEET_GRUP);
    sh.getRange(1, 1, 1, VB_HEADER_GRUP.length).setValues([VB_HEADER_GRUP]).setFontWeight('bold');
    sh.getRange('A:A').setNumberFormat('@');
    sh.setFrozenRows(1);
  }
  return sh;
}
function vbPecahOpsi_(teks) { return String(teks || '').split('|').map(function (s) { return s.trim(); }).filter(Boolean); }
function vbLabel_(n1, n2) { return [n1, n2].filter(function (x) { return String(x || '').trim(); }).join(' - '); }
function vbBacaUrutan_() {
  var hasil = {}, sh = vbSheetGrup_(), lr = sh.getLastRow();
  if (lr > 1) sh.getRange(2, 1, lr - 1, 6).getValues().forEach(function (g) {
    var id = String(g[0] || '').trim();
    if (id) hasil[id] = { namaInduk: String(g[1] || ''), tipe1: String(g[2] || ''), opsi1: vbPecahOpsi_(g[3]), tipe2: String(g[4] || ''), opsi2: vbPecahOpsi_(g[5]) };
  });
  return hasil;
}

// ===== AKSI: lihat_varian_bertingkat {sku} - definisi grup + SKU yang tertaut di tiap slot
function prosesLihatVarianBertingkat(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = vbPastikanKolom_(getMasterProdukSheet(data.toko));
    var lr = sh.getLastRow();
    var sku = String(data.sku || '').trim();
    var vals = lr > 1 ? sh.getRange(2, 1, lr - 1, VB_KOL_NILAI2).getValues() : [];
    var asal = null;
    vals.forEach(function (r) { if (String(r[0]).trim() === sku) asal = r; });
    if (!asal) throw new Error('SKU ' + sku + ' tidak ditemukan.');
    var idGrup = String(asal[22] || '').trim();
    var anggota = idGrup ? vals.filter(function (r) { return String(r[22] || '').trim() === idGrup; }) : [asal];
    var urutan = idGrup ? vbBacaUrutan_()[idGrup] : null;
    var slot = anggota.map(function (r) {
      return { sku: String(r[0]).trim(), nama: String(r[1] || ''), urlFoto: String(r[8] || ''), labelVarian: String(r[23] || ''),
        tipe1: String(r[VB_KOL_TIPE1 - 1] || ''), nilai1: String(r[VB_KOL_NILAI1 - 1] || ''), tipe2: String(r[VB_KOL_TIPE2 - 1] || ''), nilai2: String(r[VB_KOL_NILAI2 - 1] || '') };
    });
    var grup = urutan || { namaInduk: '', tipe1: '', opsi1: [], tipe2: '', opsi2: [] };
    // Lengkapi dari data baris (grup lama 1 tingkat / sheet urutan hilang)
    slot.forEach(function (s) {
      if (!grup.tipe1 && s.tipe1) grup.tipe1 = s.tipe1;
      if (!grup.tipe2 && s.tipe2) grup.tipe2 = s.tipe2;
      if (anggota.length > 1 && !s.nilai1 && !s.nilai2) { s.nilai1 = s.labelVarian || s.sku; if (!grup.tipe1) grup.tipe1 = 'Variasi'; }
      if (s.nilai1 && grup.opsi1.indexOf(s.nilai1) === -1) grup.opsi1.push(s.nilai1);
      if (s.nilai2 && grup.opsi2.indexOf(s.nilai2) === -1) grup.opsi2.push(s.nilai2);
    });
    if (!grup.namaInduk) grup.namaInduk = String(asal[1] || '').replace(new RegExp('\\s*-\\s*' + String(asal[23] || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '$'), '');
    result.idGrup = idGrup;
    result.grup = grup;
    result.slot = anggota.length > 1 || idGrup ? slot.filter(function (s) { return s.nilai1; }) : [];
    result.anggota = slot.map(function (s) { return { sku: s.sku, label: s.labelVarian || s.sku }; });
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: buat_sku_varian_baru - tombol "Buat SKU Baru" di slot kosong.
// Membuat baris produk INDEPENDEN baru (atribut disalin dari produk asal), belum masuk grup;
// penautan ke grup terjadi saat "Simpan Variasi".
function prosesBuatSkuVarianBaru_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuBaru = String(data.skuBaru || '').trim(), skuAsal = String(data.skuAsal || '').trim();
    if (!skuBaru) throw new Error('SKU baru wajib diisi.');
    if (/\s/.test(skuBaru)) throw new Error('SKU tidak boleh mengandung spasi.');
    var sh = vbPastikanKolom_(getMasterProdukSheet(data.toko));
    var lr = sh.getLastRow(), nKol = Math.max(VB_KOL_NILAI2, sh.getLastColumn());
    var vals = lr > 1 ? sh.getRange(2, 1, lr - 1, nKol).getValues() : [];
    var asal = null;
    vals.forEach(function (r) {
      var s = String(r[0] || '').trim();
      if (s.toUpperCase() === skuBaru.toUpperCase()) throw new Error('SKU ' + skuBaru + ' sudah ada - pakai kolom pencarian untuk menautkannya.');
      if (s === skuAsal) asal = r;
    });
    if (!asal) throw new Error('Produk asal ' + skuAsal + ' tidak ditemukan.');
    var label = vbLabel_(data.nilai1, data.nilai2);
    var rb = asal.slice();
    while (rb.length < nKol) rb.push('');
    rb[0] = skuBaru;
    rb[1] = String(data.namaInduk || asal[1] || '').trim() + (label ? ' - ' + label : '');
    rb[22] = ''; rb[23] = ''; rb[25] = ''; rb[26] = '';
    if (rb.length >= KAT_KOL_INFO_ARSIP) { rb[KAT_KOL_STATUS - 1] = ''; rb[KAT_KOL_INFO_ARSIP - 1] = ''; }
    rb[VB_KOL_TIPE1 - 1] = ''; rb[VB_KOL_NILAI1 - 1] = ''; rb[VB_KOL_TIPE2 - 1] = ''; rb[VB_KOL_NILAI2 - 1] = '';
    var row = lr + 1;
    sh.getRange(row, 1).setNumberFormat('@');
    sh.getRange(row, 1, 1, nKol).setValues([rb.slice(0, nKol)]);
    SpreadsheetApp.flush();
    invalidasiCacheKatalogHarga(data.toko);
    try { CacheService.getScriptCache().remove('KATALOG_PRODUK_' + (data.toko || 'default')); } catch (eC) { }
    result.success = true;
    result.produk = { sku: skuBaru, nama: rb[1], kategori: String(rb[7] || ''), urlFoto: String(rb[8] || ''), brand: String(rb[10] || ''), idVarian: '', labelVarian: '', tipe1: '', nilai1: '', tipe2: '', nilai2: '', channel: [], arsip: false };
  } catch (err) { result.error = err.message || String(err); }
  return result;
}
function prosesBuatSkuVarianBaru(data) { return katJalankanTerkunci_(prosesBuatSkuVarianBaru_inti_, data); }

// ===== AKSI: simpan_varian_bertingkat - simpan RELASI grup ke masing-masing baris produk.
// Hanya kolom 23, 24, 32-35 yang ditulis. Harga, stok, nama, dll. TIDAK disentuh.
function prosesSimpanVarianBertingkat_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuAsal = String(data.skuAsal || '').trim();
    var tipe1 = String(data.tipe1 || '').trim(), tipe2 = String(data.tipe2 || '').trim();
    var opsi1 = (data.opsi1 || []).map(function (s) { return String(s).trim(); }).filter(Boolean);
    var opsi2 = tipe2 ? (data.opsi2 || []).map(function (s) { return String(s).trim(); }).filter(Boolean) : [];
    var namaInduk = String(data.namaInduk || '').trim();
    var slot = (data.slot || []).map(function (k) { return { nilai1: String(k.nilai1 || '').trim(), nilai2: String(k.nilai2 || '').trim(), sku: String(k.sku || '').trim() }; })
      .filter(function (k) { return k.sku; });
    if (!tipe1 || !opsi1.length) throw new Error('Isi Tipe Variasi 1 dan minimal 1 pilihannya.');
    if (tipe2 && !opsi2.length) throw new Error('Tipe Variasi 2 diisi tapi pilihannya kosong.');
    if (tipe2 && tipe2.toLowerCase() === tipe1.toLowerCase()) throw new Error('Nama Tipe Variasi 1 dan 2 tidak boleh sama.');
    if (opsi1.length * Math.max(1, opsi2.length) > VB_MAKS_KOMBINASI) throw new Error('Maksimal ' + VB_MAKS_KOMBINASI + ' kombinasi.');
    if (slot.length < 1) throw new Error('Tautkan minimal 1 SKU ke slot kombinasi.');
    var slotDipakai = {}, skuDipakai = {};
    slot.forEach(function (k) {
      if (opsi1.indexOf(k.nilai1) === -1 || (tipe2 && opsi2.indexOf(k.nilai2) === -1)) throw new Error('Slot "' + vbLabel_(k.nilai1, k.nilai2) + '" tidak sesuai daftar pilihan.');
      var ks = vbLabel_(k.nilai1, k.nilai2).toLowerCase();
      if (slotDipakai[ks]) throw new Error('Slot "' + vbLabel_(k.nilai1, k.nilai2) + '" terisi 2x.');
      slotDipakai[ks] = 1;
      var kk = k.sku.toUpperCase();
      if (skuDipakai[kk]) throw new Error('SKU ' + k.sku + ' ditautkan ke lebih dari 1 slot.');
      skuDipakai[kk] = 1;
    });

    var sh = vbPastikanKolom_(getMasterProdukSheet(data.toko));
    var lr = sh.getLastRow();
    if (lr < 2) throw new Error('Master Produk kosong.');
    var vals = sh.getRange(2, 1, lr - 1, VB_KOL_NILAI2).getValues();
    var baris = {};
    vals.forEach(function (r, i) { var s = String(r[0] || '').trim(); if (s) baris[s.toUpperCase()] = i; });
    var arsip = katPetaArsip_(data.toko);
    var iAsal = baris[skuAsal.toUpperCase()];
    var idGrup = String(data.idGrup || (iAsal !== undefined ? vals[iAsal][22] : '') || '').trim();
    // Grup = milik produk asal (atau yang dikirim editor). TIDAK pernah "mengambil alih" grup milik SKU
    // yang ditautkan - SKU yang sudah di grup lain ditolak di bawah.
    if (!idGrup) idGrup = 'GRV-' + Utilities.getUuid().replace(/-/g, '').slice(0, 10).toUpperCase();

    var namaGrup = {};
    vals.forEach(function (r) { var g = String(r[22] || '').trim(); if (g && !namaGrup[g]) namaGrup[g] = String(r[1] || ''); });
    slot.forEach(function (k) {
      var i = baris[k.sku.toUpperCase()];
      if (i === undefined) throw new Error('SKU ' + k.sku + ' tidak ada di Master Produk.');
      if (arsip[String(vals[i][0]).trim()]) throw new Error('SKU ' + k.sku + ' berstatus Arsip - pulihkan dulu sebelum ditautkan.');
      var gLain = String(vals[i][22] || '').trim();
      if (gLain && gLain !== idGrup) throw new Error('SKU ' + k.sku + ' sudah tergabung di grup varian lain (' + namaGrup[gLain] + '). Lepaskan dulu dari grup itu.');
      k.i = i;
    });

    // Susun kolom baru: 23-24 & 32-35 untuk semua baris (hanya baris terkait yang berubah)
    var k2324 = vals.map(function (r) { return [r[22], r[23]]; });
    var k3235 = vals.map(function (r) { return [r[VB_KOL_TIPE1 - 1], r[VB_KOL_NILAI1 - 1], r[VB_KOL_TIPE2 - 1], r[VB_KOL_NILAI2 - 1]]; });
    var tertaut = {};
    slot.forEach(function (k) {
      k2324[k.i] = [idGrup, vbLabel_(k.nilai1, k.nilai2)];
      k3235[k.i] = [tipe1, k.nilai1, tipe2, tipe2 ? k.nilai2 : ''];
      tertaut[k.i] = 1;
    });
    // Anggota lama grup ini yang tidak lagi di slot mana pun -> dilepas (produk tetap ada)
    var dilepas = [];
    vals.forEach(function (r, i) {
      if (String(r[22] || '').trim() === idGrup && !tertaut[i]) { k2324[i] = ['', '']; k3235[i] = ['', '', '', '']; dilepas.push(String(r[0])); }
    });
    sh.getRange(2, 23, vals.length, 2).setValues(k2324);
    sh.getRange(2, VB_KOL_TIPE1, vals.length, 4).setValues(k3235);

    // Urutan pilihan (untuk tampilan)
    var shG = vbSheetGrup_(), lg = shG.getLastRow(), rowG = 0;
    if (lg > 1) shG.getRange(2, 1, lg - 1, 1).getValues().some(function (g, i) { if (String(g[0]).trim() === idGrup) { rowG = i + 2; return true; } return false; });
    if (!rowG) rowG = lg + 1;
    shG.getRange(rowG, 1).setNumberFormat('@');
    shG.getRange(rowG, 1, 1, VB_HEADER_GRUP.length).setValues([[idGrup, namaInduk, tipe1, opsi1.join(' | '), tipe2, opsi2.join(' | '), skuAsal, slot.length, new Date(), getNamaStaff(data.email) || data.email]]);
    SpreadsheetApp.flush();

    invalidasiCacheKatalogHarga(data.toko);
    try { CacheService.getScriptCache().remove('KATALOG_PRODUK_' + (data.toko || 'default')); } catch (eC) { }
    result.success = true;
    result.idGrup = idGrup;
    result.tertaut = slot.length;
    result.dilepas = dilepas;
  } catch (err) { result.error = err.message || String(err); }
  return result;
}
function prosesSimpanVarianBertingkat(data) { return katJalankanTerkunci_(prosesSimpanVarianBertingkat_inti_, data); }

/* ===== D: Varian Produk - setiap varian (misal beda warna/ukuran) adalah SKU & produk sendiri
   di Master Produk, tapi ditandai "satu grup" lewat kolom ID Varian (kolom 23) yang nilainya
   SAMA buat semua SKU yang jadi varian satu sama lain. Label Varian (kolom 24) adalah teks yang
   tampil di thumbnail strip varian PADA PRODUK ITU SENDIRI, misal "Merah - L". ===== */
function prosesSimpanVarianProduk_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('SKU kosong.');
    var labelVarian = data.labelVarian !== undefined ? String(data.labelVarian || '').trim() : null;
    var skuVarianLain = String(data.skuVarianLain || '').trim();

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    if (lastRow < 2) throw new Error('Belum ada produk di Master Produk.');
    var vals = sh.getRange(2, 1, lastRow - 1, 24).getValues();

    var rowSku = -1, rowLain = -1;
    for (var i = 0; i < vals.length; i++) {
      var s = String(vals[i][0]).trim();
      if (s === sku) rowSku = i + 2;
      if (skuVarianLain && s === skuVarianLain) rowLain = i + 2;
    }
    if (rowSku === -1) throw new Error('Produk "' + sku + '" tidak ditemukan.');

    // Simpan Label Varian punya SKU ini sendiri (kalau dikirim)
    if (labelVarian !== null) sh.getRange(rowSku, 24).setValue(labelVarian);

    if (skuVarianLain) {
      if (skuVarianLain === sku) throw new Error('Nggak bisa jadikan produk ini varian dari dirinya sendiri.');
      if (rowLain === -1) throw new Error('SKU varian "' + skuVarianLain + '" tidak ditemukan di Master Produk.');

      var idSku = String(sh.getRange(rowSku, 23).getValue() || '').trim();
      var idLain = String(sh.getRange(rowLain, 23).getValue() || '').trim();

      if (!idSku && !idLain) {
        // Belum ada grup sama sekali di kedua sisi - buat ID Varian baru buat berdua
        var idBaru = 'var' + new Date().getTime() + Math.floor(Math.random() * 1000);
        sh.getRange(rowSku, 23).setValue(idBaru);
        sh.getRange(rowLain, 23).setValue(idBaru);
      } else if (idSku && !idLain) {
        sh.getRange(rowLain, 23).setValue(idSku);
      } else if (!idSku && idLain) {
        sh.getRange(rowSku, 23).setValue(idLain);
      } else if (idSku !== idLain) {
        // Dua-duanya udah punya grup TAPI beda - gabungkan: semua produk yang segrup sama
        // idLain, ikut dipindah ke grup idSku (biar seluruh grup lama ikut nyambung).
        var kolomIdVarian = sh.getRange(2, 23, lastRow - 1, 1);
        var valsId = kolomIdVarian.getValues();
        var berubah = false;
        for (var j = 0; j < valsId.length; j++) {
          if (String(valsId[j][0]).trim() === idLain) { valsId[j][0] = idSku; berubah = true; }
        }
        if (berubah) kolomIdVarian.setValues(valsId);
      }
      // idSku === idLain (dan keduanya udah keisi) -> udah satu grup, nggak perlu apa-apa lagi
    }

    result.success = true;
    result.idVarian = String(sh.getRange(rowSku, 23).getValue() || '').trim();
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Lepas 1 SKU dari grup varian-nya (Label Varian ikut dikosongkan). Kalau sesudah itu grup lama
// cuma nyisa 1 produk doang, ID Varian punya produk sisa itu ikut dikosongkan juga - grup yang
// isinya cuma 1 produk nggak ada gunanya dipertahankan.
function prosesHapusVarianProduk_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('SKU kosong.');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    if (lastRow < 2) throw new Error('Belum ada produk di Master Produk.');
    var vals = sh.getRange(2, 1, lastRow - 1, 23).getValues();

    var rowSku = -1, idLama = '';
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][0]).trim() === sku) { rowSku = i + 2; idLama = String(vals[i][22] || '').trim(); break; }
    }
    if (rowSku === -1) throw new Error('Produk "' + sku + '" tidak ditemukan.');

    sh.getRange(rowSku, 23).setValue('');
    sh.getRange(rowSku, 24).setValue('');

    if (idLama) {
      var sisaSegrup = [];
      for (var j = 0; j < vals.length; j++) {
        if (j + 2 === rowSku) continue;
        if (String(vals[j][22] || '').trim() === idLama) sisaSegrup.push(j + 2);
      }
      if (sisaSegrup.length === 1) {
        sh.getRange(sisaSegrup[0], 23).setValue('');
        sh.getRange(sisaSegrup[0], 24).setValue('');
      }
    }

    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Koreksi C4: ganti model "link satu-satu" jadi "set membership" - form di frontend ngirim
// SELURUH daftar SKU+Nama Varian yang seharusnya jadi 1 grup (termasuk SKU aktif sendiri).
// Fungsi ini nyamain kondisi sheet sama daftar itu: SKU yang HILANG dari daftar baru dilepas
// dari grup, SKU yang baru muncul di-gabung ke grup, dan Label Varian tiap SKU ditimpa sesuai
// input form. Kalau daftar akhir cuma nyisa 1 SKU (atau kosong), grup dibubarkan (ID Varian
// dikosongkan) karena "grup" isinya 1 produk doang nggak ada gunanya.
function prosesSimpanDaftarVarian_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuAktif = String(data.skuAktif || '').trim();
    if (!skuAktif) throw new Error('SKU aktif kosong.');

    var daftar = (data.daftar || []).map(function (d) {
      return { sku: String(d.sku || '').trim(), namaVarian: String(d.namaVarian || '').trim() };
    }).filter(function (d) { return d.sku; });
    // Pastikan SKU aktif sendiri selalu ikut ke dalam daftar, walau user nggak nulis barisnya sendiri
    if (!daftar.some(function (d) { return d.sku === skuAktif; })) daftar.push({ sku: skuAktif, namaVarian: '' });

    // Cegah SKU dobel dalam 1 daftar
    var setSku = {};
    for (var m = 0; m < daftar.length; m++) {
      if (setSku[daftar[m].sku]) throw new Error('SKU "' + daftar[m].sku + '" muncul lebih dari sekali di daftar.');
      setSku[daftar[m].sku] = true;
    }

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    if (lastRow < 2) throw new Error('Belum ada produk di Master Produk.');
    var vals = sh.getRange(2, 1, lastRow - 1, 24).getValues();
    var petaRow = {};
    for (var i = 0; i < vals.length; i++) petaRow[String(vals[i][0]).trim()] = i + 2;

    // Validasi semua SKU yang diketik beneran ada di Master Produk
    for (var k = 0; k < daftar.length; k++) {
      if (!petaRow[daftar[k].sku]) throw new Error('SKU "' + daftar[k].sku + '" tidak ditemukan di Master Produk.');
    }

    var rowAktif = petaRow[skuAktif];
    var idLama = String(sh.getRange(rowAktif, 23).getValue() || '').trim();

    // Anggota grup LAMA (sebelum diedit form ini)
    var anggotaLama = {};
    if (idLama) {
      for (var n = 0; n < vals.length; n++) {
        if (String(vals[n][22] || '').trim() === idLama) anggotaLama[String(vals[n][0]).trim()] = n + 2;
      }
    } else {
      anggotaLama[skuAktif] = rowAktif;
    }

    // Lepas SKU yang ADA di grup lama tapi udah nggak ada lagi di daftar baru
    for (var skuLama in anggotaLama) {
      if (!setSku[skuLama]) {
        sh.getRange(anggotaLama[skuLama], 23).setValue('');
        sh.getRange(anggotaLama[skuLama], 24).setValue('');
      }
    }

    // Tentukan ID Varian final: pakai yang lama kalau ada; bikin baru kalau grup ini baru lahir
    // (dan daftar akhirnya beneran lebih dari 1 SKU, kalau cuma 1 SKU nggak perlu grup)
    var idFinal = idLama;
    if (!idFinal && daftar.length > 1) idFinal = 'var' + new Date().getTime() + Math.floor(Math.random() * 1000);

    for (var p = 0; p < daftar.length; p++) {
      var rowP = petaRow[daftar[p].sku];
      sh.getRange(rowP, 23).setValue(daftar.length > 1 ? idFinal : '');
      sh.getRange(rowP, 24).setValue(daftar.length > 1 ? daftar[p].namaVarian : '');
    }

    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}


function prosesUbahTampilWebsiteMassal_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuList = data.skuList || [];
    var tampilWebsite = data.tampilWebsite === true;
    if (skuList.length === 0) throw new Error('Nggak ada produk yang dipilih.');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    if (lastRow < 2) throw new Error('Belum ada produk di Master Produk.');
    var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var petaSkuKeRow = {};
    vals.forEach(function (row, idx) { petaSkuKeRow[String(row[0]).trim()] = idx + 2; });

    var jumlahBerhasil = 0;
    skuList.forEach(function (sku) {
      var row = petaSkuKeRow[String(sku).trim()];
      if (row) { sh.getRange(row, 18).setValue(tampilWebsite); jumlahBerhasil++; }
    });

    result.success = true;
    result.jumlahBerhasil = jumlahBerhasil;
  } catch (err) { result.error = err.toString(); }
  return result;
