  try {
    promoTiktokCariSemua_(promoPath_('TTS_COUPON_SEARCH'), {}, ['coupons', 'coupon_list', 'vouchers'], 10, batasWaktu).forEach(function (c) {
      var mulai = promoDetik_(promoCari_(c, ['start_time', 'claim_start_time', 'begin_time', 'redeem_start_time']));
      var akhir = promoDetik_(promoCari_(c, ['end_time', 'claim_end_time', 'redeem_end_time', 'expire_time']));
      var st = promoStatus_(mulai, akhir, c.status);
      if (st === 'Berakhir' || st === 'Nonaktif') return;
      var persen = promoCari_(c, ['percentage', 'discount_percentage', 'percent_off', 'rate']);
      var nominal = promoCari_(c, ['discount_amount', 'amount_off', 'deduction_amount', 'fixed_amount', 'amount']);
      var jenisApi = String(promoCari_(c, ['discount_type', 'benefit_type', 'type', 'promotion_type'])).toUpperCase();
      var isPersen = /PERCENT|RATE/.test(jenisApi) || (persen !== '' && nominal === '');
      baris.push(['TikTok Shop', 'C-' + (c.id || c.coupon_id || ''), promoCari_(c, ['promo_code', 'code', 'redemption_code', 'coupon_code']) || '', c.title || c.name || '',
        /SHIPPING|ONGKIR/.test(jenisApi) ? 'Voucher Ongkir' : 'Kupon Toko', /SHIPPING|ONGKIR/.test(jenisApi) ? 'Ongkir' : (isPersen ? 'Persen' : 'Nominal'),
        promoAngka_(isPersen ? persen : nominal), promoAngka_(promoCari_(c, ['min_spend', 'threshold', 'minimum_spend', 'min_order_amount'])),
        promoAngka_(promoCari_(c, ['max_discount', 'max_deduction', 'cap', 'max_discount_amount'])),
        promoAngka_(promoCari_(c, ['total_quantity', 'quantity', 'total_count', 'issue_quantity'])), promoAngka_(promoCari_(c, ['used_quantity', 'redeemed_count', 'used_count', 'claimed_count'])),
        promoFmtWaktu_(mulai), promoFmtWaktu_(akhir), st, c.display_type ? 'Tampil: ' + c.display_type : '', c.status || '']);
    });
  } catch (e) { errKupon = 'Kupon: ' + e.message; }
  var errAkt = '';
  try {
    promoTtsAktivitas_(batasWaktu).forEach(function (a) {
      if (promoTtsBundling_(a.type)) return;
      var st = promoStatus_(a.begin, a.end, a.status);
      if (st === 'Berakhir' || st === 'Nonaktif') return;
      var persen = a.diskon !== '' ? promoAngka_(a.diskon) : 0;
      baris.push(['TikTok Shop', 'P-' + a.id, '', a.title, promoTtsFlash_(a.type) ? 'Flash Sale' : 'Diskon Produk', promoTtsLabelJenis_(a.type),
        persen || (a.harga !== '' ? promoAngka_(a.harga) : ''), '', '', promoAngka_(a.batas) || '', '', promoFmtWaktu_(a.begin), promoFmtWaktu_(a.end), st,
        a.level ? 'Level: ' + a.level : '', a.status]);
    });
  } catch (e) { errAkt = 'Promosi produk: ' + e.message; }
  if (errKupon && errAkt) throw new Error(errKupon + ' | ' + errAkt);
  return { baris: baris, peringatan: [errKupon, errAkt].filter(Boolean).join(' | ') };
}

