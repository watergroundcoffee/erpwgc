function getMasterProdukSheet(toko) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var namaSheet = namaSheetToko('Master Produk', toko);
  var sh = ss.getSheetByName(namaSheet);
  if (!sh) {
    sh = ss.insertSheet(namaSheet);
    sh.getRange(1, 1, 1, 5).setValues([['SKU', 'Nama Produk', 'Harga', 'Harga Supplier', 'URL Supplier']]);
    sh.getRange(1, 1, 1, 5).setFontWeight('bold');
    sh.getRange(2, 1, 1000, 1).setNumberFormat('@'); // kolom SKU dipaksa teks
  } else if (sh.getLastColumn() < 5) {
    // Sheet lama - tambahin kolom baru kalau belum ada
    if (sh.getLastColumn() < 4) sh.getRange(1, 4).setValue('Harga Supplier').setFontWeight('bold');
    if (sh.getLastColumn() < 5) sh.getRange(1, 5).setValue('URL Supplier').setFontWeight('bold');
  }
  // Kalau kolom 4 masih berlabel nama lama "Harga Modal" (dari versi sebelumnya), rapikan jadi "Harga Supplier"
  if (sh.getLastColumn() >= 4 && String(sh.getRange(1, 4).getValue()).trim() === 'Harga Modal') {
    sh.getRange(1, 4).setValue('Harga Supplier');
  }
  // Kolom 6: Batas Stok Menipis per produk (dulu cuma ada versi global hardcode 5)
  if (sh.getLastColumn() < 6) {
    sh.getRange(1, 6).setValue('Batas Stok Menipis').setFontWeight('bold');
  }
  // Kolom 7: Harga Default Shopee (manual, belum ada koneksi API Shopee)
  if (sh.getLastColumn() < 7) {
    sh.getRange(1, 7).setValue('Harga Shopee').setFontWeight('bold');
  }
  // Kolom 8: Kategori (nama kategori, cocok sama Sheet Kategori)
  if (sh.getLastColumn() < 8) {
    sh.getRange(1, 8).setValue('Kategori').setFontWeight('bold');
  }
  // Kolom 9: URL Foto Produk (disimpan di Google Drive, sama polanya kayak Logo Perusahaan)
  if (sh.getLastColumn() < 9) {
    sh.getRange(1, 9).setValue('URL Foto').setFontWeight('bold');
  }
  // Kolom 10: Deskripsi Produk
  if (sh.getLastColumn() < 10) {
    sh.getRange(1, 10).setValue('Deskripsi').setFontWeight('bold');
  }
  // Kolom 11-15: Atribut produk tambahan (Brand, Tipe, Material, Volume, Warna)
  var atributBaru = ['Brand', 'Tipe', 'Material', 'Volume', 'Warna'];
  for (var a = 0; a < atributBaru.length; a++) {
    if (sh.getLastColumn() < 11 + a) {
      sh.getRange(1, 11 + a).setValue(atributBaru[a]).setFontWeight('bold');
    }
  }
  // Kolom 16: Margin Custom (%) - override per SKU dari margin global
  if (sh.getLastColumn() < 16) {
    sh.getRange(1, 16).setValue('Margin Custom (%)').setFontWeight('bold');
  }
  // Kolom 17: Toko - buat bedain produk Waterground vs Conner (dan toko lain nanti) dalam 1 daftar
  if (sh.getLastColumn() < 17) {
    sh.getRange(1, 17).setValue('Toko').setFontWeight('bold');
  }
  // Kolom 18: Tampil di Website (TRUE/FALSE) - dipakai buat filter katalog toko online publik
  if (sh.getLastColumn() < 18) {
    sh.getRange(1, 18).setValue('Tampil di Website').setFontWeight('bold');
  }
  // Kolom 19-20: Berat & Dimensi - dipakai buat bagian Spesifikasi di form Tambah/Edit Produk
  if (sh.getLastColumn() < 19) {
    sh.getRange(1, 19).setValue('Berat').setFontWeight('bold');
  }
  if (sh.getLastColumn() < 20) {
    sh.getRange(1, 20).setValue('Dimensi').setFontWeight('bold');
  }
  // Kolom 21: Spesifikasi Tambahan (JSON array {nama,nilai}) - dari fitur "+ Tambah Spesifikasi" di form
  if (sh.getLastColumn() < 21) {
    sh.getRange(1, 21).setValue('Spesifikasi Tambahan').setFontWeight('bold');
  }
  // Kolom 22: Galeri Foto Tambahan (JSON array URL foto ke-2 s.d. ke-5) - foto pertama
  // TETAP di kolom 9 (URL Foto) seperti biasa, biar semua bagian lain aplikasi yang udah
  // baca kolom itu nggak perlu diubah.
  if (sh.getLastColumn() < 22) {
    sh.getRange(1, 22).setValue('Galeri Foto Tambahan').setFontWeight('bold');
  }
  // Kolom 23-24: Fitur Varian Produk (D) - ID Varian = kode grup acak yang SAMA buat semua SKU
  // yang jadi varian satu sama lain (misal beda warna/ukuran dari produk yang sama). Label
  // Varian = teks yang tampil di thumbnail strip varian pada produk ITU SENDIRI, misal "Merah - L".
  if (sh.getLastColumn() < 23) {
    sh.getRange(1, 23).setValue('ID Varian').setFontWeight('bold');
  }
  if (sh.getLastColumn() < 24) {
    sh.getRange(1, 24).setValue('Label Varian').setFontWeight('bold');
  }
  // Kolom 25: Harga Jual Final TikTok Shop (Modul Harga v2). Harga Offline/Default tetap di
  // kolom 3 ("Harga"), Harga Shopee tetap di kolom 7 - biar semua pembaca lama nggak berubah.
  if (sh.getMaxColumns() < 25) sh.insertColumnsAfter(sh.getMaxColumns(), 25 - sh.getMaxColumns());
  if (sh.getLastColumn() < 25) {
    sh.getRange(1, 25).setValue('Harga TikTok Shop').setFontWeight('bold');
  }
  // Kolom 26: Last_Checked_URL - timestamp terakhir URL Supplier dicek oleh autoUpdateHPP_AI()
  // (kosong = belum pernah dicek = diprioritaskan di antrean berikutnya).
  if (sh.getMaxColumns() < 26) sh.insertColumnsAfter(sh.getMaxColumns(), 26 - sh.getMaxColumns());
  if (sh.getLastColumn() < 26) {
    sh.getRange(1, 26).setValue('Last_Checked_URL').setFontWeight('bold');
  }
  // Kolom 27: Terakhir Sync Marketplace - diisi oleh pushHargaKeMarketplace() SETELAH push harga
  // ke API Shopee/TikTok benar-benar berhasil. Ditampilkan di kolom Status tabel Katalog > Harga.
  if (sh.getMaxColumns() < 27) sh.insertColumnsAfter(sh.getMaxColumns(), 27 - sh.getMaxColumns());
  if (sh.getLastColumn() < 27) {
    sh.getRange(1, 27).setValue('Terakhir Sync Marketplace').setFontWeight('bold');
  }
  // Kolom 28-29: Harga Coret (harga sebelum diskon yang dicoret di marketplace) Shopee & TikTok Shop.
  // Kosong = tidak pakai harga coret.
  if (sh.getMaxColumns() < 29) sh.insertColumnsAfter(sh.getMaxColumns(), 29 - sh.getMaxColumns());
  if (sh.getLastColumn() < 28) sh.getRange(1, 28).setValue('Harga Coret Shopee').setFontWeight('bold');
  if (sh.getLastColumn() < 29) sh.getRange(1, 29).setValue('Harga Coret TikTok Shop').setFontWeight('bold');
  // Kolom 30-31: SOFT DELETE. Status Produk kosong/"Aktif" = aktif, "Arsip" = diarsipkan (disembunyikan
  // dari UI Katalog tapi barisnya TETAP ADA supaya histori stok/penjualan tidak yatim).
  if (sh.getMaxColumns() < KAT_KOL_INFO_ARSIP) sh.insertColumnsAfter(sh.getMaxColumns(), KAT_KOL_INFO_ARSIP - sh.getMaxColumns());
  if (sh.getLastColumn() < KAT_KOL_STATUS) sh.getRange(1, KAT_KOL_STATUS).setValue('Status Produk').setFontWeight('bold');
  if (sh.getLastColumn() < KAT_KOL_INFO_ARSIP) sh.getRange(1, KAT_KOL_INFO_ARSIP).setValue('Info Arsip').setFontWeight('bold');
  return sh;
}

