      skuSudahAda[skuMarketplace] = skuJual; // cegah duplikat dalam daftar yang sama juga
      barisBaru.push([skuJual, skuMarketplace, platform, String(data.keterangan || '').trim()]);
    });

    if (barisBaru.length > 0) {
