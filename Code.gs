/* ============================================================
   FITUR EXPORT: Excel (.xlsx) - fungsi umum dipakai berkali-kali
   ============================================================ */
function buatExcelDanKembalikanBase64(namaFile, headerArray, dataRows) {
  var ss = SpreadsheetApp.create(namaFile);
  var sh = ss.getSheets()[0];

  if (headerArray && headerArray.length > 0) {
    sh.getRange(1, 1, 1, headerArray.length).setValues([headerArray]).setFontWeight('bold');
  }
  if (dataRows && dataRows.length > 0) {
    sh.getRange(2, 1, dataRows.length, dataRows[0].length).setValues(dataRows);
  }
  SpreadsheetApp.flush();

  var fileId = ss.getId();
  var url = 'https://docs.google.com/spreadsheets/d/' + fileId + '/export?format=xlsx';
  var token = ScriptApp.getOAuthToken();
  var res = fetchHemat(url, { headers: { Authorization: 'Bearer ' + token } });
  var base64 = Utilities.base64Encode(res.getContent());

  // Bersihkan file sementara - kita cuma butuh isinya (base64), bukan file-nya sendiri
  DriveApp.getFileById(fileId).setTrashed(true);

  return base64;
}

function prosesExportExcel(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var jenis = data.jenis;
    var namaFile, headerArray, dataRows;
    var tz = Session.getScriptTimeZone();

    if (jenis === 'stock') {
      var stockData = prosesLihatStock({ email: data.email });
      if (!stockData.success) throw new Error(stockData.error);
      namaFile = 'Export Stock';
      headerArray = ['SKU', 'Nama Produk', 'Stock Saat Ini', 'Opname Terakhir'];
      dataRows = stockData.daftar.map(function (d) { return [d.sku, d.nama, d.stockSaatIni, d.opnameTerakhir]; });

    } else if (jenis === 'pesanan') {
      var pesananData = prosesLihatPesanan({ email: data.email });
      if (!pesananData.success) throw new Error(pesananData.error);
      namaFile = 'Export Pesanan Manual';
      headerArray = ['No Invoice', 'Tanggal', 'Nama Penerima', 'Total', 'Status'];
      dataRows = pesananData.items.map(function (d) {
        return [d.noInvoice, d.tanggal, d.namaPenerima, d.total || 0, d.status || 'Belum Dikirim'];
      });

    } else if (jenis === 'jurnal') {
      var jurnalData = prosesLihatJurnal({ email: data.email });
      if (!jurnalData.success) throw new Error(jurnalData.error);
      namaFile = 'Export Jurnal Transaksi';
      headerArray = ['Tanggal', 'Akun', 'Kategori', 'Jenis', 'Jumlah', 'Keterangan', 'Sumber'];
      dataRows = jurnalData.daftar.map(function (d) {
        return [d.tanggal, d.akun, d.kategori, d.jenis, d.jumlah, d.keterangan, d.sumber];
      });

    } else if (jenis === 'laba_rugi') {
      var laporan = prosesHitungLabaRugi(data); // data udah termasuk tanggalMulai/tanggalAkhir dari frontend
      if (!laporan.success) throw new Error(laporan.error);
      namaFile = 'Laporan Laba Rugi ' + laporan.periodeMulai + ' - ' + laporan.periodeAkhir;
      headerArray = ['Akun', 'Jumlah (Rp)'];
      dataRows = [];
      laporan.rincianPendapatan.forEach(function (r) { dataRows.push([r.akun, r.jumlah]); });
      dataRows.push(['Total Pendapatan', laporan.totalPendapatan]);
      dataRows.push(['Harga Pokok Penjualan (HPP)', laporan.totalHpp]);
      dataRows.push(['Laba Kotor', laporan.labaKotor]);
      laporan.rincianBeban.forEach(function (r) { dataRows.push([r.akun, r.jumlah]); });
      dataRows.push(['Total Beban', laporan.totalBeban]);
      dataRows.push(['LABA BERSIH', laporan.labaBersih]);

    } else if (jenis === 'bagan_akun') {
      var akunData = prosesLihatBaganAkun({ email: data.email });
      if (!akunData.success) throw new Error(akunData.error);
      namaFile = 'Export Bagan Akun';
      headerArray = ['Nama Akun', 'Kategori', 'Catatan'];
      dataRows = akunData.daftar.map(function (d) { return [d.nama, d.kategori, d.catatan]; });

    } else if (jenis === 'riwayat_laporan') {
      var riwayatData = prosesLihatLaporanDiterbitkan({ email: data.email });
      if (!riwayatData.success) throw new Error(riwayatData.error);
      namaFile = 'Export Riwayat Laporan Keuangan';
      headerArray = ['Tanggal Terbit', 'Periode Mulai', 'Periode Akhir', 'Pendapatan', 'HPP', 'Beban', 'Laba Bersih', 'Diterbitkan Oleh'];
      dataRows = riwayatData.daftar.map(function (d) {
        return [d.tanggalTerbit, d.periodeMulai, d.periodeAkhir, d.totalPendapatan, d.totalHpp, d.totalBeban, d.labaBersih, d.diterbitkanOleh];
      });

    } else if (jenis === 'neraca_saldo') {
      var neracaData = prosesLihatNeracaSaldo(data);
      if (!neracaData.success) throw new Error(neracaData.error);
      namaFile = 'Export Neraca Saldo';
      headerArray = ['Nama Akun', 'Kategori', 'Saldo'];
      dataRows = neracaData.daftar.map(function (d) { return [d.akun, d.kategori, d.saldo]; });

    } else {
      throw new Error('Jenis export tidak dikenali');
    }

    var base64 = buatExcelDanKembalikanBase64(namaFile, headerArray, dataRows);
    result.success = true;
    result.base64 = base64;
    result.namaFile = namaFile + '.xlsx';
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   FINANCE OTOMATIS v2 - SAK EMKM (Laba Rugi + Laporan Posisi Keuangan)
   ------------------------------------------------------------
   Prinsip: Owner cukup mencatat BIAYA OPERASIONAL. Semua angka lain ditarik otomatis:
     - Pendapatan  : "Rekap Harian Beranda" (omzet per kanal, pesanan batal tidak dihitung) - sumber yang
                     sama dengan Beranda & Laporan Penjualan, jadi angkanya identik.
     - Potongan marketplace : estimasi dari tabel "Biaya Penjualan" (persen x omzet + rupiah x jumlah pesanan).
     - HPP         : Σ (qty terjual per SKU x HARGA MODAL SKU) - presisi, lihat finTerapkanHpp_(). Catatan lama di bawah
                     (biaya rata-rata) kini hanya CADANGAN bila Harga Modal SKU kosong.
                     Biaya per SKU diambil dari modul Pembelian (Pembelian Manual Detail, ongkir dibagi
                     proporsional) + hasil Produksi (Stock Ledger "Masuk" ber-Harga Modal). Kalau tidak ada,
                     cadangan: kolom "Harga Supplier" di Master Produk.
     - Kerugian persediaan : Stock Ledger "Rusak/Hilang" x biaya rata-rata.
     - Pembelian   : total invoice Pembelian Manual (status bukan Dibatalkan) -> kas keluar & persediaan masuk.
     - Biaya operasional : Jurnal Transaksi (akun kategori Beban, jenis "Masuk"), termasuk data lama.
   Neraca disusun dengan pembukuan berpasangan (double entry) otomatis:
     Kas       = Kas Awal + Penjualan - Potongan - Pembelian - Biaya + Pendapatan lain
     Persediaan= Persediaan Awal + Pembelian - HPP - Kerugian persediaan
     Ekuitas   = Modal Awal (Kas Awal + Persediaan Awal) + Laba Ditahan + Laba Periode Berjalan
