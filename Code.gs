/* ---------- AKSI: agk_putuskan { keputusan:[{ id, setuju, ubah }] } ---------- */
function agkEksekusi_(u, ubah, data) {
  var d = u.data || {}; ubah = ubah || {};
  if (u.jenis === 'ganti_nama') {
    var baru = String(ubah.namaBaru || d.baru || '').replace(/\s+/g, ' ').trim().slice(0, 150);
    if (baru.length < 3) throw new Error('Nama baru terlalu pendek.');
    var sh = getMasterProdukSheet(data.toko);
    katDenganLock_(function () {
      var row = katCariBarisSku_(sh, d.sku);
      if (row === -1) throw new Error('SKU ' + d.sku + ' tidak ditemukan.');
      var kini = String(sh.getRange(row, 2).getValue() || '').trim();
      if (kini !== String(d.lama || '').trim()) throw new Error('Nama sudah diubah orang lain sejak diusulkan ("' + kini + '") - jalankan agen lagi.');
      sh.getRange(row, 2).setValue(baru);
      if (d.brand && !String(sh.getRange(row, 11).getValue() || '').trim()) sh.getRange(row, 11).setValue(d.brand);
    });
    return { teks: 'Nama ' + d.sku + ' → ' + baru + (d.brand ? ' · Brand diisi ' + d.brand : ''), katalog: true };
  }
  if (u.jenis === 'pasang_kategori') {
    var pilih = Array.isArray(ubah.skuList) ? ubah.skuList.filter(function (s) { return d.skuList.indexOf(s) !== -1; }) : d.skuList;
    if (!pilih.length) throw new Error('Tidak ada produk yang dipilih.');
    // hanya produk yang MASIH belum berkategori (tidak menimpa kategori yang baru diisi admin)
    var kosong = {}; agkProduk_(data.toko).forEach(function (p) { if (!p.kategori) kosong[p.sku] = 1; });
    pilih = pilih.filter(function (s) { return kosong[s]; });
    if (!pilih.length) return { teks: 'Semua produk di usulan ini sudah berkategori - tidak ada yang diubah.', katalog: false };
    var r = prosesUbahKategoriMassal({ email: data.email, toko: data.toko, skuList: pilih, kategoriBaru: d.kategori });
    if (!r || !r.success) throw new Error((r && r.error) || 'Gagal memasang kategori.');
    return { teks: 'Kategori "' + d.kategori + '" dipasang ke ' + (r.jumlahBerhasil || pilih.length) + ' produk', katalog: true };
  }
  if (u.jenis === 'buat_bundling') {
