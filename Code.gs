}
function aiwCatatToken_(usage) {
  if (!usage || (!usage.in && !usage.out)) return;
  var props = PropertiesService.getScriptProperties();
  var d = aiwJson_(props.getProperty('AI_TOKEN_HARIAN'), {}) || {};
  if (d.tanggal !== aiwHariIni_()) d = { tanggal: aiwHariIni_(), masuk: 0, keluar: 0, panggilan: 0 };
  d.masuk = (Number(d.masuk) || 0) + (Number(usage.in) || 0);
