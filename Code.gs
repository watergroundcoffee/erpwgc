// Peta jenis bukti -> nomor kolom di sheet Retur TikTok Shop
var PETA_KOLOM_BUKTI_RETUR = { resi: 12, depan: 13, samping: 14, belakang: 15, video: 16, isi: 17 };

// Upload 1 bukti (foto/video) sesuai tahapannya (resi/depan/samping/belakang/video/isi) - dicocokkan
// ke baris return_id yang sesuai. Dipakai buat pegangan internal kalau perlu ngajuin banding manual
// ke Shopee/TikTok Shop (nggak ada API resmi buat submit otomatis, jadi ini disimpan di
// Drive biar gampang diunduh/dilampirkan manual pas ngajuin banding).
function prosesUploadBuktiRetur(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var returnId = String(data.returnId || '').trim();
    var base64Data = String(data.base64 || '');
    var mimeType = String(data.mimeType || '');
    var jenis = String(data.jenis || '').trim();
    if (!returnId) throw new Error('Return ID kosong');
    if (!base64Data) throw new Error('Tidak ada file yang dikirim');
    var kolomTarget = PETA_KOLOM_BUKTI_RETUR[jenis];
    if (!kolomTarget) throw new Error('Jenis bukti tidak dikenali: ' + jenis);

    var kandidat = data.kanal === 'shopee' ? [getReturShopeeSheet(), getReturTikTokSheet()] : [getReturTikTokSheet(), getReturShopeeSheet()];
    var sh = null, rowTarget = -1;
    for (var s = 0; s < kandidat.length && rowTarget === -1; s++) {
      var lastRow = kandidat[s].getLastRow();
      if (lastRow < 2) continue;
      var vals = kandidat[s].getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][0]).trim() === returnId) { rowTarget = i + 2; sh = kandidat[s]; break; }
      }
    }
    if (rowTarget === -1) throw new Error('Data retur ini tidak ditemukan');

    var isVideo = jenis === 'video';
    var ekstensi = isVideo ? 'webm' : 'jpg';
    var bytes = Utilities.base64Decode(base64Data);
    var blob = Utilities.newBlob(bytes, mimeType || (isVideo ? 'video/webm' : 'image/jpeg'), 'bukti-' + jenis + '-' + returnId + '.' + ekstensi);
    var file = getSubfolderUpload('Bukti Unboxing Retur').createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var urlFile = 'https://drive.google.com/file/d/' + file.getId() + '/view';

    sh.getRange(rowTarget, kolomTarget).setValue(urlFile);

    result.success = true;
    result.url = urlFile;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesSyncReturTikTok(data) {
  var result = { success: false };
  if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; }
  // OPTIMASI: mutex khusus sync retur - ScriptLock hanya dipegang saat menulis ke sheet
  var mutex = kunciSinkronAmbil_('RETUR_TIKTOK');
  if (!mutex) { result.success = true; result.sedangJalan = true; result.jumlahBaru = 0; result.jumlahDiupdate = 0; result.pesan = 'Sinkron retur sedang berjalan di proses lain - dilewati.'; return result; }
  try {
    pastikanTokenTikTokMasihValid();

    var props = PropertiesService.getScriptProperties();
    var accessToken = props.getProperty('TIKTOK_ACCESS_TOKEN');
    var shopCipher = props.getProperty('TIKTOK_SHOP_CIPHER');
    if (!accessToken || !shopCipher) throw new Error('TikTok Shop belum terhubung.');

    var sh = getReturTikTokSheet();
    var lastRow = sh.getLastRow();

    var semuaReturn = [];
    var nextPageToken = '';
    var jumlahHalaman = 0;
    var waktuMulai = Date.now();
    var BATAS_WAKTU_MS = 4.5 * 60 * 1000;

    // FIX KUOTA: dari trigger otomatis cuma retur yang BARU/BERUBAH sejak sync terakhir (update_time_ge, mundur 1 jam).
    // Sync manual dari web tetap tarik penuh. Kalau API nolak filter ini, otomatis balik ke cara lama & diingat.
    var waktuMulaiDetik = Math.floor(waktuMulai / 1000);
    var waktuReturUpdateTerakhir = parseInt(props.getProperty('TIKTOK_RETUR_UPDATE_TERAKHIR') || '0', 10);
    var pakaiIncremental = !!data.dariSistem && lastRow > 1 && waktuReturUpdateTerakhir > 0 && props.getProperty('TIKTOK_RETUR_INCREMENTAL_OFF') !== '1';
    var filterRetur = pakaiIncremental ? { update_time_ge: waktuReturUpdateTerakhir - 3600 } : {};

    // ===== FASE 1 (TANPA LOCK): tarik retur dari API =====
    do {
      if (nextPageToken === '__ULANG__') nextPageToken = '';
      var path = '/return_refund/202309/returns/search';
      var bodyString = JSON.stringify(filterRetur);
      var paramsUntukSign = {
        app_key: getTiktokAppKey(), timestamp: String(Math.floor(Date.now() / 1000)),
        shop_cipher: shopCipher, version: '202309', page_size: '50', sort_field: 'create_time', sort_order: 'DESC'
      };
      if (nextPageToken) paramsUntukSign.page_token = nextPageToken;
      var signature = buatSignatureTikTok(path, paramsUntukSign, bodyString);
      var url = 'https://open-api.tiktokglobalshop.com' + path +
        '?app_key=' + encodeURIComponent(getTiktokAppKey()) + '&shop_cipher=' + encodeURIComponent(shopCipher) +
        '&timestamp=' + paramsUntukSign.timestamp + '&version=' + paramsUntukSign.version +
        '&page_size=50&sort_field=create_time&sort_order=DESC' +
        (nextPageToken ? '&page_token=' + encodeURIComponent(nextPageToken) : '') +
        '&sign=' + signature;

      var res = fetchHemat(url, {
        method: 'post', contentType: 'application/json', payload: bodyString,
        headers: { 'x-tts-access-token': accessToken }, muteHttpExceptions: true
      });
      if (res.getResponseCode() !== 200) {
        if (pakaiIncremental && jumlahHalaman === 0) {
          props.setProperty('TIKTOK_RETUR_INCREMENTAL_OFF', '1'); // filter ditolak API -> pakai cara lama seterusnya
          pakaiIncremental = false;
          filterRetur = {};
          nextPageToken = '__ULANG__';
          continue;
        }
        throw new Error('Gagal ambil data return (halaman ' + (jumlahHalaman + 1) + '): ' + res.getContentText());
      }
      var parsed = JSON.parse(res.getContentText());
      var listReturn = (parsed.data && parsed.data.return_orders) || [];
      semuaReturn = semuaReturn.concat(listReturn);
      nextPageToken = (parsed.data && parsed.data.next_page_token) || '';
      jumlahHalaman++;
    } while (nextPageToken && jumlahHalaman < 20 && (Date.now() - waktuMulai) < BATAS_WAKTU_MS);

    // ===== FASE 2 (TANPA LOCK): susun baris =====
    var barisPerReturn = {}, urutan = [];
    semuaReturn.forEach(function (r) {
      var returnId = String(r.return_id || '');
      if (!returnId || barisPerReturn[returnId]) return;
      var namaProduk = (r.return_line_items || []).map(function (li) { return li.product_name; }).join(', ') || '-';
      barisPerReturn[returnId] = [
        returnId, String(r.order_id || ''),
        r.create_time ? new Date(r.create_time * 1000) : '',
        namaProduk, r.return_reason_text || '-', r.return_status || '-',
        r.return_tracking_number || '-', r.return_provider_name || '-',
        (r.refund_amount && parseFloat(r.refund_amount.refund_total)) || 0
      ];
      urutan.push(returnId);
    });

    // ===== FASE 3 (LOCK SINGKAT): posisi baris dibaca ulang, update per blok, baris baru sekaligus =====
    var jumlahBaru = 0, jumlahDiupdate = 0;
    if (urutan.length) {
      denganKunciTulis_(function () {
        var lr = sh.getLastRow();
        var barisSudahAda = {};
        if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r, i) { if (r[0] && !barisSudahAda[String(r[0])]) barisSudahAda[String(r[0])] = i + 2; });
        var petaUpdate = {}, barisBaru = [];
        urutan.forEach(function (id) {
          if (barisSudahAda[id]) {
            // Update kolom 1-9 aja - JANGAN timpa kolom 10-11 (Diterima Gudang / Tanggal Diterima) yang ditandai manual pas scan
            petaUpdate[barisSudahAda[id]] = barisPerReturn[id];
            jumlahDiupdate++;
          } else {
            barisBaru.push(barisPerReturn[id].concat([false, '']));
            jumlahBaru++;
          }
        });
        tulisBarisPerBlok_(sh, 1, petaUpdate);
        if (barisBaru.length) sh.getRange(sh.getLastRow() + 1, 1, barisBaru.length, 11).setValues(barisBaru);
      }, 20000);
    }

    // Titik awal sync retur berikutnya - cuma kalau semua halaman kebaca (nggak berhenti di tengah)
    if (!nextPageToken) props.setProperty('TIKTOK_RETUR_UPDATE_TERAKHIR', String(waktuMulaiDetik));

    result.success = true;
    result.jumlahBaru = jumlahBaru;
    result.jumlahDiupdate = jumlahDiupdate;
  } catch (err) {
    result.error = err.toString();
  } finally { kunciSinkronLepas_('RETUR_TIKTOK', mutex); }
  return result;
}

function prosesLihatDaftarReturTikTok(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getReturTikTokSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    // Nama pelanggan per Order ID (manual > tersamar > username) - buat pencarian & kolom Pelanggan
    var namaPerOrder = {};
    try {
      var shPes = getPesananTikTokShopSheet();
      var lrPes = shPes.getLastRow();
      if (lrPes > 1) {
        shPes.getRange(2, 1, lrPes - 1, Math.min(16, shPes.getLastColumn())).getValues().forEach(function (r) {
          var k = typeof r[0] === 'number' ? kunciResi_(r[0]) : String(r[0] || '').trim();
          if (!k) return;
          var nm = String(r[10] || '').trim() || String(r[7] || '').trim() || String(r[15] || '').trim();
          if (nm) namaPerOrder[k] = nm;
        });
      }
    } catch (eNama) { /* nama pelanggan opsional */ }
    if (lastRow > 1) {
      var tz = Session.getScriptTimeZone();
      var vals = sh.getRange(2, 1, lastRow - 1, 17).getValues();
      vals.forEach(function (row, i) {
        if (!row[0]) return;
        daftar.push({
          row: i + 2, kanal: 'tiktok', returnId: String(row[0]), orderId: String(row[1]),
          tanggal: row[2] instanceof Date ? Utilities.formatDate(row[2], tz, 'dd MMM yyyy HH:mm') : String(row[2] || '-'),
          tanggalObj: row[2] instanceof Date ? row[2].getTime() : 0,
          produk: row[3], alasan: row[4], status: row[5], noResiPengembalian: resiTeks_(row[6], row[7]),
          kurir: row[7], totalRefund: parseFloat(row[8]) || 0,
          diterimaGudang: row[9] === true,
          tanggalDiterima: row[10] instanceof Date ? Utilities.formatDate(row[10], tz, 'dd MMM yyyy HH:mm') : String(row[10] || ''),
          buktiResi: String(row[11] || ''), buktiDepan: String(row[12] || ''), buktiSamping: String(row[13] || ''),
          buktiBelakang: String(row[14] || ''), buktiVideo: String(row[15] || ''), buktiIsi: String(row[16] || ''),
          pelanggan: namaPerOrder[typeof row[1] === 'number' ? kunciResi_(row[1]) : String(row[1] || '').trim()] || ''
        });
      });
    }
    result.success = true;
    daftar.sort(function (a, b) { return b.tanggalObj - a.tanggalObj; }); // terbaru duluan, berdasarkan tanggal beneran
    result.daftar = daftar;
    var waktuSyncRetur = PropertiesService.getScriptProperties().getProperty('WAKTU_SYNC_RETUR_TERAKHIR');
    result.waktuSyncTerakhir = waktuSyncRetur
      ? Utilities.formatDate(new Date(parseInt(waktuSyncRetur, 10)), Session.getScriptTimeZone(), 'HH:mm')
      : null;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   RETUR SHOPEE - sinkron data return/refund dari Shopee Open API (v2.returns.get_return_list).
   Struktur sheet SAMA dengan "Retur TikTok Shop" (17 kolom) + 1 kolom Username Pembeli, supaya
   tampilan tabel, bukti unboxing & pencocokan scan resi retur bisa dipakai bersama.
   Butuh izin API "Returns" aktif di aplikasi Shopee Open Platform.
   ============================================================ */
var SHOPEE_RETUR_ALASAN = {
  NONE: 'Tanpa alasan', NOT_RECEIPT: 'Barang tidak diterima', WRONG_ITEM: 'Salah kirim barang',
  ITEM_DAMAGED: 'Barang rusak', DIFFERENT_DESCRIPTION: 'Tidak sesuai deskripsi', MUTUAL_AGREE: 'Kesepakatan bersama',
  OTHER: 'Lainnya', CHANGE_MIND: 'Berubah pikiran', ITEM_MISSING: 'Barang kurang / hilang',
  EXPECTATION_FAILED: 'Tidak sesuai ekspektasi', ITEM_FAKE: 'Barang palsu', PHYSICAL_DMG: 'Barang rusak fisik',
  FUNCTIONAL_DMG: 'Barang tidak berfungsi', ITEM_WRONGDAMAGED: 'Salah kirim / rusak', USED: 'Barang bekas pakai',
  NO_REASON: 'Tanpa alasan', EXPIRED: 'Barang kedaluwarsa', LACK_OF_ACCESSORIES: 'Aksesoris kurang'
};

function getReturShopeeSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Retur Shopee');
  if (!sh) {
    sh = ss.insertSheet('Retur Shopee');
    sh.getRange(1, 1, 1, 18).setValues([[
      'Return SN', 'Order SN', 'Tanggal', 'Produk (ringkas)', 'Alasan Komplain', 'Status',
      'No Resi Pengembalian', 'Kurir', 'Total Refund', 'Diterima Gudang', 'Tanggal Diterima',
      'Foto Resi', 'Foto Paket Depan', 'Foto Paket Samping', 'Foto Paket Belakang', 'Video Unboxing', 'Foto Isi Barang',
      'Username Pembeli'
    ]]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

// Panggil 1 halaman get_return_list. filter = { field: 'create_time'|'update_time', from, to }
function shopeeReturAmbilHalaman_(kred, filter, pageNo) {
  var path = '/api/v2/returns/get_return_list';
  var ts = Math.floor(Date.now() / 1000);
  var sign = buatSignatureShopee(path, ts, kred.accessToken, kred.shopId);
  var url = getShopeeHost() + path +
    '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts + '&sign=' + sign +
    '&access_token=' + kred.accessToken + '&shop_id=' + kred.shopId +
    '&page_no=' + pageNo + '&page_size=50' +
    '&' + filter.field + '_from=' + filter.from + '&' + filter.field + '_to=' + filter.to;
  var res = fetchHemat(url, { method: 'get', muteHttpExceptions: true });
  var parsed = {};
  try { parsed = JSON.parse(res.getContentText()); } catch (e) { throw new Error('Respon Shopee tidak valid (HTTP ' + res.getResponseCode() + ')'); }
  if (parsed.error) throw new Error((parsed.message || parsed.error) + ' [' + parsed.error + ']');
  var r = parsed.response || {};
  return { daftar: r['return'] || r.return_list || [], more: !!r.more };
}

function shopeeReturBaris_(r) {
  var kodeAlasan = String(r.reason || '').toUpperCase();
  var alasan = SHOPEE_RETUR_ALASAN[kodeAlasan] || (kodeAlasan ? kodeAlasan.replace(/_/g, ' ').toLowerCase() : '');
  var teks = String(r.text_reason || '').trim();
  alasan = [alasan, teks].filter(Boolean).join(' - ') || '-';
  var produk = (r.item || []).map(function (it) {
    var sku = String(it.variation_sku || it.item_sku || '').trim();
    return String(it.name || '-') + (sku ? ' [' + sku + ']' : '') + (it.amount ? ' x' + it.amount : '');
  }).join(', ') || '-';
  var resi = String(r.tracking_number || '').trim();
  return [
    String(r.return_sn || ''), String(r.order_sn || ''),
    r.create_time ? new Date(r.create_time * 1000) : '',
    produk, alasan, String(r.status || '-'),
    resi || '-', resi ? 'Shopee (retur)' : '-',
    parseFloat(r.refund_amount) || 0
  ];
}

function prosesSyncReturShopee(data) {
  var result = { success: false };
  if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; }
  var mutex = kunciSinkronAmbil_('RETUR_SHOPEE');
  if (!mutex) { result.success = true; result.sedangJalan = true; result.jumlahBaru = 0; result.jumlahDiupdate = 0; result.pesan = 'Sinkron retur Shopee sedang berjalan di proses lain - dilewati.'; return result; }
  try {
    var kred = ambilKredensialShopee();
    if (!kred.accessToken || !kred.shopId) throw new Error('Shopee belum terhubung. Selesaikan otorisasi dulu di Pengaturan.');
    var props = PropertiesService.getScriptProperties();
    var sh = getReturShopeeSheet();
    var lastRow = sh.getLastRow();

    var waktuMulai = Date.now();
    var BATAS_WAKTU_MS = 4.5 * 60 * 1000;
    var JENDELA = 15 * 24 * 3600 - 60; // batas resmi Shopee: rentang waktu maks 15 hari per panggilan
    var sekarang = Math.floor(waktuMulai / 1000);
    var terakhir = parseInt(props.getProperty('SHOPEE_RETUR_UPDATE_TERAKHIR') || '0', 10);

    // Sync pertama: 90 hari ke belakang (create_time). Berikutnya: hanya yang berubah (update_time) -
    // manual dari web minimal 30 hari ke belakang biar status lama ikut terbarui.
    var field, mulai;
    if (lastRow <= 1 || !terakhir) { field = 'create_time'; mulai = sekarang - 90 * 24 * 3600; }
    else {
      field = 'update_time';
      mulai = terakhir - 3600;
      if (!data.dariSistem) mulai = Math.min(mulai, sekarang - 30 * 24 * 3600);
      mulai = Math.max(mulai, sekarang - 90 * 24 * 3600);
    }

    var semua = [], terpotong = false, jumlahHalaman = 0;
    for (var to = sekarang; to > mulai; to -= JENDELA) {
      var from = Math.max(mulai, to - JENDELA);
      var page = 0, more = true;
      while (more) {
        if ((Date.now() - waktuMulai) > BATAS_WAKTU_MS || jumlahHalaman >= 60) { terpotong = true; break; }
        var hal;
        try { hal = shopeeReturAmbilHalaman_(kred, { field: field, from: from, to: to }, page); }
        catch (eHal) {
          // Filter update_time ditolak API -> ulangi dengan create_time
          if (field === 'update_time' && jumlahHalaman === 0) { field = 'create_time'; hal = shopeeReturAmbilHalaman_(kred, { field: field, from: from, to: to }, page); }
          else throw new Error('Gagal ambil data retur Shopee: ' + eHal.message);
        }
        semua = semua.concat(hal.daftar);
        more = hal.more && hal.daftar.length > 0;
        page++; jumlahHalaman++;
      }
      if (terpotong) break;
    }

    var barisPerReturn = {}, urutan = [], username = {};
    semua.forEach(function (r) {
      var id = String(r.return_sn || '');
      if (!id || barisPerReturn[id]) return;
      barisPerReturn[id] = shopeeReturBaris_(r);
      username[id] = (r.user && r.user.username) || '';
      urutan.push(id);
    });

    var jumlahBaru = 0, jumlahDiupdate = 0;
    if (urutan.length) {
      denganKunciTulis_(function () {
        var lr = sh.getLastRow();
        var ada = {};
        if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r, i) { if (r[0] && !ada[String(r[0])]) ada[String(r[0])] = i + 2; });
        var petaUpdate = {}, petaUser = {}, barisBaru = [];
        urutan.forEach(function (id) {
          if (ada[id]) {
            petaUpdate[ada[id]] = barisPerReturn[id]; // kolom 1-9 saja, kolom gudang & bukti tidak ditimpa
            if (username[id]) petaUser[ada[id]] = [username[id]];
            jumlahDiupdate++;
          } else {
            barisBaru.push(barisPerReturn[id].concat([false, '', '', '', '', '', '', '', username[id] || '']));
            jumlahBaru++;
          }
        });
        tulisBarisPerBlok_(sh, 1, petaUpdate);
        tulisBarisPerBlok_(sh, 18, petaUser);
        if (barisBaru.length) sh.getRange(sh.getLastRow() + 1, 1, barisBaru.length, 18).setValues(barisBaru);
      }, 20000);
    }

    if (!terpotong) props.setProperty('SHOPEE_RETUR_UPDATE_TERAKHIR', String(sekarang));
    props.setProperty('WAKTU_SYNC_RETUR_SHOPEE_TERAKHIR', String(Date.now()));
    result.success = true;
    result.jumlahBaru = jumlahBaru;
    result.jumlahDiupdate = jumlahDiupdate;
    result.terpotong = terpotong;
  } catch (err) {
    result.error = err.toString();
  } finally { kunciSinkronLepas_('RETUR_SHOPEE', mutex); }
  return result;
}

// Baca sheet retur (format 17/18 kolom) -> daftar objek untuk tabel retur web
function bacaDaftarReturSheet_(sh, namaPerOrder, kanal) {
  var daftar = [];
  var lastRow = sh.getLastRow();
  if (lastRow <= 1) return daftar;
  var tz = Session.getScriptTimeZone();
  var lebar = Math.max(17, Math.min(18, sh.getLastColumn()));
  sh.getRange(2, 1, lastRow - 1, lebar).getValues().forEach(function (row, i) {
    if (!row[0]) return;
    var kunciOrder = typeof row[1] === 'number' ? kunciResi_(row[1]) : String(row[1] || '').trim();
    daftar.push({
      row: i + 2, kanal: kanal, returnId: String(row[0]), orderId: String(row[1]),
      tanggal: row[2] instanceof Date ? Utilities.formatDate(row[2], tz, 'dd MMM yyyy HH:mm') : String(row[2] || '-'),
      tanggalObj: row[2] instanceof Date ? row[2].getTime() : 0,
      produk: row[3], alasan: row[4], status: row[5], noResiPengembalian: resiTeks_(row[6], row[7]),
      kurir: row[7], totalRefund: parseFloat(row[8]) || 0,
      diterimaGudang: row[9] === true,
      tanggalDiterima: row[10] instanceof Date ? Utilities.formatDate(row[10], tz, 'dd MMM yyyy HH:mm') : String(row[10] || ''),
      buktiResi: String(row[11] || ''), buktiDepan: String(row[12] || ''), buktiSamping: String(row[13] || ''),
      buktiBelakang: String(row[14] || ''), buktiVideo: String(row[15] || ''), buktiIsi: String(row[16] || ''),
      pelanggan: namaPerOrder[kunciOrder] || String(row[17] || '').trim() || ''
    });
  });
  daftar.sort(function (a, b) { return b.tanggalObj - a.tanggalObj; });
  return daftar;
}

function prosesLihatDaftarReturShopee(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var namaPerOrder = {};
    try {
      var shPes = getPesananShopeeSheet();
      var lrPes = shPes.getLastRow();
      if (lrPes > 1) {
        shPes.getRange(2, 1, lrPes - 1, Math.min(16, shPes.getLastColumn())).getValues().forEach(function (r) {
          var k = String(r[0] || '').trim();
          if (!k) return;
          var nm = String(r[10] || '').trim() || String(r[7] || '').trim() || String(r[14] || '').trim();
          if (nm) namaPerOrder[k] = nm;
        });
      }
    } catch (eNama) { /* nama pelanggan opsional */ }
    result.daftar = bacaDaftarReturSheet_(getReturShopeeSheet(), namaPerOrder, 'shopee');
    var w = PropertiesService.getScriptProperties().getProperty('WAKTU_SYNC_RETUR_SHOPEE_TERAKHIR');
    result.waktuSyncTerakhir = w ? Utilities.formatDate(new Date(parseInt(w, 10)), Session.getScriptTimeZone(), 'HH:mm') : null;
    result.success = true;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

// Tandai "Diterima Gudang" di sheet retur mana pun (TikTok / Shopee) yang resi pengembaliannya cocok
function tandaiReturMarketplaceDiterima_(sh, kunciCache, noResi, waktu) {
  var peta = SCAN_KTX_ && SCAN_KTX_[kunciCache];
  if (!peta) {
    peta = {};
    var lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 7, lr - 1, 1).getValues().forEach(function (v, ix) { var kk = kunciResi_(v[0]); if (kk && !peta[kk]) peta[kk] = ix + 2; });
    if (SCAN_KTX_) SCAN_KTX_[kunciCache] = peta;
  }
  var row = peta[kunciResi_(noResi)];
  if (!row) return null;
  sh.getRange(row, 10).setValue(true);
  sh.getRange(row, 11).setValue(waktu);
  return String(sh.getRange(row, 5).getValue() || '');
}

// Sync order Shopee - BEDA dari TikTok yang 1x panggil API langsung dapat detail lengkap,
// Shopee API-nya 2 TAHAP: (1) get_order_list cuma dapat daftar order_sn + status ringkas,
// (2) get_order_detail buat ambil rincian lengkap (max 50 order_sn per panggilan).
// Juga beda batasan: rentang waktu MAKSIMAL 15 hari per panggilan (aturan resmi Shopee),
// jadi sync PERTAMA KALI ambil 15 hari terakhir aja (bukan histori semua kayak TikTok).
// Fallback ambil tracking number - dipanggil HANYA kalau package_list di response order
// detail nggak punya tracking_number. Sama kayak TikTok, order yang baru "Siap Dikirim"
// kadang belum langsung ke-assign nomor resi di response order utama, harus ditarik terpisah
// lewat endpoint resmi logistics.get_tracking_number.
function ambilTrackingNumberShopee(orderSn, accessToken, shopId) {
  if (!orderSn) return '';
  try {
    var path = '/api/v2/logistics/get_tracking_number';
    var timestamp = Math.floor(Date.now() / 1000);
    var signature = buatSignatureShopee(path, timestamp, accessToken, shopId);
    var url = getShopeeHost() + path +
      '?partner_id=' + getShopeePartnerId() +
      '&timestamp=' + timestamp +
      '&sign=' + signature +
      '&access_token=' + accessToken +
      '&shop_id=' + shopId +
      '&order_sn=' + encodeURIComponent(orderSn) +
      '&response_optional_fields=' + encodeURIComponent('plp_number,first_mile_tracking_number,last_mile_tracking_number');
    var res = fetchHemat(url, { method: 'get', muteHttpExceptions: true });
    var parsed = JSON.parse(res.getContentText());
    if (!parsed.error && parsed.response) {
      // v2026.10.23 (DN-071646-606): sebagian kurir (mis. SiCepat) nomornya ada di last/first mile, bukan tracking_number
      var rp = parsed.response;
      return String(rp.tracking_number || rp.last_mile_tracking_number || rp.first_mile_tracking_number || '').trim();
    }
  } catch (e) { /* gagal ambil tracking - biarin kosong, jangan gagalin sync order-nya */ }
  return '';
}

var SYNC_TUMPANG_DETIK_ = 1800; // v2026.10.25: jendela tumpang-tindih sync pesanan Shopee & TikTok
function prosesSyncPesananShopee(data) {
  var result = { success: false };
  if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; }
  // OPTIMASI: mutex khusus sync Shopee - ScriptLock tidak lagi dipegang selama UrlFetch
  var mutex = kunciSinkronAmbil_('ORDER_SHOPEE');
  if (!mutex) {
    result.success = true; result.sedangJalan = true; result.jumlahBaru = 0; result.jumlahStatusDiupdate = 0;
    result.pesan = 'Sinkron pesanan Shopee sedang berjalan di proses lain - dilewati.';
    return result;
  }
  try {
    // Token diambil dari CacheService - fetch token baru HANYA kalau mau expired (lihat ambilKredensialShopee)
    var kred = ambilKredensialShopee();
    var props = PropertiesService.getScriptProperties();
    var accessToken = kred.accessToken;
    var shopId = kred.shopId;
    if (!accessToken || !shopId) throw new Error('Shopee belum terhubung. Selesaikan otorisasi dulu di Pengaturan.');
    var anggaranTracking = { sisa: TRACKING_FALLBACK_MAKS_PER_JALAN }; // batas "ambil resi satu-satu" per sync

    var waktuMulai = Date.now();
    var BATAS_WAKTU_MS = 4.5 * 60 * 1000; // stop di 4.5 menit, kasih ruang aman dari batas 6 menit Apps Script

    var waktuSyncTerakhir = props.getProperty('SHOPEE_WAKTU_SYNC_TERAKHIR');
    var timeTo = Math.floor(waktuMulai / 1000);
    // v2026.10.25 (Paket 12, DN-261019-072955-928): mundur 30 menit dari titik sync terakhir (tumpang-tindih) -
    // pesanan yang telat muncul di daftar API Shopee tidak terlewat selamanya. Pesanan yang sudah ada dilewati (dedup).
    var timeFrom = waktuSyncTerakhir ? parseInt(waktuSyncTerakhir, 10) - SYNC_TUMPANG_DETIK_ : (timeTo - 15 * 24 * 60 * 60);
    if (timeTo - timeFrom > 15 * 24 * 60 * 60) timeFrom = timeTo - (15 * 24 * 60 * 60 - 60); // jaga2 dikit di bawah batas 15 hari Shopee

    // ===== TAHAP 1 (TANPA LOCK): get_order_list - cuma dapat order_sn + status =====
    var semuaOrderSn = [];
    var cursor = '';
    var lebihBanyakLagi = false;
    do {
      var pathList = '/api/v2/order/get_order_list';
      var timestampList = Math.floor(Date.now() / 1000);
      var signatureList = buatSignatureShopee(pathList, timestampList, accessToken, shopId);
      var urlList = getShopeeHost() + pathList +
        '?partner_id=' + getShopeePartnerId() +
        '&timestamp=' + timestampList +
        '&sign=' + signatureList +
        '&access_token=' + accessToken +
        '&shop_id=' + shopId +
        '&time_range_field=create_time' +
        '&time_from=' + timeFrom +
        '&time_to=' + timeTo +
        '&page_size=100' +
        (cursor ? '&cursor=' + encodeURIComponent(cursor) : '');

      var resList = fetchHemat(urlList, { method: 'get', muteHttpExceptions: true });
      var parsedList = JSON.parse(resList.getContentText());
      if (parsedList.error) throw new Error('Gagal ambil daftar order Shopee: ' + (parsedList.message || parsedList.error));

      var listHalamanIni = (parsedList.response && parsedList.response.order_list) || [];
      listHalamanIni.forEach(function (o) { semuaOrderSn.push(o.order_sn); });
      lebihBanyakLagi = !!(parsedList.response && parsedList.response.more);
      cursor = (parsedList.response && parsedList.response.next_cursor) || '';
    } while (lebihBanyakLagi && cursor && (Date.now() - waktuMulai) < BATAS_WAKTU_MS);

    // Dedup terhadap sheet SEBELUM manggil get_order_detail - biar hemat kuota (baca saja, tanpa lock)
    var sh = getPesananShopeeSheet();
    var lastRow = sh.getLastRow();
    var idSudahAda = {};
    if (lastRow > 1) {
      sh.getRange(2, 1, lastRow - 1, 1).getValues().forEach(function (row) { idSudahAda[String(row[0])] = true; });
    }
    var orderSnBaru = semuaOrderSn.filter(function (sn) { if (idSudahAda[sn]) return false; idSudahAda[sn] = true; return true; }); // sekalian buang order_sn dobel

    // ===== TAHAP 2 (TANPA LOCK): get_order_detail - batch max 50 order_sn per panggilan =====
    var rencanaBaru = []; // { id, baris, ledger, detail }
    var UKURAN_BATCH = 50;
    var berhentiKarenaWaktu = false;
    for (var i = 0; i < orderSnBaru.length; i += UKURAN_BATCH) {
      if ((Date.now() - waktuMulai) > BATAS_WAKTU_MS) { berhentiKarenaWaktu = true; break; }
      var batch = orderSnBaru.slice(i, i + UKURAN_BATCH);
      var pathDetail = '/api/v2/order/get_order_detail';
      var timestampDetail = Math.floor(Date.now() / 1000);
      var signatureDetail = buatSignatureShopee(pathDetail, timestampDetail, accessToken, shopId);
      var fieldsOptional = SHOPEE_FIELD_PEMBELI_ + ',item_list,total_amount,shipping_carrier,order_status,note,package_list';
      var urlDetail = getShopeeHost() + pathDetail +
        '?partner_id=' + getShopeePartnerId() +
        '&timestamp=' + timestampDetail +
        '&sign=' + signatureDetail +
        '&access_token=' + accessToken +
        '&shop_id=' + shopId +
        '&order_sn_list=' + encodeURIComponent(batch.join(',')) +
        '&response_optional_fields=' + encodeURIComponent(fieldsOptional);

      var resDetail = fetchHemat(urlDetail, { method: 'get', muteHttpExceptions: true });
      var parsedDetail = JSON.parse(resDetail.getContentText());
      if (parsedDetail.error) throw new Error('Gagal ambil detail order Shopee: ' + (parsedDetail.message || parsedDetail.error));

      var ordersDetail = (parsedDetail.response && parsedDetail.response.order_list) || [];
      ordersDetail.forEach(function (o) { rencanaBaru.push(spRencanaDariOrderShopee_(o, accessToken, shopId, anggaranTracking)); });
    }

    // ===== TAHAP 3 (LOCK SINGKAT): tulis pesanan baru + ledger + detail sekaligus =====
    var jumlahBaru = 0;
    if (rencanaBaru.length) {
      denganKunciTulis_(function () {
        var lr = sh.getLastRow();
        var adaSekarang = {};
        if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r) { adaSekarang[String(r[0])] = true; });
        var tulisBaru = rencanaBaru.filter(function (r) { return !adaSekarang[r.id]; }); // anti dobel
        if (!tulisBaru.length) return;
        var barisBaru = tulisBaru.map(function (r) { return r.baris; });
        var ledgerSemua = [], detailSemua = [];
        tulisBaru.forEach(function (r) { ledgerSemua = ledgerSemua.concat(r.ledger); detailSemua = detailSemua.concat(r.detail); });
        var awal = sh.getLastRow() + 1;
        sh.getRange(awal, 7, barisBaru.length, 1).setNumberFormat('@'); // No Resi = teks (nol depan SiCepat aman)
        sh.getRange(awal, 1, barisBaru.length, 17).setValues(barisBaru);
        try { tambahBarisBatch_(getStockLedgerSheet(), ledgerSemua); } catch (eDeduct) { }
        try { tambahBarisBatch_(getPesananMarketplaceDetailSheet('Pesanan Shopee Detail'), detailSemua); } catch (eDetail) { }
        jumlahBaru = barisBaru.length;
        SpreadsheetApp.flush();
        invalidasiCacheGabunganPesanan();
      }, 20000, ['penjualan', 'stok']);
    }

    result.success = true;
    result.jumlahBaru = jumlahBaru;
    result.jumlahDitemukan = semuaOrderSn.length;
    // Update status pesanan LAMA yang masih aktif. Dari trigger otomatis: maks 1x per 15 menit & ditunda kalau kuota menipis.
    var infoStatusShopee = { resiTerupdate: 0 };
    var bolehCekStatusShopee = !data.lewatiCekStatus && (!data.dariSistem || (!kuotaUrlFetchMenipis() && bolehJalanTiap('SHOPEE_STATUS_AKTIF', STATUS_AKTIF_JEDA_DETIK)));
    result.jumlahStatusDiupdate = bolehCekStatusShopee ? prosesUpdateStatusPesananAktifShopee(accessToken, shopId, anggaranTracking, infoStatusShopee) : 0;
    result.jumlahResiTerupdate = infoStatusShopee.resiTerupdate;
    result.masihAdaLagi = lebihBanyakLagi || berhentiKarenaWaktu; // true = masih ada sisa, perlu klik Sync lagi buat lanjutin

    // Simpan "titik awal" sync berikutnya - TAPI cuma kalau nggak berhenti di tengah jalan, biar nggak ada yang kelewat
    if (!result.masihAdaLagi) {
      props.setProperty('SHOPEE_WAKTU_SYNC_TERAKHIR', String(timeTo));
    }
  } catch (err) {
    result.error = err.toString();
  } finally { kunciSinkronLepas_('ORDER_SHOPEE', mutex); }
  return result;
}

// v2026.10.25 (Paket 12): penyusun 1 baris pesanan Shopee (dipakai sync rutin DAN penambahan pesanan yang terlewat)
function spRencanaDariOrderShopee_(o, accessToken, shopId, anggaranTracking) {
  var ringkasProduk = (o.item_list || []).map(function (it) {
    return it.item_name + (it.model_name ? ' (' + it.model_name + ')' : '');
  }).join('; ');
  var pb = shopeeEkstrakPembeli_(o); // data pembeli akurat (per field, cadangan komponen alamat)

  // Auto-potong stock + rincian per-SKU - dikumpulkan, ditulis sekali di fase tulis
  var ledger = [], detail = [];
  (o.item_list || []).forEach(function (li) {
    var sellerSkuAsli = String(li.model_sku || li.item_sku || '').trim();
    if (!sellerSkuAsli) return;
    var qtyTerjual = parseFloat(li.model_quantity_purchased || 1) || 1;
    // SKU bundling (mis. "SKU1+SKU2") dipecah -> stok tiap SKU Gudang induk dipotong sendiri-sendiri
    pecahSkuPesananBundling_(sellerSkuAsli, qtyTerjual).forEach(function (b) {
      ledger.push([new Date(o.create_time * 1000), b.sku, 'Terjual Online', b.qty, 'Auto: terjual Shopee Order ' + o.order_sn + (b.bundling ? ' (bundling ' + sellerSkuAsli + ')' : ''), 'Sistem (Auto Shopee)']);
      detail.push([o.order_sn, b.sku, b.qty]);
    });
  });

  var baris = [
    o.order_sn,
    new Date(o.create_time * 1000),
    ringkasProduk,
    parseFloat(o.total_amount) || 0,
    o.order_status || '-',
    o.shipping_carrier || '-',
    (o.package_list && o.package_list[0] && o.package_list[0].tracking_number) || ambilTrackingShopeeHemat(o.order_sn, o.order_status, accessToken, shopId, anggaranTracking) || '-',
    pb.namaAsli || '-',
    pb.hpAsli || '-',
    pb.alamatAsli || '-',
    // Nama/HP/Alamat "Manual" langsung terisi kalau Shopee TIDAK menyamarkan field itu
    // (admin tetap bisa menimpa; field tersamar dibiarkan kosong untuk diisi manual)
    pb.nama, pb.hp, pb.alamat,
    o.note || '',
    pb.username || '', // Username Manual - kesimpen di sini biar konsisten sama kolom TikTok
    'Shopee',
    o.order_status === 'COMPLETED' ? new Date() : '' // Tanggal Jadi Selesai
  ];
  baris[6] = resiTeks_(baris[6], baris[5]) || '-';
  return { id: String(o.order_sn), baris: baris, ledger: ledger, detail: detail };
}

// BARU - Shopee sebelumnya nggak punya mekanisme refresh status pesanan aktif kayak TikTok,
// jadi sekali disync, status pesanan nggak pernah dicek ulang. Ini nyamain pola TikTok:
// cek ulang pesanan yang masih aktif (bukan Selesai/Batal), pakai get_order_detail batch 50.
function prosesUpdateStatusPesananAktifShopee(accessToken, shopId, anggaranTracking, info) {
  // Cek ulang pesanan yang masih aktif (bukan Selesai/Batal) pakai get_order_detail BATCH 50.
  // Sekalian isi No Resi yang masih kosong dari package_list (tanpa panggilan tambahan).
  anggaranTracking = anggaranTracking || { sisa: TRACKING_FALLBACK_MAKS_PER_JALAN };
  info = info || { resiTerupdate: 0 };
  var sh = getPesananShopeeSheet();
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return 0;

  var batasUmurMs = Date.now() - STATUS_AKTIF_MAKS_UMUR_HARI * 24 * 60 * 60 * 1000;
  var vals = sh.getRange(2, 1, lastRow - 1, 7).getValues(); // No Pesanan, Tanggal, Produk, Total, Status, Kurir, No Resi
  var rowPesananAktif = [];
  for (var i = 0; i < vals.length; i++) {
    var status = String(vals[i][4] || '').trim().toUpperCase();
    if (!vals[i][0] || status === 'COMPLETED' || status === 'CANCELLED') continue;
    var tgl = vals[i][1];
    if (tgl instanceof Date && tgl.getTime() < batasUmurMs) continue; // pesanan lama nyangkut - nggak dicek tiap sync
    var resiLama = resiTeks_(vals[i][6], vals[i][5]);
    rowPesananAktif.push({ row: i + 2, orderSn: String(vals[i][0]), statusLama: status, resiKosong: !resiLama || resiLama === '-' });
  }
  if (rowPesananAktif.length === 0) return 0;
  rowPesananAktif = urutkanPrioritasAktif_(rowPesananAktif, 'PRIORITAS_OFFSET_SHOPEE', MAKS_BATCH_STATUS_PER_JALAN * 50);

  // ===== FASE 1 (TANPA LOCK): get_order_detail batch 50, kumpulkan hasil =====
  var hasil = {}; // orderSn -> { status, resi }
  var UKURAN_BATCH = 50; // batas maksimal Shopee per panggilan get_order_detail
  for (var b = 0; b < rowPesananAktif.length; b += UKURAN_BATCH) {
    if (b / UKURAN_BATCH >= MAKS_BATCH_STATUS_PER_JALAN) break; // sisanya kebagian di jadwal berikutnya
    var batch = rowPesananAktif.slice(b, b + UKURAN_BATCH);
    try {
      var pathDetail = '/api/v2/order/get_order_detail';
      var timestampDetail = Math.floor(Date.now() / 1000);
      var signatureDetail = buatSignatureShopee(pathDetail, timestampDetail, accessToken, shopId);
      var orderSnList = batch.map(function (r) { return r.orderSn; }).join(',');
      var urlDetail = getShopeeHost() + pathDetail +
        '?partner_id=' + getShopeePartnerId() +
        '&timestamp=' + timestampDetail +
        '&sign=' + signatureDetail +
        '&access_token=' + accessToken +
        '&shop_id=' + shopId +
        '&order_sn_list=' + encodeURIComponent(orderSnList) +
        '&response_optional_fields=' + encodeURIComponent('order_status,package_list');

      var res = fetchHemat(urlDetail, { method: 'get', muteHttpExceptions: true });
      var parsed = JSON.parse(res.getContentText());
      if (parsed.error) continue; // lewati batch ini kalau gagal, jangan sampai gagalin semuanya

      var perSn = {};
      ((parsed.response && parsed.response.order_list) || []).forEach(function (o) { perSn[o.order_sn] = o; });
      batch.forEach(function (r) {
        var o = perSn[r.orderSn];
        if (!o || !o.order_status) return;
        var resiBaru = (o.package_list && o.package_list[0] && o.package_list[0].tracking_number) || '';
        // Cadangan satu-per-satu HANYA kalau batch nggak bawa resi, resi di sheet masih kosong, dst (dibatasi anggaran)
        if (!resiBaru && r.resiKosong) resiBaru = ambilTrackingShopeeHemat(r.orderSn, o.order_status, accessToken, shopId, anggaranTracking);
        hasil[r.orderSn] = { status: String(o.order_status), resi: resiBaru || '' };
      });
    } catch (e) {
      if (urlFetchSedangDiblokir()) break; // kuota habis - berhenti, jangan lanjut batch lain
      continue;
    }
  }
  if (!Object.keys(hasil).length) return 0;

  // ===== FASE 2 (LOCK SINGKAT): baca ulang posisi baris, tulis hanya yang berubah, per blok =====
  var jumlahDiupdate = 0;
  denganKunciTulis_(function () {
    var lr = sh.getLastRow();
    if (lr < 2) return;
    var v = sh.getRange(2, 1, lr - 1, 7).getValues();
    var tglSelesai = sh.getRange(2, 17, lr - 1, 1).getValues();
    var petaStatus = {}, petaResi = {}, petaTgl = {}, sudah = {};
    v.forEach(function (r, i) {
      var sn = String(r[0] || '').trim();
      var h = sn && hasil[sn];
      if (!h || sudah[sn]) return;
      sudah[sn] = true;
      var row = i + 2;
      if (h.status.toUpperCase() !== String(r[4] || '').trim().toUpperCase()) { petaStatus[row] = h.status; jumlahDiupdate++; }
      var resiSkrg = resiTeks_(r[6], r[5]);
      if (h.resi && !resiSama_(resiSkrg, h.resi)) {
        petaResi[row] = String(h.resi);
        if (!resiSkrg || resiSkrg === '-') info.resiTerupdate++;
      }
      if (h.status === 'COMPLETED' && !tglSelesai[i][0]) petaTgl[row] = new Date();
    });
    var n = tulisSelPerBlok_(sh, 5, petaStatus, false) + tulisSelPerBlok_(sh, 7, petaResi, true) + tulisSelPerBlok_(sh, 17, petaTgl, false);
    if (n) { SpreadsheetApp.flush(); invalidasiCacheGabunganPesanan(); }
  }, 20000);
  return jumlahDiupdate;
}

// Trigger otomatis - dipanggil tiap 5 menit (sama jadwalnya kayak TikTok Shop)
function prosesSyncPesananShopeeOtomatis() {
  if (urlFetchSedangDiblokir()) { Logger.log('⏸ Sync Shopee dilewati - kuota UrlFetch lagi habis (rem darurat aktif).'); return { success: false, error: 'Kuota UrlFetch habis' }; }
  var hasil = prosesSyncPesananShopee({ dariSistem: true });
  Logger.log('Sync otomatis Pesanan Shopee: ' + JSON.stringify(hasil));
  // Retur Shopee cukup tiap ~10 menit
  try {
    var propsRS = PropertiesService.getScriptProperties();
    var wRS = propsRS.getProperty('WAKTU_SYNC_RETUR_SHOPEE_TERAKHIR');
    if ((!wRS || (Date.now() - parseInt(wRS, 10)) > 10 * 60 * 1000) && !kuotaUrlFetchMenipis()) {
      Logger.log('Sync otomatis Retur Shopee: ' + JSON.stringify(prosesSyncReturShopee({ dariSistem: true })));
    }
  } catch (eRS) { Logger.log('Gagal sync retur Shopee otomatis: ' + eRS.toString()); }
  return hasil;
}

// JALANKAN INI SEKALI SAJA (klik ▶ Run manual di editor) buat mengaktifkan sync otomatis tiap 5 menit.
function aktifkanSyncOtomatisShopee() {
  hapusSyncOtomatisShopee();
  ScriptApp.newTrigger('prosesSyncPesananShopeeOtomatis')
    .timeBased()
    .everyMinutes(5)
    .create();
  Logger.log('✅ Sync otomatis Shopee AKTIF - bakal jalan sendiri tiap 5 menit dari sekarang.');
}

// Jalankan ini kalau mau MATIKAN sync otomatis Shopee.
function hapusSyncOtomatisShopee() {
  var triggers = ScriptApp.getProjectTriggers();
  var dihapus = 0;
  triggers.forEach(function (t) {
    if (t.getHandlerFunction() === 'prosesSyncPesananShopeeOtomatis') {
      ScriptApp.deleteTrigger(t);
      dihapus++;
    }
  });
  Logger.log(dihapus > 0 ? '✅ ' + dihapus + ' trigger lama dihapus.' : 'Nggak ada trigger aktif buat dihapus.');
}

// Sama persis pola prosesInputDataPembeliTikTok - posisi kolom (11-14 Manual+Catatan, 15 Username)
// SENGAJA disamain biar konsisten, walau buat Shopee ini opsional dipakai (data Shopee biasanya
// nggak tersamar separah TikTok Shipping, tapi tetap disediakan buat jaga-jaga/pelengkap).
function prosesInputDataPembeliShopee(data) {
  var row;
  return withTransaction(data.email, 'buatInvoice', 'penjualan', function () {
    var result = { success: false };
    var sh = getPesananShopeeSheet();
    // v2026.10.43: nomor baris dari browser bisa basi (baris bergeser) -> dicocokkan ulang dengan No Pesanan
    if (data.noPesanan) {
      var noP = String(data.noPesanan).trim(), lrP = sh.getLastRow();
      var diBaris = row >= 2 && row <= lrP ? String(sh.getRange(row, 1).getValue() || '').trim() : '';
      if (diBaris !== noP) {
        row = 0;
        if (lrP > 1) sh.getRange(2, 1, lrP - 1, 1).getValues().some(function (x, i) { if (String(x[0] || '').trim() === noP) { row = i + 2; return true; } return false; });
        if (!row) throw new Error('Pesanan ' + noP + ' tidak ditemukan.');
      }
    }
    if (row > sh.getLastRow()) throw new Error('Pesanan tidak ditemukan.');

    sh.getRange(row, 11, 1, 4).setValues([[
      data.namaManual || '', data.hpManual || '', data.alamatManual || '', data.catatan || ''
    ]]);
    sh.getRange(row, 15).setValue(data.usernameManual || '');
    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();
    try { CacheService.getScriptCache().remove('WA_FU_PESANAN_V1__meta'); } catch (eW) { }
    result.success = true;
    result.row = row;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      row = parseInt(data.row, 10);
      if (!row || row < 2) throw new Error('Baris tidak valid');
    }
  });
}

function prosesLihatPesananShopee(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getPesananShopeeSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    var tz = Session.getScriptTimeZone();
    if (lastRow > 1) {
      sh.getRange(2, 1, lastRow - 1, 16).getValues().forEach(function (row, idx) {
        if (!row[0]) return;
        daftar.push({
          row: idx + 2,
          noPesanan: row[0],
          tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy HH:mm') : String(row[1] || '-'),
          tanggalMs: row[1] instanceof Date ? row[1].getTime() : 0,
          produk: row[2], total: parseFloat(row[3]) || 0, status: row[4], kurir: row[5], noResi: resiTeks_(row[6], row[5]),
          namaTersamar: row[7], hpTersamar: row[8], alamatTersamar: row[9],
          namaManual: row[10], hpManual: row[11], alamatManual: row[12],
          catatan: row[13], usernameManual: row[14], channelAsli: row[15]
        });
      });
    }
    daftar.reverse(); // terbaru duluan
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Fallback ambil tracking number - dipanggil HANYA kalau field tracking_number di response
// order detail kosong. Order yang baru masuk status "Siap Dikirim" kadang belum langsung
// ke-assign nomor resi di response order utama, jadi harus ditarik terpisah lewat endpoint
// Get Package Detail (fulfillment/202309/packages/{package_id}).
function ambilTrackingNumberPaketTikTok(packageId, accessToken, shopCipher) {
  if (!packageId || packageId === '-') return '';
  try {
    var path = '/fulfillment/202309/packages/' + packageId;
    var timestamp = String(Math.floor(Date.now() / 1000));
    var paramsUntukSign = { app_key: getTiktokAppKey(), timestamp: timestamp, shop_cipher: shopCipher };
    var signature = buatSignatureTikTok(path, paramsUntukSign, '');
    var url = 'https://open-api.tiktokglobalshop.com' + path +
      '?app_key=' + encodeURIComponent(getTiktokAppKey()) +
      '&shop_cipher=' + encodeURIComponent(shopCipher) +
      '&timestamp=' + timestamp +
      '&sign=' + signature;
    var res = fetchHemat(url, { method: 'get', headers: { 'x-tts-access-token': accessToken }, muteHttpExceptions: true });
    var parsed = JSON.parse(res.getContentText());
    if (parsed.code === 0 && parsed.data) {
      return parsed.data.tracking_number || '';
    }
  } catch (e) { /* gagal ambil tracking - biarin kosong, jangan gagalin sync order-nya */ }
  return '';
}

function prosesSyncPesananTikTokShop(data) {
  var result = { success: false };
  // Kalau dipanggil dari Trigger otomatis (bukan user via web), data.dariSistem = true, lewati cekIzin
  if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; }
  // OPTIMASI: mutex khusus sync TikTok (bukan ScriptLock) - trigger 5 menit & sinkron penuh tidak jalan dobel,
  // dan simpan data user TIDAK ikut tertahan selama UrlFetch ke TikTok berjalan.
  var mutex = kunciSinkronAmbil_('ORDER_TIKTOK');
  if (!mutex) {
    result.success = true; result.sedangJalan = true; result.jumlahBaru = 0; result.jumlahDiupdate = 0;
    result.pesan = 'Sinkron pesanan TikTok sedang berjalan di proses lain - dilewati.';
    return result;
  }
  try {
    var props = PropertiesService.getScriptProperties();
    var accessToken = props.getProperty('TIKTOK_ACCESS_TOKEN');
    var shopCipher = props.getProperty('TIKTOK_SHOP_CIPHER');
    if (!accessToken || !shopCipher) throw new Error('TikTok Shop belum terhubung. Hubungi developer buat otorisasi ulang.');
    var anggaranTracking = { sisa: TRACKING_FALLBACK_MAKS_PER_JALAN }; // batas "ambil resi satu-satu" per sync

    var path = '/order/202309/orders/search';
    var waktuMulai = Date.now();
    var BATAS_WAKTU_MS = 4.5 * 60 * 1000; // stop di 4.5 menit, kasih ruang aman dari batas 6 menit Apps Script

    // Cuma minta pesanan yang dibuat SETELAH sync terakhir - biar nggak scan ulang semua tiap kali.
    // Sync PERTAMA KALI (belum ada catatan waktu) tetap ambil SEMUA histori dulu.
    var waktuSyncTerakhir = props.getProperty('TIKTOK_WAKTU_SYNC_TERAKHIR');
    var filterCreateTimeGe = waktuSyncTerakhir ? parseInt(waktuSyncTerakhir, 10) - SYNC_TUMPANG_DETIK_ : null; // v2026.10.25: tumpang-tindih 30 menit

    var semuaOrder = [];
    var nextPageToken = '';
    var jumlahHalaman = 0;

    // ===== FASE 1 (TANPA LOCK): tarik data dari API TikTok =====
    do {
      var bodyObjek = {};
      if (filterCreateTimeGe) bodyObjek.create_time_ge = filterCreateTimeGe;
      var bodyString = JSON.stringify(bodyObjek);
      var paramsUntukSign = {
        app_key: getTiktokAppKey(),
        timestamp: String(Math.floor(Date.now() / 1000)),
        shop_cipher: shopCipher,
        version: '202309',
        page_size: '100'
      };
      if (nextPageToken) paramsUntukSign.page_token = nextPageToken;
      var signature = buatSignatureTikTok(path, paramsUntukSign, bodyString);

      var url = 'https://open-api.tiktokglobalshop.com' + path +
        '?app_key=' + encodeURIComponent(getTiktokAppKey()) +
        '&shop_cipher=' + encodeURIComponent(shopCipher) +
        '&timestamp=' + paramsUntukSign.timestamp +
        '&version=' + paramsUntukSign.version +
        '&page_size=' + paramsUntukSign.page_size +
        (nextPageToken ? '&page_token=' + encodeURIComponent(nextPageToken) : '') +
        '&sign=' + signature;

      var res = fetchHemat(url, {
        method: 'post', contentType: 'application/json', payload: bodyString,
        headers: { 'x-tts-access-token': accessToken }, muteHttpExceptions: true
      });
      if (res.getResponseCode() !== 200) throw new Error('Gagal ambil data TikTok Shop (halaman ' + (jumlahHalaman + 1) + '): ' + res.getContentText());

      var parsed = JSON.parse(res.getContentText());
      var ordersHalamanIni = (parsed.data && parsed.data.orders) || [];
      semuaOrder = semuaOrder.concat(ordersHalamanIni);
      nextPageToken = (parsed.data && parsed.data.next_page_token) || '';
      jumlahHalaman++;

    } while (nextPageToken && (Date.now() - waktuMulai) < BATAS_WAKTU_MS);

    var berhentiKarenaWaktu = !!nextPageToken; // kalau masih ada token tersisa pas keluar loop, berarti berhenti karena waktu, bukan karena udah abis
    var orders = semuaOrder;

    // ===== FASE 2 (TANPA LOCK): baca sheet & susun rencana tulis (termasuk fallback ambil resi via API) =====
    var sh = getPesananTikTokShopSheet();
    var lastRow = sh.getLastRow();
    var idSudahAda = {};
    var resiKosongPerId = {}; // order lama yang No Resi-nya masih kosong/strip
    if (lastRow > 1) {
      var idVals = sh.getRange(2, 1, lastRow - 1, 7).getValues(); // kolom 1=OrderID, 7=NoResi
      idVals.forEach(function (row) {
        var orderId = typeof row[0] === 'number' ? kunciResi_(row[0]) : String(row[0] || '').trim();
        if (!orderId) return;
        idSudahAda[orderId] = true;
        var noResiSaatIni = resiTeks_(row[6], row[5]);
        if (!noResiSaatIni || noResiSaatIni === '-') resiKosongPerId[orderId] = true;
      });
    }

    var resiUpdatePerId = {}; // orderId -> resi baru (order lama yang resinya tadinya kosong)
    var rencanaBaru = [];     // { id, baris, ledger:[], detail:[] }
    orders.forEach(function (o) {
      var idO = String(o.id);
      if (idSudahAda[idO]) {
        // Order lama yang resinya masih kosong: cek ulang resi (TANPA diproses ulang penuh -> stock tidak terpotong dobel)
        if (resiKosongPerId[idO]) {
          var packageIdExisting = (o.packages && o.packages.length > 0) ? o.packages[0].id : '-';
          var trackingBaru = o.tracking_number || ambilTrackingTikTokHemat(packageIdExisting, o.status, accessToken, shopCipher, anggaranTracking);
          if (trackingBaru) resiUpdatePerId[idO] = String(trackingBaru);
        }
        return;
      }
      idSudahAda[idO] = true; // jaga-jaga order yang sama muncul 2x di hasil API

      var ringkasProduk = (o.line_items || []).map(function (li) {
        return li.product_name + (li.sku_name ? ' (' + li.sku_name + ')' : '');
      }).join('; ');
      var totalOrder = o.payment ? parseFloat(o.payment.total_amount) || 0 : 0;
      var addr = o.recipient_address || {};
      var packageId = (o.packages && o.packages.length > 0) ? o.packages[0].id : '-';

      // Auto-potong stock + rincian per-SKU - DIKUMPULKAN dulu, ditulis sekali (bukan appendRow per item)
      var ledger = [], detail = [];
      (o.line_items || []).forEach(function (li) {
        var sellerSkuAsli = String(li.seller_sku || '').trim();
        if (!sellerSkuAsli) return;
        var qtyTerjual = parseFloat(li.qty || 1) || 1;
        // PENTING: pakai SKU Jual internal, bukan kode marketplace mentah. SKU bundling dipecah per SKU Gudang induk.
        pecahSkuPesananBundling_(sellerSkuAsli, qtyTerjual).forEach(function (b) {
          ledger.push([new Date(o.create_time * 1000), b.sku, 'Terjual Online', b.qty, 'Auto: terjual TikTok Shop Order ' + o.id + (b.bundling ? ' (bundling ' + sellerSkuAsli + ')' : ''), 'Sistem (Auto TikTok)']);
          detail.push([idO, b.sku, b.qty]);
        });
      });

      var baris = [
        idO,
        new Date(o.create_time * 1000),
        ringkasProduk,
        totalOrder,
        o.status || '-',
        o.shipping_provider || '-',
        o.tracking_number || ambilTrackingTikTokHemat(packageId, o.status, accessToken, shopCipher, anggaranTracking) || '-',
        addr.name || '-',
        addr.phone_number || '-',
        addr.full_address || '-',
        '', '', '', '', packageId,
        '', o.commerce_platform || 'TIKTOK_SHOP',
        o.status === 'COMPLETED' ? new Date() : '' // Tanggal Jadi Selesai - kalau udah COMPLETED pas pertama kali disync, langsung stamp
      ];
      baris[6] = resiTeks_(baris[6], baris[5]) || '-';
      rencanaBaru.push({ id: idO, baris: baris, ledger: ledger, detail: detail });
    });

    // ===== FASE 3 (LOCK SINGKAT): tulis semuanya sekaligus =====
    var jumlahResiTerupdate = 0, jumlahBaru = 0;
    if (rencanaBaru.length || Object.keys(resiUpdatePerId).length) {
      denganKunciTulis_(function () {
        var barisPerId = petaBarisPerId_(sh); // posisi baris dibaca ulang di dalam lock
        var petaResi = {};
        Object.keys(resiUpdatePerId).forEach(function (id) { if (barisPerId[id]) petaResi[barisPerId[id]] = resiUpdatePerId[id]; });
        jumlahResiTerupdate = tulisSelPerBlok_(sh, 7, petaResi, true);

        var tulisBaru = rencanaBaru.filter(function (r) { return !barisPerId[r.id]; }); // anti dobel
        if (tulisBaru.length) {
          var barisBaru = tulisBaru.map(function (r) { return r.baris; });
          var ledgerSemua = [], detailSemua = [];
          tulisBaru.forEach(function (r) { ledgerSemua = ledgerSemua.concat(r.ledger); detailSemua = detailSemua.concat(r.detail); });
          var awal = sh.getLastRow() + 1;
          sh.getRange(awal, 1, barisBaru.length, 1).setNumberFormat('@'); // Order ID 18 digit = teks (anti presisi hilang)
          sh.getRange(awal, 7, barisBaru.length, 1).setNumberFormat('@'); // No Resi = teks (nol depan SiCepat aman)
          sh.getRange(awal, 1, barisBaru.length, 18).setValues(barisBaru);
          try { tambahBarisBatch_(getStockLedgerSheet(), ledgerSemua); } catch (eDeduct) { /* gagal potong stock nggak boleh gagalin sync order */ }
          try { tambahBarisBatch_(getPesananMarketplaceDetailSheet('Pesanan TikTok Shop Detail'), detailSemua); } catch (eDetail) { }
          jumlahBaru = barisBaru.length;
        }
        if (jumlahBaru || jumlahResiTerupdate) { SpreadsheetApp.flush(); invalidasiCacheGabunganPesanan(); }
      }, 20000, ['penjualan', 'stok']);
    }

    result.success = true;
    result.jumlahBaru = jumlahBaru;
    result.jumlahResiTerupdate = jumlahResiTerupdate;
    result.jumlahTotal = orders.length;
    result.jumlahHalaman = jumlahHalaman;
    // Update status pesanan LAMA yang masih aktif (belum selesai/dibatalkan) - siapa tau statusnya udah berubah
    // Dari trigger otomatis: maks 1x per 15 menit & ditunda kalau kuota menipis. Sync manual dari web tetap langsung jalan.
    var bolehCekStatusTikTok = !data.lewatiCekStatus && (!data.dariSistem || (!kuotaUrlFetchMenipis() && bolehJalanTiap('TIKTOK_STATUS_AKTIF', STATUS_AKTIF_JEDA_DETIK)));
    var jumlahDiupdate = bolehCekStatusTikTok ? prosesUpdateStatusPesananAktifTikTok(accessToken, shopCipher, anggaranTracking) : 0;

    result.masihAdaLagi = berhentiKarenaWaktu; // true = masih ada pesanan lain, perlu klik Sync lagi buat lanjutin
    result.jumlahDiupdate = jumlahDiupdate;

    // Simpan waktu sekarang sebagai "titik awal" buat sync berikutnya - TAPI cuma kalau nggak lagi
    // berhenti di tengah jalan (masihAdaLagi), biar nggak ada pesanan yang kelewat.
    if (!berhentiKarenaWaktu) {
      props.setProperty('TIKTOK_WAKTU_SYNC_TERAKHIR', String(Math.floor(waktuMulai / 1000)));
    }
  } catch (err) {
    result.error = err.toString();
  } finally { kunciSinkronLepas_('ORDER_TIKTOK', mutex); }
  return result;
}

function prosesLihatPesananTikTokShop(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getPesananTikTokShopSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    var tz = Session.getScriptTimeZone();
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 17).getValues();
      for (var i = 0; i < vals.length; i++) {
        if (!vals[i][0]) continue;
        daftar.push({
          row: i + 2, orderId: String(vals[i][0]),
          tanggalObj: vals[i][1] instanceof Date ? vals[i][1] : null,
          tanggal: vals[i][1] instanceof Date ? Utilities.formatDate(vals[i][1], tz, 'dd MMM yyyy HH:mm') : '-',
          produk: vals[i][2], total: vals[i][3], status: vals[i][4], kurir: vals[i][5], noResi: resiTeks_(vals[i][6], vals[i][5]),
          namaTersamar: vals[i][7], hpTersamar: vals[i][8], alamatTersamar: vals[i][9],
          namaManual: vals[i][10], hpManual: vals[i][11], alamatManual: vals[i][12], catatan: vals[i][13],
          packageId: String(vals[i][14] || '-'), usernameManual: vals[i][15] || '',
          channelAsli: vals[i][16] || 'TIKTOK_SHOP'
        });
      }
    }

    // Filter waktu
    if (data.filterWaktu) {
      var sekarangF = new Date();
      var batasBawah = null;
      if (data.filterWaktu === 'hari_ini') { batasBawah = new Date(sekarangF.getFullYear(), sekarangF.getMonth(), sekarangF.getDate()); }
      else if (data.filterWaktu === 'kemarin') {
        batasBawah = new Date(sekarangF.getFullYear(), sekarangF.getMonth(), sekarangF.getDate() - 1);
        var batasAtasKemarin = new Date(sekarangF.getFullYear(), sekarangF.getMonth(), sekarangF.getDate());
        daftar = daftar.filter(function (d) { return d.tanggalObj && d.tanggalObj >= batasBawah && d.tanggalObj < batasAtasKemarin; });
        batasBawah = null; // udah difilter di atas, jangan difilter lagi di bawah
      }
      else if (data.filterWaktu === 'minggu_ini') { batasBawah = new Date(sekarangF); batasBawah.setDate(batasBawah.getDate() - 6); }
      else if (data.filterWaktu === 'bulan_ini') { batasBawah = new Date(sekarangF.getFullYear(), sekarangF.getMonth(), 1); }
      if (batasBawah) daftar = daftar.filter(function (d) { return d.tanggalObj && d.tanggalObj >= batasBawah; });
    }

    // Filter status
    if (data.filterStatus) {
      daftar = daftar.filter(function (d) { return d.status === data.filterStatus; });
    }

    // Sort
    var sortBy = data.sortBy || 'created_desc';
    daftar.sort(function (a, b) {
      if (sortBy === 'created_asc') return (a.tanggalObj || 0) - (b.tanggalObj || 0);
      if (sortBy === 'created_desc') return (b.tanggalObj || 0) - (a.tanggalObj || 0);
      if (sortBy === 'price_asc') return a.total - b.total;
      if (sortBy === 'price_desc') return b.total - a.total;
      return (b.tanggalObj || 0) - (a.tanggalObj || 0);
    });

    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesInputDataPembeliTikTok(data) {
  var result = { success: false };
  if (!cekIzin(data.email, 'buatInvoice')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; } // di luar lock
  var lock = kunciModul_('penjualan');
  try { lock.waitLock(15000); } catch (e) { result.error = 'Sistem sibuk, coba lagi.'; return result; }
  try {
    var row = parseInt(data.row, 10);
    if (!row || row < 2) throw new Error('Baris tidak valid');
    var sh = getPesananTikTokShopSheet();
    if (row > sh.getLastRow()) throw new Error('Pesanan tidak ditemukan.');

    sh.getRange(row, 11, 1, 4).setValues([[
      data.namaManual || '', data.hpManual || '', data.alamatManual || '', data.catatan || ''
    ]]);
    sh.getRange(row, 16).setValue(data.usernameManual || '');
    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();
    result.success = true;
  } catch (err) {
    result.error = err.toString();
  } finally { lepasKunci_(lock); }
  return result;
}

// Dipanggil dari tabel "Input Data Pembeli Massal" - simpan BANYAK baris pesanan sekaligus dalam
// satu request, biar nggak perlu klik simpan satu-satu per pesanan.
// data.daftar = [{ row, usernameManual, namaManual, hpManual, alamatManual, catatan }, ...]
function prosesSimpanDataPembeliMassal(data) {
  var result = { success: false };
  // Cek izin & validasi DI LUAR lock -> lock dipegang sesingkat mungkin
  if (!cekIzin(data.email, 'buatInvoice')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; }
  var daftar = data.daftar || [];
  if (!daftar.length) { result.error = 'Tidak ada data yang dikirim.'; return result; }
  // Kelompokkan per sumber/toko. Item tanpa "sumber" = TikTok Shop Waterground (perilaku lama, tidak berubah).
  var perSumber = { tiktok: [], shopee: [], conner: [], website: [], posales: [] };
  daftar.forEach(function (item) {
    var k = String(item.sumber || 'tiktok').toLowerCase();
    if (!perSumber[k]) k = 'tiktok';
    perSumber[k].push(item);
  });
  var lock = kunciModul_('penjualan');
  try { lock.waitLock(20000); } catch (e) { result.error = 'Sistem sibuk, coba lagi.'; return result; }
  try {
    result.tersimpan = [];
    var jumlahTersimpan = 0;
    // Konfigurasi kolom per sheet: kolom ID, kolom blok manual (Nama, HP, Alamat, Catatan), kolom username
    var konfig = {
      tiktok: { sheet: getPesananTikTokShopSheet(), kolId: 1, kolManual: 11, kolUser: 16 },
      shopee: { sheet: getPesananShopeeSheet(), kolId: 1, kolManual: 11, kolUser: 15 },
      conner: { sheet: getPesananConnerSheet(), kolId: 1, kolManual: 11, kolUser: 15 },
      website: { sheet: getPesananWebsiteSheet(), kolId: 1, website: true },
      posales: { sheet: getPesananManualSheets().header, kolId: 1, posales: true }
    };
    Object.keys(perSumber).forEach(function (k) {
      var items = perSumber[k];
      if (!items.length) return;
      var kf = konfig[k], sh = kf.sheet;
      var lastRow = sh.getLastRow();
      // Baris dicari ulang DI DALAM lock berdasarkan Order ID, supaya tidak salah tulis
      var idPerBaris = lastRow > 1 ? sh.getRange(2, kf.kolId, lastRow - 1, 1).getValues() : [];
      var barisPerId = {};
      idPerBaris.forEach(function (r, i) {
        var kk = typeof r[0] === 'number' ? kunciResi_(r[0]) : String(r[0] || '').trim();
        if (kk && !barisPerId[kk]) barisPerId[kk] = i + 2;
      });
      var petaManual = {}, petaUser = {}, petaNamaW = {}, petaCatW = {}, petaPO = {};
      items.forEach(function (item) {
        var row = parseInt(item.row, 10);
        if (item.orderId) {
          var kId = String(item.orderId).trim();
          var barisSaatIni = row >= 2 && row <= lastRow ? idPerBaris[row - 2][0] : null;
          var idSaatIni = typeof barisSaatIni === 'number' ? kunciResi_(barisSaatIni) : String(barisSaatIni || '').trim();
          if (idSaatIni !== kId) row = barisPerId[kId] || 0;
        }
        if (!row || row < 2 || row > lastRow) return;
        if (item.orderId) result.tersimpan.push(String(item.orderId));
        jumlahTersimpan++;
        if (kf.website) {
          // Website: Nama (3), HP (4), Alamat (5) | Catatan (9)
          petaNamaW[row] = [item.namaManual || '', item.hpManual || '', item.alamatManual || ''];
          petaCatW[row] = item.catatan || '';
        } else if (kf.posales) {
          // PO Sales / Manual Order: Nama Pembeli (16), No HP Pembeli (17) - data penerima tidak disentuh
          petaPO[row] = [item.namaManual || '', item.hpManual || ''];
        } else {
          petaManual[row] = [item.namaManual || '', item.hpManual || '', item.alamatManual || '', item.catatan || ''];
          petaUser[row] = item.usernameManual || '';
        }
      });
      if (kf.website) { tulisBarisPerBlok_(sh, 3, petaNamaW); tulisSelPerBlok_(sh, 9, petaCatW, false); }
      else if (kf.posales) { tulisBarisPerBlok_(sh, 16, petaPO); }
      else { tulisBarisPerBlok_(sh, kf.kolManual, petaManual); tulisSelPerBlok_(sh, kf.kolUser, petaUser, false); }
    });
    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();
    try { CacheService.getScriptCache().remove('WA_FU_PESANAN_V1__meta'); } catch (eW) { }
    result.success = true;
    result.jumlahTersimpan = jumlahTersimpan;
  } catch (err) {
    result.error = err.toString();
  } finally { lepasKunci_(lock); }
  return result;
}

/* ============================================================
   EKSTRAKSI DATA PEMBELI SHOPEE (v2.order.get_order_detail) - SATU sumber kebenaran
   Dipakai sinkron pesanan baru, tarik manual dari form, dan pengisi otomatis terjadwal.
   - Field diminta eksplisit: buyer_user_id, buyer_username, recipient_address
   - recipient_address: name, phone, full_address (+ town/district/city/state/zipcode sebagai cadangan
     kalau full_address kosong / tidak memuat kota)
   - Penyamaran Shopee (****) dinilai PER FIELD: field yang tersamar dikosongkan, field lain tetap dipakai
     (dulu satu field tersamar membuat semua field dibuang).
   ============================================================ */
var SHOPEE_FIELD_PEMBELI_ = 'buyer_user_id,buyer_username,recipient_address';
function shopeeTeksBersih_(v) { return String(v === null || v === undefined ? '' : v).replace(/[\u0000-\u001F\u00A0]+/g, ' ').replace(/\s{2,}/g, ' ').trim(); }
function shopeeTersamar_(v) { return /\*{2,}/.test(String(v || '')); }
function shopeeEkstrakPembeli_(o) {
  o = o || {};
  var a = o.recipient_address || {};
  var nama = shopeeTeksBersih_(a.name);
  var hp = shopeeTeksBersih_(a.phone).replace(/[^\d+*]/g, '');
  var alamat = shopeeTeksBersih_(a.full_address);
  var bagian = [a.town, a.district, a.city, a.state, a.zipcode].map(shopeeTeksBersih_).filter(function (x) { return x && !shopeeTersamar_(x); });
  if (!alamat || shopeeTersamar_(alamat)) {
    // full_address kosong / tersamar -> rakit dari komponen wilayah (tetap berguna untuk label kota)
    if (!alamat && bagian.length) alamat = bagian.join(', ');
  } else {
    // full_address ada tapi tidak memuat kota/provinsi -> lengkapi supaya label pengiriman akurat
    var lower = alamat.toLowerCase();
    var tambah = [a.city, a.state].map(shopeeTeksBersih_).filter(function (x) { return x && !shopeeTersamar_(x) && lower.indexOf(x.toLowerCase()) < 0; });
    if (tambah.length) alamat += ', ' + tambah.join(', ');
    var kodePos = shopeeTeksBersih_(a.zipcode);
    if (kodePos && !shopeeTersamar_(kodePos) && alamat.indexOf(kodePos) < 0) alamat += ' ' + kodePos;
  }
  var sNama = shopeeTersamar_(nama), sHp = shopeeTersamar_(hp), sAlamat = shopeeTersamar_(alamat);
  var hasil = {
    username: shopeeTersamar_(o.buyer_username) ? '' : shopeeTeksBersih_(o.buyer_username),
    buyerId: String(o.buyer_user_id || ''),
    nama: sNama ? '' : nama, hp: sHp ? '' : hp, alamat: sAlamat ? '' : alamat,
    namaAsli: nama, hpAsli: hp, alamatAsli: alamat,
    kota: shopeeTeksBersih_(a.city), provinsi: shopeeTeksBersih_(a.state), kodePos: shopeeTeksBersih_(a.zipcode),
    tersamarField: { nama: sNama, hp: sHp, alamat: sAlamat }
  };
  hasil.tersamarSebagian = sNama || sHp || sAlamat;
  // "tersamar" (kompatibel dengan frontend lama) = TIDAK ada satu pun data kontak yang bisa dipakai
  hasil.tersamar = !(hasil.nama || hasil.hp || hasil.alamat);
  return hasil;
}
// Ambil data pembeli untuk daftar order_sn (batch 50 sesuai batas Shopee). Batch yang gagal karena
// 1 order_sn tidak valid dipecah ulang supaya pesanan lain dalam batch tetap terambil.
// v2026.10.40 (Paket 24): field yang tersamar / kosong dicoba dari API cadangan (dokumen pengiriman, faktur pembeli)
// lalu dari data yang pernah ditangkap di sheet "Pembeli Shopee Lengkap"; hasil yang terisi disimpan ke sheet itu.
// opsi.tanpaCadangan = true -> perilaku lama (hanya get_order_detail).
function shopeeAmbilPembeliBatch_(daftar, kred, opsi) {
  opsi = opsi || {};
  var hasil = {}, peringatan = [], orders = {};
  var batasMs = opsi.batasMs || (Date.now() + 4 * 60 * 1000);
  function tarik(batch, kedalaman) {
    if (!batch.length || Date.now() > batasMs) return;
    var r = shopeeGet_('/api/v2/order/get_order_detail', { order_sn_list: batch.join(','), response_optional_fields: SHOPEE_FIELD_PEMBELI_ + ',package_list,order_status' }, kred);
    if (!r.ok) {
      var pesan = ((r.error || '') + ' ' + (r.pesan || '')).trim();
      if (batch.length > 1 && kedalaman < 3 && /param|order_sn|not.?found|invalid/i.test(pesan) && !/token|auth|sign|permission/i.test(pesan)) {
        var tengah = Math.ceil(batch.length / 2);
        tarik(batch.slice(0, tengah), kedalaman + 1);
        tarik(batch.slice(tengah), kedalaman + 1);
        return;
      }
      peringatan.push('Shopee: ' + pesan);
      if (opsi.lemparError) throw new Error('Gagal ambil data dari Shopee: ' + pesan);
      return;
    }
    ((r.json && r.json.response && r.json.response.order_list) || []).forEach(function (o) {
      if (!o || !o.order_sn) return;
      var sn = String(o.order_sn);
      var h = shopeeEkstrakPembeli_(o);
      h.status = String(o.order_status || '');
      ['kota', 'provinsi', 'kodePos'].forEach(function (f) { if (shopeeTersamar_(h[f])) h[f] = ''; }); // v2026.10.41: '****' bukan data
      h.sumber = {};
      ['nama', 'hp', 'alamat', 'username'].forEach(function (f) { if (h[f]) h.sumber[f] = 'get_order_detail'; });
      hasil[sn] = h; orders[sn] = o;
    });
  }
  for (var i = 0; i < daftar.length; i += 50) {
    tarik(daftar.slice(i, i + 50), 0);
    if (peringatan.length && /token|auth|sign|permission/i.test(peringatan[peringatan.length - 1])) break;
  }
  if (!opsi.tanpaCadangan && Object.keys(hasil).length) {
    try { spbLengkapiCadangan_(hasil, orders, kred, batasMs); } catch (eC) { peringatan.push('Cadangan: ' + (eC.message || eC)); }
    // Data yang pernah ditangkap saat pesanan masih aktif (sebelum Shopee menyamarkan)
    try {
      var kurang = Object.keys(hasil).filter(function (sn) { var h = hasil[sn]; return !(h.nama && h.hp && h.alamat && h.username) || !h.alamatPenagihan; });
      if (kurang.length) {
        var lama = spbBacaLengkap_(kurang);
        kurang.forEach(function (sn) {
          var h = hasil[sn], l = lama[sn];
          if (!l) return;
          ['username', 'nama', 'hp', 'alamat', 'kelurahan', 'kecamatan', 'kota', 'provinsi', 'kodePos', 'namaPenagihan', 'hpPenagihan', 'emailPenagihan', 'alamatPenagihan', 'npwp'].forEach(function (f) {
            if (!h[f] && l[f] && !shopeeTersamar_(l[f])) { h[f] = l[f]; if (/^(nama|hp|alamat|username)$/.test(f)) h.sumber[f] = 'tersimpan ' + (l.pertama || ''); }
          });
          spbHitungUlangTanda_(h);
        });
      }
    } catch (eL) { }
    try { p39LengkapiHpRiwayat_(hasil); } catch (eH) { } // v2026.10.57 (DN-385): HP tersamar -> riwayat pelanggan
    try { spbSimpanLengkap_(hasil); } catch (eS) { }
  }
  return { hasil: hasil, peringatan: peringatan };
}

/* ============================================================
   TARIK DATA PEMBELI SHOPEE OTOMATIS (API get_order_detail)
   data.daftar = ['ORDER_SN', ...] (maks 50 per panggilan). Mengembalikan username, nama, HP, alamat
   per pesanan + penanda "tersamar" (Shopee menyamarkan data setelah pesanan selesai/lama).
   Tidak menulis ke sheet - browser yang mengisi form, user tinggal Simpan.
   ============================================================ */
function prosesTarikDataPembeliShopee(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var daftar = (data.daftar || []).map(function (x) { return String(x || '').trim(); }).filter(Boolean);
    if (!daftar.length) throw new Error('Tidak ada No Pesanan Shopee.');
    var kred = ambilKredensialShopee();
    if (!kred.accessToken || !kred.shopId) throw new Error('Shopee belum terhubung. Selesaikan otorisasi dulu di Pengaturan.');
    var tarik = shopeeAmbilPembeliBatch_(daftar, kred, { lemparError: true });
    result.success = true;
    result.data = tarik.hasil;
    if (tarik.peringatan.length) result.peringatan = tarik.peringatan.join(' | ');
  } catch (err) { result.error = err.message || String(err); }
  return result;
}

/* ============================================================
   SEMUA PESANAN GABUNGAN - lintas channel (PO Sales + TikTok Shop, dst nanti)
   ============================================================ */
function prosesLihatSemuaPesananGabungan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    // Fungsi ini paling berat & paling sering dipanggil (Dashboard, Pantauan, tabel Pesanan,
    // polling tiap 20 detik) - tiap panggil baca ULANG semua sheet TikTok/Conner/Website.
    // Cache 20 detik biar panggilan yang beruntun (misal pindah Dashboard->Pantauan dalam
    // beberapa detik, atau bareng sama polling) pakai hasil yang sama, nggak baca ulang.
    // V3: cache besar (gzip + dipecah) - V2 dulu selalu gagal karena datanya > 100 KB.
    // data.segar = true -> lewati cache (dipakai setelah sinkron penuh / simpan data pembeli).
    var cacheKey = 'GABUNGAN_PESANAN_V3';
    if (!data.segar) {
      var dariCache = cacheBesarGet_(cacheKey);
      if (dariCache && dariCache.success) { dariCache.dariCache = true; return dariCache; }
    }

    var gabungan = [];
    var tz = Session.getScriptTimeZone();

    // SEMUA channel & toko digabung jadi 1 daftar - dibedakan lewat field "toko" per item
    // (bukan lagi lewat context switch). Ini biar kerja sehari-hari nggak perlu gonta-ganti toko terus.
    // semua: true -> JANGAN dibatasi 50 terakhir (dulu PO Sales lama nggak pernah muncul & nggak ikut dihitung di Laporan)
    var poSales = prosesLihatPesanan({ email: data.email, semua: true });
    if (poSales.success) {
      poSales.items.forEach(function (o) {
        gabungan.push({
          sumber: 'PO Sales', toko: o.toko || 'Waterground', tanggal: o.tanggal, ts: o.tanggalMs || 0, noReferensi: o.noInvoice,
          pembeli: o.namaPenerima, total: o.total || 0, status: o.status || 'Belum Dikirim', noResi: o.noResi || '-', rowPoSales: o.row,
          hpManual: o.hp || o.hpPembeli || '', kurir: o.kurir || '', alamatManual: o.alamat || '', namaManual: o.namaPembeli || ''
        });
      });
    }

    var tiktokData = prosesLihatPesananTikTokShop({ email: data.email });
    if (tiktokData.success) {
      tiktokData.daftar.forEach(function (o) {
        gabungan.push({
          sumber: (o.channelAsli === 'TOKOPEDIA') ? 'Tokopedia' : 'TikTok Shop', toko: 'Waterground', tanggal: o.tanggal,
          ts: o.tanggalObj instanceof Date ? o.tanggalObj.getTime() : 0, noReferensi: o.orderId,
          pembeli: p13NamaPembeli_(o.namaManual, o.namaTersamar, o.usernameManual),
          total: o.total || 0, status: o.status, noResi: o.noResi, rowTiktok: o.row, packageId: o.packageId,
          namaManual: o.namaManual, hpManual: o.hpManual, alamatManual: o.alamatManual, catatan: o.catatan,
          usernameManual: o.usernameManual, namaTersamar: o.namaTersamar, hpTersamar: o.hpTersamar, alamatTersamar: o.alamatTersamar,
          channelAsli: o.channelAsli, produk: o.produk, kurir: o.kurir
        });
      });
    }

    var shConner = getPesananConnerSheet();
    var lastRowConner = shConner.getLastRow();
    if (lastRowConner > 1) {
      var lebarConner = Math.min(Math.max(shConner.getLastColumn(), 10), 15);
      var valsConner = shConner.getRange(2, 1, lastRowConner - 1, lebarConner).getValues();
      valsConner.forEach(function (row, idxC) {
        var orderId = String(row[0] || '').trim();
        if (!orderId) return;
        var namaManualC = String(row[10] || '').trim();
        gabungan.push({
          sumber: 'TikTok Shop', toko: 'Conner', tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy HH:mm') : String(row[1] || ''),
          ts: row[1] instanceof Date ? row[1].getTime() : 0,
          noReferensi: orderId, pembeli: p13NamaPembeli_(namaManualC, row[7], lebarConner >= 15 ? row[14] : '', '(tersamar)'), total: parseFloat(row[3]) || 0,
          status: row[4], noResi: resiTeks_(row[6], row[5]) || '-', kurir: row[5], produk: row[2],
          namaTersamar: row[7] || '', hpTersamar: row[8], alamatTersamar: row[9] || '',
          namaManual: namaManualC, hpManual: String(row[11] || ''), alamatManual: String(row[12] || ''), catatan: String(row[13] || ''),
          usernameManual: String(row[14] || ''), rowConner: idxC + 2
        });
      });
    }

    var shopeeData = prosesLihatPesananShopee({ email: data.email });
    if (shopeeData.success) {
      shopeeData.daftar.forEach(function (o) {
        gabungan.push({
          sumber: 'Shopee', toko: 'Waterground', tanggal: o.tanggal, ts: o.tanggalMs || 0, noReferensi: String(o.noPesanan),
          pembeli: p13NamaPembeli_(o.namaManual, o.namaTersamar, o.usernameManual),
          total: o.total || 0, status: o.status, noResi: o.noResi, rowShopee: o.row,
          namaManual: o.namaManual, hpManual: o.hpManual, alamatManual: o.alamatManual, catatan: o.catatan,
          usernameManual: o.usernameManual, namaTersamar: o.namaTersamar, hpTersamar: o.hpTersamar, alamatTersamar: o.alamatTersamar,
          produk: o.produk, kurir: o.kurir, ekspor: shopeeEkspor_(o.usernameManual, o.namaTersamar) // v2026.10.50 (DN-300)
        });
      });
    }

    var shWebsite = getPesananWebsiteSheet();
    var lastRowWebsite = shWebsite.getLastRow();
    if (lastRowWebsite > 1) {
      var valsWebsite = shWebsite.getRange(2, 1, lastRowWebsite - 1, 9).getValues();
      valsWebsite.forEach(function (row, idxW) {
        var orderId = String(row[0] || '').trim();
        if (!orderId) return;
        gabungan.push({
          sumber: 'Website', toko: 'Waterground',
          tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy HH:mm') : String(row[1] || ''),
          ts: row[1] instanceof Date ? row[1].getTime() : 0,
          noReferensi: orderId, pembeli: row[2] || '-', hpManual: row[3], alamatManual: row[4],
          produk: row[5] || '-', total: parseFloat(row[6]) || 0, status: row[7] || 'Menunggu Pembayaran',
          noResi: '-', catatan: row[8] || '', namaManual: row[2] || '', rowWebsite: idxW + 2
        });
      });
    }

    // Pastikan ts terisi (fallback parse teks tanggal) & No Resi selalu STRING
    gabungan.forEach(function (o) {
      if (!o.ts) o.ts = msTanggalPesanan_(o);
      o.noResi = (o.noResi === null || o.noResi === undefined || o.noResi === '') ? '-' : String(o.noResi);
      o.noReferensi = String(o.noReferensi || '');
      o._sig = sigPesananStatis_(o); // tanda tangan data "statis" - dipakai sinkron delta di browser
    });
    result.success = true;
    result.daftar = gabungan.sort(function (a, b) { return (b.ts || 0) - (a.ts || 0); }); // terbaru dulu
    // Info kapan terakhir sync TikTok BENERAN selesai (baik dari trigger otomatis tiap menit,
    // maupun dari tombol Refresh Pesanan manual - dua-duanya update timestamp yang sama ini),
    // ditampilkan di sebelah tombol Refresh biar user tau data seberapa fresh.
    var waktuSyncTiktok = PropertiesService.getScriptProperties().getProperty('TIKTOK_WAKTU_SYNC_TERAKHIR');
    result.waktuSyncTerakhirTiktok = waktuSyncTiktok
      ? Utilities.formatDate(new Date(parseInt(waktuSyncTiktok, 10) * 1000), Session.getScriptTimeZone(), 'HH:mm')
      : null;

    cacheBesarPut_(cacheKey, result, 45); // 45 detik; setiap penulisan pesanan memanggil invalidasiCacheGabunganPesanan()
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   SINKRON PENUH TRANSAKSI PENJUALAN (model lama: cek SEMUA pesanan aktif)
   Dipanggil browser per kanal secara berurutan (tiktok -> shopee -> conner) supaya:
     - progres di layar nyata per kanal, dan
     - tiap request aman dari batas 6 menit Apps Script.
   Per kanal: (1) tarik pesanan baru, (2) cek status + resi SEMUA pesanan aktif (<= 30 hari,
   belum COMPLETED/CANCELLED) lewat API batch - tanpa batas batch/round-robin seperti trigger.
   Penulisan: baris dicari ulang DI DALAM lock (berdasarkan Order ID), status ditulis 1x setValues.
   data.otomatis = true (buka halaman) -> dilewati kalau kanal itu sudah dicek < 10 menit lalu
   (hemat kuota UrlFetch). Tombol 🔄 mengirim otomatis = false -> selalu jalan.
   ============================================================ */
/* ============================================================
   KUNCI MODULAR (mutex per modul/domain data) - PENGGANTI LockService.getScriptLock() GLOBAL
   Dulu 1 ScriptLock mengunci SELURUH sistem: simpan di Penjualan membuat input Gudang ikut antre.
   Sekarang tiap modul punya kunci sendiri di CacheService (key 'LOCK_MODUL_<modul>'), jadi modul
   yang berbeda bisa menyimpan BERSAMAAN.

   Kenapa masih ada ScriptLock di dalamnya? CacheService tidak punya operasi "cek-lalu-isi" yang
   atomik: dua request bisa sama-sama membaca "kosong" lalu sama-sama merasa memegang kunci.
   ScriptLock dipakai HANYA sebagai "gerbang" beberapa milidetik untuk operasi cek-lalu-isi itu,
   lalu langsung dilepas. Pekerjaan simpan yang sebenarnya hanya dijaga kunci modul.

   Pembagian modul berdasarkan DATA yang ditulis (bukan tampilan): fungsi yang menulis Stock Ledger
   memegang 'stok' juga, walaupun tombolnya ada di modul lain - supaya 2 proses tidak menulis ke
   baris terakhir ledger yang sama. Kunci selalu diambil dengan urutan tetap (anti deadlock).
   Pemakaian: var lock = kunciModul_('penjualan') / kunciModul_(['penjualan', 'stok']) -
   API-nya sama dengan ScriptLock: waitLock(ms), tryLock(ms), releaseLock(), hasLock().
   ============================================================ */
var MODUL_KUNCI_URUTAN_ = ['akses', 'token', 'katalog', 'pembelian', 'penjualan', 'pengiriman', 'produksi', 'stok', 'keuangan', 'rekap', 'umum'];
var KUNCI_MODUL_TTL_DETIK_ = 360; // > batas eksekusi 6 menit: kunci milik eksekusi yang terbunuh lepas sendiri
var KUNCI_MODUL_DIPEGANG_ = {};   // per eksekusi: modul -> { token, n } (reentrant: fungsi bersarang aman)

function kunciModulAmbilSatu_(modul, batasMs) {
  var pegang = KUNCI_MODUL_DIPEGANG_[modul];
  if (pegang) { pegang.n++; return true; } // eksekusi ini sudah memegang modul ini
  var cache = CacheService.getScriptCache();
  var k = 'LOCK_MODUL_' + modul;
  var token = Utilities.getUuid();
  var gerbang = LockService.getScriptLock();
  while (true) {
    var dapat = false;
    if (gerbang.tryLock(Math.max(1, Math.min(2000, batasMs - Date.now())))) {
      try {
        if (!cache.get(k)) { cache.put(k, token, KUNCI_MODUL_TTL_DETIK_); dapat = true; }
      } finally { gerbang.releaseLock(); } // gerbang hanya dipegang beberapa milidetik
    }
    if (dapat) { KUNCI_MODUL_DIPEGANG_[modul] = { token: token, n: 1 }; return true; }
    if (Date.now() >= batasMs) return false;
    Utilities.sleep(150 + Math.floor(Math.random() * 200)); // jitter supaya request yang antre tidak bertabrakan
  }
}

function kunciModulLepasSatu_(modul) {
  var pegang = KUNCI_MODUL_DIPEGANG_[modul];
  if (!pegang) return;
  if (--pegang.n > 0) return;
  delete KUNCI_MODUL_DIPEGANG_[modul];
  try {
    var cache = CacheService.getScriptCache();
    var k = 'LOCK_MODUL_' + modul;
    if (cache.get(k) === pegang.token) cache.remove(k);
  } catch (e) { /* TTL tetap melepas kunci */ }
}

function kunciModul_(modul) {
  var daftar = [];
  (Array.isArray(modul) ? modul : [modul]).forEach(function (m) { m = String(m || 'umum'); if (daftar.indexOf(m) === -1) daftar.push(m); });
  daftar.sort(function (a, b) {
    var ia = MODUL_KUNCI_URUTAN_.indexOf(a), ib = MODUL_KUNCI_URUTAN_.indexOf(b);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  });
  var dipegang = [];
  var obj = {
    modul: daftar,
    tryLock: function (ms) {
      if (dipegang.length) return true;
      var batas = Date.now() + Math.max(0, ms || 0);
      for (var i = 0; i < daftar.length; i++) {
        if (!kunciModulAmbilSatu_(daftar[i], batas)) {
          for (var j = dipegang.length - 1; j >= 0; j--) kunciModulLepasSatu_(dipegang[j]);
          dipegang = [];
          return false;
        }
        dipegang.push(daftar[i]);
      }
      return true;
    },
    waitLock: function (ms) {
      if (!obj.tryLock(ms)) throw new Error('Lock timeout: modul ' + daftar.join(' + ') + ' sedang dipakai proses lain.');
    },
    releaseLock: function () {
      for (var j = dipegang.length - 1; j >= 0; j--) kunciModulLepasSatu_(dipegang[j]);
      dipegang = [];
    },
    hasLock: function () { return dipegang.length > 0; }
  };
  return obj;
}

// JALANKAN dari editor kalau ada modul yang "nyangkut" terkunci (mis. setelah eksekusi dihentikan paksa)
function resetSemuaKunciModul() {
  var cache = CacheService.getScriptCache();
  cache.removeAll(MODUL_KUNCI_URUTAN_.map(function (m) { return 'LOCK_MODUL_' + m; }));
  Logger.log('✅ Semua kunci modul dilepas: ' + MODUL_KUNCI_URUTAN_.join(', '));
}

// Lihat modul mana yang sedang terkunci (untuk diagnosa)
function lihatStatusKunciModul() {
  var cache = CacheService.getScriptCache();
  var isi = cache.getAll(MODUL_KUNCI_URUTAN_.map(function (m) { return 'LOCK_MODUL_' + m; }));
  MODUL_KUNCI_URUTAN_.forEach(function (m) { Logger.log(m + ': ' + (isi['LOCK_MODUL_' + m] ? 'TERKUNCI' : 'bebas')); });
  return isi;
}

/* ============================================================
   OPTIMASI KONKURENSI: KUNCI SINKRON (mutex) TERPISAH DARI ScriptLock
   Masalah lama: sync pesanan (trigger 5 menit + sinkron penuh) memegang ScriptLock GLOBAL selama
   UrlFetch berjalan (bisa 4,5 menit). Semua simpan data user memakai ScriptLock yang sama dengan
   waitLock 15-20 detik -> selama sync jalan, input data gagal "Sistem sibuk" / timeout.
   Sekarang: proses sinkron dijaga mutex berbasis CacheService (tidak memblokir siapa pun), dan
   ScriptLock HANYA dipegang sebentar saat menulis hasil ke Sheets.
   ============================================================ */
var KUNCI_SINKRON_TTL_DETIK_ = 360; // > batas eksekusi 6 menit: mutex yatim (eksekusi terbunuh) lepas sendiri

// Ambil mutex bernama. Return token (string) kalau berhasil, null kalau sedang dipakai proses lain.
function kunciSinkronAmbil_(nama, ttlDetik) {
  var cache = CacheService.getScriptCache();
  var k = 'MUTEX_SINKRON_' + nama;
  var token = Utilities.getUuid();
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return null; // ScriptLock hanya dipakai beberapa milidetik untuk cek-dan-set
  try {
    if (cache.get(k)) return null;
    cache.put(k, token, Math.min(21600, ttlDetik || KUNCI_SINKRON_TTL_DETIK_));
    return token;
  } finally { lock.releaseLock(); }
}

function kunciSinkronLepas_(nama, token) {
  if (!token) return;
  try {
    var cache = CacheService.getScriptCache();
    var k = 'MUTEX_SINKRON_' + nama;
    if (cache.get(k) === token) cache.remove(k);
  } catch (e) { /* TTL tetap melepas mutex */ }
}

// Jalankan fn() di dalam kunci modul SINGKAT (khusus fase tulis - tanpa UrlFetch di dalamnya).
// modul default 'penjualan'; tambahkan 'stok' kalau fase tulisnya juga menulis Stock Ledger.
function denganKunciTulis_(fn, tungguMs, modul) {
  var lock = kunciModul_(modul || 'penjualan');
  if (!lock.tryLock(tungguMs || 20000)) throw new Error('Sistem sibuk, coba lagi.');
  try { return fn(); } finally { lepasKunci_(lock); }
}

// Peta Order ID -> nomor baris (dibaca ulang DI DALAM kunci tulis supaya posisi baris selalu terbaru)
function petaBarisPerId_(sh) {
  var lr = sh.getLastRow();
  var peta = {};
  if (lr < 2) return peta;
  sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r, i) {
    var k = typeof r[0] === 'number' ? kunciResi_(r[0]) : String(r[0] || '').trim();
    if (k && !peta[k]) peta[k] = i + 2;
  });
  return peta;
}

// Tulis sel yang BERUBAH saja di satu kolom, dikelompokkan per blok baris berurutan (1 setValues per blok).
// Sel lain tidak pernah ditulis ulang -> aman untuk ID/resi lama yang tersimpan sebagai teks.
// peta = { nomorBaris: nilai }. teks = true -> sel diformat '@' dan nilainya String (nol depan aman).
function tulisSelPerBlok_(sh, kol, peta, teks) {
  var rows = Object.keys(peta).map(Number).filter(function (r) { return r >= 2; }).sort(function (a, b) { return a - b; });
  var i = 0, n = 0;
  while (i < rows.length) {
    var j = i;
    while (j + 1 < rows.length && rows[j + 1] === rows[j] + 1) j++;
    var nilai = [];
    for (var k = i; k <= j; k++) {
      var v = peta[rows[k]];
      nilai.push([teks ? String(v == null ? '' : v).trim().replace(/^'+/, '') : v]);
    }
    var rg = sh.getRange(rows[i], kol, nilai.length, 1);
    if (teks) rg.setNumberFormat('@');
    rg.setValues(nilai);
    n += nilai.length;
    i = j + 1;
  }
  return n;
}

// Sama seperti tulisSelPerBlok_, tapi per baris berisi beberapa kolom: peta = { nomorBaris: [nilai...] }
function tulisBarisPerBlok_(sh, kolAwal, peta) {
  var rows = Object.keys(peta).map(Number).filter(function (r) { return r >= 2; }).sort(function (a, b) { return a - b; });
  var i = 0, n = 0;
  while (i < rows.length) {
    var j = i;
    while (j + 1 < rows.length && rows[j + 1] === rows[j] + 1) j++;
    var blok = [];
    for (var k = i; k <= j; k++) blok.push(peta[rows[k]]);
    sh.getRange(rows[i], kolAwal, blok.length, blok[0].length).setValues(blok);
    n += blok.length;
    i = j + 1;
  }
  return n;
}

// Tambah banyak baris sekaligus di bawah sheet (pengganti appendRow() di dalam loop)
function tambahBarisBatch_(sh, baris) {
  if (!baris || !baris.length) return;
  sh.getRange(sh.getLastRow() + 1, 1, baris.length, baris[0].length).setValues(baris);
}

var SINKRON_PENUH_JEDA_OTOMATIS_DETIK = 600;
var SINKRON_PENUH_BATAS_MS = 240000; // 4 menit untuk cek status per kanal

function prosesSinkronPenuhKanal(data) {
  var result = { success: false, kanal: String(data.kanal || '') };
  var mulai = Date.now();
  var mutex = null;
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var kanal = result.kanal;
    if (['tiktok', 'shopee', 'conner'].indexOf(kanal) === -1) throw new Error('Kanal tidak dikenal: ' + kanal);
    var props = PropertiesService.getScriptProperties();
    var kunciWaktu = 'SINKRON_PENUH_' + kanal.toUpperCase() + '_TERAKHIR';
    var terakhir = parseInt(props.getProperty(kunciWaktu) || '0', 10) || 0;

    if (data.otomatis && terakhir && (Date.now() - terakhir) < SINKRON_PENUH_JEDA_OTOMATIS_DETIK * 1000) {
      result.success = true;
      result.dilewati = 'baru';
      result.menitLalu = Math.floor((Date.now() - terakhir) / 60000);
      return result;
    }
    if (urlFetchSedangDiblokir()) { result.success = true; result.dilewati = 'kuota'; return result; }
    // OPTIMASI: 1 kanal = maksimal 1 sinkron penuh di saat yang sama (lintas tab/user). Dulu 2 staff yang
    // membuka halaman bersamaan menjalankan sinkron penuh berbarengan -> kuota UrlFetch & eksekusi dobel.
    mutex = kunciSinkronAmbil_('PENUH_' + kanal);
    if (!mutex) { result.success = true; result.dilewati = 'sedang_jalan'; return result; }

    var lap = { aktif: 0, dicek: 0, statusBerubah: 0, resiBaru: 0, resiDiperbarui: 0, pesananBaru: 0, sisa: 0, peringatan: [] };
    var batasMs = mulai + SINKRON_PENUH_BATAS_MS;

    if (kanal === 'tiktok') {
      try { pastikanTokenTikTokMasihValid(); } catch (eTok) { lap.peringatan.push('Token: ' + eTok); }
      var hT = prosesSyncPesananTikTokShop({ dariSistem: true, lewatiCekStatus: true });
      if (hT.success) lap.pesananBaru = hT.jumlahBaru || 0; else lap.peringatan.push('Tarik pesanan baru: ' + (hT.error || '?'));
      cekStatusPenuhTikTok_({
        label: 'TikTok Shop', sheet: getPesananTikTokShopSheet(), appKey: getTiktokAppKey(), appSecret: getTiktokAppSecret(),
        accessToken: props.getProperty('TIKTOK_ACCESS_TOKEN'), shopCipher: props.getProperty('TIKTOK_SHOP_CIPHER'), kolTglSelesai: 18
      }, lap, batasMs);
    } else if (kanal === 'shopee') {
      var hS = prosesSyncPesananShopee({ dariSistem: true, lewatiCekStatus: true });
      if (hS.success) lap.pesananBaru = hS.jumlahBaru || 0; else lap.peringatan.push('Tarik pesanan baru: ' + (hS.error || '?'));
      cekStatusPenuhShopee_(lap, batasMs);
    } else {
      var accConner = props.getProperty('CONNER_ACCESS_TOKEN'), cipConner = props.getProperty('CONNER_SHOP_CIPHER');
      if (!accConner || !cipConner || !connerAppKey_()) { result.success = true; result.dilewati = 'belum_terhubung'; return result; }
      try { pastikanTokenConnerMasihValid(); } catch (eTokC) { lap.peringatan.push('Token: ' + eTokC); }
      var hC = prosesSyncPesananConner({ dariSistem: true });
      if (hC.success) lap.pesananBaru = hC.jumlahBaru || 0; else lap.peringatan.push('Tarik pesanan baru: ' + (hC.error || '?'));
      cekStatusPenuhTikTok_({
        label: 'Conner Hardware', sheet: getPesananConnerSheet(), appKey: connerAppKey_(), appSecret: connerAppSecret_(),
        accessToken: props.getProperty('CONNER_ACCESS_TOKEN'), shopCipher: props.getProperty('CONNER_SHOP_CIPHER'), kolTglSelesai: 0
      }, lap, batasMs);
    }

    if (!lap.sisa) props.setProperty(kunciWaktu, String(Date.now())); // sisa > 0 -> klik berikutnya lanjut lagi
    invalidasiCacheGabunganPesanan();
    result.laporan = lap;
    result.detik = Math.round((Date.now() - mulai) / 1000);
    result.success = true;
  } catch (err) {
    result.error = err.toString();
  } finally { kunciSinkronLepas_('PENUH_' + result.kanal, mutex); }
  return result;
}

// TikTok Waterground (termasuk Tokopedia) & Conner: kolom sama - 1 Order ID, 2 Tanggal, 5 Status, 6 Kurir, 7 No Resi
function cekStatusPenuhTikTok_(cfg, lap, batasMs) {
  var sh = cfg.sheet;
  var lr = sh.getLastRow();
  if (lr < 2) return;
  if (!cfg.accessToken || !cfg.shopCipher || !cfg.appKey) { lap.peringatan.push(cfg.label + ': belum terhubung'); return; }
  var batasUmur = Date.now() - STATUS_AKTIF_MAKS_UMUR_HARI * 86400000;
  var vals = sh.getRange(2, 1, lr - 1, 7).getValues();
  var kandidat = [], sudah = {};
  for (var i = vals.length - 1; i >= 0; i--) { // terbaru dulu
    var id = typeof vals[i][0] === 'number' ? kunciResi_(vals[i][0]) : String(vals[i][0] || '').trim();
    if (!id || sudah[id]) continue;
    var st = String(vals[i][4] || '').trim().toUpperCase();
    if (st === 'COMPLETED' || st === 'CANCELLED') continue;
    if (vals[i][1] instanceof Date && vals[i][1].getTime() < batasUmur) continue;
    sudah[id] = true;
    kandidat.push(id);
  }
  lap.aktif += kandidat.length;

  var hasil = {};
  for (var b = 0; b < kandidat.length; b += 20) {
    if (Date.now() > batasMs) { lap.sisa += kandidat.length - b; break; }
    if (urlFetchSedangDiblokir()) { lap.sisa += kandidat.length - b; lap.peringatan.push('Kuota UrlFetch habis'); break; }
    var ids = kandidat.slice(b, b + 20).join(',');
    try {
      var path = '/order/202309/orders';
      var params = { app_key: cfg.appKey, timestamp: String(Math.floor(Date.now() / 1000)), shop_cipher: cfg.shopCipher, version: '202309', ids: ids };
      var url = 'https://open-api.tiktokglobalshop.com' + path + '?app_key=' + encodeURIComponent(cfg.appKey) + '&shop_cipher=' + encodeURIComponent(cfg.shopCipher) +
        '&timestamp=' + params.timestamp + '&version=202309&ids=' + encodeURIComponent(ids) + '&sign=' + buatSignatureTikTok(path, params, '', cfg.appSecret);
      var res = fetchHemat(url, { method: 'get', headers: { 'x-tts-access-token': cfg.accessToken }, muteHttpExceptions: true });
      if (res.getResponseCode() !== 200) { lap.peringatan.push(cfg.label + ': 1 batch gagal (HTTP ' + res.getResponseCode() + ')'); continue; }
      var parsed = JSON.parse(res.getContentText());
      ((parsed.data && parsed.data.orders) || []).forEach(function (o) {
        var t = String(o.tracking_number || '').trim();
        if (!t) (o.line_items || []).some(function (li) { t = String(li.tracking_number || '').trim(); return !!t; });
        hasil[String(o.id)] = { status: String(o.status || ''), resi: t };
      });
      lap.dicek += Math.min(20, kandidat.length - b);
    } catch (e) {
      lap.peringatan.push(cfg.label + ': ' + e);
    }
  }
  tulisHasilCekPenuh_(sh, hasil, cfg.kolTglSelesai, lap, 'COMPLETED');
}

// Shopee: 1 No Pesanan, 2 Tanggal, 5 Status, 6 Kurir, 7 No Resi, 17 Tanggal Jadi Selesai
function cekStatusPenuhShopee_(lap, batasMs) {
  var kred = ambilKredensialShopee();
  if (!kred.accessToken || !kred.shopId) { lap.peringatan.push('Shopee: belum terhubung'); return; }
  var sh = getPesananShopeeSheet();
  var lr = sh.getLastRow();
  if (lr < 2) return;
  var batasUmur = Date.now() - STATUS_AKTIF_MAKS_UMUR_HARI * 86400000;
  var vals = sh.getRange(2, 1, lr - 1, 7).getValues();
  var kandidat = [], sudah = {};
  for (var i = vals.length - 1; i >= 0; i--) {
    var sn = String(vals[i][0] || '').trim();
    if (!sn || sudah[sn]) continue;
    var st = String(vals[i][4] || '').trim().toUpperCase();
    if (st === 'COMPLETED' || st === 'CANCELLED') continue;
    if (vals[i][1] instanceof Date && vals[i][1].getTime() < batasUmur) continue;
    sudah[sn] = true;
    kandidat.push(sn);
  }
  lap.aktif += kandidat.length;

  var hasil = {};
  for (var b = 0; b < kandidat.length; b += 50) {
    if (Date.now() > batasMs) { lap.sisa += kandidat.length - b; break; }
    if (urlFetchSedangDiblokir()) { lap.sisa += kandidat.length - b; lap.peringatan.push('Kuota UrlFetch habis'); break; }
    var batch = kandidat.slice(b, b + 50);
    try {
      var path = '/api/v2/order/get_order_detail', ts = Math.floor(Date.now() / 1000);
      var url = getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts + '&sign=' + buatSignatureShopee(path, ts, kred.accessToken, kred.shopId) +
        '&access_token=' + kred.accessToken + '&shop_id=' + kred.shopId + '&order_sn_list=' + encodeURIComponent(batch.join(',')) +
        '&response_optional_fields=' + encodeURIComponent('order_status,package_list');
      var parsed = JSON.parse(fetchHemat(url, { method: 'get', muteHttpExceptions: true }).getContentText());
      if (parsed.error) { lap.peringatan.push('Shopee: ' + (parsed.message || parsed.error)); continue; }
      ((parsed.response && parsed.response.order_list) || []).forEach(function (o) {
        var t = '';
        (o.package_list || []).some(function (p) { t = String(p.tracking_number || '').trim(); return !!t; });
        hasil[String(o.order_sn)] = { status: String(o.order_status || ''), resi: t };
      });
      lap.dicek += batch.length;
    } catch (e) {
      lap.peringatan.push('Shopee: ' + e);
    }
  }
  tulisHasilCekPenuh_(sh, hasil, 17, lap, 'COMPLETED');
}

// Tulis hasil cek: baris dicari ulang di dalam lock, kolom Status ditulis sekali (setValues),
// resi hanya ditulis kalau kosong / berbeda (format teks), tanggal selesai hanya kalau belum ada.
function tulisHasilCekPenuh_(sh, hasil, kolTglSelesai, lap, statusSelesai) {
  if (!Object.keys(hasil).length) return;
  var lock = kunciModul_('penjualan');
  if (!lock.tryLock(25000)) { lap.peringatan.push('Sistem sibuk - hasil cek belum ditulis, coba lagi'); return; }
  try {
    var lr = sh.getLastRow();
    if (lr < 2) return;
    var vals = sh.getRange(2, 1, lr - 1, 7).getValues();
    var tglSelesai = kolTglSelesai ? sh.getRange(2, kolTglSelesai, lr - 1, 1).getValues() : null;
    // OPTIMASI: hanya sel yang berubah yang ditulis, dikelompokkan per blok baris (dulu: kolom Status ditulis
    // ulang SELURUHNYA + resi ditulis 1 sel per panggilan).
    var petaStatus = {}, petaTgl = {}, petaResi = {};
    vals.forEach(function (r, i) {
      var id = typeof r[0] === 'number' ? kunciResi_(r[0]) : String(r[0] || '').trim();
      var h = id && hasil[id];
      if (!h) return;
      var row = i + 2;
      var stLama = String(r[4] || '').trim();
      if (h.status && h.status !== stLama) { petaStatus[row] = h.status; lap.statusBerubah++; }
      if (tglSelesai && h.status === statusSelesai && !tglSelesai[i][0]) petaTgl[row] = new Date();
      if (h.resi) {
        var resiLama = resiTeks_(r[6], r[5]);
        if (!resiLama || resiLama === '-') { petaResi[row] = h.resi; lap.resiBaru++; }
        else if (!resiSama_(resiLama, h.resi)) { petaResi[row] = h.resi; lap.resiDiperbarui++; }
      }
    });
    var n = tulisSelPerBlok_(sh, 5, petaStatus, false) + tulisSelPerBlok_(sh, 7, petaResi, true);
    if (kolTglSelesai) n += tulisSelPerBlok_(sh, kolTglSelesai, petaTgl, false);
  } finally { lepasKunci_(lock); }
}

/* ============================================================
   SINKRON DELTA TRANSAKSI PENJUALAN
   Browser menyimpan daftar pesanan lengkap (IndexedDB). Setelah itu yang ditarik berkala hanya:
     - lihat_pesanan_gabungan_ringan : 1 tuple kecil per pesanan [kunci, status, noResi, kurir, _sig]
     - lihat_pesanan_gabungan_detail : objek LENGKAP hanya untuk kunci yang baru / _sig-nya berubah
   _sig = hash semua field SELAIN status/noResi/kurir (No Ref, tanggal, pembeli, total, data pembeli
   manual, posisi baris sheet, dst). Kalau ada yang berubah (mis. data pembeli diedit di perangkat lain),
   browser otomatis mengambil ulang objek itu - cache tidak pernah basi diam-diam.
   ============================================================ */
function sigPesananStatis_(o) {
  var salin = {};
  Object.keys(o).forEach(function (k) { if (k !== 'status' && k !== 'noResi' && k !== 'kurir' && k !== '_sig') salin[k] = o[k]; });
  var teks = JSON.stringify(salin);
  var h = 5381;
  for (var i = 0; i < teks.length; i++) h = ((h << 5) + h + teks.charCodeAt(i)) | 0;
  return (h >>> 0).toString(36);
}

function prosesLihatPesananGabunganRingan(data) {
  var result = { success: false };
  try {
    var gab = prosesLihatSemuaPesananGabungan(data); // cek izin + cache 20 detik di dalamnya
    if (!gab.success) throw new Error(gab.error || 'Gagal ambil pesanan.');
    result.tuple = (gab.daftar || []).map(function (o) {
      return [o.sumber + '|' + o.noReferensi, String(o.status || ''), String(o.noResi || '-'), String(o.kurir || ''), o._sig || sigPesananStatis_(o), o.ts || 0];
    });
    result.waktuSyncTerakhirTiktok = gab.waktuSyncTerakhirTiktok || null;
    result.jumlah = result.tuple.length;
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesLihatPesananGabunganDetail(data) {
  var result = { success: false };
  try {
    var kunci = Array.isArray(data.kunci) ? data.kunci.slice(0, 1000) : [];
    var gab = prosesLihatSemuaPesananGabungan(data);
    if (!gab.success) throw new Error(gab.error || 'Gagal ambil pesanan.');
    var mau = {};
    kunci.forEach(function (k) { mau[String(k)] = true; });
    result.daftar = (gab.daftar || []).filter(function (o) { return mau[o.sumber + '|' + o.noReferensi]; });
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   SYNC OTOMATIS TIKTOK SHOP - jalan sendiri tiap beberapa menit lewat Trigger
   ============================================================ */

// Versi sync yang dipanggil OTOMATIS oleh Trigger (bukan oleh user), jadi nggak perlu cekIzin
// Dipanggil dari tombol "🔄 Refresh Pesanan" di halaman web (Transaksi Penjualan) - user mau
// narik pesanan terbaru sekarang juga, nggak nunggu trigger otomatis (yang jalan tiap 5 menit).
// Mastiin token valid dulu (refresh kalau perlu, aman lewat lock), baru sync pesanan.
/* ============================================================
   DASHBOARD PENJUALAN - ringkasan khusus buat menu Penjualan, terpisah dari
   Beranda (dashboard umum lintas modul) dan Transaksi Penjualan (tabel mentah).
   ============================================================ */
/* ============================================================
   PANTAUAN PENJUALAN - sub-tab pertama Transaksi Penjualan, ringkasan cepat
   status pemrosesan pesanan (bukan angka penjualan kayak Dashboard Penjualan).
   ============================================================ */
function prosesLihatPantauanPenjualan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var gab = prosesLihatSemuaPesananGabungan(data);
    if (!gab.success) throw new Error(gab.error || 'Gagal ambil data pesanan.');
    var daftar = gab.daftar || [];

    var sekarang = new Date();
    var awalHariIni = new Date(sekarang.getFullYear(), sekarang.getMonth(), sekarang.getDate());
    var awalKemarin = new Date(awalHariIni.getTime() - 24 * 60 * 60 * 1000);
    var awalBulanIni = new Date(sekarang.getFullYear(), sekarang.getMonth(), 1);
    var awalBulanLalu = new Date(sekarang.getFullYear(), sekarang.getMonth() - 1, 1);

    var hariIni = 0, kemarin = 0, bulanIni = 0, bulanLalu = 0, perluDiproses = 0, selesaiHariIni = 0;
    var rincian = {
      'Hari Ini': { pembeli: 0, resi: 0, proses: 0 }, '1 Hari': { pembeli: 0, resi: 0, proses: 0 },
      '2 Hari': { pembeli: 0, resi: 0, proses: 0 }, '3 Hari': { pembeli: 0, resi: 0, proses: 0 },
      '> 3 Hari': { pembeli: 0, resi: 0, proses: 0 }
    };
    var KATA_SELESAI = ['COMPLETED', 'SELESAI', 'DITERIMA', 'DELIVERED'];
    var KATA_RETUR = ['CANCEL', 'RETURN', 'RETUR', 'BATAL', 'KOMPLAIN', 'REJECT'];

    daftar.forEach(function (o) {
      var tgl;
      try { tgl = o.tanggal instanceof Date ? o.tanggal : new Date(o.tanggal); } catch (e) { return; }
      if (!tgl || isNaN(tgl.getTime())) return;

      if (tgl >= awalHariIni) hariIni++;
      else if (tgl >= awalKemarin && tgl < awalHariIni) kemarin++;
      if (tgl >= awalBulanIni) bulanIni++;
      else if (tgl >= awalBulanLalu && tgl < awalBulanIni) bulanLalu++;

      var st = String(o.status || '').toUpperCase();
      var sudahSelesai = KATA_SELESAI.some(function (k) { return st.indexOf(k) !== -1; });
      var sudahRetur = KATA_RETUR.some(function (k) { return st.indexOf(k) !== -1; });
      if (sudahSelesai && tgl >= awalHariIni) selesaiHariIni++;

      var belumResi = !o.noResi || o.noResi === '-';
      var belumProses = belumResi && !sudahSelesai && !sudahRetur;
      if (belumProses) perluDiproses++;

      var butuhDataPembeli = o.rowTiktok && !(o.namaManual && o.namaManual.trim());
      if (belumProses || butuhDataPembeli) {
        var tglSajaHari = new Date(tgl.getFullYear(), tgl.getMonth(), tgl.getDate());
        var usiaHari = Math.floor((awalHariIni - tglSajaHari) / (24 * 60 * 60 * 1000));
        var kunci = usiaHari <= 0 ? 'Hari Ini' : usiaHari === 1 ? '1 Hari' : usiaHari === 2 ? '2 Hari' : usiaHari === 3 ? '3 Hari' : '> 3 Hari';
        if (butuhDataPembeli) rincian[kunci].pembeli++;
        if (belumResi && !sudahSelesai && !sudahRetur) rincian[kunci].resi++;
        if (belumProses) rincian[kunci].proses++;
      }
    });

    result.success = true;
    result.hariIni = hariIni; result.kemarin = kemarin;
    result.bulanIni = bulanIni; result.bulanLalu = bulanLalu;
    result.perluDiproses = perluDiproses; result.selesaiHariIni = selesaiHariIni;
    result.rincian = rincian;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

// Baca sheet "Retur & Komplain" - dari fitur scan resi retur masuk yang udah ada.
// Datanya sengaja minim (No Resi, Tanggal, Keterangan) - itu emang yang tercatat selama ini,
// nggak dibuat-buat kolom lain yang aslinya nggak ada datanya.
function prosesLihatDaftarRetur(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sh = ss.getSheetByName('Retur & Komplain');
    var daftar = [];
    if (sh) {
      var lastRow = sh.getLastRow();
      if (lastRow > 1) {
        var tz = Session.getScriptTimeZone();
        var vals = sh.getRange(2, 1, lastRow - 1, 3).getValues();
        vals.forEach(function (row) {
          var noResi = String(row[0] || '').trim();
          if (!noResi) return;
          daftar.push({
            noResi: noResi,
            tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy HH:mm') : String(row[1] || '-'),
            keterangan: String(row[2] || '-')
          });
        });
      }
    }
    daftar.reverse(); // terbaru duluan
    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesLihatDashboardPenjualan(data) {
  var result = { success: false };
  try {
    var gab = prosesLihatSemuaPesananGabungan({ email: data.email });
    if (!gab.success) throw new Error(gab.error || 'Gagal ambil data pesanan.');
    var daftar = gab.daftar || [];

    var sekarang = new Date();
    var awalHariIni = new Date(sekarang.getFullYear(), sekarang.getMonth(), sekarang.getDate());
    var batas30Hari = new Date(sekarang.getTime() - 30 * 24 * 60 * 60 * 1000);

    var totalHariIni = 0, jumlahHariIni = 0;
    var total30Hari = 0, jumlah30Hari = 0;
    // Semua channel SELALU tampil (walau 0) - biar kelihatan kalau ada channel yang nggak ada penjualan,
    // bukan diam-diam hilang dari grafik.
    var perChannel = { 'TikTok Shop': 0, 'Tokopedia': 0, 'Shopee': 0, 'Website': 0, 'PO Sales': 0, 'Conner Hardware': 0 };
    var jumlahPerChannel = { 'TikTok Shop': 0, 'Tokopedia': 0, 'Shopee': 0, 'Website': 0, 'PO Sales': 0, 'Conner Hardware': 0 };
    var totalBatal30Hari = 0, jumlahBatal30Hari = 0;
    var perStatus = { 'Perlu Diproses': 0, 'Dalam Pengiriman': 0, 'Selesai': 0, 'Retur/Komplain': 0 };
    var perluDataPembeli = 0;
    var perluResi = 0;

    var KATA_RETUR = ['CANCEL', 'RETURN', 'RETUR', 'BATAL', 'KOMPLAIN', 'REJECT'];
    var KATA_SELESAI = ['COMPLETED', 'SELESAI', 'DITERIMA', 'DELIVERED'];
    var KATA_KIRIM = ['COLLECTION', 'SHIPPED', 'TRANSIT', 'DIKIRIM', 'KIRIM'];

    var KATA_BATAL = ['CANCEL', 'BATAL', 'REJECT'];
    daftar.forEach(function (o) {
      // Pakai timestamp numerik (ts) dari backend - dulu parse teks tanggal ("27 Sep 2026, 14:05")
      // yang bisa gagal diam-diam -> pesanan terlewat dari laporan.
      var ms = msTanggalPesanan_(o);
      if (!ms) return;
      var tgl = new Date(ms);
      if (tgl < batas30Hari) return;

      var st = String(o.status || '').toUpperCase();
      var totalOrder = parseFloat(o.total) || 0;
      var kanal = kanalLaporanPesanan_(o);
      var dibatalkan = KATA_BATAL.some(function (k) { return st.indexOf(k) !== -1; });

      if (dibatalkan) {
        // Pesanan batal TIDAK dihitung sebagai omzet, tapi tetap tercatat di status
        totalBatal30Hari += totalOrder; jumlahBatal30Hari++;
      } else {
        total30Hari += totalOrder; jumlah30Hari++;
        if (tgl >= awalHariIni) { totalHariIni += totalOrder; jumlahHariIni++; }
        perChannel[kanal] = (perChannel[kanal] || 0) + totalOrder;
        jumlahPerChannel[kanal] = (jumlahPerChannel[kanal] || 0) + 1;
      }

      if (KATA_RETUR.some(function (k) { return st.indexOf(k) !== -1; })) perStatus['Retur/Komplain']++;
      else if (KATA_SELESAI.some(function (k) { return st.indexOf(k) !== -1; })) perStatus['Selesai']++;
      else if (st.indexOf('BELUM') === -1 && KATA_KIRIM.some(function (k) { return st.indexOf(k) !== -1; })) perStatus['Dalam Pengiriman']++; // "Belum Dikirim" (PO Sales) = masih Perlu Diproses
      else perStatus['Perlu Diproses']++;

      if (o.rowTiktok && !(o.namaManual && String(o.namaManual).trim())) perluDataPembeli++;
      if ((!o.noResi || o.noResi === '-') && !dibatalkan) perluResi++;
    });

    // Top 5 (terlaris) & Bottom 3 (slow moving) - dari Stock Ledger (Jenis diawali "Terjual"),
    // lintas toko Waterground & Conner Hardware. Dihitung sekali, dipakai tabel UI + AI Data Layer.
    var produkAI = { top5: [], bottom3: [], produkBelumPernahTerjual: 0 };
    try { produkAI = hitungProdukPenjualanAI_(batas30Hari); } catch (eTop) { /* dashboard tetap tampil */ }
    var topProduk = produkAI.top5.map(function (p) { return { sku: p.sku, nama: p.nama, qty: p.qty30Hari }; });

    result.success = true;
    result.totalHariIni = totalHariIni;
    result.jumlahHariIni = jumlahHariIni;
    result.total30Hari = total30Hari;
    result.jumlah30Hari = jumlah30Hari;
    result.rataRata = jumlah30Hari > 0 ? Math.round(total30Hari / jumlah30Hari) : 0;
    result.perChannel = perChannel;
    result.jumlahPerChannel = jumlahPerChannel;
    result.totalBatal30Hari = totalBatal30Hari;
    result.jumlahBatal30Hari = jumlahBatal30Hari;
    result.perStatus = perStatus;
    result.perluDataPembeli = perluDataPembeli;
    result.perluResi = perluResi;
    result.topProduk = topProduk;
    result.bottomProduk = produkAI.bottom3;

    // ===== AI DATA LAYER + ACTION TRACKER =====
    // Bagian ini sengaja dibungkus try terpisah: kalau gagal, laporan untuk manusia tetap tampil.
    try {
      var dataLayer = bangunDataLayerPenjualan_(daftar, produkAI, {
        perluDataPembeli: perluDataPembeli, perluResi: perluResi, perStatus: perStatus
      });
      // Saran berbasis aturan (placeholder sampai LLM terhubung) -> disimpan ke "Log Saran AI"
      try { saranAIUpsert_(saranAIRulePenjualan_(dataLayer), 'Sistem', data.email, true); } catch (eUp) { dataLayer.catatanSistem = 'Saran baru belum tersimpan: ' + eUp; }
      var saran = saranAIAmbilUntukModul_('Penjualan');
      dataLayer.aksi = { tasks: saran.tasks, pengingat: saran.pengingat, ringkasStatus: saran.ringkasStatus };
      result.dataLayer = dataLayer;
    } catch (eDl) {
      result.dataLayerError = eDl.toString();
    }
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}


/* ============================================================
   AI DATA LAYER - LAPORAN PENJUALAN
   Semantic state yang bersih & stabil untuk dibaca LLM (di-inject ke prompt / di-scrape dari
   window.omniAIDataLayer). Aturan: angka MENTAH (Rupiah utuh, bukan "Rp 1,2 jt"), tanggal ISO,
   growth dalam persen 1 desimal, null = tidak ada pembanding (JANGAN dianggap 0).
   ============================================================ */
var DATA_LAYER_PENJUALAN_SCHEMA = 'omniai.sales_report.v1';
var KATA_BATAL_PENJUALAN = ['CANCEL', 'BATAL', 'REJECT'];

function pertumbuhanPct_(sekarang, sebelumnya) {
  if (!sebelumnya) return null;
  return Math.round((sekarang - sebelumnya) / sebelumnya * 1000) / 10;
}

function bangunDataLayerPenjualan_(daftar, produkAI, operasional) {
  var tz = Session.getScriptTimeZone();
  var now = new Date();
  var y = now.getFullYear(), m = now.getMonth(), d = now.getDate();
  var H = now.getHours(), Mi = now.getMinutes(), S = now.getSeconds();
  var HARI = 24 * 60 * 60 * 1000;

  // Rentang [dari, sampai) - perbandingan "like-for-like" (periode sama panjang, sampai jam yang sama)
  var hariBlnLalu = new Date(y, m, 0).getDate();
  var hariBlnTL = new Date(y - 1, m + 1, 0).getDate();
  var R = {
    hariIni: [new Date(y, m, d), now],
    kemarinLfl: [new Date(y, m, d - 1), new Date(now.getTime() - HARI)],
    mtd: [new Date(y, m, 1), now],
    mtdBulanLalu: [new Date(y, m - 1, 1), new Date(y, m - 1, Math.min(d, hariBlnLalu), H, Mi, S)],
    bulanLaluPenuh: [new Date(y, m - 1, 1), new Date(y, m, 1)],
    mtdTahunLalu: [new Date(y - 1, m, 1), new Date(y - 1, m, Math.min(d, hariBlnTL), H, Mi, S)],
    r30: [new Date(now.getTime() - 30 * HARI), now],
    r30Prev: [new Date(now.getTime() - 60 * HARI), new Date(now.getTime() - 30 * HARI)]
  };
  var B = {};
  Object.keys(R).forEach(function (k) { B[k] = { omzet: 0, pesanan: 0 }; });
  var ch30 = {}, chPrev = {};
  ['TikTok Shop', 'Tokopedia', 'Shopee', 'Website', 'PO Sales', 'Conner Hardware'].forEach(function (c) {
    ch30[c] = { omzet: 0, pesanan: 0 }; chPrev[c] = { omzet: 0, pesanan: 0 };
  });
  var batal30 = { jumlah: 0, nilai: 0 }, semua30 = 0;

  daftar.forEach(function (o) {
    var ms = msTanggalPesanan_(o);
    if (!ms) return;
    var st = String(o.status || '').toUpperCase();
    var batal = KATA_BATAL_PENJUALAN.some(function (k) { return st.indexOf(k) !== -1; });
    var nilai = parseFloat(o.total) || 0;
    var kanal = kanalLaporanPesanan_(o);
    var diR30 = ms >= R.r30[0].getTime() && ms < R.r30[1].getTime();
    if (diR30) { semua30++; if (batal) { batal30.jumlah++; batal30.nilai += nilai; } }
    if (batal) return; // omzet = TANPA pesanan batal
    Object.keys(R).forEach(function (k) {
      if (ms >= R[k][0].getTime() && ms < R[k][1].getTime()) { B[k].omzet += nilai; B[k].pesanan++; }
    });
    if (diR30) { ch30[kanal] = ch30[kanal] || { omzet: 0, pesanan: 0 }; ch30[kanal].omzet += nilai; ch30[kanal].pesanan++; }
    if (ms >= R.r30Prev[0].getTime() && ms < R.r30Prev[1].getTime()) {
      chPrev[kanal] = chPrev[kanal] || { omzet: 0, pesanan: 0 }; chPrev[kanal].omzet += nilai; chPrev[kanal].pesanan++;
    }
  });

  function aov(b) { return b.pesanan ? Math.round(b.omzet / b.pesanan) : 0; }
  function tgl(dt) { return Utilities.formatDate(dt, tz, 'yyyy-MM-dd'); }
  function rentang(k) { return { dari: tgl(R[k][0]), sampai: tgl(new Date(R[k][1].getTime() - 1)) }; }

  var total30 = Object.keys(ch30).reduce(function (s, k) { return s + ch30[k].omzet; }, 0);
  var kontribusi = Object.keys(ch30).map(function (k) {
    return {
      channel: k, omzet: ch30[k].omzet, pesanan: ch30[k].pesanan,
      sharePct: total30 ? Math.round(ch30[k].omzet / total30 * 1000) / 10 : 0,
      omzet30HariSebelumnya: (chPrev[k] || {}).omzet || 0,
      growthPct: pertumbuhanPct_(ch30[k].omzet, (chPrev[k] || {}).omzet || 0)
    };
  }).sort(function (a, b) { return b.omzet - a.omzet; });

  return {
    schema: DATA_LAYER_PENJUALAN_SCHEMA,
    generatedAt: now.toISOString(),
    timezone: tz,
    mataUang: 'IDR',
    cakupan: 'Semua channel & toko (Waterground + Conner Hardware). Omzet TIDAK termasuk pesanan batal.',
    periode: {
      hariIni: tgl(now), bulanIniMTD: rentang('mtd'), bulanLaluPeriodeSama: rentang('mtdBulanLalu'),
      bulanLaluPenuh: rentang('bulanLaluPenuh'), tahunLaluPeriodeSama: rentang('mtdTahunLalu'),
      rolling30Hari: rentang('r30'), rolling30HariSebelumnya: rentang('r30Prev')
    },
    ringkasan: {
      harian: {
        omzet: B.hariIni.omzet, pesanan: B.hariIni.pesanan, aov: aov(B.hariIni),
        kemarinSampaiJamSama: { omzet: B.kemarinLfl.omzet, pesanan: B.kemarinLfl.pesanan },
        growthVsKemarinPct: pertumbuhanPct_(B.hariIni.omzet, B.kemarinLfl.omzet)
      },
      bulananMTD: {
        omzet: B.mtd.omzet, pesanan: B.mtd.pesanan, aov: aov(B.mtd),
        momPct: pertumbuhanPct_(B.mtd.omzet, B.mtdBulanLalu.omzet),
        yoyPct: pertumbuhanPct_(B.mtd.omzet, B.mtdTahunLalu.omzet),
        pembanding: {
          bulanLaluPeriodeSama: B.mtdBulanLalu,
          tahunLaluPeriodeSama: B.mtdTahunLalu
        }
      },
      bulanLaluPenuh: { omzet: B.bulanLaluPenuh.omzet, pesanan: B.bulanLaluPenuh.pesanan, aov: aov(B.bulanLaluPenuh) },
      rolling30Hari: {
        omzet: B.r30.omzet, pesanan: B.r30.pesanan, aov: aov(B.r30),
        growthVs30HariSebelumnyaPct: pertumbuhanPct_(B.r30.omzet, B.r30Prev.omzet),
        batal: { jumlah: batal30.jumlah, nilai: batal30.nilai, ratePct: semua30 ? Math.round(batal30.jumlah / semua30 * 1000) / 10 : 0 }
      }
    },
    kontribusiChannel: kontribusi,
    produk: {
      sumber: 'Stock Ledger (Jenis diawali "Terjual"), satuan qty, 30 hari terakhir',
      top5: produkAI.top5,
      bottom3SlowMoving: produkAI.bottom3,
      produkAktifBelumPernahTerjual: produkAI.produkBelumPernahTerjual
    },
    operasional: {
      pesananTikTokButuhDataPembeli: operasional.perluDataPembeli,
      pesananBelumAdaResi30Hari: operasional.perluResi,
      statusPesanan30Hari: operasional.perStatus
    },
    catatanUntukAI: [
      'growthPct/momPct/yoyPct null berarti periode pembanding tidak punya data - jangan diartikan 0% atau turun.',
      'MoM & YoY membandingkan periode yang SAMA PANJANG (tanggal 1 s/d hari ini jam yang sama).',
      'bottom3SlowMoving hanya berisi produk aktif yang pernah terjual; onHand null = SKU tidak dikenal mesin stok.',
      'Saran baru kirim via aksi simpan_saran_ai_eksternal; pengingat via suntik_reminder_saran_ai (lihat skemaOutputAI).'
    ],
    skemaOutputAI: {
      simpan_saran_ai_eksternal: { tasks: [{ id: 'opsional, unik', judul: 'string <= 90 char', deskripsi: 'string, langkah konkret', kategori: 'Pertumbuhan|Channel|Produk|Stok|Operasional|Promosi', prioritas: 'tinggi|sedang|rendah', metrik: 'object angka pemicu dari data layer' }] },
      suntik_reminder_saran_ai: { taskId: 'id task berstatus kerjakan', instruksi: 'teks pengingat singkat untuk admin' }
    }
  };
}

function hitungProdukPenjualanAI_(batas30Hari) {
  var tz = Session.getScriptTimeZone();
  var info = {}, qty30 = {}, terakhir = {};
  var ledgerSudahDibaca = {}; // FIX: kedua toko saat ini berbagi 1 sheet Stock Ledger -> jangan dihitung 2x
  ['Waterground', 'Conner Hardware'].forEach(function (toko) {
    try {
      var shM = getMasterProdukSheet(toko);
      var lrM = shM.getLastRow();
      if (lrM > 1) {
        var nc = Math.min(shM.getLastColumn(), KAT_KOL_STATUS);
        shM.getRange(2, 1, lrM - 1, nc).getValues().forEach(function (r) {
          var sku = String(r[0] || '').trim();
          if (!sku || info[sku]) return;
          info[sku] = { nama: String(r[1] || sku), toko: toko, arsip: nc >= KAT_KOL_STATUS ? katApakahArsip_(r[KAT_KOL_STATUS - 1]) : false };
        });
      }
    } catch (eM) { /* lewati toko ini */ }
    try {
      var shL = getStockLedgerSheet(toko);
      if (ledgerSudahDibaca[shL.getName()]) throw new Error('sudah dibaca');
      ledgerSudahDibaca[shL.getName()] = true;
      var lrL = shL.getLastRow();
      if (lrL > 1) {
        shL.getRange(2, 1, lrL - 1, 4).getValues().forEach(function (r) {
          var t = r[0], sku = String(r[1] || '').trim(), jenis = String(r[2] || ''), qty = parseFloat(r[3]) || 0;
          if (!sku || jenis.indexOf('Terjual') !== 0 || !(t instanceof Date)) return;
          if (t >= batas30Hari) qty30[sku] = (qty30[sku] || 0) + qty;
          if (!terakhir[sku] || t > terakhir[sku]) terakhir[sku] = t;
        });
      }
    } catch (eL) { /* lewati toko ini */ }
  });

  var onHand = {};
  try {
    // v2026.10.22: dulu dari sheet "Master Stok" (hasil Rekonsiliasi Malam, sudah dihentikan) -> sekarang mesin stok langsung
    var snapS = cacheBesarGet_(SM_CACHE_PETA_STOK);
    if (!snapS || !snapS.peta || (Date.now() - (snapS.dihitungMs || 0)) > 30 * 60000) snapS = smHitungPetaStok_();
    Object.keys(snapS.peta || {}).forEach(function (sku) { var x = snapS.peta[sku]; if (x && x.onHand !== null && x.onHand !== undefined) onHand[sku] = Number(x.onHand) || 0; });
  } catch (eS) { /* stok opsional */ }

  var sekarang = Date.now();
  function kartu(sku) {
    var t = terakhir[sku];
    return {
      sku: sku, nama: (info[sku] && info[sku].nama) || sku, toko: (info[sku] && info[sku].toko) || null,
      qty30Hari: qty30[sku] || 0,
      terjualTerakhir: t ? Utilities.formatDate(t, tz, 'yyyy-MM-dd') : null,
      hariSejakTerjualTerakhir: t ? Math.floor((sekarang - t.getTime()) / 86400000) : null,
      onHand: onHand.hasOwnProperty(sku) ? onHand[sku] : null
    };
  }

  var top5 = Object.keys(qty30).filter(function (k) { return qty30[k] > 0; })
    .sort(function (a, b) { return qty30[b] - qty30[a]; }).slice(0, 5).map(kartu);
  var aktif = Object.keys(info).filter(function (k) { return !info[k].arsip; });
  var bottom3 = aktif.filter(function (k) { return !!terakhir[k]; })
    .sort(function (a, b) { return ((qty30[a] || 0) - (qty30[b] || 0)) || (terakhir[a] - terakhir[b]); })
    .slice(0, 3).map(kartu);
  return { top5: top5, bottom3: bottom3, produkBelumPernahTerjual: aktif.filter(function (k) { return !terakhir[k]; }).length };
}

function prosesLihatDataLayerPenjualan(data) {
  // Alias khusus AI: jawaban = data layer saja (lebih ringkas untuk dipanggil agen/LLM dari luar)
  var r = prosesLihatDashboardPenjualan(data);
  if (!r.success) return r;
  if (!r.dataLayer) return { success: false, error: r.dataLayerError || 'Data layer gagal dibangun' };
  return { success: true, dataLayer: r.dataLayer };
}

/* ============================================================
   SARAN AI -> ACTION TRACKER (sheet "Log Saran AI")
   Status: Baru -> Kerjakan -> Selesai / Abaikan. Task berstatus Kerjakan > SARAN_AI_REMINDER_HARI
   hari otomatis masuk "pengingat" (tampil merah di UI & ikut di data layer untuk LLM).
   Penulisan selalu di dalam LockService & baris dicari DINAMIS berdasarkan Task ID.
   ============================================================ */
var SARAN_AI_SHEET = 'Log Saran AI';
var SARAN_AI_REMINDER_HARI = 3;
var SARAN_AI_HEADER = [
  'Task ID', 'Dibuat Pada', 'Sumber', 'Modul', 'Kategori', 'Prioritas', 'Judul', 'Deskripsi', 'Metrik Pemicu (JSON)',
  'Status', 'Status Diubah Pada', 'Diubah Oleh', 'Mulai Dikerjakan', 'Selesai Pada', 'Instruksi Reminder AI', 'Reminder Terakhir', 'Catatan'
];
var SARAN_AI_STATUS = { baru: 'Baru', kerjakan: 'Kerjakan', selesai: 'Selesai', abaikan: 'Abaikan' };
var SARAN_AI_PRIORITAS = { tinggi: 3, sedang: 2, rendah: 1 };

function getLogSaranAISheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SARAN_AI_SHEET);
  if (!sh) {
    sh = ss.insertSheet(SARAN_AI_SHEET);
    sh.getRange(1, 1, 1, SARAN_AI_HEADER.length).setValues([SARAN_AI_HEADER]).setFontWeight('bold');
    sh.getRange('A:A').setNumberFormat('@');
    sh.setFrozenRows(1);
  }
  return sh;
}

function saranAIIso_(v) { return (v instanceof Date) ? v.toISOString() : (v ? String(v) : null); }

function saranAIBarisKeObjek_(r) {
  var metrik = null;
  try { metrik = r[8] ? JSON.parse(r[8]) : null; } catch (e) { metrik = null; }
  var statusKey = String(r[9] || 'Baru').trim().toLowerCase();
  if (!SARAN_AI_STATUS[statusKey]) statusKey = 'baru';
  var mulai = r[12] instanceof Date ? r[12] : null;
  var hariDikerjakan = (statusKey === 'kerjakan' && mulai) ? Math.floor((Date.now() - mulai.getTime()) / 86400000) : null;
  return {
    id: String(r[0]), dibuatPada: saranAIIso_(r[1]), sumber: String(r[2] || ''), modul: String(r[3] || ''),
    kategori: String(r[4] || ''), prioritas: String(r[5] || 'sedang').toLowerCase(), judul: String(r[6] || ''),
    deskripsi: String(r[7] || ''), metrik: metrik, status: statusKey,
    statusDiubahPada: saranAIIso_(r[10]), diubahOleh: String(r[11] || ''), mulaiDikerjakan: saranAIIso_(r[12]),
    selesaiPada: saranAIIso_(r[13]), instruksiReminder: String(r[14] || ''), reminderTerakhir: saranAIIso_(r[15]),
    catatan: String(r[16] || ''),
    hariDikerjakan: hariDikerjakan,
    terlambat: hariDikerjakan !== null && hariDikerjakan >= SARAN_AI_REMINDER_HARI
  };
}

function saranAIBacaBaris_(sh) {
  var lr = sh.getLastRow();
  if (lr < 2) return [];
  return sh.getRange(2, 1, lr - 1, SARAN_AI_HEADER.length).getValues();
}

// Tambah task yang ID-nya BELUM ada (ID deterministik -> tidak dobel tiap laporan dibuka).
// cobaSaja = true: kalau lock sibuk, lewati diam-diam (dipanggil dari fungsi baca laporan).
function saranAIUpsert_(tasks, sumber, email, cobaSaja) {
  if (!tasks || !tasks.length) return 0;
  var lock = kunciModul_('umum');
  if (!lock.tryLock(cobaSaja ? 3000 : 15000)) {
    if (cobaSaja) return 0;
    throw new Error('Sistem sibuk, coba lagi.');
  }
  try {
    var sh = getLogSaranAISheet();
    var ada = {};
    saranAIBacaBaris_(sh).forEach(function (r) { ada[String(r[0])] = true; });
    var now = new Date(), oleh = email ? getNamaStaff(email) : sumber;
    var baru = [];
    tasks.forEach(function (t) {
      if (!t.id || ada[t.id]) return;
      ada[t.id] = true;
      var prio = String(t.prioritas || 'sedang').toLowerCase();
      baru.push([
        t.id, now, sumber, t.modul || 'Penjualan', t.kategori || 'Umum', SARAN_AI_PRIORITAS[prio] ? prio : 'sedang',
        String(t.judul || '').slice(0, 200), String(t.deskripsi || '').slice(0, 2000),
        t.metrik ? JSON.stringify(t.metrik).slice(0, 5000) : '', 'Baru', now, oleh, '', '', '', '', ''
      ]);
    });
    if (baru.length) {
      var mulai = sh.getLastRow() + 1;
      sh.getRange(mulai, 1, baru.length, 1).setNumberFormat('@');
      sh.getRange(mulai, 1, baru.length, SARAN_AI_HEADER.length).setValues(baru);
    }
    return baru.length;
  } finally {
    lepasKunci_(lock);
  }
}

function saranAIAmbilUntukModul_(modul) {
  var sh = getLogSaranAISheet();
  var batasLama = Date.now() - 14 * 86400000;
  var semua = saranAIBacaBaris_(sh)
    .filter(function (r) { return r[0] && String(r[3] || '') === modul; })
    .map(saranAIBarisKeObjek_);
  // Tampilkan: semua yang masih terbuka + yang ditutup dalam 14 hari terakhir
  var tasks = semua.filter(function (t) {
    if (t.status === 'baru' || t.status === 'kerjakan') return true;
    var diubah = t.statusDiubahPada ? new Date(t.statusDiubahPada).getTime() : 0;
    return diubah >= batasLama;
  });
  var urutStatus = { kerjakan: 0, baru: 1, selesai: 2, abaikan: 3 };
  tasks.sort(function (a, b) {
    return (b.terlambat - a.terlambat) || (urutStatus[a.status] - urutStatus[b.status]) ||
      ((SARAN_AI_PRIORITAS[b.prioritas] || 0) - (SARAN_AI_PRIORITAS[a.prioritas] || 0)) ||
      (String(b.dibuatPada).localeCompare(String(a.dibuatPada)));
  });
  tasks = tasks.slice(0, 60);

  var pengingat = [];
  tasks.forEach(function (t) {
    if (t.terlambat) {
      pengingat.push({
        taskId: t.id, level: 'urgent', judul: t.judul, hariDikerjakan: t.hariDikerjakan,
        pesan: t.instruksiReminder || ('Sudah ' + t.hariDikerjakan + ' hari berstatus "Kerjakan" tanpa diselesaikan. Selesaikan, atau Abaikan kalau sudah tidak relevan.')
      });
    } else if (t.instruksiReminder && (t.status === 'baru' || t.status === 'kerjakan')) {
      pengingat.push({ taskId: t.id, level: 'ai', judul: t.judul, hariDikerjakan: t.hariDikerjakan, pesan: t.instruksiReminder });
    }
  });
  var ringkas = { baru: 0, kerjakan: 0, selesai: 0, abaikan: 0, terlambat: pengingat.filter(function (p) { return p.level === 'urgent'; }).length };
  tasks.forEach(function (t) { ringkas[t.status]++; });
  return { tasks: tasks, pengingat: pengingat, ringkasStatus: ringkas };
}

// Saran berbasis ATURAN dari data layer - kerangka sementara sebelum LLM terhubung.
// ID = kode + periode (minggu/hari), jadi tiap kondisi muncul maksimal 1x per periode.
function saranAIRulePenjualan_(dl) {
  var tz = Session.getScriptTimeZone(), now = new Date();
  var minggu = Utilities.formatDate(now, tz, "YYYY'W'ww");
  var hari = Utilities.formatDate(now, tz, 'yyyyMMdd');
  var bulan = Utilities.formatDate(now, tz, 'yyyyMM');
  var rp = function (n) { return 'Rp ' + Math.round(n || 0).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
  var slug = function (t) { return String(t).toUpperCase().replace(/[^A-Z0-9]/g, ''); };
  var out = [];
  function add(kode, periode, t) { t.id = 'SLS-' + kode + '-' + periode; t.modul = 'Penjualan'; out.push(t); }

  var r = dl.ringkasan, ch = dl.kontribusiChannel || [];
  var mom = r.bulananMTD.momPct, g30 = r.rolling30Hari.growthVs30HariSebelumnyaPct;

  if (mom !== null && mom <= -10) {
    var palingTurun = ch.filter(function (c) { return c.growthPct !== null; }).sort(function (a, b) { return a.growthPct - b.growthPct; })[0];
    add('MOM-TURUN', minggu, {
      kategori: 'Pertumbuhan', prioritas: mom <= -25 ? 'tinggi' : 'sedang',
      judul: 'Omzet bulan ini turun ' + Math.abs(mom) + '% vs periode sama bulan lalu',
      deskripsi: 'MTD ' + rp(r.bulananMTD.omzet) + ' vs ' + rp(r.bulananMTD.pembanding.bulanLaluPeriodeSama.omzet) + ' bulan lalu.' +
        (palingTurun ? ' Channel paling turun: ' + palingTurun.channel + ' (' + palingTurun.growthPct + '%).' : '') +
        ' Cek harga & stok di channel tsb, lalu jadwalkan promo/flash sale minggu ini.',
      metrik: { momPct: mom, omzetMTD: r.bulananMTD.omzet, channelPalingTurun: palingTurun ? palingTurun.channel : null }
    });
  }
  if (g30 !== null && g30 >= 20 && dl.produk.top5.length) {
    add('TUMBUH', minggu, {
      kategori: 'Pertumbuhan', prioritas: 'rendah',
      judul: 'Penjualan naik ' + g30 + '% - amankan stok produk terlaris',
      deskripsi: 'Omzet 30 hari ' + rp(r.rolling30Hari.omzet) + '. Pastikan stok ' + dl.produk.top5.slice(0, 3).map(function (p) { return p.nama; }).join(', ') + ' cukup untuk 2 minggu ke depan.',
      metrik: { growth30HariPct: g30 }
    });
  }
  ch.forEach(function (c) {
    if (c.omzet30HariSebelumnya > 0 && c.omzet === 0) {
      add('CH-MATI-' + slug(c.channel), minggu, {
        kategori: 'Channel', prioritas: 'tinggi',
        judul: 'Channel ' + c.channel + ' tidak ada penjualan 30 hari terakhir',
        deskripsi: 'Sebelumnya ' + rp(c.omzet30HariSebelumnya) + '. Cek status toko/listing, token API, dan stok yang tampil di ' + c.channel + '.',
        metrik: { channel: c.channel, omzet30HariSebelumnya: c.omzet30HariSebelumnya }
      });
    } else if (c.growthPct !== null && c.growthPct <= -30 && c.omzet30HariSebelumnya >= 1000000) {
      add('CH-TURUN-' + slug(c.channel), minggu, {
        kategori: 'Channel', prioritas: 'sedang',
        judul: c.channel + ' turun ' + Math.abs(c.growthPct) + '% dalam 30 hari',
        deskripsi: rp(c.omzet) + ' vs ' + rp(c.omzet30HariSebelumnya) + ' periode sebelumnya. Bandingkan harga dengan kompetitor & aktifkan voucher toko.',
        metrik: { channel: c.channel, growthPct: c.growthPct }
      });
    }
    if (c.sharePct >= 60 && ch.length > 1) {
      add('KONSENTRASI-' + slug(c.channel), bulan, {
        kategori: 'Channel', prioritas: 'rendah',
        judul: c.sharePct + '% omzet bergantung pada ' + c.channel,
        deskripsi: 'Risiko tinggi kalau channel ini bermasalah. Dorong channel kedua lewat promo khusus / produk eksklusif.',
        metrik: { channel: c.channel, sharePct: c.sharePct }
      });
    }
  });
  dl.produk.top5.forEach(function (p) {
    var perHari = p.qty30Hari / 30;
    if (p.onHand !== null && perHari > 0 && p.onHand < perHari * 7) {
      add('STOK-TOP-' + slug(p.sku), minggu, {
        kategori: 'Stok', prioritas: p.onHand <= 0 ? 'tinggi' : 'sedang',
        judul: 'Stok ' + p.nama + ' cukup < 7 hari',
        deskripsi: 'On Hand ' + p.onHand + ', laku ±' + (Math.round(perHari * 10) / 10) + '/hari. Buat PO / restock sekarang supaya tidak kehabisan.',
        metrik: { sku: p.sku, onHand: p.onHand, qty30Hari: p.qty30Hari }
      });
    }
  });
  if (dl.produk.bottom3SlowMoving.length) {
    add('SLOW', minggu, {
      kategori: 'Produk', prioritas: 'sedang',
      judul: 'Gerakkan ' + dl.produk.bottom3SlowMoving.length + ' produk slow moving',
      deskripsi: dl.produk.bottom3SlowMoving.map(function (p) {
        return p.nama + ' (' + p.qty30Hari + ' terjual/30 hari' + (p.hariSejakTerjualTerakhir !== null ? ', terakhir ' + p.hariSejakTerjualTerakhir + ' hari lalu' : '') + ')';
      }).join('; ') + '. Opsi: bundling dengan produk terlaris, diskon terbatas, atau turunkan prioritas restock.',
      metrik: { sku: dl.produk.bottom3SlowMoving.map(function (p) { return p.sku; }) }
    });
  }
  var bt = r.rolling30Hari.batal;
  if (bt.ratePct >= 10 && bt.jumlah >= 5) {
    add('BATAL-TINGGI', minggu, {
      kategori: 'Operasional', prioritas: 'tinggi',
      judul: 'Tingkat pembatalan ' + bt.ratePct + '% (' + bt.jumlah + ' pesanan)',
      deskripsi: 'Nilai batal 30 hari ' + rp(bt.nilai) + '. Cek alasan batal terbanyak (stok kosong? proses lambat?) dan perbaiki penyebab utamanya.',
      metrik: { batalRatePct: bt.ratePct, jumlahBatal: bt.jumlah }
    });
  }
  var op = dl.operasional;
  if (op.pesananTikTokButuhDataPembeli > 0) {
    add('DATA-PEMBELI', hari, {
      kategori: 'Operasional', prioritas: op.pesananTikTokButuhDataPembeli >= 10 ? 'tinggi' : 'sedang',
      judul: 'Isi data pembeli untuk ' + op.pesananTikTokButuhDataPembeli + ' pesanan TikTok',
      deskripsi: 'Data pembeli manual diperlukan untuk invoice & CRM. Buka Penjualan > Transaksi Penjualan, pilih pesanan lalu "Input Data Pembeli".',
      metrik: { jumlah: op.pesananTikTokButuhDataPembeli }
    });
  }
  if (op.pesananBelumAdaResi30Hari >= 5) {
    add('RESI-BELUM', hari, {
      kategori: 'Operasional', prioritas: 'sedang',
      judul: op.pesananBelumAdaResi30Hari + ' pesanan 30 hari terakhir belum ada resi',
      deskripsi: 'Proses pengiriman yang tertunda berisiko dibatalkan otomatis oleh marketplace. Prioritaskan yang paling lama.',
      metrik: { jumlah: op.pesananBelumAdaResi30Hari }
    });
  }
  return out;
}

function prosesLihatSaranAIPenjualan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var s = saranAIAmbilUntukModul_(data.modul || 'Penjualan');
    result.success = true;
    result.tasks = s.tasks; result.pengingat = s.pengingat; result.ringkasStatus = s.ringkasStatus;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesUpdateStatusSaranAI(data) {
  var taskId, statusKey;
  return withTransaction(data.email, 'buatInvoice', 'umum', function () {
    var result = { success: false };
    if (!SARAN_AI_STATUS[statusKey]) throw new Error('Status tidak valid: ' + data.status);

    var sh = getLogSaranAISheet();
    var ids = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, 1).getDisplayValues() : [];
    var row = -1;
    for (var i = 0; i < ids.length; i++) { if (String(ids[i][0]).trim() === taskId) { row = i + 2; break; } }
    if (row < 0) throw new Error('Task ' + taskId + ' tidak ditemukan di Log Saran AI.');

    var r = sh.getRange(row, 1, 1, SARAN_AI_HEADER.length).getValues()[0];
    var now = new Date();
    r[9] = SARAN_AI_STATUS[statusKey];
    r[10] = now;
    r[11] = getNamaStaff(data.email);
    if (statusKey === 'kerjakan') { r[12] = now; r[13] = ''; }        // mulai (ulang) hitungan 3 hari
    else if (statusKey === 'selesai') { r[13] = now; }
    else if (statusKey === 'baru') { r[12] = ''; r[13] = ''; }       // "Buka lagi"
    if (statusKey !== 'kerjakan') r[14] = '';                         // instruksi reminder tidak relevan lagi
    if (data.catatan) r[16] = String(data.catatan).slice(0, 1000);
    sh.getRange(row, 1, 1, SARAN_AI_HEADER.length).setValues([r]);
    result.success = true;
    result.task = saranAIBarisKeObjek_(r);
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      taskId = String(data.taskId || '').trim();
      statusKey = String(data.status || '').trim().toLowerCase();
      if (!taskId) throw new Error('Task ID kosong');
    }
  });
}

// Pintu masuk untuk LLM: simpan saran hasil analisis data layer (sumber = "LLM").
function prosesSimpanSaranAIEksternal(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tasks = Array.isArray(data.tasks) ? data.tasks : [];
    if (!tasks.length) throw new Error('tasks kosong');
    var stamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMddHHmmss');
    var bersih = tasks.slice(0, 20).map(function (t, i) {
      if (!t || !String(t.judul || '').trim()) return null;
      return {
        id: String(t.id || ('LLM-' + stamp + '-' + (i + 1))).replace(/[^A-Za-z0-9_\-]/g, '').slice(0, 80),
        modul: String(data.modul || t.modul || 'Penjualan'), kategori: t.kategori, prioritas: t.prioritas,
        judul: t.judul, deskripsi: t.deskripsi, metrik: t.metrik || null
      };
    }).filter(Boolean);
    result.jumlahBaru = saranAIUpsert_(bersih, 'LLM', data.email, false);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// LLM membaca log -> menyuntik instruksi pengingat ke task tertentu (tampil merah di UI)
function prosesSuntikReminderSaranAI(data) {
  var taskId, instruksi;
  return withTransaction(data.email, 'buatInvoice', 'umum', function () {
    var result = { success: false };
    var sh = getLogSaranAISheet();
    var ids = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, 1).getDisplayValues() : [];
    var row = -1;
    for (var i = 0; i < ids.length; i++) { if (String(ids[i][0]).trim() === taskId) { row = i + 2; break; } }
    if (row < 0) throw new Error('Task ' + taskId + ' tidak ditemukan.');
    sh.getRange(row, 15, 1, 2).setValues([[instruksi, new Date()]]);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      taskId = String(data.taskId || '').trim();
      instruksi = String(data.instruksi || '').trim().slice(0, 500);
      if (!taskId || !instruksi) throw new Error('taskId & instruksi wajib diisi');
    }
  });
}

function prosesRefreshPesananManual(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    pastikanTokenTikTokMasihValid();
    var hasilTiktok = prosesSyncPesananTikTokShop({ dariSistem: true });
    var hasilShopee = { success: false };
    try { hasilShopee = prosesSyncPesananShopee({ dariSistem: true }); } catch (eShopee) { hasilShopee.error = eShopee.toString(); }

    result.success = hasilTiktok.success || hasilShopee.success;
    result.jumlahBaruTiktok = hasilTiktok.jumlahBaru || 0;
    result.jumlahBaruShopee = hasilShopee.jumlahBaru || 0;
    if (!result.success) result.error = (hasilTiktok.error || '') + ' ' + (hasilShopee.error || '');
    invalidasiCacheGabunganPesanan(); // pastikan sinkron delta browser langsung melihat hasil sync, bukan cache 20 detik
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesSyncPesananTikTokShopOtomatis() {
  if (urlFetchSedangDiblokir()) { Logger.log('⏸ Sync TikTok dilewati - kuota UrlFetch lagi habis (rem darurat aktif).'); return { success: false, error: 'Kuota UrlFetch habis' }; }
  pastikanTokenTikTokMasihValid(); // cek & refresh token DULUAN sebelum coba sync apapun

  // Pesanan disync TIAP KALI trigger jalan (tiap 5 menit) - ini yang paling perlu selalu fresh.
  var hasilPesanan = prosesSyncPesananTikTokShop({ dariSistem: true });
  Logger.log('Sync otomatis Pesanan TikTok Shop: ' + JSON.stringify(hasilPesanan));

  // Produk & Virtual Stock nggak perlu SESERING itu (produk jarang berubah) - cukup tiap ~10 menit,
  // biar nggak boros manggil API terus-menerus tanpa perlu.
  var props = PropertiesService.getScriptProperties();
  var waktuSyncProdukTerakhir = props.getProperty('WAKTU_SYNC_PRODUK_TERAKHIR');
  var perluSyncProduk = !waktuSyncProdukTerakhir || (Date.now() - parseInt(waktuSyncProdukTerakhir, 10)) > 10 * 60 * 1000;

  if (perluSyncProduk && kuotaUrlFetchMenipis()) perluSyncProduk = false; // kuota menipis - prioritaskan pesanan
  if (perluSyncProduk) {
    try {
      var hasilProduk = denganIzinSistem_(function () { return prosesSyncProdukTikTokShop({ dariSistem: true, email: SISTEM_EMAIL_ }); });
      Logger.log('Sync otomatis Produk TikTok Shop: ' + JSON.stringify(hasilProduk));
      if (props.getProperty('VIRTUAL_STOCK_AKTIF_TIKTOK') === 'true') {
        var hasilVS = denganIzinSistem_(function () { return prosesUpdateVirtualStockSemua({ dariSistem: true, email: SISTEM_EMAIL_ }); });
        Logger.log('Update otomatis Virtual Stock: ' + JSON.stringify(hasilVS));
      }
      props.setProperty('WAKTU_SYNC_PRODUK_TERAKHIR', String(Date.now()));
    } catch (eProdukVS) {
      Logger.log('Gagal sync produk/virtual stock otomatis: ' + eProdukVS.toString());
    }
  }

  // Retur juga nggak perlu SESERING pesanan (jarang ada retur baru tiap menit) - cukup tiap ~10 menit.
  var waktuSyncReturTerakhir = props.getProperty('WAKTU_SYNC_RETUR_TERAKHIR');
  var perluSyncRetur = !waktuSyncReturTerakhir || (Date.now() - parseInt(waktuSyncReturTerakhir, 10)) > 10 * 60 * 1000;
  if (perluSyncRetur && kuotaUrlFetchMenipis()) perluSyncRetur = false;
  if (perluSyncRetur) {
    try {
      var hasilRetur = denganIzinSistem_(function () { return prosesSyncReturTikTok({ dariSistem: true, email: SISTEM_EMAIL_ }); });
      Logger.log('Sync otomatis Retur TikTok Shop: ' + JSON.stringify(hasilRetur));
      props.setProperty('WAKTU_SYNC_RETUR_TERAKHIR', String(Date.now()));
    } catch (eRetur) {
      Logger.log('Gagal sync retur otomatis: ' + eRetur.toString());
    }
  }

  return hasilPesanan;
}

// JALANKAN INI SEKALI SAJA (klik ▶ Run manual di editor) buat mengaktifkan sync otomatis tiap 5 menit.
// Sengaja nggak dipasang tiap 1 menit (walau itu bisa) - biar hemat jatah kuota harian Apps Script
// (akun Gmail gratis cuma dapat 90 menit/hari total eksekusi). Butuh update lebih cepat dari 5 menit?
// Pakai tombol "🔄 Refresh Pesanan" manual di halaman Transaksi Penjualan - itu instan kapan aja.
function aktifkanSyncOtomatisTikTok() {
  hapusSyncOtomatisTikTok(); // bersihin dulu kalau ada yang lama
  ScriptApp.newTrigger('prosesSyncPesananTikTokShopOtomatis')
    .timeBased()
    .everyMinutes(5)
    .create();
  Logger.log('✅ Sync otomatis AKTIF - bakal jalan sendiri tiap 5 menit dari sekarang.');
}

// Jalankan ini kalau mau MATIKAN sync otomatis.
function hapusSyncOtomatisTikTok() {
  var triggers = ScriptApp.getProjectTriggers();
  var dihapus = 0;
  triggers.forEach(function (t) {
    if (t.getHandlerFunction() === 'prosesSyncPesananTikTokShopOtomatis') {
      ScriptApp.deleteTrigger(t);
      dihapus++;
    }
  });
  Logger.log(dihapus > 0 ? '✅ ' + dihapus + ' trigger lama dihapus.' : 'Nggak ada trigger aktif buat dihapus.');
}

// Cek ulang status pesanan yang MASIH AKTIF (belum COMPLETED/CANCELLED) di Sheet kita,
// update kalau ternyata udah berubah di sisi TikTok. Ini nutupin celah dari sync
// berbasis "cuma pesanan baru" - status pesanan lama yang berubah tetap ke-update.
function prosesUpdateStatusPesananAktifTikTok(accessToken, shopCipher, anggaranTracking) {
  anggaranTracking = anggaranTracking || { sisa: TRACKING_FALLBACK_MAKS_PER_JALAN };
  var sh = getPesananTikTokShopSheet();
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return 0;

  var batasUmurMs = Date.now() - STATUS_AKTIF_MAKS_UMUR_HARI * 24 * 60 * 60 * 1000;
  var vals = sh.getRange(2, 1, lastRow - 1, 7).getValues(); // Order ID, Tanggal, Produk, Total, Status, Kurir, No Resi
  var rowPesananAktif = []; // { row, orderId, resiKosong }
  for (var i = 0; i < vals.length; i++) {
    var status = String(vals[i][4] || '').trim();
    if (!vals[i][0] || status === 'COMPLETED' || status === 'CANCELLED') continue;
    var tgl = vals[i][1];
    if (tgl instanceof Date && tgl.getTime() < batasUmurMs) continue; // pesanan lama nyangkut - nggak dicek tiap sync
    var resiLama = resiTeks_(vals[i][6], vals[i][5]);
    rowPesananAktif.push({ row: i + 2, orderId: typeof vals[i][0] === 'number' ? kunciResi_(vals[i][0]) : String(vals[i][0]), resiKosong: !resiLama || resiLama === '-' });
  }
  if (rowPesananAktif.length === 0) return 0;
  // FIX: dulu selalu mulai dari baris teratas (pesanan terlama) -> pesanan terbaru tidak pernah kebagian
  rowPesananAktif = urutkanPrioritasAktif_(rowPesananAktif, 'PRIORITAS_OFFSET_TIKTOK', MAKS_BATCH_STATUS_PER_JALAN * 20);

  // ===== FASE 1 (TANPA LOCK): tanya status ke TikTok per batch 20, kumpulkan hasilnya =====
  var hasil = {}; // orderId -> { status, resi, resiKosong }
  var UKURAN_BATCH = 20; // batasi per panggilan biar URL nggak kepanjangan
  for (var b = 0; b < rowPesananAktif.length; b += UKURAN_BATCH) {
    if (b / UKURAN_BATCH >= MAKS_BATCH_STATUS_PER_JALAN) break; // sisanya kebagian di jadwal berikutnya
    var batch = rowPesananAktif.slice(b, b + UKURAN_BATCH);
    var idsBatch = batch.map(function (r) { return r.orderId; }).join(',');
    var resiKosongPerOrderId = {};
    batch.forEach(function (r) { resiKosongPerOrderId[r.orderId] = r.resiKosong; });

    try {
      var path = '/order/202309/orders';
      var paramsUntukSign = {
        app_key: getTiktokAppKey(),
        timestamp: String(Math.floor(Date.now() / 1000)),
        shop_cipher: shopCipher,
        version: '202309',
        ids: idsBatch
      };
      var signature = buatSignatureTikTok(path, paramsUntukSign);
      var url = 'https://open-api.tiktokglobalshop.com' + path +
        '?app_key=' + encodeURIComponent(getTiktokAppKey()) +
        '&shop_cipher=' + encodeURIComponent(shopCipher) +
        '&timestamp=' + paramsUntukSign.timestamp +
        '&version=' + paramsUntukSign.version +
        '&ids=' + encodeURIComponent(idsBatch) +
        '&sign=' + signature;

      var res = fetchHemat(url, { method: 'get', headers: { 'x-tts-access-token': accessToken }, muteHttpExceptions: true });
      if (res.getResponseCode() !== 200) continue; // lewati batch ini kalau gagal, jangan sampai gagalin semuanya

      var parsed = JSON.parse(res.getContentText());
      ((parsed.data && parsed.data.orders) || []).forEach(function (o) {
        var idO = String(o.id);
        var tracking = o.tracking_number || '';
        // Fallback endpoint paket HANYA kalau resi di sheet masih kosong (dibatasi anggaran & jeda per pesanan)
        if (!tracking && resiKosongPerOrderId[idO]) {
          var packageIdAktif = (o.packages && o.packages.length > 0) ? o.packages[0].id : '-';
          tracking = ambilTrackingTikTokHemat(packageIdAktif, o.status, accessToken, shopCipher, anggaranTracking);
        }
        hasil[idO] = { status: String(o.status || ''), resi: tracking || '', resiKosong: !!resiKosongPerOrderId[idO] };
      });
    } catch (e) {
      if (urlFetchSedangDiblokir()) break; // kuota habis - berhenti, jangan lanjut batch lain
      continue;
    }
  }
  if (!Object.keys(hasil).length) return 0;

  // ===== FASE 2 (LOCK SINGKAT): baca ulang, tulis HANYA sel yang benar-benar berubah, per blok =====
  var jumlahDiupdate = 0;
  denganKunciTulis_(function () {
    var lr = sh.getLastRow();
    if (lr < 2) return;
    var v = sh.getRange(2, 1, lr - 1, 7).getValues();
    var tglSelesai = sh.getRange(2, 18, lr - 1, 1).getValues();
    var petaStatus = {}, petaResi = {}, petaTgl = {}, sudah = {};
    v.forEach(function (r, i) {
      var id = typeof r[0] === 'number' ? kunciResi_(r[0]) : String(r[0] || '').trim();
      var h = id && hasil[id];
      if (!h || sudah[id] || !h.status) return;
      sudah[id] = true;
      var row = i + 2;
      if (h.status !== String(r[4] || '').trim()) { petaStatus[row] = h.status; jumlahDiupdate++; }
      var resiSkrg = resiTeks_(r[6], r[5]);
      // JANGAN timpa resi yang sudah ada dengan '-' kalau kali ini nggak dapat resi
      if (h.resi) { if (!resiSama_(resiSkrg, h.resi)) petaResi[row] = String(h.resi); }
      else if (!resiSkrg) petaResi[row] = '-';
      // Stamp tanggal selesai HANYA kalau belum pernah ke-stamp
      if (h.status === 'COMPLETED' && !tglSelesai[i][0]) petaTgl[row] = new Date();
    });
    var n = tulisSelPerBlok_(sh, 5, petaStatus, false) + tulisSelPerBlok_(sh, 7, petaResi, true) + tulisSelPerBlok_(sh, 18, petaTgl, false);
    if (n) { SpreadsheetApp.flush(); invalidasiCacheGabunganPesanan(); }
  }, 20000);
  return jumlahDiupdate;
}

/* ============================================================
   CETAK DOKUMEN / BUAT LABEL TIKTOK SHOP - via Fulfillment API
   ============================================================ */
function prosesCetakDokumenTikTok(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var packageIds = data.packageIds || [];
    if (packageIds.length === 0) throw new Error('Pilih minimal 1 pesanan dulu.');

    var props = PropertiesService.getScriptProperties();
    var accessToken = props.getProperty('TIKTOK_ACCESS_TOKEN');
    var shopCipher = props.getProperty('TIKTOK_SHOP_CIPHER');
    if (!accessToken || !shopCipher) throw new Error('TikTok Shop belum terhubung.');

    var hasilPerPaket = [];
    packageIds.forEach(function (packageId) {
      if (!packageId || packageId === '-') { hasilPerPaket.push({ packageId: packageId, berhasil: false, pesan: 'Package ID tidak valid' }); return; }
      try {
        var path = '/fulfillment/202309/packages/' + packageId + '/shipping_documents';
        var paramsUntukSign = {
          app_key: getTiktokAppKey(),
          timestamp: String(Math.floor(Date.now() / 1000)),
          shop_cipher: shopCipher,
          version: '202309',
          document_type: 'SHIPPING_LABEL'
        };
        var signature = buatSignatureTikTok(path, paramsUntukSign);
        var url = 'https://open-api.tiktokglobalshop.com' + path +
          '?app_key=' + encodeURIComponent(getTiktokAppKey()) +
          '&shop_cipher=' + encodeURIComponent(shopCipher) +
          '&timestamp=' + paramsUntukSign.timestamp +
          '&version=' + paramsUntukSign.version +
          '&document_type=SHIPPING_LABEL' +
          '&sign=' + signature;

        var res = fetchHemat(url, { method: 'get', headers: { 'x-tts-access-token': accessToken }, muteHttpExceptions: true });
        var kode = res.getResponseCode();
        var isiRespons = res.getContentText();

        if (kode === 200) {
          var parsed = JSON.parse(isiRespons);
          var docUrl = parsed.data && (parsed.data.doc_url || parsed.data.url);
          if (docUrl) {
            hasilPerPaket.push({ packageId: packageId, berhasil: true, docUrl: docUrl, isiMentah: isiRespons });
          } else {
            // TikTok balas 200 (bukan error), tapi struktur responsnya beda dari yang kita duga -
            // ini tandanya endpoint/nama field-nya perlu disesuaikan lagi. Tampilkan respons mentahnya biar kelihatan.
            hasilPerPaket.push({ packageId: packageId, berhasil: false, pesan: 'Respons TikTok nggak ada link dokumennya. Isi mentah: ' + isiRespons.substring(0, 200) });
          }
        } else {
          hasilPerPaket.push({ packageId: packageId, berhasil: false, pesan: 'Kode ' + kode + ': ' + isiRespons.substring(0, 200) });
        }
      } catch (e) {
        hasilPerPaket.push({ packageId: packageId, berhasil: false, pesan: e.toString() });
      }
    });

    result.success = true;
    result.hasil = hasilPerPaket;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

