}


/* ####################################################################################
   MODUL CONNER HUB (Web) - Daftar Toko, Pesanan Masuk, Sinkronisasi Stok
   ------------------------------------------------------------------------------------
   "API Conner" = TikTok Shop Open API (versi 202309) untuk toko Conner Hardware, memakai
   kredensial CONNER_* yang SUDAH ada (connerAppKey_/connerAppSecret_, CONNER_ACCESS_TOKEN,
   CONNER_SHOP_CIPHER) + refresh token otomatis pastikanTokenConnerMasihValid().

   Aksi router (dipanggil dari HTML):
     lihat_conner_toko        -> status koneksi + daftar toko (authorization/shops) + daftar gudang (logistics/warehouses)
     lihat_conner_pesanan     -> pesanan dari sheet "Pesanan Conner" (cepat, tanpa API)
     lihat_conner_stok        -> listing sheet "Produk Conner" + stok tersedia OmniAI (mesin 4 pilar)
     conner_tarik_pesanan     -> tarik pesanan baru (prosesSyncPesananConner) + lengkapi resi/status
     conner_tarik_produk      -> tarik semua listing dari API (products/search, berhalaman) ke sheet "Produk Conner"
     conner_update_stok       -> kirim stok ke Conner (products/{id}/inventory/update)
     conner_set_gudang_default-> pilih gudang TikTok default untuk update stok (Owner)
     cek_conner_api           -> lihat respons JSON mentah endpoint tertentu (Owner, untuk debug parsing)

   Prinsip: semua panggilan API lewat cnApi_() -> tanda tangan, token, log error (Log_API_Errors)
   dan retry 1x setelah refresh token ada di SATU tempat.
   #################################################################################### */
var CN_HOST_ = 'https://open-api.tiktokglobalshop.com';
var CN_SHEET_PRODUK_ = 'Produk Conner';
var CN_KOLOM_PRODUK_ = ['Product ID', 'SKU ID', 'Seller SKU', 'Nama Produk', 'Varian', 'Status Produk', 'Warehouse ID',
  'Stok di Conner', 'Harga', 'Ditarik Pada', 'Stok Terkirim Terakhir', 'Waktu Kirim Terakhir'];
var CN_CACHE_TOKO_ = 'CN_TOKO_V1';
var CN_MAKS_HALAMAN_PRODUK_ = 25;   // 25 x 100 = 2.500 listing per tarikan
var CN_MAKS_ITEM_UPDATE_ = 40;      // per request dari browser (browser mengirim bertahap)

function cnBolehLihat_(email) { return cekIzin(email, 'mintaStock') || cekIzin(email, 'buatInvoice'); }

function cnOwner_(email) {
  if (IZIN_SISTEM_) return true;
  var s = getStaffByEmail(email);
  return !!(s && s.role === 'Owner' && s.aktif);
}

function cnFmtWaktu_(ms) {
  if (!ms) return '';
  return Utilities.formatDate(new Date(ms), Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm');
}

// Kredensial Conner. tanpaCipher = untuk endpoint level akun (authorization/shops) yang tidak butuh shop_cipher.
function cnKred_(tanpaCipher) {
  try { pastikanTokenConnerMasihValid(); } catch (eTok) { Logger.log('Cek token Conner: ' + eTok); }
  var p = PropertiesService.getScriptProperties();
  var k = {
    appKey: connerAppKey_(), appSecret: connerAppSecret_(),
    accessToken: p.getProperty('CONNER_ACCESS_TOKEN') || '', shopCipher: p.getProperty('CONNER_SHOP_CIPHER') || ''
  };
  if (!k.appKey || !k.appSecret) throw new Error('App Key / App Secret Conner belum diisi. Lengkapi di Pengaturan > Otorisasi Marketplace.');
  if (!k.accessToken) throw new Error('Toko Conner belum diotorisasi (Access Token kosong). Hubungkan toko di Pengaturan > Otorisasi Marketplace.');
  if (!tanpaCipher && !k.shopCipher) throw new Error('Shop Cipher Conner belum tersimpan. Buka tab Daftar Toko lalu klik Muat ulang - cipher diisi otomatis.');
  return k;
}

/* Panggil API TikTok Shop toko Conner.
   method : 'get' | 'post'
   query  : parameter tambahan di URL (ikut ditandatangani), mis. { page_size: 100, page_token: '...' }
   body   : objek body untuk POST (ikut ditandatangani)
   opsi   : { tanpaCipher, mentah (balikan {http,json,teks} apa adanya), target (label log), _ulang } */
function cnApi_(method, path, query, body, opsi) {
  opsi = opsi || {};
  method = String(method || 'get').toLowerCase();
  var k = cnKred_(opsi.tanpaCipher);
  var params = { app_key: k.appKey, timestamp: String(Math.floor(Date.now() / 1000)), version: '202309' };
  if (!opsi.tanpaCipher) params.shop_cipher = k.shopCipher;
  Object.keys(query || {}).forEach(function (q) {
    var v = query[q];
    if (v !== undefined && v !== null && v !== '') params[q] = String(v);
  });
  var bodyString = method === 'post' ? JSON.stringify(body || {}) : '';
  var sign = buatSignatureTikTok(path, params, bodyString, k.appSecret);
  var qs = Object.keys(params).map(function (n) { return encodeURIComponent(n) + '=' + encodeURIComponent(params[n]); }).join('&');
  var req = { method: method, headers: { 'x-tts-access-token': k.accessToken }, muteHttpExceptions: true };
  if (bodyString) { req.contentType = 'application/json'; req.payload = bodyString; }

  var res = fetchHemat(CN_HOST_ + path + '?' + qs + '&sign=' + sign, req);
  var http = res.getResponseCode(), teks = res.getContentText() || '';
  var json = null;
  try { json = JSON.parse(teks); } catch (eJ) { }

  // Token kedaluwarsa di tengah jalan -> refresh sekali lalu ulangi
  var kode = json && json.code;
  if (!opsi._ulang && (kode === 105002 || kode === 105001 || /access.?token.*(expire|invalid)/i.test(String(json && json.message || '')))) {
    var r = refreshConnerAccessToken();
    if (r && r.success) return cnApi_(method, path, query, body, Object.assign({}, opsi, { _ulang: true }));
  }
  if (opsi.mentah) return { http: http, json: json, teks: json ? '' : teks.slice(0, 5000) };

  if (http !== 200 || !json || (kode !== undefined && kode !== 0)) {
    try { apiErrCatat_('Conner Hardware', path, opsi.target || '', bodyString || JSON.stringify(query || {}), http, json, teks); } catch (eL) { }
    var pesan = (json && json.message) ? json.message : teks.slice(0, 200);
    var err = new Error('API Conner ' + path + ' ditolak (HTTP ' + http + (kode ? ', kode ' + kode : '') + '): ' + pesan);
    err.kode = kode;
    throw err;
  }
  return json.data || {};
}

/* ---------- TAB 1: DAFTAR TOKO CONNER ---------- */
function prosesLihatConnerToko(data) {
  var result = { success: false };
  try {
    if (!cnBolehLihat_(data.email)) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var props = PropertiesService.getScriptProperties();

    // Status lokal (murah, selalu segar)
    var expMs = parseInt(props.getProperty('CONNER_TOKEN_EXPIRED_AT') || '0', 10);
    var syncDetik = parseInt(props.getProperty('CONNER_WAKTU_SYNC_TERAKHIR') || '0', 10);
    var autoSync = false;
    try { autoSync = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'prosesSyncPesananConnerOtomatis'; }); } catch (eT) { }
    var jumlahPesanan = 0;
    try { jumlahPesanan = Math.max(0, getPesananConnerSheet().getLastRow() - 1); } catch (eP) { }
    var status = {
      punyaKredensial: !!(connerAppKey_() && connerAppSecret_()),
      punyaToken: !!props.getProperty('CONNER_ACCESS_TOKEN'),
      punyaCipher: !!props.getProperty('CONNER_SHOP_CIPHER'),
      tokenBerlakuSampai: expMs ? cnFmtWaktu_(expMs) : '',
      tokenSisaHari: expMs ? Math.floor((expMs - Date.now()) / 86400000) : null,
      authVia: props.getProperty('CONNER_AUTH_VIA') || 'SENDIRI',
      syncTerakhir: syncDetik ? cnFmtWaktu_(syncDetik * 1000) : '',
      autoSync: autoSync,
      jumlahPesanan: jumlahPesanan,
      gudangDefault: props.getProperty('CONNER_GUDANG_DEFAULT') || ''
    };
    status.terhubung = status.punyaKredensial && status.punyaToken;
    result.status = status;
    result.toko = []; result.gudang = []; result.peringatan = [];

    if (!status.terhubung) {
      result.success = true;
      result.pesan = !status.punyaKredensial ? 'App Key / App Secret Conner belum diisi.' : 'Toko Conner belum diotorisasi.';
      return result;
    }

    // Bagian API di-cache 10 menit (hemat kuota UrlFetch); tombol Muat ulang mengirim segar=true
    var cache = CacheService.getScriptCache();
    var dariCache = !data.segar ? cache.get(CN_CACHE_TOKO_) : null;
    var api = null;
    if (dariCache) { try { api = JSON.parse(dariCache); } catch (eC) { api = null; } }
    if (!api) {
      api = { toko: [], gudang: [], peringatan: [], waktu: cnFmtWaktu_(Date.now()) };
      try {
        var dShops = cnApi_('get', '/authorization/202309/shops', {}, null, { tanpaCipher: true, target: 'daftar toko' });
        var cipherTersimpan = props.getProperty('CONNER_SHOP_CIPHER') || '';
        (dShops.shops || []).forEach(function (s) {
          api.toko.push({
            id: String(s.id || ''), nama: s.name || '-', region: s.region || '-', tipe: s.seller_type || '-',
            kode: s.code || '', aktifDiOmni: !!(s.cipher && s.cipher === cipherTersimpan)
          });
        });
        // Cipher belum tersimpan & hanya 1 toko -> simpan otomatis (Make it smart)
        if (!cipherTersimpan && dShops.shops && dShops.shops.length === 1 && dShops.shops[0].cipher) {
          props.setProperty('CONNER_SHOP_CIPHER', dShops.shops[0].cipher);
          api.toko[0].aktifDiOmni = true;
          api.peringatan.push('Shop Cipher Conner tersimpan otomatis.');
        } else if (!cipherTersimpan && dShops.shops && dShops.shops.length > 1) {
          api.peringatan.push('Akun ini punya ' + dShops.shops.length + ' toko - Shop Cipher belum dipilih. Otorisasi ulang toko Conner di Pengaturan.');
        }
      } catch (eS) { api.peringatan.push('Daftar toko: ' + (eS.message || eS)); }

      try {
        var dWh = cnApi_('get', '/logistics/202309/warehouses', {}, null, { target: 'daftar gudang' });
        (dWh.warehouses || []).forEach(function (w) {
          var a = w.address || {};
          api.gudang.push({
            id: String(w.id || ''), nama: w.name || '-', status: w.effect_status || '-', tipe: w.type || '-',
            subTipe: w.sub_type || '', defaultTikTok: !!w.is_default,
            alamat: a.full_address || [a.address_line1, a.city, a.region].filter(function (x) { return x; }).join(', ')
          });
        });
      } catch (eW) { api.peringatan.push('Daftar gudang: ' + (eW.message || eW)); }
      try { cache.put(CN_CACHE_TOKO_, JSON.stringify(api), 600); } catch (eCP) { }
    }

    // Gudang default belum dipilih -> pakai gudang penjualan default dari TikTok (otomatis, bisa diganti)
    if (!status.gudangDefault) {
      var gd = api.gudang.filter(function (g) { return g.defaultTikTok && /SALES/i.test(g.tipe); })[0]
        || api.gudang.filter(function (g) { return /SALES/i.test(g.tipe); })[0];
      if (gd) { props.setProperty('CONNER_GUDANG_DEFAULT', gd.id); status.gudangDefault = gd.id; }
    }

    result.toko = api.toko;
    result.gudang = api.gudang;
    result.peringatan = api.peringatan;
    result.diperbarui = api.waktu;
    result.success = true;
  } catch (err) { result.error = err.message || String(err); }
  return result;
}

