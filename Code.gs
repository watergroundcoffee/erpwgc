/* ============================================================
   SHOPEE OPEN PLATFORM - otorisasi, tukar token, refresh, tes koneksi
   ============================================================ */
// Bikin tanda tangan (signature) HMAC-SHA256 sesuai aturan resmi Shopee Open Platform v2.
// Untuk API PUBLIK (belum ada access_token, misal: bikin link otorisasi, tukar code jadi token):
//   base string = partner_id + path + timestamp
// Untuk API TOKO (sudah ada access_token, misal: get_shop_info, get_order_list):
//   base string = partner_id + path + timestamp + access_token + shop_id
// accessToken & shopId boleh dikosongkan (undefined) kalau lagi bikin signature buat API publik.
function buatSignatureShopee(path, timestamp, accessToken, shopId) {
  var baseString = getShopeePartnerId() + path + timestamp + (accessToken || '') + (shopId || '');
  var signatureBytes = Utilities.computeHmacSha256Signature(baseString, getShopeePartnerKey());
  var signatureHex = signatureBytes.map(function (byte) {
    var v = (byte < 0 ? byte + 256 : byte).toString(16);
    return v.length === 1 ? '0' + v : v;
  }).join('');
  return signatureHex; // huruf kecil (lowercase hex)
}

