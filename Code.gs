    }
    var url = 'https://maps.googleapis.com/maps/api/geocode/json?language=id&region=id&key=' + encodeURIComponent(key) +
      (data.mode === 'balik' ? '&latlng=' + Number(data.lat) + ',' + Number(data.lng) : '&address=' + encodeURIComponent(String(data.q || '')));
    j = JSON.parse(UrlFetchApp.fetch(url, { muteHttpExceptions: true }).getContentText() || '{}');
    if (j.status && j.status !== 'OK' && j.status !== 'ZERO_RESULTS') throw new Error('Google: ' + j.status + (j.error_message ? ' - ' + j.error_message : ''));
    var r0 = (j.results || [])[0];
    if (!r0) return { success: true, google: true, hasil: null };
    var h = p87GeoKomponen_(r0.address_components, r0.geometry && r0.geometry.location, r0.formatted_address);
    h.presisi = r0.geometry ? r0.geometry.location_type : '';
    return { success: true, google: true, hasil: h };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}


