    result.error = err.toString();
  }
  return result;
}

/* ===== FORMAT NO HP STANDAR INTERNASIONAL: +62 813-1472-1287 =====
   0813..., 62813..., +62 813..., 813... -> "+62 813-1472-1287". Nomor tersamar (ada * / huruf) atau
   terlalu pendek dibiarkan apa adanya. hpKunci_ = pembanding (digit saja, diawali 62). */
function formatNoHpIntl_(v) {
  var asli = String(v == null ? '' : v).trim();
  if (!asli || /[*a-zA-Z]/.test(asli)) return asli;
  var d = asli.replace(/\D/g, '');
  if (d.length < 8) return asli;
  if (d.indexOf('0062') === 0) d = d.slice(2);
  if (d.charAt(0) === '0') d = '62' + d.slice(1);
  else if (d.indexOf('62') !== 0) d = '62' + d;
  var n = d.slice(2);
  if (n.length < 7 || n.length > 13) return asli;
  return '+62 ' + n.slice(0, 3) + '-' + n.slice(3, 7) + (n.length > 7 ? '-' + n.slice(7) : '');
}
function hpKunci_(v) {
  var d = String(v || '').replace(/\D/g, '');
  if (d.charAt(0) === '0') d = '62' + d.slice(1);
  return d.length >= 8 ? d : '';
}
// Rapikan semua No HP lama di sheet Data Pembeli (dijalankan saat Kelola Pelanggan dimuat, maks 1x / 30 menit)
function rapikanNoHpDataPembeli_() {
  var cache = CacheService.getScriptCache();
  if (cache.get('PEL_HP_RAPI_V1')) return 0;
  var lock = kunciModul_('penjualan');
  if (!lock.tryLock(5000)) return 0;
  var n = 0;
  try {
    var sh = getDataPembeliSheet(), lr = sh.getLastRow();
    if (lr > 1) {
      var rg = sh.getRange(2, 3, lr - 1, 1), v = rg.getValues();
      v.forEach(function (r) { var b = formatNoHpIntl_(r[0]); if (b !== String(r[0] == null ? '' : r[0]).trim() || (typeof r[0] === 'number' && b)) { r[0] = b; n++; } });
      if (n) { rg.setNumberFormat('@'); rg.setValues(v); }
    }
    cache.put('PEL_HP_RAPI_V1', '1', 1800);
  } catch (e) { Logger.log('rapikanNoHpDataPembeli_: ' + e); } finally { lepasKunci_(lock); }
  return n;
}

function simpanAtauUpdatePembeli(nama, alamat, noHp) {
  var sh = getDataPembeliSheet();
  var lastRow = sh.getLastRow();
  noHp = formatNoHpIntl_(noHp);

  if (lastRow > 1) {
    var values = sh.getRange(2, 1, lastRow - 1, 3).getValues();
    for (var i = 0; i < values.length; i++) {
      var cocokHp = noHp && hpKunci_(noHp) && hpKunci_(values[i][2]) === hpKunci_(noHp);
      var cocokNama = !noHp && String(values[i][0] || '').trim().toLowerCase() === nama.trim().toLowerCase();
      if (cocokHp || cocokNama) {
        sh.getRange(i + 2, 3).setNumberFormat('@');
        sh.getRange(i + 2, 1, 1, 3).setValues([[nama, alamat, noHp]]);
        return;
      }
    }
  }
  var newRow = lastRow + 1;
  sh.getRange(newRow, 3).setNumberFormat('@');
  sh.getRange(newRow, 1, 1, 3).setValues([[nama, alamat, noHp]]);
  sh.getRange(newRow, 8, 1, 2).setValues([['PO Sales', new Date()]]); // Sumber Kontak, Tanggal Kontak Pertama
}

