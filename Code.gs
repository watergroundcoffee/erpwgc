// ---------- Finance: penanda baris Stock Ledger "Masuk" yang berarti barang jualan kembali ----------
function finApakahReturStok_(ket) {
  var k = String(ket || '');
  return k.indexOf('Retur diterima baik') === 0 || k.indexOf('Koreksi salah kirim') === 0 || k.indexOf('Retur dari pesanan') === 0 || /^Batal pesanan \S+ sebelum discan/.test(k);
}
function finIdDariKetRetur_(ket) {
  var k = String(ket || ''), m = k.match(/pesanan\s+([A-Za-z0-9\-_\/]+)/i);
  return m ? m[1].trim().toUpperCase() : '';
}
function finCatatIdKanal_(ket, kanal, peta) {
  var k = String(ket || '');
  var m = k.match(/order\s+([A-Za-z0-9\-_]+)/i) || k.match(/\(([A-Za-z0-9\-_\/]{5,})\)/) || k.match(/\[INV:([^\]]+)\]/);
  if (m) peta[String(m[1]).trim().toUpperCase()] = kanal;
}

// ---------- C. Pesanan Shopee yang terlewat sync: ambil dari API & tambahkan (tanpa dobel) ----------
function spSisipkanPesananShopee_(daftarSn) {
  var out = { ditambah: [], sudahAda: [], tidakAda: [], error: '' };
  var norm = function (x) { return String(x || '').toUpperCase().replace(/[^A-Z0-9]/g, ''); };
  var sn = [];
  (daftarSn || []).forEach(function (x) { var k = norm(x); if (k && sn.indexOf(k) === -1 && pgiMiripIdPesanan_(k) === 'shopee') sn.push(k); });
  if (!sn.length) return out;
  var sh = getPesananShopeeSheet(), lr = sh.getLastRow(), ada = {};
  if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r) { ada[norm(r[0])] = true; });
  var perlu = sn.filter(function (k) { if (ada[k]) { out.sudahAda.push(k); return false; } return true; }).slice(0, 50);
  if (!perlu.length) return out;
  var kred = ambilKredensialShopee();
  if (!kred || !kred.accessToken || !kred.shopId) { out.error = 'Shopee belum terhubung'; return out; }
  var rs = shopeeGet_('/api/v2/order/get_order_detail', { order_sn_list: perlu.join(','), response_optional_fields: SHOPEE_FIELD_PEMBELI_ + ',item_list,total_amount,shipping_carrier,order_status,note,package_list' }, kred);
  if (!rs.ok) { out.error = 'Shopee: ' + rs.error + ' ' + rs.pesan; return out; }
  var anggaran = { sisa: 5 }, rencana = [];
  ((rs.json.response && rs.json.response.order_list) || []).forEach(function (o) {
    if (!o || !o.order_sn) return;
    rencana.push(spRencanaDariOrderShopee_(o, kred.accessToken, kred.shopId, anggaran));
  });
  var ketemu = {};
  rencana.forEach(function (r) { ketemu[norm(r.id)] = true; });
  perlu.forEach(function (k) { if (!ketemu[k]) out.tidakAda.push(k); });
  if (!rencana.length) return out;
  denganKunciTulis_(function () {
    var lr2 = sh.getLastRow(), adaSkrg = {};
    if (lr2 > 1) sh.getRange(2, 1, lr2 - 1, 1).getValues().forEach(function (r) { adaSkrg[norm(r[0])] = true; });
    var tulis = rencana.filter(function (r) { return !adaSkrg[norm(r.id)]; });
    if (!tulis.length) return;
    var awal = sh.getLastRow() + 1, ledger = [], detail = [];
    tulis.forEach(function (r) { ledger = ledger.concat(r.ledger); detail = detail.concat(r.detail); });
    sh.getRange(awal, 7, tulis.length, 1).setNumberFormat('@');
    sh.getRange(awal, 1, tulis.length, 17).setValues(tulis.map(function (r) { return r.baris; }));
    try { tambahBarisBatch_(getStockLedgerSheet(), ledger); } catch (e1) { }
    try { tambahBarisBatch_(getPesananMarketplaceDetailSheet('Pesanan Shopee Detail'), detail); } catch (e2) { }
    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();
    try { invalidasiPetaResiRingkas_(); } catch (e3) { }
    tulis.forEach(function (r) { out.ditambah.push(r.id); });
  }, 20000, ['penjualan', 'stok']);
  return out;
}

