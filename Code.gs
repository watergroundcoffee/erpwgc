/* ---------- TAB 2: PESANAN MASUK ---------- */
function prosesLihatConnerPesanan(data) {
  var result = { success: false };
  try {
    if (!cnBolehLihat_(data.email)) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var hari = parseInt(data.hari, 10);
    if (isNaN(hari) || hari < 0) hari = 30;
    var batasMs = hari > 0 ? Date.now() - hari * 86400000 : 0;
    var sh = getPesananConnerSheet(), lr = sh.getLastRow();
    var tz = Session.getScriptTimeZone();
    var daftar = [];
    if (lr > 1) {
      sh.getRange(2, 1, lr - 1, 10).getValues().forEach(function (r) {
        var id = kunciResi_(r[0]);
        if (!id) return;
        var tgl = r[1] instanceof Date ? r[1] : null;
        var ms = tgl ? tgl.getTime() : 0;
        if (batasMs && ms && ms < batasMs) return;
        daftar.push({
          id: id, kode: 'TC-' + id, ms: ms, tanggal: tgl ? Utilities.formatDate(tgl, tz, 'dd MMM yyyy HH:mm') : String(r[1] || ''),
          produk: String(r[2] || ''), total: parseFloat(r[3]) || 0, status: String(r[4] || '').trim().toUpperCase() || '-',
          kurir: String(r[5] || '').trim(), resi: (resiTeks_(r[6], r[5]) || '').replace(/^-$/, ''), nama: String(r[7] || '').trim()
        });
      });
    }
    daftar.sort(function (a, b) { return b.ms - a.ms; });
    if (daftar.length > 3000) daftar = daftar.slice(0, 3000);
    var syncDetik = parseInt(PropertiesService.getScriptProperties().getProperty('CONNER_WAKTU_SYNC_TERAKHIR') || '0', 10);
    result.success = true;
    result.daftar = daftar;
    result.hari = hari;
    result.syncTerakhir = syncDetik ? cnFmtWaktu_(syncDetik * 1000) : '';
  } catch (err) { result.error = err.message || String(err); }
  return result;
}

