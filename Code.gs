        var diskon = Math.max(0, Math.round(parseFloat(inv.diskon) || 0)), ongkir = Math.max(0, Math.round(parseFloat(inv.ongkir) || 0)), biaya = Math.round(parseFloat(inv.biayaLain) || 0);
