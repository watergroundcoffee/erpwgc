}

/* ####################################################################################
   PAKET 10 (v2026.10.23) - PENGIRIMAN & RETUR
   A. Kurir & resi selalu tertulis: kurir diambil dari pesanan bila kolom Kurir "Resi Keluar" kosong / Tidak Diketahui;
      ID Pesanan yang discan -> resi asli (resi pesanan / resi driver hasil cek marketplace). Cek kurir instan ikut jadwal.
   B. Status penerimaan retur ikut dikirim ke Pengiriman > Control (di bawah No Resi Retur).
   C. Retur:
      - retur_terima      : konfirmasi rincian barang -> stok. Logika (disetujui Owner 16 Okt 2026):
          Barang pesanan X kembali BAIK          -> Stock Ledger "Masuk" X (stok utama).
          X kembali RUSAK / tidak kembali         -> TIDAK masuk stok; dicatat NEGATIF di "Jurnal Penyesuaian Stok" (bahan klaim).
          SALAH KIRIM (yang keluar ternyata Y)    -> X ditambah (koreksi: X tidak pernah keluar). Y yang kembali baik = netral;
                                                     Y rusak / tidak kembali -> Stock Ledger "Rusak/Hilang" Y + jurnal negatif.
        Dijalankan SEKALI per resi (jejak di kolom 11 "Retur Detail").
      - retur_klaim_simpan: progres klaim ke marketplace + hasil akhir bahasa akuntansi. "Disetujui" + nilai ->
        Jurnal Transaksi akun "Pendapatan Klaim" (7-102), sekali; nilai berubah -> disesuaikan; tahap mundur -> jurnal dibatalkan.
      - retur_media_salin : salin foto/video unboxing lama (Google Drive) ke Supabase Storage supaya bisa dilihat/diunduh/disalin.
   #################################################################################### */
function p10KurirKosong_(k) { var t = String(k == null ? '' : k).trim(); return !t || t === '-' || /tidak\s*diketahui/i.test(t); }
function p10KurirTampil_(simpan, cocok) { return (p10KurirKosong_(simpan) && cocok && cocok.kurir) ? String(cocok.kurir) : simpan; }
function p10ResiAsli_(scan, cocok) {
  if (!cocok || !cocok.noInvoice || cocok.jenis === 'transfer') return '';
  var ks = kunciResi_(scan);
  if (!ks || ks !== kunciResi_(cocok.noInvoice)) return '';
  var c = String(cocok.resiTautan || cocok.noResi || '').trim();
  return c && kunciResi_(c) !== ks ? c : '';
}
function p10PetaStatusRetur_() {
  var out = {};
  try {
    var d = returBacaDetail_();
    Object.keys(d).forEach(function (k) { var x = d[k]; out[k] = { s: x.statusCek || '', stok: !!(x.terima && x.terima.t), klaim: x.klaim ? String(x.klaim.tahap || '') : '', hasil: x.klaim ? String(x.klaim.hasil || '') : '' }; });
  } catch (e) { }
  return out;
}
function p10StatusRetur_(peta, resiRetur) {
  if (!resiRetur) return null;
  return (peta && peta[kunciResi_(resiRetur)]) || { s: '', stok: false, klaim: '', hasil: '' };
}

// Jadwal: ID Pesanan yang discan (<= 3 hari) dicek ke marketplace -> resi asli/driver + kurir tertulis (maks 10 per jalan)
function p10ResolveInstanTerjadwal_() {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Resi Keluar');
  if (!sh || sh.getLastRow() < 2) return 0;
  var lr = sh.getLastRow(), awal = Math.max(2, lr - 300);
  var vals = sh.getRange(awal, 1, lr - awal + 1, 10).getValues();
  var peta = bangunPetaResiKeSemuaPesananCache_(), batas = Date.now() - 3 * 86400000, daftar = [], lihat = {};
  for (var i = vals.length - 1; i >= 0 && daftar.length < 10; i--) {
    var scan = String(vals[i][0] || '').trim(), t = vals[i][2];
    if (!scan || !(t instanceof Date) || t.getTime() < batas) continue;
    var c = peta[kunciResi_(scan)];
    if (!c || !c.noInvoice || c.jenis === 'transfer' || lihat[kunciResi_(scan)]) continue;
    var idPes = kunciResi_(scan) === kunciResi_(c.noInvoice);
    // v2026.10.24 (DN-085144-953): resi biasa yang kurirnya kosong di Resi Keluar DAN di pesanan -> tanya marketplace
    var kurirHilang = !idPes && p10KurirKosong_(vals[i][9]) && p10KurirKosong_(c.kurir) && /shopee|tiktok|tokopedia|conner/i.test(String(c.sumber || ''));
    if (!idPes && !kurirHilang) continue;
    if (idPes && c.resiTautan && !p10KurirKosong_(vals[i][9]) && !pgiApakahKurirInstan_(vals[i][9])) continue; // sudah lengkap & bukan instan
    lihat[kunciResi_(scan)] = 1;
    daftar.push({ scan: scan, noInvoice: c.noInvoice, sumber: c.sumber });
  }
  if (!daftar.length) return 0;
  PGI_DARI_SISTEM_ = true;
  try { prosesPgrResolveInstant({ daftar: daftar }); } finally { PGI_DARI_SISTEM_ = false; }
  return daftar.length;
}

var P10_KONDISI_ = ['Baik', 'Rusak'];
function p10HargaModal_() {
  var m = {};
  try { var sh = getMasterProdukSheet(), lr = sh.getLastRow(); if (lr > 1) sh.getRange(2, 1, lr - 1, 4).getValues().forEach(function (r) { m[String(r[0]).trim().toUpperCase()] = { nama: String(r[1] || ''), modal: Number(r[3]) || 0 }; }); } catch (e) { }
  return m;
}
function p10SkuInduk_(sku) { var s = String(sku || '').trim(); if (!s) return ''; try { return String(resolveSkuJualCepat_(s) || s).trim(); } catch (e) { return s; } }

// ===== AKSI: retur_terima { noResi, idPesanan, items:[{ sku, nama, qty, terima, kondisi:'Baik'|'Rusak', skuDiterima }] }
function prosesReturTerima(data) {
  var noResi, items;
  return withTransaction(data.email, 'scanResiMasuk', ['pengiriman', 'stok'], function (ktx) {
    var sh = getReturDetailSheet_();
    returPastikanKolomEkstra_(sh);
    var peta = returBacaDetail_(), d = peta[kunciResi_(noResi)];
    if (d && d.terima && d.terima.t) throw new Error('Retur ' + noResi + ' sudah pernah dimasukkan ke stok (' + Utilities.formatDate(new Date(d.terima.t), Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm') + ' oleh ' + (d.terima.oleh || '-') + ').');
    var oleh = ktx.namaStaff() || data.email || '', sekarang = new Date(), tz = Session.getScriptTimeZone();
    var noPesanan = String(data.idPesanan || (d && d.idManual) || '').trim();
    var master = p10HargaModal_();
    var ledger = [], jurnal = [], aktual = [], ringkas = [], adaMasalah = false, semuaHilang = true;
    var label = 'resi ' + noResi + (noPesanan ? ' · pesanan ' + noPesanan : '');
    function catatJurnal(sku, nama, qty, tindakan) {
      var harga = (master[String(sku).toUpperCase()] || {}).modal || 0;
      jurnal.push([sekarang, Utilities.formatDate(sekarang, tz, "yyyy-MM-dd'T'HH:mm:ss.SSSXXX"), '-', 'RETUR ' + noResi, noPesanan || '-', sku, nama || (master[String(sku).toUpperCase()] || {}).nama || sku,
        'Negatif', qty, harga, qty * harga, tindakan, String(data.catatan || '').slice(0, 200), oleh, sekarang.getTime()]);
    }
    items.forEach(function (it) {
      var x = p10SkuInduk_(it.sku), y = it.skuDiterima ? p10SkuInduk_(it.skuDiterima) : x;
      var salah = !!y && y.toUpperCase() !== x.toUpperCase();
      var hilang = it.qty - it.terima, nama = it.nama || (master[x.toUpperCase()] || {}).nama || x;
      var namaY = (master[y.toUpperCase()] || {}).nama || y;
      if (it.terima > 0) semuaHilang = false;
      if (!salah) {
        if (it.terima > 0 && it.kondisi === 'Baik') ledger.push([sekarang, x, 'Masuk', it.terima, 'Retur diterima baik · ' + label, oleh]);
        if (it.terima > 0 && it.kondisi === 'Rusak') { catatJurnal(x, nama, it.terima, 'Retur rusak - tidak masuk stok (bahan klaim)'); adaMasalah = true; }
        if (hilang > 0) { catatJurnal(x, nama, hilang, 'Barang retur tidak kembali (bahan klaim)'); adaMasalah = true; }
      } else {
        adaMasalah = true;
        ledger.push([sekarang, x, 'Masuk', it.qty, 'Koreksi salah kirim · ' + x + ' tidak pernah keluar (yang terkirim ' + y + ') · ' + label, oleh]);
        if (it.terima > 0 && it.kondisi === 'Rusak') {
          ledger.push([sekarang, y, 'Rusak/Hilang', it.terima, 'Salah kirim kembali rusak · ' + label, oleh]);
          catatJurnal(y, namaY, it.terima, 'Salah kirim - kembali rusak (bahan klaim)');
        }
        if (hilang > 0) {
          ledger.push([sekarang, y, 'Rusak/Hilang', hilang, 'Salah kirim tidak kembali · ' + label, oleh]);
          catatJurnal(y, namaY, hilang, 'Salah kirim - barang tidak kembali (kerugian)');
        }
      }
      var st = it.terima <= 0 ? 'Hilang' : (it.kondisi === 'Rusak' ? 'Rusak' : 'Sesuai');
      aktual.push({ sku: it.sku, nama: salah ? nama + ' (diterima ' + y + ')' : nama, qty: it.qty, status: st });
      ringkas.push({ sku: x, nama: nama, qty: it.qty, terima: it.terima, kondisi: it.kondisi, skuDiterima: salah ? y : '', salahKirim: salah });
    });
    var refLedger = '';
    if (ledger.length) {
      var shL = getStockLedgerSheet(), a = shL.getLastRow() + 1;
      shL.getRange(a, 1, ledger.length, 6).setValues(ledger);
      refLedger = 'Ledger baris ' + a + (ledger.length > 1 ? '-' + (a + ledger.length - 1) : '');
    }
    if (jurnal.length) {
      var shJ = getJurnalPenyesuaianStokSheet();
      shJ.getRange(shJ.getLastRow() + 1, 1, jurnal.length, 15).setValues(jurnal);
    }
    var statusCek = semuaHilang ? 'Tidak Terima' : (adaMasalah ? 'Komplain Rusak' : 'Diterima Baik');
    var row = d ? d.row : sh.getLastRow() + 1;
    var nilai = d ? sh.getRange(row, 1, 1, RETUR_DETAIL_HEADER.length).getValues()[0] : [noResi, '', '', '', '[]', '[]', '[]', '', '', ''];
    if (!d) sh.getRange(row, 1, 1, 3).setNumberFormat('@');
    nilai[3] = statusCek; nilai[4] = JSON.stringify(aktual); nilai[7] = sekarang; nilai[8] = oleh;
    sh.getRange(row, 1, 1, RETUR_DETAIL_HEADER.length).setValues([nilai]);
    var terima = { t: sekarang.getTime(), oleh: oleh, noPesanan: noPesanan, ledger: refLedger, jurnal: jurnal.length, items: ringkas };
    sh.getRange(row, 11).setValue(JSON.stringify(terima));
    if (ledger.length) { try { hitungUlangSaldoStok_(); } catch (e1) { } try { smInvalidasiCache(); } catch (e2) { } }
    try { finInvalidasi_(); } catch (e3) { }
    try { CacheService.getScriptCache().remove('RETUR_PRODUK_CARI_V1__meta'); } catch (e4) { }
    return { success: true, statusCek: statusCek, terima: terima, itemAktual: aktual, masukStok: ledger.filter(function (l) { return l[2] === 'Masuk'; }).reduce(function (s2, l) { return s2 + l[3]; }, 0), jurnalNegatif: jurnal.length };
  }, {
    tungguMs: 20000, pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
