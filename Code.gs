      var mentah = peta[String(x.skuMentah || '').trim().toUpperCase()];
      if (!mentah) throw new Error('Batch ' + (i + 1) + ': pilih green bean (bahan mentah).');
      if (!mentah.gramPer) throw new Error('Satuan ' + mentah.nama + ' harus kg / gram.');
      var masuk = prod2Num_(x.masuk), keluar = prod2Num_(x.keluar);
      if (!(masuk > 0) || !(keluar > 0)) throw new Error('Batch ' + (i + 1) + ': isi berat masuk & berat keluar (gram).');
      if (keluar > masuk) throw new Error('Batch ' + (i + 1) + ': berat keluar (' + keluar + ' g) lebih besar dari berat masuk (' + masuk + ' g) - cek timbangan.');
