// ===== AKSI: lengkapi_resi_belum_terhubung (tombol di Pengiriman + otomatis saat ada resi belum terhubung)
function prosesLengkapiResiBelumTerhubung(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiKeluar')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    // Tombol "Hubungkan" = paksa (langsung jalan, pesanan <= 3 hari ditanya lagi). Otomatis dari browser = paling cepat tiap 45 detik.
    var h = lengkapiResiKosongSemua_({ paksa: data.paksa === true, abaikanJeda: data.paksa === true, jedaMinMs: 45000 });
    result.success = true;
    result.dilewati = h.dilewati;
    result.resiTerisi = h.resiTerisi;
    result.statusDiupdate = h.statusDiupdate;
    result.paketTambahan = h.multiPaket;
    result.peringatan = h.error;
    // Cek ulang resi yang dikirim browser -> kembalikan yang SEKARANG sudah terhubung
    if (Array.isArray(data.resi) && data.resi.length) {
      var peta = bangunPetaResiKeSemuaPesanan();
      result.terhubung = {};
      data.resi.slice(0, 500).forEach(function (r) {
        var c = peta[kunciResi_(r)];
        if (c) result.terhubung[r] = { noInvoice: c.noInvoice, pembeli: c.pembeli, sumber: c.sumber, statusPesanan: normalisasiStatusPesanan(c.status) };
      });
    }
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: cari_pesanan_untuk_tautan (dialog 🔗) - cari lintas semua sumber
function prosesCariPesananUntukTautan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiKeluar')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var q = String(data.q || '').trim().toLowerCase();
    var qResi = kunciResi_(data.q);
    var qHp = q.replace(/\D/g, '').replace(/^62/, '0');
    var semua = kumpulkanPesananUntukResi_();
    var skor = [];
    semua.forEach(function (p, i) {
      var s = 0;
      var no = String(p.noInvoice).toLowerCase();
      if (q) {
        if (no === q || kunciResi_(p.noInvoice) === qResi) s = 100;
        else if (no.indexOf(q) !== -1) s = 60;
        else if (String(p.pembeli || '').toLowerCase().indexOf(q) !== -1) s = 40;
        else if (qHp.length >= 6 && String(p.hp || '').replace(/\D/g, '').replace(/^62/, '0').indexOf(qHp) !== -1) s = 35;
        if (!s) return;
      } else {
        if (p.resi.length) return; // tanpa kata kunci: sarankan pesanan terbaru yang resinya masih kosong
        s = 1;
      }
      skor.push({ s: s, i: i, p: p });
    });
    // v2026.10.25 (Paket 12, DN-261019-072955-928): ID pesanan Shopee yang belum ada di sistem -> tanya Shopee & tambahkan
    if (q && !skor.some(function (x) { return x.s >= 100; }) && pgiMiripIdPesanan_(data.q) === 'shopee') {
      try {
        var hS = spSisipkanPesananShopee_([data.q]);
        result.dariApi = hS;
        if (hS.ditambah.length) {
          skor = [];
          kumpulkanPesananUntukResi_().forEach(function (p, i) { if (kunciResi_(p.noInvoice) === qResi) skor.push({ s: 100, i: i, p: p }); });
        }
      } catch (eApi) { result.dariApi = { error: String(eApi.message || eApi) }; }
    }
    skor.sort(function (a, b) { return (b.s - a.s) || (b.i - a.i); });
    result.daftar = skor.slice(0, 25).map(function (x) {
      return { sumber: x.p.sumber, toko: x.p.toko, noInvoice: x.p.noInvoice, pembeli: x.p.pembeli, status: x.p.status, tanggal: x.p.tanggal, resi: x.p.resi.join(', ') };
    });
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: tautkan_resi_manual - simpan relasi resi -> pesanan (tidak mengubah data marketplace)
function prosesTautkanResiManual(data) {
  return withTransaction(data.email, 'scanResiKeluar', 'penjualan', function () {
    var result = { success: false };
    var resi = String(data.noResi || '').trim(), no = String(data.noInvoice || '').trim(), sumber = String(data.sumber || '').trim();
    if (!kunciResi_(resi) || !kunciResi_(no)) throw new Error('No Resi dan No Pesanan wajib diisi.');
    var sh = getTautanResiSheet_();
    var lr = sh.getLastRow();
    var baris = null;
    if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().some(function (r, i) { if (resiSama_(r[0], resi)) { baris = i + 2; return true; } return false; });
    var nilai = [[resi, sumber, no, 'Manual', getNamaStaff(data.email) || data.email, new Date()]];
    if (!baris) baris = lr + 1;
    sh.getRange(baris, 1, 1, 3).setNumberFormat('@');
