        // Data Pembeli: hanya yang baru
        try {
          var shP = getDataPembeliSheet(), lrP = shP.getLastRow(), kenal = {};
          if (lrP > 1) shP.getRange(2, 1, lrP - 1, 3).getValues().forEach(function (r) { kenal['n:' + String(r[0] || '').trim().toLowerCase()] = true; var k = hpKunci_(r[2]); if (k) kenal['h:' + k] = true; });
          var tambah = [];
          pembeliBaru.forEach(function (p) {
            var kh = hpKunci_(p.hp);
            if ((kh && kenal['h:' + kh]) || kenal['n:' + p.nama.toLowerCase()]) return;
            kenal['n:' + p.nama.toLowerCase()] = true; if (kh) kenal['h:' + kh] = true;
            tambah.push([p.nama, p.alamat, p.hp, '', '', '', '', 'Import Penjualan Manual', new Date()]);
          });
          if (tambah.length) { var p0 = shP.getLastRow() + 1; shP.getRange(p0, 3, tambah.length, 1).setNumberFormat('@'); shP.getRange(p0, 1, tambah.length, 9).setValues(tambah); }
          laporan.pembeliBaru = tambah.length;
        } catch (eP) { laporan.error.push('Data Pembeli: ' + (eP.message || eP)); }
        if (ledger.length) { sisipkanLedgerKronologis_(getStockLedgerSheet(), ledger, 6); hitungUlangSaldoStok_(); try { smInvalidasiCache(); } catch (eS) { } }
        laporan.stokDipotong = ledger.length;
        SpreadsheetApp.flush();
        pmInvalidasiCache_();
        try { invalidasiCacheGabunganPesanan(); } catch (eG) { }
        if (laporan.tanggalPaling) { try { pjMintaRekapMundur_(new Date(Utilities.parseDate(laporan.tanggalPaling, tz, 'yyyy-MM-dd').getTime())); } catch (eR) { } }
        try { finInvalidasi_(); } catch (eF) { }
      }
      result.success = true;
      result.laporan = laporan;
      result.disimpan = data.cekSaja ? 0 : header.length;
    } finally { if (!data.cekSaja) lepasKunci_(lock); }
  } catch (err) { result.error = err.message || String(err); }
