    try {
      var perlu = vs.filter(function (r) { return r[0] && !String(r[10] || '').trim(); }).map(function (r) { return String(r[0]).trim(); });
      if (perlu.length) lengkap = spbBacaLengkap_(perlu);
    } catch (eL) { lengkap = {}; }
    vs.forEach(function (r) {
      var id = String(r[0] || '').trim(); if (!id) return;
