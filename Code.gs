var SIKLUS_RESI_SHEET_ = 'Siklus Resi';
var SIKLUS_RESI_HEADER_ = ['No Resi', 'No Pesanan', 'Sumber', 'Tahap', 'Nilai Kompensasi', 'Catatan', 'Diubah Oleh', 'Diubah', 'Riwayat (JSON)', 'Ref Jurnal', 'No Laporan'];
var SIKLUS_TAHAP_ = ['Perlu tindakan', 'Data komplain disiapkan', 'Komplain diajukan', 'Diminta data tambahan', 'Kompensasi diterima', 'Komplain ditolak', 'Ternyata sampai (berhasil)', 'Barang kembali (retur)'];
// Tahap yang membuat resi dianggap SELESAI (salah satu dari 3 akhir)
var SIKLUS_TAHAP_AKHIR_ = { 'Kompensasi diterima': 'kompensasi', 'Ternyata sampai (berhasil)': 'sukses', 'Barang kembali (retur)': 'retur' };
var SIKLUS_SUMBER_JURNAL_ = 'Kompensasi Hilang';
function getSiklusResiSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SIKLUS_RESI_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(SIKLUS_RESI_SHEET_);
    sh.getRange(1, 1, 1, SIKLUS_RESI_HEADER_.length).setValues([SIKLUS_RESI_HEADER_]).setFontWeight('bold');
    sh.getRange('A:C').setNumberFormat('@');
    sh.setFrozenRows(1);
  }
  return sh;
}
function siklusBacaSemua_() {
  var sh = getSiklusResiSheet_(), lr = sh.getLastRow(), peta = {};
  if (lr < 2) return peta;
  sh.getRange(2, 1, lr - 1, SIKLUS_RESI_HEADER_.length).getValues().forEach(function (r, i) {
    var k = kunciResi_(r[0]); if (!k) return;
    var riw = []; try { riw = JSON.parse(String(r[8] || '[]')) || []; } catch (e) { riw = []; }
    peta[k] = { row: i + 2, noResi: String(r[0] || '').trim(), noPesanan: String(r[1] || '').trim(), sumber: String(r[2] || '').trim(), tahap: String(r[3] || '').trim(),
      nilai: Number(r[4]) || 0, catatan: String(r[5] || ''), oleh: String(r[6] || ''), t: r[7] instanceof Date ? r[7].getTime() : 0, riwayat: riw,
      refJurnal: String(r[9] || ''), noLaporan: String(r[10] || ''), akhir: SIKLUS_TAHAP_AKHIR_[String(r[3] || '').trim()] || '' };
  });
  return peta;
}
function siklusPublik_(x) {
  return { noResi: x.noResi, noPesanan: x.noPesanan, sumber: x.sumber, tahap: x.tahap, nilai: x.nilai, catatan: x.catatan, oleh: x.oleh, t: x.t,
    riwayat: (x.riwayat || []).slice(0, 10), akhir: x.akhir, noLaporan: x.noLaporan, jurnal: x.refJurnal };
}

// ===== AKSI: siklus_resi_daftar {} -> { peta: { KUNCI_RESI: {...} }, tahap: [...] }
function prosesSiklusResiDaftar(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiKeluar') && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var peta = siklusBacaSemua_(), out = {};
    Object.keys(peta).forEach(function (k) { out[k] = siklusPublik_(peta[k]); });
    result.peta = out; result.tahap = SIKLUS_TAHAP_; result.batasHari = { reguler: 14, instan: 2 };
    result.success = true;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}

// ===== AKSI: siklus_resi_simpan { noResi, noPesanan, sumber, tahap, nilai, catatan, noLaporan }
function prosesSiklusResiSimpan(data) {
  var noResi, tahap;
  return withTransaction(data.email, 'buatInvoice', ['pengiriman', 'keuangan'], function (ktx) {
    var sh = getSiklusResiSheet_();
    var lama = siklusBacaSemua_()[kunciResi_(noResi)] || null;
    var oleh = ktx.namaStaff() || data.email || '', sekarang = new Date();
    var nilai = Math.max(0, Math.round(Number(data.nilai) || 0));
    if (tahap === 'Kompensasi diterima' && !(nilai > 0)) throw new Error('Isi nilai kompensasi yang diterima dari marketplace / kurir.');
    var noPesanan = String(data.noPesanan || (lama && lama.noPesanan) || '').trim().slice(0, 60);
    var sumber = String(data.sumber || (lama && lama.sumber) || '').trim().slice(0, 40);
    var catatan = String(data.catatan !== undefined ? data.catatan : (lama ? lama.catatan : '')).trim().slice(0, 500);
    var noLaporan = String(data.noLaporan !== undefined ? data.noLaporan : (lama ? lama.noLaporan : '')).trim().slice(0, 60);
    var refJurnal = lama ? lama.refJurnal : '';
    // Jurnal Pendapatan Klaim (kompensasi barang hilang/rusak di perjalanan): sekali, disesuaikan, atau dibatalkan
    var shJ = getJurnalTransaksiSheet(), rowJ = parseInt(String(refJurnal).replace(/\D/g, ''), 10) || 0;
    var jAktif = rowJ >= 2 && rowJ <= shJ.getLastRow() && String(shJ.getRange(rowJ, 4).getValue()).trim() === 'Masuk' && String(shJ.getRange(rowJ, 7).getValue()).trim() === SIKLUS_SUMBER_JURNAL_;
    var ketJ = 'Kompensasi paket hilang/rusak · resi ' + noResi + (noPesanan ? ' · pesanan ' + noPesanan : '') + (noLaporan ? ' · laporan ' + noLaporan : '');
    if (tahap === 'Kompensasi diterima') {
      if (jAktif) { if (Math.round(Number(shJ.getRange(rowJ, 5).getValue()) || 0) !== nilai) shJ.getRange(rowJ, 5, 1, 2).setValues([[nilai, ketJ]]); }
      else {
        rowJ = shJ.getLastRow() + 1;
        shJ.getRange(rowJ, 1, 1, 8).setValues([[sekarang, MRK_AKUN_PENDAPATAN_KLAIM, 'Pendapatan', 'Masuk', nilai, ketJ, SIKLUS_SUMBER_JURNAL_, '']]);
        refJurnal = 'Jurnal baris ' + rowJ;
        try {
          var shA = getBaganAkunSheet(), lrA = shA.getLastRow(), adaA = false;
          if (lrA > 1) adaA = shA.getRange(2, 1, lrA - 1, 1).getValues().some(function (a) { return String(a[0]).trim().toLowerCase() === MRK_AKUN_PENDAPATAN_KLAIM.toLowerCase(); });
          if (!adaA) shA.appendRow([MRK_AKUN_PENDAPATAN_KLAIM, 'Pendapatan', 'Ganti rugi klaim barang rusak/kurang dari supplier/kurir (7-102)']);
        } catch (eA) { }
      }
    } else if (jAktif) {
      shJ.getRange(rowJ, 4).setValue('Dihapus');
      shJ.getRange(rowJ, 6).setValue(String(shJ.getRange(rowJ, 6).getValue()) + ' [dibatalkan ' + Utilities.formatDate(sekarang, Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm') + ' oleh ' + oleh + ']');
      refJurnal = refJurnal + ' (dibatalkan)';
    }
    var riw = lama && Array.isArray(lama.riwayat) ? lama.riwayat.slice(0, 29) : [];
    if (!lama || tahap !== lama.tahap || nilai !== lama.nilai || catatan !== lama.catatan || noLaporan !== lama.noLaporan) riw.unshift({ t: sekarang.getTime(), tahap: tahap, oleh: oleh, nilai: nilai, catatan: catatan.slice(0, 120) });
    var baris = [noResi, noPesanan, sumber, tahap, nilai, catatan, oleh, sekarang, JSON.stringify(riw), refJurnal, noLaporan];
    var row = lama ? lama.row : sh.getLastRow() + 1;
    if (!lama) sh.getRange(row, 1, 1, 3).setNumberFormat('@');
    sh.getRange(row, 1, 1, SIKLUS_RESI_HEADER_.length).setValues([baris]);
    SpreadsheetApp.flush();
    try { finInvalidasi_(); } catch (eF) { }
    try { CacheService.getScriptCache().remove(AC_CACHE_); } catch (eC) { }
    var x = { noResi: noResi, noPesanan: noPesanan, sumber: sumber, tahap: tahap, nilai: nilai, catatan: catatan, oleh: oleh, t: sekarang.getTime(), riwayat: riw, refJurnal: refJurnal, noLaporan: noLaporan, akhir: SIKLUS_TAHAP_AKHIR_[tahap] || '' };
    return { success: true, siklus: siklusPublik_(x) };
  }, {
    tungguMs: 20000, pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      noResi = String(data.noResi || '').trim();
      if (!kunciResi_(noResi)) throw new Error('No Resi kosong');
      tahap = String(data.tahap || '');
      if (SIKLUS_TAHAP_.indexOf(tahap) === -1) throw new Error('Tahap tidak dikenal: ' + tahap);
    }
  });
}

