  }, {
    tungguMs: 20000, pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      noResi = String(data.noResi || '').trim();
      if (!noResi) throw new Error('No Resi kosong');
      tahap = String(data.tahap || '');
