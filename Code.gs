      var k = String(x && x.kunci || '').trim(), m = k.match(/^(Waterground|Conner)\|(.+)$/);
      if (!m) return;
      var d = x.gagal ? {} : ttbBersihkanLabel_(x);
      if (d.hp && (d.nama || d.alamat)) {
        var h = { kunci: k, id: m[2], toko: m[1], channel: '', status: '', paket: '', sumber: {} };
        ['nama', 'hp', 'alamat'].forEach(function (f) { if (d[f]) { h[f] = d[f]; h.sumber[f] = 'label resmi (teks dibaca browser)'; } });
        (perToko[m[1]] = perToko[m[1]] || []).push(h);
        statusAntre[k] = { ok: true };
      } else statusAntre[k] = { ok: false, catatan: String(x && x.catatan || 'Penerima tidak terbaca dari label').slice(0, 200) };
    });
    var tersimpan = 0, terisi = 0;
    Object.keys(perToko).forEach(function (toko) {
