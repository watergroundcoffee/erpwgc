}
// Tulis hasil smart matching: (1) tautan resi driver -> pesanan, (2) kolom Kurir di "Resi Keluar" bila masih kosong / Tidak Diketahui
function pgiSimpanHasil_(daftar) {
  if (!daftar || !daftar.length) return;
  var lock = kunciModul_(['pengiriman', 'penjualan']);
  if (!lock.tryLock(10000)) return; // dicoba lagi pengecekan berikutnya
  try {
    var adaUbah = false;
    var shT = getTautanResiSheet_(), lrT = shT.getLastRow(), sudah = {};
    if (lrT > 1) shT.getRange(2, 1, lrT - 1, 3).getValues().forEach(function (r) { sudah[kunciResi_(r[0]) + '|' + kunciResi_(r[2])] = true; });
    var baris = [];
    daftar.forEach(function (x) {
      if (!x.resi || kunciResi_(x.resi) === kunciResi_(x.scan)) return; // v2026.10.24: resi yang discan = resi asli -> tidak perlu tautan
      var k = kunciResi_(x.resi) + '|' + kunciResi_(x.no);
      if (sudah[k]) return;
      sudah[k] = true;
      baris.push([x.resi, x.sumber, x.no, x.instan ? 'Otomatis: resi driver kurir instan (ID Pesanan discan)' : 'Otomatis: resi asli (ID Pesanan discan)', 'Sistem', new Date()]);
    });
    if (baris.length) {
      shT.getRange(lrT + 1, 1, baris.length, 3).setNumberFormat('@');
      shT.getRange(lrT + 1, 1, baris.length, TAUTAN_RESI_HEADER.length).setValues(baris);
      adaUbah = true;
    }
    var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Resi Keluar');
    if (sh && sh.getLastRow() > 1) {
      var lr = sh.getLastRow(), awal = Math.max(2, lr - 4000);
      var nKol = Math.min(10, sh.getLastColumn());
      if (nKol >= 10) {
        var vals = sh.getRange(awal, 1, lr - awal + 1, 10).getValues(), petaKurir = {};
        var perScan = {};
        daftar.forEach(function (x) { if (x.kurir) perScan[kunciResi_(x.scan)] = x; });
        vals.forEach(function (r, i) {
          var x = perScan[kunciResi_(r[0])]; if (!x) return;
          var kini = String(r[9] || '').trim();
          if (kini && kini !== '-' && !/tidak\s*diketahui/i.test(kini)) return;
          petaKurir[awal + i] = String(x.kurir).trim() + (x.instan && !pgiApakahKurirInstan_(x.kurir) ? ' (Instan)' : '');
        });
        if (Object.keys(petaKurir).length) { tulisSelPerBlok_(sh, 10, petaKurir, false); adaUbah = true; }
      }
    }
    if (adaUbah) {
      SpreadsheetApp.flush();
      try { invalidasiPetaResiRingkas_(); } catch (e1) { }
      try { invalidasiCacheGabunganPesanan(); } catch (e2) { }
    }
  } finally { lepasKunci_(lock); }
}


/* ####################################################################################
