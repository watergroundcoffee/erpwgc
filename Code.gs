    var stokKerja = {}, hargaKerja = {};
    semua.forEach(function (b) { stokKerja[b.sku.toUpperCase()] = b.stokGram || 0; hargaKerja[b.sku.toUpperCase()] = b.hargaGram || 0; });
    rencana.forEach(function (r) {
      var biayaBahan = 0;
      r.input.forEach(function (x) {
        var k = x.b.sku.toUpperCase();
        biayaBahan += hargaKerja[k] * x.gram;
        stokKerja[k] = prod2Bulat_(stokKerja[k] - x.gram);
