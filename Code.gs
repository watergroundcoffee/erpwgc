// Upload foto bukti per item - dipanggil TERPISAH setelah baris detail kebentuk
// (butuh nomor baris detail spesifik), sama pola kayak upload bukti retur.
function prosesUploadFotoMemoHilangRusak(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var row = parseInt(data.row, 10);
    var base64Data = String(data.base64 || '');
    if (!row || row < 2) throw new Error('Baris tidak valid');
    if (!base64Data) throw new Error('Tidak ada file yang dikirim');

    var sheets = getMemoHilangRusakSheets();
    if (row > sheets.detail.getLastRow()) throw new Error('Baris detail tidak ditemukan');

    // Nama file rapi: "<No Memo> - <urutan item> - <SKU>.jpg", contoh "LHR260929-01 - 02 - WG-ARB-1KG.jpg"
    var infoBaris = sheets.detail.getRange(row, 1, 1, 2).getValues()[0];
    var noMemo = String(infoBaris[0] || '').trim();
    if (data.noMemo && noMemo !== String(data.noMemo).trim()) throw new Error('Baris detail tidak cocok dengan memo ' + data.noMemo);
    var sku = String(infoBaris[1] || '').trim();
    var urutan = 1;
    if (row > 2) {
      var atas = sheets.detail.getRange(Math.max(2, row - 200), 1, row - Math.max(2, row - 200), 1).getValues();
      for (var u = atas.length - 1; u >= 0 && String(atas[u][0] || '').trim() === noMemo; u--) urutan++;
    }
    var aman = function (t) { return String(t || '').replace(/[\\/:*?"<>|#%]+/g, '-').replace(/\s+/g, ' ').trim(); };
    var mime = data.mimeType || 'image/jpeg';
    var ekst = mime === 'image/png' ? '.png' : (mime === 'image/webp' ? '.webp' : '.jpg');
    var fotoKe = parseInt(data.fotoKe, 10) || 1;
    var namaFile = aman(noMemo || ('Baris ' + row)) + ' - ' + (urutan < 10 ? '0' + urutan : urutan) + (sku ? ' - ' + aman(sku) : '') +
      ' - foto ' + fotoKe + ekst;

    var bytes = Utilities.base64Decode(base64Data);
    var blob = Utilities.newBlob(bytes, mime, namaFile);
    var file = getFolderLaporHilangRusak_().createFile(blob);
    file.setDescription('Foto bukti Lapor Hilang/Rusak ' + noMemo + (sku ? ' · SKU ' + sku : '') + ' · diunggah ' + (getNamaStaff(data.email) || data.email || ''));
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var urlFile = 'https://drive.google.com/file/d/' + file.getId() + '/view';

    // Bisa lebih dari 1 foto per item: URL disimpan berurutan, 1 URL per baris di sel yang sama
    var selFoto = sheets.detail.getRange(row, 5);
    var lama = String(selFoto.getValue() || '').trim();
    var daftarUrl = lama ? lama.split(/\s+/).filter(function (u) { return /^https?:/.test(u); }) : [];
    if (daftarUrl.indexOf(urlFile) === -1) daftarUrl.push(urlFile);
    selFoto.setValue(daftarUrl.join('\n'));
    result.success = true;
    result.url = urlFile;
    result.jumlahFoto = daftarUrl.length;
  } catch (err) { result.error = err.toString(); }
  return result;
}

