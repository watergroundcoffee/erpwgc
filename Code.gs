    pkSheet_().appendRow([noInvoice, 'Pembayaran', waktu, pkWaktuPerangkat_(data.waktuKlikMs), namaStaff, url, String(data.catatan || '').slice(0, 300), 'Aktif', String(data.idPermintaan || '')]);
    pkInvalidasi_();
    if (metode === 'Tunai') { try { ksTambah_(noInvoice, diterimaOleh, parseFloat(sh.getRange(row, 10).getValue()) || 0, waktu, namaStaff); } catch (eKs) { } }
    var stKini_ = String(sh.getRange(row, 12).getValue() || '').trim();
