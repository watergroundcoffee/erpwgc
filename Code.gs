/* ---------- Pemanggil Gemini generateContent (+ Google Search grounding) ---------- */
function copilotPanggilLLM_(systemText, contents, opsi) {
  opsi = opsi || {};
  var props = PropertiesService.getScriptProperties();
  var agenLLM = aiAgentKey_(opsi.agent || 'jaya'); // default Jaya (CEO); tugas latar seperti ringkas memori -> Budi
  var apiKey = agenLLM.key;
  if (!apiKey || apiKey.indexOf('PASTE_') === 0) throw new Error('API key agent ' + aiAgentDef_(opsi.agent || 'jaya').nama + ' belum diisi - atur di menu AI Agent > 🔑 Agent Keys.');
  var model = agenLLM.model;
  if (agenLLM.provider !== 'gemini') {
    // Provider non-Gemini: tanpa Google Search grounding, sisanya sama (system prompt + riwayat percakapan)
    var hasilU;
    for (var cobaU = 1; ; cobaU++) {
      try { hasilU = aiPanggilUniversal_(agenLLM, { system: systemText, contents: contents, suhu: 0.4, maksToken: 4096 }); break; }
      catch (eU) {
        if ((eU.httpKode === 429 || eU.httpKode >= 500) && cobaU < 3) { Utilities.sleep(1500 * cobaU); continue; }
        throw new Error('LLM API ' + aiProviderLabel_(agenLLM.provider) + ' gagal: ' + String(eU.message || eU).slice(0, 300));
      }
    }
    try { aiwCatatToken_(hasilU.usage); } catch (eTokU) { }
    if (!hasilU.teks) throw new Error('LLM tidak memberi jawaban (kosong).');
    return { teks: hasilU.teks, sumber: [], kueriWeb: [], grounded: false, model: model, usage: hasilU.usage };
  }
  var pakaiSearch = props.getProperty('LLM_GROUNDING') !== '0' && !opsi.tanpaSearch;
  var url = 'https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(model) + ':generateContent';

  function kirim(denganSearch) {
    var payload = {
      system_instruction: { parts: [{ text: systemText }] },
      contents: contents,
      generationConfig: { temperature: 0.4, maxOutputTokens: 4096 }
    };
    if (denganSearch) payload.tools = [{ google_search: {} }]; // Grounding with Google Search (tren pasar terkini)
    var kode, isi;
    for (var i = 1; i <= 3; i++) {
      var res = fetchHemat(url, { method: 'post', contentType: 'application/json', headers: { 'x-goog-api-key': apiKey }, payload: JSON.stringify(payload), muteHttpExceptions: true });
      kode = res.getResponseCode(); isi = res.getContentText();
      if (kode === 200) break;
      if ((kode === 429 || kode === 503 || kode === 500) && i < 3) { Utilities.sleep(1500 * i); continue; }
      break;
    }
    return { kode: kode, isi: isi };
  }

  var r = kirim(pakaiSearch), grounded = pakaiSearch;
  if (r.kode === 400 && pakaiSearch && /google_search|tool|grounding/i.test(r.isi)) { r = kirim(false); grounded = false; } // model tak mendukung tool
  if (r.kode !== 200) {
    var pesan = r.isi; try { pesan = JSON.parse(r.isi).error.message; } catch (e) { }
    throw new Error('LLM API gagal (HTTP ' + r.kode + '): ' + String(pesan).slice(0, 300));
  }
  var data = JSON.parse(r.isi), cand = (data.candidates || [])[0] || {};
  // Pemakaian token (untuk kuota harian & health bar AI Agent)
  var um = data.usageMetadata || {};
  var usage = { in: Number(um.promptTokenCount) || 0, out: (Number(um.candidatesTokenCount) || 0) + (Number(um.thoughtsTokenCount) || 0) };
  try { aiwCatatToken_(usage); } catch (eTok) { }
  var teks = ((cand.content && cand.content.parts) || []).map(function (p) { return p.text || ''; }).join('').trim();
  if (!teks) {
    var alasan = cand.finishReason || (data.promptFeedback && data.promptFeedback.blockReason) || 'kosong';
    throw new Error('LLM tidak memberi jawaban (' + alasan + ').');
  }
  var gm = cand.groundingMetadata || {}, sumber = [], ada = {};
  (gm.groundingChunks || []).forEach(function (ch) {
    var w = ch.web; if (!w || !w.uri || ada[w.uri]) return;
    ada[w.uri] = 1; sumber.push({ judul: w.title || w.uri, url: w.uri });
  });
  return { teks: teks, sumber: sumber.slice(0, 6), kueriWeb: gm.webSearchQueries || [], grounded: grounded && !!(gm.groundingChunks || gm.webSearchQueries), model: model, usage: usage };
}

/* ---------- FUNGSI UTAMA: tanyaCopilot(pesanUser, opsi) ----------
   opsi = { email, riwayat: [{role:'user'|'assistant', content}], halaman, bolehKeuangan } */
function tanyaCopilot(pesanUser, opsi) {
  opsi = opsi || {};
  var pesan = String(pesanUser || '').trim();
  if (!pesan) throw new Error('Pesan kosong.');
  if (pesan.length > 4000) pesan = pesan.slice(0, 4000);
  var tz = Session.getScriptTimeZone();
  var konteks = copilotKonteksErp_(opsi.email, opsi.bolehKeuangan !== false);
  var memoriTeks = ''; try { memoriTeks = memoryBlokPrompt_(opsi.bolehKeuangan !== false); } catch (eMem) { console.warn('Memori gagal dimuat: ' + eMem); }
  // Agenda & log aksi SELALU segar (tidak ikut cache konteks 10 menit) supaya AI tahu task_id terbaru
  var agendaTeks = ''; if (opsi.bolehKeuangan !== false) { try { agendaTeks = copilotKonteksAgenda_(); } catch (eAg) { console.warn('Agenda gagal dimuat: ' + eAg); } }
  var systemText = COPILOT_PERSONA_ + '\n\n' + COPILOT_ATURAN_ + '\n\n' + (opsi.bolehKeuangan !== false ? COPILOT_ATURAN_AKSI_ + '\n\n' : '') +
    'Tanggal & jam sekarang: ' + Utilities.formatDate(new Date(), tz, "EEEE, dd MMMM yyyy HH:mm") + ' (' + tz + ').\n' +
    'Toko berjualan di: Shopee, TikTok Shop, Tokopedia, Website, PO Sales/reseller. Produk utama: kopi (biji/bubuk) & perlengkapan kopi.\n' +
    (opsi.halaman ? 'User sedang membuka halaman OmniAI: ' + opsi.halaman + '.\n' : '') +
    '\n=== DATA ERP OMNIAI (real-time, sumber kebenaran untuk angka internal) ===\n' + konteks + (agendaTeks ? '\n\n' + agendaTeks : '') + '\n=== AKHIR DATA ERP ===' +
    (memoriTeks ? '\n\n' + memoriTeks : '');
  var contents = [], rw = (opsi.riwayat || []).slice(-10);
  // Pesan saat ini biasanya sudah ada di ujung riwayat -> buang supaya tidak terkirim dua kali
  if (rw.length && rw[rw.length - 1].role === 'user' && String(rw[rw.length - 1].content || '').trim() === pesan) rw.pop();
  rw.forEach(function (m) {
    var t = String((m && m.content) || '').trim(); if (!t) return;
    var role = m.role === 'user' ? 'user' : 'model';
    if (contents.length && contents[contents.length - 1].role === role) contents[contents.length - 1].parts[0].text += '\n\n' + t.slice(0, 2000);
    else contents.push({ role: role, parts: [{ text: t.slice(0, 2000) }] });
  });
  while (contents.length && contents[0].role !== 'user') contents.shift(); // Gemini: giliran pertama harus user
  // Catatan sistem (hasil eksekusi) yang berada di ujung riwayat digabung dengan pertanyaan saat ini
  if (contents.length && contents[contents.length - 1].role === 'user') contents[contents.length - 1].parts[0].text += '\n\n' + pesan;
  else contents.push({ role: 'user', parts: [{ text: pesan }] });
  return copilotPanggilLLM_(systemText, contents);
}

/* ---------- AKSI: tanya_copilot { pesan, riwayat?, halaman? } ---------- */
function prosesTanyaCopilot(data) {
  var mulai = Date.now();
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin memakai OmniAI Copilot.');
    // Batas pemakaian ringan: 12 pertanyaan / menit / user
    var cache = CacheService.getScriptCache(), kRate = 'COPILOT_RATE_' + String(data.email || '-').toLowerCase();
    var n = parseInt(cache.get(kRate) || '0', 10);
    if (n >= 12) throw new Error('Terlalu banyak pertanyaan dalam 1 menit. Tunggu sebentar ya.');
    cache.put(kRate, String(n + 1), 60);
    if (data.segarkanKonteks) { cache.remove(COPILOT_CACHE_KONTEKS_ + '_F'); cache.remove(COPILOT_CACHE_KONTEKS_ + '_S'); }
    var hasil = tanyaCopilot(data.pesan, {
      email: data.email, riwayat: Array.isArray(data.riwayat) ? data.riwayat : [],
      halaman: String(data.halaman || '').slice(0, 80), bolehKeuangan: cekIzin(data.email, 'buatInvoice')
    });
    var durasi = Math.round((Date.now() - mulai) / 100) / 10;
    copilotLog_(data.email, data.pesan, hasil.teks, { model: hasil.model, grounded: hasil.grounded, durasi: durasi });
    return { success: true, jawaban: hasil.teks, sumber: hasil.sumber, kueriWeb: hasil.kueriWeb, grounded: hasil.grounded, model: hasil.model, durasi: durasi };
  } catch (err) {
    return { success: false, error: (err && err.message) ? err.message : String(err) };
  }
}

// Tes cepat dari editor Apps Script (lihat hasil di Log eksekusi)
function tesCopilot() {
  var r = denganIzinSistem_(function () { return prosesTanyaCopilot({ pesan: 'Apa 3 langkah paling cepat untuk menaikkan omzet minggu ini tanpa merusak margin?', riwayat: [] }); });
  Logger.log(JSON.stringify(r, null, 2));
}

/* ======================================================================================
   OMNIAI ACTION EXECUTOR - AI Function Calling / Action Execution Loop (Write-Access)
   Alur: Copilot (LLM) menulis blok JSON {"tool_call":"execute_action","action":...,"params":{...}}
         -> frontend menampilkan tombol konfirmasi (atau Auto-Pilot) -> executeAiAction(payload)
         -> izin + kebijakan + GUARDRAIL di SERVER -> eksekusi -> audit trail di sheet "Execution_Logs".
   Server TIDAK pernah mempercayai frontend/AI: semua batas diperiksa ulang di sini.
   Aksi:
     UPDATE_PRICE    { sku, new_price, platform: Shopee|TikTok Shop|Tokopedia|Offline, harga_coret?, sync? }
     UPDATE_STOCK    { sku, new_qty, location?, alasan? }
     CREATE_VOUCHER  { platform:'Shopee', nama, kode, jenis:'Nominal'|'Persen', nilai, min_belanja?, maks_diskon?, kuota, mulai, berakhir }
     CREATE_BUNDLE   { platform:'Shopee', nama, skus:[...], min_qty, tipe:'persen'|'potongan'|'harga_paket', nilai, mulai, berakhir, purchase_limit? (alias batas_beli; default 99999) }
     TOGGLE_AD       { platform:'TikTok Shop'|'Shopee', campaign_id, action:'ENABLE'|'PAUSE' }
   ====================================================================================== */
var EKS_SHEET_ = 'Execution_Logs';
var EKS_HEADER_ = ['Timestamp', 'Executed_By', 'Action_Type', 'SKU/Target', 'Old_Value', 'New_Value', 'Status', 'Response'];
var EKS_IZIN_ = 'buatInvoice';               // hak akses minimal untuk mengeksekusi aksi (Owner/Admin keuangan)
var EKS_MAKS_UBAH_HARGA_PCT_ = 50;           // perubahan harga > 50% sekali jalan selalu ditolak
var EKS_AUTOPILOT_MAKS_UBAH_HARGA_PCT_ = 15; // Auto-Pilot hanya boleh mengubah harga maks ±15%
var EKS_BUNDLE_PURCHASE_LIMIT_DEFAULT_ = 99999;    // Shopee bundle: batas beli default bila tidak ditentukan
var EKS_BUNDLE_PURCHASE_LIMIT_MAKS_ = 999999999;   // batas atas dari Shopee API
// Aksi yang BOLEH jalan otomatis (Auto-Pilot). Stok fisik, voucher, bundling & MENYALAKAN iklan selalu butuh klik manusia.
var EKS_AUTOPILOT_IZIN_ = { UPDATE_PRICE: true, TOGGLE_AD_PAUSE: true, GET_ACTION_LOGS: true, GET_SCHEDULED_TASKS: true, CHECK_SKU_MAPPING: true, GET_WAREHOUSE_SUMMARY: true }; // GET_/CHECK_ = baca saja
var EKS_PLATFORM_ = {
  'shopee': { label: 'Shopee', kolFinal: 7, kolCoret: 28, grupBiaya: 'shopee', fieldFinal: 'hargaShopee', fieldCoret: 'hargaCoretShopee' },
  'tiktok shop': { label: 'TikTok Shop', kolFinal: 25, kolCoret: 29, grupBiaya: 'tiktok', fieldFinal: 'hargaTiktok', fieldCoret: 'hargaCoretTiktok' },
  'tiktok': { label: 'TikTok Shop', kolFinal: 25, kolCoret: 29, grupBiaya: 'tiktok', fieldFinal: 'hargaTiktok', fieldCoret: 'hargaCoretTiktok' },
  'tokopedia': { label: 'Tokopedia', kolFinal: 25, kolCoret: 29, grupBiaya: 'tokopedia', fieldFinal: 'hargaTiktok', fieldCoret: 'hargaCoretTiktok' },
  'offline': { label: 'Offline', kolFinal: 3, kolCoret: 0, grupBiaya: 'default', fieldFinal: 'hargaDefault', fieldCoret: '' },
  'default': { label: 'Offline', kolFinal: 3, kolCoret: 0, grupBiaya: 'default', fieldFinal: 'hargaDefault', fieldCoret: '' }
};

function eksPlatform_(p) {
  var k = String(p || 'Shopee').toLowerCase().trim();
  var cfg = EKS_PLATFORM_[k];
  if (!cfg) throw new Error('Platform "' + p + '" tidak dikenal (Shopee / TikTok Shop / Tokopedia / Offline).');
  return cfg;
}
function eksRp_(n) { return 'Rp ' + Math.round(Number(n) || 0).toLocaleString('id-ID'); }

/* ---------- Audit trail ---------- */
function getExecutionLogsSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(EKS_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(EKS_SHEET_);
    sh.getRange(1, 1, 1, EKS_HEADER_.length).setValues([EKS_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('D:F').setNumberFormat('@');
  }
  return sh;
}
function eksCatatLog_(oleh, tipe, target, lama, baru, status, respon) {
  try {
    var teks = function (v) { return v === undefined || v === null ? '' : (typeof v === 'object' ? JSON.stringify(v) : String(v)); };
    getExecutionLogsSheet_().appendRow([new Date(), oleh, tipe, teks(target), teks(lama).slice(0, 2000), teks(baru).slice(0, 2000), status, teks(respon).slice(0, 5000)]);
  } catch (e) { console.error('Execution_Logs gagal ditulis: ' + e); }
}

/* ---------- Data produk (Master Produk) ---------- */
function eksBacaProduk_(sku, toko) {
  var sh = getMasterProdukSheet(toko);
  var row = katCariBarisSku_(sh, String(sku || '').trim());
  if (row === -1) throw new Error('SKU ' + sku + ' tidak ditemukan di Master Produk.');
  var r = sh.getRange(row, 1, 1, KAT_KOL_STATUS).getValues()[0];
  if (katApakahArsip_(r[KAT_KOL_STATUS - 1])) throw new Error('Produk ' + sku + ' diarsipkan.');
  return { sh: sh, row: row, sku: String(r[0]).trim(), nama: String(r[1] || '').trim(), hpp: parseFloat(r[3]) || 0, r: r };
}

/* ---------- Potongan komisi marketplace untuk harga P (dari Parameter Biaya Platform, seksi "Biaya Platform") ---------- */
var EKS_PARAM_MEMO_ = null; // parameter biaya dibaca sekali per eksekusi
function eksPotonganKomisi_(grupBiaya, harga) {
  if (!EKS_PARAM_MEMO_) EKS_PARAM_MEMO_ = ambilParamBiayaPlatform();
  var g = (EKS_PARAM_MEMO_.grup || {})[grupBiaya] || { biaya: [] }, total = 0, rincian = [];
  (g.biaya || []).forEach(function (b) {
    var n = Number(b.nominal) || 0; if (!n) return;
    var v = b.tipe === '%' ? harga * n / 100 : n;
    if (b.tipe === '%' && b.maks) v = Math.min(v, Number(b.maks) || v);
    total += v; rincian.push({ nama: b.nama, nilai: Math.round(v) });
  });
  return { total: Math.round(total), rincian: rincian };
}

// Harga minimum aman (titik impas HPP + komisi) dicari numerik karena ada batas maks per komponen komisi
function eksHargaMinimum_(hpp, grupBiaya) {
  var lo = hpp, hi = Math.max(hpp * 5, hpp + 100000);
  for (var i = 0; i < 40; i++) { var mid = (lo + hi) / 2; if (mid >= hpp + eksPotonganKomisi_(grupBiaya, mid).total) hi = mid; else lo = mid; }
  return Math.ceil(hi);
}

/* ---------- GUARDRAIL: validatePriceSafety(sku, proposedPrice, platform?) ----------
   Harga baru TIDAK BOLEH < HPP + potongan komisi marketplace (dihitung pada harga baru itu sendiri). */
function validatePriceSafety(sku, proposedPrice, platform, toko) {
  var hasil = { status: 'REJECTED_SAFETY_VIOLATION', sku: String(sku || ''), harga: Math.round(Number(proposedPrice) || 0) };
  try {
    var cfg = eksPlatform_(platform);
    hasil.platform = cfg.label;
    var p = eksBacaProduk_(sku, toko);
    hasil.hpp = p.hpp;
    if (!(hasil.harga > 0)) { hasil.alasan = 'Harga harus lebih dari Rp 0.'; return hasil; }
    if (!(p.hpp > 0)) { hasil.alasan = 'HPP SKU ' + sku + ' belum diisi di Master Produk - harga tidak bisa divalidasi, eksekusi ditolak demi keamanan.'; return hasil; }
    var kom = eksPotonganKomisi_(cfg.grupBiaya, hasil.harga);
    hasil.komisi = kom.total; hasil.rincianKomisi = kom.rincian;
    hasil.batasMinimum = p.hpp + kom.total;
    hasil.hargaMinimumAman = eksHargaMinimum_(p.hpp, cfg.grupBiaya);
    if (hasil.harga < hasil.batasMinimum) {
      hasil.alasan = 'Harga ' + eksRp_(hasil.harga) + ' di bawah HPP ' + eksRp_(p.hpp) + ' + komisi ' + cfg.label + ' ' + eksRp_(kom.total) + ' = ' + eksRp_(hasil.batasMinimum) + '. Harga minimum aman: ' + eksRp_(hasil.hargaMinimumAman) + '.';
      return hasil;
    }
    hasil.status = 'OK';
    hasil.marginBersih = hasil.harga - hasil.batasMinimum;
    hasil.marginPct = Math.round(hasil.marginBersih / hasil.harga * 1000) / 10;
  } catch (e) { hasil.alasan = e.message; }
  return hasil;
}

/* ---------- 1) updateProductPrice ---------- */
function updateProductPrice(sku, newPrice, platform, opsi) {
  opsi = opsi || {};
  var cfg = eksPlatform_(platform), toko = opsi.toko;
  var p = eksBacaProduk_(sku, toko);
  var harga = Math.round(Number(newPrice));
  var lama = parseFloat(p.r[cfg.kolFinal - 1]) || 0;
  var coretLama = cfg.kolCoret ? (parseFloat(p.r[cfg.kolCoret - 1]) || 0) : 0;
  var out = { target: p.sku + ' @ ' + cfg.label, oldValue: lama, newValue: harga };

  var aman = validatePriceSafety(p.sku, harga, cfg.label, toko);
  out.guardrail = aman;
  if (aman.status !== 'OK') { out.status = 'REJECTED_SAFETY_VIOLATION'; out.pesan = aman.alasan; return out; }
  if (lama > 0) {
    var ubahPct = Math.abs(harga - lama) / lama * 100;
    var batasPct = opsi.autopilot ? EKS_AUTOPILOT_MAKS_UBAH_HARGA_PCT_ : EKS_MAKS_UBAH_HARGA_PCT_;
    if (ubahPct > batasPct) {
      out.status = 'REJECTED_LIMIT';
      out.pesan = 'Perubahan ' + (Math.round(ubahPct * 10) / 10) + '% (' + eksRp_(lama) + ' → ' + eksRp_(harga) + ') melebihi batas ' + batasPct + '%' + (opsi.autopilot ? ' untuk Auto-Pilot - konfirmasi manual diperlukan.' : ' per eksekusi.');
      return out;
    }
  }
  if (harga === lama && opsi.hargaCoret === undefined) { out.status = 'SUCCESS'; out.pesan = 'Harga sudah ' + eksRp_(harga) + ' - tidak ada perubahan.'; return out; }

  // Harga Coret wajib >= Harga Jual Final (aturan Sync Harga). Kalau tidak diberikan & kurang, ikut dinaikkan.
  var item = { sku: p.sku };
  item[cfg.fieldFinal] = harga;
  var coretBaru = coretLama;
  if (cfg.kolCoret) {
    if (opsi.hargaCoret !== undefined && opsi.hargaCoret !== null && opsi.hargaCoret !== '') {
      coretBaru = Math.round(Number(opsi.hargaCoret));
      if (!(coretBaru >= harga)) { out.status = 'FAILED'; out.pesan = 'Harga coret (' + eksRp_(coretBaru) + ') harus ≥ harga jual (' + eksRp_(harga) + ').'; return out; }
    } else if (coretLama < harga) coretBaru = harga;
    if (coretBaru !== coretLama) item[cfg.fieldCoret] = coretBaru;
  }
  var simpan = denganIzinSistem_(function () { return prosesSimpanHargaJualFinal({ email: opsi.email, toko: toko, items: [item] }); });
  if (!simpan.success) { out.status = 'FAILED'; out.pesan = simpan.error; return out; }
  out.status = 'SUCCESS';
  out.pesan = 'Harga jual ' + cfg.label + ' ' + p.sku + ' diubah ' + eksRp_(lama) + ' → ' + eksRp_(harga) + ' (margin setelah komisi ≈ ' + eksRp_(aman.marginBersih) + ', ' + aman.marginPct + '%).';
  if (coretBaru !== coretLama) out.pesan += ' Harga coret ikut disesuaikan ' + eksRp_(coretLama) + ' → ' + eksRp_(coretBaru) + '.';

  // Push ke marketplace: jalur resmi Sync Harga mengirim HARGA CORET sebagai harga dasar listing.
  if (cfg.kolCoret && cfg.label !== 'Offline' && opsi.sync !== false && coretBaru !== coretLama) {
    try {
      var fnSync = cfg.label === 'Shopee' ? syncShopeeOnly : syncTikTokOnly;
      var s = denganIzinSistem_(function () { return fnSync({ email: opsi.email, toko: toko, sku: p.sku, hargaCoret: coretBaru }); });
      out.sync = { mode: s.mode, sukses: s.jumlahSukses, gagal: s.jumlahGagal, error: s.error || '' };
      out.pesan += s.success || s.jumlahSukses ? ' Sync ' + cfg.label + ' (' + s.mode + '): ' + s.jumlahSukses + '/' + s.jumlahListing + ' listing.' : ' ⚠ Sync marketplace gagal: ' + (s.error || 'cek Log Sync Harga') + '.';
    } catch (eS) { out.pesan += ' ⚠ Sync marketplace gagal: ' + eS.message; }
  } else if (cfg.kolCoret) {
    out.pesan += ' Harga dasar listing (harga coret) tidak berubah; harga akhir di ' + cfg.label + ' mengikuti program diskon di Seller Centre.';
  }
  return out;
}

/* ---------- 2) updateStockQty (Smart Opname - stok fisik tercatat beserta timestamp) ---------- */
function updateStockQty(sku, newQty, location, opsi) {
  opsi = opsi || {};
  var qty = Number(newQty);
  var out = { target: String(sku || '') + (location ? ' @ ' + location : ''), newValue: qty };
  if (!isFinite(qty) || qty < 0 || Math.floor(qty) !== qty) { out.status = 'FAILED'; out.pesan = 'Qty baru harus bilangan bulat ≥ 0.'; return out; }
  var r = denganIzinSistem_(function () {
    return prosesSmartOpnameSimpan({ email: opsi.email, sku: sku, qtyFisik: qty, toko: location || opsi.toko || 'Waterground',
      catatan: 'OmniAI Action Executor' + (opsi.alasan ? ' - ' + String(opsi.alasan).slice(0, 200) : '') });
  });
  if (!r.success) { out.status = 'FAILED'; out.pesan = r.error; return out; }
  out.oldValue = r.qtySistem;
  out.status = 'SUCCESS';
  out.pesan = 'Stok ' + r.sku + (r.nama ? ' (' + r.nama + ')' : '') + ' disesuaikan ' + r.qtySistem + ' → ' + qty + ' (selisih ' + (r.selisih > 0 ? '+' : '') + r.selisih + '). ID opname ' + r.id + '.';
  return out;
}

/* ---------- 3) createPromotionOrBundle ---------- */
// Diskon efektif maksimum per unit dari sebuah promo -> dipakai guardrail lintas SKU
function eksCekPromoAman_(skuList, hargaSetelahDiskon, platform, toko) {
  var langgar = [];
  skuList.forEach(function (sku) {
    try {
      var p = eksBacaProduk_(sku, toko), cfg = eksPlatform_(platform);
      var hargaNormal = parseFloat(p.r[cfg.kolFinal - 1]) || 0;
      if (!hargaNormal) { langgar.push(sku + ': harga jual ' + cfg.label + ' belum ada'); return; }
      var hargaAkhir = hargaSetelahDiskon(hargaNormal);
      var v = validatePriceSafety(sku, hargaAkhir, cfg.label, toko);
      if (v.status !== 'OK') langgar.push(sku + ': ' + eksRp_(hargaNormal) + ' → ' + eksRp_(hargaAkhir) + ' (' + v.alasan + ')');
    } catch (e) { langgar.push(sku + ': ' + e.message); }
  });
  return langgar;
}
function eksSemuaSkuAktif_(toko) {
  var sh = getMasterProdukSheet(toko), lr = sh.getLastRow();
  if (lr < 2) return [];
  return sh.getRange(2, 1, lr - 1, KAT_KOL_STATUS).getValues()
    .filter(function (r) { return String(r[0]).trim() && !katApakahArsip_(r[KAT_KOL_STATUS - 1]) && (parseFloat(r[6]) || 0) > 0; })
    .map(function (r) { return String(r[0]).trim(); });
}

function createPromotionOrBundle(bundleData, opsi) {
  opsi = opsi || {};
  var d = bundleData || {}, jenis = String(d.jenis || '').toUpperCase(), toko = opsi.toko;
  var out = { target: jenis + ' ' + (d.nama || d.kode || ''), oldValue: '-', newValue: d };
  if (String(d.platform || 'Shopee') !== 'Shopee') { out.status = 'FAILED'; out.pesan = 'Pembuatan promo via API saat ini hanya untuk Shopee. Buat promo TikTok Shop di Seller Center.'; return out; }

  if (jenis === 'VOUCHER') {
    var nilai = Number(d.nilai) || 0, minB = Number(d.min_belanja) || 0, persen = /persen|%/i.test(d.jenis_diskon || d.tipe || '');
    // Guardrail: rasio diskon terburuk per keranjang diterapkan ke tiap SKU aktif
    var rasio = persen ? nilai / 100 : (minB > 0 ? nilai / minB : 1);
    if (!persen && minB <= 0) { out.status = 'REJECTED_SAFETY_VIOLATION'; out.pesan = 'Voucher nominal wajib punya minimal belanja agar margin bisa dijamin.'; return out; }
    var langgarV = eksCekPromoAman_(eksSemuaSkuAktif_(toko), function (h) { return Math.round(h * (1 - Math.min(1, rasio))); }, 'Shopee', toko);
    if (langgarV.length) { out.status = 'REJECTED_SAFETY_VIOLATION'; out.pesan = 'Voucher membuat ' + langgarV.length + ' SKU di bawah HPP + komisi, mis.: ' + langgarV.slice(0, 3).join(' | '); return out; }
    var rV = prosesPromoBuatVoucher({ email: opsi.email, platform: 'Shopee', nama: d.nama, kode: d.kode, jenisDiskon: persen ? 'Persen' : 'Nominal',
      nilai: nilai, minBelanja: minB, maksDiskon: d.maks_diskon, kuota: d.kuota, mulai: d.mulai, berakhir: d.berakhir });
    out.status = rV.success ? 'SUCCESS' : 'FAILED';
    out.pesan = rV.success ? rV.pesan : rV.error;
    out.respon = rV;
    return out;
  }

  if (jenis === 'BUNDLE') {
    var skus = (Array.isArray(d.skus) ? d.skus : String(d.skus || '').split(/[,\s]+/)).map(function (s) { return String(s).trim(); }).filter(String);
    var minQty = Math.max(2, parseInt(d.min_qty, 10) || 2), tipe = String(d.tipe || 'persen').toLowerCase(), v = Number(d.nilai) || 0;
    if (!skus.length) { out.status = 'FAILED'; out.pesan = 'Daftar SKU bundling kosong.'; return out; }
    if (!(v > 0)) { out.status = 'FAILED'; out.pesan = 'Nilai diskon bundling wajib > 0.'; return out; }
    // purchase_limit WAJIB untuk Shopee (bilangan bulat 1 - 999.999.999). Kosong / 0 -> default.
    var plMentah = (d.purchase_limit !== undefined && d.purchase_limit !== null && String(d.purchase_limit).trim() !== '') ? d.purchase_limit : d.batas_beli;
    var purchaseLimit = EKS_BUNDLE_PURCHASE_LIMIT_DEFAULT_;
    if (plMentah !== undefined && plMentah !== null && String(plMentah).trim() !== '' && Number(plMentah) !== 0) {
      var plAngka = Number(String(plMentah).trim());
      if (!(Number.isInteger(plAngka) && plAngka >= 1 && plAngka <= EKS_BUNDLE_PURCHASE_LIMIT_MAKS_)) {
        out.status = 'FAILED'; out.pesan = 'purchase_limit harus bilangan bulat 1 - 999.999.999 (diterima: "' + plMentah + '").'; return out;
      }
      purchaseLimit = plAngka;
    }
    var hargaUnit = function (h) {
      if (tipe === 'harga_paket') return Math.round(v / minQty);
      if (tipe === 'potongan') return Math.round(h - v / minQty);
      return Math.round(h * (1 - v / 100));
    };
    var langgarB = eksCekPromoAman_(skus, hargaUnit, 'Shopee', toko);
    if (langgarB.length) { out.status = 'REJECTED_SAFETY_VIOLATION'; out.pesan = 'Bundling membuat harga per unit di bawah HPP + komisi: ' + langgarB.slice(0, 4).join(' | '); return out; }
    var mulai = promoDetik_(d.mulai), akhir = promoDetik_(d.berakhir), now = Math.floor(Date.now() / 1000);
    if (!mulai || mulai < now + 60) mulai = now + 600;
    if (!akhir || akhir <= mulai) { out.status = 'FAILED'; out.pesan = 'Periode bundling tidak valid.'; return out; }
    // Peta SKU gudang -> item_id Shopee (kolom "SKU Terhubung Shopee")
    var kol = syncKolomSkuTerhubungMaster_(toko)['Shopee'], itemIds = [], gagalId = [];
    skus.forEach(function (sku) {
      try {
        var p = eksBacaProduk_(sku, toko);
        // v2026.10.87 (DN-107): bundling WAJIB lewat SKU Marketplace terhubung (kolom "SKU Terhubung Shopee"),
        // tidak lagi jatuh ke SKU Gudang bila mapping kosong.
        var kodeList = kol ? skupPecah_(p.sh.getRange(p.row, kol.nomor).getDisplayValue()).filter(String) : [];
        if (!kodeList.length) throw new Error('SKU Marketplace Shopee terhubung belum diisi di Produk Master');
        kodeList.forEach(function (kode) {
          var id = syncResolveIdShopee_(kode);
          if (id && id.item_id && itemIds.indexOf(id.item_id) === -1) itemIds.push(id.item_id);
        });
      } catch (e) { gagalId.push(sku + ': ' + e.message); }
    });
    if (!itemIds.length) { out.status = 'FAILED'; out.pesan = 'Tidak ada SKU yang ditemukan di Shopee. ' + gagalId.join(' | '); return out; }
    var body = { rule_type: tipe === 'harga_paket' ? 1 : tipe === 'potongan' ? 3 : 2, min_amount: minQty, start_time: mulai, end_time: akhir, name: String(d.nama || 'Bundle OmniAI').slice(0, 25), purchase_limit: purchaseLimit };
    if (body.rule_type === 1) body.fix_price = v; else if (body.rule_type === 3) body.discount_value = v; else body.discount_percentage = v;
    var rB = promoShopeePost_(promoPath_('SHP_BUNDLE_ADD') || '/api/v2/bundle_deal/add_bundle_deal', body);
    promoLog_('Shopee add_bundle_deal', { body: body, hasil: rB.json });
    if (!rB.ok) { out.status = 'FAILED'; out.pesan = 'Shopee menolak bundle: ' + rB.pesan; return out; }
    var idBundle = rB.resp.bundle_deal_id;
    var rI = promoShopeePost_(promoPath_('SHP_BUNDLE_ADD_ITEM') || '/api/v2/bundle_deal/add_bundle_deal_item', { bundle_deal_id: idBundle, item_list: itemIds.map(function (id) { return { item_id: id, status: 1 }; }) });
    promoLog_('Shopee add_bundle_deal_item', { id: idBundle, hasil: rI.json });
    out.status = rI.ok ? 'SUCCESS' : 'FAILED';
    out.pesan = rI.ok ? 'Bundle "' + body.name + '" (ID ' + idBundle + ') dibuat di Shopee dengan ' + itemIds.length + ' produk.' + (gagalId.length ? ' ⚠ Dilewati: ' + gagalId.join(' | ') : '')
      : 'Bundle ID ' + idBundle + ' dibuat, tapi produk gagal ditambahkan: ' + rI.pesan;
    out.respon = { bundle_deal_id: idBundle, item_ids: itemIds };
    try { prosesPromoSinkron({ jenis: 'bundling', dariSistem: true }); } catch (e) { }
    return out;
  }
  out.status = 'FAILED'; out.pesan = 'Jenis promo tidak dikenal: ' + jenis + ' (VOUCHER / BUNDLE).';
  return out;
}

/* ---------- 4) toggleAdCampaign ---------- */
function toggleAdCampaign(campaignId, action, opsi) {
  opsi = opsi || {};
  var aksi = /^(enable|on|aktif|resume|start)/i.test(String(action)) ? 'ENABLE' : 'PAUSE';
  var platform = String(opsi.platform || 'TikTok Shop');
  var out = { target: platform + ' campaign ' + campaignId, newValue: aksi };
  if (!String(campaignId || '').trim()) { out.status = 'FAILED'; out.pesan = 'campaign_id wajib diisi.'; return out; }
  if (/tiktok/i.test(platform)) {
    var props = PropertiesService.getScriptProperties();
    var token = String(props.getProperty('TIKTOK_ADS_ACCESS_TOKEN') || '').trim();
    var adv = String(opsi.advertiserId || (props.getProperty('TIKTOK_ADS_ADVERTISER_ID') || '').split(',')[0]).trim();
    if (!token || !adv) { out.status = 'FAILED'; out.pesan = 'TikTok Ads belum diatur (TIKTOK_ADS_ACCESS_TOKEN & TIKTOK_ADS_ADVERTISER_ID).'; return out; }
    var g = iklanTiktokGet_('/open_api/v1.3/campaign/get/', { advertiser_id: adv, filtering: { campaign_ids: [String(campaignId)] }, page: '1', page_size: '10' }, token);
    var c = g.ok && (g.data.list || [])[0];
    out.oldValue = c ? c.operation_status : '(tidak terbaca)';
    if (c) out.target += ' (' + c.campaign_name + ')';
    var body = JSON.stringify({ advertiser_id: adv, campaign_ids: [String(campaignId)], operation_status: aksi === 'ENABLE' ? 'ENABLE' : 'DISABLE' });
    var res = fetchHemat('https://business-api.tiktok.com/open_api/v1.3/campaign/status/update/', { method: 'post', contentType: 'application/json', headers: { 'Access-Token': token }, payload: body, muteHttpExceptions: true });
    var j = null; try { j = JSON.parse(res.getContentText()); } catch (e) { }
    out.respon = j;
    out.status = j && j.code === 0 ? 'SUCCESS' : 'FAILED';
    out.pesan = out.status === 'SUCCESS' ? 'Kampanye TikTok Ads ' + campaignId + (aksi === 'ENABLE' ? ' DIAKTIFKAN.' : ' DIJEDA.') : 'TikTok Ads menolak: ' + ((j && j.message) || 'HTTP ' + res.getResponseCode());
    return out;
  }
  // Shopee Ads (Open Platform v2) - path bisa di-override lewat Script Property PROMO_PATH_SHP_ADS_EDIT
  var path = promoPath_('SHP_ADS_EDIT') || '/api/v2/ads/edit_manual_product_ads';
  var r = promoShopeePost_(path, { reference_id: 'omniai-' + Date.now(), campaign_id: Number(campaignId), edit_action: aksi === 'ENABLE' ? 'resume' : 'pause' });
  promoLog_('Shopee ads toggle', { campaignId: campaignId, aksi: aksi, hasil: r.json });
  out.oldValue = '(tidak terbaca)';
  out.respon = r.json;
  out.status = r.ok ? 'SUCCESS' : 'FAILED';
  out.pesan = r.ok ? 'Kampanye Shopee Ads ' + campaignId + (aksi === 'ENABLE' ? ' DILANJUTKAN.' : ' DIJEDA.') : 'Shopee Ads menolak: ' + r.pesan;
  return out;
}

/* ---------- MAIN DISPATCHER: executeAiAction(actionPayload) ----------
   actionPayload = { tool_call:'execute_action', action, params, email?, sumber:'AI'|'User', mode:'manual'|'autopilot', actionId?, toko? }
   Bisa dipanggil lewat doPost (aksi: execute_ai_action) ATAU google.script.run.executeAiAction(payload) bila HTML disajikan HtmlService. */
function executeAiAction(actionPayload) {
  var a = actionPayload || {};
  if (typeof a === 'string') { try { a = JSON.parse(a); } catch (e) { a = {}; } }
  // Dipanggil langsung lewat google.script.run (tidak lewat router doPost) -> email wajib dari token sesi
  if (!RUTE_TERVERIFIKASI_ && !IZIN_SISTEM_) {
    var sesiLangsung = verifikasiTokenSesi_(a.sessionToken);
    if (!sesiLangsung) return { success: false, sesiHabis: true, status: 'FAILED', pesan: 'Sesi login berakhir. Silakan login ulang.' };
    a = Object.assign({}, a, { email: sesiLangsung.email });
    delete a.sessionToken;
  }
  var email = String(a.email || '').trim();
  if (!email) { try { email = Session.getActiveUser().getEmail() || ''; } catch (e) { } }
  var action = String(a.action || '').toUpperCase().trim(), params = a.params || {};
  var autopilot = String(a.mode || '').toLowerCase() === 'autopilot';
  var oleh = (String(a.sumber || 'AI').toUpperCase() === 'USER' ? 'User' : (autopilot ? 'AI (Auto-Pilot)' : 'AI (dikonfirmasi)')) + ' - ' + (email || 'tidak dikenal');
  var hasil = { success: false, action: action, status: 'FAILED', pesan: '' };

  // Idempotensi: actionId yang sama tidak dieksekusi dua kali (klik ganda / retry jaringan)
  var cache = CacheService.getScriptCache(), kunciId = a.actionId ? 'EKS_ID_' + String(a.actionId).slice(0, 80) : '';
  if (kunciId) { var lama = cache.get(kunciId); if (lama) { try { var o = JSON.parse(lama); o.duplikat = true; return o; } catch (e) { } } }

  var target = params.sku || params.campaign_id || params.nama || params.kode || (Array.isArray(params.items) && params.items.length ? params.items.map(function (x) { return x && x.sku; }).join(', ').slice(0, 200) : '') || '-';
  try {
    if (a.tool_call && a.tool_call !== 'execute_action') throw new Error('tool_call tidak dikenal: ' + a.tool_call);
    if (!cekIzin(email, EKS_IZIN_)) { hasil.status = 'REJECTED_PERMISSION'; throw new Error('Anda tidak punya izin mengeksekusi aksi (butuh izin setara Owner/Admin Keuangan).'); }
    var kunciKebijakan = action === 'TOGGLE_AD' ? 'TOGGLE_AD_' + (/^(enable|on|aktif|resume|start)/i.test(String(params.action)) ? 'ENABLE' : 'PAUSE') : action;
    if (autopilot && !EKS_AUTOPILOT_IZIN_[kunciKebijakan]) { hasil.status = 'REJECTED_POLICY'; throw new Error('Aksi ' + kunciKebijakan + ' tidak boleh dijalankan Auto-Pilot - klik konfirmasi manual.'); }
    var opsi = { email: email, toko: a.toko, autopilot: autopilot };
    var r;
    if (action === 'UPDATE_PRICE') {
      r = updateProductPrice(params.sku, params.new_price, params.platform || 'Shopee', Object.assign({ hargaCoret: params.harga_coret, sync: params.sync }, opsi));
    } else if (action === 'UPDATE_STOCK') {
      r = updateStockQty(params.sku, params.new_qty, params.location, Object.assign({ alasan: params.alasan || params.reason }, opsi));
    } else if (action === 'CREATE_VOUCHER' || action === 'CREATE_BUNDLE' || action === 'CREATE_PROMOTION') {
      var bd = Object.assign({}, params);
      bd.jenis = action === 'CREATE_BUNDLE' ? 'BUNDLE' : action === 'CREATE_VOUCHER' ? 'VOUCHER' : (params.jenis || 'VOUCHER');
      if (bd.jenis === 'VOUCHER') bd.jenis_diskon = params.jenis_diskon || params.jenis_voucher || params.tipe || 'Nominal';
      r = createPromotionOrBundle(bd, opsi);
    } else if (action === 'TOGGLE_AD') {
      r = toggleAdCampaign(params.campaign_id, params.action, Object.assign({ platform: params.platform }, opsi));
    } else if (action === 'UPDATE_MEMORY') {
      r = memoryUbah_(params, Object.assign({ oleh: oleh }, opsi));
    } else if (action === 'AUTOMATE_PRICE_RESTRUCTURE') {
      r = automatePriceRestructure(params, Object.assign({ oleh: oleh }, opsi));
    } else if (action === 'CANCEL_SCHEDULED_TASK') {
      r = sptBatalkanTugas_(params.task_id || params.taskId, oleh, params.alasan);
    } else if (action === 'GET_SCHEDULED_TASKS') {
      r = sptToolLihatTugas_(params);
    } else if (action === 'GET_ACTION_LOGS') {
      r = sptToolLihatLog_(params);
    } else if (action === 'CHECK_SKU_MAPPING') {
      r = cekMappingSku(params.sku, params.platform, opsi);
    } else if (action === 'GET_WAREHOUSE_SUMMARY') {
      r = whToolRingkasan_(params);
    } else if (action === 'CREATE_RESTOCK_MEMO') {
      r = whEksekusiRestockMemo_(params, opsi, a.actionId);
    } else {
      throw new Error('Aksi tidak dikenal: ' + action + ' (UPDATE_PRICE / UPDATE_STOCK / CREATE_VOUCHER / CREATE_BUNDLE / TOGGLE_AD / UPDATE_MEMORY / AUTOMATE_PRICE_RESTRUCTURE / CANCEL_SCHEDULED_TASK / GET_SCHEDULED_TASKS / GET_ACTION_LOGS / CHECK_SKU_MAPPING / GET_WAREHOUSE_SUMMARY / CREATE_RESTOCK_MEMO).');
    }
    hasil.status = r.status || 'FAILED';
    hasil.success = r.status === 'SUCCESS';
    hasil.pesan = r.pesan || '';
    hasil.oldValue = r.oldValue; hasil.newValue = r.newValue; hasil.target = r.target || target;
    if (r.guardrail) hasil.guardrail = r.guardrail;
    if (r.sync) hasil.sync = r.sync;
    if (r.data !== undefined) hasil.data = r.data;
    hasil.bacaSaja = !!r.bacaSaja;
    // Aksi BACA (GET_* / CHECK_*) tidak mengubah apa pun -> tidak dicatat agar audit trail tetap bersih
    if (!r.bacaSaja) eksCatatLog_(oleh, action, hasil.target, r.oldValue, r.newValue, hasil.status, { pesan: hasil.pesan, guardrail: r.guardrail, sync: r.sync, respon: r.respon, params: params });
  } catch (err) {
    hasil.pesan = (err && err.message) ? err.message : String(err);
    if (hasil.status === 'FAILED' || !hasil.status) hasil.status = 'FAILED';
    eksCatatLog_(oleh, action || '(kosong)', target, '', JSON.stringify(params), hasil.status, hasil.pesan);
  }
  if (kunciId && hasil.status !== 'FAILED') { try { cache.put(kunciId, JSON.stringify(hasil), 1800); } catch (e) { } }
  if (hasil.success) { try { CacheService.getScriptCache().remove(COPILOT_CACHE_KONTEKS_ + '_F'); CacheService.getScriptCache().remove(COPILOT_CACHE_KONTEKS_ + '_S'); } catch (e) { } }
  if (!hasil.bacaSaja) { try { memoryCatatEksekusi_(action, hasil, oleh); } catch (eMem) { } }
  return hasil;
}

/* ---------- AKSI doPost: execute_ai_action / cek_harga_aman / lihat_execution_logs ---------- */
function prosesExecuteAiAction(data) {
  var p = data.payload || data;
  p = Object.assign({}, typeof p === 'string' ? JSON.parse(p) : p, { email: data.email, toko: data.toko });
  return executeAiAction(p);
}
function prosesCekHargaAman(data) {
  if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, EKS_IZIN_)) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  var v = validatePriceSafety(data.sku, data.harga, data.platform || 'Shopee', data.toko);
  return { success: true, hasil: v };
}
function prosesLihatExecutionLogs(data) {
  if (!cekIzin(data.email, EKS_IZIN_)) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  var sh = getExecutionLogsSheet_(), lr = sh.getLastRow(), n = Math.min(100, Math.max(1, parseInt(data.limit, 10) || 30));
  if (lr < 2) return { success: true, data: [] };
  var mulai = Math.max(2, lr - n + 1);
  var rows = sh.getRange(mulai, 1, lr - mulai + 1, EKS_HEADER_.length).getDisplayValues().reverse();
  return { success: true, data: rows.map(function (r) { var o = {}; EKS_HEADER_.forEach(function (h, i) { o[h] = r[i]; }); return o; }) };
}

/* ---------- Konteks harga untuk Copilot: harga sekarang + harga minimum aman per platform ---------- */
function copilotKonteksHarga_(skuPrioritas) {
  var sh = getMasterProdukSheet(), lr = sh.getLastRow();
  if (lr < 2) return '';
  var semua = sh.getRange(2, 1, lr - 1, KAT_KOL_STATUS).getValues().filter(function (r) { return String(r[0]).trim() && !katApakahArsip_(r[KAT_KOL_STATUS - 1]); });
  var urut = {}; (skuPrioritas || []).forEach(function (s, i) { if (urut[s] === undefined) urut[s] = i; });
  semua.sort(function (a, b) { var ia = urut[String(a[0]).trim()], ib = urut[String(b[0]).trim()]; return (ia === undefined ? 1e9 : ia) - (ib === undefined ? 1e9 : ib); });
  var baris = ['## HARGA & BATAS AMAN (harga minimum = HPP + komisi marketplace; aksi di bawahnya DITOLAK sistem)'];
  semua.slice(0, 30).forEach(function (r) {
    var sku = String(r[0]).trim(), hpp = parseFloat(r[3]) || 0;
    var minS = hpp ? eksHargaMinimum_(hpp, 'shopee') : null;
    var minT = hpp ? eksHargaMinimum_(hpp, 'tiktok') : null;
    baris.push('- ' + String(r[1] || '').trim() + ' [' + sku + '] HPP ' + (hpp ? eksRp_(hpp) : 'BELUM ADA') +
      ' | Shopee ' + eksRp_(r[6]) + (minS ? ' (min ' + eksRp_(minS) + ')' : '') +
      ' | TikTok ' + eksRp_(r[24]) + (minT ? ' (min ' + eksRp_(minT) + ')' : '') + ' | Offline ' + eksRp_(r[2]));
  });
  return baris.join('\n');
}

function copilotKonteksKampanyeIklan_() {
  var props = PropertiesService.getScriptProperties();
  var token = String(props.getProperty('TIKTOK_ADS_ACCESS_TOKEN') || '').trim();
  var adv = String(props.getProperty('TIKTOK_ADS_ADVERTISER_ID') || '').split(',')[0].trim();
