          if (asliD && !target[k]) (mirip[asliD] = mirip[asliD] || {})[src.fnSumber(r) + '|' + no] = { no: no, sumber: src.fnSumber(r), kolom: String(head[c] || ('Kolom ' + (c + 1))), kode: String(bag).trim() };
        });
