function devTerapkanPaketSelesai_() {
  var props = PropertiesService.getScriptProperties();
  var sudah = String(props.getProperty('DEV_PAKET_DITERAPKAN') || '').split(',').filter(String);
  var antre = DEV_PAKET_SELESAI_.filter(function (pk) { return sudah.indexOf(pk.versi) < 0; });
