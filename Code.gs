  Object.keys(rata).forEach(function (s) { if (!(unit[s] > 0) && rata[s] > 0) { unit[s] = rata[s]; sumberPakai[s] = sumberRata[s] || 'pembelian'; } });

  var tanpaHpp = {}, jual = D.jualSku || {}, rusak = D.rusakSku || {}, terakhir = D.terakhirJual || {};
  Object.keys(D.hari).forEach(function (t) { D.hari[t].h = 0; D.hari[t].r = 0; });
  Object.keys(jual).forEach(function (t) {
    var tot = 0, m = jual[t];
    Object.keys(m).forEach(function (s) {
