}

/* ####################################################################################
   PAKET 11 (v2026.10.24) - AGEN PENJUALAN & MARGIN ("Agen Growth")
   Tujuan: menaikkan PENJUALAN dan MARGIN. Analisa 100% dari data ERP (tidak mengarang angka), lalu
   rekomendasi berbentuk aksi yang SAMA dengan Copilot (executeAiAction: izin, guardrail HPP + komisi,
   batas ±50%, Execution_Logs). Tidak ada aksi yang jalan tanpa klik konfirmasi Owner.
   Sumber data: header + detail pesanan Shopee / TikTok Shop & Tokopedia / Conner / PO Sales / Website,
   Master Produk (HPP, harga per kanal), Log Sync Harga (perubahan harga), ringkasan stok gudang (saranQty).
   Aksi: agen_penjualan_analisa { hari: 7|14|30, pakaiAI: bool, segar: bool }  (izin EKS_IZIN_)
   #################################################################################### */
var AGP_CACHE_ = 'AGP_ANALISA_V1_';
var AGP_BATAL_ = { UNPAID: 1, CANCELLED: 1, CANCELED: 1, IN_CANCEL: 1, AWAITING_PAYMENT: 1, PENDING_PAYMENT: 1, BATAL: 1, DIBATALKAN: 1 };
function agpBatal_(st) { var s = String(st || '').trim().toUpperCase().replace(/\s+/g, '_'); return !!AGP_BATAL_[s] || /BATAL|CANCEL/.test(s); }
function agpTgl_(d) { return Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd'); }
function agpBulat_(n, ke) { ke = ke || 100; return Math.round(n / ke) * ke; }
function agpPct_(a, b) { return b > 0 ? Math.round((a - b) / b * 1000) / 10 : (a > 0 ? null : 0); }

function prosesAgenPenjualanAnalisa(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, EKS_IZIN_)) throw new Error('Agen Penjualan khusus Owner / Admin Keuangan.');
    var hari = [7, 14, 30].indexOf(parseInt(data.hari, 10)) !== -1 ? parseInt(data.hari, 10) : 7;
    var kunci = AGP_CACHE_ + hari;
    var c = null;
    if (!data.segar) { try { c = cacheBesarGet_(kunci); } catch (e) { c = null; } }
    var hasil = c || agpAnalisa_({ hari: hari });
    if (!c) { try { cacheBesarPut_(kunci, hasil, 600); } catch (e) { } }
    if (data.pakaiAI && !hasil.narasi) {
      try { hasil.narasi = agpNarasiAI_(hasil); try { cacheBesarPut_(kunci, hasil, 600); } catch (e2) { } }
      catch (eAI) { hasil.narasiError = String(eAI.message || eAI).slice(0, 300); }
    }
    result.success = true; result.analisa = hasil;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}

// Pesanan terstandar: { no, kanal, ms, total, item:[{sku, qty}] }
function agpKumpulkanPesanan_(sejakMs) {
  var out = [], perNo = {};
  var idTeks = function (v) { return typeof v === 'number' ? kunciResi_(v) : String(v || '').trim(); };
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  function tambahHeader(no, kanal, tgl, total, status) {
    if (!no || !(tgl instanceof Date) || tgl.getTime() < sejakMs || agpBatal_(status)) return;
    var o = { no: no, kanal: kanal, ms: tgl.getTime(), total: ccAngkaRupiah_(total), item: [] };
    out.push(o); perNo[kanal + '|' + kunciResi_(no)] = o;
  }
  function tambahDetail(namaSheet, kanalList) {
    var sh = ss.getSheetByName(namaSheet);
    if (!sh || sh.getLastRow() < 2) return;
    sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues().forEach(function (r) {
      var k = kunciResi_(idTeks(r[0])); if (!k) return;
      for (var i = 0; i < kanalList.length; i++) {
        var o = perNo[kanalList[i] + '|' + k];
        if (o) { var q = Number(r[2]) || 0, s = String(r[1] || '').trim(); if (s && q > 0) pecahSkuPesananBundling_(s, q).forEach(function (b) { o.item.push({ sku: b.sku, qty: b.qty }); }); return; }
      }
    });
  }
  try { var shS = getPesananShopeeSheet(), lrS = shS.getLastRow(); if (lrS > 1) shS.getRange(2, 1, lrS - 1, 5).getValues().forEach(function (r) { tambahHeader(idTeks(r[0]), 'Shopee', r[1], r[3], r[4]); }); } catch (e) { }
  try { var shT = getPesananTikTokShopSheet(), lrT = shT.getLastRow(); if (lrT > 1) shT.getRange(2, 1, lrT - 1, 17).getValues().forEach(function (r) { tambahHeader(idTeks(r[0]), r[16] === 'TOKOPEDIA' ? 'Tokopedia' : 'TikTok Shop', r[1], r[3], r[4]); }); } catch (e) { }
  try { var shC = getPesananConnerSheet(), lrC = shC.getLastRow(); if (lrC > 1) shC.getRange(2, 1, lrC - 1, 5).getValues().forEach(function (r) { tambahHeader(idTeks(r[0]), 'Conner', r[1], r[3], r[4]); }); } catch (e) { }
  try {
    var sm = getPesananManualSheets(), lrM = sm.header.getLastRow();
    if (lrM > 1) sm.header.getRange(2, 1, lrM - 1, 12).getValues().forEach(function (r) { tambahHeader(idTeks(r[0]), 'PO Sales', r[1], r[9], r[11]); });
    var lrMD = sm.detail.getLastRow();
    if (lrMD > 1) sm.detail.getRange(2, 1, lrMD - 1, 4).getValues().forEach(function (r) {
      var o = perNo['PO Sales|' + kunciResi_(idTeks(r[0]))]; if (o && String(r[1] || '').trim() && Number(r[3]) > 0) o.item.push({ sku: String(r[1]).trim(), qty: Number(r[3]) });
    });
  } catch (e) { }
  try { var shW = getPesananWebsiteSheet(), lrW = shW.getLastRow(); if (lrW > 1) shW.getRange(2, 1, lrW - 1, 8).getValues().forEach(function (r) { tambahHeader(idTeks(r[0]), 'Website', r[1], r[6], r[7]); }); } catch (e) { }
  tambahDetail('Pesanan Shopee Detail', ['Shopee']);
  tambahDetail('Pesanan TikTok Shop Detail', ['TikTok Shop', 'Tokopedia']);
  tambahDetail('Pesanan Conner Detail', ['Conner']);
  return out;
}

function agpMaster_() {
  var m = {}, sh = getMasterProdukSheet(), lr = sh.getLastRow();
  if (lr < 2) return m;
  sh.getRange(2, 1, lr - 1, KAT_KOL_STATUS).getValues().forEach(function (r) {
    var sku = String(r[0] || '').trim(); if (!sku || katApakahArsip_(r[KAT_KOL_STATUS - 1])) return;
    m[sku.toUpperCase()] = { sku: sku, nama: String(r[1] || '').trim(), offline: Number(r[2]) || 0, hpp: parseFloat(r[3]) || 0, shopee: Number(r[6]) || 0, tiktok: Number(r[24]) || 0, coretShopee: Number(r[27]) || 0, coretTiktok: Number(r[28]) || 0 };
  });
  return m;
}
function agpGrupKanal_(kanal) { return kanal === 'Shopee' ? 'shopee' : (kanal === 'Tokopedia' ? 'tokopedia' : (kanal === 'TikTok Shop' || kanal === 'Conner' ? 'tiktok' : 'default')); }
function agpHargaKanal_(p, kanal) { return kanal === 'Shopee' ? p.shopee : (kanal === 'TikTok Shop' || kanal === 'Tokopedia' || kanal === 'Conner' ? p.tiktok : p.offline) || p.shopee || p.tiktok || p.offline; }

// Perubahan Harga Jual Final per SKU+kanal dalam N hari (Log Sync Harga, mode LIVE, tidak gagal)
function agpPerubahanHarga_(sejakMs) {
  var out = {};
  try {
    var sh = getLogSyncHargaSheet_(), lr = sh.getLastRow(); if (lr < 2) return out;
    var awal = Math.max(2, lr - 3000), rows = sh.getRange(awal, 1, lr - awal + 1, 8).getValues(), per = {};
    rows.forEach(function (r) {
      if (!(r[0] instanceof Date) || /gagal|error|ditolak|fail/i.test(String(r[7] || '')) || !/live/i.test(String(r[4] || ''))) return;
      var harga = Number(r[6]) || 0; if (!(harga > 0)) return;
      var k = String(r[1] || '').trim().toUpperCase() + '|' + String(r[2] || '').trim();
      (per[k] = per[k] || []).push({ ms: r[0].getTime(), harga: harga });
    });
    Object.keys(per).forEach(function (k) {
      var l = per[k].sort(function (a, b) { return a.ms - b.ms; });
      for (var i = l.length - 1; i > 0; i--) {
        if (l[i].ms < sejakMs) break;
        if (l[i].harga !== l[i - 1].harga) {
          var sku = k.split('|')[0];
          if (!out[sku] || out[sku].ms < l[i].ms) out[sku] = { ms: l[i].ms, kanal: k.split('|')[1], dari: l[i - 1].harga, ke: l[i].harga, naik: l[i].harga > l[i - 1].harga };
          break;
        }
      }
    });
  } catch (e) { }
  return out;
}

function agpAnalisa_(opsi) {
  var hari = opsi.hari || 7, HARI = 86400000;
  var sekarang = new Date(), tz = Session.getScriptTimeZone();
  var akhirHariIni = Utilities.parseDate(agpTgl_(sekarang) + ' 00:00:00', tz, 'yyyy-MM-dd HH:mm:ss').getTime() + HARI;
  // Hari ini belum selesai -> jendela A = N hari PENUH terakhir s/d kemarin; B = N hari sebelumnya
  var aAkhir = akhirHariIni - HARI, aMulai = aAkhir - hari * HARI, bMulai = aMulai - hari * HARI;
  var seriMulai = akhirHariIni - Math.max(28, hari * 2) * HARI;
  var sejak = Math.min(bMulai, seriMulai);
  var pesanan = agpKumpulkanPesanan_(sejak);
  var master = agpMaster_();
  var induk = function (s) { var x = String(resolveSkuJualCepat_(s) || s).trim(); return x.toUpperCase(); };
  // Alokasi omzet pesanan ke item: proporsional qty x harga kanal (Master)
  var kanal = {}, sku = {}, harian = {}, pasangan = {}, tanpaRincian = { n: 0, omzet: 0 };
  function slotK(k) { return kanal[k] || (kanal[k] = { kanal: k, omzetA: 0, omzetB: 0, pesananA: 0, pesananB: 0, labaA: 0, labaB: 0 }); }
  function slotS(k) { var p = master[k] || { sku: k, nama: k, hpp: 0, shopee: 0, tiktok: 0, offline: 0 }; return sku[k] || (sku[k] = { sku: p.sku, nama: p.nama, qtyA: 0, qtyB: 0, omzetA: 0, omzetB: 0, labaA: 0, labaB: 0, kanalQty: {}, adaMaster: !!master[k] }); }
  pesanan.forEach(function (o) {
    var jendela = o.ms >= aMulai && o.ms < aAkhir ? 'A' : (o.ms >= bMulai && o.ms < aMulai ? 'B' : '');
    var t = agpTgl_(new Date(o.ms));
    var h = harian[t] || (harian[t] = { t: t, omzet: 0, pesanan: 0, laba: 0 });
    h.omzet += o.total; h.pesanan++;
    var bobot = o.item.map(function (it) { var p = master[induk(it.sku)]; return it.qty * (p ? (agpHargaKanal_(p, o.kanal) || 1) : 1); });
    var totB = bobot.reduce(function (s, b) { return s + b; }, 0);
    var labaO = 0, grup = agpGrupKanal_(o.kanal);
    o.item.forEach(function (it, i) {
      var k = induk(it.sku), p = master[k], s = slotS(k);
      var omz = totB > 0 ? o.total * bobot[i] / totB : 0;
      var unit = it.qty > 0 ? omz / it.qty : 0;
      var laba = p && p.hpp > 0 && unit > 0 ? (unit - p.hpp - eksPotonganKomisi_(grup, unit).total) * it.qty : 0;
      labaO += laba;
      if (jendela) { s['qty' + jendela] += it.qty; s['omzet' + jendela] += omz; s['laba' + jendela] += laba; if (jendela === 'A') s.kanalQty[o.kanal] = (s.kanalQty[o.kanal] || 0) + it.qty; }
    });
    h.laba += labaO;
    if (!o.item.length) { tanpaRincian.n++; tanpaRincian.omzet += o.total; }
    if (jendela) { var sk = slotK(o.kanal); sk['omzet' + jendela] += o.total; sk['pesanan' + jendela]++; sk['laba' + jendela] += labaO; }
    // Pasangan SKU yang sering dibeli bersama (28 hari) -> ide bundling
    if (o.ms >= akhirHariIni - 28 * HARI && o.item.length > 1) {
      var u = {}; o.item.forEach(function (it) { u[induk(it.sku)] = 1; });
      var ks = Object.keys(u).sort();
      for (var a = 0; a < ks.length && a < 6; a++) for (var b = a + 1; b < ks.length && b < 6; b++) { var kp = ks[a] + '+' + ks[b]; pasangan[kp] = (pasangan[kp] || 0) + 1; }
    }
  });
  var tot = { omzetA: 0, omzetB: 0, pesananA: 0, pesananB: 0, labaA: 0, labaB: 0 };
  Object.keys(kanal).forEach(function (k) { var x = kanal[k]; ['omzetA', 'omzetB', 'pesananA', 'pesananB', 'labaA', 'labaB'].forEach(function (f) { tot[f] += x[f]; }); x.deltaPct = agpPct_(x.omzetA, x.omzetB); });
  tot.deltaPct = agpPct_(tot.omzetA, tot.omzetB); tot.pesananDeltaPct = agpPct_(tot.pesananA, tot.pesananB);
  tot.aovA = tot.pesananA ? Math.round(tot.omzetA / tot.pesananA) : 0; tot.aovB = tot.pesananB ? Math.round(tot.omzetB / tot.pesananB) : 0;
  tot.marginPctA = tot.omzetA > 0 ? Math.round(tot.labaA / tot.omzetA * 1000) / 10 : null;
  tot.marginPctB = tot.omzetB > 0 ? Math.round(tot.labaB / tot.omzetB * 1000) / 10 : null;

  // Stok (ringkasan gudang: status HABIS/KRITIS/MENIPIS + saranQty dari sistem)
  var kritis = {};
  try { kritis = ceoPetaSkuKritis_(whAmbilRingkasanGudang_({})); } catch (eSt) { kritis = {}; }
  var ubahHarga = agpPerubahanHarga_(akhirHariIni - Math.max(21, hari * 2) * HARI);

  var daftarSku = Object.keys(sku).map(function (k) {
    var s = sku[k], p = master[k] || {};
    s.deltaPct = agpPct_(s.qtyA, s.qtyB);
    s.hpp = p.hpp || 0; s.hargaShopee = p.shopee || 0; s.hargaTiktok = p.tiktok || 0;
    var kanalUtama = Object.keys(s.kanalQty).sort(function (a, b) { return s.kanalQty[b] - s.kanalQty[a]; })[0] || (p.shopee ? 'Shopee' : 'TikTok Shop');
    s.kanalUtama = kanalUtama;
    var hk = p.sku ? agpHargaKanal_(p, kanalUtama) : 0;
    s.hargaKanal = hk;
    s.marginPct = hk > 0 && p.hpp > 0 ? Math.round((hk - p.hpp - eksPotonganKomisi_(agpGrupKanal_(kanalUtama), hk).total) / hk * 1000) / 10 : null;
    var st = kritis[k]; if (st) { s.stokStatus = st.status; s.stokAvail = st.avail; s.saranQty = Number(st.saranQty) || 0; }
    if (ubahHarga[k]) s.hargaBerubah = ubahHarga[k];
    s.omzetA = Math.round(s.omzetA); s.omzetB = Math.round(s.omzetB); s.labaA = Math.round(s.labaA); s.labaB = Math.round(s.labaB);
    delete s.kanalQty;
    return s;
  });
  daftarSku.sort(function (a, b) { return (b.omzetA + b.omzetB) - (a.omzetA + a.omzetB); });

  // ---------- Temuan & rekomendasi (aturan sederhana, bisa dijelaskan) ----------
  var temuan = [], rek = [], rp = eksRp_;
  var rataHarian = function (s) { return (s.qtyA + s.qtyB) / (2 * hari); };
  var unitRev = function (s) { var q = s.qtyA + s.qtyB; return q ? (s.omzetA + s.omzetB) / q : s.hargaKanal; };
  if (tot.deltaPct !== null && tot.deltaPct <= -10) temuan.push({ tingkat: 'tinggi', judul: 'Omzet turun ' + Math.abs(tot.deltaPct) + '% vs ' + hari + ' hari sebelumnya', detail: rp(tot.omzetA) + ' (' + tot.pesananA + ' pesanan) vs ' + rp(tot.omzetB) + ' (' + tot.pesananB + ' pesanan). Rata-rata nilai pesanan ' + rp(tot.aovA) + ' vs ' + rp(tot.aovB) + '.' });
  else if (tot.deltaPct !== null && tot.deltaPct >= 10) temuan.push({ tingkat: 'info', judul: 'Omzet naik ' + tot.deltaPct + '%', detail: rp(tot.omzetA) + ' vs ' + rp(tot.omzetB) + '.' });
  Object.keys(kanal).forEach(function (k) { var x = kanal[k]; if (x.omzetB >= 200000 && x.deltaPct !== null && x.deltaPct <= -25) temuan.push({ tingkat: 'tinggi', judul: k + ' turun ' + Math.abs(x.deltaPct) + '%', detail: rp(x.omzetA) + ' (' + x.pesananA + ' pesanan) vs ' + rp(x.omzetB) + ' (' + x.pesananB + ' pesanan).' }); });
  if (tot.marginPctA !== null && tot.marginPctB !== null && tot.marginPctA < tot.marginPctB - 3) temuan.push({ tingkat: 'sedang', judul: 'Margin kotor turun ke ' + tot.marginPctA + '% (sebelumnya ' + tot.marginPctB + '%)', detail: 'Laba kotor estimasi (setelah HPP & komisi) ' + rp(tot.labaA) + ' vs ' + rp(tot.labaB) + '.' });

  // R1 Stok habis / kritis pada produk yang laku -> 1 memo restock
  var restock = daftarSku.filter(function (s) { return s.stokStatus && /HABIS|KRITIS/i.test(s.stokStatus) && (s.qtyA + s.qtyB) >= 3 && s.saranQty > 0; }).slice(0, 10);
  if (restock.length) {
    var hilang = restock.reduce(function (t, s) { return t + rataHarian(s) * unitRev(s) * 7; }, 0);
    temuan.push({ tingkat: 'tinggi', judul: restock.length + ' produk laku stoknya habis / kritis', detail: restock.map(function (s) { return s.nama + ' (' + s.stokStatus + ', laku ' + (s.qtyA + s.qtyB) + ' pcs/' + (2 * hari) + ' hari)'; }).join('; ') });
    rek.push({ prioritas: 'tinggi', kategori: 'penjualan', judul: 'Restock ' + restock.length + ' produk laku', alasan: 'Produk laris kehabisan stok = penjualan hilang. Jumlah memakai saran sistem (stok aman).',
      dampak: 'Menyelamatkan ± ' + rp(hilang) + ' omzet per minggu', aksi: { tool_call: 'execute_action', action: 'CREATE_RESTOCK_MEMO', params: { items: restock.map(function (s) { return { sku: s.sku, qty: s.saranQty }; }), catatan: 'Usulan Agen Penjualan: produk laku stok habis/kritis' } } });
  }
  // R2 Turun setelah harga NAIK -> kembalikan harga lama (bila aman)
  daftarSku.forEach(function (s) {
    if (rek.length >= 12 || !s.adaMaster) return;
