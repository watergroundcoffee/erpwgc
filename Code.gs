var BILLING_HARGA_BULANAN = 200000;
var BILLING_HARGA_TAHUNAN = 2000000;
var BILLING_KUOTA_PER_BULAN = 1000;
var BILLING_BIAYA_OVERAGE_PER_TX = 200;

function getBillingSettingsSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Billing Pengaturan Langganan');
  if (!sh) {
    sh = ss.insertSheet('Billing Pengaturan Langganan');
    sh.getRange(1, 1, 1, 2).setValues([['Key', 'Value']]);
    sh.getRange(1, 1, 1, 2).setFontWeight('bold');
  }
  return sh;
}

function prosesSimpanPengaturanLangganan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'lihatTagihan')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tanggalMulai = String(data.tanggalMulai || '').trim(); // format 'YYYY-MM-DD'
    var jenisPaket = String(data.jenisPaket || '').trim(); // 'Bulanan' | 'Tahunan'
    if (!tanggalMulai) throw new Error('Tanggal mulai langganan wajib diisi.');
    if (jenisPaket !== 'Bulanan' && jenisPaket !== 'Tahunan') throw new Error('Jenis paket nggak valid.');

    var sh = getBillingSettingsSheet();
    var lastRow = sh.getLastRow();
    var petaRow = {};
    if (lastRow > 1) {
      sh.getRange(2, 1, lastRow - 1, 1).getValues().forEach(function (row, idx) { petaRow[String(row[0])] = idx + 2; });
    }
    function simpanKeyValue(key, value) {
      if (petaRow[key]) sh.getRange(petaRow[key], 2).setValue(value);
      else sh.appendRow([key, value]);
    }
    simpanKeyValue('tanggal_mulai_langganan', tanggalMulai);
    simpanKeyValue('jenis_paket', jenisPaket);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesLihatPengaturanLangganan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'lihatTagihan')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getBillingSettingsSheet();
    var lastRow = sh.getLastRow();
    var peta = {};
    if (lastRow > 1) {
      sh.getRange(2, 1, lastRow - 1, 2).getValues().forEach(function (row) { peta[String(row[0])] = row[1]; });
    }
    result.success = true;
    result.tanggalMulai = peta['tanggal_mulai_langganan'] || '';
    result.jenisPaket = peta['jenis_paket'] || 'Bulanan';
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Hitung batas periode billing ke-N (1-based) sejak tanggal mulai langganan.
// Aturan: periode dimulai H+1 tanggal langganan s.d. tanggal H bulan berikutnya.
// Contoh: mulai 15 Jan -> periode 1 = 16 Jan s.d. 15 Feb, periode 2 = 16 Feb s.d. 15 Mar, dst.
function hitungPeriodeBillingKe(tanggalMulaiLangganan, nomorPeriode) {
  var mulai = new Date(tanggalMulaiLangganan);
  var awalPeriode = new Date(mulai);
  awalPeriode.setDate(awalPeriode.getDate() + 1); // H+1
  awalPeriode.setMonth(awalPeriode.getMonth() + (nomorPeriode - 1));

  var akhirPeriode = new Date(mulai);
  akhirPeriode.setMonth(akhirPeriode.getMonth() + nomorPeriode); // tanggal H bulan berikutnya

  return { awal: awalPeriode, akhir: akhirPeriode };
}

// Hitung berapa banyak periode yang udah lewat/sedang berjalan dari tanggal mulai
// langganan sampai tanggal referensi (biasanya "hari ini").
function hitungNomorPeriodeSaatIni(tanggalMulaiLangganan, tanggalReferensi) {
  var mulai = new Date(tanggalMulaiLangganan);
  var ref = new Date(tanggalReferensi);
  var nomor = 1;
  while (true) {
    var periode = hitungPeriodeBillingKe(mulai, nomor);
    if (ref <= periode.akhir) return nomor;
    nomor++;
    if (nomor > 240) return nomor; // jaga-jaga infinite loop (20 tahun), harusnya nggak pernah kejadian
  }
}

// Hitung jumlah transaksi yang BENERAN Selesai (bukan cuma "belum batal") dari SEMUA channel
// (TikTok Shop, Shopee, PO Sales) dalam 1 rentang tanggal - PENTING: difilter berdasarkan
// TANGGAL JADI SELESAI (kapan status berubah jadi Selesai/COMPLETED), BUKAN tanggal order
// dibuat - jadi order yang dibuat jauh sebelum periode berjalan, tapi baru Selesai di periode
// ini, TETAP kehitung di periode ini (sesuai definisi billing yang diminta).
function hitungTransaksiSuksesDalamPeriode(tanggalAwal, tanggalAkhir) {
  var awalMs = tanggalAwal.getTime();
  var akhirMs = tanggalAkhir.getTime() + (24 * 60 * 60 * 1000 - 1); // sampai akhir hari tanggalAkhir
  var totalSukses = 0;

  function hitungDariSheet(sheet, kolomStatus, kolomTanggalSelesai, statusSukses) {
    var lastRow = sheet.getLastRow();
    if (lastRow < 2) return;
    var jumlahKolom = Math.max(kolomStatus, kolomTanggalSelesai);
    var vals = sheet.getRange(2, 1, lastRow - 1, jumlahKolom).getValues();
    vals.forEach(function (row) {
      var status = String(row[kolomStatus - 1] || '').trim().toUpperCase();
      if (status !== statusSukses) return; // HARUS beneran Selesai/COMPLETED, bukan status lain
      var tglSelesai = row[kolomTanggalSelesai - 1];
      if (!(tglSelesai instanceof Date)) return; // nggak ada tanggal jadi Selesai-nya = nggak bisa dipastikan masuk periode mana, jangan dihitung
      var tglMs = tglSelesai.getTime();
      if (tglMs < awalMs || tglMs > akhirMs) return;
      totalSukses++;
    });
  }

  hitungDariSheet(getPesananTikTokShopSheet(), 5, 18, 'COMPLETED');
  hitungDariSheet(getPesananShopeeSheet(), 5, 17, 'COMPLETED');
  hitungDariSheet(getPesananManualSheets().header, 12, 19, 'SELESAI');

  return totalSukses;
}

// Hitung rincian tagihan 1 periode: kuota, overage, total.
function hitungRincianTagihanPeriode(jenisPaket, jumlahTransaksi) {
  var hargaDasar = jenisPaket === 'Tahunan' ? Math.round(BILLING_HARGA_TAHUNAN / 12) : BILLING_HARGA_BULANAN;
  var kelebihan = Math.max(0, jumlahTransaksi - BILLING_KUOTA_PER_BULAN);
  var biayaOverage = kelebihan * BILLING_BIAYA_OVERAGE_PER_TX;
  return {
    kuota: BILLING_KUOTA_PER_BULAN,
    terpakai: jumlahTransaksi,
    kelebihan: kelebihan,
    hargaDasar: hargaDasar,
    biayaOverage: biayaOverage,
    total: hargaDasar + biayaOverage
  };
}

// Fungsi utama - dipanggil dari web. Balikin rekap SEMUA periode dari tanggal mulai
// langganan sampai periode yang sedang berjalan hari ini (biar keliatan histori lengkap).
function prosesSimulasiTagihan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'lihatTagihan')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tanggalMulai = String(data.tanggalMulai || '').trim();
    var jenisPaket = String(data.jenisPaket || '').trim();
    if (!tanggalMulai) throw new Error('Tanggal mulai langganan wajib diisi.');
    if (jenisPaket !== 'Bulanan' && jenisPaket !== 'Tahunan') throw new Error('Jenis paket nggak valid.');

    var sekarang = new Date();
    var nomorPeriodeSaatIni = hitungNomorPeriodeSaatIni(tanggalMulai, sekarang);
    var tz = Session.getScriptTimeZone();
    var daftarPeriode = [];

    for (var i = 1; i <= nomorPeriodeSaatIni; i++) {
      var periode = hitungPeriodeBillingKe(tanggalMulai, i);
      var jumlahTransaksi = hitungTransaksiSuksesDalamPeriode(periode.awal, periode.akhir);
      var rincian = hitungRincianTagihanPeriode(jenisPaket, jumlahTransaksi);
      daftarPeriode.push({
        nomorPeriode: i,
        tanggalAwal: Utilities.formatDate(periode.awal, tz, 'dd MMM yyyy'),
        tanggalAkhir: Utilities.formatDate(periode.akhir, tz, 'dd MMM yyyy'),
        sedangBerjalan: i === nomorPeriodeSaatIni,
        jenisPaket: jenisPaket,
        jumlahTransaksi: jumlahTransaksi,
        kuota: rincian.kuota,
        kelebihan: rincian.kelebihan,
        hargaDasar: rincian.hargaDasar,
        biayaOverage: rincian.biayaOverage,
        total: rincian.total
      });
    }

    daftarPeriode.reverse(); // terbaru duluan
    result.success = true;
    result.daftarPeriode = daftarPeriode;
    result.hargaBulanan = BILLING_HARGA_BULANAN;
    result.hargaTahunan = BILLING_HARGA_TAHUNAN;
    result.kuotaPerBulan = BILLING_KUOTA_PER_BULAN;
    result.biayaOveragePerTx = BILLING_BIAYA_OVERAGE_PER_TX;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function getMemoStockOpnameSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var shHeader = ss.getSheetByName('Memo Stock Opname');
  if (!shHeader) {
    shHeader = ss.insertSheet('Memo Stock Opname');
    shHeader.getRange(1, 1, 1, 6).setValues([['No Memo', 'Tanggal', 'Status', 'Dicatat Oleh', 'Diverifikasi Oleh', 'Tanggal Diverifikasi']]);
    shHeader.getRange(1, 1, 1, 6).setFontWeight('bold');
  }
  var shDetail = ss.getSheetByName('Memo Stock Opname Detail');
  if (!shDetail) {
    shDetail = ss.insertSheet('Memo Stock Opname Detail');
    shDetail.getRange(1, 1, 1, 6).setValues([['No Memo', 'SKU', 'Nama Produk', 'Stok Sistem Saat Itu', 'Stok Fisik', 'Catatan']]);
    shDetail.getRange(1, 1, 1, 6).setFontWeight('bold');
  }
  // Kolom tambahan: ID Kirim (anti dobel antrean HP), Foto URL & penanda Tanpa SKU (nama barang manual)
  if (shHeader.getLastColumn() < 7) shHeader.getRange(1, 7).setValue('ID Kirim').setFontWeight('bold');
  if (shDetail.getLastColumn() < 7) shDetail.getRange(1, 7).setValue('Foto URL').setFontWeight('bold');
  if (shDetail.getLastColumn() < 8) shDetail.getRange(1, 8).setValue('Tanpa SKU').setFontWeight('bold');
  return { header: shHeader, detail: shDetail };
}

// Murni catat draft hasil hitung fisik - TIDAK menyentuh Stock Ledger. Selisih dihitung
// di sini juga (stokFisik - stokSistemSaatItu) biar tersimpan apa adanya, walau stock
// sistem berubah lagi setelahnya, catatan opname ini tetap akurat sesuai momen dihitung.
function prosesSimpanMemoStockOpname(data) {
  var result = { success: false };
  var items, idKirim, sekarang, namaStaff, sheets, petaStok = {};
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    items = (Array.isArray(data.items) ? data.items : []).map(function (it) {
      var sku = String(it.sku || '').replace(/\s+/g, '').trim().slice(0, 60);
      var tanpaSku = it.tanpaSku === true || !sku;
      if (tanpaSku) sku = ''; // nama barang yang diketik manual TIDAK PERNAH disimpan sebagai SKU
      return {
        sku: sku, nama: String(it.nama || '').replace(/\s+/g, ' ').trim().slice(0, 150), tanpaSku: tanpaSku,
        stokFisik: parseFloat(it.stokFisik) || 0, stokSistem: it.stokSistem, catatan: String(it.catatan || '').trim().slice(0, 300)
      };
    }).filter(function (it) { return it.sku || it.nama; });
    if (items.length === 0) throw new Error('Belum ada item di keranjang.');
    if (items.length > 500) throw new Error('Maksimal 500 item per memo.');
    idKirim = String(data.idPermintaan || '').trim().slice(0, 80);
    sekarang = new Date();
    var wDibuat = parseFloat(data.waktuDibuat);
    if (wDibuat > 0 && wDibuat <= Date.now() + 120000 && wDibuat > Date.now() - 14 * 86400000) sekarang = new Date(Math.min(wDibuat, Date.now()));
    namaStaff = getNamaStaff(data.email);
    sheets = getMemoStockOpnameSheets();
    var sudah = idKirim ? soCariIdKirim_(sheets, idKirim) : null;
    if (sudah) return sudah;
    // Staff di mobile HANYA mencatat stok fisik (blind count). Stok sistem saat itu diambil di server -
    // SENGAJA di luar lock (pembacaan berat) supaya tidak menahan proses stok lain.
    var perluStokSistem = items.some(function (it) { return it.sku && (it.stokSistem === undefined || it.stokSistem === null || it.stokSistem === ''); });
    if (perluStokSistem) {
      try {
        var posisi = prosesLihatStock({ email: data.email, toko: data.toko });
        if (posisi.success) posisi.daftar.forEach(function (d) { petaStok[String(d.sku).trim()] = d.stockSaatIni; });
      } catch (eStok) { /* tanpa stok sistem pun memo tetap tersimpan */ }
    }
  } catch (eV) { result.error = eV.toString(); return result; }

  var lock = kunciModul_('stok');
  try { lock.waitLock(15000); } catch (e) { result.error = 'Sistem sibuk, coba lagi.'; return result; }
  try {
    var lagi = idKirim ? soCariIdKirim_(sheets, idKirim) : null;
    if (lagi) return lagi;
    var noMemo = bikinNomorMemo(sheets.header, 'SO');
    var lrH = sheets.header.getLastRow();
    sheets.header.getRange(lrH + 1, 1, 1, 7).setValues([[noMemo, sekarang, 'Menunggu Verifikasi', namaStaff, '', '', idKirim]]);
    var barisDetail = items.map(function (it) {
      var sistem = '';
      if (it.sku) sistem = (it.stokSistem !== undefined && it.stokSistem !== null && it.stokSistem !== '') ? (parseFloat(it.stokSistem) || 0) : (petaStok[it.sku] !== undefined ? petaStok[it.sku] : 0);
      return [noMemo, it.sku, it.nama || '', sistem, it.stokFisik, it.catatan, '', it.tanpaSku ? 'Ya' : ''];
    });
    var barisAwal = sheets.detail.getLastRow() + 1;
    sheets.detail.getRange(barisAwal, 2, barisDetail.length, 1).setNumberFormat('@');
    sheets.detail.getRange(barisAwal, 1, barisDetail.length, 8).setValues(barisDetail);

    result.success = true;
    result.noMemo = noMemo;
    // Nomor baris detail tiap item (urutan sama dengan items) - dipakai upload foto barang
    result.barisDetail = barisDetail.map(function (_, i) { return barisAwal + i; });
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

/* ####################################################################################
   P1 - MEMO GUDANG DARI HP = LANGSUNG MASUK (tanpa validasi admin), DIKIRIM PER MEMO
   - Barang Masuk : stok langsung bertambah pada WAKTU MEMO ("Stok Langsung HP <No Memo>"). Memo tetap
                    tampil di Validasi Masuk untuk pencocokan invoice & hutang supplier; saat divalidasi,
                    baris langsung diganti baris validasi (berharga modal) - stok tidak pernah dobel.
   - Hilang/Rusak : stok langsung berkurang pada waktu memo (status Disetujui otomatis).
   - Stock Opname : HANYA akun Owner. Dari HP langsung menjadi titik nol (Smart Opname) per waktu hitung.
   - Minta Stock  : tidak mengubah stok (tetap ke Pembelian).
   Satu memo = satu kiriman (antrean HP sudah mengirim 1 paket per memo, idPermintaan anti dobel).
   Owner tetap bisa membatalkan memo (Void) - stok dibalik pada waktu yang sama.
   #################################################################################### */
var MG_TANDA_LANGSUNG_ = 'Stok Langsung HP ';
function mgDariHp_(data) { return String(data && data.perangkat || '').toLowerCase() === 'hp'; }
function mgApakahOwner_(email) {
  if (IZIN_SISTEM_) return true;
  if (DEV_EMAIL_TESTING && email === DEV_EMAIL_TESTING) return true;
  try { var st = getStaffByEmail(email); return !!(st && st.role === 'Owner'); } catch (e) { return false; }
}
function bmCariBarisLangsung_(noMemo) {
  var sh = getStockLedgerSheet(), lr = sh.getLastRow(), hasil = [];
  if (lr < 2 || !noMemo) return { sh: sh, baris: hasil };
  // v2026.10.121 (DN-251): tanpa createTextFinder (tidak ada di backend Supabase -> dulu gagal diam-diam, baris
  // langsung tidak terhapus saat validasi). Baca kolom Keterangan lalu cocokkan.
  sh.getRange(2, 5, lr - 1, 1).getValues().forEach(function (v, i) {
    var m = String(v[0] || '').match(/^Stok Langsung HP (\S+)/);
    if (m && m[1] === noMemo) hasil.push(i + 2);
  });
  return { sh: sh, baris: hasil };
}
function bmAdaStokLangsung_(noMemo) { try { return bmCariBarisLangsung_(noMemo).baris.length > 0; } catch (e) { return false; } }
function bmHapusStokLangsung_(memoIds) {
  var semua = [], sh = null;
  (memoIds || []).forEach(function (no) { var c = bmCariBarisLangsung_(String(no).trim()); sh = c.sh; semua = semua.concat(c.baris); });
  if (!sh || !semua.length) return 0;
  semua.sort(function (a, b) { return b - a; }).forEach(function (r) { sh.deleteRow(r); }); // dari bawah -> nomor baris lain aman
  try { smInvalidasiCache(); } catch (e) { }
  return semua.length;
}

function mgLangsungBarangMasuk_(data) {
  var out = prosesSimpanMemoBarangMasuk(data);
  if (!out || !out.success || !mgDariHp_(data)) return out;
  try {
    var noMemo = out.noMemo;
    if (bmAdaStokLangsung_(noMemo)) { out.langsung = true; return out; } // kiriman ulang - sudah diproses
    var sheets = getMemoBarangMasukSheets(), lr = sheets.header.getLastRow(), waktuMemo = new Date(), status = '';
    var v = lr > 1 ? sheets.header.getRange(2, 1, lr - 1, 3).getValues() : [];
    for (var i = v.length - 1; i >= 0; i--) if (String(v[i][0]).trim() === noMemo) { if (v[i][1] instanceof Date) waktuMemo = v[i][1]; status = String(v[i][2] || ''); break; }
    if (!VM_STATUS_MENUNGGU[status]) return out;
    var namaStaff = getNamaStaff(data.email) || data.email || '';
    var baris = [], ld = sheets.detail.getLastRow();
    if (ld > 1) sheets.detail.getRange(2, 1, ld - 1, 4).getValues().forEach(function (r) {
      if (String(r[0]).trim() !== noMemo || !String(r[1] || '').trim() || !(parseFloat(r[2]) > 0)) return;
      baris.push([waktuMemo, String(r[1]).trim(), 'Masuk', parseFloat(r[2]), MG_TANDA_LANGSUNG_ + noMemo + ' (belum divalidasi invoice)' + (r[3] ? ' - ' + r[3] : ''), namaStaff, data.toko || 'Waterground', 0]);
    });
    if (baris.length) {
      var lock = kunciModul_('stok');
      lock.waitLock(20000);
      try { if (!bmAdaStokLangsung_(noMemo)) sisipkanLedgerKronologis_(getStockLedgerSheet(), baris, 8); } finally { lepasKunci_(lock); }
      try { smInvalidasiCache(); } catch (e) { }
    }
    out.langsung = true;
    out.pesanLangsung = 'Stok langsung bertambah (' + baris.length + ' SKU). Memo tetap dicocokkan dengan invoice di Validasi Masuk.';
  } catch (eL) { out.peringatanLangsung = 'Memo tersimpan, tapi stok gagal ditambahkan otomatis: ' + (eL.message || eL) + ' - akan tetap bisa divalidasi manual.'; }
  return out;
}

function mgLangsungHilangRusak_(data) {
  var out = prosesSimpanMemoHilangRusak(data);
  if (!out || !out.success || !mgDariHp_(data)) return out;
  try {
    var r = prosesApproveMemoHilangRusak({ email: data.email, noMemo: out.noMemo, _langsung: true, _namaSistem: 'Otomatis (HP) - ' + (getNamaStaff(data.email) || '') });
    out.langsung = !!r.success || /udah disetujui/i.test(String(r.error || ''));
    if (r.success) { try { smInvalidasiCache(); } catch (e) { } out.pesanLangsung = 'Stok langsung dikurangi.'; }
  } catch (eL) { out.peringatanLangsung = 'Memo tersimpan, tapi stok gagal dikurangi otomatis: ' + (eL.message || eL); }
  return out;
}

function mgLangsungStockOpname_(data) {
  // Stock Opname HANYA untuk akun Owner (web maupun HP)
  if (!mgApakahOwner_(data.email)) return { success: false, error: 'Stock Opname hanya bisa dilakukan akun Owner.' };
  var out = prosesSimpanMemoStockOpname(data);
  if (!out || !out.success || !mgDariHp_(data)) return out;
  try {
    var sheets = getMemoStockOpnameSheets(), lr = sheets.header.getLastRow(), row = -1, status = '', waktuMemo = Date.now();
    var v = lr > 1 ? sheets.header.getRange(2, 1, lr - 1, 3).getValues() : [];
    for (var i = v.length - 1; i >= 0; i--) if (String(v[i][0]).trim() === out.noMemo) { row = i + 2; status = String(v[i][2] || '').trim(); if (v[i][1] instanceof Date) waktuMemo = v[i][1].getTime(); break; }
    if (row < 0 || status === 'Terverifikasi') { out.langsung = status === 'Terverifikasi'; return out; }
    var items = (Array.isArray(data.items) ? data.items : []).filter(function (it) { return String(it.sku || '').trim() && !it.tanpaSku; })
      .map(function (it) { return { sku: String(it.sku).trim(), qtyFisik: it.stokFisik, catatan: 'Memo SO ' + out.noMemo + ' (langsung dari HP)' + (it.catatan ? ' - ' + it.catatan : ''), waktuHitungMs: waktuMemo }; });
    if (!items.length) return out; // semua baris tanpa SKU -> tetap menunggu (perlu diisi SKU dulu)
    var r = prosesSmartOpnameSimpanMassal({ email: data.email, toko: data.toko, items: items, waktuKirimMs: Date.now() });
    if (r && r.success) {
      var adaTanpaSku = (data.items || []).some(function (it) { return !String(it.sku || '').trim() || it.tanpaSku; });
      if (!adaTanpaSku) {
        sheets.header.getRange(row, 3).setValue('Terverifikasi');
        sheets.header.getRange(row, 5, 1, 2).setValues([['Otomatis (HP) - ' + (getNamaStaff(data.email) || ''), new Date()]]);
      }
      out.langsung = true;
      out.pesanLangsung = 'Stok ' + items.length + ' SKU langsung disesuaikan (Smart Opname).' + (adaTanpaSku ? ' Barang tanpa SKU menunggu diisi SKU-nya.' : '');
    } else out.peringatanLangsung = 'Memo tersimpan, tapi opname otomatis gagal: ' + ((r && r.error) || '-');
  } catch (eL) { out.peringatanLangsung = 'Memo tersimpan, tapi opname otomatis gagal: ' + (eL.message || eL); }
  return out;
}

// Cari memo Stock Opname yang sudah tersimpan dengan ID Kirim yang sama (kiriman ulang antrean HP)
function soCariIdKirim_(sheets, idKirim) {
  var lrH = sheets.header.getLastRow();
  if (lrH < 2 || sheets.header.getLastColumn() < 7) return null;
  var awal = Math.max(2, lrH - 499);
  var cek = sheets.header.getRange(awal, 1, lrH - awal + 1, 7).getValues();
  for (var h = cek.length - 1; h >= 0; h--) {
    if (String(cek[h][6] || '') !== idKirim) continue;
    var noAda = String(cek[h][0]).trim(), baris = [];
    var lrD = sheets.detail.getLastRow();
    if (lrD > 1) sheets.detail.getRange(2, 1, lrD - 1, 1).getValues().forEach(function (r, i) { if (String(r[0] || '').trim() === noAda) baris.push(i + 2); });
    return { success: true, noMemo: noAda, barisDetail: baris, duplikat: true };
  }
  return null;
}

// Foto barang Stock Opname (barang tanpa SKU / barcode luntur) -> folder "Stock Opname" di Drive
function prosesUploadFotoMemoStockOpname(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var row = parseInt(data.row, 10);
    var base64Data = String(data.base64 || '');
    if (!row || row < 2) throw new Error('Baris tidak valid');
    if (!base64Data) throw new Error('Tidak ada file yang dikirim');
    var sheets = getMemoStockOpnameSheets();
    if (row > sheets.detail.getLastRow()) throw new Error('Baris detail tidak ditemukan');
    var info = sheets.detail.getRange(row, 1, 1, 3).getValues()[0];
    var noMemo = String(info[0] || '').trim();
    if (data.noMemo && noMemo !== String(data.noMemo).trim()) throw new Error('Baris detail tidak cocok dengan memo ' + data.noMemo);
    var sku = String(info[1] || '').trim(), nama = String(info[2] || '').trim();
    var aman = function (t) { return String(t || '').replace(/[\\/:*?"<>|#%]+/g, '-').replace(/\s+/g, ' ').trim().slice(0, 80); };
    var mime = data.mimeType || 'image/jpeg';
    var ekst = mime === 'image/png' ? '.png' : (mime === 'image/webp' ? '.webp' : '.jpg');
    var fotoKe = parseInt(data.fotoKe, 10) || 1;
    var namaFile = aman(noMemo || ('Baris ' + row)) + ' - ' + aman(sku || ('TANPA SKU ' + nama)) + ' - foto ' + fotoKe + ekst;
    var blob = Utilities.newBlob(Utilities.base64Decode(base64Data), mime, namaFile);
    var file = getSubfolderUpload('Stock Opname').createFile(blob);
    file.setDescription('Foto barang Stock Opname ' + noMemo + (sku ? ' · SKU ' + sku : ' · tanpa SKU: ' + nama) + ' · diunggah ' + (getNamaStaff(data.email) || data.email || ''));
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var urlFile = 'https://drive.google.com/file/d/' + file.getId() + '/view';
    var sel = sheets.detail.getRange(row, 7);
    var lama = String(sel.getValue() || '').trim();
    var daftarUrl = lama ? lama.split(/\s+/).filter(function (u) { return /^https?:/.test(u); }) : [];
    if (daftarUrl.indexOf(urlFile) === -1) daftarUrl.push(urlFile);
    sel.setValue(daftarUrl.join('\n'));
    result.success = true;
    result.url = urlFile;
    result.jumlahFoto = daftarUrl.length;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesLihatDaftarMemoStockOpname(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sheets = getMemoStockOpnameSheets();
    var lastRow = sheets.header.getLastRow();
    var daftar = [];
    var tz = Session.getScriptTimeZone();
    // Ringkasan per memo dari detail: jumlah item, selisih fisik vs sistem, tanpa SKU, foto
    var agg = {};
    var lrD = sheets.detail.getLastRow();
    if (lrD > 1) {
      sheets.detail.getRange(2, 1, lrD - 1, 8).getValues().forEach(function (r) {
        var k = String(r[0] || '').trim();
        if (!k) return;
        var a = agg[k] || (agg[k] = { n: 0, sel: 0, tanpa: 0, foto: 0 });
        a.n++;
        if (!String(r[1] || '').trim()) a.tanpa++;
        else if (r[3] !== '' && r[3] !== null && (parseFloat(r[4]) || 0) !== (parseFloat(r[3]) || 0)) a.sel++;
        if (String(r[6] || '').trim()) a.foto += String(r[6]).trim().split(/\s+/).length;
      });
    }
    if (lastRow > 1) {
      sheets.header.getRange(2, 1, lastRow - 1, 6).getValues().forEach(function (row) {
        if (!row[0]) return;
        var a = agg[String(row[0]).trim()] || { n: 0, sel: 0, tanpa: 0, foto: 0 };
        daftar.push({
          noMemo: row[0],
          tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy HH:mm') : String(row[1] || '-'),
          status: row[2], dicatatOleh: row[3], diverifikasiOleh: row[4] || '-',
          jumlahItem: a.n, nSelisih: a.sel, nTanpaSku: a.tanpa, nFoto: a.foto
        });
      });
    }
    daftar.reverse();
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesLihatDetailMemoStockOpname(data) {
