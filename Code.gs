/* ============================================================
   SMART PASTE PRODUK v2026.10.14 ("Isi dengan AI" di Edit / Tambah Produk)
   - Owner/admin menempel teks halaman produk (Ctrl+A, Ctrl+C dari halaman supplier / marketplace).
   - Pertama kali sebuah format dibaca AI. AI juga melaporkan LABEL yang dipakai format itu
     ("Berat", "Merek", ...). Label yang benar-benar ada di teks disimpan sebagai POLA.
   - Tempelan berikutnya dengan format yang sama dibaca dengan POLA (tanpa AI: instan & gratis).
     AI hanya dipanggil lagi kalau pola tidak cocok / hasilnya terlalu sedikit.
   - Pola disimpan di Script Properties (SMART_PASTE_PRODUK_POLA_V1), maks 60 pola.
   ============================================================ */
var SPPR_KUNCI = 'SMART_PASTE_PRODUK_POLA_V1';
var SPPR_FIELD = ['nama', 'merk', 'tipe', 'material', 'volume', 'warna', 'berat', 'dimensi', 'deskripsi'];

function spprMuatPola_() {
  try { var a = JSON.parse(PropertiesService.getScriptProperties().getProperty(SPPR_KUNCI) || '[]'); return Array.isArray(a) ? a : []; } catch (e) { return []; }
}
function spprSimpanPola_(daftar) {
  daftar.sort(function (a, b) { return (b.terakhir || 0) - (a.terakhir || 0); });
  PropertiesService.getScriptProperties().setProperty(SPPR_KUNCI, JSON.stringify(daftar.slice(0, 60)));
}
function spprNorm_(t) { return String(t || '').toLowerCase().replace(/\s+/g, ' ').trim(); }
function spprBaris_(teks) {
  return String(teks || '').replace(/\r/g, '').split('\n').map(function (x) { return x.replace(/\s+/g, ' ').trim(); }).filter(function (x) { return x; });
}
// Nilai sesudah label: "Berat : 250 gram" -> "250 gram"; label sendirian di satu baris -> baris berikutnya
function spprAmbilNilai_(baris, label) {
  var l = spprNorm_(label);
  if (!l) return '';
  for (var i = 0; i < baris.length; i++) {
    var b = spprNorm_(baris[i]);
    if (b.indexOf(l) !== 0) continue;
    var sisa = baris[i].slice(label.length).replace(/^[\s:：\-–=|]+/, '').trim();
    if (sisa) return sisa.slice(0, 2000);
    if (i + 1 < baris.length) return baris[i + 1].slice(0, 2000);
  }
  return '';
}
function spprLabelAda_(baris, label) {
  var l = spprNorm_(label);
  if (!l || l.length < 2) return false;
  for (var i = 0; i < baris.length; i++) if (spprNorm_(baris[i]).indexOf(l) === 0) return true;
  return false;
}
function spprAngka_(t) { var m = String(t || '').replace(/\./g, '').replace(',', '.').match(/[0-9]+(\.[0-9]+)?/); return m ? Number(m[0]) : 0; }
// "1,2 kg" -> 1200 ; "250 gr" -> 250
function spprBeratGram_(t) {
  var s = String(t || '').toLowerCase();
  var n = Number((s.match(/[0-9]+([.,][0-9]+)?/) || ['0'])[0].replace(',', '.'));
  if (!n) return 0;
  if (/\bkg\b|kilo/.test(s)) n = n * 1000;
  return Math.round(n);
}
// "20 x 15 x 10 cm" -> [20,15,10]
function spprDimensi_(t) {
  var a = String(t || '').replace(/,/g, '.').match(/[0-9]+(\.[0-9]+)?/g) || [];
  if (a.length < 3) return null;
  var k = /\bmm\b/i.test(t) ? 0.1 : (/\bm\b/i.test(t) && !/cm/i.test(t) ? 100 : 1);
  return a.slice(0, 3).map(function (x) { return Math.round(Number(x) * k * 10) / 10; });
}
function spprRapikan_(h) {
  var o = {};
  ['nama', 'merk', 'tipe', 'material', 'volume', 'warna', 'deskripsi', 'urlFoto'].forEach(function (k) {
    var v = String(h[k] == null ? '' : h[k]).trim();
    if (v) o[k] = k === 'deskripsi' ? v.slice(0, 5000) : v.slice(0, 300);
  });
  var g = Number(h.beratGram) || spprBeratGram_(h.berat);
  if (g > 0 && g < 1000000) o.beratGram = g;
  var d = (h.panjangCm && h.lebarCm && h.tinggiCm) ? [Number(h.panjangCm), Number(h.lebarCm), Number(h.tinggiCm)] : spprDimensi_(h.dimensi);
  if (d && d.every(function (x) { return x > 0 && x < 10000; })) { o.panjangCm = d[0]; o.lebarCm = d[1]; o.tinggiCm = d[2]; }
  if (o.urlFoto && !/^https:\/\//i.test(o.urlFoto)) delete o.urlFoto;
  return o;
}

// Coba semua pola tersimpan. Hasil: { pola, hasil } atau null
function spprCocokPola_(baris, daftar) {
  var terbaik = null;
  for (var i = 0; i < daftar.length; i++) {
    var p = daftar[i], penanda = p.penanda || [];
    if (penanda.length < 3) continue;
    var ada = penanda.filter(function (l) { return spprLabelAda_(baris, l); }).length;
    if (ada / penanda.length < 0.7) continue;
    var mentah = {}, terisi = 0;
    Object.keys(p.aturan || {}).forEach(function (f) {
      var v = spprAmbilNilai_(baris, p.aturan[f]);
      if (v) { mentah[f] = v; terisi++; }
    });
    if (p.namaBaris && baris[0]) { mentah.nama = mentah.nama || baris[Math.min(p.namaBaris - 1, baris.length - 1)]; }
    var nAturan = Object.keys(p.aturan || {}).length;
    if (terisi < Math.max(2, Math.ceil(nAturan * 0.6))) continue;
    var skor = ada * 10 + terisi;
    if (!terbaik || skor > terbaik.skor) terbaik = { pola: p, hasil: spprRapikan_(mentah), skor: skor };
  }
  return terbaik;
}

function prosesSmartPasteProduk(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var teks = String(data.teks || '').trim().slice(0, 20000);
    if (teks.length < 20) throw new Error('Teks terlalu pendek - tempel seluruh isi halaman produk (Ctrl+A lalu Ctrl+C).');
    var baris = spprBaris_(teks);
    var daftar = spprMuatPola_();

    if (!data.paksaAI) {
      var cocok = spprCocokPola_(baris, daftar);
      if (cocok && Object.keys(cocok.hasil).length >= 2) {
        cocok.pola.dipakai = (cocok.pola.dipakai || 0) + 1;
        cocok.pola.terakhir = Date.now();
        try { spprSimpanPola_(daftar); } catch (eS) { }
        return { success: true, sumber: 'pola', namaPola: cocok.pola.nama, data: cocok.hasil };
      }
    }

    var prompt = 'Kamu membantu mengisi formulir PRODUK MASTER di ERP toko online. Dari teks halaman produk di bawah (hasil copy seluruh halaman ' +
      'supplier / marketplace), ambil data produk dan kembalikan HANYA JSON (tanpa markdown) dengan format persis:\n' +
      '{"namaFormat": "<nama singkat format/sumber halaman, mis. Halaman produk Hargapabrik.com, Halaman produk Shopee>",\n' +
      ' "nama": "<nama produk yang bersih, tanpa kata promosi/SEO berlebihan, maks 100 karakter>", "merk": "<merek>", "tipe": "<tipe/model/seri>",\n' +
      ' "material": "<bahan>", "volume": "<isi/volume/kapasitas, mis. 250 ml>", "warna": "<warna>",\n' +
      ' "beratGram": <berat paket dalam GRAM, angka saja, 0 bila tidak ada>, "panjangCm": <angka>, "lebarCm": <angka>, "tinggiCm": <angka>,\n' +
      ' "deskripsi": "<deskripsi produk yang rapi, poin penting saja, tanpa info toko/pengiriman/promo, maks 1500 karakter>", "urlFoto": "<URL https gambar produk utama bila tertulis>",\n' +
      ' "label": {"merk": "<TEKS LABEL persis seperti di sumber sebelum nilai merek, mis. Merek>", "tipe": "", "material": "", "volume": "", "warna": "", "berat": "", "dimensi": "", "deskripsi": ""},\n' +
      ' "penanda": ["<3-8 teks label/judul bagian yang SELALU ada di format halaman ini, ditulis persis seperti di sumber, mis. Spesifikasi, Berat, Merek>"]}\n' +
      'ATURAN: hanya pakai data yang TERTULIS di sumber - DILARANG mengarang. Field yang tidak ada = string kosong / 0. ' +
      'Label hanya diisi bila nilai field itu memang tertulis setelah label tersebut di sumber.\n\n' + teks;
    var hasilAI = aiTeksBertingkat_('Smart Paste Produk', prompt, function (x) {
      if (!x || typeof x !== 'object' || Array.isArray(x)) return 'Balasan bukan objek JSON';
      if (!String(x.nama || '').trim() && !String(x.deskripsi || '').trim()) return 'Data produk tidak ditemukan di teks';
      return '';
    });
    var p = hasilAI.parsed || {};
    var hasil = spprRapikan_(p);

    // Simpan pola: hanya label yang benar-benar ada di teks & mengembalikan nilai
    var aturan = {}, lbl = p.label || {};
    ['merk', 'tipe', 'material', 'volume', 'warna', 'berat', 'dimensi', 'deskripsi'].forEach(function (f) {
      var l = String(lbl[f] || '').trim();
      if (l && l.length <= 40 && spprLabelAda_(baris, l) && spprAmbilNilai_(baris, l)) aturan[f] = l;
    });
    var penanda = (Array.isArray(p.penanda) ? p.penanda : []).map(function (x) { return String(x || '').trim(); })
      .filter(function (l) { return l && l.length <= 40 && spprLabelAda_(baris, l); });
    Object.keys(aturan).forEach(function (f) { if (penanda.indexOf(aturan[f]) === -1) penanda.push(aturan[f]); });
    var polaBaru = null;
    if (penanda.length >= 3 && Object.keys(aturan).length >= 2) {
      var namaBaris = 0;
      if (hasil.nama) for (var i = 0; i < Math.min(baris.length, 40); i++) if (spprNorm_(baris[i]) === spprNorm_(hasil.nama)) { namaBaris = i + 1; break; }
      var kunciPola = penanda.map(spprNorm_).sort().join('|');
      daftar = daftar.filter(function (x) { return (x.penanda || []).map(spprNorm_).sort().join('|') !== kunciPola; });
      polaBaru = { id: 'pp' + Date.now().toString(36), nama: String(p.namaFormat || 'Format tanpa nama').slice(0, 80), penanda: penanda.slice(0, 12),
        aturan: aturan, namaBaris: namaBaris, dibuat: Date.now(), terakhir: Date.now(), dipakai: 1, oleh: data.email || '' };
      daftar.push(polaBaru);
      try { spprSimpanPola_(daftar); } catch (eS2) { }
    }
    return { success: true, sumber: 'ai', model: hasilAI.model || '', namaPola: polaBaru ? polaBaru.nama : '', polaDisimpan: !!polaBaru, data: hasil };
  } catch (err) { result.error = err.message || String(err); }
  return result;
}

