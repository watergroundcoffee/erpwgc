/* Lapor Hilang/Rusak dari HP dikirim lewat ANTREAN KIRIM (seperti Minta Stock): idPermintaan unik per memo.
   Anti dobel 2 lapis: cache idPermintaan (idemMulai_) + kolom "ID Kirim" permanen. Kiriman ulang dengan ID yang
   sama mengembalikan memo + baris detail yang sudah ada (upload foto bisa dilanjutkan tanpa membuat memo baru). */
function prosesSimpanMemoHilangRusak(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var items = (Array.isArray(data.items) ? data.items : []).map(function (it) {
      return { sku: String(it.sku || '').trim().slice(0, 60), qty: parseFloat(it.qty) || 0, catatan: String(it.catatan || '').trim().slice(0, 300) };
    }).filter(function (it) { return it.sku && it.qty > 0; });
    if (items.length === 0) throw new Error('Belum ada item di keranjang.');
    if (items.length > 200) throw new Error('Maksimal 200 item per memo.');
    var idKirim = String(data.idPermintaan || '').trim().slice(0, 80);
    var sekarang = new Date();
    var wDibuat = parseFloat(data.waktuDibuat);
    if (wDibuat > 0 && wDibuat <= Date.now() + 120000 && wDibuat > Date.now() - 14 * 86400000) sekarang = new Date(Math.min(wDibuat, Date.now()));
    var namaStaff = getNamaStaff(data.email);
  } catch (errV) { result.error = errV.toString(); return result; }

  var lock = kunciModul_('memo_hr');
  try { lock.waitLock(20000); } catch (e) { result.error = 'Sistem sibuk, coba lagi.'; return result; }
  try {
    var sheets = getMemoHilangRusakSheets();
    var lrH = sheets.header.getLastRow();
    if (idKirim && lrH > 1) {
      var awalH = Math.max(2, lrH - 499);
      var cekH = sheets.header.getRange(awalH, 1, lrH - awalH + 1, 7).getValues();
      for (var h = cekH.length - 1; h >= 0; h--) {
        if (String(cekH[h][6] || '') !== idKirim) continue;
        var noAda = String(cekH[h][0]).trim(), barisAda = [];
        var lrDA = sheets.detail.getLastRow();
        if (lrDA > 1) sheets.detail.getRange(2, 1, lrDA - 1, 1).getValues().forEach(function (r, i) { if (String(r[0] || '').trim() === noAda) barisAda.push(i + 2); });
        return { success: true, noMemo: noAda, barisDetail: barisAda, duplikat: true };
      }
    }
    var noMemo = bikinNomorMemo(sheets.header, 'LHR');
    sheets.header.getRange(lrH + 1, 1, 1, 7).setValues([[noMemo, sekarang, 'Menunggu', namaStaff, '', '', idKirim]]);
    var barisDetail = items.map(function (it) { return [noMemo, it.sku, it.qty || 0, it.catatan || '', '']; });
    var barisAwal = sheets.detail.getLastRow() + 1;
    sheets.detail.getRange(barisAwal, 1, barisDetail.length, 5).setValues(barisDetail);

    result.success = true;
    result.noMemo = noMemo;
    // Nomor baris detail tiap item (urutan sama dengan items) - dipakai upload foto bukti tanpa request tambahan
    result.barisDetail = barisDetail.map(function (_, i) { return barisAwal + i; });
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

