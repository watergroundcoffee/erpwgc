// Office tandai udah dicek - status doang, BELUM ada penyesuaian stock (sesuai instruksi,
// tahap ini cukup sampai pencatatan + verifikasi status). Penyesuaian otomatis nanti nyusul.
function prosesVerifikasiMemoStockOpname(data) {
  return withTransaction(data.email, 'mintaStock', 'stok', function () {
    var result = { success: false };
    var noMemo = String(data.noMemo || '').trim();
    var sheets = getMemoStockOpnameSheets();
    var lastRowHeader = sheets.header.getLastRow();
    var rowTarget = -1;
    if (lastRowHeader > 1) {
      var vals = sheets.header.getRange(2, 1, lastRowHeader - 1, 1).getValues();
      for (var i = 0; i < vals.length; i++) { if (String(vals[i][0]).trim() === noMemo) { rowTarget = i + 2; break; } }
    }
    if (rowTarget === -1) throw new Error('Memo tidak ditemukan.');
    if (String(sheets.header.getRange(rowTarget, 3).getValue()).trim() === 'Terverifikasi') throw new Error('Memo ini sudah terverifikasi.');
    // Barang tanpa SKU (nama manual) wajib diberi SKU dulu lewat Edit sebelum masuk tahap akhir
    var lrDV = sheets.detail.getLastRow(), nTanpaV = 0;
    if (lrDV > 1) sheets.detail.getRange(2, 1, lrDV - 1, 2).getValues().forEach(function (r) { if (String(r[0]).trim() === noMemo && !String(r[1] || '').trim()) nTanpaV++; });
    if (nTanpaV) throw new Error(nTanpaV + ' barang di memo ini belum punya SKU - isi dulu lewat tombol Edit sebelum diverifikasi.');
    // Kolom 4 (Dicatat Oleh) tidak disentuh: status di kolom 3, verifikator & tanggal di kolom 5-6
    sheets.header.getRange(rowTarget, 3).setValue('Terverifikasi');
    sheets.header.getRange(rowTarget, 5, 1, 2).setValues([[getNamaStaff(data.email), new Date()]]);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

function getMemoHilangRusakSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
