// AI baca foto struk/kwitansi biaya operasional, kasih SARAN isian (bukan auto-simpan) -
// user tetap review/edit dulu sebelum klik simpan, biar nggak salah input kalau AI salah baca.
function prosesBacaStrukBiayaAI(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var base64Image = String(data.fotoBase64 || '');
    if (!base64Image) throw new Error('Tidak ada foto yang dikirim');

    var daftarKategori = finDaftarKategori_().map(function (k) { return k.akun; }); // sama persis dengan pilihan di form Finance
    var prompt = 'Ini foto struk/kwitansi/bukti transfer/bukti bayar biaya operasional bisnis. Baca dan kembalikan HANYA JSON (tanpa markdown/backtick), dengan format persis: ' +
      '{"jumlah": <angka total yang dibayar dalam Rupiah, tanpa titik/koma>, "tanggal": "<yyyy-MM-dd tanggal transaksi/pembayaran, kalau tidak ada kosongkan>", ' +
      '"noNota": "<WAJIB DIISI - nomor UNIK transaksi ini>", "jenisNomor": "<label nomor yang dipakai, misal No Ref / NTPN / No Pesanan>", ' +
      '"pajakPenghasilan": <true kalau dokumen ini bukti bayar/setor PAJAK PENGHASILAN (PPh), selain itu false>, ' +
      '"kategoriBiaya": "<pilih salah satu PERSIS dari: ' + daftarKategori.join(', ') + '>", "keterangan": "<ringkasan singkat isi struk, misal nama toko/jenis pembelian>"}\n' +
      'ATURAN noNota (WAJIB & PALING PENTING - dipakai sistem untuk membedakan 2 transaksi yang nominal & tanggalnya sama): ' +
      'periksa SELURUH dokumen (header, footer, pojok, barcode/QR caption, teks kecil). Cari nomor yang unik untuk SATU kali pembayaran ini, urutan prioritas: No Pesanan / Order ID / No Invoice / No Nota / No Struk / ' +
      'No Referensi / Ref No / No Transaksi / ID Transaksi / Kode Bayar / Kode Billing / NTPN / NTB / No Resi pembayaran / Trace No. ' +
      'Salin persis seperti tertulis (huruf & angka). JANGAN pakai nomor yang sama di setiap bulan seperti ID Pelanggan / IDPEL / No Meter / No HP / ' +
      'NPWP / No Rekening / No Kartu - nomor itu bukan nomor nota. Kosongkan HANYA kalau benar-benar tidak ada nomor transaksi sama sekali.\n' +
      'ATURAN PAJAK: bukti setor/bayar PPh (PPh Final 0,5% UMKM PP 55/PP 23, PPh 21, PPh 23, PPh 25, PPh 29, e-Billing DJP, Bukti Penerimaan Negara, ' +
      'kode akun pajak 411128/411125/411126/411121, ada NTPN) -> pajakPenghasilan true dan kategoriBiaya "' + FIN_AKUN_PAJAK_PH + '". ' +
      'PBB, pajak kendaraan/STNK, PPN, bea/cukai BUKAN pajak penghasilan (pajakPenghasilan false).';

    // PROTEKSI BIAYA: Gemini Flash (gratis) WAJIB dicoba dulu; Gemini Pro (berbayar) hanya bila Flash gagal
    // atau nominal tidak terbaca.
    var hasilAI = ocrVisionBertingkat_('Struk Biaya', base64Image, data.fotoMimeType || 'image/jpeg', prompt, function (x) {
      if (!x || typeof x !== 'object' || Array.isArray(x)) return 'Balasan bukan objek JSON';
      if (!(ocrAngka_(x.jumlah) > 0)) return 'Nominal tidak terbaca';
      return '';
    });
    var parsed = hasilAI.parsed;
    parsed.jumlah = ocrAngka_(parsed.jumlah);

    result.success = true;
    result.modelAI = hasilAI.model;
    result.tahapAI = hasilAI.tahap;
    result.alasanFallback = hasilAI.alasanFallback;
    result.jumlah = parseFloat(parsed.jumlah) || 0;
    result.tanggal = parsed.tanggal || '';
    result.kategoriBiaya = daftarKategori.indexOf(parsed.kategoriBiaya) !== -1 ? parsed.kategoriBiaya : 'Beban Operasional Lain';
    var teksPajak = [parsed.keterangan, parsed.jenisNomor, parsed.kategoriBiaya].join(' ');
    if (parsed.pajakPenghasilan === true || /\bpph\b|pajak\s*penghasilan|\bntpn\b|41112[1568]/i.test(teksPajak)) result.kategoriBiaya = FIN_AKUN_PAJAK_PH;
    result.keterangan = String(parsed.keterangan || '').trim();
    var nota = finNotaBersih_(parsed.noNota);
    if (/^(-|NULL|NONE|TIDAK ADA|N\/A|KOSONG)$/.test(nota)) nota = '';
    var jenisNomor = String(parsed.jenisNomor || '').trim().slice(0, 40);
    // No Nota WAJIB: kalau tahap pertama tidak menemukannya, AI diminta membaca ulang KHUSUS mencari nomor transaksi
    if (!nota) {
      try {
        var ulang = bacaNotaFokus_(null, base64Image, data.fotoMimeType || 'image/jpeg');
        if (ulang.noNota) { nota = ulang.noNota; jenisNomor = ulang.jenisNomor || jenisNomor; result.notaDariBacaUlang = true; }
      } catch (eUlang) { /* tetap lanjut - user diminta isi manual */ }
    }
    result.noNota = nota;
    result.jenisNomor = jenisNomor;
  } catch (err) {
    result.error = 'AI gagal baca struk ini (' + err.toString() + ') - isi manual aja.';
  }
  return result;
}

/* ===== AI TEKS BERTINGKAT (gratis dulu, berbayar hanya bila gagal) - versi teks dari ocrVisionBertingkat_ ===== */
function ocrGeminiPanggilTeks_(key, model, prompt) {
  var url = 'https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(model) + ':generateContent';
  var res = fetchHemat(url, { method: 'post', contentType: 'application/json', headers: { 'x-goog-api-key': key }, muteHttpExceptions: true,
    payload: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }],
      generationConfig: { temperature: 0.1, maxOutputTokens: 4096, responseMimeType: 'application/json' } }) });
  var kode = res.getResponseCode(), isi = res.getContentText();
  if (kode !== 200) {
    var ket = isi;
    try { var j = JSON.parse(isi); ket = (j.error && j.error.message) || isi; } catch (eJ) { }
    var e = new Error('HTTP ' + kode + ': ' + String(ket).slice(0, 220)); e.httpKode = kode; throw e;
  }
  var d = JSON.parse(isi);
  var teks = d.candidates && d.candidates[0] && d.candidates[0].content && d.candidates[0].content.parts ?
    d.candidates[0].content.parts.map(function (x) { return x.text || ''; }).join('') : '';
  if (!String(teks).trim()) throw new Error('Balasan kosong');
  return teks;
}
function aiTeksBertingkat_(jenis, prompt, validasiFn) {
  var cfg = ocrKonfig_(), alasan = '';
  function coba(key, model) {
    var teks = ocrGeminiPanggilTeks_(key, model, prompt);
    var parsed = aiParseJsonLonggar_(teks);
    var tolak = validasiFn ? validasiFn(parsed) : '';
    if (tolak) throw new Error(tolak);
    return { parsed: parsed, teks: teks };
  }
  if (cfg.keyGratis) {
    try {
      var h1 = coba(cfg.keyGratis, cfg.modelGratis);
      ocrLog_(jenis, 'gratis', cfg.modelGratis, true, '');
      h1.model = cfg.modelGratis; h1.tahap = 'gratis'; h1.alasanFallback = '';
      return h1;
    } catch (e1) { alasan = String(e1.message || e1); ocrLog_(jenis, 'gratis', cfg.modelGratis, false, alasan); }
  } else if (cfg.rehan && cfg.rehan.key) {
    try {
      var teksR = aifPanggilLangsung_({ prompt: prompt, suhu: 0.1 });
      var pR = aiParseJsonLonggar_(teksR), tR = validasiFn ? validasiFn(pR) : '';
      if (tR) throw new Error(tR);
      ocrLog_(jenis, 'gratis', 'agent Rehan (' + (cfg.rehan.model || cfg.rehan.provider) + ')', true, '');
      return { parsed: pR, teks: teksR, model: cfg.rehan.model || cfg.rehan.provider, tahap: 'gratis', alasanFallback: '' };
    } catch (eR) { alasan = String(eR.message || eR); ocrLog_(jenis, 'gratis', 'agent Rehan', false, alasan); }
  } else {
    alasan = 'Key Gemini gratis (GEMINI_FREE_API_KEY) belum dipasang';
  }
  if (!cfg.keyBayar) throw new Error('Model gratis gagal (' + alasan + ') dan key model berbayar belum dipasang.');
  if (ocrPakaiBayarHariIni_(false) >= cfg.maksBayar) throw new Error('Model gratis gagal (' + alasan + '). Batas harian model berbayar (' + cfg.maksBayar + 'x) sudah tercapai.');
  ocrPakaiBayarHariIni_(true);
  try {
    var h2 = coba(cfg.keyBayar, cfg.modelBayar);
    ocrLog_(jenis, 'berbayar', cfg.modelBayar, true, 'Fallback karena: ' + alasan);
    h2.model = cfg.modelBayar; h2.tahap = 'berbayar'; h2.alasanFallback = alasan;
    return h2;
  } catch (e2) {
    ocrLog_(jenis, 'berbayar', cfg.modelBayar, false, String(e2.message || e2));
    throw new Error('Model gratis: ' + alasan + ' | Model berbayar: ' + String(e2.message || e2));
  }
}

var PROMPT_ATURAN_NO_NOTA_ = 'ATURAN noNota (WAJIB): noNota adalah nomor yang UNIK untuk SATU kali pembayaran/transaksi ini - dipakai sistem untuk ' +
  'membedakan 2 transaksi yang nominal & tanggalnya sama. Urutan prioritas: No Pesanan / Order ID / No Invoice (mis. INV/20260101/XXX/123) / No Faktur / ' +
  'No Nota / No Struk / No Referensi / Ref No / No Transaksi / ID Transaksi / Kode Bayar / Kode Billing / NTPN / NTB / Trace No / No Resi pembayaran. ' +
  'Salin PERSIS seperti tertulis (huruf, angka, tanda / dan -). DILARANG memakai nomor yang sama di setiap transaksi/bulan: ID Pelanggan / IDPEL / ' +
  'No Meter / NOP / No HP / NPWP / No Rekening / No Kartu / No Virtual Account tetap. DILARANG mengarang nomor. Kosongkan hanya kalau benar-benar tidak ada.';

// Baca ulang terfokus: HANYA mencari nomor transaksi (teks ATAU gambar). Gratis dulu, berbayar bila gagal.
function bacaNotaFokus_(teks, base64, mime) {
  var prompt = 'Tugasmu HANYA mencari nomor transaksi unik (No Nota) dari dokumen ' + (teks ? 'teks berikut' : 'gambar ini') + '. ' +
    'Balas HANYA JSON: {"noNota": "<nomor>", "jenisNomor": "<label nomor, mis. No Pesanan / No Invoice / NTPN>"}\n' + PROMPT_ATURAN_NO_NOTA_ +
    (teks ? '\n\n=== TEKS DOKUMEN ===\n' + String(teks).slice(0, 12000) : '');
  var valid = function (x) {
    if (!x || typeof x !== 'object') return 'Balasan bukan objek JSON';
    var n = finNotaBersih_(x.noNota);
    if (!n || /^(-|NULL|NONE|TIDAK ADA|N\/A|KOSONG)$/.test(n)) return 'No Nota tidak ditemukan';
    return '';
  };
  var h = teks ? aiTeksBertingkat_('No Nota (teks)', prompt, valid) : ocrVisionBertingkat_('No Nota (gambar)', base64, mime, prompt, valid);
  return { noNota: finNotaBersih_(h.parsed.noNota), jenisNomor: String(h.parsed.jenisNomor || '').trim().slice(0, 40), model: h.model, tahap: h.tahap };
}

// Smart Paste Biaya Operasional (TEKS): AI mengekstrak nominal, tanggal, kategori & No Nota (WAJIB).
// hanyaNota = true -> parser lokal di browser sudah mengisi field lain, AI cukup mencari No Nota.
function prosesBacaTeksBiayaAI(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var teks = String(data.teks || '').replace(/\u00a0/g, ' ').trim().slice(0, 12000);
    if (teks.length < 10) throw new Error('Teks terlalu pendek');
    var nota = '', jenisNomor = '', parsed = {}, hasilAI = null;
    if (!data.hanyaNota) {
      var daftarKategori = finDaftarKategori_().map(function (k) { return k.akun; });
      var prompt = 'Ini teks yang di-copy dari nota / struk / invoice / bukti transfer / bukti bayar biaya operasional bisnis. ' +
        'Kembalikan HANYA JSON (tanpa markdown) dengan format persis: ' +
        '{"jumlah": <angka total yang DIBAYAR dalam Rupiah tanpa titik/koma>, "tanggal": "<yyyy-MM-dd tanggal transaksi/pembayaran, kosongkan kalau tidak ada>", ' +
        '"noNota": "<WAJIB - nomor UNIK transaksi ini>", "jenisNomor": "<label nomor yang dipakai>", ' +
        '"pajakPenghasilan": <true kalau bukti setor/bayar PPh, selain itu false>, ' +
        '"kategoriBiaya": "<pilih salah satu PERSIS dari: ' + daftarKategori.join(', ') + '>", "keterangan": "<ringkasan singkat: nama toko/penjual & jenis pembelian>"}\n' +
        PROMPT_ATURAN_NO_NOTA_ + '\n' +
        'ATURAN PAJAK: bukti setor PPh (PPh Final UMKM, PPh 21/23/25/29, e-Billing DJP, NTPN, akun 411128/411125/411126/411121) -> pajakPenghasilan true dan kategoriBiaya "' + FIN_AKUN_PAJAK_PH + '".\n\n' +
        '=== TEKS ===\n' + teks;
      hasilAI = aiTeksBertingkat_('Teks Biaya', prompt, function (x) {
        if (!x || typeof x !== 'object' || Array.isArray(x)) return 'Balasan bukan objek JSON';
        if (!(ocrAngka_(x.jumlah) > 0)) return 'Nominal tidak terbaca';
        return '';
      });
      parsed = hasilAI.parsed;
      result.jumlah = ocrAngka_(parsed.jumlah) || 0;
      result.tanggal = /^\d{4}-\d{2}-\d{2}$/.test(String(parsed.tanggal || '')) ? String(parsed.tanggal) : '';
      result.kategoriBiaya = daftarKategori.indexOf(parsed.kategoriBiaya) !== -1 ? parsed.kategoriBiaya : 'Beban Operasional Lain';
      var teksPajak = [parsed.keterangan, parsed.jenisNomor, parsed.kategoriBiaya].join(' ');
      if (parsed.pajakPenghasilan === true || /\bpph\b|pajak\s*penghasilan|\bntpn\b|41112[1568]/i.test(teksPajak)) result.kategoriBiaya = FIN_AKUN_PAJAK_PH;
      result.keterangan = String(parsed.keterangan || '').trim().slice(0, 300);
      nota = finNotaBersih_(parsed.noNota);
      if (/^(-|NULL|NONE|TIDAK ADA|N\/A|KOSONG)$/.test(nota)) nota = '';
      jenisNomor = String(parsed.jenisNomor || '').trim().slice(0, 40);
      result.modelAI = hasilAI.model; result.tahapAI = hasilAI.tahap; result.alasanFallback = hasilAI.alasanFallback;
    }
    if (!nota) {
      try {
        var fokus = bacaNotaFokus_(teks, null, null);
        nota = fokus.noNota; jenisNomor = fokus.jenisNomor || jenisNomor;
        if (!result.modelAI) { result.modelAI = fokus.model; result.tahapAI = fokus.tahap; }
      } catch (eFokus) { /* lanjut ke sidik dokumen */ }
    }
    // Benar-benar tidak ada nomor transaksi di teks -> SIDIK DOKUMEN deterministik dari isi teks:
    // teks yang sama persis = sidik sama (terdeteksi dobel), teks nota lain = sidik beda (tidak dianggap dobel
    // hanya karena nominal / tanggalnya sama).
    if (!nota) {
      var normal = teks.toUpperCase().replace(/\s+/g, ' ').trim();
      var dig = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, normal, Utilities.Charset.UTF_8);
      nota = 'DOC-' + dig.slice(0, 5).map(function (b) { var v = (b < 0 ? b + 256 : b).toString(16); return v.length < 2 ? '0' + v : v; }).join('').toUpperCase();
      jenisNomor = 'Sidik dokumen (otomatis)';
      result.notaOtomatis = true;
    }
    result.noNota = nota;
    result.jenisNomor = jenisNomor;
    result.success = true;
  } catch (err) {
    result.error = String(err.message || err).replace(/^Error:\s*/, '');
  }
  return result;
}

/* ===== SMART PASTE SUPPLIER: dari URL website (diambil server) atau teks halaman Kontak =====
   Mengembalikan saran isian (bukan langsung disimpan): nama, website, WA, telepon, email, alamat, dll. */
function spsBersihkanHtml_(html) {
  return String(html || '')
    .replace(/<script[\s\S]*?<\/script>/gi, ' ').replace(/<style[\s\S]*?<\/style>/gi, ' ').replace(/<noscript[\s\S]*?<\/noscript>/gi, ' ')
    .replace(/<svg[\s\S]*?<\/svg>/gi, ' ').replace(/<!--[\s\S]*?-->/g, ' ')
    .replace(/<(br|\/p|\/div|\/li|\/h[1-6]|\/tr)[^>]*>/gi, '\n').replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/gi, ' ').replace(/&amp;/gi, '&').replace(/&quot;/gi, '"').replace(/&#39;|&apos;/gi, "'").replace(/&lt;/gi, '<').replace(/&gt;/gi, '>')
    .replace(/[ \t\r\f\v]+/g, ' ').replace(/\n\s*\n+/g, '\n').trim();
}
function spsSinyalHtml_(html) {
  var h = String(html || ''), s = [];
  var ambil = function (re) { var m = h.match(re); return m ? m[1].trim() : ''; };
  var judul = ambil(/<title[^>]*>([\s\S]*?)<\/title>/i);
  if (judul) s.push('Judul halaman: ' + judul.replace(/\s+/g, ' '));
  var og = ambil(/<meta[^>]+property=["']og:site_name["'][^>]+content=["']([^"']+)/i) || ambil(/<meta[^>]+content=["']([^"']+)["'][^>]+property=["']og:site_name["']/i);
  if (og) s.push('Nama situs: ' + og);
  var desk = ambil(/<meta[^>]+name=["']description["'][^>]+content=["']([^"']+)/i) || ambil(/<meta[^>]+content=["']([^"']+)["'][^>]+name=["']description["']/i);
  if (desk) s.push('Deskripsi: ' + desk);
  var unik = function (arr) { var o = {}; return arr.filter(function (x) { x = String(x || '').trim(); if (!x || o[x]) return false; o[x] = 1; return true; }); };
  var tel = unik((h.match(/href=["']tel:([^"']+)/gi) || []).map(function (x) { return decodeURIComponent(x.replace(/^href=["']tel:/i, '')); }));
  if (tel.length) s.push('Link telepon: ' + tel.slice(0, 8).join(', '));
  var wa = unik((h.match(/(?:wa\.me\/|api\.whatsapp\.com\/send\?phone=|whatsapp:\/\/send\?phone=)(\+?\d{8,15})/gi) || []).map(function (x) { return x.replace(/^.*?(\+?\d{8,15})$/, '$1'); }));
  if (wa.length) s.push('Link WhatsApp: ' + wa.slice(0, 8).join(', '));
  var mail = unik((h.match(/mailto:([^"'?\s>]+)/gi) || []).map(function (x) { return x.replace(/^mailto:/i, ''); }));
  if (mail.length) s.push('Link email: ' + mail.slice(0, 5).join(', '));
  var mp = unik((h.match(/https?:\/\/(?:www\.)?(?:shopee\.co\.id|tokopedia\.com|tiktok\.com|lazada\.co\.id|blibli\.com|instagram\.com|facebook\.com)\/[^"'\s<>]{2,80}/gi) || []));
  if (mp.length) s.push('Link toko/sosial: ' + mp.slice(0, 8).join(', '));
  (h.match(/<script[^>]+application\/ld\+json[^>]*>([\s\S]*?)<\/script>/gi) || []).slice(0, 4).forEach(function (blok) {
    var isi = blok.replace(/^<script[^>]*>/i, '').replace(/<\/script>$/i, '').trim();
    if (/Organization|LocalBusiness|Store|PostalAddress|telephone/i.test(isi)) s.push('JSON-LD: ' + isi.replace(/\s+/g, ' ').slice(0, 1500));
  });
  return s.join('\n');
}
function spsAmbilHalaman_(url) {
  var res = fetchHemat(url, {
    muteHttpExceptions: true, followRedirects: true, validateHttpsCertificates: true,
    headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36',
      'Accept': 'text/html,application/xhtml+xml', 'Accept-Language': 'id-ID,id;q=0.9,en;q=0.8' }
  });
  var kode = res.getResponseCode();
  if (kode < 200 || kode >= 300) return { ok: false, kode: kode };
  var html = res.getContentText();
  return { ok: true, kode: kode, html: String(html || '').slice(0, 600000) };
}
function spsNormalUrl_(v) {
  var u = String(v || '').trim();
  if (!u) return '';
  if (!/^https?:\/\//i.test(u)) u = 'https://' + u;
  if (!/^https?:\/\/([a-z0-9-]+\.)+[a-z]{2,}(:\d+)?(\/\S*)?$/i.test(u)) throw new Error('URL website tidak valid');
  if (/^https?:\/\/(localhost|127\.|10\.|192\.168\.|169\.254\.)/i.test(u)) throw new Error('URL tidak diizinkan');
  return u;
}
function spsNormalNoHp_(v) {
  var d = String(v || '').replace(/[^\d+]/g, '').replace(/^\+/, '');
  if (/^0/.test(d)) d = '62' + d.slice(1);
  return d;
}
function prosesSmartPasteSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var teksSumber = '', sumber = 'teks', urlAwal = '';
    if (data.url) {
      urlAwal = spsNormalUrl_(data.url);
      var asal = urlAwal.match(/^(https?:\/\/[^\/]+)/i)[1];
      var kandidat = [urlAwal];
      ['/contact', '/kontak', '/contact-us', '/hubungi-kami', '/about', '/tentang-kami'].forEach(function (p) { if (kandidat.indexOf(asal + p) === -1) kandidat.push(asal + p); });
      var bagian = [], berhasil = 0, kodeGagal = [];
      for (var i = 0; i < kandidat.length && berhasil < 3; i++) {
        try {
          var hal = spsAmbilHalaman_(kandidat[i]);
          if (!hal.ok) { if (i === 0) kodeGagal.push(hal.kode); continue; }
          berhasil++;
          var sinyal = spsSinyalHtml_(hal.html);
          var isi = spsBersihkanHtml_(hal.html).slice(0, i === 0 ? 9000 : 5000);
          bagian.push('=== HALAMAN: ' + kandidat[i] + ' ===\n' + sinyal + '\n--- isi ---\n' + isi);
          // Halaman utama sudah memuat kontak lengkap -> tidak perlu membuka halaman lain
          if (i === 0 && /wa\.me|whatsapp|mailto:|tel:/i.test(hal.html) && /alamat|address|jl\.|jalan/i.test(isi)) break;
        } catch (eHal) { if (i === 0) kodeGagal.push(String(eHal.message || eHal).slice(0, 80)); }
      }
      if (!berhasil) throw new Error('Website menolak diakses dari server' + (kodeGagal.length ? ' (' + kodeGagal.join(', ') + ')' : '') +
        '. Buka halaman Kontak/Tentang Kami supplier, tekan Ctrl+A lalu Ctrl+C, dan tempel teksnya di kotak Isi Otomatis.');
      teksSumber = bagian.join('\n\n').slice(0, 20000);
      sumber = 'website';
    } else {
      teksSumber = String(data.teks || '').trim().slice(0, 15000);
      if (teksSumber.length < 15) throw new Error('Teks terlalu pendek');
    }
    var prompt = 'Kamu membantu mengisi formulir KONTAK SUPPLIER untuk sistem ERP toko. Dari ' + (sumber === 'website' ? 'isi website supplier' : 'teks') +
      ' di bawah, ekstrak info supplier dan kembalikan HANYA JSON (tanpa markdown) dengan format persis:\n' +
      '{"nama": "<nama toko/perusahaan supplier, tanpa slogan>", "website": "<URL website utama>", ' +
      '"whatsapp": [{"nomor": "<nomor WA>", "label": "<nama/jabatan/divisi, mis. Admin Penjualan, CS>"}], "telepon": ["<telepon kantor/toko non-WA>"], ' +
      '"email": "<email utama>", "alamat": "<alamat fisik lengkap>", "kota": "<kota>", "jamOperasional": "<jam buka>", ' +
      '"marketplace": [{"platform": "<Shopee/Tokopedia/TikTok/Instagram/dll>", "url": "<link>"}], "deskripsi": "<1 kalimat: jenis barang yang dijual>"}\n' +
      'ATURAN: hanya pakai data yang TERTULIS di sumber - DILARANG mengarang nomor, email, atau alamat. Field yang tidak ada = string kosong / array kosong. ' +
      'Nomor HP Indonesia (08xx/+628xx/628xx) yang disebut WhatsApp/WA/chat masuk "whatsapp"; nomor HP lain tanpa keterangan juga boleh masuk "whatsapp"; ' +
      'nomor kantor (021/022/031/dll) masuk "telepon". Maksimal 5 nomor WA.\n\n' + teksSumber;
    var hasilAI = aiTeksBertingkat_('Smart Paste Supplier', prompt, function (x) {
      if (!x || typeof x !== 'object' || Array.isArray(x)) return 'Balasan bukan objek JSON';
      if (!String(x.nama || '').trim() && !(x.whatsapp || []).length && !String(x.email || '').trim()) return 'Info supplier tidak ditemukan';
      return '';
    });
    var p = hasilAI.parsed || {};
    var str = function (v, n) { return String(v || '').replace(/\s+/g, ' ').trim().slice(0, n || 200); };
    var wa = [], sudah = {};
    (Array.isArray(p.whatsapp) ? p.whatsapp : []).forEach(function (w) {
      var no = spsNormalNoHp_(w && typeof w === 'object' ? w.nomor : w);
      if (!/^62\d{8,13}$/.test(no) || sudah[no]) return;
      sudah[no] = 1;
      wa.push({ nomor: '+' + no, label: str(w && w.label, 40) });
    });
    var website = str(p.website, 300) || urlAwal;
    if (website && !/^https?:\/\//i.test(website)) website = 'https://' + website;
    result.hasil = {
