// Helper: bikin map SKU -> Nama Produk sekali jalan, biar nggak lookup satu-satu per baris
function buatMapNamaProdukBySku(toko) {
  var sh = getMasterProdukSheet(toko);
  var lastRow = sh.getLastRow();
  var map = {};
  if (lastRow > 1) {
    var vals = sh.getRange(2, 1, lastRow - 1, 2).getValues();
    vals.forEach(function (row) {
      var sku = String(row[0] || '').trim();
      if (sku) map[sku] = String(row[1] || '').trim();
    });
  }
  return map;
}

