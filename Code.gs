      try { var shM = getMasterProdukSheet(), lrM = shM.getLastRow(); if (lrM > 1) shM.getRange(2, 1, lrM - 1, 1).getValues().forEach(function (r) { var s = String(r[0] || '').trim().toUpperCase(); if (s) master[s] = true; }); } catch (eM) { }
      var header = [], detail = [], ledger = [], laporan = { baru: 0, duplikat: [], gantiNomor: [], error: [], skuLuarMaster: {}, tanggalPaling: '' };
      var pembeliBaru = [];
