function prosesSimpanKontakKurir(data) {
  var namaKurir, namaAgen, noHp;
  return withTransaction(data.email, null, 'pengiriman', function () {
    var result = { success: false };
    // daftarJasaKirim: array dari checkbox yang dicentang saat disimpan (opsional)
    var daftarJasaKirimStr = Array.isArray(data.daftarJasaKirim) ? data.daftarJasaKirim.join(',') : null;

    var sh = getKontakKurirSheet();
    var lastRow = sh.getLastRow();

    if (data.row) {
      // Mode edit kontak yang sudah ada
      var row = parseInt(data.row, 10);
      if (row > 1 && row <= lastRow) {
        sh.getRange(row, 3).setNumberFormat('@');
        // Kalau daftarJasaKirim tidak dikirim (misal dari dialog edit teks biasa), pertahankan nilai lama
        var jasaAkhir = daftarJasaKirimStr !== null ? daftarJasaKirimStr : String(sh.getRange(row, 4).getValue() || '');
        sh.getRange(row, 1, 1, 4).setValues([[namaKurir, namaAgen, noHp, jasaAkhir]]);
        result.success = true;
        result.row = row;
        return result;
      }
    }

    // Cek duplikat (nama sama persis) sebelum nambah baru
    if (lastRow > 1) {
      var existing = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < existing.length; i++) {
        if (String(existing[i][0]).trim().toLowerCase() === namaKurir.toLowerCase()) {
          throw new Error('Nama kurir ini sudah tersimpan sebelumnya.');
        }
      }
    }

    var newRow = sh.getLastRow() + 1;
    sh.getRange(newRow, 3).setNumberFormat('@');
    sh.getRange(newRow, 1, 1, 4).setValues([[namaKurir, namaAgen, noHp, daftarJasaKirimStr || '']]);
    result.success = true;
    result.row = sh.getLastRow();
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.',
    validasi: function () {
      namaKurir = String(data.namaKurir || '').trim();
      namaAgen = String(data.namaAgen || '').trim();
      noHp = String(data.noHp || '').trim();
      if (!namaKurir) throw new Error('Nama kurir kosong');
    }
  });
}

function prosesHapusKontakKurir(data) {
  var row;
  return withTransaction(data.email, null, 'pengiriman', function () {
    var result = { success: false };
    var sh = getKontakKurirSheet();
    if (row > sh.getLastRow()) throw new Error('Data sudah tidak ada');
    sh.deleteRow(row);
