}

function mkTarikTiktok_(dariDetik, sampaiDetik, tz, batasWaktu) {
  var baris = [], info = { statement: 0, payment: 0 }, contohDicatat = false;
  // 1) Statements: dana penjualan yang di-settle ke saldo penjual (dipecah: pendapatan, biaya, penyesuaian)
  var token = '', putaran = 0;
  do {
    var r = mkTiktokGet_('/finance/202309/statements', { statement_time_ge: dariDetik, statement_time_lt: sampaiDetik, page_size: 100, page_token: token, sort_field: 'statement_time', sort_order: 'ASC' });
    if (!r.ok) throw new Error('TikTok statements: ' + r.pesan);
    var list = r.data.statements || [];
    if (!contohDicatat && list.length) { mkLogMp_('TikTok statements', JSON.stringify(list.slice(0, 2))); contohDicatat = true; }
    list.forEach(function (s) {
      var waktu = Utilities.formatDate(new Date(parseInt(s.statement_time, 10) * 1000), tz, 'yyyy-MM-dd HH:mm');
      var settle = mkNilai_(s.settlement_amount), rev = mkNilai_(s.revenue_amount), fee = mkNilai_(s.fee_amount);
      var sisa = Math.round((settle - rev - fee) * 100) / 100;
      var ket = 'Settlement ' + (s.id || '') + (s.payment_status ? ' (' + s.payment_status + ')' : '');
      if (rev) baris.push(['TTS-ST-' + s.id + '-R', waktu, 'Saldo TikTok Shop', 'TikTok Shop', 'Pendapatan penjualan · ' + ket, rev > 0 ? rev : '', rev < 0 ? -rev : '', '', '', String(s.id || ''), '', '', '', 'op_terima']);
      if (fee) baris.push(['TTS-ST-' + s.id + '-F', waktu, 'Saldo TikTok Shop', 'TikTok Shop', 'Biaya & komisi TikTok · ' + ket, fee > 0 ? fee : '', fee < 0 ? -fee : '', '', '', String(s.id || ''), '', '', '', 'op_marketplace']);
      if (sisa) baris.push(['TTS-ST-' + s.id + '-A', waktu, 'Saldo TikTok Shop', 'TikTok Shop', 'Penyesuaian / ongkir · ' + ket, sisa > 0 ? sisa : '', sisa < 0 ? -sisa : '', '', '', String(s.id || ''), '', '', '', sisa > 0 ? 'op_lain_masuk' : 'op_marketplace']);
      if (!rev && !fee && settle) baris.push(['TTS-ST-' + s.id, waktu, 'Saldo TikTok Shop', 'TikTok Shop', 'Dana penjualan · ' + ket, settle > 0 ? settle : '', settle < 0 ? -settle : '', '', '', String(s.id || ''), '', '', '', 'op_terima']);
      info.statement++;
    });
    token = r.data.next_page_token || '';
    putaran++;
  } while (token && putaran < 50 && Date.now() < batasWaktu);
  // 2) Payments: dana dikirim dari saldo TikTok ke rekening bank (transfer antar akun sendiri)
  token = ''; putaran = 0; contohDicatat = false;
  do {
    var p = mkTiktokGet_('/finance/202309/payments', { create_time_ge: dariDetik, create_time_lt: sampaiDetik, page_size: 100, page_token: token, sort_field: 'create_time', sort_order: 'ASC' });
    if (!p.ok) { info.paymentError = p.pesan; break; }
    var pl = p.data.payments || [];
    if (!contohDicatat && pl.length) { mkLogMp_('TikTok payments', JSON.stringify(pl.slice(0, 2))); contohDicatat = true; }
    pl.forEach(function (x) {
      if (String(x.status || '').toUpperCase() !== 'PAID') return;
      var w = parseInt(x.paid_time || x.create_time, 10);
      var jml = Math.abs(mkNilai_(x.amount) || mkNilai_(x.settlement_amount));
      if (!jml || !w) return;
      baris.push(['TTS-PY-' + x.id, Utilities.formatDate(new Date(w * 1000), tz, 'yyyy-MM-dd HH:mm'), 'Saldo TikTok Shop', 'TikTok Shop',
        'Dana dikirim ke rekening' + (x.bank_account ? ' ' + x.bank_account : '') + ' · ' + x.id, '', jml, '', '', String(x.id || ''), '', '', '', 'transfer']);
      info.payment++;
    });
    token = p.data.next_page_token || '';
    putaran++;
  } while (token && putaran < 50 && Date.now() < batasWaktu);
  return { baris: baris, info: info };
}

function mkTarikShopee_(dariDetik, sampaiDetik, tz, batasWaktu) {
  var kred = ambilKredensialShopee();
  if (!kred || !kred.accessToken) throw new Error('Shopee belum terhubung');
  var baris = [], n = 0, contohDicatat = false;
  for (var awal = dariDetik; awal < sampaiDetik && Date.now() < batasWaktu; awal += 14 * 86400) {
    var akhir = Math.min(sampaiDetik, awal + 14 * 86400);
    for (var hal = 0; hal < 100 && Date.now() < batasWaktu; hal++) {
      var r = shopeeGet_('/api/v2/payment/get_wallet_transaction_list', { page_no: hal, page_size: 100, create_time_from: awal, create_time_to: akhir }, kred);
      if (!r.ok) throw new Error('Shopee wallet: ' + (r.pesan || r.error));
      var resp = (r.json && r.json.response) || {};
      var list = resp.transaction_list || [];
      if (!contohDicatat && list.length) { mkLogMp_('Shopee wallet', JSON.stringify(list.slice(0, 2))); contohDicatat = true; }
      list.forEach(function (x) {
        var amt = mkNilai_(x.amount), tipe = String(x.transaction_type || x.transaction_tab_type || '').toUpperCase();
        if (amt > 0 && /WITHDRAW/.test(tipe)) amt = -amt;
        if (!amt) return;
        var teksKomp = (tipe + ' ' + String(x.description || x.reason || '')).toUpperCase();
        var kat = /WITHDRAW/.test(tipe) ? 'transfer' : (amt > 0 && /COMPENSAT|KOMPENSASI|CLAIM|KLAIM|INSURANCE|ASURANSI|LOST|HILANG/.test(teksKomp)) ? 'op_kompensasi' : /ESCROW|ORDER|INCOME/.test(tipe) ? (amt > 0 ? 'op_terima' : 'op_refund') : /ADS|FEE|CHARGE|PAID_ADS|SERVICE/.test(tipe) ? 'op_marketplace' : /REFUND|RETURN/.test(tipe) ? 'op_refund' : '';
        var ket = (x.description || x.reason || tipe || 'Transaksi dompet') + (x.order_sn ? ' · ' + x.order_sn : '');
        baris.push(['SHP-' + (x.transaction_id || (x.create_time + '-' + amt)), Utilities.formatDate(new Date(parseInt(x.create_time, 10) * 1000), tz, 'yyyy-MM-dd HH:mm'),
          'Saldo Shopee', 'Shopee', String(ket).slice(0, 250), amt > 0 ? amt : '', amt < 0 ? -amt : '', x.current_balance !== undefined ? mkNilai_(x.current_balance) : '', '', String(x.order_sn || x.transaction_id || ''), '', '', '', kat]);
        n++;
      });
      if (!resp.more) break;
    }
  }
  return { baris: baris, info: { transaksi: n } };
}

// ===== AKSI: fin_sinkron_marketplace { hariMundur? } - tarik saldo & mutasi TikTok Shop + Shopee =====
function prosesFinSinkronMarketplace(data) {
  var result = { success: false, hasil: {} };
  if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  var mutex = kunciSinkronAmbil_('FIN_MP');
  if (!mutex) return { success: true, sedangJalan: true, pesan: 'Sinkron marketplace sedang berjalan di proses lain.' };
  try {
    var tz = Session.getScriptTimeZone(), props = PropertiesService.getScriptProperties();
    var st = {}; try { st = JSON.parse(props.getProperty('FIN_MP_STATUS') || '{}') || {}; } catch (e) { }
    var sekarang = Math.floor(Date.now() / 1000), batasWaktu = Date.now() + 4 * 60 * 1000;
    var peng = finPengaturan_();
    var awalBuku = peng.tanggalMulai ? Math.floor(Utilities.parseDate(peng.tanggalMulai, tz, 'yyyy-MM-dd').getTime() / 1000) : sekarang - 90 * 86400;
    var hariMundur = Math.min(365, Math.max(1, parseInt(data.hariMundur, 10) || 0));
    function mulaiDari(kunci) {
      if (data.hariMundur) return sekarang - hariMundur * 86400;
      var terakhir = st[kunci] && st[kunci].sampai ? st[kunci].sampai - 3 * 86400 : 0; // tumpang tindih 3 hari: settlement bisa menyusul
      return Math.max(terakhir || Math.max(awalBuku, sekarang - 180 * 86400), sekarang - 365 * 86400);
    }
    var semuaBaris = [];
    [['tiktok', 'TikTok Shop', mkTarikTiktok_], ['shopee', 'Shopee', mkTarikShopee_]].forEach(function (s) {
      var dari = mulaiDari(s[0]);
      try {
        var h = s[2](dari, sekarang, tz, batasWaktu);
        semuaBaris = semuaBaris.concat(h.baris);
        st[s[0]] = { ok: true, waktu: Date.now(), dari: dari, sampai: sekarang, info: h.info, pesan: '' };
        result.hasil[s[1]] = { ok: true, baris: h.baris.length, info: h.info };
      } catch (eS) {
        var pesan = String(eS.message || eS).replace(/^Error:\s*/, '');
        st[s[0]] = { ok: false, waktu: Date.now(), pesan: pesan, sampai: st[s[0]] && st[s[0]].sampai };
        result.hasil[s[1]] = { ok: false, pesan: pesan };
      }
    });
    // Tulis baris baru (ID unik -> tidak dobel); kategori otomatis hanya untuk baris baru
    var baru = 0;
    if (semuaBaris.length) {
      var lock = kunciModul_('mutasi_kas');
      lock.waitLock(20000);
      try {
        var sh = getMutasiKasSheet_(), lr = sh.getLastRow(), ada = {};
        if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r) { ada[String(r[0])] = 1; });
        var oleh = 'Sinkron otomatis', waktu = new Date(), tulis = [];
        semuaBaris.forEach(function (b) {
          if (ada[b[0]]) return; ada[b[0]] = 1;
          var kat = b[13] || '';
          tulis.push([b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], kat, b[9], '', waktu, oleh]);
        });
        tulis.sort(function (a, b) { return a[1] < b[1] ? -1 : a[1] > b[1] ? 1 : 0; });
        if (tulis.length) sh.getRange(lr + 1, 1, tulis.length, MK_HEADER.length).setValues(tulis);
        baru = tulis.length;
        SpreadsheetApp.flush();
      } finally { lepasKunci_(lock); }
      mkInvalidasi_();
    }
    props.setProperty('FIN_MP_STATUS', JSON.stringify(st));
    result.baru = baru;
    result.mpStatus = st;
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  finally { try { kunciSinkronLepas_('FIN_MP', mutex); } catch (eL) { } }
  return result;
}
// Untuk trigger harian (opsional): pasang time-driven trigger ke fungsi ini
function sinkronMutasiMarketplaceOtomatis() { return prosesFinSinkronMarketplace({ dariSistem: true }); }

// ----- LAPORAN ARUS KAS RIIL (dari mutasi yang sudah dikategorikan) -----
function finArusKasRiil_(dari, sampai) {
  var semua = mkUrut_(mkBacaSemua_());
  if (!semua.length) return null;
  var per = {}, akun = {}, belum = { n: 0, masuk: 0, keluar: 0 }, abaikan = 0, transfer = 0;
  semua.forEach(function (r) {
    var tgl = r.t.slice(0, 10), a = akun[r.akun] || (akun[r.akun] = { akun: r.akun, sumber: r.sumber, adaSaldo: false, awal: 0, akhir: 0, awalDiketahui: false, lastSebelum: null, firstDalam: null, lastDalam: null, hitungSebelum: 0, hitungSampai: 0 });
    var net = r.masuk - r.keluar;
    if (r.saldo !== null) a.adaSaldo = true;
    if (tgl < dari) { a.hitungSebelum += net; if (r.saldo !== null) a.lastSebelum = r; }
    if (tgl <= sampai) { a.hitungSampai += net; if (r.saldo !== null) a.lastSampai = r; }
    if (tgl < dari || tgl > sampai) return;
    if (r.saldo !== null && !a.firstDalam) a.firstDalam = r;
    if (!r.kat) { belum.n++; belum.masuk += r.masuk; belum.keluar += r.keluar; return; }
    if (r.kat === 'abaikan') { abaikan += net; return; }
    if (r.kat === 'transfer') { transfer += net; return; }
    per[r.kat] = (per[r.kat] || 0) + net;
  });
  var daftarAkun = Object.keys(akun).map(function (k) {
    var a = akun[k], awal, akhir, sumberSaldo;
    if (a.adaSaldo) {
      awal = a.lastSebelum ? a.lastSebelum.saldo : (a.firstDalam ? a.firstDalam.saldo - (a.firstDalam.masuk - a.firstDalam.keluar) : (a.lastSampai ? a.lastSampai.saldo : 0));
      akhir = a.lastSampai ? a.lastSampai.saldo : awal;
      sumberSaldo = 'saldo';
    } else { awal = a.hitungSebelum; akhir = a.hitungSampai; sumberSaldo = 'hitung'; }
    return { akun: a.akun, sumber: a.sumber, awal: awal, akhir: akhir, metode: sumberSaldo };
  });
  function grup(g) {
    return mkDaftarKategori_().filter(function (k) { return k.grup === g && per[k.k]; }).map(function (k) { return { kode: k.k, nama: k.label, nilai: per[k.k] }; });
  }
  var op = grup('op'), inv = grup('inv'), fin = grup('fin');
  function jml(a) { return a.reduce(function (t, x) { return t + x.nilai; }, 0); }
  var kasAwal = daftarAkun.reduce(function (t, a) { return t + a.awal; }, 0), kasAkhir = daftarAkun.reduce(function (t, a) { return t + a.akhir; }, 0);
  var totOp = jml(op), totInv = jml(inv), totFin = jml(fin), nBelum = belum.masuk - belum.keluar;
  return {
    akun: daftarAkun, operasi: op, totalOperasi: totOp, investasi: inv, totalInvestasi: totInv, pendanaan: fin, totalPendanaan: totFin,
    transfer: transfer, abaikan: abaikan, belum: { n: belum.n, net: nBelum, masuk: belum.masuk, keluar: belum.keluar },
    kenaikan: totOp + totInv + totFin, kasAwal: kasAwal, kasAkhir: kasAkhir,
    selisih: Math.round((kasAkhir - kasAwal - (totOp + totInv + totFin + transfer + abaikan + nBelum)) * 100) / 100
  };
}


