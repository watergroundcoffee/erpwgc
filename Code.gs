function finPetaTglPesanan_(tz) {
  var peta = {}, ss = SpreadsheetApp.getActiveSpreadsheet();
  ['Pesanan Shopee', 'Pesanan TikTok Shop', 'Pesanan Conner', 'Pesanan Manual', 'Pesanan Website'].forEach(function (nm) {
    try {
      var sh = ss.getSheetByName(nm); if (!sh || sh.getLastRow() < 2) return;
      sh.getRange(2, 1, sh.getLastRow() - 1, 2).getValues().forEach(function (r) {
        var k = kunciResi_(r[0]); if (!k) return;
        var d = r[1];
        if (!(d instanceof Date)) { var x = new Date(String(d || '').replace(',', '')); if (isNaN(x.getTime())) return; d = x; }
        var t = finTglStr_(d, tz);
        if (!peta[k] || t < peta[k]) peta[k] = t;
      });
    } catch (e) { }
  });
  return peta;
}
// No pesanan dari keterangan Stock Ledger ("... Order 2611...", "[INV:...]", "discan keluar (INV)", "backdate) INV ...")
function finTglPesananLedger_(ket, peta) {
  var k = String(ket || ''); if (!k || !peta) return '';
  var calon = [], m;
  if ((m = k.match(/order\s+([A-Za-z0-9\-_]+)/i))) calon.push(m[1]);
  if ((m = k.match(/\[INV:([^\]]+)\]/))) calon.push(m[1]);
  if ((m = k.match(/discan keluar \(([^)]+)\)/))) calon.push(m[1]);
  if ((m = k.match(/backdate\)\s+(\S+)/))) calon.push(m[1]);
  if ((m = k.match(/pesanan\s+([A-Za-z0-9\-_\/]+)/i))) calon.push(m[1]);
  if ((m = k.match(/\(([A-Za-z0-9\-_\/]{5,})\)/))) calon.push(m[1]);
  for (var i = 0; i < calon.length; i++) { var t = peta[kunciResi_(calon[i])]; if (t) return t; }
  return '';
}
function finValidTgl_(s) { return /^\d{4}-\d{2}-\d{2}$/.test(String(s || '')); }
function finGeserHari_(s, n) {
  var tz = Session.getScriptTimeZone();
  var d = Utilities.parseDate(s, tz, 'yyyy-MM-dd');
  return finTglStr_(new Date(d.getTime() + n * 86400000 + 12 * 3600000), tz);
}
function finParseTanggalInput_(s) {
  var tz = Session.getScriptTimeZone();
  if (!finValidTgl_(s)) return new Date();
  var d = Utilities.parseDate(s, tz, 'yyyy-MM-dd');
  return new Date(d.getTime() + 12 * 3600000); // tengah hari -> aman dari geser zona waktu
}
function finAngka_(v) { var n = parseFloat(v); return isFinite(n) ? n : 0; }

function finPengaturan_() {
  var p = {};
  try { p = JSON.parse(PropertiesService.getScriptProperties().getProperty('FIN_PENGATURAN') || '{}') || {}; } catch (e) { p = {}; }
  function tempo(v) { var n = Math.round(finAngka_(v)); return n > 0 ? Math.min(n, 180) : 0; }
  return {
    tanggalMulai: finValidTgl_(p.tanggalMulai) ? p.tanggalMulai : '',
    kasAwal: finAngka_(p.kasAwal),
    piutangAwal: Math.max(0, finAngka_(p.piutangAwal)),
    persediaanAwal: finAngka_(p.persediaanAwal),
    utangAwal: Math.max(0, finAngka_(p.utangAwal)),
    tempoMarketplace: tempo(p.tempoMarketplace),
    tempoLain: tempo(p.tempoLain),
    tempoPembelian: tempo(p.tempoPembelian),
    diperbarui: p.diperbarui || '', oleh: p.oleh || ''
  };
}
// Aritmetika tanggal kalender murni (teks yyyy-MM-dd) - bebas zona waktu & cepat (tanpa parseDate)
function finTambahHari_(s, n) {
  var p = String(s).split('-');
  var d = new Date(Date.UTC(+p[0], +p[1] - 1, +p[2] + n));
  return d.getUTCFullYear() + '-' + ('0' + (d.getUTCMonth() + 1)).slice(-2) + '-' + ('0' + d.getUTCDate()).slice(-2);
}
function finAkhirBulan_(tahun, bulan0) {
  var d = new Date(Date.UTC(tahun, bulan0 + 1, 0));
  return d.getUTCFullYear() + '-' + ('0' + (d.getUTCMonth() + 1)).slice(-2) + '-' + ('0' + d.getUTCDate()).slice(-2);
}
function finNominal_(kode) { return String(kode).charAt(0) >= '4'; }
function finKodeUrut_(awalan, idx) { return awalan + ('0' + idx).slice(-2); }
function finInvalidasi_() {
  try { CacheService.getScriptCache().remove(FIN_CACHE_KUNCI + '__meta'); } catch (e) { }
  finInvalidasiLaporan_();
}
// Versi hasil laporan jadi (dipakai sebagai bagian kunci cache laporan). Dinaikkan saat data yang
// TIDAK ada di cache data harian berubah (mis. kategori Mutasi Kas -> Arus Kas Riil).
function finLapVersi_() {
  try { return CacheService.getScriptCache().get('FIN_LAP_VER') || '0'; } catch (e) { return '0'; }
}
function finInvalidasiLaporan_() {
  try { CacheService.getScriptCache().put('FIN_LAP_VER', String(Date.now()) + Math.floor(Math.random() * 1000), 21600); } catch (e) { }
}
// Tambal cache data keuangan setelah biaya dicatat / diedit / dihapus -> laporan berikutnya TIDAK perlu
// membaca ulang seluruh Stock Ledger, Pembelian, dll (inilah yang dulu membuat Dashboard lama).
// rowHapus: baris lama yang dibuang dari hitungan; baru: { tanggal(Date), akun, jumlah, ket, row }
// Rembes berubah (nama penalang / status dibayar) -> tambal info rembes di cache tanpa membangun ulang data
function finPatchRembes_(rows, nama, status) {
  try {
    var D = cacheBesarGet_(FIN_CACHE_KUNCI);
    if (!D || !D.biayaList) { finInvalidasiLaporan_(); return; }
    var set = {}; (rows || []).forEach(function (r) { set[r] = 1; });
    var nm = finNamaRembes_(nama), tglBayar = finTglRembesDibayar_(status), kena = 0;
    D.biayaList.forEach(function (b) {
      if (!set[b.row]) return;
      kena++;
      if (nm) { b.rb = nm; b.rbt = tglBayar; } else { delete b.rb; delete b.rbt; }
    });
    if (!kena) { finInvalidasi_(); return; }
    D.versi = (D.versi || 0) + 1;
    if (!cacheBesarPut_(FIN_CACHE_KUNCI, D, FIN_CACHE_DETIK)) finInvalidasi_();
    else finInvalidasiLaporan_();
  } catch (e) { finInvalidasi_(); }
}
function finPatchBiaya_(rowHapus, baru) {
  try {
    var D = cacheBesarGet_(FIN_CACHE_KUNCI);
    if (!D || !D.hari) { finInvalidasiLaporan_(); return; }
    var list = D.biayaList || (D.biayaList = []);
    if (rowHapus) {
      var idx = -1;
      for (var i = 0; i < list.length; i++) if (list[i].row === rowHapus) { idx = i; break; }
      if (idx === -1) { finInvalidasi_(); return; } // cache versi lama (tanpa nomor baris) -> bangun ulang saja
      var lama = list[idx], h = D.hari[lama.t];
      if (h && h.x && h.x[lama.a] !== undefined) { h.x[lama.a] -= lama.v; if (Math.abs(h.x[lama.a]) < 0.5) delete h.x[lama.a]; }
      list.splice(idx, 1);
    }
    if (baru) {
      var t = finTglStr_(baru.tanggal), a = finAkunNormal_(baru.akun);
      var slot = D.hari[t] || (D.hari[t] = { o: {}, h: 0, r: 0, b: 0, x: {}, l: 0 });
      slot.x[a] = (slot.x[a] || 0) + baru.jumlah;
      var nb = { t: t, a: a, v: baru.jumlah, ket: String(baru.ket || '').slice(0, 90), s: 'Biaya Operasional', row: baru.row };
      if (baru.rembesOleh) { nb.rb = finNamaRembes_(baru.rembesOleh); nb.rbt = finTglRembesDibayar_(baru.statusRembes); }
      list.push(nb);
      if (!D.tglPertama || t < D.tglPertama) D.tglPertama = t;
    }
    D.versi = (D.versi || 0) + 1;
    if (!cacheBesarPut_(FIN_CACHE_KUNCI, D, FIN_CACHE_DETIK)) finInvalidasi_();
    else finInvalidasiLaporan_();
  } catch (e) { finInvalidasi_(); }
}

// Pastikan rekap penjualan ada & tidak terlalu usang (trigger 10 menit biasanya sudah menjaga ini)
function finPastikanRekap_(paksa) {
  var props = PropertiesService.getScriptProperties();
  try { pastikanTriggerRekapBeranda_(); } catch (e) { }
  var t = Number(props.getProperty('REKAP_BERANDA_DIPERBARUI') || 0);
  try {
    if (!t) rekapBerandaPerbarui_(0);
    else if (paksa || Date.now() - t > 10 * 60 * 1000) rekapBerandaPerbarui_(2); // data omzet hari ini maks ~10 menit
  } catch (e) { Logger.log('finPastikanRekap_: ' + e); }
  return Number(props.getProperty('REKAP_BERANDA_DIPERBARUI') || 0);
}

// Baca semua sumber data SEKALI lalu ringkas per HARI (kecil, bisa di-cache)
function finBangunData_(paksa, lewatiRekap) {
  if (!paksa) {
    var c = cacheBesarGet_(FIN_CACHE_KUNCI);
    if (c && c.hari && c.jualSku) { // HPP selalu dihitung ulang dari Harga Modal & pemetaan SKU TERBARU
      var sigLama = c.hppSig;
      finTerapkanHpp_(c, false);
      if (c.hppSig !== sigLama) { try { cacheBesarPut_(FIN_CACHE_KUNCI, c, FIN_CACHE_DETIK); } catch (eP) { } }
      return c;
    }
  }
  var tz = Session.getScriptTimeZone();
  var rekapDiperbarui = lewatiRekap ? Number(PropertiesService.getScriptProperties().getProperty('REKAP_BERANDA_DIPERBARUI') || 0) : finPastikanRekap_(paksa);
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var hari = {};
  function slot(t) { return hari[t] || (hari[t] = { o: {}, h: 0, r: 0, b: 0, x: {}, l: 0 }); }

  // 1) Omzet per hari per kanal (non-batal)
  var shR = ss.getSheetByName(REKAP_SHEET_HARIAN);
  if (shR && shR.getLastRow() > 1) {
    shR.getRange(2, 1, shR.getLastRow() - 1, 4).getValues().forEach(function (r) {
      var t = String(r[0] || ''), kanal = String(r[1] || '');
      if (!finValidTgl_(t) || !kanal || kanal === '_HARI') return;
      var o = slot(t).o, k = o[kanal] || (o[kanal] = [0, 0]);
      k[0] += finAngka_(r[2]); k[1] += finAngka_(r[3]);
    });
  }

  // 2) Tarif potongan marketplace per kanal
  var tarif = {};
  try {
    var shBP = getBiayaPenjualanSheet();
    if (shBP.getLastRow() > 1) shBP.getRange(2, 1, shBP.getLastRow() - 1, 4).getValues().forEach(function (r) {
      var ch = String(r[0] || '').trim(); if (!ch) return;
      var t = tarif[ch] || (tarif[ch] = { persen: 0, rupiah: 0 });
      if (String(r[2]).trim() === 'Persen') t.persen += finAngka_(r[3]); else t.rupiah += finAngka_(r[3]);
    });
  } catch (eBP) { }

  // 3) Pembelian (modul Pembelian): biaya per SKU + kas keluar per hari
  var biaya = {}; // sku -> { q, v }
  var sumberBiaya = {}; // sku -> 'pembelian' | 'produksi' | 'master'
  function tambahBiaya(sku, q, v, sumber) {
    if (!sku || !(q > 0) || !(v >= 0)) return;
    var b = biaya[sku] || (biaya[sku] = { q: 0, v: 0 });
    b.q += q; b.v += v;
    if (!sumberBiaya[sku] || sumber === 'pembelian') sumberBiaya[sku] = sumber;
  }
  var nPembelian = 0;
  var beliList = [], biayaList = [], lainList = [], nonOps = []; // rincian per transaksi untuk Jurnal Umum
  try {
    var pm = getPembelianManualSheets();
    var infoInv = {};
    if (pm.header.getLastRow() > 1) pm.header.getRange(2, 1, pm.header.getLastRow() - 1, Math.min(13, pm.header.getMaxColumns())).getValues().forEach(function (r) {
      var inv = String(r[0] || '').trim();
      if (!inv || String(r[9] || '').trim() === 'Dibatalkan') return;
      var total = finAngka_(r[6]), ongkir = finAngka_(r[5]) + finAngka_(r[11]); // ongkir + biaya lain = biaya perolehan tambahan
      var barang = total - ongkir + finAngka_(r[12]); // subtotal barang kotor (sebelum diskon supplier) -> faktor = biaya bersih / harga barang
      infoInv[inv] = { faktor: (barang > 0 && total > 0) ? total / barang : 1 };
      if (r[1] instanceof Date && total > 0) {
        var tglB = finTglStr_(r[1], tz);
        slot(tglB).b += total; nPembelian++;
        beliList.push({ t: tglB, inv: inv, sup: String(r[2] || '').trim().slice(0, 60) || '-', v: total });
      }
    });
    if (pm.detail.getLastRow() > 1) pm.detail.getRange(2, 1, pm.detail.getLastRow() - 1, 6).getValues().forEach(function (r) {
      var inv = infoInv[String(r[0] || '').trim()];
      if (!inv) return;
      var sku = resolveSkuJualCepat_(r[1]), q = finAngka_(r[3]), sub = finAngka_(r[5]) || q * finAngka_(r[4]);
      tambahBiaya(sku, q, sub * inv.faktor, 'pembelian');
    });
  } catch (ePM) { Logger.log('Finance: gagal baca Pembelian Manual - ' + ePM); }

  // 4) Stock Ledger (dibaca 1x): biaya hasil produksi + qty terjual & rusak per hari per SKU
  var jual = {}, rusak = {}; // tgl -> { sku: qty }
  var jualKanal = {}; // tgl -> { kanal: { sku: qty } } - dasar HPP per channel (Laporan Penjualan)
  var terakhirJual = {};
  var idTokopedia = finIdPesananTokopedia_();
  var idKanalJual = {}, returBaris = []; // v2026.10.25 (Paket 12): pembalikan HPP barang yang kembali ke stok
  // v2026.10.122 (DN-199 / DN-727): HPP barang terjual dicatat di TANGGAL PESANAN (batas 00:00 WIB), sama dengan omzet.
  // Dulu tanggal baris Stock Ledger yang dipakai -> Manual Order yang discan keluar / ditandai dikirim hari ini, atau pesanan
  // yang baru tertarik belakangan, membawa HPP hari-hari sebelumnya ke "Hari ini".
  var tglPesananFin = {};
  try { tglPesananFin = finPetaTglPesanan_(tz); } catch (eTP) { Logger.log('Finance: peta tanggal pesanan gagal - ' + eTP); }
  try {
    var shL = getStockLedgerSheet();
    if (shL.getLastRow() > 1) {
      var lebar = Math.min(8, shL.getMaxColumns());
      shL.getRange(2, 1, shL.getLastRow() - 1, lebar).getValues().forEach(function (r) {
        var d = r[0]; if (!(d instanceof Date)) return;
        var sku = resolveSkuJualCepat_(r[1]); if (!sku) return;
        var jenis = String(r[2] || ''), q = finAngka_(r[3]);
        if (!(q > 0)) return;
        var t = finTglStr_(d, tz);
        if (jenis.indexOf('Terjual') === 0) {
          var tPes = finTglPesananLedger_(lebar >= 5 ? r[4] : '', tglPesananFin);
          if (tPes && tPes < t) t = tPes;
          var mj = jual[t] || (jual[t] = {}); mj[sku] = (mj[sku] || 0) + q;
          var knL = finKanalLedger_(jenis, lebar >= 5 ? r[4] : '', idTokopedia);
          var hk = jualKanal[t] || (jualKanal[t] = {}), mk = hk[knL] || (hk[knL] = {});
          mk[sku] = (mk[sku] || 0) + q;
          if (!terakhirJual[sku] || t > terakhirJual[sku]) terakhirJual[sku] = t;
          finCatatIdKanal_(lebar >= 5 ? r[4] : '', knL, idKanalJual);
        } else if (jenis === 'Masuk' && finApakahReturStok_(lebar >= 5 ? r[4] : '')) {
          returBaris.push({ t: t, sku: sku, q: q, id: finIdDariKetRetur_(lebar >= 5 ? r[4] : '') });
        } else if (jenis === 'Rusak/Hilang') {
          var mr = rusak[t] || (rusak[t] = {}); mr[sku] = (mr[sku] || 0) + q;
        } else if (jenis === 'Masuk' && String(lebar >= 5 ? r[4] : '').indexOf(MRK_PENANDA_PULIH) === 0) {
          // Klaim Memo Rusak diganti BARANG: membalik beban kerusakan (Dr Persediaan, Cr Beban Kerusakan)
          var mp = rusak[t] || (rusak[t] = {}); mp[sku] = (mp[sku] || 0) - q;
        } else if (jenis === 'Masuk' && lebar >= 8 && finAngka_(r[7]) > 0) {
          tambahBiaya(sku, q, q * finAngka_(r[7]), 'produksi');
        }
      });
    }
  } catch (eL) { Logger.log('Finance: gagal baca Stock Ledger - ' + eL); }
  var returSku = {}, returKanal = {};
  returBaris.forEach(function (x) {
    var mr = returSku[x.t] || (returSku[x.t] = {}); mr[x.sku] = (mr[x.sku] || 0) + x.q;
    var kn = (x.id && idKanalJual[x.id]) || 'Lainnya';
    var hk = returKanal[x.t] || (returKanal[x.t] = {}), mk = hk[kn] || (hk[kn] = {});
    mk[x.sku] = (mk[x.sku] || 0) + x.q;
  });

  // 5) Biaya rata-rata pembelian/produksi per SKU - HANYA cadangan bila Harga Modal di Master Produk kosong.
  //    HPP utama = Harga Modal (kolom "Harga Supplier") per SKU Gudang, dihitung ulang tiap laporan dibuka
  //    lewat finTerapkanHpp_() -> perubahan harga modal langsung terlihat tanpa menunggu cache habis.
  var unitRata = {};
  Object.keys(biaya).forEach(function (s) { if (biaya[s].q > 0) unitRata[s] = biaya[s].v / biaya[s].q; });

  // 6) Biaya operasional, pendapatan lain & transaksi non-operasional dari Jurnal Transaksi (data lama ikut terbaca)
  try {
    var shJ = getJurnalTransaksiSheet();
    if (shJ.getLastRow() > 1) {
      var lebarJ = Math.min(13, shJ.getMaxColumns());
      var namaOwnerJ = finNamaOwner_();
      shJ.getRange(2, 1, shJ.getLastRow() - 1, lebarJ).getValues().forEach(function (r, iJ) {
        var d = r[0]; if (!(d instanceof Date)) return;
        if (String(r[3] || '').trim() !== 'Masuk') return;
        var akun = String(r[1] || '').trim(), kat = String(r[2] || '').trim(), jml = finAngka_(r[4]);
        if (!(jml > 0)) return;
        var t = finTglStr_(d, tz), sumberJ = String(r[6] || '').trim();
        var ketJ = String(r[5] || '').trim().slice(0, 90);
        if (sumberJ === FIN_SUMBER_NONOPS) {
          var info = {};
          try { info = JSON.parse(String((lebarJ >= 9 ? r[8] : '') || '{}')) || {}; } catch (eI) { info = {}; }
          var jenisN = FIN_NONOPS_JENIS[info.j] ? info.j : finNonOpsDariAkun_(akun);
          if (!jenisN) return;
          nonOps.push({ row: iJ + 2, t: t, j: jenisN, v: Math.round(jml), ket: ketJ, u: Math.round(finAngka_(info.u)) || 0, g: String(info.g || ('r' + (iJ + 2))) });
          return;
        }
        if (kat === 'Beban' && akun !== FIN_AKUN_HPP) {
          var a = finAkunNormal_(akun), rbJ = lebarJ >= 12 ? finNamaRembes_(r[11]) : '';
          // Data lama berakun "Kartu Kredit": direklasifikasi -> beban aslinya + utang Reimburse ke Owner
          if (finAdalahKartuKredit_(a)) {
            a = /\bpph\b|pajak\s*penghasilan|ntpn/i.test(ketJ) ? FIN_AKUN_PAJAK_PH : 'Beban Operasional Lain';
            if (!rbJ) rbJ = namaOwnerJ;
          }
          var x = slot(t).x;
          x[a] = (x[a] || 0) + jml;
          var bJ = { t: t, a: a, v: jml, ket: ketJ, s: sumberJ, row: iJ + 2 };
          if (rbJ) { bJ.rb = rbJ; bJ.rbt = lebarJ >= 13 ? finTglRembesDibayar_(r[12]) : ''; }
          biayaList.push(bJ);
        } else if (kat === 'Pendapatan') {
          slot(t).l += jml;
          lainList.push({ t: t, a: akun, v: jml, ket: ketJ });
        }
      });
    }
  } catch (eJ) { Logger.log('Finance: gagal baca Jurnal - ' + eJ); }

  var hasil = {
    dibuat: Date.now(), rekapDiperbarui: rekapDiperbarui, hari: hari, tarif: tarif, unit: {},
    jualSku: jual, jualKanal: jualKanal, returSku: returSku, returKanal: returKanal, rusakSku: rusak, terakhirJual: terakhirJual, unitRata: unitRata, sumberRata: sumberBiaya,
    tanpaHpp: [], sumberHpp: { pembelian: 0, produksi: 0, master: 0 }, nPembelian: nPembelian,
    beliList: beliList, biayaList: biayaList, lainList: lainList, nonOps: nonOps,
    poList: (function () {
      try {
        return poBacaSemua_().filter(function (o) { return o.status !== 'Batal' && finValidTgl_(o.tanggal); }).map(function (o) {
          return { t: o.tanggal, no: o.noPo, pembeli: o.pembeli.slice(0, 40), jual: o.jual, hpp: o.modal + o.biayaLain, bayar: o.tanggalBayar, lengkap: o.dokLengkap, n: (o.items || []).length };
        });
      } catch (eP) { return []; }
    })(),
    tglPertama: Object.keys(hari).sort()[0] || ''
  };
  finTerapkanHpp_(hasil, true);
  cacheBesarPut_(FIN_CACHE_KUNCI, hasil, FIN_CACHE_DETIK);
  return hasil;
}

/* HPP PRESISI = Σ (Qty terjual per SKU × Harga Modal SKU tersebut) - TANPA rata-rata.
   - Qty terjual dibaca dari Stock Ledger "Terjual ..." per hari. SKU yang tercatat bisa berupa SKU Marketplace
     (Shopee/TikTok/Tokopedia) -> dipetakan ke SKU Gudang / Produk Induk lewat "SKU Marketplace Terhubung",
     "SKU Supplier Terhubung" & kolom SKU marketplace di Master Produk (resolveSkuJualCepat_), lalu dicocokkan
     juga tanpa beda huruf besar/kecil, sehingga HPP tidak bernilai 0 hanya karena kode jualnya beda.
   - Harga Modal = kolom 4 Master Produk ("Harga Supplier"), dibaca SEGAR setiap laporan dibuka.
     Cadangan (hanya bila Harga Modal kosong): biaya pembelian/produksi per SKU.
   paksa=false -> lewati hitung ulang kalau Harga Modal tidak berubah sejak terakhir dihitung. */
function finTerapkanHpp_(D, paksa) {
  function nrm(x) { return String(x == null ? '' : x).replace(/[\u200B-\u200D\u2060\uFEFF\u00AD]/g, '').replace(/\u00A0/g, ' ').replace(/^'+/, '').trim(); }
  var master = {}, masterBesar = {}, namaSku = {}, arsipBesar = {}, sig = [];
  // aliasFin: KODE (huruf besar) -> [SKU induk, ...]. Dibangun KHUSUS Finance dari SEMUA sumber pemetaan,
  // termasuk kode SKU Marketplace yang kebetulan juga ada (atau diarsipkan/digabung) di Master Produk -
  // kasus inilah yang dulu membuat HPP SKU Marketplace terbaca Rp 0.
  var aliasFin = {};
  function tambahAlias(kode, induk) {
    kode = nrm(kode); induk = nrm(induk);
    if (!kode || !induk || kode.toUpperCase() === induk.toUpperCase()) return;
    var k = kode.toUpperCase(), d = aliasFin[k] || (aliasFin[k] = []);
    if (d.indexOf(induk) === -1) d.push(induk);
  }
  try {
    var shM = getMasterProdukSheet(), lrM = shM.getLastRow();
    if (lrM > 1) {
      var lebarM = Math.max(4, Math.min(shM.getLastColumn(), KAT_KOL_INFO_ARSIP));
      var kolPf = null;
      try { kolPf = syncKolomSkuTerhubungMaster_(); } catch (eK) { kolPf = null; }
      var lebarBaca = lebarM;
      if (kolPf) ['Shopee', 'TikTok Shop', 'Tokopedia'].forEach(function (pf) { var k = kolPf[pf]; if (k && !k.dobel) lebarBaca = Math.max(lebarBaca, k.nomor); });
      lebarBaca = Math.min(lebarBaca, shM.getLastColumn());
      shM.getRange(2, 1, lrM - 1, Math.max(4, lebarBaca)).getValues().forEach(function (r) {
        var s = nrm(r[0]); if (!s) return;
        var h = finAngka_(r[3]);
        var arsip = r.length >= KAT_KOL_STATUS && String(r[KAT_KOL_STATUS - 1] || '').trim() === KAT_STATUS_ARSIP;
        if (!namaSku[s] || !arsip) namaSku[s] = String(r[1] || s).trim();
        if (arsip) arsipBesar[s.toUpperCase()] = true;
        if (h > 0) {
          if (!(master[s] > 0) || !arsip) master[s] = h;
          if (!(masterBesar[s.toUpperCase()] > 0) || !arsip) masterBesar[s.toUpperCase()] = h;
        }
        // Produk arsip hasil gabung: "Digabung ke SKU-X - ..." -> SKU-X jadi induknya
        if (arsip && r.length >= KAT_KOL_INFO_ARSIP) {
          var mg = String(r[KAT_KOL_INFO_ARSIP - 1] || '').match(/Digabung ke\s+(\S+)/i);
