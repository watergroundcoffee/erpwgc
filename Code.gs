/* ============================================================
   KOREKSI SALAH SCAN RESI v2026.10.21 (Paket 8)
   Masalah: kamera / scanner gudang kadang salah membaca 1-2 karakter (atau kurang / lebih 1-2 digit), sehingga resi
   yang discan tidak pernah cocok dengan resi dari marketplace -> "Belum terhubung" selamanya.
   Aturan (sengaja ketat, TANPA AI):
   - Hanya resi scan keluar <= KRS_HARI_ hari yang BELUM terhubung ke pesanan mana pun, panjang >= KRS_MIN_PANJANG_.
   - Pembanding = semua resi pesanan (Shopee / TikTok / Tokopedia / Conner / PO Sales + tabel tautan + hasil API
     cari mendalam). Jarak Damerau-Levenshtein <= 2 (ganti / hilang / lebih / tertukar 1 karakter = 1),
     awalan huruf harus sama (JP.., JX.., SPXID..), jarak 2 hanya untuk resi >= 12 karakter.
   - Harus TUNGGAL: tepat 1 pesanan yang cocok di jarak terdekat & tidak ada pesanan lain di jarak <= 2.
   - Resi yang benar BELUM pernah discan keluar (kalau sudah, kemungkinan scan dobel -> tidak dikoreksi, dilaporkan).
   Tindakan: No Resi di sheet "Resi Keluar" diganti dengan resi yang benar (stok fisik & invoice langsung benar),
   dicatat di sheet "Koreksi Resi Otomatis" (resi salah, resi benar, pesanan, selisih) + tautan resi salah -> pesanan.
   Frontend menandai baris itu "Dikoreksi sistem" (aksi koreksi_resi_lihat).
   ============================================================ */
var KRS_SHEET_ = 'Koreksi Resi Otomatis';
var KRS_HEADER_ = ['Waktu', 'Resi Discan (salah)', 'Resi Benar', 'No Pesanan', 'Sumber', 'Selisih Karakter', 'Baris Resi Keluar', 'Oleh', 'Catatan'];
var KRS_MIN_PANJANG_ = 10, KRS_MAKS_JARAK_ = 2, KRS_PANJANG_JARAK2_ = 12, KRS_HARI_ = 14;
var KRS_MAKS_TRACKING_SHOPEE_ = 80;
function getKoreksiResiSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(KRS_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(KRS_SHEET_);
    sh.getRange(1, 1, 1, KRS_HEADER_.length).setValues([KRS_HEADER_]).setFontWeight('bold');
    sh.getRange('B:D').setNumberFormat('@');
    sh.setFrozenRows(1);
  }
  return sh;
}
// Jarak Damerau-Levenshtein (versi OSA), berhenti lebih awal bila pasti > maks
function krsJarak_(a, b, maks) {
  var n = a.length, m = b.length;
  if (Math.abs(n - m) > maks) return maks + 1;
  var dua = [], satu = [], kini = [], i, j;
  for (j = 0; j <= m; j++) satu.push(j);
  for (i = 1; i <= n; i++) {
    kini = [i];
    var minBaris = i;
    for (j = 1; j <= m; j++) {
      var biaya = a.charAt(i - 1) === b.charAt(j - 1) ? 0 : 1;
      var v = Math.min(satu[j] + 1, kini[j - 1] + 1, satu[j - 1] + biaya);
      if (i > 1 && j > 1 && a.charAt(i - 1) === b.charAt(j - 2) && a.charAt(i - 2) === b.charAt(j - 1)) v = Math.min(v, dua[j - 2] + 1);
      kini.push(v);
      if (v < minBaris) minBaris = v;
    }
    if (minBaris > maks) return maks + 1;
    dua = satu; satu = kini;
  }
  return satu[m];
}
function krsAwalan_(k) { var m = String(k).match(/^[A-Z]+/); return m ? m[0] : ''; }
// Kunci resi yang sudah discan keluar (bukan Pending)
function krsKunciSudahScan_() {
  var o = {};
  try { smBacaSheet('Resi Keluar', 11).forEach(function (r) { var k = kunciResi_(r[0]); if (k && String(r[10] || '').trim() !== 'Pending') o[k] = 1; }); } catch (e) { }
  return o;
}
// Daftar pembanding: { t: resi asli, k: normal, no, sumber } dikelompokkan per panjang
function krsKandidat_(paketApi) {
  var perPanjang = {}, sudah = {};
  function tambah(t, no, sumber) {
    var k = ovxNormResi_(t);
    if (k.length < KRS_MIN_PANJANG_ - 2 || !no) return;
    var kunci = k + '|' + no;
    if (sudah[kunci]) return;
    sudah[kunci] = 1;
    (perPanjang[k.length] = perPanjang[k.length] || []).push({ t: String(t).trim(), k: k, no: String(no), sumber: sumber || '' });
  }
  kumpulkanPesananUntukResi_().forEach(function (p) {
    if (/CANCEL|BATAL/i.test(String(p.status || ''))) return;
    (p.resi || []).forEach(function (r) { tambah(r, p.noInvoice, p.sumber); });
  });
  try {
    var sh = getTautanResiSheet_(), lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 1, lr - 1, 4).getValues().forEach(function (r) {
      if (/koreksi salah scan/i.test(String(r[3] || ''))) return; // resi salah hasil koreksi bukan pembanding
      tambah(r[0], kunciResi_(r[2]) ? String(r[2]).trim() : '', String(r[1] || ''));
    });
  } catch (e) { }
  (paketApi || []).forEach(function (p) { tambah(p.t, p.no, p.sumber); });
  return perPanjang;
}
// Cari resi asli yang paling mirip. Hasil: { status: 'cocok'|'ragu'|'dobel'|'tidak', c, jarak, pilihan[] }
function krsCari_(resiScan, perPanjang, sudahScan) {
  var k = ovxNormResi_(resiScan);
  if (k.length < KRS_MIN_PANJANG_) return { status: 'tidak', alasan: 'pendek' };
  var aw = krsAwalan_(k), terdekat = [], jMin = 99;
  for (var L = k.length - KRS_MAKS_JARAK_; L <= k.length + KRS_MAKS_JARAK_; L++) {
    var daftar = perPanjang[L];
    if (!daftar) continue;
    for (var i = 0; i < daftar.length; i++) {
      var c = daftar[i];
      if (c.k === k || krsAwalan_(c.k) !== aw) continue;
      var maks = (k.length >= KRS_PANJANG_JARAK2_ && c.k.length >= KRS_PANJANG_JARAK2_) ? KRS_MAKS_JARAK_ : 1;
      var j = krsJarak_(k, c.k, maks);
      if (j > maks) continue;
      terdekat.push({ c: c, j: j });
      if (j < jMin) jMin = j;
    }
  }
  if (!terdekat.length) return { status: 'tidak', alasan: 'tidakMirip' };
  var pesanan = {};
  terdekat.forEach(function (x) { pesanan[x.c.no] = Math.min(pesanan[x.c.no] === undefined ? 99 : pesanan[x.c.no], x.j); });
  var pilihan = Object.keys(pesanan).map(function (no) {
    var x = terdekat.filter(function (y) { return y.c.no === no && y.j === pesanan[no]; })[0];
    return { resi: x.c.t, no: no, sumber: x.c.sumber, jarak: x.j };
  }).sort(function (a, b) { return a.jarak - b.jarak; });
  if (pilihan.length !== 1) return { status: 'ragu', pilihan: pilihan.slice(0, 5) };
  var p = pilihan[0];
  if (sudahScan[kunciResi_(p.resi)]) return { status: 'dobel', pilihan: pilihan };
  return { status: 'cocok', c: p, jarak: p.jarak };
}
// Jalankan koreksi. opsi: { paketApi, hanya: [resi scan], oleh }
function krsJalankan_(opsi) {
