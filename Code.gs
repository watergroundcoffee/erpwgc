    var hitung = { kirim: 0, ulasan: 0, komplain: 0, repeat: 0 }, tanpaNomor = { kirim: 0, ulasan: 0, komplain: 0, repeat: 0 };
    function cocok(o, j) {
      var hari = (kini - o.tanggalMs) / 86400000;
      if (j === 'kirim') return o.status === 'Dalam Pengiriman' || o.status === 'Terkirim' || (o.status === 'Menunggu Kurir' && !!o.resi);
      if (j === 'ulasan') return (o.status === 'Terkirim' || o.status === 'Pesanan Selesai') && hari <= WA_ULASAN_HARI_ + 7;
      if (j === 'komplain') return o.status === 'Retur';
      if (j === 'repeat') return o.status === 'Pesanan Selesai' && hari >= WA_REPEAT_MIN_ && hari <= WA_REPEAT_MAKS_ && o.nomor && terbaruPerNomor[o.nomor] <= o.tanggalMs;
      return false;
    }
    var daftar = [];
    semua.forEach(function (o) {
      Object.keys(hitung).forEach(function (j) {
        if (!cocok(o, j)) return;
        if (!o.nomor) { tanpaNomor[j]++; return; }
        if (log.stop[o.nomor]) return;
        hitung[j]++;
        if (j !== jenis) return;
        var x = JSON.parse(JSON.stringify(o));
        var sudah = log.per[o.id + '|' + j];
        x.sudah = sudah || null;
        daftar.push(x);
      });
    });
    // repeat order: 1 baris per nomor
    if (jenis === 'repeat') { var lihat = {}; daftar = daftar.filter(function (o) { if (lihat[o.nomor]) return false; lihat[o.nomor] = true; return true; }); hitung.repeat = daftar.length; }
    daftar.sort(function (a, b) { if (!!a.sudah !== !!b.sudah) return a.sudah ? 1 : -1; return b.tanggalMs - a.tanggalMs; });
    return { success: true, jenis: jenis, daftar: daftar.slice(0, 400), total: daftar.length, hitung: hitung, tanpaNomor: tanpaNomor,
      template: waTemplate_(), label: WA_JENIS_, bolehEditTemplate: mgApakahOwner_(data.email),
      aturan: { ulasanHari: WA_ULASAN_HARI_, repeatMin: WA_REPEAT_MIN_, repeatMaks: WA_REPEAT_MAKS_, hariData: WA_HARI_DATA_ } };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}
