    sh.getRange(row, 23).setValue(catatan);
    return { success: true, status: '', catatan: catatan };
  }, {
    tungguMs: 15000, pesanTanpaIzin: 'Anda tidak punya izin untuk mengubah status pesanan.',
    validasi: function () { row = parseInt(data.row, 10) || 0; if (!row && !data.noInvoice) throw new Error('Pesanan tidak dikenali'); }
  });
