  sh.getRange(row, 1).setNumberFormat('@');
  sh.getRange(row, 1, 1, PROD2_HDR_BAHAN.length).setValues([[sku, nama, 'gram', 0, 0, 0, 'Setengah Jadi ' + level, true, new Date(), 'Dibuat otomatis oleh Roastery']]);
