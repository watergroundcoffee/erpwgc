    var t = c.types || [], v = c.longText || c.long_name || '';
    if (t.indexOf('route') >= 0) o.jalan = v;
    else if (t.indexOf('street_number') >= 0) o.no = v;
    else if (t.indexOf('premise') >= 0 && !o.no) o.no = v;
    else if (t.indexOf('administrative_area_level_4') >= 0 || (t.indexOf('sublocality_level_1') >= 0 && !o.kel)) o.kel = v;
    else if (t.indexOf('administrative_area_level_3') >= 0) o.kec = v;
    else if (t.indexOf('administrative_area_level_2') >= 0) o.kota = v;
    else if (t.indexOf('administrative_area_level_1') >= 0) o.prov = v;
