// Cocokkan No Invoice dari file import dengan Order ID di sheet "Pesanan TikTok Shop" (dan Conner, hanya dilaporkan).
// Balikan per invoice: { s: 'tiktok' | 'conner', terisi: Nama Manual pesanan sudah diisi? }
function prosesCekInvoiceImportPembeli(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var minta = {};
    (data.invoices || []).slice(0, 5000).forEach(function (v) { var k = kunciResi_(v); if (k) minta[k] = String(v); });
    var cocok = {};
    var sh = getPesananTikTokShopSheet(), lr = sh.getLastRow();
    if (lr > 1) {
      var lebar = Math.min(Math.max(sh.getLastColumn(), 11), 16);
      sh.getRange(2, 1, lr - 1, lebar).getValues().forEach(function (r) {
        var k = kunciResi_(r[0]);
        if (k && minta[k] && !cocok[minta[k]]) cocok[minta[k]] = { s: 'tiktok', terisi: !!String(r[10] || '').trim() };
      });
    }
    var shC = getPesananConnerSheet(), lrC = shC.getLastRow();
    if (lrC > 1) {
      shC.getRange(2, 1, lrC - 1, 1).getValues().forEach(function (r) {
        var k = kunciResi_(r[0]);
        if (k && minta[k] && !cocok[minta[k]]) cocok[minta[k]] = { s: 'conner', terisi: false };
      });
    }
    result.cocok = cocok;
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Isi data pembeli manual (Nama/HP/Alamat/Username Manual) di pesanan TikTok Shop yang No Invoice-nya ada di file import.
// HANYA kolom yang masih kosong yang diisi - data manual yang sudah ada tidak ditimpa.
function importIsiPesananTikTok_(daftar) {
  var hasil = { dilengkapi: 0, sudahTerisi: 0 };
  var adaInv = daftar.some(function (it) { return it.invoices && it.invoices.length; });
  if (!adaInv) return hasil;
  var sh = getPesananTikTokShopSheet(), lr = sh.getLastRow();
  if (lr < 2) return hasil;
  if (sh.getLastColumn() < 16) sh.getRange(1, 16).setValue('Username Manual').setFontWeight('bold');
  var ids = sh.getRange(2, 1, lr - 1, 1).getValues();
  var manual = sh.getRange(2, 11, lr - 1, 6).getValues(); // 11 Nama, 12 HP, 13 Alamat, 14 Catatan, 15 Package, 16 Username
  var baris = {};
  ids.forEach(function (r, i) { var k = kunciResi_(r[0]); if (k && baris[k] == null) baris[k] = i; });
  var petaNHA = {}, petaUser = {};
  daftar.forEach(function (it) {
    (it.invoices || []).slice(0, 50).forEach(function (inv) {
      var i = baris[kunciResi_(inv)];
      if (i == null) return;
      var m = manual[i], diubah = false;
      var isi = [it.nama, it.noHp, it.alamat];
      for (var c = 0; c < 3; c++) {
        if (!String(m[c] || '').trim() && isi[c]) { m[c] = isi[c]; diubah = true; }
      }
      if (!String(m[5] || '').trim() && it.username) { m[5] = it.username; petaUser[i + 2] = it.username; diubah = true; }
      if (diubah) { petaNHA[i + 2] = [m[0], m[1], m[2]]; hasil.dilengkapi++; } else hasil.sudahTerisi++;
    });
  });
  if (Object.keys(petaNHA).length) {
    Object.keys(petaNHA).forEach(function (r) { sh.getRange(Number(r), 12).setNumberFormat('@'); });
    tulisBarisPerBlok_(sh, 11, petaNHA);
    tulisSelPerBlok_(sh, 16, petaUser, true);
    try { invalidasiCacheGabunganPesanan(); } catch (e) { }
  }
  return hasil;
}

// Simpan hasil import ke sheet Data Pembeli. Cocok = No HP sama (atau nama sama & HP lama kosong):
// baris lama HANYA diisi kolom yang masih kosong (tidak menimpa). Selain itu ditambah sebagai baris baru.
function prosesSimpanImportPembeli(data) {
  var result = { success: false };
  if (!cekIzin(data.email, 'buatInvoice')) { result.error = 'Anda tidak punya izin untuk aksi ini.'; return result; }
  var daftar = (data.daftar || []).slice(0, IMPORT_PEMBELI_MAKS_SIMPAN_);
  if (!daftar.length) { result.error = 'Tidak ada data yang dikirim.'; return result; }
  var lock = kunciModul_('penjualan');
  try { lock.waitLock(20000); } catch (e) { result.error = 'Sistem sibuk, coba lagi.'; return result; }
  try {
    var sh = getDataPembeliSheet();
    var lastRow = sh.getLastRow();
    var lama = lastRow > 1 ? sh.getRange(2, 1, lastRow - 1, 9).getValues() : [];
    var idxHp = {}, idxNama = {};
    lama.forEach(function (r, i) {
      var k = hpKunci_(r[2]); if (k && idxHp[k] == null) idxHp[k] = i;
      var n = String(r[0] || '').trim().toLowerCase(); if (n && idxNama[n] == null) idxNama[n] = i;
    });
    var bersih = function (v, maks) { return String(v == null ? '' : v).replace(/\s+/g, ' ').trim().substring(0, maks); };
    var baru = [], diubah = {}, nTambah = 0, nUpdate = 0, nSama = 0, nLewat = 0, sudahDiBatch = {};
    daftar.forEach(function (it) {
      var nama = bersih(it.nama, 120);
      if (!nama) { nLewat++; return; }
      var hp = formatNoHpIntl_(bersih(it.noHp, 40));
      var kHp = hpKunci_(hp);
      var kunciBatch = kHp || ('n:' + nama.toLowerCase());
      if (sudahDiBatch[kunciBatch]) { nLewat++; return; }
      sudahDiBatch[kunciBatch] = true;
      var tgl = Number(it.tanggalMs) > 0 ? new Date(Number(it.tanggalMs)) : new Date();
      var baris = [nama, bersih(it.alamat, 400), hp, '', bersih(it.pic, 80), bersih(it.kategori, 30), bersih(it.keterangan, 300),
        bersih(it.sumberKontak, 40) || 'Import', tgl];
      var iLama = kHp && idxHp[kHp] != null ? idxHp[kHp] : null;
      if (iLama == null && idxNama[nama.toLowerCase()] != null && !hpKunci_(lama[idxNama[nama.toLowerCase()]][2])) iLama = idxNama[nama.toLowerCase()];
      if (iLama != null) {
        var r = lama[iLama], ada = false;
        [1, 2, 4, 5, 6, 7, 8].forEach(function (c) {
          var kosong = r[c] === '' || r[c] == null || (typeof r[c] === 'string' && !r[c].trim());
          if (kosong && baris[c] !== '' && baris[c] != null) { r[c] = baris[c]; ada = true; }
        });
        if (ada) { diubah[iLama] = true; nUpdate++; } else nSama++;
        return;
      }
      baru.push(baris); nTambah++;
    });
    // Pesanan TikTok Shop yang No Invoice-nya ada di file -> isi data pembeli manualnya (pakai data yang sudah dirapikan)
    var itemPesanan = daftar.filter(function (it) { return it.invoices && it.invoices.length && bersih(it.nama, 120); }).map(function (it) {
      return { nama: bersih(it.nama, 120), noHp: formatNoHpIntl_(bersih(it.noHp, 40)), alamat: bersih(it.alamat, 400),
        username: bersih(it.username, 60).replace(/^@/, ''), invoices: (it.invoices || []).map(String) };
    });
    var hasilPesanan = importIsiPesananTikTok_(itemPesanan);
    result.pesananDilengkapi = hasilPesanan.dilengkapi; result.pesananSudahTerisi = hasilPesanan.sudahTerisi;
    Object.keys(diubah).forEach(function (i) {
      var row = Number(i) + 2;
      sh.getRange(row, 3).setNumberFormat('@');
      sh.getRange(row, 1, 1, 9).setValues([lama[i]]);
    });
    if (baru.length) {
      var mulai = lastRow + 1;
      sh.getRange(mulai, 3, baru.length, 1).setNumberFormat('@');
      sh.getRange(mulai, 1, baru.length, 9).setValues(baru);
    }
    result.success = true;
    result.ditambah = nTambah; result.diperbarui = nUpdate; result.sudahAda = nSama; result.dilewati = nLewat;
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

function prosesLihatSemuaPelanggan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    try { result.hpDirapikan = rapikanNoHpDataPembeli_(); } catch (eR) { }

    var shPembeli = getDataPembeliSheet();
    var lastRowPembeli = shPembeli.getLastRow();
    var daftarPembeli = [];
    if (lastRowPembeli > 1) {
      var valsPembeli = shPembeli.getRange(2, 1, lastRowPembeli - 1, 9).getValues();
      var tz = Session.getScriptTimeZone();
      valsPembeli.forEach(function (row) {
        var nama = String(row[0] || '').trim();
        if (!nama) return;
        daftarPembeli.push({
          nama: nama, alamat: row[1], noHp: String(row[2] || '').trim(),
          email: String(row[3] || '').trim(), pic: String(row[4] || '').trim(),
          kategori: String(row[5] || '').trim(), keterangan: String(row[6] || '').trim(),
          sumberKontak: String(row[7] || '').trim() || 'PO Sales', segmen: segmenDariSumberKontak_(row[7]), adaDataLengkap: true,
          tglKontakPertama: row[8] instanceof Date ? Utilities.formatDate(row[8], tz, 'dd MMM yyyy') : '',
          jumlahPesanan: 0, totalBelanja: 0, terakhirBeli: null
        });
      });
    }
    var mapPembeli = {};
    daftarPembeli.forEach(function (p) { mapPembeli[p.nama.toLowerCase()] = p; });

    var sheetsPesanan = getPesananManualSheets();
    var shHeader = sheetsPesanan.header;
    var lastRowHeader = shHeader.getLastRow();
    if (lastRowHeader > 1) {
      var valsHeader = shHeader.getRange(2, 1, lastRowHeader - 1, 12).getValues();
      valsHeader.forEach(function (row) {
        if (!String(row[0] || '').trim()) return;
        if (String(row[11] || '').trim() === 'Dibatalkan') return;
        var namaPenerima = String(row[2] || '').trim();
        if (!namaPenerima) return;
        var key = namaPenerima.toLowerCase();
        if (!mapPembeli[key]) {
          mapPembeli[key] = { nama: namaPenerima, alamat: row[3] || '', noHp: String(row[4] || '').trim(), sumberKontak: 'PO Sales', segmen: 'Offline (PO Sales)', adaDataLengkap: true, jumlahPesanan: 0, totalBelanja: 0, terakhirBeli: null };
          daftarPembeli.push(mapPembeli[key]);
        }
        var p = mapPembeli[key];
        pelTambahKanal_(p, 'PO Sales');
        p.jumlahPesanan++;
        p.totalBelanja += parseFloat(row[9]) || 0;
        var tgl = row[1];
        if (tgl instanceof Date && (!p.terakhirBeli || tgl > p.terakhirBeli)) p.terakhirBeli = tgl;
      });
    }

    // Pelanggan TikTok Shop - datanya bisa TERSENSOR (mode TikTok Shipping) kecuali udah diisi manual
    var shTiktokPesanan = getPesananTikTokShopSheet();
    var lastRowTiktokPesanan = shTiktokPesanan.getLastRow();
    if (lastRowTiktokPesanan > 1) {
      var valsTiktokPesanan = shTiktokPesanan.getRange(2, 1, lastRowTiktokPesanan - 1, 13).getValues();
      valsTiktokPesanan.forEach(function (row) {
        var namaManual = String(row[10] || '').trim();
        var namaTersamar = String(row[7] || '').trim();
        var namaDipakai = namaManual || namaTersamar;
        if (!namaDipakai) return;
        var key = namaDipakai.toLowerCase();
        var sudahLengkap = !!namaManual;

        if (!mapPembeli[key]) {
          mapPembeli[key] = {
            nama: namaDipakai, alamat: namaManual ? String(row[12] || '').trim() : String(row[9] || '').trim(),
            noHp: namaManual ? String(row[11] || '').trim() : String(row[8] || '').trim(),
            sumberKontak: 'TikTok Shop', segmen: 'Marketplace (TikTok Shop)', adaDataLengkap: sudahLengkap,
            jumlahPesanan: 0, totalBelanja: 0, terakhirBeli: null
          };
          daftarPembeli.push(mapPembeli[key]);
        }
        var p = mapPembeli[key];
        if (sudahLengkap && !p.adaDataLengkap) p.adaDataLengkap = true; // upgrade kalau ketemu versi lengkapnya belakangan
        pelTambahKanal_(p, 'TikTok Shop');
        p.jumlahPesanan++;
        p.totalBelanja += parseFloat(row[3]) || 0;
        var tglTiktok = row[1];
        if (tglTiktok instanceof Date && (!p.terakhirBeli || tglTiktok > p.terakhirBeli)) p.terakhirBeli = tglTiktok;
      });
    }

    // v2026.10.43 (DN-261021-085640-808): pelanggan Shopee & Conner ikut tampil. Shopee: kolom Manual -> data yang ditangkap
    // (API / OCR, sheet "Pembeli Shopee Lengkap"); data tersamar (****) tidak dijadikan kontak.
    try { pelTambahMarketplace_(daftarPembeli, mapPembeli); } catch (eMp) { console.error('pelTambahMarketplace_: ' + eMp); }
    // v2026.10.52 (DN-261021-231001-556): gabung kontak yang sama (No HP / username), Kode Pelanggan & kategori belanja
    try { daftarPembeli = pelIdentifikasi_(daftarPembeli); } catch (eId) { console.error('pelIdentifikasi_: ' + eId); }

    var tz = Session.getScriptTimeZone();
    daftarPembeli.forEach(function (p) {
      p.terakhirBeliMs = p.terakhirBeli ? p.terakhirBeli.getTime() : 0;
      p.terakhirBeli = p.terakhirBeli ? Utilities.formatDate(p.terakhirBeli, tz, 'dd MMM yyyy') : '-';
      p.noHp = formatNoHpIntl_(p.noHp);
      delete p.email; delete p.kategori; // kolom Email & Kategori tidak dipakai lagi
    });
    daftarPembeli.sort(function (a, b) {
      if (a.adaDataLengkap !== b.adaDataLengkap) return a.adaDataLengkap ? -1 : 1; // yang datanya LENGKAP (nggak disensor) di atas
      return b.jumlahPesanan - a.jumlahPesanan;
    });

    result.success = true;
    result.daftar = daftarPembeli;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

// Coba endpoint "Get Order Detail" (BEDA dari "search orders" - ini GET, per-ID spesifik).
// Cek apakah endpoint ini kasih alamat pembeli LEBIH LENGKAP (nggak disamarkan).
function tesDetailPesananTikTokShop() {
  var props = PropertiesService.getScriptProperties();
  var accessToken = props.getProperty('TIKTOK_ACCESS_TOKEN');
  var shopCipher = props.getProperty('TIKTOK_SHOP_CIPHER');

  if (!accessToken || !shopCipher) { Logger.log('❌ Belum ada token/shop cipher. Jalankan tesKoneksiTikTokShop() dulu.'); return; }

  // GANTI ID INI dengan salah satu order id dari hasil tesLihatPesananTikTokShop() sebelumnya
  var contohOrderId = '577367904435603338';

  try {
    var path = '/order/202309/orders';
    var paramsUntukSign = {
      app_key: getTiktokAppKey(),
      timestamp: String(Math.floor(Date.now() / 1000)),
      shop_cipher: shopCipher,
      version: '202309',
      ids: contohOrderId
    };
    var signature = buatSignatureTikTok(path, paramsUntukSign);

    var url = 'https://open-api.tiktokglobalshop.com' + path +
      '?app_key=' + encodeURIComponent(getTiktokAppKey()) +
      '&shop_cipher=' + encodeURIComponent(shopCipher) +
      '&timestamp=' + paramsUntukSign.timestamp +
      '&version=' + paramsUntukSign.version +
      '&ids=' + encodeURIComponent(contohOrderId) +
      '&sign=' + signature;

    var res = fetchHemat(url, {
      method: 'get',
      headers: { 'x-tts-access-token': accessToken },
      muteHttpExceptions: true
    });
    Logger.log('Kode respons: ' + res.getResponseCode());
    Logger.log('Isi respons LENGKAP: ' + res.getContentText());
  } catch (err) {
    Logger.log('❌ Error: ' + err.toString());
  }
}

