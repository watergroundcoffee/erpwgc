}

function ambilLogResiKeluarBertahap(email, opsi) {
  if (!cekIzin(email, 'scanResiKeluar')) throw new Error('Anda tidak punya izin untuk aksi ini.');
  opsi = opsi || {};
  var t0 = Date.now();
  var limit = Math.min(Math.max(parseInt(opsi.limit, 10) || PGR_LIMIT_DEFAULT, 1), PGR_LIMIT_MAKS);
  var filterKategori = opsi.filterKategori || null;

  var sh = getSheetInfo('keluar').sheet;
  var lastRow = sh.getLastRow();
  var hasil = { daftar: [], cursorBerikut: null, adaLagi: false, totalBarisLog: Math.max(lastRow - 1, 0) };

  var barisAwal = lastRow;
  var sebelumBaris = parseInt(opsi.sebelumBaris, 10);
  if (sebelumBaris) barisAwal = Math.min(lastRow, sebelumBaris - 1);
  if (barisAwal < 2) return hasil;

  var tz = Session.getScriptTimeZone();
  var peta = bangunPetaResiKeSemuaPesananCache_(); // dari cache 2 menit (dulu dibangun ulang tiap buka tab)
  var bolehNilai = cekIzin(email, 'buatInvoice'); // Nilai Paket hanya untuk role yang boleh melihat harga
  var petaRetur = bangunPetaReturPerInvoice(peta); // dibangun SEKALI
  var petaStatusRetur = p10PetaStatusRetur_();
  var syncShopeeSegar = kilatSyncShopeeSegar_();

  var baris = barisAwal;
  var barisTerakhirDiproses = null;
  var penuh = false;
  while (baris >= 2 && !penuh) {
    var mulai = Math.max(2, baris - PGR_UKURAN_CHUNK + 1);
    var vals = sh.getRange(mulai, 1, baris - mulai + 1, 11).getValues();
    for (var i = vals.length - 1; i >= 0; i--) {
      barisTerakhirDiproses = mulai + i;
      var row = vals[i];
      var noResiScan = String(row[0] || '').trim();
      if (!noResiScan) continue;
      var tanggalObj = row[2] instanceof Date ? row[2] : null;
      var cocok = peta[kunciResi_(noResiScan)] || deteksiKilatOtomatis_(noResiScan, row[9], tanggalObj, syncShopeeSegar);
      var statusPesanan = normalisasiStatusPesanan(cocok ? cocok.status : '');
      var kategori = klasifikasiStatusResi(statusPesanan, tanggalObj);
      if (filterKategori && filterKategori.indexOf(kategori) === -1) continue;
      hasil.daftar.push({
        noResiScan: noResiScan, tanggal: tanggalObj ? Utilities.formatDate(tanggalObj, tz, 'dd MMM yyyy, HH:mm:ss') : '-',
        kurir: p10KurirTampil_(row[9], cocok), kurirDariPesanan: p10KurirKosong_(row[9]) && !!(cocok && cocok.kurir), resiAsli: p10ResiAsli_(noResiScan, cocok), dicatatOleh: row[8],
        noInvoice: cocok ? cocok.noInvoice : null, pembeli: cocok ? cocok.pembeli : null,
        sumber: cocok ? cocok.sumber : null, jenis: cocok ? (cocok.jenis || 'pesanan') : null, statusTransfer: cocok && cocok.statusTransfer ? cocok.statusTransfer : null, kilatOtomatis: !!(cocok && cocok.kilatOtomatis), statusAkhirKilat: cocok && cocok.statusAkhir ? cocok.statusAkhir : null, kodeAkhirKilat: cocok && cocok.kodeAkhir ? cocok.kodeAkhir : null, umurHariKilat: cocok && cocok.umurHari !== undefined ? cocok.umurHari : null, hariLakuKilat: cocok && cocok.hariLaku !== undefined ? cocok.hariLaku : null, orderPembeliKilat: cocok && cocok.orderPembeli ? cocok.orderPembeli : null,
        statusPesanan: statusPesanan,
        kategoriPengiriman: kategori,
        resiRetur: (cocok && petaRetur[cocok.noInvoice]) ? petaRetur[cocok.noInvoice] : null,
        statusRetur: p10StatusRetur_(petaStatusRetur, cocok && petaRetur[cocok.noInvoice]),
        ms: tanggalObj ? tanggalObj.getTime() : 0, nilai: (bolehNilai && cocok && cocok.nilai) ? cocok.nilai : null
      });
      if (hasil.daftar.length >= limit) { penuh = true; break; }
    }
    if (Date.now() - t0 > PGR_BATAS_WAKTU_MS) break;
    baris = mulai - 1;
  }

  hasil.adaLagi = barisTerakhirDiproses !== null && barisTerakhirDiproses > 2;
  hasil.cursorBerikut = hasil.adaLagi ? barisTerakhirDiproses : null;
  return hasil;
}

