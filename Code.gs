  var rs = D.returSku || {}, totRetur = 0;
  Object.keys(D.hari).forEach(function (t) { D.hari[t].hb = 0; });
  Object.keys(rs).forEach(function (t) {
    var tot = 0, m = rs[t];
    Object.keys(m).forEach(function (s) { tot += m[s] * hargaModal(s); });
    var slot = D.hari[t] || (D.hari[t] = { o: {}, h: 0, r: 0, b: 0, x: {}, l: 0 });
    slot.h = (slot.h || 0) - tot; slot.hb = tot; totRetur += tot;
