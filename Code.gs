}
function aiwBangunTaskCenter_() {
  var batasSelesai = Date.now() - 30 * 86400000;
  var tugas = sptBacaSemua_().filter(function (t) {
    var aktif = t.status === 'PENDING' || t.status === 'PROCESSING';
    return aktif || aiwMs_(t.diperbarui) >= batasSelesai || aiwMs_(t.waktu) >= batasSelesai;
  }).map(function (t) {
    var p = t.params || {};
    return {
      task_id: t.id, status: t.status, action: t.action, sku: t.sku, waktu_ms: aiwMs_(t.waktu), dibuat_ms: aiwMs_(t.dibuat), diperbarui_ms: aiwMs_(t.diperbarui),
      oleh: t.oleh, percobaan: t.percobaan, hasil: String(t.hasil || '').slice(0, 600), ringkas: sptRingkasParams_(t),
      alasan: String(p.alasan || p.alasan_bisnis || p.catatan || '').slice(0, 300), platform: p.platform || aiwPlatformDari_(t.action + ' ' + JSON.stringify(p).slice(0, 300)) || 'Shopee'
    };
  });
  tugas.sort(function (a, b) {
    var pa = a.status === 'PENDING' || a.status === 'PROCESSING', pb = b.status === 'PENDING' || b.status === 'PROCESSING';
    if (pa !== pb) return pa ? -1 : 1;
    return pa ? a.waktu_ms - b.waktu_ms : b.diperbarui_ms - a.diperbarui_ms;
  });
  tugas = tugas.slice(0, 400);

  var log = [], shL = getExecutionLogsSheet_(), lrL = shL.getLastRow();
  if (lrL >= 2) {
    var nL = Math.min(400, lrL - 1);
    shL.getRange(lrL - nL + 1, 1, nL, EKS_HEADER_.length).getValues().reverse().forEach(function (r) {
      var resp = aiwJson_(r[7], null), pesan = '', taskId = '', platform = '';
