    if (kategoriBaru) {
      var shKat = getKategoriProdukSheet();
      var lastRowKat = shKat.getLastRow();
      var sudahAda = false;
      if (lastRowKat > 1) {
        var valsKat = shKat.getRange(2, 1, lastRowKat - 1, 1).getValues();
        for (var k = 0; k < valsKat.length; k++) {
          if (String(valsKat[k][0]).trim().toLowerCase() === kategoriBaru.toLowerCase()) { sudahAda = true; break; }
        }
      }
      if (!sudahAda) shKat.appendRow([kategoriBaru, '']);
    }


    result.success = true;
    result.skuBerubah = skuLama !== skuBaru;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

