    invalidasiPetaResiRingkas_(); // tautan baru harus langsung kelihatan di Daftar Resi
    var c = bangunPetaResiKeSemuaPesanan()[kunciResi_(resi)];
    result.hasil = c ? { noInvoice: c.noInvoice, pembeli: c.pembeli, sumber: c.sumber, statusPesanan: normalisasiStatusPesanan(c.status) } : null;
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// Urutan cek status/resi pesanan aktif: resi KOSONG & TERBARU dulu, sisanya bergilir (round-robin)
// supaya tidak selalu pesanan terlama saja yang kebagian kuota per jalan.
function urutkanPrioritasAktif_(daftar, kunciOffset, kapasitas) {
  var kosong = daftar.filter(function (r) { return r.resiKosong; }).sort(function (a, b) { return b.row - a.row; });
  var isi = daftar.filter(function (r) { return !r.resiKosong; }).sort(function (a, b) { return b.row - a.row; });
  if (isi.length) {
    var props = PropertiesService.getScriptProperties();
    var off = (parseInt(props.getProperty(kunciOffset) || '0', 10) || 0) % isi.length;
    isi = isi.slice(off).concat(isi.slice(0, off));
    var terpakai = Math.max(0, kapasitas - kosong.length);
    props.setProperty(kunciOffset, String((off + terpakai) % isi.length));
  }
  return kosong.concat(isi);
}

