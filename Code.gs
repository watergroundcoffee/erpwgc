  } else if (sh.getLastColumn() < 4) {
    sh.getRange(1, 4).setValue('Kontak WA (JSON)').setFontWeight('bold');
  }
  return sh;
}

function getCabangSupplierSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
