// Hitung HPP dengan metode RATA-RATA TERTIMBANG BERGERAK (moving weighted average) -
// diproses urut dari yang paling lama, setiap "Masuk" nambah ke kolam harga, setiap
// "keluar" (Terjual/Opname-kurang/Rusak) ngurangin qty tapi HARGA RATA-RATA TETAP dipakai.
// Versi BULK dari hitungHppWeightedAverage() - baca Stock Ledger CUMA SEKALI buat SEMUA SKU
// sekaligus (bukan 1x per SKU kayak versi single di bawah). Dipakai di halaman yang nampilin
// banyak produk sekaligus (misal Harga) biar nggak kena masalah N+1 query yang bikin lemot
// parah kalau produk & riwayat stock-nya udah banyak.
function hitungSemuaHppWeightedAverage(toko) {
  var peta = {};
  var sh = getStockLedgerSheet(toko);
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return peta;
  var vals = sh.getRange(2, 1, lastRow - 1, 8).getValues();

  var perSku = {};
  vals.forEach(function (row) {
    var sku = String(row[1]).trim();
    if (!sku) return;
    if (!perSku[sku]) perSku[sku] = [];
    perSku[sku].push({ tanggal: row[0], jenis: String(row[2]).trim(), qty: parseFloat(row[3]) || 0, harga: parseFloat(row[7]) || 0 });
  });

  Object.keys(perSku).forEach(function (sku) {
    var baris = perSku[sku];
    baris.sort(function (a, b) { return new Date(a.tanggal) - new Date(b.tanggal); });

    var totalQty = 0, totalNilai = 0;
    var pernahAdaHargaAsli = false; // PENTING: kalau stock masuk-nya nggak pernah dicatat pakai harga
    // (misal input manual tanpa isi harga), jangan anggap HPP-nya "0 valid" - itu bikin nimpa
    // HPP manual/AI yang udah bener. Cuma percaya hasil hitungan ini kalau BENERAN ada harga asli.
    baris.forEach(function (b) {
      if (b.jenis === 'Masuk') {
        if (b.harga > 0) { totalQty += b.qty; totalNilai += b.qty * b.harga; pernahAdaHargaAsli = true; }
        else { totalQty += b.qty; }
      } else {
        var hppSaatIni = totalQty > 0 ? (totalNilai / totalQty) : 0;
        totalQty -= b.qty;
        totalNilai -= b.qty * hppSaatIni;
        if (totalQty < 0) { totalQty = 0; totalNilai = 0; }
      }
    });

    peta[sku] = (pernahAdaHargaAsli && totalQty > 0) ? (totalNilai / totalQty) : null;
  });

  return peta;
}

// Versi SINGLE (1 SKU aja) - masih dipertahankan buat kebutuhan lain yang cuma perlu 1 SKU
// (misal ngecek 1 produk doang), TAPI JANGAN dipanggil di dalam loop banyak produk -
// pakai hitungSemuaHppWeightedAverage() buat itu.
function hitungHppWeightedAverage(sku, toko) {
  var sh = getStockLedgerSheet(toko);
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return null;
  var vals = sh.getRange(2, 1, lastRow - 1, 8).getValues();

  var baris = [];
  vals.forEach(function (row) {
    if (String(row[1]).trim() !== sku) return;
    baris.push({ tanggal: row[0], jenis: String(row[2]).trim(), qty: parseFloat(row[3]) || 0, harga: parseFloat(row[7]) || 0 });
  });
  baris.sort(function (a, b) { return new Date(a.tanggal) - new Date(b.tanggal); });

  var totalQty = 0, totalNilai = 0;
  var pernahAdaHargaAsli = false; // sama kayak versi bulk - jangan anggap 0 valid kalau nggak pernah ada harga asli
  baris.forEach(function (b) {
    if (b.jenis === 'Masuk') {
      if (b.harga > 0) { totalQty += b.qty; totalNilai += b.qty * b.harga; pernahAdaHargaAsli = true; }
      else { totalQty += b.qty; } // stock masuk tanpa harga (misal opname manual) - qty nambah, nilai nggak (netral)
    } else {
      // Terjual Online, Terjual PO Sales, Rusak-Hilang, Opname (dianggap pengurang) - qty berkurang,
      // HPP RATA-RATA TETAP (nggak berubah krn barang keluar, cuma kolamnya ngecil)
      var hppSaatIni = totalQty > 0 ? (totalNilai / totalQty) : 0;
      totalQty -= b.qty;
      totalNilai -= b.qty * hppSaatIni;
      if (totalQty < 0) { totalQty = 0; totalNilai = 0; } // jaga2 data nggak konsisten
    }
  });

  if (!pernahAdaHargaAsli || totalQty <= 0) return null; // stock habis, atau belum pernah ada harga asli - nggak ada dasar buat rata-rata
  return totalNilai / totalQty;
}

// Tambah BANYAK SKU Supplier sekaligus ke 1 SKU Jual - dipisah spasi/koma/baris baru
function prosesTambahSkuSupplierTerhubungMassal_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuJual = String(data.skuJual || '').trim();
    var daftarSkuSupplier = data.daftarSkuSupplier || [];
    if (!skuJual) throw new Error('SKU Jual kosong');
    if (daftarSkuSupplier.length === 0) throw new Error('Nggak ada SKU Supplier yang diisi');

    var sh = getSkuSupplierTerhubungSheet();
    var lastRow = sh.getLastRow();
    var skuSupplierSudahAda = {};
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 2).getValues();
      vals.forEach(function (row) { skuSupplierSudahAda[String(row[1]).trim()] = String(row[0]).trim(); });
    }

    var barisBaru = [];
    var dilewati = [];
    daftarSkuSupplier.forEach(function (skuMentah) {
      var skuSupplier = String(skuMentah || '').trim();
      if (!skuSupplier) return;
      if (skuSupplierSudahAda[skuSupplier]) { dilewati.push(skuSupplier + ' (udah ke ' + skuSupplierSudahAda[skuSupplier] + ')'); return; }
      skuSupplierSudahAda[skuSupplier] = skuJual; // cegah duplikat dalam daftar yang sama juga
      barisBaru.push([skuJual, skuSupplier, String(data.keterangan || '').trim()]);
    });

    if (barisBaru.length > 0) {
      sh.getRange(sh.getLastRow() + 1, 1, barisBaru.length, 3).setValues(barisBaru);
    }

    result.success = true;
    result.jumlahDitambah = barisBaru.length;
    result.dilewati = dilewati;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Kalau SKU di Master Produk KEBETULAN ada spasinya (misal dari copy-paste Excel yang nyampur
// beberapa kode jadi 1 sel), tombol 🔗 di List langsung BACA nilai SKU itu, pecah, kode PERTAMA
// jadi SKU Jual (SKU resmi produk ini), sisanya otomatis didaftarkan sebagai SKU Supplier Terhubung.
function prosesUbahSkuSpasiJadiTerhubung_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuGabungan = String(data.skuGabungan || '').trim();
    if (!skuGabungan) throw new Error('SKU kosong');

    var kodeKode = skuGabungan.split(/[\s,]+/).map(function (s) { return s.trim(); }).filter(function (s) { return s; });
    if (kodeKode.length < 2) throw new Error('SKU ini nggak ada spasinya - nggak ada yang perlu dipisah/dihubungkan');

    var skuUtama = kodeKode[0];
    var skuLainnya = kodeKode.slice(1);

    // Ganti SKU di Master Produk dari gabungan jadi cuma kode pertama (SKU resmi)
    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var rowTarget = -1;
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][0]).trim() === skuGabungan) { rowTarget = i + 2; break; }
    }
    if (rowTarget === -1) throw new Error('SKU ini nggak ketemu di Master Produk');
    sh.getRange(rowTarget, 1).setValue(skuUtama);

    // Daftarkan kode-kode lainnya sebagai SKU Supplier Terhubung ke SKU utama
    var shLink = getSkuSupplierTerhubungSheet();
    var lastRowLink = shLink.getLastRow();
    var sudahAda = {};
    if (lastRowLink > 1) {
      var valsLink = shLink.getRange(2, 1, lastRowLink - 1, 2).getValues();
      valsLink.forEach(function (row) { sudahAda[String(row[1]).trim()] = true; });
    }
    var barisBaru = [];
    skuLainnya.forEach(function (kode) {
      if (sudahAda[kode]) return;
      barisBaru.push([skuUtama, kode, 'Otomatis dari SKU gabungan (spasi)']);
    });
    if (barisBaru.length > 0) {
      shLink.getRange(shLink.getLastRow() + 1, 1, barisBaru.length, 3).setValues(barisBaru);
    }

    result.success = true;
    result.skuUtama = skuUtama;
    result.skuTerhubung = skuLainnya;
  } catch (err) { result.error = err.toString(); }
  return result;
}

