}
function bdlMaster_(toko) {
  var sh = getMasterProdukSheet(toko), lr = sh.getLastRow(), out = {}, utama = {};
  try { utama = petaSkuUtamaSupplier_(); } catch (e) { utama = {}; }
  if (lr > 1) {
    var lebar = Math.max(KAT_KOL_STATUS, 29);
    sh.getRange(2, 1, lr - 1, lebar).getValues().forEach(function (r) {
