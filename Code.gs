      var namaFile = namaFolder + ' - ' + jenis + ' ' + (urutan < 10 ? '0' + urutan : urutan) + ekst.toLowerCase();
      var file = folder.createFile(blobSumber ? Utilities.newBlob(blobSumber.getBytes(), mime, namaFile) : Utilities.newBlob(Utilities.base64Decode(base64), mime, namaFile));
      file.setDescription('Unboxing retur ' + noResi + ' · diunggah ' + (getNamaStaff(data.email) || data.email || ''));
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      var entri = { id: file.getId(), nama: namaFile, mime: mime, url: 'https://drive.google.com/file/d/' + file.getId() + '/view',
        thumb: jenis === 'foto' ? 'https://drive.google.com/thumbnail?id=' + file.getId() + '&sz=w400' : '', t: Date.now() };
      daftar.push(entri);
      var row = d ? d.row : sh.getLastRow() + 1;
      if (!d) { sh.getRange(row, 1, 1, 3).setNumberFormat('@'); sh.getRange(row, 1, 1, RETUR_DETAIL_HEADER.length).setValues([[noResi, '', '', '', '[]', '[]', '[]', '', '', '']]); }
      sh.getRange(row, jenis === 'video' ? 7 : 6).setValue(JSON.stringify(daftar));
      sh.getRange(row, 8, 1, 2).setValues([[new Date(), getNamaStaff(data.email) || data.email || '']]);
      result.success = true;
      result.file = entri;
      result.folderUrl = folder.getUrl();
    } finally { lepasKunci_(lock); }
  } catch (err) { result.error = err.toString(); }
