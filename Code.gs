function prosesReturKlaimSimpan(data) {
  var noResi, tahap;
  return withTransaction(data.email, 'buatInvoice', ['pengiriman', 'keuangan'], function (ktx) {
    var sh = getReturDetailSheet_();
    returPastikanKolomEkstra_(sh);
    var d = returBacaDetail_()[kunciResi_(noResi)];
    var row = d ? d.row : sh.getLastRow() + 1;
    if (!d) { sh.getRange(row, 1, 1, 3).setNumberFormat('@'); sh.getRange(row, 1, 1, RETUR_DETAIL_HEADER.length).setValues([[noResi, '', '', '', '[]', '[]', '[]', new Date(), '', '']]); }
    var lama = (d && d.klaim) || {}, oleh = ktx.namaStaff() || data.email || '', sekarang = new Date();
    var nilai = Math.max(0, Math.round(Number(data.nilai) || 0));
    if (tahap === 'Disetujui' && !(nilai > 0)) throw new Error('Isi nilai ganti rugi yang disetujui marketplace.');
    var k = { tahap: tahap, noKlaim: String(data.noKlaim || '').trim().slice(0, 60), nilai: nilai, catatan: String(data.catatan || '').trim().slice(0, 500),
      kanal: String(data.kanal || lama.kanal || '').slice(0, 40), refJurnal: String(lama.refJurnal || ''), riwayat: Array.isArray(lama.riwayat) ? lama.riwayat.slice(0, 29) : [] };
    var hk = p10HasilKlaim_(tahap, 'Rp ' + nilai.toLocaleString('id-ID'));
    k.hasil = hk.hasil; k.akuntansi = hk.akuntansi;
    // v2026.10.24 (DN-172826-154): ongkos kirim retur yang dibebankan ke penjual + banding ke marketplace
    var on = data.ongkir && typeof data.ongkir === 'object' ? data.ongkir : (lama.ongkir || null);
    if (on) {
      var onLama = lama.ongkir || {};
      k.ongkir = { nilai: Math.max(0, Math.round(Number(on.nilai) || 0)), banding: P11_BANDING_.indexOf(String(on.banding)) !== -1 ? String(on.banding) : 'Tidak diajukan', refJurnal: String(onLama.refJurnal || '') };
      p11JurnalOngkirRetur_(k.ongkir, noResi, d, oleh, sekarang);
    }
    // Jurnal Pendapatan Klaim: sekali, disesuaikan, atau dibatalkan
    var shJ = getJurnalTransaksiSheet(), rowJ = parseInt(String(k.refJurnal).replace(/\D/g, ''), 10) || 0;
    var jAktif = rowJ >= 2 && rowJ <= shJ.getLastRow() && String(shJ.getRange(rowJ, 4).getValue()).trim() === 'Masuk' && String(shJ.getRange(rowJ, 7).getValue()).trim() === 'Klaim Retur';
    var ketJ = 'Klaim retur ' + noResi + (k.noKlaim ? ' · No klaim ' + k.noKlaim : '') + (d && d.idManual ? ' · pesanan ' + d.idManual : '');
    if (tahap === 'Disetujui') {
      if (jAktif) { if (Math.round(Number(shJ.getRange(rowJ, 5).getValue()) || 0) !== nilai) shJ.getRange(rowJ, 5, 1, 2).setValues([[nilai, ketJ]]); }
      else {
        rowJ = shJ.getLastRow() + 1;
        shJ.getRange(rowJ, 1, 1, 8).setValues([[sekarang, MRK_AKUN_PENDAPATAN_KLAIM, 'Pendapatan', 'Masuk', nilai, ketJ, 'Klaim Retur', '']]);
        k.refJurnal = 'Jurnal baris ' + rowJ;
        try {
          var shA = getBaganAkunSheet(), lrA = shA.getLastRow(), ada = false;
          if (lrA > 1) ada = shA.getRange(2, 1, lrA - 1, 1).getValues().some(function (a) { return String(a[0]).trim().toLowerCase() === MRK_AKUN_PENDAPATAN_KLAIM.toLowerCase(); });
          if (!ada) shA.appendRow([MRK_AKUN_PENDAPATAN_KLAIM, 'Pendapatan', 'Ganti rugi klaim barang rusak/kurang dari supplier/kurir (7-102)']);
        } catch (eA) { }
      }
    } else if (jAktif) {
      shJ.getRange(rowJ, 4).setValue('Dihapus');
      shJ.getRange(rowJ, 6).setValue(String(shJ.getRange(rowJ, 6).getValue()) + ' [dibatalkan ' + Utilities.formatDate(sekarang, Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm') + ' oleh ' + oleh + ']');
      k.refJurnal = k.refJurnal + ' (dibatalkan)';
    }
    if (tahap !== lama.tahap || k.catatan !== (lama.catatan || '') || nilai !== (Number(lama.nilai) || 0)) k.riwayat.unshift({ t: sekarang.getTime(), tahap: tahap, oleh: oleh, catatan: k.catatan.slice(0, 120), nilai: nilai });
    k.diubah = sekarang.getTime(); k.oleh = oleh;
    sh.getRange(row, 12).setValue(JSON.stringify(k));
    try { finInvalidasi_(); } catch (eF) { }
