function prosesLihatCabangSupplier(data) {
  var result = { success: false };
  try {
    var namaSupplier = String(data.namaSupplier || '').trim();
    var sh = getCabangSupplierSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var values = sh.getRange(2, 1, lastRow - 1, 4).getValues();
      for (var i = 0; i < values.length; i++) {
        if (namaSupplier && String(values[i][0]).trim() !== namaSupplier) continue;
        var namaCabang = String(values[i][1] || '').trim();
        if (!namaCabang) continue;
        daftar.push({ row: i + 2, namaSupplier: values[i][0], namaCabang: namaCabang, alamat: values[i][2], kontak: values[i][3] });
      }
    }
    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ===== Simpan Invoice Supplier (setelah direview/dikoreksi user) + Rekonsiliasi ===== */
function prosesSimpanInvoiceSupplier(data) {
  return withTransaction(data.email, 'mintaStock', 'pembelian', function () {
    var result = { success: false };
    var namaSupplier = String(data.namaSupplier || '').trim();
    var namaCabang = String(data.namaCabang || '').trim();
    var tanggal = data.tanggal ? new Date(data.tanggal) : new Date();
    var items = data.items || [];
    var namaStaff = getNamaStaff(data.email);

    if (!namaSupplier) throw new Error('Nama supplier kosong');
    if (items.length === 0) throw new Error('Belum ada item/produk');

    var sheets = getInvoiceSupplierSheets();
    var noInvoiceSupplier = String(data.noInvoice || '').trim() || ('INV-' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMddHHmmss'));

    var total = 0;
    items.forEach(function (it) { total += (parseFloat(it.qty) || 0) * (parseFloat(it.harga) || 0); });

    // Upload gambar ke Drive (kalau ada)
    var linkGambar = '';
    if (data.gambarBase64) {
      try {
        var folder = getFolderInvoiceSupplier();
        var decoded = Utilities.base64Decode(data.gambarBase64);
        var blob = Utilities.newBlob(decoded, data.mimeType || 'image/jpeg', noInvoiceSupplier + '.jpg');
        var file = folder.createFile(blob);
        file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
        linkGambar = file.getUrl();
      } catch (driveErr) {
        linkGambar = ''; // gagal upload gambar bukan alasan buat batal simpan datanya
      }
    }

    // Rekonsiliasi tiap item terhadap Stock Ledger (Masuk) berdasarkan SKU + tanggal berdekatan
    var adaSelisih = false;
    var catatanSelisih = [];
    var detailRows = items.map(function (it) {
      var sku = String(it.sku || '').trim();
      var qty = parseFloat(it.qty) || 0;
      var nama = String(it.nama || '').trim();
      var cek = sku ? cekKecocokanStockMasuk(sku, tanggal, qty, data.toko) : { status: 'SKU Kosong' };
      if (cek.status !== 'Cocok') {
        adaSelisih = true;
        catatanSelisih.push(sku + ': ' + cek.status);
      }
      // Nama produk dari invoice supplier otomatis jadi nama produk di Master Produk
      if (sku && nama) {
        upsertNamaMasterProduk(sku, nama, data.toko);
      }
      return [noInvoiceSupplier, sku, nama, qty, parseFloat(it.harga) || 0, cek.status];
    });

    var headerRow = sheets.header.getLastRow() + 1;
    sheets.header.getRange(headerRow, 1).setNumberFormat('@');
    sheets.header.getRange(headerRow, 1, 1, 9).setValues([[
      noInvoiceSupplier, tanggal, namaSupplier, namaCabang, total, linkGambar,
      adaSelisih ? 'Ada Selisih' : 'Cocok', catatanSelisih.join('; '), namaStaff
    ]]);

    var startRowDetail = sheets.detail.getLastRow() + 1;
    sheets.detail.getRange(startRowDetail, 2, detailRows.length, 1).setNumberFormat('@');
    sheets.detail.getRange(startRowDetail, 1, detailRows.length, 6).setValues(detailRows);

    result.success = true;
    result.noInvoiceSupplier = noInvoiceSupplier;
    result.adaSelisih = adaSelisih;
    result.catatanSelisih = catatanSelisih;
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// Cek 1 item invoice supplier terhadap Stock Ledger - cari entri "Masuk" dengan SKU sama
// dalam jarak +/- 5 hari dari tanggal invoice, bandingkan qty
function cekKecocokanStockMasuk(sku, tanggalInvoice, qtyInvoice, toko) {
  var sh = getStockLedgerSheet(toko);
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return { status: 'Belum Ada Stock Masuk' };

  var vals = sh.getRange(2, 1, lastRow - 1, 4).getValues();
  var msPerHari = 24 * 60 * 60 * 1000;
  var kandidat = [];

  for (var i = 0; i < vals.length; i++) {
    if (String(vals[i][1]).trim() !== sku) continue;
    if (String(vals[i][2]).trim() !== 'Masuk') continue;
    var tglLedger = vals[i][0];
    if (!(tglLedger instanceof Date)) continue;
    var selisihHari = Math.abs((tglLedger - tanggalInvoice) / msPerHari);
    if (selisihHari <= 5) {
      kandidat.push({ qty: parseFloat(vals[i][3]) || 0, selisihHari: selisihHari });
    }
  }

  if (kandidat.length === 0) return { status: 'Belum Ada Stock Masuk' };

  // Cari kandidat dengan qty paling cocok
  var totalQtyKandidat = 0;
  kandidat.forEach(function (k) { totalQtyKandidat += k.qty; });

  if (Math.abs(totalQtyKandidat - qtyInvoice) < 0.01) {
    return { status: 'Cocok' };
  }
  return { status: 'Selisih Qty (Invoice: ' + qtyInvoice + ', Stock Masuk: ' + totalQtyKandidat + ')' };
}

function prosesLihatInvoiceSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sheets = getInvoiceSupplierSheets();
    var sh = sheets.header;
    var lastRow = sh.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var values = sh.getRange(2, 1, lastRow - 1, 9).getValues();
      for (var i = 0; i < values.length; i++) {
        var noInv = String(values[i][0] || '').trim();
        if (!noInv) continue;
        daftar.push({
          row: i + 2, noInvoice: noInv,
          tanggal: values[i][1] instanceof Date ? Utilities.formatDate(values[i][1], Session.getScriptTimeZone(), 'dd MMM yyyy') : String(values[i][1] || ''),
          namaSupplier: values[i][2], namaCabang: values[i][3], total: values[i][4],
          linkGambar: values[i][5], statusRekonsiliasi: values[i][6], catatanSelisih: values[i][7], dicatatOleh: values[i][8]
        });
      }
    }
    daftar.reverse();
    result.success = true;
    result.daftar = daftar.slice(0, 50);
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

