    var s = stok[m.sku.toUpperCase()] || 0, bisa = Math.floor(Math.max(0, s) / Math.max(1, x.qty));
    maks = maks === null ? bisa : Math.min(maks, bisa);
    hpp += m.hpp * x.qty; harga += m.harga * x.qty;
