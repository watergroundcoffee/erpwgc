}

// Hitung ulang stock utk 1 SKU tertentu (dipakai buat konfirmasi setelah input)
function hitungStockSatuSku(skuTarget, toko) {
  var sh = getStockLedgerSheet(toko);
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return 0;

  var vals = sh.getRange(2, 1, lastRow - 1, 4).getValues();
  var entries = [];
  for (var i = 0; i < vals.length; i++) {
    if (String(vals[i][1]).trim() !== skuTarget) continue;
    entries.push({ tgl: vals[i][0], jenis: vals[i][2], qty: parseFloat(vals[i][3]) || 0 });
  }
  entries.sort(function (a, b) { return a.tgl - b.tgl; });

  var baseline = 0, sudahOpname = false, masukSesudah = 0;
  for (var j = 0; j < entries.length; j++) {
    var e = entries[j];
    if (e.jenis === 'Opname') {
      baseline = e.qty;
      sudahOpname = true;
      masukSesudah = 0;
    } else if (e.jenis === 'Masuk') {
      if (sudahOpname) masukSesudah += e.qty;
      else baseline += e.qty;
    } else if (e.jenis === 'Rusak/Hilang' || e.jenis === 'Terjual Online' || e.jenis === 'Terjual PO Sales' || e.jenis === 'Transfer Gudang Shopee' || e.jenis === 'Pemakaian Produksi') {
      if (sudahOpname) masukSesudah -= e.qty;
      else baseline -= e.qty;
    }
  }
  return baseline + masukSesudah;
}

function prosesLihatStock(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    // FIX LAMBAT: dulu cache.put() biasa (batas 100 KB per nilai). Daftar stock semua SKU (nama, harga modal,
    // URL supplier) hampir selalu > 100 KB -> cache GAGAL diam-diam -> SELURUH Stock Ledger dibaca ulang
    // tiap panggilan (termasuk tiap scan SKU di Stock Opname / Minta Stock mobile). Sekarang pakai cache besar
    // (gzip + dipecah) sehingga benar-benar tersimpan.
    var cacheKey = 'POSISI_STOCK_' + (data.toko || 'default');
    var dariCache = cacheBesarGet_(cacheKey);
    if (dariCache && dariCache.success) return dariCache;

    // S1: angka stok diambil dari MESIN STOK BARU (sama persis dengan Monitor Stok). Format hasil tetap sama
    // (sku, nama, stockSaatIni, opnameTerakhir, hargaModal, urlSupplier) supaya semua pemanggil lama aman.
    // Kalau mesin baru gagal karena alasan apa pun, jatuh ke perhitungan ledger lama di bawah.
    if (SM_STOK_LAMA_PAKAI_MESIN_BARU) {
      try {
        var snapB = cacheBesarGet_(SM_CACHE_PETA_STOK);
        if (!snapB || snapB.versi !== smVersiStok_() || (Date.now() - (snapB.dihitungMs || 0)) > SM_PETA_SEGAR_DETIK * 1000) snapB = smHitungPetaStok_();
        var shMB = getMasterProdukSheet(data.toko), lrMB = shMB.getLastRow(), infoMB = {};
        if (lrMB > 1) shMB.getRange(2, 1, lrMB - 1, 5).getValues().forEach(function (m) {
          var k = String(m[0] || '').trim(); if (k) infoMB[k] = { nama: String(m[1] || '').trim(), hm: m[3] || 0, url: String(m[4] || '').trim() };
        });
        var daftarB = Object.keys(snapB.peta).map(function (sku) {
          var x = snapB.peta[sku], mi = infoMB[sku] || {};
          return {
            sku: sku, nama: mi.nama || x.nama || '(nama tidak ditemukan di Master Produk)', stockSaatIni: x.onHand,
            onReserve: x.onReserve, onAvailable: x.onAvailable,
            opnameTerakhir: x.opnameTerakhir || 'Belum pernah di-opname', hargaModal: mi.hm || 0, urlSupplier: mi.url || ''
          };
        });
        daftarB.sort(function (a, b) { return a.sku.localeCompare(b.sku); });
        result.success = true;
        result.daftar = daftarB;
        result.sumber = 'mesin-stok-v2';
        cacheBesarPut_(cacheKey, result, 90);
        return result;
      } catch (eBaru) { Logger.log('Mesin stok baru gagal, pakai ledger lama: ' + eBaru); result = { success: false }; }
    }

    var sh = getStockLedgerSheet(data.toko);
    var lastRow = sh.getLastRow();
    var daftar = [];

    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 6).getValues();
      var grouped = {};
      for (var i = 0; i < vals.length; i++) {
        var sku = String(vals[i][1] || '').trim();
        if (!sku) continue;
        if (!grouped[sku]) grouped[sku] = [];
        grouped[sku].push({ tgl: vals[i][0], jenis: vals[i][2], qty: parseFloat(vals[i][3]) || 0 });
      }

      // Ambil nama produk dari Master Produk sekali aja (jangan per-SKU biar cepat)
      var shMaster = getMasterProdukSheet(data.toko);
      var namaMap = {};
      var hargaModalMap = {};
      var urlSupplierMap = {};
      var lastRowMaster = shMaster.getLastRow();
      if (lastRowMaster > 1) {
        var masterVals = shMaster.getRange(2, 1, lastRowMaster - 1, 5).getValues();
        for (var m = 0; m < masterVals.length; m++) {
          var skuM = String(masterVals[m][0]).trim();
          namaMap[skuM] = String(masterVals[m][1] || '').trim();
          hargaModalMap[skuM] = masterVals[m][3] || 0;
          urlSupplierMap[skuM] = String(masterVals[m][4] || '').trim();
        }
      }

      Object.keys(grouped).forEach(function (sku) {
        var entries = grouped[sku];
        entries.sort(function (a, b) { return a.tgl - b.tgl; });

        var baseline = 0, sudahOpname = false, masukSesudah = 0, tglOpnameTerakhir = null;
        for (var j = 0; j < entries.length; j++) {
          var e = entries[j];
          if (e.jenis === 'Opname') {
            baseline = e.qty;
            sudahOpname = true;
            tglOpnameTerakhir = e.tgl;
            masukSesudah = 0;
          } else if (e.jenis === 'Masuk') {
            if (sudahOpname) masukSesudah += e.qty;
            else baseline += e.qty;
          } else if (e.jenis === 'Rusak/Hilang' || e.jenis === 'Terjual Online' || e.jenis === 'Terjual PO Sales' || e.jenis === 'Transfer Gudang Shopee' || e.jenis === 'Pemakaian Produksi') {
            if (sudahOpname) masukSesudah -= e.qty;
            else baseline -= e.qty;
          }
        }

        daftar.push({
          sku: sku,
          nama: namaMap[sku] || '(nama tidak ditemukan di Master Produk)',
          stockSaatIni: baseline + masukSesudah,
          opnameTerakhir: tglOpnameTerakhir
            ? Utilities.formatDate(tglOpnameTerakhir, Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm')
            : 'Belum pernah di-opname',
          hargaModal: hargaModalMap[sku] || 0,
          urlSupplier: urlSupplierMap[sku] || ''
        });
      });
    }

    daftar.sort(function (a, b) { return a.sku.localeCompare(b.sku); });
    result.success = true;
    result.daftar = daftar;
    cacheBesarPut_(cacheKey, result, 90);
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

