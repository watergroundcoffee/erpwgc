    var lock = kunciModul_('penjualan');
    if (lock.tryLock(15000)) {
      try {
        var sh = getTtbAntreSheet_(), a = ttbBacaSheet_(sh, TTB_ANTRE_HEADER_.length), kini = new Date();
        Object.keys(statusAntre).forEach(function (k) {
          var row = a.peta[k];
          if (!row) return;
          var r = a.baris[row - 2], n = (Number(r[5]) || 0) + 1, s = statusAntre[k];
          if (s.ok) sh.getRange(row, 6, 1, 5).setValues([[n, 'Selesai', 0, 'Terbaca dari label', kini]]);
          else sh.getRange(row, 6, 1, 4).setValues([[n, n >= TTB_ANTRE_MAKS_COBA_ ? 'Gagal' : 'Menunggu', Date.now() + 60 * 60000, s.catatan]]);
        });
        SpreadsheetApp.flush();
      } finally { lepasKunci_(lock); }
    }
    return { success: true, terbaca: tersimpan, pesananTerisi: terisi, diproses: Object.keys(statusAntre).length };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}
