}

/* ---------- Pisahkan blok JSON aksi dari teks LLM (port dari ocPisahkanAksi di frontend) ---------- */
function aiwPisahkanAksi_(teks) {
  var aksi = [];
  function ambil(obj) {
    var list = Array.isArray(obj) ? obj : [obj], ada = false;
    list.forEach(function (o) {
      if (o && typeof o === 'object' && (o.tool_call === 'execute_action' || (o.action && o.params && !o.tool_call))) { aksi.push(o); ada = true; }
    });
    return ada;
  }
  var bersih = String(teks || '').replace(/```(?:json|JSON)?\s*([\s\S]*?)```/g, function (utuh, isi) {
    try { return ambil(JSON.parse(String(isi).trim())) ? '\n' : utuh; } catch (e) { return utuh; }
  });
  var idx, guard = 0;
  while ((idx = bersih.indexOf('"tool_call"')) !== -1 && guard++ < 10) {
    var awal = bersih.lastIndexOf('{', idx);
    if (awal === -1) break;
    var dalam = 0, akhir = -1, diString = false;
    for (var i = awal; i < bersih.length; i++) {
      var c = bersih.charAt(i);
      if (c === '"' && bersih.charAt(i - 1) !== '\\') diString = !diString;
      if (diString) continue;
      if (c === '{') dalam++;
      else if (c === '}') { dalam--; if (dalam === 0) { akhir = i; break; } }
    }
    if (akhir === -1) break;
    var berhasil = false;
    try { berhasil = ambil(JSON.parse(bersih.slice(awal, akhir + 1))); } catch (e) { berhasil = false; }
    if (!berhasil) break;
    bersih = bersih.slice(0, awal) + bersih.slice(akhir + 1);
  }
  return { teks: bersih.replace(/\n{3,}/g, '\n\n').trim(), aksi: aksi };
}
function aiwBuatKartu_(a) {
  var act = String(a.action || '').toUpperCase().trim();
  return {
    card_id: 'CRD-' + Utilities.getUuid().replace(/-/g, '').slice(0, 12).toUpperCase(),
    action: act, params: (a.params && typeof a.params === 'object') ? a.params : {}, alasan: String(a.alasan || '').slice(0, 600),
    status: AIW_AKSI_BACA_[act] ? 'BACA' : 'PROPOSED', dibuat: new Date().toISOString(), hasil: null
  };
}
function aiwRingkasKartu_(c) {
  var p = JSON.stringify(c.params || {});
  return '[USULAN AKSI ' + c.action + ' ' + p.slice(0, 220) + '] status: ' + c.status + (c.hasil && c.hasil.pesan ? ' - ' + String(c.hasil.pesan).slice(0, 300) : '');
}

/* ---------- Riwayat untuk LLM: ringkasan + jendela pesan terakhir (konteks per thread) ---------- */
function aiwRiwayatUntukLLM_(sesi, pesan) {
  var rw = [];
  if (sesi.ringkasan) rw.push({ role: 'user', content: '[RINGKASAN PERCAKAPAN SEBELUMNYA DI THREAD INI - jadikan konteks, jangan diulang]\n' + sesi.ringkasan });
  pesan.filter(function (m) { return m.seq > sesi.ringkasanSampai; }).slice(-AIW_JENDELA_PESAN_).forEach(function (m) {
    if (m.role === 'user') rw.push({ role: 'user', content: m.konten });
    else if (m.role === 'assistant') {
      var info = (m.cards || []).map(aiwRingkasKartu_).join('\n');
      rw.push({ role: 'assistant', content: m.konten + (info ? '\n\n' + info : '') });
    }
  });
  return rw;
}

