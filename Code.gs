// Dipanggil otomatis oleh doGet() setelah Shopee redirect balik dengan ?code=...&shop_id=...
// Tukar "auth code" jadi Access Token + Refresh Token, simpan di Script Properties (rahasia).


// Access token Shopee cuma valid 4 jam - fungsi ini bikin token baru pakai refresh_token yang tersimpan.
function refreshTokenShopee() {
  var props = PropertiesService.getScriptProperties();
  var refreshToken = props.getProperty('SHOPEE_REFRESH_TOKEN');
  var shopId = props.getProperty('SHOPEE_SHOP_ID');
  if (!refreshToken || !shopId) {
    Logger.log('❌ Belum ada refresh token / shop id tersimpan. Selesaikan otorisasi dulu di halaman Pengaturan.');
    return;
  }
  try {
    var path = '/api/v2/auth/access_token/get';
    var timestamp = Math.floor(Date.now() / 1000);
    var signature = buatSignatureShopee(path, timestamp);
    var url = getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + timestamp + '&sign=' + signature;
    var bodyObjek = { refresh_token: refreshToken, shop_id: parseInt(shopId, 10), partner_id: parseInt(getShopeePartnerId(), 10) };
    var res = fetchHemat(url, { method: 'post', contentType: 'application/json', payload: JSON.stringify(bodyObjek), muteHttpExceptions: true });
    var data = JSON.parse(res.getContentText());
    if (!data.access_token) {
      Logger.log('❌ Gagal refresh token: ' + res.getContentText());
      CacheService.getScriptCache().put('SHOPEE_REFRESH_GAGAL', '1', 15 * 60); // jangan coba lagi tiap 5 menit
      return;
    }
    props.setProperty('SHOPEE_ACCESS_TOKEN', data.access_token);
    props.setProperty('SHOPEE_REFRESH_TOKEN', data.refresh_token);
    props.setProperty('SHOPEE_TOKEN_EXPIRED_AT', String(Date.now() + (data.expire_in * 1000)));
    hapusCacheKredensialShopee();
    Logger.log('✅ Token Shopee berhasil di-refresh.');
  } catch (err) {
    Logger.log('❌ Error: ' + err.toString());
    try { CacheService.getScriptCache().put('SHOPEE_REFRESH_GAGAL', '1', 15 * 60); } catch (e) {}
  }
}

// Dipanggil oleh trigger otomatis (lihat aktifkanRefreshShopeeOtomatis) - cuma refresh kalau
// tokennya bakal expired dalam 10 menit ke depan, biar nggak refresh terus-terusan tiap jam.
function refreshTokenShopeeOtomatis() {
  var props = PropertiesService.getScriptProperties();
  var expiredAt = parseInt(props.getProperty('SHOPEE_TOKEN_EXPIRED_AT') || '0', 10);
  if (Date.now() <= expiredAt - (10 * 60 * 1000)) return; // token masih aman - NOL panggilan API
  // Refresh barusan gagal (misal refresh token invalid) -> tunggu 15 menit, jangan nembak tiap sync
  if (CacheService.getScriptCache().get('SHOPEE_REFRESH_GAGAL')) return;
  refreshTokenShopee();
}

// JALANKAN INI SEKALI (lewat editor Apps Script) buat aktifkan auto-refresh token Shopee tiap 1 jam,
// biar token nggak pernah keburu expired (batasnya 4 jam) walau nggak ada yang buka app.
function aktifkanRefreshShopeeOtomatis() {
  var triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(function (t) { if (t.getHandlerFunction() === 'refreshTokenShopeeOtomatis') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('refreshTokenShopeeOtomatis').timeBased().everyHours(1).create();
  Logger.log('✅ Auto-refresh token Shopee (tiap 1 jam) sudah aktif.');
}

