    var sh = rstSheet_(RST_SH_KEMASAN, RST_HDR_KEMASAN, [1, 3]);
    var ada = rstBacaKemasan_().filter(function (x) { return x.sku.toUpperCase() === m.sku.toUpperCase(); })[0];
    var baris = [m.sku, m.nama, src.sku, gram, lebih, JSON.stringify(bk), porsi, k.aktif !== false, new Date(), rstNamaOleh_(data.email)];
    if (ada) sh.getRange(ada.row, 1, 1, baris.length).setValues([baris]);
    else { var row = sh.getLastRow() + 1; sh.getRange(row, 1, 1, 3).setNumberFormat('@'); sh.getRange(row, 1, 1, baris.length).setValues([baris]); }
    return { success: true, sku: m.sku };
