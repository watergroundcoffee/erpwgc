}

/* ============================================================
   IMPORT DATA PEMBELI LAMA (Excel/CSV tidak rapi) -> dirapikan AI (Gemini, paket gratis) -> Data Pembeli
   Alur: browser memecah file per baris + mengambil No HP & tanggal sendiri (No HP TIDAK dikirim ke AI)
   -> analisa_import_pembeli (maks 40 baris / panggilan) -> pratinjau & edit -> simpan_import_pembeli.
   ============================================================ */
var IMPORT_PEMBELI_MAKS_SIMPAN_ = 400;

/* =====================================================================
   AI FRAMEWORK GRATIS (AIF) - SATU-SATUNYA jalur untuk semua "baca dokumen" di ERP
   (import data pembeli, foto invoice supplier, foto struk biaya, dan pekerjaan baca dokumen berikutnya).
   - Kunci WAJIB dari Script Property GEMINI_FREE_API_KEY (project Google AI Studio TANPA billing = tidak
     mungkin ditagih). TIDAK PERNAH jatuh ke GEMINI_API_KEY berbayar - kalau belum dipasang, fitur menolak.
   - Opsional: GEMINI_FREE_MODEL (default gemini-3.6-flash), GEMINI_FREE_RPM (default 8),
     GEMINI_FREE_RPD (default 400). Isi sesuai angka "Rate limit" project Anda di AI Studio.
   - Pembatas kecepatan sendiri (per menit & per hari, hari = zona waktu Pasifik seperti kuota Google)
     supaya tidak pernah menembak kuota; kalau Google tetap membalas 429, pekerjaan ditunda, bukan gagal.
   - Pekerjaan besar masuk ANTRIAN (sheet "Antrian AI" + "Antrian AI Item") yang diproses trigger tiap
     1 menit di latar belakang. Bisa ditinggal; progres & log terlihat di dasbor (tombol 🤖 Antrian AI).
   ===================================================================== */
var AIF_MODEL_DEFAULT_ = 'gemini-3.6-flash';
var AIF_STATUS_AKTIF_ = ['Menunggu', 'Diproses', 'Menunggu kuota', 'Tertunda'];
var AIF_MAKS_PERCOBAAN_ITEM_ = 4;

function aifKonfig_() {
  var p = PropertiesService.getScriptProperties();
  var angka = function (n, d) { var v = parseInt(p.getProperty(n), 10); return v > 0 ? v : d; };
  var rehan = aiAgentKey_('rehan'); // key, model, provider & base URL agent Rehan (bebas: Gemini, Anthropic, OpenAI, dll)
  return {
    key: rehan.key, model: rehan.model, provider: rehan.provider, baseUrl: rehan.baseUrl,
    rpm: angka('GEMINI_FREE_RPM', 8), rpd: angka('GEMINI_FREE_RPD', 400)
  };
}
function aifSiap_() { return !!aifKonfig_().key; }
function aifErr_(kode, pesan, tunggu) { var e = new Error(pesan); e.aifKode = kode; e.tunggu = tunggu || 0; return e; }
function aifHariPT_() { return Utilities.formatDate(new Date(), 'America/Los_Angeles', 'yyyy-MM-dd'); }
function aifPemakaian_() {
  var hari = aifHariPT_(), p = {};
  try { p = JSON.parse(PropertiesService.getScriptProperties().getProperty('AIF_PEMAKAIAN') || '{}'); } catch (e) { }
  if (p.d !== hari) p = { d: hari, n: 0, t: 0, habis: 0 };
  return p;
}
function aifSimpanPemakaian_(p) { PropertiesService.getScriptProperties().setProperty('AIF_PEMAKAIAN', JSON.stringify(p)); }
function aifMenitKey_() { return 'AIF_M_' + Math.floor(Date.now() / 60000); }
function aifCekKuota_(cfg) {
  var p = aifPemakaian_();
  if (p.habis || p.n >= cfg.rpd) return { ok: false, alasan: 'hari', tunggu: 3600 };
  var n = parseInt(CacheService.getScriptCache().get(aifMenitKey_()) || '0', 10);
  if (n >= cfg.rpm) return { ok: false, alasan: 'menit', tunggu: 61 - new Date().getSeconds() };
  return { ok: true };
}
function aifCatat_(token, habisHari) {
  var c = CacheService.getScriptCache(), k = aifMenitKey_();
  c.put(k, String(parseInt(c.get(k) || '0', 10) + 1), 120);
  var p = aifPemakaian_();
  p.n++; p.t += token || 0; if (habisHari) p.habis = 1;
  aifSimpanPemakaian_(p);
}
var AIF_PESAN_HARI_ = 'Kuota harian AI gratis habis - lanjut otomatis setelah kuota Google reset (sekitar jam 14:00-15:00 WIB).';

// opsi: { prompt, gambar: {mime, base64}, json: true/false, suhu, maksToken, tungguMaks (detik boleh menunggu kuota menit) }
function aifPanggil_(opsi) {
  var cfg = aifKonfig_();
  if (!cfg.key) throw aifErr_('BELUM_SIAP', 'Key agent Rehan belum diisi - atur di menu AI Agent > 🔑 Agent Keys, lalu coba lagi.');
  var q = aifCekKuota_(cfg);
  if (!q.ok) {
    if (q.alasan === 'menit' && (opsi.tungguMaks || 0) >= q.tunggu) { Utilities.sleep(q.tunggu * 1000 + 300); }
    else throw aifErr_(q.alasan === 'hari' ? 'KUOTA_HARI' : 'KUOTA_MENIT', q.alasan === 'hari' ? AIF_PESAN_HARI_ : 'Batas per menit agent Rehan tercapai - menunggu giliran.', q.tunggu);
  }
  if (cfg.provider !== 'gemini') {
    // Provider selain Gemini (Anthropic / OpenAI / OpenRouter / Groq / endpoint kustom) lewat adapter universal
    var hasilU;
    try {
      hasilU = aiPanggilUniversal_(cfg, { prompt: opsi.prompt, gambar: opsi.gambar, json: !!opsi.json, suhu: opsi.suhu == null ? 0.1 : opsi.suhu, maksToken: opsi.maksToken || 8192 });
    } catch (eU) {
      var kU = eU.httpKode || 0;
      if (kU === 429) { aifCatat_(0, false); throw aifErr_('KUOTA_MENIT', 'Provider membatasi kecepatan (429) - menunggu giliran.', 60); }
      if (kU >= 500) throw aifErr_('SIBUK', 'Server ' + aiProviderLabel_(cfg.provider) + ' sedang sibuk (' + kU + ') - dicoba lagi otomatis.', 20);
      throw aifErr_('KONFIG', 'Agent Rehan (' + aiProviderLabel_(cfg.provider) + ') menolak: ' + String(eU.message || eU).slice(0, 220));
    }
    aifCatat_(hasilU.usage.in + hasilU.usage.out, false);
    if (!opsi.json) return hasilU.teks;
    try { return aiParseJsonLonggar_(hasilU.teks); } catch (eJ) { throw aifErr_('FORMAT', 'Balasan AI bukan JSON yang utuh.'); }
  }
  var parts = [{ text: String(opsi.prompt || '') }];
  if (opsi.gambar && opsi.gambar.base64) parts.push({ inline_data: { mime_type: opsi.gambar.mime || 'image/jpeg', data: opsi.gambar.base64 } });
  var gen = { temperature: opsi.suhu == null ? 0.1 : opsi.suhu, maxOutputTokens: opsi.maksToken || 8192 };
  if (opsi.json) gen.responseMimeType = 'application/json';
  var url = 'https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(cfg.model) + ':generateContent';
  var res = fetchHemat(url, { method: 'post', contentType: 'application/json', headers: { 'x-goog-api-key': cfg.key },
    payload: JSON.stringify({ contents: [{ parts: parts }], generationConfig: gen }), muteHttpExceptions: true });
  var kode = res.getResponseCode(), isi = res.getContentText();
  if (kode === 429) {
    var harian = /per.?day|PerDay|daily/i.test(isi);
    aifCatat_(0, harian);
    var m = isi.match(/"retryDelay"\s*:\s*"(\d+)/);
    throw aifErr_(harian ? 'KUOTA_HARI' : 'KUOTA_MENIT', harian ? AIF_PESAN_HARI_ : 'Google membatasi kecepatan (429) - menunggu giliran.', m ? parseInt(m[1], 10) + 2 : 60);
  }
  if (kode >= 500) throw aifErr_('SIBUK', 'Server Gemini sedang sibuk (' + kode + ') - dicoba lagi otomatis.', 20);
  if (kode !== 200) {
    var ket = /API key not valid|API_KEY_INVALID/i.test(isi) ? 'API key agent Rehan tidak valid.' :
      (/not found|is not supported/i.test(isi) ? 'Model "' + cfg.model + '" tidak tersedia - ganti model agent Rehan.' : String(isi).substring(0, 200));
    throw aifErr_('KONFIG', 'Agent Rehan menolak (kode ' + kode + '): ' + ket);
  }
  var d = JSON.parse(isi);
  aifCatat_(d.usageMetadata ? d.usageMetadata.totalTokenCount : 0, false);
  var teks = d.candidates && d.candidates[0] && d.candidates[0].content && d.candidates[0].content.parts ?
    d.candidates[0].content.parts.map(function (x) { return x.text || ''; }).join('') : '';
  if (!opsi.json) return teks;
  teks = String(teks || '').replace(/^\s*```(?:json)?/i, '').replace(/```\s*$/, '').trim();
  try { return JSON.parse(teks); } catch (e) { throw aifErr_('FORMAT', 'Balasan AI bukan JSON yang utuh.'); }
}

// Pemanggilan langsung (user menunggu, mis. foto invoice/struk): tunggu kuota menit & server sibuk sebentar.
function aifPanggilLangsung_(opsi) {
  opsi.tungguMaks = 65;
  for (var coba = 1; ; coba++) {
    try { return aifPanggil_(opsi); }
    catch (e) {
      if (coba < 3 && (e.aifKode === 'SIBUK' || e.aifKode === 'KUOTA_MENIT')) { Utilities.sleep(Math.min(e.tunggu || 10, 40) * 1000); continue; }
      throw e;
    }
  }
}

/* ----- Antrian pekerjaan AI ----- */
var AIF_KOLOM_JOB_ = ['Job ID', 'Jenis', 'Judul', 'Status', 'Dibuat', 'Oleh', 'Total', 'Selesai', 'Gagal', 'Pesan', 'Diupdate', 'Meta'];
var AIF_KOLOM_ITEM_ = ['Job ID', 'Item ID', 'Status', 'Input', 'Output', 'Percobaan', 'Error', 'Diupdate'];
function aifSheet_(nama, kolom) {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(nama);
  if (!sh) { sh = ss.insertSheet(nama); sh.getRange(1, 1, 1, kolom.length).setValues([kolom]).setFontWeight('bold'); sh.setFrozenRows(1); }
  return sh;
}
function aifSheetJob_() { return aifSheet_('Antrian AI', AIF_KOLOM_JOB_); }
function aifSheetItem_() { return aifSheet_('Antrian AI Item', AIF_KOLOM_ITEM_); }
function aifBacaJob_() {
  var sh = aifSheetJob_(), lr = sh.getLastRow();
  if (lr < 2) return [];
  return sh.getRange(2, 1, lr - 1, 12).getValues().map(function (r, i) {
    var meta = {}; try { meta = JSON.parse(r[11] || '{}'); } catch (e) { }
    return { row: i + 2, id: String(r[0]), jenis: String(r[1]), judul: String(r[2]), status: String(r[3]), dibuat: r[4], oleh: String(r[5]),
      total: Number(r[6]) || 0, selesai: Number(r[7]) || 0, gagal: Number(r[8]) || 0, pesan: String(r[9] || ''), diupdate: r[10], meta: meta };
  }).filter(function (j) { return j.id; });
}
function aifTulisJob_(job) {
  aifSheetJob_().getRange(job.row, 1, 1, 12).setValues([[job.id, job.jenis, job.judul, job.status, job.dibuat, job.oleh, job.total,
    job.selesai, job.gagal, job.pesan, new Date(), JSON.stringify(job.meta || {})]]);
}
function aifBacaItem_(jobId) {
  var sh = aifSheetItem_(), lr = sh.getLastRow();
  if (lr < 2) return [];
  var hasil = [];
  sh.getRange(2, 1, lr - 1, 8).getValues().forEach(function (r, i) {
    if (String(r[0]) !== jobId) return;
    hasil.push({ row: i + 2, id: String(r[1]), status: String(r[2]), input: r[3], output: r[4], percobaan: Number(r[5]) || 0, error: String(r[6] || '') });
  });
  return hasil;
}
function aifTulisItem_(jobId, items) {
  var peta = {};
  items.forEach(function (it) { peta[it.row] = [it.status, it.input, it.output || '', it.percobaan, it.error || '', new Date()]; });
  tulisBarisPerBlok_(aifSheetItem_(), 3, peta);
}
function aifHitungJob_(job, items) {
  job.total = items.length;
  job.selesai = items.filter(function (i) { return i.status === 'Selesai'; }).length;
  job.gagal = items.filter(function (i) { return i.status === 'Gagal'; }).length;
  if (job.selesai + job.gagal >= job.total && AIF_STATUS_AKTIF_.indexOf(job.status) !== -1) {
    job.status = job.gagal ? 'Selesai (ada gagal)' : 'Selesai';
    job.pesan = job.gagal ? job.gagal + ' baris tidak bisa dibaca AI - bisa dicoba lagi atau dicek manual.' : '';
    job.meta.selesaiPada = Date.now();
  }
}
function aifPastikanTrigger_() {
  var ada = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'aifJalankanAntrian'; });
  if (!ada) ScriptApp.newTrigger('aifJalankanAntrian').timeBased().everyMinutes(1).create();
}
function aifHapusTrigger_() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'aifJalankanAntrian') ScriptApp.deleteTrigger(t); });
}

// Daftar pekerja per jenis pekerjaan. Pekerjaan "baca dokumen" baru cukup didaftarkan di sini.
var AIF_PEKERJA_ = {
  import_pembeli: { batch: 25, proses: aifProsesImportPembeli_, label: 'Import data pembeli' }
};

// Prompt dibuat ringkas & output pakai kunci 1 huruf supaya token sekecil mungkin.
function aifProsesImportPembeli_(inputs, job, tungguMaks) {
  var baris = inputs.map(function (it) { return it.id + '\t' + String(it.teks || '').substring(0, 600); }).join('\n');
  var prompt =
    'Rapikan data pelanggan toko online Indonesia. Tiap baris: id<TAB>sel-sel 1 baris Excel dipisah " | " ' +
    '(HP/uang/invoice/tanggal sudah dibuang; urutan umum: username, nama penerima, alamat, "kel,kec,kota,prov,negara", kodepos; ' +
    'abaikan SKU/nama produk/username affiliator).\n' +
    (job.meta && job.meta.header ? 'Header file: ' + String(job.meta.header).substring(0, 300) + '\n' : '') +
    'Balas JSON array, 1 objek per id: {"i":id,"n":nama,"p":pic,"a":alamat,"u":username,"j":"B"|"P","c":catatan}\n' +
    'n: nama kontak; kalau penerima jelas usaha (cafe/kopi/resto/toko/warung/PT/CV/hotel/kantor/klinik) pakai nama usaha. Kapitalisasi rapi, jangan mengarang; kosong/tak bermakna -> username.\n' +
    'p: nama orang yg bisa dihubungi bila beda dari n (mis. "Acaii Tea atau Mbak Tini" -> n "Acaii Tea", p "Mbak Tini"), selain itu "".\n' +
    'a: 1 baris: jalan/no/blok/RT RW, patokan singkat dlm kurung, kelurahan, kecamatan, kota/kab, provinsi, kodepos 5 digit. Tanpa pengulangan, tanpa "Indonesia", tanpa catatan Tokopedia, tanpa info tambahan.\n' +
    'u: username tanpa @ atau "". j: B=bisnis, P=perorangan. c: info penting singkat di luar alamat (jam buka, titip satpam, catatan Tokopedia) maks 80 huruf atau "".\n' +
    'DATA:\n' + baris;
  var hasil = aifPanggil_({ prompt: prompt, json: true, suhu: 0.1, maksToken: 200 * inputs.length + 500, tungguMaks: tungguMaks || 0 });
  if (!Array.isArray(hasil)) hasil = [];
  var bersih = function (v, maks) { return String(v == null ? '' : v).replace(/\s+/g, ' ').trim().substring(0, maks); };
  var out = {};
  hasil.forEach(function (o) {
    if (!o || o.i == null) return;
    out[String(o.i)] = { nama: bersih(o.n, 120), pic: bersih(o.p, 80), alamat: bersih(o.a, 400), username: bersih(o.u, 60).replace(/^@/, ''),
      jenis: String(o.j || '').toUpperCase() === 'B' ? 'Bisnis' : 'Perorangan', catatan: bersih(o.c, 120) };
  });
  return out;
}

// PEKERJA ANTRIAN - dipanggil trigger tiap 1 menit (maks ~4 menit/putaran) atau dari dasbor (1 kelompok, ~30 detik).
function aifJalankanAntrian(opsi) {
  var maksMs = opsi && opsi.maksMs ? opsi.maksMs : 240000;
  var lock = kunciModul_('aifworker');
  if (!lock.tryLock(0)) return { sibuk: true };
  var mulai = Date.now(), nBatch = 0, sisaAktif = 0;
  try {
    while (true) {
      var sisaMs = maksMs - (Date.now() - mulai);
      if (nBatch > 0 && sisaMs < 70000) break;
      var semua = aifBacaJob_();
      var aktif = semua.filter(function (j) { return AIF_STATUS_AKTIF_.indexOf(j.status) !== -1; })
        .sort(function (a, b) { return new Date(a.dibuat) - new Date(b.dibuat); });
      sisaAktif = aktif.length;
      if (!aktif.length) { aifHapusTrigger_(); try { aifBersihkanItemLama_(semua); } catch (eB) { } break; }
      var job = aktif[0], pekerja = AIF_PEKERJA_[job.jenis];
      if (!pekerja) { job.status = 'Dibatalkan'; job.pesan = 'Jenis pekerjaan tidak dikenal: ' + job.jenis; aifTulisJob_(job); continue; }
      var cfg = aifKonfig_();
      if (!cfg.key) {
        aktif.forEach(function (j) { if (j.status !== 'Tertunda' || !j.pesan) { j.status = 'Tertunda'; j.pesan = 'Menunggu key agent Rehan diisi (AI Agent > 🔑 Agent Keys).'; aifTulisJob_(j); } });
        break;
      }
      var q = aifCekKuota_(cfg);
      if (!q.ok) {
        if (q.alasan === 'hari') { aktif.forEach(function (j) { j.status = 'Menunggu kuota'; j.pesan = AIF_PESAN_HARI_; aifTulisJob_(j); }); break; }
        if (sisaMs - q.tunggu * 1000 > 40000) { Utilities.sleep(q.tunggu * 1000 + 300); continue; }
        if (job.status !== 'Diproses' || job.pesan) { job.status = 'Diproses'; job.pesan = ''; aifTulisJob_(job); }
        break;
      }
      var items = aifBacaItem_(job.id);
      var antre = items.filter(function (i) { return i.status === 'Menunggu'; });
      if (!antre.length) { aifHitungJob_(job, items); if (AIF_STATUS_AKTIF_.indexOf(job.status) !== -1) job.status = 'Selesai'; aifTulisJob_(job); continue; }
      var ukuran = Math.max(1, Math.min(job.meta.batch || pekerja.batch, pekerja.batch));
      var ambil = antre.slice(0, ukuran);
      var inputs = ambil.map(function (it) { var x = {}; try { x = JSON.parse(it.input); } catch (e) { } return { id: it.id, teks: x.teks, x: x.x }; });
      var out = null, err = null;
      try { out = pekerja.proses(inputs, job, Math.max(0, Math.min(60, (sisaMs - 45000) / 1000))); } catch (e) { err = e; }
      nBatch++;
      if (err) {
        var k = err.aifKode || '';
        if (k === 'KUOTA_HARI') { aktif.forEach(function (j) { j.status = 'Menunggu kuota'; j.pesan = AIF_PESAN_HARI_; aifTulisJob_(j); }); break; }
        if (k === 'KUOTA_MENIT' || k === 'SIBUK') {
          job.status = 'Diproses'; job.pesan = err.message; aifTulisJob_(job);
          var tunggu = Math.min(err.tunggu || 30, 65) * 1000;
          if (maksMs - (Date.now() - mulai) - tunggu > 60000) { Utilities.sleep(tunggu); continue; }
          break;
        }
        if (k === 'BELUM_SIAP' || k === 'KONFIG') { job.status = 'Tertunda'; job.pesan = err.message; aifTulisJob_(job); break; }
        // Error lain (mis. balasan terpotong/bukan JSON): kecilkan kelompok, coba lagi; baris yang terus gagal ditandai Gagal
        ambil.forEach(function (it) {
          it.percobaan++; it.error = String(err.message || err).substring(0, 300);
          if (ukuran === 1 && it.percobaan >= AIF_MAKS_PERCOBAAN_ITEM_) it.status = 'Gagal';
        });
        if (ukuran > 1) job.meta.batch = Math.max(1, Math.floor(ukuran / 2));
        aifTulisItem_(job.id, ambil);
      } else {
        ambil.forEach(function (it) {
          if (out[it.id]) { it.status = 'Selesai'; it.output = JSON.stringify(out[it.id]); it.error = ''; }
          else { it.percobaan++; it.error = 'Tidak ada di balasan AI'; if (it.percobaan >= AIF_MAKS_PERCOBAAN_ITEM_) it.status = 'Gagal'; }
        });
        aifTulisItem_(job.id, ambil);
        if (job.meta.batch && job.meta.batch < pekerja.batch) job.meta.batch = Math.min(pekerja.batch, job.meta.batch * 2); // pulih pelan-pelan
      }
      if (job.status !== 'Diproses' || job.pesan) { job.status = 'Diproses'; job.pesan = ''; }
      aifHitungJob_(job, items);
      aifTulisJob_(job);
    }
  } finally { lock.releaseLock(); }
  if (sisaAktif) { try { aifPastikanTrigger_(); } catch (e) { } }
  return { batch: nBatch };
}

// Item pekerjaan yang sudah lewat 30 hari dihapus supaya sheet tetap ringan (hanya saat antrian kosong & sheet > 3000 baris)
function aifBersihkanItemLama_(semuaJob) {
  var sh = aifSheetItem_(), lr = sh.getLastRow();
  if (lr < 3000) return;
  var batas = Date.now() - 30 * 86400000, simpan = {};
  semuaJob.forEach(function (j) { if (AIF_STATUS_AKTIF_.indexOf(j.status) !== -1 || !(j.dibuat instanceof Date) || j.dibuat.getTime() >= batas) simpan[j.id] = true; });
  var lock = kunciModul_('aifantrian');
  if (!lock.tryLock(10000)) return;
  try {
    var vals = sh.getRange(2, 1, sh.getLastRow() - 1, 8).getValues();
    var sisa = vals.filter(function (r) { return simpan[String(r[0])]; });
    if (sisa.length === vals.length) return;
    sh.getRange(2, 1, vals.length, 8).clearContent();
    if (sisa.length) { sh.getRange(2, 4, sisa.length, 2).setNumberFormat('@'); sh.getRange(2, 1, sisa.length, 8).setValues(sisa); }
  } finally { lepasKunci_(lock); }
}

function aifRingkasJob_(j) {
  var tz = Session.getScriptTimeZone();
  var fmt = function (d) { return d instanceof Date ? Utilities.formatDate(d, tz, 'dd MMM yyyy HH:mm') : ''; };
  return { id: j.id, jenis: j.jenis, label: (AIF_PEKERJA_[j.jenis] || {}).label || j.jenis, judul: j.judul, status: j.status,
    dibuat: fmt(j.dibuat), dibuatMs: j.dibuat instanceof Date ? j.dibuat.getTime() : 0, oleh: j.oleh, total: j.total, selesai: j.selesai,
    gagal: j.gagal, pesan: j.pesan, diupdate: fmt(j.diupdate), aktif: AIF_STATUS_AKTIF_.indexOf(j.status) !== -1 };
}
function aifInfoPemakaian_() {
  var cfg = aifKonfig_(), p = aifPemakaian_();
  return { siap: !!cfg.key, model: cfg.model, rpm: cfg.rpm, rpd: cfg.rpd, hariIni: p.n, tokenHariIni: p.t, habis: !!p.habis };
}

function prosesBuatJobAI(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var jenis = String(data.jenis || '');
    if (!AIF_PEKERJA_[jenis]) throw new Error('Jenis pekerjaan AI tidak dikenal.');
    if (!aifSiap_()) throw new Error('Key agent Rehan (AI Framework gratis) belum diisi - atur dulu di menu AI Agent > 🔑 Agent Keys.');
    var items = (data.items || []).slice(0, 3000).filter(function (it) { return it && it.id != null; });
    if (!items.length) throw new Error('Tidak ada data untuk dibaca.');
    var lock = kunciModul_('aifantrian');
    lock.waitLock(20000);
    try {
      var id = 'AI-' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyMMdd-HHmmss') + '-' + Utilities.getUuid().slice(0, 4);
      var meta = data.meta && typeof data.meta === 'object' ? data.meta : {};
      var shJ = aifSheetJob_();
      shJ.getRange(shJ.getLastRow() + 1, 1, 1, 12).setValues([[id, jenis, String(data.judul || AIF_PEKERJA_[jenis].label).substring(0, 150), 'Menunggu',
        new Date(), data.email, items.length, 0, 0, '', new Date(), JSON.stringify(meta).substring(0, 45000)]]);
      var shI = aifSheetItem_(), awal = shI.getLastRow() + 1;
      var rows = items.map(function (it) {
        return [id, String(it.id), 'Menunggu', JSON.stringify({ teks: String(it.teks || '').substring(0, 2000), x: it.x || null }).substring(0, 45000), '', 0, '', new Date()];
      });
      shI.getRange(awal, 4, rows.length, 2).setNumberFormat('@');
      shI.getRange(awal, 1, rows.length, 8).setValues(rows);
      result.jobId = id;
    } finally { lepasKunci_(lock); }
    aifPastikanTrigger_();
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesCekAntrianAI(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var batas = Date.now() - 30 * 86400000;
    result.jobs = aifBacaJob_().filter(function (j) { return j.status !== 'Dihapus' && (!(j.dibuat instanceof Date) || j.dibuat.getTime() >= batas || AIF_STATUS_AKTIF_.indexOf(j.status) !== -1); })
      .sort(function (a, b) { return new Date(b.dibuat) - new Date(a.dibuat); }).slice(0, 40).map(aifRingkasJob_);
    result.pemakaian = aifInfoPemakaian_();
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Dipanggil dasbor selama jendela progres terbuka: memproses 1 kelompok sekarang juga (lebih cepat dari trigger)
function prosesCekProsesAntrianAI(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    result.jalan = aifJalankanAntrian({ maksMs: 28000 });
    if (data.jobId) { var j = aifBacaJob_().filter(function (x) { return x.id === String(data.jobId); })[0]; result.job = j ? aifRingkasJob_(j) : null; }
    result.pemakaian = aifInfoPemakaian_();
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesCekHasilJobAI(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var j = aifBacaJob_().filter(function (x) { return x.id === String(data.jobId || ''); })[0];
    if (!j) throw new Error('Pekerjaan tidak ditemukan (mungkin sudah dibersihkan).');
    result.job = aifRingkasJob_(j);
    result.meta = j.meta;
    result.items = aifBacaItem_(j.id).map(function (it) {
      var inp = {}, out = null;
      try { inp = JSON.parse(it.input); } catch (e) { }
      try { out = it.output ? JSON.parse(it.output) : null; } catch (e) { }
      return { id: it.id, status: it.status, teks: inp.teks || '', x: inp.x || {}, output: out, error: it.error };
    });
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesUbahJobAI(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var lock = kunciModul_('aifantrian');
    lock.waitLock(20000);
    try {
      var j = aifBacaJob_().filter(function (x) { return x.id === String(data.jobId || ''); })[0];
      if (!j) throw new Error('Pekerjaan tidak ditemukan.');
      var aksi = String(data.aksiJob || '');
      if (aksi === 'batal') { j.status = 'Dibatalkan'; j.pesan = 'Dibatalkan oleh ' + data.email; }
      else if (aksi === 'diterapkan') { j.status = 'Diterapkan'; j.pesan = String(data.pesan || '').substring(0, 300); }
      else if (aksi === 'hapus') { j.status = 'Dihapus'; }
      else if (aksi === 'ulang') {
        var items = aifBacaItem_(j.id), ulang = items.filter(function (i) { return i.status === 'Gagal' || i.status === 'Menunggu'; });
        ulang.forEach(function (i) { i.status = 'Menunggu'; i.percobaan = 0; i.error = ''; });
        if (ulang.length) aifTulisItem_(j.id, ulang);
        j.meta.batch = 0; j.status = 'Menunggu'; j.pesan = ''; aifHitungJob_(j, items);
        if (!ulang.length) j.status = 'Selesai';
        aifTulisJob_(j);
        if (ulang.length) aifPastikanTrigger_();
        result.success = true; return result;
      } else throw new Error('Aksi tidak dikenal.');
      aifTulisJob_(j);
    } finally { lock.releaseLock(); }
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* =====================================================================
   AI AGENT KEYS - 1 API key per agent, dikelola dari dasbor (menu AI Agent -> 🔑 Agent Keys). Hanya Owner.
   Key disimpan di Script Properties; frontend TIDAK PERNAH menerima key utuh (hanya versi tersamar).
     jaya  : Core / Business Intelligence (CEO) -> LLM_API_KEY (+LLM_MODEL). Cadangan lama: GEMINI_API_KEY.
             Dipakai: Copilot & AI Agent Workspace, Tanya AI, Laporan Kesehatan Bisnis, Analisa Staff, Rangkum pesan dev.
     rehan : Data Scraper -> GEMINI_FREE_API_KEY (+GEMINI_FREE_MODEL/RPM/RPD) = AI Framework GRATIS.
             Dipakai: semua baca dokumen (import pembeli, foto invoice, foto struk) & baca halaman supplier. TANPA cadangan.
     budi  : Eksekutor / Task Runner -> AI_KEY_BUDI (+AI_MODEL_BUDI). Cadangan: key Jaya.
             Dipakai: Sederhanakan nama produk massal, merangkum memori thread chat.
   ===================================================================== */
function aiAgentDef_(role) {
  var d = {
    jaya: { role: 'jaya', nama: 'Jaya', ikon: '👔', peran: 'Core / Business Intelligence (CEO)', propKey: 'LLM_API_KEY', propModel: 'LLM_MODEL',
      modelDefault: COPILOT_MODEL_DEFAULT_, labelOk: 'Active',
      tugas: ['Copilot & AI Agent Workspace', 'Tanya AI', 'Laporan Kesehatan Bisnis', 'Analisa performa staff', 'Rangkum pesan developer'] },
    rehan: { role: 'rehan', nama: 'Rehan', ikon: '🕵️', peran: 'Data Scraper', propKey: 'GEMINI_FREE_API_KEY', propModel: 'GEMINI_FREE_MODEL',
      modelDefault: AIF_MODEL_DEFAULT_, labelOk: 'Connected',
      tugas: ['Import data pembeli (Antrian AI)', 'Baca foto invoice supplier', 'Baca foto struk biaya', 'Baca halaman supplier (harga modal, deskripsi, nama/foto/merk)'] },
    budi: { role: 'budi', nama: 'Budi', ikon: '🛠️', peran: 'Eksekutor / Task Runner', propKey: 'AI_KEY_BUDI', propModel: 'AI_MODEL_BUDI',
      modelDefault: COPILOT_MODEL_DEFAULT_, labelOk: 'Ready',
      tugas: ['Sederhanakan nama produk massal', 'Merangkum memori thread chat AI'] }
  };
  return d[role] || null;
}
var AI_AGENT_ROLES_ = ['jaya', 'rehan', 'budi'];

/* ===== PROVIDER AI BEBAS (tidak dikunci ke Gemini gratis / berbayar) =====
   Tiap agent boleh memakai key & model dari provider mana pun:
     gemini (Google AI Studio), anthropic (Claude), openai, openrouter, groq, deepseek, xai, mistral,
     custom (endpoint apa pun yang kompatibel OpenAI /chat/completions - isi Base URL).
   Script Properties per agent: <propKey>_PROVIDER ('' = deteksi otomatis dari awalan key) & <propKey>_BASEURL. */
var AI_PROVIDER_INFO_ = {
  gemini: { label: 'Google Gemini', base: 'https://generativelanguage.googleapis.com/v1beta' },
  anthropic: { label: 'Anthropic (Claude)', base: 'https://api.anthropic.com/v1' },
  openai: { label: 'OpenAI', base: 'https://api.openai.com/v1' },
  openrouter: { label: 'OpenRouter', base: 'https://openrouter.ai/api/v1' },
  groq: { label: 'Groq', base: 'https://api.groq.com/openai/v1' },
  deepseek: { label: 'DeepSeek', base: 'https://api.deepseek.com/v1' },
  xai: { label: 'xAI (Grok)', base: 'https://api.x.ai/v1' },
  mistral: { label: 'Mistral', base: 'https://api.mistral.ai/v1' },
  custom: { label: 'Kustom (kompatibel OpenAI)', base: '' }
};
function aiProviderLabel_(p) { return (AI_PROVIDER_INFO_[p] || { label: p || 'AI' }).label; }
function aiDeteksiProvider_(key) {
  var k = String(key || '').trim();
  if (/^sk-ant-/i.test(k)) return 'anthropic';
  if (/^sk-or-/i.test(k)) return 'openrouter';
  if (/^gsk_/i.test(k)) return 'groq';
  if (/^xai-/i.test(k)) return 'xai';
  if (/^sk-/i.test(k)) return 'openai';
  return 'gemini'; // AIza..., AQ.... (format key Google) & lainnya
}
function aiNormalProvider_(v) { v = String(v || '').trim().toLowerCase(); return AI_PROVIDER_INFO_[v] ? v : ''; }
function aiBaseUrlBersih_(u) { return String(u || '').trim().replace(/\/+$/, ''); }
// Konfigurasi akhir: provider tersimpan (atau deteksi dari key) + base URL (kustom / bawaan provider)
function aiResolveProvider_(providerTersimpan, baseTersimpan, key) {
  var prov = aiNormalProvider_(providerTersimpan) || aiDeteksiProvider_(key);
  var base = aiBaseUrlBersih_(baseTersimpan) || (AI_PROVIDER_INFO_[prov] || {}).base || '';
  return { provider: prov, baseUrl: base };
}

// Key + model yang DIPAKAI agent (sudah termasuk cadangan). sumber: 'sendiri' | 'cadangan-lama' | 'cadangan-jaya' | ''
function aiAgentKey_(role) {
  var def = aiAgentDef_(role) || aiAgentDef_('jaya');
  var p = PropertiesService.getScriptProperties();
  var key = String(p.getProperty(def.propKey) || '').trim(), sumber = key ? 'sendiri' : '';
  var provSimpan = p.getProperty(def.propKey + '_PROVIDER') || '', baseSimpan = p.getProperty(def.propKey + '_BASEURL') || '';
  if (!key && def.role === 'jaya') {
    var lama = String(GEMINI_API_KEY || '').trim();
    if (lama && lama.indexOf('PASTE_') !== 0) { key = lama; sumber = 'cadangan-lama'; }
  }
  if (!key && def.role === 'budi') {
    var j = aiAgentKey_('jaya');
    if (j.key) return { key: j.key, model: String(p.getProperty(def.propModel) || j.model).trim(), sumber: 'cadangan-jaya', provider: j.provider, baseUrl: j.baseUrl };
  }
  var pr = aiResolveProvider_(provSimpan, baseSimpan, key);
  // Model default bawaan hanya berlaku untuk Gemini; provider lain wajib isi nama model sendiri
  var model = String(p.getProperty(def.propModel) || (pr.provider === 'gemini' ? def.modelDefault : '')).trim();
  return { key: key, model: model, sumber: sumber, provider: pr.provider, baseUrl: pr.baseUrl };
}

// JSON dari balasan model (boleh terbungkus ``` atau ada teks pembuka)
function aiParseJsonLonggar_(teks) {
  var t = String(teks || '').replace(/^\s*```(?:json)?/i, '').replace(/```\s*$/, '').trim();
  try { return JSON.parse(t); } catch (e) { }
  var a = t.search(/[\{\[]/), b = Math.max(t.lastIndexOf('}'), t.lastIndexOf(']'));
  if (a >= 0 && b > a) return JSON.parse(t.slice(a, b + 1));
  throw new Error('Bukan JSON');
}
function aiErrHttp_(kode, isi, prov) {
  var pesan = String(isi || '');
  try { var j = JSON.parse(isi); pesan = (j.error && (j.error.message || j.error.type)) || j.message || pesan; } catch (e) { }
  var e2 = new Error('HTTP ' + kode + ' dari ' + aiProviderLabel_(prov) + ': ' + String(pesan).slice(0, 260));
  e2.httpKode = kode; e2.isi = isi;
  return e2;
}

/* Pemanggil UNIVERSAL. cfg = { key, model, provider, baseUrl }
   opsi = { system?, prompt?, contents? (format Gemini: [{role:'user'|'model', parts:[{text}]}]), gambar? {mime, base64},
            json?, suhu?, maksToken? }
   Balikan: { teks, usage: { in, out }, ms } . Gagal -> Error dengan .httpKode */
function aiPanggilUniversal_(cfg, opsi) {
  opsi = opsi || {};
  var prov = cfg.provider || aiDeteksiProvider_(cfg.key);
  if (!cfg.key) throw new Error('API key belum diisi.');
  if (!cfg.model) throw new Error('Nama model belum diisi untuk provider ' + aiProviderLabel_(prov) + '.');
  var base = aiBaseUrlBersih_(cfg.baseUrl) || (AI_PROVIDER_INFO_[prov] || {}).base || '';
  if (!base) throw new Error('Base URL belum diisi (provider kustom).');
  var giliran = [];
  (opsi.contents || []).forEach(function (c) {
    var t = ((c && c.parts) || []).map(function (x) { return x.text || ''; }).join('');
    if (t) giliran.push({ role: c.role === 'model' || c.role === 'assistant' ? 'assistant' : 'user', teks: t });
  });
  if (opsi.prompt) giliran.push({ role: 'user', teks: String(opsi.prompt) });
  if (!giliran.length) throw new Error('Prompt kosong.');
  var tambahanJson = opsi.json ? '\n\nBalas HANYA dengan JSON valid, tanpa markdown/backtick dan tanpa teks lain.' : '';
  giliran[giliran.length - 1].teks += tambahanJson;
  var suhu = opsi.suhu == null ? 0.3 : opsi.suhu, maks = opsi.maksToken || 4096, t0 = Date.now();

  if (prov === 'gemini') {
    var parts = [{ text: giliran[giliran.length - 1].teks }];
    if (opsi.gambar && opsi.gambar.base64) parts.push({ inline_data: { mime_type: opsi.gambar.mime || 'image/jpeg', data: opsi.gambar.base64 } });
    var isiG = giliran.slice(0, -1).map(function (g) { return { role: g.role === 'assistant' ? 'model' : 'user', parts: [{ text: g.teks }] }; });
    isiG.push({ role: 'user', parts: parts });
    var bodyG = { contents: isiG, generationConfig: { temperature: suhu, maxOutputTokens: maks } };
    if (opsi.system) bodyG.system_instruction = { parts: [{ text: opsi.system }] };
    if (opsi.json) bodyG.generationConfig.responseMimeType = 'application/json';
    var resG = fetchHemat(base + '/models/' + encodeURIComponent(cfg.model) + ':generateContent', { method: 'post', contentType: 'application/json',
      headers: { 'x-goog-api-key': cfg.key }, payload: JSON.stringify(bodyG), muteHttpExceptions: true });
    if (resG.getResponseCode() !== 200) throw aiErrHttp_(resG.getResponseCode(), resG.getContentText(), prov);
    var dG = JSON.parse(resG.getContentText()), cG = (dG.candidates || [])[0] || {}, umG = dG.usageMetadata || {};
    return { teks: ((cG.content && cG.content.parts) || []).map(function (x) { return x.text || ''; }).join('').trim(),
      usage: { in: Number(umG.promptTokenCount) || 0, out: (Number(umG.candidatesTokenCount) || 0) + (Number(umG.thoughtsTokenCount) || 0) }, ms: Date.now() - t0 };
  }

  if (prov === 'anthropic') {
    var pesanA = [];
    giliran.forEach(function (g) {
      if (pesanA.length && pesanA[pesanA.length - 1].role === g.role) pesanA[pesanA.length - 1].content[0].text += '\n\n' + g.teks;
      else pesanA.push({ role: g.role, content: [{ type: 'text', text: g.teks }] });
    });
    while (pesanA.length && pesanA[0].role !== 'user') pesanA.shift();
    if (opsi.gambar && opsi.gambar.base64) {
      var mimeA = opsi.gambar.mime || 'image/jpeg';
      var blokA = mimeA === 'application/pdf'
        ? { type: 'document', source: { type: 'base64', media_type: 'application/pdf', data: opsi.gambar.base64 } }
        : { type: 'image', source: { type: 'base64', media_type: mimeA, data: opsi.gambar.base64 } };
      pesanA[pesanA.length - 1].content.unshift(blokA);
    }
    var bodyA = { model: cfg.model, max_tokens: maks, temperature: suhu, messages: pesanA };
    if (opsi.system) bodyA.system = opsi.system;
    var resA = fetchHemat(base + '/messages', { method: 'post', contentType: 'application/json',
      headers: { 'x-api-key': cfg.key, 'anthropic-version': '2023-06-01' }, payload: JSON.stringify(bodyA), muteHttpExceptions: true });
    if (resA.getResponseCode() === 400 && /temperature/i.test(resA.getContentText())) {
      delete bodyA.temperature; // sebagian model menolak parameter temperature
      resA = fetchHemat(base + '/messages', { method: 'post', contentType: 'application/json',
        headers: { 'x-api-key': cfg.key, 'anthropic-version': '2023-06-01' }, payload: JSON.stringify(bodyA), muteHttpExceptions: true });
    }
    if (resA.getResponseCode() !== 200) throw aiErrHttp_(resA.getResponseCode(), resA.getContentText(), prov);
    var dA = JSON.parse(resA.getContentText()), uA = dA.usage || {};
    return { teks: (dA.content || []).map(function (b) { return b.type === 'text' ? b.text : ''; }).join('').trim(),
      usage: { in: Number(uA.input_tokens) || 0, out: Number(uA.output_tokens) || 0 }, ms: Date.now() - t0 };
  }

  // OpenAI & semua endpoint yang kompatibel OpenAI (OpenRouter, Groq, DeepSeek, xAI, Mistral, kustom)
  var pesanO = [];
  if (opsi.system) pesanO.push({ role: 'system', content: opsi.system });
  giliran.forEach(function (g) { pesanO.push({ role: g.role, content: g.teks }); });
  if (opsi.gambar && opsi.gambar.base64) {
    var akhir = pesanO[pesanO.length - 1];
    akhir.content = [{ type: 'text', text: akhir.content }, { type: 'image_url', image_url: { url: 'data:' + (opsi.gambar.mime || 'image/jpeg') + ';base64,' + opsi.gambar.base64 } }];
  }
  var bodyO = { model: cfg.model, messages: pesanO, temperature: suhu, max_tokens: maks };
  var hdrO = { Authorization: 'Bearer ' + cfg.key };
  if (prov === 'openrouter') { hdrO['HTTP-Referer'] = 'https://omniai.local'; hdrO['X-Title'] = 'OmniAI ERP'; }
  var resO;
  for (var cobaO = 1; cobaO <= 3; cobaO++) {
    resO = fetchHemat(base + '/chat/completions', { method: 'post', contentType: 'application/json', headers: hdrO, payload: JSON.stringify(bodyO), muteHttpExceptions: true });
    if (resO.getResponseCode() !== 400) break;
    var isiO = resO.getContentText(), ubah = false;
    // Model generasi baru: max_tokens -> max_completion_tokens, sebagian tidak menerima temperature
    if (/max_tokens/i.test(isiO) && bodyO.max_tokens) { bodyO.max_completion_tokens = bodyO.max_tokens; delete bodyO.max_tokens; ubah = true; }
    if (/temperature/i.test(isiO) && bodyO.temperature != null) { delete bodyO.temperature; ubah = true; }
    if (!ubah) break;
  }
  if (resO.getResponseCode() !== 200) throw aiErrHttp_(resO.getResponseCode(), resO.getContentText(), prov);
  var dO = JSON.parse(resO.getContentText()), chO = (dO.choices || [])[0] || {}, uO = dO.usage || {};
  var kontenO = chO.message ? chO.message.content : '';
  if (Array.isArray(kontenO)) kontenO = kontenO.map(function (x) { return x.text || ''; }).join('');
  return { teks: String(kontenO || '').trim(), usage: { in: Number(uO.prompt_tokens) || 0, out: Number(uO.completion_tokens) || 0 }, ms: Date.now() - t0 };
}

// Tes koneksi tanpa memakai kuota generate: ambil info model / daftar model dari provider
function aiTesKoneksi_(cfg) {
  var prov = cfg.provider, base = aiBaseUrlBersih_(cfg.baseUrl) || (AI_PROVIDER_INFO_[prov] || {}).base || '';
  var t0 = Date.now(), res, kode, isi;
  if (!base) return { ok: false, ms: 0, pesan: 'Base URL belum diisi (provider kustom).' };
  if (prov === 'gemini') {
    if (!cfg.model) return { ok: false, ms: 0, pesan: 'Nama model belum diisi.' };
    res = fetchHemat(base + '/models/' + encodeURIComponent(cfg.model), { method: 'get', headers: { 'x-goog-api-key': cfg.key }, muteHttpExceptions: true });
  } else if (prov === 'anthropic') {
    res = fetchHemat(base + '/models' + (cfg.model ? '/' + encodeURIComponent(cfg.model) : ''), { method: 'get',
      headers: { 'x-api-key': cfg.key, 'anthropic-version': '2023-06-01' }, muteHttpExceptions: true });
  } else {
    res = fetchHemat(base + '/models', { method: 'get', headers: { Authorization: 'Bearer ' + cfg.key }, muteHttpExceptions: true });
  }
  kode = res.getResponseCode(); isi = res.getContentText();
  var ms = Date.now() - t0, label = aiProviderLabel_(prov);
  if (kode === 200) {
    var info = {}; try { info = JSON.parse(isi); } catch (e) { }
    if (prov !== 'gemini' && prov !== 'anthropic' && cfg.model) {
      var ids = (info.data || info.models || []).map(function (m) { return String(m.id || m.name || ''); });
      if (ids.length && ids.indexOf(cfg.model) === -1) return { ok: true, ms: ms, pesan: 'Key valid (' + label + '), tapi model "' + cfg.model + '" tidak ada di daftar - cek ejaan atau pakai "Coba Prompt".' };
    }
    if (!cfg.model) return { ok: false, ms: ms, pesan: 'Key valid (' + label + '). Isi / pilih nama model dulu.' };
    return { ok: true, ms: ms, pesan: 'Terhubung ke ' + label + ' · ' + (info.display_name || info.displayName || cfg.model) + ' (' + ms + ' ms)' };
  }
  if (kode === 401 || /API key not valid|API_KEY_INVALID|invalid.*key|authentication/i.test(isi)) return { ok: false, ms: ms, pesan: 'API key tidak valid / salah salin (' + label + ').' };
  if (kode === 403) return { ok: false, ms: ms, pesan: 'Key ditolak (403) - API belum aktif di project ini atau key dibatasi.' };
  if (kode === 404) return { ok: false, ms: ms, pesan: 'Model "' + cfg.model + '" tidak ditemukan di ' + label + '.' };
  if (kode === 429) return { ok: true, ms: ms, pesan: 'Key valid, tapi kuota sedang penuh (429).' };
  if (kode === 400) return { ok: false, ms: ms, pesan: 'Permintaan ditolak (400): ' + String(isi).substring(0, 160) };
  return { ok: false, ms: ms, pesan: 'Gagal (kode ' + kode + '): ' + String(isi).substring(0, 160) };
}

// Konfigurasi uji dari isian form (belum disimpan) atau yang tersimpan
function aiCfgUji_(role, data) {
  var pakai = aiAgentKey_(role);
  var keyUji = String(data.key || '').replace(/\s+/g, '') || pakai.key;
  var provIsian = aiNormalProvider_(data.provider); // '' = deteksi otomatis
  var provDasar = provIsian || (data.key ? '' : pakai.provider); // key baru + otomatis -> deteksi dari awalan key
  var baseIsian = String(data.baseUrl || '').trim();
  var pr = aiResolveProvider_(provDasar, baseIsian || (provDasar === pakai.provider && !data.key ? pakai.baseUrl : ''), keyUji);
  var model = String(data.model || '').trim() || (pr.provider === pakai.provider ? pakai.model : (pr.provider === 'gemini' ? aiAgentDef_(role).modelDefault : ''));
  return { key: keyUji, model: model, provider: pr.provider, baseUrl: pr.baseUrl, pakai: pakai };
}

// ===== AKSI: ambil_model_ai_agent { role, key?, provider?, baseUrl? } -> daftar nama model dari provider =====
function prosesAmbilModelAiAgent(data) {
  var result = { success: false };
  try {
    integrasiWajibOwner_(data.email);
    var role = String(data.role || ''); if (!aiAgentDef_(role)) throw new Error('Agent tidak dikenal.');
    var cfg = aiCfgUji_(role, data);
    if (!cfg.key) throw new Error('Isi API key dulu.');
    var base = cfg.baseUrl, res, daftar = [];
    if (cfg.provider === 'gemini') {
      res = fetchHemat(base + '/models?pageSize=200', { method: 'get', headers: { 'x-goog-api-key': cfg.key }, muteHttpExceptions: true });
      if (res.getResponseCode() !== 200) throw aiErrHttp_(res.getResponseCode(), res.getContentText(), cfg.provider);
      (JSON.parse(res.getContentText()).models || []).forEach(function (m) {
        if ((m.supportedGenerationMethods || []).indexOf('generateContent') === -1) return;
        daftar.push({ id: String(m.name || '').replace(/^models\//, ''), nama: m.displayName || '' });
      });
    } else if (cfg.provider === 'anthropic') {
      res = fetchHemat(base + '/models?limit=100', { method: 'get', headers: { 'x-api-key': cfg.key, 'anthropic-version': '2023-06-01' }, muteHttpExceptions: true });
      if (res.getResponseCode() !== 200) throw aiErrHttp_(res.getResponseCode(), res.getContentText(), cfg.provider);
      (JSON.parse(res.getContentText()).data || []).forEach(function (m) { daftar.push({ id: m.id, nama: m.display_name || '' }); });
    } else {
      res = fetchHemat(base + '/models', { method: 'get', headers: { Authorization: 'Bearer ' + cfg.key }, muteHttpExceptions: true });
      if (res.getResponseCode() !== 200) throw aiErrHttp_(res.getResponseCode(), res.getContentText(), cfg.provider);
      var j = JSON.parse(res.getContentText());
      (j.data || j.models || []).forEach(function (m) { daftar.push({ id: String(m.id || m.name || ''), nama: m.name && m.name !== m.id ? m.name : '' }); });
    }
    result.success = true;
    result.provider = cfg.provider;
    result.providerLabel = aiProviderLabel_(cfg.provider);
    result.models = daftar.filter(function (m) { return m.id; }).slice(0, 400);
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: cek_prompt_ai_agent { role, key?, model?, provider?, baseUrl?, prompt } - uji coba kirim pesan sungguhan =====
function prosesCekPromptAiAgent(data) {
  var result = { success: false };
