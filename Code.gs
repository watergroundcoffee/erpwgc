function pkInvalidasi_() { try { CacheService.getScriptCache().remove(PK_CACHE_); } catch (e) { } }
function pkSimpanFoto_(base64, mime, namaFile, folder) {
  var b64 = String(base64 || '').replace(/^data:[^,]+,/, '');
