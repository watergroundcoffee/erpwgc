/* ---------- Kolom "SKU Terhubung <Platform>" di Produk Master (dicari berdasarkan JUDUL, bukan nomor) ----------
   Judul yang dikenali (huruf besar/kecil & spasi bebas):
     Shopee      : "SKU Terhubung Shopee"
     TikTok Shop : "SKU Terhubung TikTok" / "SKU Terhubung TikTok Shop"
   Sengaja TIDAK mengenali "Tokopedia" -> SKU Tokopedia tidak akan pernah ikut ke API TikTok. */
var SYNC_KOLOM_MEMO_ = null;
function syncKolomSkuTerhubungMaster_(toko) {
  if (SYNC_KOLOM_MEMO_) return SYNC_KOLOM_MEMO_;
  var hasil = { 'Shopee': null, 'TikTok Shop': null, 'Tokopedia': null };
  var dicari = { 'sku terhubung shopee': 'Shopee', 'sku terhubung tiktok': 'TikTok Shop', 'sku terhubung tokopedia': 'Tokopedia' };
  try {
    var sh = getMasterProdukSheet(toko);
    sh.getRange(1, 1, 1, sh.getLastColumn()).getDisplayValues()[0].forEach(function (judul, i) {
      // Dicocokkan PERSIS per kata (hanya huruf besar/kecil & spasi berlebih yang dimaafkan).
      var pf = dicari[String(judul || '').toLowerCase().replace(/\s+/g, ' ').trim()];
      if (!pf) return;
      if (hasil[pf]) { hasil[pf].dobel = true; return; } // judul dobel -> ditolak (lihat syncAmbilSkuTerhubung_)
      hasil[pf] = { nomor: i + 1, huruf: syncHurufKolom_(i + 1), judul: String(judul).trim() };
    });
  } catch (e) { }
  SYNC_KOLOM_MEMO_ = hasil;
  return hasil;
}

function syncHurufKolom_(n) {
  var s = '';
  while (n > 0) { var m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); }
  return s;
}
/* Jalankan SEKALI (menu Sheets / editor): membuat 2 kolom "SKU Terhubung Shopee" & "SKU Terhubung TikTok"
   di UJUNG KANAN Produk Master (tidak menyisip di tengah -> nomor kolom lain aman), lalu mengisinya dari
   sheet "SKU Marketplace Terhubung" (Platform Shopee / TikTok Shop). SKU Tokopedia & platform kosong
   TIDAK disalin. Kolom yang sudah ada & sudah berisi TIDAK ditimpa. */
function siapkanKolomSkuTerhubungPerPlatform() {
  return katDenganLock_(function () {
    var sh = getMasterProdukSheet();
    SYNC_KOLOM_MEMO_ = null;
    var kol = syncKolomSkuTerhubungMaster_();
    var lastCol = sh.getLastColumn();
    var dibuat = [];
    var DAFTAR = [['Shopee', 'SKU Terhubung Shopee', /^shopee$/i], ['TikTok Shop', 'SKU Terhubung TikTok', /^tiktok(\s*shop)?$/i], ['Tokopedia', 'SKU Terhubung Tokopedia', /^tokopedia$/i]];
    DAFTAR.forEach(function (x) {
      if (kol[x[0]]) return;
      lastCol++;
      if (sh.getMaxColumns() < lastCol) sh.insertColumnsAfter(sh.getMaxColumns(), lastCol - sh.getMaxColumns());
      sh.getRange(1, lastCol).setValue(x[1]).setFontWeight('bold');
      kol[x[0]] = { nomor: lastCol, judul: x[1] };
      dibuat.push(x[1]);
    });
    var lastRow = sh.getLastRow();
    var terisi = { 'Shopee': 0, 'TikTok Shop': 0, 'Tokopedia': 0 };
    if (lastRow > 1) {
      var skuMaster = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      var link = {};
      var shLink = getSkuMarketplaceTerhubungSheet(), lr = shLink.getLastRow();
      if (lr > 1) shLink.getRange(2, 1, lr - 1, 3).getValues().forEach(function (r) {
        var sj = String(r[0] || '').trim(), platform = String(r[2] || '').trim();
        var cocok = DAFTAR.filter(function (x) { return x[2].test(platform); })[0];
        if (!sj || !cocok) return; // platform kosong / tidak dikenal -> TIDAK disalin
        link[sj] = link[sj] || { 'Shopee': [], 'TikTok Shop': [], 'Tokopedia': [] };
        String(r[1] || '').split(/[,;\r\n\s]+/).forEach(function (k) { k = k.trim(); if (k && link[sj][cocok[0]].indexOf(k) === -1) link[sj][cocok[0]].push(k); });
      });
      DAFTAR.forEach(function (x) {
        var pf = x[0];
        var range = sh.getRange(2, kol[pf].nomor, lastRow - 1, 1);
        var isi = range.getValues();
        var berubah = false;
        skuMaster.forEach(function (r, i) {
          var sj = String(r[0] || '').trim();
          if (!sj || String(isi[i][0] || '').trim() || !link[sj] || !link[sj][pf].length) return; // isian manual tidak ditimpa
          isi[i][0] = link[sj][pf].join(', ');
          terisi[pf]++; berubah = true;
        });
        if (berubah) { range.setNumberFormat('@'); range.setValues(isi); }
      });
    }
    SYNC_KOLOM_MEMO_ = null;
    var pesan = 'Kolom dibuat: ' + (dibuat.join(', ') || '(semua sudah ada)') + '. Terisi otomatis: Shopee ' + terisi['Shopee'] + ', TikTok ' + terisi['TikTok Shop'] + ', Tokopedia ' + terisi['Tokopedia'] + ' produk. Periksa kolom TikTok: SKU Tokopedia yang dulu tercampur di baris TikTok harus dipindah manual ke kolom Tokopedia.';
    Logger.log(pesan);
    return pesan;
  });
}function menuSiapkanKolomSkuTerhubung() {
  SpreadsheetApp.getUi().alert(siapkanKolomSkuTerhubungPerPlatform());
}


/* (Jalur Tokopedia Open API lama dihapus: API itu dihentikan TikTok Shop - Tokopedia kini lewat API TikTok Shop.) */





/* ####################################################################################
   KELOLA "SKU TERHUBUNG" PER MARKETPLACE DARI WEB (tanpa membuka Google Sheets)
   Sumber kebenaran untuk Sync Harga = 3 kolom Produk Master: "SKU Terhubung Shopee",
   "SKU Terhubung TikTok", "SKU Terhubung Tokopedia" (dibuat otomatis di ujung kanan kalau belum ada).
   Setiap simpan juga menyelaraskan sheet lama "SKU Marketplace Terhubung" (dipakai pencocokan pesanan
   masuk & Monitor Stok) untuk ketiga platform tsb, supaya dua sumber data tidak pernah bertentangan.
   #################################################################################### */
var SKUP_PLATFORM = [
  { kunci: 'shopee', platform: 'Shopee', judul: 'SKU Terhubung Shopee', cocok: /^shopee$/i },
  { kunci: 'tiktok', platform: 'TikTok Shop', judul: 'SKU Terhubung TikTok', cocok: /^tiktok(\s*shop)?$/i },
  { kunci: 'tokopedia', platform: 'Tokopedia', judul: 'SKU Terhubung Tokopedia', cocok: /^tokopedia$/i }
];

function skupPecah_(teks) {
  return String(teks == null ? '' : teks).replace(/[\u200B-\u200D\u2060\uFEFF\u00AD]/g, '').replace(/\u00A0/g, ' ')
    .split(/[,;\r\n\s]+/).map(function (k) { return k.trim(); }).filter(function (k) { return k; });
}

// Pastikan 3 kolom ada (buat di ujung kanan bila belum). Dipanggil DI DALAM lock.
function skupPastikanKolom_(sh) {
  SYNC_KOLOM_MEMO_ = null;
  var kol = syncKolomSkuTerhubungMaster_();
  var lastCol = sh.getLastColumn();
  SKUP_PLATFORM.forEach(function (p) {
    if (kol[p.platform]) return;
    lastCol++;
    if (sh.getMaxColumns() < lastCol) sh.insertColumnsAfter(sh.getMaxColumns(), lastCol - sh.getMaxColumns());
    sh.getRange(1, lastCol).setValue(p.judul).setFontWeight('bold');
    sh.getRange(1, lastCol, sh.getMaxRows(), 1).setNumberFormat('@');
    kol[p.platform] = { nomor: lastCol, huruf: syncHurufKolom_(lastCol), judul: p.judul };
  });
  SYNC_KOLOM_MEMO_ = kol;
  return kol;
}

// Isi saat ini per platform: kolom Produk Master bila ada isinya; kalau kosong, usulan dari sheet lama
// (hanya baris ber-Platform persis) supaya admin tidak mengetik ulang.
function prosesAmbilSkuTerhubungPlatform(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('SKU Gudang kosong.');
    var sh = getMasterProdukSheet(data.toko);
    var row = katCariBarisSku_(sh, sku);
    if (row === -1) throw new Error('SKU ' + sku + ' tidak ditemukan di Produk Master.');
    SYNC_KOLOM_MEMO_ = null;
    var kol = syncKolomSkuTerhubungMaster_(data.toko);
    var isiBaris = sh.getRange(row, 1, 1, sh.getLastColumn()).getDisplayValues()[0];
    var dariLink = { 'Shopee': [], 'TikTok Shop': [], 'Tokopedia': [] }, tanpaPlatform = [];
    var shLink = getSkuMarketplaceTerhubungSheet(), lr = shLink.getLastRow();
    if (lr > 1) shLink.getRange(2, 1, lr - 1, 3).getValues().forEach(function (r) {
      if (String(r[0] || '').trim() !== sku) return;
      var pl = String(r[2] || '').trim();
      var p = SKUP_PLATFORM.filter(function (x) { return x.cocok.test(pl); })[0];
      skupPecah_(r[1]).forEach(function (k) {
        if (p) { if (dariLink[p.platform].indexOf(k) === -1) dariLink[p.platform].push(k); }
        else if (tanpaPlatform.indexOf(k) === -1) tanpaPlatform.push(k);
      });
    });
    result.data = {};
    result.sumber = {};
    SKUP_PLATFORM.forEach(function (p) {
      var k = kol[p.platform];
      var isiKolom = k ? skupPecah_(isiBaris[k.nomor - 1]) : [];
      // Gabungan: kode di kolom Produk Master + kode yang dihubungkan dari Katalog (sama dengan yang dipakai Sync)
      var gab = isiKolom.slice(), dariKatalog = [];
      dariLink[p.platform].forEach(function (kd) { if (gab.map(function (x) { return x.toUpperCase(); }).indexOf(kd.toUpperCase()) === -1) { gab.push(kd); dariKatalog.push(kd); } });
      result.data[p.kunci] = gab;
      result.sumber[p.kunci] = isiKolom.length ? 'kolom ' + (k ? k.huruf : '') + (dariKatalog.length ? ' + Katalog (' + dariKatalog.join(', ') + ') - klik Simpan untuk menyatukan' : '')
        : (dariKatalog.length ? 'dari Katalog - klik Simpan untuk menyatukan' : '');
    });
    result.tanpaPlatform = tanpaPlatform; // kode lama tanpa platform - admin yang menentukan tempatnya
    result.nama = String(isiBaris[1] || '');
    result.success = true;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}

function prosesSimpanSkuTerhubungPlatform(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('SKU Gudang kosong.');
    var baru = {};
    SKUP_PLATFORM.forEach(function (p) {
      var arr = Array.isArray(data[p.kunci]) ? data[p.kunci] : skupPecah_(data[p.kunci]);
      var bersih = [];
      arr.forEach(function (k) { k = String(k || '').replace(/\s+/g, ''); if (k && bersih.map(function (x) { return x.toUpperCase(); }).indexOf(k.toUpperCase()) === -1) bersih.push(k); });
      if (bersih.length > 50) throw new Error('Maksimal 50 SKU per marketplace.');
      baru[p.platform] = bersih;
    });

    var peringatan = [];
    katDenganLock_(function () {
      var sh = getMasterProdukSheet(data.toko);
      var kol = skupPastikanKolom_(sh);
      var row = katCariBarisSku_(sh, sku); // dicari DI DALAM lock
      if (row === -1) throw new Error('SKU ' + sku + ' tidak ditemukan di Produk Master.');
      var petaArsip = katPetaArsip_(data.toko);
      if (petaArsip[sku]) throw new Error('Produk ' + sku + ' diarsipkan - pulihkan dulu.');

      // Cegah 1 kode marketplace dipakai 2 produk BERBEDA di platform yang sama (harga salah produk!)
      var lastRow = sh.getLastRow();
      var skuSemua = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      SKUP_PLATFORM.forEach(function (p) {
        if (!baru[p.platform].length) return;
        var nomor = kol[p.platform].nomor;
        var isiKol = sh.getRange(2, nomor, lastRow - 1, 1).getDisplayValues();
        var target = baru[p.platform].map(function (k) { return k.toUpperCase(); });
        isiKol.forEach(function (r, i) {
          var pemilik = String(skuSemua[i][0] || '').trim();
          if (!pemilik || pemilik === sku || petaArsip[pemilik]) return;
          skupPecah_(r[0]).forEach(function (k) {
            if (target.indexOf(k.toUpperCase()) !== -1) throw new Error('"' + k + '" sudah terhubung ke produk ' + pemilik + ' di kolom ' + p.judul + '. Hapus dari produk itu dulu supaya harga tidak terkirim ke listing yang salah.');
          });
        });
      });

      // 1) Tulis 3 sel Produk Master (1 baris)
      SKUP_PLATFORM.forEach(function (p) {
        var sel = sh.getRange(row, kol[p.platform].nomor);
        sel.setNumberFormat('@');
        sel.setValue(baru[p.platform].join(', '));
      });

      // 2) Selaraskan sheet lama "SKU Marketplace Terhubung" untuk 3 platform ini (baris platform lain / kosong dibiarkan)
      var shLink = getSkuMarketplaceTerhubungSheet();
      var info = katBacaLink_(shLink, 4);
      var valsBaru = info.vals.filter(function (r) {
        if (String(r[0] || '').trim() !== sku) return true;
        var pl = String(r[2] || '').trim();
        return !SKUP_PLATFORM.some(function (p) { return p.cocok.test(pl); });
      });
      SKUP_PLATFORM.forEach(function (p) {
        baru[p.platform].forEach(function (k) {
          var pemilikLain = info.pemilik[k];
          if (pemilikLain && pemilikLain !== sku && !petaArsip[pemilikLain]) { peringatan.push('"' + k + '" di data pesanan lama masih milik ' + pemilikLain + ' (tidak diubah).'); return; }
          var b = []; for (var i = 0; i < info.lebar; i++) b.push('');
          b[0] = sku; b[1] = k; b[2] = p.platform; b[3] = 'Diatur dari menu Harga';
          valsBaru.push(b);
        });
      });
      katTulisUlangLink_(info, valsBaru);
      result.kolom = {};
      SKUP_PLATFORM.forEach(function (p) { result.kolom[p.kunci] = kol[p.platform].huruf; });
    });

    // Info: kode yang sama di TikTok & Tokopedia -> Sync TikTok & Tokopedia mengirimnya SEKALI (1 API)
    var tt = baru['TikTok Shop'].map(function (k) { return k.toUpperCase(); });
    baru['Tokopedia'].forEach(function (k) { if (tt.indexOf(k.toUpperCase()) !== -1) peringatan.push('"' + k + '" ada di kolom TikTok DAN Tokopedia - tidak masalah, saat Sync dikirim sekali saja lewat API TikTok Shop.'); });

    katInvalidasiCacheKatalog_(data.toko);
    SYNC_KOLOM_MEMO_ = null;
    result.success = true;
    result.data = { shopee: baru['Shopee'], tiktok: baru['TikTok Shop'], tokopedia: baru['Tokopedia'] };
    result.peringatan = peringatan;
  } catch (err) {
    result.error = String(err && err.message) === 'KAT_LOCK_SIBUK' ? 'Sistem sedang sibuk, coba lagi sebentar.' : String(err && err.message || err);
  }
  return result;
}


/* ####################################################################################
   SYNC HARGA MODULAR - 1 marketplace per klik
   syncShopeeOnly -> HANYA kolom "SKU Terhubung Shopee" -> HANYA API Shopee
   syncTikTokOnly -> kolom "SKU Terhubung TikTok" + "SKU Terhubung Tokopedia" -> HANYA API TikTok Shop
                     (Tokopedia & TikTok Shop = 1 Seller Center / 1 katalog sejak integrasi; Tokopedia Open API
                     lama sudah dihentikan. SKU yang sama di dua kolom dikirim sekali.)
   Error / data kosong di satu marketplace tidak pernah menyentuh marketplace lain.
   Semua kunci tetap berlaku: Harga Coret saja, fail-safe harga nol (dicek ulang sebelum UrlFetchApp),
   try-catch independen per listing, sakelar SYNC_HARGA_MODE di atas file.
   data: { sku, hargaCoret (Harga Coret di layar - pembanding), email, toko }
   #################################################################################### */

function syncShopeeOnly(data) {
  return syncJalankanSatuMarketplace_(data, {
    platform: 'Shopee', label: 'Shopee', kolFinal: 7, kolCoret: 28,
    kolom: [{ platform: 'Shopee', judul: 'SKU Terhubung Shopee', asal: 'Shopee' }],
    siapkan: function () { SHOPEE_ID_MEMO_ = null; },
    // 1 SKU Shopee bisa milik >1 listing (duplikat / varian di listing berbeda) -> 1 request per listing
    susunRequest: function (kodeMp, hargaCoret, mode) {
      var reqs = syncSusunRequestShopeeSemua_(kodeMp, hargaCoret, mode);
      return { reqs: reqs, idSumber: reqs[0].idSumber };
    },
    // ID dari sheet lokal ditolak Shopee (listing dihapus / dibuat ulang) -> cari ID terbaru lalu kirim ulang SEKALI
    ulangDenganIdSegar: function (kodeMp, hargaCoret, mode) {
      var reqs = syncSusunRequestShopeeSemua_(kodeMp, hargaCoret, mode, true);
      return { reqs: reqs, idSumber: reqs[0].idSumber };
    }
  });
}

function syncTikTokOnly(data) {
  return syncJalankanSatuMarketplace_(data, {
    platform: 'TikTok Shop', label: 'TikTok & Tokopedia', kolFinal: 25, kolCoret: 29,
    // Seller Center gabungan Tokopedia & TikTok Shop = 1 katalog, 1 API (TikTok Shop).
    // Dibaca: kolom TikTok (wajib) + kolom Tokopedia (opsional). SKU yang sama di dua kolom dikirim SEKALI.
    kolom: [
      { platform: 'TikTok Shop', judul: 'SKU Terhubung TikTok', asal: 'TikTok' },
      { platform: 'Tokopedia', judul: 'SKU Terhubung Tokopedia', asal: 'Tokopedia', opsional: true }
    ],
    siapkan: function (mode) {
      SYNC_ID_MEMO_ = {}; SYNC_ID_LOKAL_MEMO_ = null;
      // Access token TikTok berlaku ~7 hari. Dulu jalur sync harga TIDAK pernah memperbaruinya, jadi setelah
      // token kedaluwarsa semua update harga ditolak TikTok (kode 105002 / "access token expired").
      if (mode === 'LIVE') { try { pastikanTokenTikTokMasihValid(); } catch (eTok) { Logger.log('Refresh token TikTok: ' + eTok); } }
    },
    ulangDenganIdSegar: function (kodeMp, hargaCoret, mode) {
      delete SYNC_ID_MEMO_['TikTok Shop|' + kodeMp];
      var hasil = fetchMarketplaceID('TikTok Shop', kodeMp);
      if (!hasil.ditemukan) throw syncErrorDilewati_('SKU "' + kodeMp + '" sudah tidak ada di TikTok Shop - dilewati.');
      syncSimpanIdKeLokal_('TikTok Shop', kodeMp, hasil);
      hasil.sumber = 'api';
      SYNC_ID_MEMO_['TikTok Shop|' + kodeMp] = hasil;
      return { reqs: (hasil.semua || [hasil]).map(function (x) { return syncSusunRequestTiktok_(kodeMp, hargaCoret, mode, x); }), idSumber: 'api' };
    },
    // seller_sku DUPLIKAT (2+ listing dengan SKU sama persis) -> SEMUA listing dikirimi harga, bukan hanya salah satu
    susunRequest: function (kodeMp, hargaCoret, mode) {
      var id = syncResolveId_('TikTok Shop', kodeMp); // on-the-fly: sheet lokal -> API TikTok Shop -> simpan
      var sumber = id.sumber || (id.simulasi ? 'simulasi' : 'lokal');
      if (id.simulasi && mode === 'LIVE') throw new Error('Token TikTok Shop belum terpasang - ID listing tidak bisa dicari, update harga LIVE dibatalkan.');
      return { reqs: (id.semua || [id]).map(function (x) { return syncSusunRequestTiktok_(kodeMp, hargaCoret, mode, x); }), idSumber: sumber };
    },
    alasanSingkat: function (pesan) {
      if (/tidak ditemukan di marketplace/i.test(pesan)) return 'tidak ditemukan via API TikTok Shop';
      if (/AMBIGU/i.test(pesan)) return 'SKU ambigu (>1 listing)';
      return null;
    },
    pesanTidakDitemukan: function (kodeMp, asal) {
      return '"' + kodeMp + '" (dari kolom ' + asal + ') tidak ditemukan lewat API TikTok Shop. ' +
        (asal === 'Tokopedia'
          ? 'Pastikan toko Tokopedia sudah terintegrasi ke Tokopedia & TikTok Shop Seller Center, dan Seller SKU-nya persis sama di sana.'
          : 'Periksa Seller SKU di Seller Center (harus persis sama), atau hapus lewat [✎ SKU] kalau listing sudah tidak ada.');
    }
  });
}


// Mesin bersama - hanya bekerja dengan SATU konfigurasi marketplace yang diberikan pemanggilnya.
function syncJalankanSatuMarketplace_(data, cfg) {
  var mode = getSyncHargaMode_();
  var mulaiMs = Date.now();
  var result = { success: false, platform: cfg.platform, label: cfg.label, mode: mode, sku: String((data && data.sku) || '').trim(),
    jumlahListing: 0, jumlahSukses: 0, jumlahGagal: 0, perListing: [] };
  var hpp = 0, hargaFinal = 0, hargaCoret = 0;
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = result.sku;
    if (!sku) throw new Error('SKU Gudang kosong.');
    if (cfg.siapkan) cfg.siapkan(mode);
    SYNC_KOLOM_MEMO_ = null;

    // 1) Baca Produk Master (baris SKU ini)
    var sh = getMasterProdukSheet(data.toko);
    var row = katCariBarisSku_(sh, sku);
    if (row === -1) throw new Error('SKU ' + sku + ' tidak ditemukan di Produk Master.');
    var rAngka = sh.getRange(row, 1, 1, KAT_KOL_STATUS).getValues()[0]; // HPP, harga, status (kolom 1-30)
    if (katApakahArsip_(rAngka[KAT_KOL_STATUS - 1])) throw new Error('Produk ' + sku + ' diarsipkan - tidak boleh di-sync.');
    hpp = parseFloat(rAngka[3]) || 0;
    hargaFinal = parseFloat(rAngka[cfg.kolFinal - 1]) || 0;
    hargaCoret = parseFloat(rAngka[cfg.kolCoret - 1]) || 0;   // <- HARGA CORET: satu-satunya harga yang dikirim

    // 2) FAIL-SAFE + validasi harga
    syncGerbangHarga_(hpp, hargaFinal, hargaCoret);
    if (hargaCoret < hargaFinal) throw new Error('Harga Coret (' + katFmtRp_(hargaCoret) + ') lebih kecil dari Harga Jual Final (' + katFmtRp_(hargaFinal) + '). Perbaiki di menu Harga.');
    var pesanRugi = katPesanHppMelebihiHarga_(sku, hpp, hargaFinal);
    if (pesanRugi) throw new Error(pesanRugi.replace(/^Gagal:/, 'Gagal Sync:'));
    if (data.hargaCoret === undefined || data.hargaCoret === null || Math.abs(Number(data.hargaCoret) - hargaCoret) > 0.5) {
      throw new Error('Harga Coret di layar (' + katFmtRp_(data.hargaCoret) + ') berbeda dengan yang tersimpan (' + katFmtRp_(hargaCoret) + '). Simpan dulu / muat ulang, lalu Sync lagi.');
    }

    // 3) RESOLVER SKU MAPPING: SKU Gudang -> SKU Marketplace sebelum API dipanggil.
    //    Sumber digabung: kolom "SKU Terhubung <Platform>" Produk Master + sheet "SKU Marketplace Terhubung"
    //    (yang diisi menu Katalog). Dulu hanya kolom Produk Master yang dibaca -> SKU yang dihubungkan dari
    //    Katalog (mis. IV00416) tidak pernah terkirim. Fallback ke SKU Gudang HANYA bila tidak ada mapping sama sekali.
    var map = syncKodeTerhubung_(sku, cfg.kolom.map(function (kd) { return kd.platform; }), data.toko);
    var daftarKode = map.kode, asalKode = map.asal;
    result.sumberSku = map.sumber.join(' + ') || 'SKU Gudang (fallback)';
    result.isiKolom = daftarKode.map(function (k) { return k + ' (' + asalKode[k] + ')'; }).join(' | ');
    if (map.fallback) result.peringatan = 'Belum ada mapping ' + cfg.label + ' untuk ' + sku + ' - dicoba memakai SKU Gudang sebagai SKU marketplace.';
    if (map.platformLain.length) result.infoPlatformLain = map.platformLain;
    Logger.log('[RESOLVER SKU] ' + sku + ' -> ' + cfg.label + ': ' + result.isiKolom);

    // 4) Loop listing - try-catch INDEPENDEN, tidak pernah break.
    //    1 kode marketplace bisa menghasilkan BEBERAPA listing (SKU duplikat) -> semuanya dikirim satu per satu.
    result.jumlahListing = 0;
    result.jumlahDilewati = 0;
    result.jumlahDijadwalkan = 0;
    var urutan = 0;
    var ctxDasar = { sku: sku, cfg: cfg, mode: mode, hargaCoret: hargaCoret, hargaFinal: hargaFinal, data: data };
    var catatSt = function (st) {
      if (st.success) result.jumlahSukses++; else if (st.dilewati) result.jumlahDilewati++; else if (st.dijadwalkan) result.jumlahDijadwalkan++; else result.jumlahGagal++;
      result.jumlahListing++;
      result.perListing.push(st);
    };
    daftarKode.forEach(function (kodeMp) {
      var stBaru = function () { return { urutan: ++urutan, skuMarketplace: kodeMp, asalKolom: asalKode[kodeMp], originalPrice: Math.round(hargaCoret), success: false, pesan: '' }; };
      var ctx = Object.assign({ kodeMp: kodeMp }, ctxDasar);
      var hasil;
      try {
        if (Date.now() - mulaiMs > SYNC_HARGA_BATAS_WAKTU_MS) throw new Error('Belum diproses: batas waktu eksekusi hampir habis - klik lagi.');
        hasil = cfg.susunRequest(kodeMp, hargaCoret, mode);
      } catch (errSusun) { catatSt(syncKlasifikasiGagal_(stBaru(), errSusun, ctx)); return; }
      var daftarReq = hasil.reqs || [hasil.req], segar = null;
      daftarReq.forEach(function (req, j) {
        var st = stBaru();
        if (daftarReq.length > 1) st.listingKe = (j + 1) + '/' + daftarReq.length;
        if (hasil.idSumber) st.idSumber = hasil.idSumber;
        st.target = syncLabelTarget_(req);
        try {
          if (Date.now() - mulaiMs > SYNC_HARGA_BATAS_WAKTU_MS) throw new Error('Belum diproses: batas waktu eksekusi hampir habis - klik lagi.');
          syncGerbangHarga_(hpp, hargaFinal, hargaCoret);                    // penjaga gawang terakhir
          syncPastikanHargaCoretDiPayload_(req, hargaCoret, hargaFinal);      // kunci Harga Coret
          try {
            syncEksekusiRequest_(req, mode);
          } catch (errKirim) {
            // ID dari sheet lokal bisa basi (listing dihapus/dibuat ulang). Kalau penolakannya BUKAN soal
            // otorisasi/tanda tangan/promo, cari ID terbaru via API lalu kirim ulang SEKALI.
            var pesanKirim = String(errKirim && errKirim.message || errKirim);
            if ((errKirim && errKirim.promo) || mode !== 'LIVE' || hasil.idSumber !== 'lokal' || !cfg.ulangDenganIdSegar || /sign|token|auth|permission|forbidden|HTTP 401|HTTP 403|105\d{3}|106\d{3}/i.test(pesanKirim)) throw errKirim;
            if (!segar) segar = cfg.ulangDenganIdSegar(kodeMp, hargaCoret, mode);
            var daftarSegar = segar.reqs || [segar.req];
            req = daftarSegar[Math.min(j, daftarSegar.length - 1)];
            st.idSumber = 'api';
            st.target = syncLabelTarget_(req);
            syncGerbangHarga_(hpp, hargaFinal, hargaCoret);
            syncPastikanHargaCoretDiPayload_(req, hargaCoret, hargaFinal);
            syncEksekusiRequest_(req, mode);
          }
          st.success = true;
          st.pesan = (mode === 'DRY_RUN' ? 'Dry-run: payload disusun & di-log' : 'Terkirim') +
            (st.idSumber === 'api' ? ' · ID dicari via API & disimpan' : st.idSumber === 'indeks' ? ' · ID dari Indeks SKU Shopee' : st.idSumber === 'simulasi' ? ' · ID placeholder (token belum ada)' : st.idSumber === 'lokal' ? ' · ID dari sheet lokal' : '') +
            (st.listingKe ? ' · listing duplikat ' + st.listingKe + ' (' + st.target + ')' : '');
          var teksMap = 'Syncing ' + sku + ' via Mapped SKU ' + kodeMp + ' to ' + cfg.label + (asalKode[kodeMp] ? ' [' + asalKode[kodeMp] + ']' : '');
          Logger.log(teksMap + (st.target ? ' (' + st.target + ')' : ''));
          syncCatatLog_(sku, cfg.label, kodeMp + (st.target ? ' [' + st.target + ']' : ''), mode, hargaCoret, hargaFinal, 'OK', teksMap + ' · ' + st.pesan + ' (listing ' + st.urutan + ')', req);
        } catch (errListing) {
          st = syncKlasifikasiGagal_(st, errListing, Object.assign({ req: req }, ctx));
        }
        catatSt(st);
      });
    });

    // 5) LIVE + ada yang sukses -> catat "Terakhir Sync Marketplace"
    if (mode === 'LIVE' && result.jumlahSukses > 0) {
      katTulisDiBarisSku_(sh, sku, function (baris) { sh.getRange(baris, 27).setValue(new Date()); });
      invalidasiCacheKatalogHarga(data.toko);
    }
    result.success = result.jumlahGagal === 0;
    result.pesan = result.jumlahSukses + '/' + result.jumlahListing + ' listing ' + (mode === 'DRY_RUN' ? 'lolos dry-run' : 'ter-update') +
      (result.jumlahDilewati ? ' · ' + result.jumlahDilewati + ' dilewati (tidak ada di marketplace)' : '') +
      (result.jumlahDijadwalkan ? ' · ' + result.jumlahDijadwalkan + ' terkunci promo → dijadwalkan ulang otomatis' : '');
  } catch (err) {
    result.success = false;
    result.gagalKanal = true; // gagal sebelum ada listing yang ditembak
    result.pesan = String(err && err.message || err);
    result.alasanSingkat = syncTerjemahkanAlasan_(result.pesan);
    syncCatatLog_(result.sku || '-', cfg.label, result.isiKolom || '-', mode, hargaCoret, hargaFinal, 'GAGAL', result.pesan, null);
  }
  return result;
}


/* ======================================================================================
   MODUL PROMOSI - integrasi Marketing / Open API Shopee & TikTok Shop
   - Kode Promo & Diskon : Shopee Voucher + Discount API, TikTok Coupon + Promotion Activity API
   - Bundling Produk     : Shopee Bundle Deal + Add-on Deal API, TikTok Promotion Activity (BMSM/bundle)
   - Kalender Kampanye   : Shopee Shop Flash Sale API, TikTok Flash Sale activity, promo toko terjadwal + jadwal manual
   - Kelola Affiliate    : TikTok Shop Affiliate Seller API (order affiliate + pengajuan sampel)
   Data hasil tarik disimpan ke sheet "Promo ..." (tampilan cepat, tetap ada walau API sedang gagal).
   Path endpoint bisa di-override lewat Script Properties: PROMO_PATH_<KUNCI> (lihat PROMO_PATH_DEFAULT_).
   ====================================================================================== */

var PROMO_PATH_DEFAULT_ = {
  SHP_VOUCHER_LIST: '/api/v2/voucher/get_voucher_list',
  SHP_VOUCHER_ADD: '/api/v2/voucher/add_voucher',
  SHP_VOUCHER_END: '/api/v2/voucher/end_voucher',
  SHP_DISCOUNT_LIST: '/api/v2/discount/get_discount_list',
  SHP_BUNDLE_LIST: '/api/v2/bundle_deal/get_bundle_deal_list',
  SHP_BUNDLE_ITEM: '/api/v2/bundle_deal/get_bundle_deal_item',
  SHP_ADDON_LIST: '/api/v2/add_on_deal/get_add_on_deal_list',
  SHP_FLASH_LIST: '/api/v2/shop_flash_sale/get_shop_flash_sale_list',
  TTS_ACTIVITY_SEARCH: '/promotion/202309/activities/search',
  TTS_COUPON_SEARCH: '/promotion/202406/coupons/search',
  TTS_AFF_ORDER_SEARCH: '/affiliate_seller/202410/orders/search',
  TTS_AFF_SAMPLE_SEARCH: '/affiliate_seller/202409/sample_applications/search'
};

var PROMO_SHEET_ = {
  kode: { nama: 'Promo Kode Diskon', header: ['Platform', 'ID', 'Kode', 'Nama', 'Kategori', 'Jenis Diskon', 'Nilai', 'Min Belanja', 'Maks Diskon', 'Kuota', 'Terpakai', 'Mulai', 'Berakhir', 'Status', 'Info', 'Status API'] },
  bundling: { nama: 'Promo Bundling', header: ['Platform', 'ID', 'Nama', 'Tipe', 'Aturan', 'Jumlah Produk', 'Batas Beli', 'Mulai', 'Berakhir', 'Status', 'Info', 'Status API'] },
  kampanye: { nama: 'Promo Kampanye', header: ['Platform', 'ID', 'Nama', 'Tipe', 'Mulai', 'Berakhir', 'Status', 'Sumber', 'Catatan', 'Dibuat Oleh'] },
  affOrder: { nama: 'Promo Affiliate Order', header: ['Platform', 'Order ID', 'Tanggal', 'Creator', 'Produk', 'SKU', 'Qty', 'GMV', 'Rate Komisi (%)', 'Komisi', 'Status Order', 'Kunci'] },
  affSampel: { nama: 'Promo Affiliate Sampel', header: ['Platform', 'ID Pengajuan', 'Tanggal', 'Creator', 'Follower', 'Produk', 'Status', 'Info'] }
};

function promoPath_(kunci) {
  return PropertiesService.getScriptProperties().getProperty('PROMO_PATH_' + kunci) || PROMO_PATH_DEFAULT_[kunci];
}

function promoSheet_(key) {
  var def = PROMO_SHEET_[key];
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(def.nama);
  if (!sh) {
    sh = ss.insertSheet(def.nama);
    sh.getRange(1, 1, 1, def.header.length).setValues([def.header]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

function promoBaca_(key) {
  var sh = promoSheet_(key), n = PROMO_SHEET_[key].header.length, lr = sh.getLastRow();
  if (lr < 2) return [];
  return sh.getRange(2, 1, lr - 1, n).getDisplayValues();
}

// Ganti semua baris milik `platform` (kolom A) dengan `baris` baru. jaga(row) -> true = baris lama dipertahankan.
function promoGantiBaris_(key, platform, baris, jaga) {
  return denganKunciTulis_(function () {
    var sh = promoSheet_(key), n = PROMO_SHEET_[key].header.length;
    var lama = promoBaca_(key).filter(function (r) { return r[0] !== platform || (jaga && jaga(r)); });
    var semua = lama.concat(baris.map(function (r) { var x = r.slice(0, n); while (x.length < n) x.push(''); return x; }));
    var lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 1, lr - 1, n).clearContent();
    if (semua.length) {
      sh.getRange(2, 1, semua.length, n).setNumberFormat('@').setValues(semua.map(function (r) { return r.map(function (v) { return v === null || v === undefined ? '' : String(v); }); }));
    }
    return semua.length;
  }, 20000, 'promosi');
}

function promoLog_(sumber, info) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName('Log Promo Marketplace');
    if (!sh) { sh = ss.insertSheet('Log Promo Marketplace'); sh.getRange(1, 1, 1, 3).setValues([['Waktu', 'Sumber', 'Info']]).setFontWeight('bold'); }
    sh.appendRow([new Date(), sumber, String(typeof info === 'string' ? info : JSON.stringify(info)).slice(0, 45000)]);
    if (sh.getLastRow() > 300) sh.deleteRows(2, sh.getLastRow() - 300);
  } catch (e) { }
}

/* ---------- utilitas waktu, angka, status ---------- */
function promoDetik_(v) {
  if (v === '' || v === null || v === undefined) return 0;
  if (v instanceof Date) return Math.floor(v.getTime() / 1000);
  var n = Number(v);
  if (!isFinite(n) || n <= 0) {
    var d = new Date(String(v).replace(' ', 'T'));
    return isNaN(d.getTime()) ? 0 : Math.floor(d.getTime() / 1000);
  }
  return n > 1e12 ? Math.floor(n / 1000) : Math.floor(n);
}
function promoFmtWaktu_(detik) {
  if (!detik) return '';
  return Utilities.formatDate(new Date(detik * 1000), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm');
}
function promoStatus_(mulai, akhir, statusApi) {
  var s = String(statusApi || '').toUpperCase(), now = Math.floor(Date.now() / 1000);
  if (/DEACTIV|DISABLE|DELETE|CANCEL|STOP|TERMINAT|INVALID|NOT_EFFECTIVE|REJECT|SUSPEND/.test(s)) return 'Nonaktif';
  if (/DRAFT/.test(s)) return 'Draft';
  if (akhir && now > akhir) return 'Berakhir';
  if (/EXPIRE|ENDED|FINISH/.test(s)) return 'Berakhir';
  if (mulai && now < mulai) return 'Akan Datang';
  if (/UPCOMING|NOT_START/.test(s) && !mulai) return 'Akan Datang';
  return 'Aktif';
}
// Cari nilai pertama dari daftar nama kunci, menelusuri objek bersarang (maks 3 level) - API sering beda nama field antar versi
function promoCari_(obj, nama, kedalaman) {
  if (!obj || typeof obj !== 'object') return '';
  kedalaman = kedalaman === undefined ? 3 : kedalaman;
  for (var i = 0; i < nama.length; i++) {
    var v = obj[nama[i]];
    if (v !== undefined && v !== null && v !== '' && typeof v !== 'object') return v;
    if (v && typeof v === 'object' && (v.amount !== undefined || v.value !== undefined)) return mkNilai_(v);
  }
  if (kedalaman <= 0) return '';
  var kunci = Object.keys(obj);
  for (var j = 0; j < kunci.length; j++) {
    var anak = obj[kunci[j]];
    if (anak && typeof anak === 'object' && !Array.isArray(anak)) {
      var h = promoCari_(anak, nama, kedalaman - 1);
      if (h !== '') return h;
    }
  }
  return '';
}
function promoAngka_(v) { var n = parseFloat(v); return isFinite(n) ? n : 0; }

/* ---------- pemanggil API ---------- */
function promoShopeeGet_(path, params) {
  var kred = ambilKredensialShopee();
  if (!kred || !kred.accessToken || !kred.shopId) return { ok: false, pesan: 'Shopee belum terhubung (Pengaturan > Integrasi).', resp: {} };
  var r = shopeeGet_(path, params || {}, kred);
  return { ok: r.ok, pesan: r.ok ? '' : ((r.error || '') + ' ' + (r.pesan || '')).trim(), resp: (r.json && r.json.response) || {}, json: r.json };
}

function promoShopeePost_(path, body) {
  var kred = ambilKredensialShopee();
  if (!kred || !kred.accessToken || !kred.shopId) return { ok: false, pesan: 'Shopee belum terhubung (Pengaturan > Integrasi).', resp: {} };
  var ts = Math.floor(Date.now() / 1000);
  var url = getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts +
    '&sign=' + buatSignatureShopee(path, ts, kred.accessToken, kred.shopId) +
    '&access_token=' + encodeURIComponent(kred.accessToken) + '&shop_id=' + kred.shopId;
  var res = fetchHemat(url, { method: 'post', contentType: 'application/json', payload: JSON.stringify(body || {}), muteHttpExceptions: true });
  var json = null; try { json = JSON.parse(res.getContentText()); } catch (e) { }
  var ok = !!json && !json.error && res.getResponseCode() === 200;
  return { ok: ok, pesan: ok ? '' : (json ? ((json.error || '') + ' ' + (json.message || '')).trim() : 'Respons bukan JSON (HTTP ' + res.getResponseCode() + ')'), resp: (json && json.response) || {}, json: json };
}

var PROMO_TOKO_ = ''; // v2026.10.123 (DN-668): 'Conner' = panggilan promo/affiliate memakai akun TikTok Conner Official
function promoTiktokPost_(path, query, body) {
  var cfgToko = PROMO_TOKO_ === 'Conner' ? ovxCfgTiktok_('Conner') : null;
  if (!cfgToko) { try { pastikanTokenTikTokMasihValid(); } catch (e) { } }
  var props = PropertiesService.getScriptProperties();
  var token = cfgToko ? cfgToko.token : props.getProperty('TIKTOK_ACCESS_TOKEN'), cipher = cfgToko ? cfgToko.cipher : props.getProperty('TIKTOK_SHOP_CIPHER');
  if (!token || !cipher) return { ok: false, pesan: (cfgToko ? 'TikTok Shop Conner Official' : 'TikTok Shop') + ' belum terhubung (Pengaturan > Toko & API).', data: {} };
  var p = { app_key: cfgToko ? cfgToko.appKey : getTiktokAppKey(), timestamp: String(Math.floor(Date.now() / 1000)), shop_cipher: cipher };
  Object.keys(query || {}).forEach(function (k) { if (query[k] !== '' && query[k] !== undefined && query[k] !== null) p[k] = String(query[k]); });
  var bodyStr = JSON.stringify(body || {});
  var sign = buatSignatureTikTok(path, p, bodyStr, cfgToko ? cfgToko.appSecret : undefined);
  var url = 'https://open-api.tiktokglobalshop.com' + path + '?' + Object.keys(p).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(p[k]); }).join('&') + '&sign=' + sign;
  var res = fetchHemat(url, { method: 'post', contentType: 'application/json', headers: { 'x-tts-access-token': token }, payload: bodyStr, muteHttpExceptions: true });
  var j = null; try { j = JSON.parse(res.getContentText()); } catch (e) { }
  if (!j) return { ok: false, pesan: 'Respons bukan JSON (HTTP ' + res.getResponseCode() + ')', data: {} };
  var pesan = j.code === 0 ? '' : (j.message || ('kode ' + j.code));
  if (j.code === 105001 || /scope|permission|unauthori[sz]ed/i.test(pesan)) pesan += ' — aktifkan scope Promotion/Affiliate di Partner Center lalu otorisasi ulang toko.';
  return { ok: j.code === 0, pesan: pesan, data: j.data || {}, kode: j.code };
}

// Paging TikTok "search": page_size/page_token di body; kalau ditolak, coba di query.
function promoTiktokCariSemua_(path, bodyDasar, namaList, maksHalaman, batasWaktu) {
  // v2026.10.121 (DN-303): page_size/page_token kini di QUERY dulu (API affiliate 202410 menolak bila hanya di body:
  // "PageSize is a required field"); bila ditolak dicoba query+body, lalu body saja.
  var hasil = [], token = '', hal = 0, mode = 0, contoh = false;
  while (true) {
    var body = Object.assign({}, bodyDasar || {}), query = {};
    if (mode <= 1) { query.page_size = 50; if (token) query.page_token = token; }
    if (mode >= 1) { body.page_size = 50; if (token) body.page_token = token; }
    var r = promoTiktokPost_(path, query, body);
    if (!r.ok && mode < 2 && hal === 0 && /page_?size|pagesize|page_?token|param|required/i.test(r.pesan)) { mode++; continue; }
    if (!r.ok) { if (!hasil.length) throw new Error(r.pesan); break; }
    var list = [];
    for (var i = 0; i < namaList.length; i++) if (Array.isArray(r.data[namaList[i]])) { list = r.data[namaList[i]]; break; }
    if (!contoh && list.length) { promoLog_('TikTok ' + path, list.slice(0, 2)); contoh = true; }
    hasil = hasil.concat(list);
    token = r.data.next_page_token || '';
    hal++;
    if (!token || hal >= (maksHalaman || 10) || Date.now() >= batasWaktu) break;
  }
  return hasil;
}

/* ---------- tarik data: Shopee ---------- */
function promoShopeeHalaman_(path, paramDasar, namaList, mulaiHal, maksHal, batasWaktu) {
  var hasil = [], contoh = false;
  for (var hal = mulaiHal; hal < mulaiHal + (maksHal || 10) && Date.now() < batasWaktu; hal++) {
    var p = Object.assign({}, paramDasar, { page_no: hal, page_size: 100 });
    var r = promoShopeeGet_(path, p);
    if (!r.ok) { if (!hasil.length) throw new Error(path.split('/').pop() + ': ' + r.pesan); break; }
    var list = r.resp[namaList] || [];
    if (!contoh && list.length) { promoLog_('Shopee ' + path, list.slice(0, 2)); contoh = true; }
    hasil = hasil.concat(list);
    if (!r.resp.more) break;
  }
  return hasil;
}

function promoTarikKodeShopee_(batasWaktu) {
  var baris = [], sudah = {};
  ['ongoing', 'upcoming'].forEach(function (st) {
    promoShopeeHalaman_(promoPath_('SHP_VOUCHER_LIST'), { status: st }, 'voucher_list', 1, 10, batasWaktu).forEach(function (v) {
      var id = 'V-' + v.voucher_id; if (sudah[id]) return; sudah[id] = 1;
