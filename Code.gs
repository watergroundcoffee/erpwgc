/* ---------- UJI SEMUA SUMBER (Owner): matriks field x API + jawaban mentah + PDF label (teks dibaca browser) ---------- */
function ttbPilihContoh_(cfg, maks) {
  var sh = cfg.sheet, lr = sh.getLastRow();
  if (lr < 2) return [];
  var mulai = Math.max(2, lr - 400), vals = sh.getRange(mulai, 1, lr - mulai + 1, 5).getValues();
  var urutan = ['AWAITING_COLLECTION', 'IN_TRANSIT', 'AWAITING_SHIPMENT', 'DELIVERED', 'COMPLETED'], per = {};
  for (var i = vals.length - 1; i >= 0; i--) {
    var id = ttbIdSel_(vals[i][0]), st = String(vals[i][4] || '').trim().toUpperCase();
    if (id && urutan.indexOf(st) >= 0 && !per[st]) per[st] = id;
  }
  return urutan.filter(function (s) { return per[s]; }).map(function (s) { return per[s]; }).slice(0, maks);
}
function prosesTiktokPembeliUji(data) {
  try {
