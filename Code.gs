// ===== AKSI: smap_simpan { produkUpdate:[{sku,nama?,modal?}], produkBaru:[{sku,nama,modal,kategori}], supplier:[{sku,kode}], marketplace:[{kode,sku,platform}], bundling:[{kode,isi:[],nama}] } =====
function prosesSmapSimpan(data) { return katJalankanTerkunci_(prosesSmapSimpan_inti_, data); }
function prosesSmapSimpan_inti_(data) {
  var result = { success: false, produkDiubah: 0, produkBaru: 0, supplierDitambah: 0, mapping: null, bundling: 0 };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tz = Session.getScriptTimeZone(), tgl = Utilities.formatDate(new Date(), tz, 'dd MMM yyyy');
    var shM = getMasterProdukSheet(data.toko);
    var modalPer = {}; // sku (upper) -> modal yang ditulis -> ikut diselaraskan ke SKU Supplier utama

    // 1) Produk BARU (dicentang user) - ditulis paling awal supaya mapping di bawah bisa menemukannya
    var baru = Array.isArray(data.produkBaru) ? data.produkBaru : [];
    if (baru.length) {
      var ada = {}, lrB = shM.getLastRow();
      if (lrB > 1) shM.getRange(2, 1, lrB - 1, 1).getValues().forEach(function (r) { ada[String(r[0] || '').trim().toUpperCase()] = 1; });
      var tulis = [];
      baru.forEach(function (p) {
        var sku = String(p.sku || '').replace(/\s+/g, '').trim(); if (!sku || ada[sku.toUpperCase()]) return;
        ada[sku.toUpperCase()] = 1;
        var modal = Math.round(smapAngka_(p.modal));
        tulis.push([sku, smapTeks_(p.nama).slice(0, 200) || sku, '', modal > 0 ? modal : '', '', '', '', smapTeks_(p.kategori).slice(0, 60)]);
        if (modal > 0) modalPer[sku.toUpperCase()] = modal;
      });
      if (tulis.length) {
        var awal = shM.getLastRow() + 1;
        shM.getRange(awal, 1, tulis.length, 1).setNumberFormat('@');
        shM.getRange(awal, 1, tulis.length, 8).setValues(tulis);
        result.produkBaru = tulis.length;
      }
    }

    // 2) Update nama & harga modal produk yang sudah ada (data Excel menimpa) - kolom 2 & 4 saja
    var upd = Array.isArray(data.produkUpdate) ? data.produkUpdate : [];
    if (upd.length) {
      var lr = shM.getLastRow();
      var nilai = shM.getRange(2, 1, lr - 1, 4).getValues(), posisi = {};
      nilai.forEach(function (r, i) { var u = String(r[0] || '').trim().toUpperCase(); if (u && posisi[u] === undefined) posisi[u] = i; });
      var berubah = 0;
      upd.forEach(function (p) {
        var i = posisi[String(p.sku || '').trim().toUpperCase()]; if (i === undefined) return;
        var kena = false;
        if (p.nama !== undefined && smapTeks_(p.nama)) { nilai[i][1] = smapTeks_(p.nama).slice(0, 200); kena = true; }
        if (p.modal !== undefined && smapAngka_(p.modal) > 0) { nilai[i][3] = Math.round(smapAngka_(p.modal)); modalPer[String(nilai[i][0]).trim().toUpperCase()] = nilai[i][3]; kena = true; }
        if (kena) berubah++;
      });
      if (berubah) {
        shM.getRange(2, 2, nilai.length, 1).setValues(nilai.map(function (r) { return [r[1]]; }));
        shM.getRange(2, 4, nilai.length, 1).setValues(nilai.map(function (r) { return [r[3]]; }));
      }
      result.produkDiubah = berubah;
    }

    // 3) SKU Supplier Terhubung - hanya menambah. Produk yang belum punya SKU Supplier: kode pertama = SKU Utama
    var sup = Array.isArray(data.supplier) ? data.supplier : [];
    var shS = getSkuSupplierTerhubungSheet(), lrS = shS.getLastRow();
    var isiS = lrS > 1 ? shS.getRange(2, 1, lrS - 1, Math.max(4, Math.min(6, shS.getLastColumn()))).getValues() : [];
    var punya = {}, pemilikSup = {}, barisUtama = {};
    isiS.forEach(function (r, i) {
      var sj = String(r[0] || '').trim().toUpperCase(), ks = smapU_(r[1]); if (!sj) return;
      if (barisUtama[sj] === undefined) barisUtama[sj] = i;
      if (ks) { punya[sj + '|' + ks] = 1; if (!pemilikSup[ks]) pemilikSup[ks] = sj; }
    });
    var tambahS = [];
    sup.forEach(function (x) {
      var sj = String(x.sku || '').trim(), ks = smapU_(x.kode); if (!sj || !ks) return;
      var su = sj.toUpperCase();
      if (punya[su + '|' + ks] || (pemilikSup[ks] && pemilikSup[ks] !== su)) return;
      punya[su + '|' + ks] = 1; pemilikSup[ks] = su;
      var jadiUtama = barisUtama[su] === undefined && !tambahS.some(function (t) { return t[0].toUpperCase() === su; });
      tambahS.push([sj, ks, '', jadiUtama && modalPer[su] ? modalPer[su] : '', 'Import Excel ' + tgl, '']);
    });
    if (tambahS.length) {
      var awalS = shS.getLastRow() + 1;
      shS.getRange(awalS, 2, tambahS.length, 1).setNumberFormat('@');
      shS.getRange(awalS, 1, tambahS.length, 6).setValues(tambahS);
      result.supplierDitambah = tambahS.length;
    }
    // Harga modal SKU Supplier Utama ikut diselaraskan, supaya simpan pemetaan berikutnya tidak mengembalikan harga lama
    var utamaBerubah = false;
    Object.keys(modalPer).forEach(function (su) { var i = barisUtama[su]; if (i !== undefined && smapAngka_(isiS[i][3]) !== modalPer[su]) { isiS[i][3] = modalPer[su]; utamaBerubah = true; } });
    if (utamaBerubah) shS.getRange(2, 4, isiS.length, 1).setValues(isiS.map(function (r) { return [r[3]]; }));

    // 4) SKU Marketplace Terhubung - memakai mesin Import Mapping SKU (gabung koma, tanpa menghapus, cek konflik)
    var mp = Array.isArray(data.marketplace) ? data.marketplace : [];
    if (mp.length) {
      SYNC_KOLOM_MEMO_ = null;
      var kolAda = {}; try { kolAda = syncKolomSkuTerhubungMaster_(data.toko) || {}; } catch (eKA) { kolAda = {}; }
      var perluKolom = mp.some(function (x) { var pf = importMappingPlatform_(x.platform); return pf && !kolAda[pf]; });
      if (perluKolom) { try { result.kolomDibuat = siapkanKolomSkuTerhubungPerPlatform(); } catch (eKol) { result.peringatanKolom = String(eKol.message || eKol); } }
      SYNC_KOLOM_MEMO_ = null;
      var hasilMp = prosesImportMappingSku_inti_({ email: data.email, toko: data.toko, platform: '',
        daftar: mp.map(function (x) { return { skuMarketplace: x.kode, skuGudang: x.sku, platform: x.platform || '' }; }) });
      if (!hasilMp.success) throw new Error('Mapping marketplace gagal: ' + hasilMp.error);
      result.mapping = { ditambah: hasilMp.ditambah, sudahAda: hasilMp.sudahAda, dilewati: hasilMp.jumlahDilewati, konflik: hasilMp.konflik };
    }

    // 5) SKU Bundling - tambah / perbarui isi resmi
    var bund = Array.isArray(data.bundling) ? data.bundling : [];
    if (bund.length) {
      var shB = getSkuBundlingSheet_(), lrBd = shB.getLastRow();
      var isiB = lrBd > 1 ? shB.getRange(2, 1, lrBd - 1, 4).getValues() : [], posB = {};
      isiB.forEach(function (r, i) { var k = smapU_(r[0]); if (k && posB[k] === undefined) posB[k] = i; });
      var baruB = [], ubahB = false;
      bund.forEach(function (b) {
        var k = smapU_(b.kode), isi = (b.isi || []).map(function (x) { return String(x || '').replace(/\s+/g, ''); }).filter(function (x) { return x && !/^X{3,}$/i.test(x); });
        if (!k || !isi.length) return;
        var baris = [k, isi.join(', '), smapTeks_(b.nama).slice(0, 150), tgl];
        if (posB[k] !== undefined) { isiB[posB[k]] = baris; ubahB = true; } else { posB[k] = -1; baruB.push(baris); }
        result.bundling++;
      });
      if (ubahB) shB.getRange(2, 1, isiB.length, 4).setValues(isiB);
      if (baruB.length) { var awB = shB.getLastRow() + 1; shB.getRange(awB, 1, baruB.length, 2).setNumberFormat('@'); shB.getRange(awB, 1, baruB.length, 4).setValues(baruB); }
      CACHE_BUNDLING_ = null;
    }

    SpreadsheetApp.flush();
    try { katInvalidasiCacheKatalog_(data.toko); } catch (e1) { }
    try { invalidasiCacheKatalogHarga(data.toko); } catch (e2) { }
    try { CacheService.getScriptCache().remove(FIN_CACHE_KUNCI + '__meta'); } catch (e3) { } // HPP Finance dihitung ulang dari harga modal baru
    CACHE_SKU_MASTER_SET_ = null; SYNC_KOLOM_MEMO_ = null;
    result.success = true;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}


/* ======================================================================================
   PEMBARUAN v2026.10-UX (backend)
   (1) Login Email + Password  : sheet tersembunyi "Kredensial Login", password di-hash
                                  (HMAC-SHA256 berulang + salt unik per akun + pepper di Script Properties)
   (1) Pengaturan Akun          : buat / ganti password, foto profil
   (3) Registry Toko            : sheet "Daftar Toko" (nama, data induk, logo, warna)
   (3) Pembeli Shopee otomatis  : get_order_detail -> isi kolom kosong di sheet Shopee
   (6) Iklan & Saldo            : sheet "Iklan Harian" + "Saldo Iklan" (API Shopee Ads / TikTok Ads + input manual)
   ====================================================================================== */

/* ---------- (1) KREDENSIAL LOGIN ---------- */
var KRED_SHEET_ = 'Kredensial Login';
var KRED_HEADER_ = ['Email', 'Password Hash', 'Salt', 'Iterasi', 'Foto URL', 'Diperbarui'];
var KRED_ITERASI_ = 1500;

function getKredensialSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(KRED_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(KRED_SHEET_);
    sh.getRange(1, 1, 1, KRED_HEADER_.length).setValues([KRED_HEADER_]).setFontWeight('bold');
    sh.setFrozenRows(1);
    try { sh.hideSheet(); } catch (e) { }
  }
  return sh;
}
function kredPepper_() {
  var p = sesiProps_();
  var v = p.getProperty('PASSWORD_PEPPER');
  if (v) return v;
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    v = p.getProperty('PASSWORD_PEPPER');
    if (!v) { v = Utilities.getUuid() + Utilities.getUuid(); p.setProperty('PASSWORD_PEPPER', v); }
    return v;
  } finally { lock.releaseLock(); }
}
function kredHash_(password, salt, iterasi) {
  var kunci = Utilities.newBlob(String(salt) + '|' + kredPepper_()).getBytes();
  var h = Utilities.computeHmacSha256Signature(Utilities.newBlob(String(password)).getBytes(), kunci);
  for (var i = 1; i < (iterasi || KRED_ITERASI_); i++) h = Utilities.computeHmacSha256Signature(h, kunci);
  return Utilities.base64Encode(h);
}
function kredBaca_(email) {
  var e = String(email || '').trim().toLowerCase();
  if (!e) return null;
  var sh = getKredensialSheet_(), lr = sh.getLastRow();
  if (lr < 2) return null;
  var v = sh.getRange(2, 1, lr - 1, KRED_HEADER_.length).getValues();
  for (var i = 0; i < v.length; i++) {
    if (String(v[i][0]).trim().toLowerCase() === e) {
      return { row: i + 2, hash: String(v[i][1] || ''), salt: String(v[i][2] || ''), iterasi: parseInt(v[i][3], 10) || KRED_ITERASI_, foto: String(v[i][4] || '') };
    }
  }
  return null;
}
// ubah: { hash, salt, iterasi, foto } - hanya field yang diisi yang ditulis
function kredTulis_(email, ubah, tanpaLock) {
  var lock = tanpaLock ? null : LockService.getScriptLock();
  if (lock) lock.waitLock(15000);
  try {
    var sh = getKredensialSheet_();
    var ada = kredBaca_(email);
    var baris = ada ? sh.getRange(ada.row, 1, 1, KRED_HEADER_.length).getValues()[0] : [String(email).trim().toLowerCase(), '', '', '', '', ''];
    if (ubah.hash !== undefined) baris[1] = ubah.hash;
    if (ubah.salt !== undefined) baris[2] = ubah.salt;
    if (ubah.iterasi !== undefined) baris[3] = ubah.iterasi;
    if (ubah.foto !== undefined) baris[4] = ubah.foto;
    baris[5] = new Date();
    var row = ada ? ada.row : sh.getLastRow() + 1;
    sh.getRange(row, 1, 1, 3).setNumberFormat('@');
    sh.getRange(row, 1, 1, KRED_HEADER_.length).setValues([baris]);
    SpreadsheetApp.flush();
  } finally { if (lock) lock.releaseLock(); }
}
function kredSetPassword_(email, password, tanpaLock) {
  var salt = Utilities.getUuid().replace(/-/g, '');
  kredTulis_(email, { hash: kredHash_(password, salt, KRED_ITERASI_), salt: salt, iterasi: KRED_ITERASI_ }, tanpaLock);
}
function kredValidasiPasswordBaru_(pw) {
  pw = String(pw || '');
  if (pw.length < 8) throw new Error('Password minimal 8 karakter.');
  if (pw.length > 128) throw new Error('Password terlalu panjang (maks 128 karakter).');
  if (!/[A-Za-z]/.test(pw) || !/\d/.test(pw)) throw new Error('Password harus berisi kombinasi huruf dan angka.');
}
function akunEmailKhusus_(email) {
  var e = String(email || '').trim().toLowerCase();
  if (!e) return false;
  return (!!DEV_EMAIL_TESTING && e === String(DEV_EMAIL_TESTING).trim().toLowerCase()) ||
    (!!ADMIN_GUDANG_EMAIL_TESTING && e === String(ADMIN_GUDANG_EMAIL_TESTING).trim().toLowerCase());
}
function loginKunciEmail_(email) {
  return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(email || '').trim().toLowerCase())).replace(/=/g, '').slice(0, 22);
}
// Email persis seperti tertulis di sheet Staff ('' kalau belum terdaftar)
function staffEmailAsli_(email) {
  var e = String(email || '').trim().toLowerCase();
  if (!e) return '';
  var sh = getStaffSheet(), lr = sh.getLastRow();
  if (lr < 2) return '';
  var v = sh.getRange(2, 1, lr - 1, 1).getValues();
  for (var i = 0; i < v.length; i++) if (String(v[i][0]).trim().toLowerCase() === e) return String(v[i][0]).trim();
  return '';
}
function loginBangunHasil_(email, staff) {
  var hasil = { success: true, email: email, nama: staff.nama || email, role: staff.role || '', aktif: !!staff.aktif, izin: {} };
  if (staff.aktif) { hasil.isOwner = staff.role === 'Owner'; hasil.izin = getIzinByEmail(email); }
  return hasil;
}

function prosesLoginEmail(data) {
  try {
    var email = String(data.emailLogin || data.email || '').trim();
    var pw = String(data.password || '');
    if (!email || !pw) throw new Error('Email dan password wajib diisi.');
    if (akunEmailKhusus_(email)) throw new Error('Akun ini memakai jalur login khusus (Developer / Admin Gudang).');
    var kunciBlokir = 'EMAIL_' + loginKunciEmail_(email);
    loginCekBlokir_(kunciBlokir);
    var asli = staffEmailAsli_(email);
    var staff = asli ? getStaffByEmail(asli) : null;
    var k = asli ? kredBaca_(asli) : null;
    if (staff && (!k || !k.hash)) throw new Error('Akun ini belum punya password. Masuk dengan Google dulu, lalu buat password di menu Pengaturan Akun (pojok kanan atas).');
    if (!staff || !k) { loginCatatGagal_(kunciBlokir); throw new Error('Email atau password salah.'); }
    if (!sesiSamaPersis_(kredHash_(pw, k.salt, k.iterasi), k.hash)) { loginCatatGagal_(kunciBlokir); throw new Error('Email atau password salah.'); }
    loginBersihkanGagal_(kunciBlokir);
    updateTerakhirLoginStaff(asli);
    var hasil = loginBangunHasil_(asli, staff);
    hasil.foto = k.foto || '';
    hasil.punyaPassword = true;
    hasil.metodeLogin = 'email';
    hasil.sessionToken = buatTokenSesi_(asli);
    return hasil;
  } catch (err) {
    return { success: false, error: err.message || String(err) };
  }
}

function prosesLoginDaftarEmail(data) {
  try {
    var email = String(data.emailLogin || data.email || '').trim().toLowerCase();
    var nama = String(data.nama || '').trim();
    var pw = String(data.password || '');
    if (nama.length < 2) throw new Error('Nama lengkap wajib diisi.');
    if (nama.length > 80) throw new Error('Nama terlalu panjang.');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error('Format email belum benar.');
    kredValidasiPasswordBaru_(pw);
    if (akunEmailKhusus_(email)) throw new Error('Email ini tidak bisa didaftarkan.');
    // Anti spam pendaftaran: maks 10 pendaftaran / 10 menit (global)
    var c = CacheService.getScriptCache();
    var n = parseInt(c.get('DAFTAR_EMAIL_HITUNG') || '0', 10);
    if (n >= 10) throw new Error('Terlalu banyak pendaftaran baru. Coba lagi dalam 10 menit.');
    c.put('DAFTAR_EMAIL_HITUNG', String(n + 1), 600);

    var lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      staffInvalidasi_();
      if (staffEmailAsli_(email)) throw new Error('Email ini sudah terdaftar. Silakan masuk - atau login dengan Google lalu buat password di Pengaturan Akun.');
      var sh = getStaffSheet();
      sh.insertRowAfter(1);
      sh.getRange(2, 4).insertCheckboxes();
      var sekarang = new Date();
      sh.getRange(2, 1, 1, 6).setValues([[email, nama, '', false, sekarang, sekarang]]);
      if (!sh.getRange(1, 5).getValue()) {
        sh.getRange(1, 5).setValue('Tanggal Bergabung').setFontWeight('bold');
        sh.getRange(1, 6).setValue('Terakhir Login').setFontWeight('bold');
      }
      kredSetPassword_(email, pw, true);
      SpreadsheetApp.flush();
    } finally { lock.releaseLock(); }
    staffInvalidasi_();
    return { success: true, email: email, nama: nama, role: '', aktif: false, izin: {}, punyaPassword: true, foto: '', metodeLogin: 'email', sessionToken: buatTokenSesi_(email) };
  } catch (err) {
    return { success: false, error: err.message || String(err) };
  }
}

// Dipanggil route 'login' (Google): simpan foto Google (kalau belum ada) + status punya password
function akunLengkapiHasilGoogle_(out, fotoGoogle) {
  try {
    if (!out || !out.success || !out.email) return out;
    var k = kredBaca_(out.email);
    if (fotoGoogle && (!k || !k.foto)) kredTulis_(out.email, { foto: fotoGoogle });
    out.foto = (k && k.foto) || fotoGoogle || '';
    out.punyaPassword = !!(k && k.hash);
    out.metodeLogin = 'google';
  } catch (e) { console.error('akunLengkapiHasilGoogle_: ' + e); }
  return out;
}

function prosesLihatAkunSaya(data) {
  try {
    var k = kredBaca_(data.email);
    var s = getStaffByEmail(data.email) || {};
    return { success: true, email: data.email, nama: s.nama || data.email, role: s.role || '', foto: (k && k.foto) || '', punyaPassword: !!(k && k.hash), akunKhusus: akunEmailKhusus_(data.email) };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

function prosesSimpanPasswordAkun(data) {
  try {
    if (akunEmailKhusus_(data.email)) throw new Error('Akun Developer / Admin Gudang tidak memakai password email.');
    var staff = getStaffByEmail(data.email);
    if (!staff) throw new Error('Akun tidak ditemukan.');
    var k = kredBaca_(data.email);
    var ganti = !!(k && k.hash);
    if (ganti) {
      var kb = 'GANTIPW_' + loginKunciEmail_(data.email);
      loginCekBlokir_(kb);
      if (!sesiSamaPersis_(kredHash_(String(data.passwordLama || ''), k.salt, k.iterasi), k.hash)) { loginCatatGagal_(kb); throw new Error('Password lama salah.'); }
      loginBersihkanGagal_(kb);
    }
    kredValidasiPasswordBaru_(data.passwordBaru);
    kredSetPassword_(data.email, String(data.passwordBaru));
    return { success: true, punyaPassword: true, pesan: ganti ? 'Password berhasil diganti.' : 'Password berhasil dibuat. Sekarang Anda juga bisa login dengan email & password.' };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

function prosesUploadFotoAkun(data) {
  try {
    var b64 = String(data.base64 || '');
    if (!b64) throw new Error('File foto kosong.');
    if (b64.length > 4.2 * 1024 * 1024) throw new Error('Ukuran foto maksimal 3 MB.');
    var mime = /^image\/(png|jpe?g|webp)$/i.test(String(data.mimeType || '')) ? String(data.mimeType) : 'image/jpeg';
    var blob = Utilities.newBlob(Utilities.base64Decode(b64), mime, 'foto-staff-' + loginKunciEmail_(data.email));
