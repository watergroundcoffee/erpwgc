/* ============================================================
   PEMBELIAN - Kontak Pemasok: CRUD di atas sheet "Data Supplier" & "Cabang Supplier"
   yang udah ada (dipakai juga sama fitur Invoice Supplier AI matching).
   ============================================================ */
function prosesLihatKontakPemasok(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var shSupplier = getDataSupplierSheet();
    var lastRowSupplier = shSupplier.getLastRow();
    var daftar = [];
    if (lastRowSupplier > 1) {
      shSupplier.getRange(2, 1, lastRowSupplier - 1, 4).getValues().forEach(function (row, i) {
        var nama = String(row[0] || '').trim();
        if (!nama) return;
        var kontakWA = [];
        try { if (row[3]) kontakWA = JSON.parse(row[3]); } catch (eParse) { kontakWA = []; }
        daftar.push({ row: i + 2, nama: nama, kontakUtama: row[1] || '', catatan: row[2] || '', kontakWA: kontakWA, cabang: [] });
      });
    }
    var mapSupplier = {};
    daftar.forEach(function (s) { mapSupplier[s.nama] = s; });

    var shCabang = getCabangSupplierSheet();
    var lastRowCabang = shCabang.getLastRow();
    if (lastRowCabang > 1) {
      shCabang.getRange(2, 1, lastRowCabang - 1, 4).getValues().forEach(function (row, i) {
        var namaSupplier = String(row[0] || '').trim();
        var namaCabang = String(row[1] || '').trim();
        if (!namaSupplier || !namaCabang) return;
        if (!mapSupplier[namaSupplier]) return; // cabang buat supplier yang udah dihapus, skip
        mapSupplier[namaSupplier].cabang.push({ row: i + 2, namaCabang: namaCabang, alamat: row[2] || '', kontak: row[3] || '' });
      });
    }

    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesSimpanSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var nama = String(data.nama || '').trim();
    var kontakUtama = String(data.kontakUtama || '').trim();
    var catatan = String(data.catatan || '').trim();
    // kontakWA: [{ namaJabatan, noWA }] - boleh lebih dari 1 (misal admin toko, PIC pengiriman, dll)
    var kontakWA = (data.kontakWA || []).filter(function (k) { return String(k.noWA || '').trim() || (k.wa && k.wa.length) || (k.email && k.email.length); }); // v2026.10.58: kontak email saja juga disimpan
    var kontakWAJson = JSON.stringify(kontakWA);
    if (!nama) throw new Error('Nama supplier wajib diisi');

    var sh = getDataSupplierSheet();
    var row = parseInt(data.row, 10);
    if (row && row >= 2) {
      sh.getRange(row, 1, 1, 4).setValues([[nama, kontakUtama, catatan, kontakWAJson]]);
    } else {
      var lastRow = sh.getLastRow();
      if (lastRow > 1) {
        var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
        for (var i = 0; i < vals.length; i++) {
          if (String(vals[i][0]).trim().toLowerCase() === nama.toLowerCase()) throw new Error('Supplier dengan nama ini udah ada');
        }
      }
      sh.appendRow([nama, kontakUtama, catatan, kontakWAJson]);
      row = sh.getLastRow();
    }
    result.success = true;
    result.row = row;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesHapusSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var row = parseInt(data.row, 10);
    if (!row || row < 2) throw new Error('Baris nggak valid');
    getDataSupplierSheet().deleteRow(row);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesSimpanCabangSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var namaSupplier = String(data.namaSupplier || '').trim();
    var namaCabang = String(data.namaCabang || '').trim();
    var alamat = String(data.alamat || '').trim();
    var kontak = String(data.kontak || '').trim();
    if (!namaSupplier || !namaCabang) throw new Error('Nama supplier dan nama cabang wajib diisi');

    var sh = getCabangSupplierSheet();
    var row = parseInt(data.row, 10);
    if (row && row >= 2) {
      sh.getRange(row, 1, 1, 4).setValues([[namaSupplier, namaCabang, alamat, kontak]]);
    } else {
      sh.appendRow([namaSupplier, namaCabang, alamat, kontak]);
      row = sh.getLastRow();
    }
    result.success = true;
    result.row = row; // dipakai Instant Action: baris baru di layar langsung dapat ID aslinya
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesHapusCabangSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var row = parseInt(data.row, 10);
    if (!row || row < 2) throw new Error('Baris nggak valid');
    getCabangSupplierSheet().deleteRow(row);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== Laporan Pembelian - ringkasan sederhana dari riwayat Minta Stock (No PO), biar
// disesuaikan lagi nanti sama kebutuhan toko - ini kerangka awal aja. =====
function prosesLihatLaporanPembelian(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'adminPembelian')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var riwayat = prosesLihatRiwayatMintaStock(data);
    if (!riwayat.success) throw new Error(riwayat.error || 'Gagal ambil data riwayat pembelian.');
    var daftar = riwayat.daftar || [];

    var sekarang = new Date();
    var awalBulanIni = new Date(sekarang.getFullYear(), sekarang.getMonth(), 1);
    var awalBulanLalu = new Date(sekarang.getFullYear(), sekarang.getMonth() - 1, 1);

    var poUnik = {}; // dedupe per No PO (1 PO bisa berisi banyak baris SKU)
    var poBulanIni = {}, poBulanLalu = {};
    var perStatus = {};

    daftar.forEach(function (item) {
      if (item.noPO && item.noPO !== '-') poUnik[item.noPO] = true;
      perStatus[item.status] = (perStatus[item.status] || 0) + 1;
      var tgl = new Date(item.tanggal);
      if (!isNaN(tgl.getTime()) && item.noPO && item.noPO !== '-') {
        if (tgl >= awalBulanIni) poBulanIni[item.noPO] = true;
        else if (tgl >= awalBulanLalu && tgl < awalBulanIni) poBulanLalu[item.noPO] = true;
      }
    });

    result.success = true;
    result.totalPO = Object.keys(poUnik).length;
    result.poBulanIni = Object.keys(poBulanIni).length;
    result.poBulanLalu = Object.keys(poBulanLalu).length;
    result.perStatus = perStatus;
    result.totalSupplier = getDataSupplierSheet().getLastRow() - 1;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   INPUT PEMBELIAN MANUAL - formulir input data pembelian manual (ganti sistem sync email
   otomatis yang udah dihapus). Staff isi sendiri: Supplier, No Invoice, daftar barang
   (SKU, Nama, Qty, Harga Satuan - subtotal & total otomatis dihitung), plus ongkos kirim
   opsional. Data ini juga otomatis nambah Stock Ledger (barang beneran diterima saat itu),
   dan ke depannya bisa diolah jadi Laporan Keuangan (belum sekarang).
   ============================================================ */
function getPembelianManualSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var shHeader = ss.getSheetByName('Pembelian Manual');
  if (!shHeader) {
    shHeader = ss.insertSheet('Pembelian Manual');
    shHeader.getRange(1, 1, 1, 10).setValues([[
      'No Invoice', 'Tanggal', 'Nama Supplier', 'Cabang', 'Jumlah Koli', 'Ongkos Kirim', 'Total', 'Dicatat Oleh', 'Status Dicek', 'Status Pembelian'
    ]]);
    shHeader.getRange(1, 1, 1, 10).setFontWeight('bold');
  } else if (shHeader.getLastColumn() < 8) {
    // Migrasi dari struktur lama (6 kolom: ...Ongkos Kirim, Total, Dicatat Oleh) ke yang baru -
    // sisipkan Cabang & Jumlah Koli SEBELUM Ongkos Kirim, biar data lama yang udah ada nggak berantakan.
    var lastRow = shHeader.getLastRow();
    if (lastRow > 1) {
      var dataLama = shHeader.getRange(2, 1, lastRow - 1, 6).getValues(); // No Invoice, Tanggal, Supplier, OngkosKirim, Total, DicatatOleh
      var dataBaru = dataLama.map(function (r) { return [r[0], r[1], r[2], '', '', r[3], r[4], r[5], 'Sudah Dicek', 'Aktif']; }); // data lama udah kepotong stock-nya duluan, anggap udah dicek
      shHeader.getRange(2, 1, dataBaru.length, 10).setValues(dataBaru);
    }
    shHeader.getRange(1, 1, 1, 10).setValues([[
      'No Invoice', 'Tanggal', 'Nama Supplier', 'Cabang', 'Jumlah Koli', 'Ongkos Kirim', 'Total', 'Dicatat Oleh', 'Status Dicek', 'Status Pembelian'
    ]]);
    shHeader.getRange(1, 1, 1, 10).setFontWeight('bold');
  } else if (shHeader.getLastColumn() < 9) {
    // Migrasi dari 8 kolom (belum ada Status Dicek) - data lama juga udah kepotong stock-nya pas disimpan, anggap "Sudah Dicek"
    var lastRow2 = shHeader.getLastRow();
    shHeader.getRange(1, 9).setValue('Status Dicek').setFontWeight('bold');
    if (lastRow2 > 1) {
      var statusLama = [];
      for (var r = 0; r < lastRow2 - 1; r++) statusLama.push(['Sudah Dicek']);
      shHeader.getRange(2, 9, statusLama.length, 1).setValues(statusLama);
    }
  } else if (shHeader.getLastColumn() < 10) {
    // Migrasi tambahan kolom Status Pembelian (Aktif/Dibatalkan) - data lama semuanya masih Aktif
    var lastRow3 = shHeader.getLastRow();
    shHeader.getRange(1, 10).setValue('Status Pembelian').setFontWeight('bold');
    if (lastRow3 > 1) {
      var statusPembelianLama = [];
      for (var r2 = 0; r2 < lastRow3 - 1; r2++) statusPembelianLama.push(['Aktif']);
      shHeader.getRange(2, 10, statusPembelianLama.length, 1).setValues(statusPembelianLama);
    }
  }
  // Kolom 11: Dokumen (link bukti/invoice/screenshot di Drive, dipisah baris baru) - ditambahkan otomatis
  if (shHeader.getMaxColumns() < 11) shHeader.insertColumnsAfter(shHeader.getMaxColumns(), 11 - shHeader.getMaxColumns());
  if (!String(shHeader.getRange(1, 11).getValue()).trim()) shHeader.getRange(1, 11).setValue('Dokumen').setFontWeight('bold');
  // Kolom 12: Biaya Lain (biaya layanan, asuransi, admin, packing kayu, dll - digabung jadi 1 angka; ikut masuk Total & HPP)
  if (shHeader.getMaxColumns() < 12) shHeader.insertColumnsAfter(shHeader.getMaxColumns(), 12 - shHeader.getMaxColumns());
  if (!String(shHeader.getRange(1, 12).getValue()).trim()) shHeader.getRange(1, 12).setValue('Biaya Lain').setFontWeight('bold');
  // Kolom 13: Diskon Supplier (potongan dari supplier atas seluruh invoice - mengurangi Total & HPP)
  if (shHeader.getMaxColumns() < 13) shHeader.insertColumnsAfter(shHeader.getMaxColumns(), 13 - shHeader.getMaxColumns());
  if (!String(shHeader.getRange(1, 13).getValue()).trim()) shHeader.getRange(1, 13).setValue('Diskon Supplier').setFontWeight('bold');
  var shDetail = ss.getSheetByName('Pembelian Manual Detail');
  if (!shDetail) {
    shDetail = ss.insertSheet('Pembelian Manual Detail');
    shDetail.getRange(1, 1, 1, 6).setValues([[
      'No Invoice', 'SKU', 'Nama Produk', 'Qty', 'Harga Satuan', 'Subtotal'
    ]]);
    shDetail.getRange(1, 1, 1, 6).setFontWeight('bold');
  }
  return { header: shHeader, detail: shDetail };
}

// Ringkas info error backend supaya bisa dibaca di console/alert front-end: pesan asli + nama
// fungsi & nomor baris (diambil dari stack trace V8 Apps Script, format "at fungsi (Code:123:45)").
function detailErrorBackend_(err, konteks) {
  var pesan = (err && err.message) ? err.message : String(err);
  var stack = (err && err.stack) ? String(err.stack) : '';
  var cocok = stack.match(/at\s+([\w$.]+)\s+\(([^:()]+):(\d+)(?::\d+)?\)/);
  return {
    konteks: konteks || '',
    pesan: pesan,
    nama: (err && err.name) || 'Error',
    fungsi: cocok ? cocok[1] : '',
    file: cocok ? cocok[2] : '',
    baris: cocok ? Number(cocok[3]) : ((err && err.lineNumber) || null),
    stack: stack.split('\n').slice(0, 6).join('\n')
  };
}

/* ============================================================
   SIMPAN PEMBELIAN MANUAL - versi batch + idempotent
   ------------------------------------------------------------
   Perbaikan (lihat catatan di chat):
   1. IDEMPOTENT: front-end mengirim `idempotencyKey` unik per form. Hasil sukses disimpan di
      CacheService 6 jam. Kalau request yang sama terkirim ulang (timeout di browser lalu retry,
      atau staf klik Simpan lagi), server MENGEMBALIKAN hasil sukses yang sama - bukan error
      "No Invoice udah pernah diinput" seperti sebelumnya.
   2. Validasi input dikerjakan SEBELUM mengambil lock -> lock dipegang sesingkat mungkin.
   3. Semua baca sheet dilakukan sekali (getValues), semua tulis dalam batch setValues:
      1 tulis header, 1 tulis detail, maks 1 tulis supplier & 1 tulis cabang.
   4. Error dikembalikan lengkap (pesan asli + fungsi + baris) lewat `errorDetail`.
   ============================================================ */
function prosesSimpanPembelianManual(data) {
  var result = { success: false };
  var tahap = 'validasi input';
  var lock = null;
  try {
    // ---------- 1) Validasi & susun data di MEMORY (tanpa lock, tanpa tulis sheet) ----------
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noInvoice = String(data.noInvoice || '').trim();
    var namaSupplier = String(data.namaSupplier || '').trim();
    var cabang = String(data.cabang || '').trim(); // opsional - boleh kosong
    var jumlahKoli = (data.jumlahKoli !== undefined && data.jumlahKoli !== null && data.jumlahKoli !== '') ? (parseFloat(data.jumlahKoli) || 0) : '';
    var ongkosKirim = parseFloat(data.ongkosKirim) || 0;
    var biayaLain = parseFloat(data.biayaLain) || 0;
    var diskon = parseFloat(data.diskon) || 0;
    var items = Array.isArray(data.items) ? data.items : [];
    var idemKey = String(data.idempotencyKey || '').trim().substring(0, 80);
    var dokumen = dokumenBersihkan_(data.dokumen);
    if (!noInvoice) throw new Error('No Invoice wajib diisi');
    if (!namaSupplier) throw new Error('Nama Supplier wajib diisi');
    if (items.length === 0) throw new Error('Minimal 1 barang harus diisi');
    if (items.length > 500) throw new Error('Maksimal 500 baris barang per invoice');
    if (ongkosKirim < 0) throw new Error('Ongkos Kirim tidak boleh minus');
    if (biayaLain < 0) throw new Error('Biaya Lainnya tidak boleh minus');
    if (diskon < 0) throw new Error('Diskon Supplier tidak boleh minus');
    namaSupplier = namaSupplier.replace(/\s+/g, ' ');

    var totalBarang = 0;
    var barisDetail = [];
    items.forEach(function (item) {
      var sku = String((item && item.sku) || '').trim();
      var nama = String((item && item.nama) || '').trim();
      var qty = parseFloat(item && item.qty) || 0;
      var hargaSatuan = parseFloat(item && item.hargaSatuan) || 0;
      if (!sku || qty <= 0) return; // skip baris kosong/nggak valid
      if (hargaSatuan < 0) throw new Error('Harga satuan SKU ' + sku + ' tidak boleh minus');
      var subtotal = qty * hargaSatuan;
      totalBarang += subtotal;
      barisDetail.push([noInvoice, sku, nama, qty, hargaSatuan, subtotal]);
      // TIDAK langsung nambah Stock Ledger - stock baru ketambah saat staff gudang konfirmasi Checklist.
    });
    if (barisDetail.length === 0) throw new Error('Nggak ada barang yang valid (SKU/Qty kosong)');
    if (diskon > totalBarang + ongkosKirim + biayaLain) throw new Error('Diskon Supplier lebih besar dari total belanja');
    var totalKeseluruhan = totalBarang + ongkosKirim + biayaLain - diskon;

    var tanggalCatat = new Date();
    if (data.tanggalTransaksi) {
      var tglParsed = new Date(data.tanggalTransaksi);
      if (!isNaN(tglParsed.getTime())) tanggalCatat = tglParsed;
    }
    var namaStaff = getNamaStaff(data.email);
    var cache = CacheService.getScriptCache();
    var kunciCache = idemKey ? 'IDEM_PM_' + idemKey : '';

    // ---------- 2) Kunci singkat: cek duplikat + tulis batch ----------
    tahap = 'menunggu antrean simpan';
    lock = kunciModul_('pembelian');
    if (!lock.tryLock(25000)) throw new Error('Server sedang memproses simpan data lain. Tunggu beberapa detik lalu klik Simpan lagi (aman, tidak akan dobel).');

    // Request ulang dari form yang sama (retry/timeout) -> kembalikan hasil sukses sebelumnya
    if (kunciCache) {
      var hasilLama = cache.get(kunciCache);
      if (hasilLama) {
        var parsedLama = JSON.parse(hasilLama);
        parsedLama.sudahTersimpanSebelumnya = true;
        return parsedLama;
      }
    }

    tahap = 'membaca sheet pembelian';
    var sheets = getPembelianManualSheets();
    var lastRowHeader = sheets.header.getLastRow();
    if (lastRowHeader > 1) {
      var noInvoiceSemua = sheets.header.getRange(2, 1, lastRowHeader - 1, 1).getValues();
      var noInvLower = noInvoice.toLowerCase();
      for (var di = 0; di < noInvoiceSemua.length; di++) {
        if (String(noInvoiceSemua[di][0]).trim().toLowerCase() === noInvLower) {
          throw new Error('No Invoice "' + noInvoice + '" udah pernah diinput sebelumnya - nggak bisa diinput dobel. Cek daftar Pembelian.');
        }
      }
    }

    tahap = 'memperbarui Kontak Pemasok';
    // Auto-simpan Supplier & Cabang ke Kontak Pemasok kalau belum ada (baca 1x, tulis maks 1x per sheet)
    var shSupplier = getDataSupplierSheet();
    var lastRowSupplier = shSupplier.getLastRow();
    var namaSupLower = namaSupplier.toLowerCase();
    var namaSupplierResmi = '';
    if (lastRowSupplier > 1) shSupplier.getRange(2, 1, lastRowSupplier - 1, 1).getValues().some(function (r) {
      if (String(r[0]).replace(/\s+/g, ' ').trim().toLowerCase() === namaSupLower) { namaSupplierResmi = String(r[0]).trim(); return true; }
      return false;
    });
    if (namaSupplierResmi) namaSupplier = namaSupplierResmi; // pakai ejaan yang sudah ada di Kontak Pemasok (beda huruf besar/kecil/spasi = supplier yang sama)
    else {
      // Supplier BARU -> otomatis dicatat di Kontak Pemasok
      shSupplier.getRange(lastRowSupplier + 1, 1, 1, 4).setValues([[namaSupplier, '', 'Ditambahkan otomatis dari Input Pembelian ' + noInvoice, '[]']]);
      result.supplierBaru = true;
    }

    if (cabang) {
      var shCabang = getCabangSupplierSheet();
      var lastRowCabang = shCabang.getLastRow();
      var cabangLower = cabang.toLowerCase();
      var cabangSudahAda = lastRowCabang > 1 && shCabang.getRange(2, 1, lastRowCabang - 1, 2).getValues()
        .some(function (r) { return String(r[0]).trim().toLowerCase() === namaSupLower && String(r[1]).trim().toLowerCase() === cabangLower; });
      if (!cabangSudahAda) { shCabang.getRange(lastRowCabang + 1, 1, 1, 4).setValues([[namaSupplier, cabang, '', '']]); result.cabangBaru = true; }
    }

    tahap = 'menulis invoice';
    // 1x tulis header (10 kolom lengkap, termasuk Status Pembelian = Aktif) + 1x tulis semua detail
    sheets.header.getRange(lastRowHeader + 1, 1, 1, 13).setValues([[
      noInvoice, tanggalCatat, namaSupplier, cabang, jumlahKoli, ongkosKirim, totalKeseluruhan, namaStaff, 'Belum Dicek', 'Aktif', dokumen.join('\n'), biayaLain, diskon
    ]]);
    sheets.detail.getRange(sheets.detail.getLastRow() + 1, 1, barisDetail.length, 6).setValues(barisDetail);

    result.success = true;
    result.noInvoice = noInvoice;
    result.namaSupplier = namaSupplier;
    result.total = totalKeseluruhan;
    result.jumlahItem = barisDetail.length;
    if (kunciCache) { try { cache.put(kunciCache, JSON.stringify(result), 21600); } catch (eCache) { /* biarin */ } }
  } catch (err) {
    result.success = false;
    result.error = (err && err.message) ? err.message : String(err);
    result.errorDetail = detailErrorBackend_(err, 'simpan_pembelian_manual - tahap: ' + tahap);
    console.error('prosesSimpanPembelianManual gagal (' + tahap + '): ' + result.error + '\n' + result.errorDetail.stack);
  } finally {
    if (lock) { try { lepasKunci_(lock); } catch (eRel) { /* lock mungkin nggak didapat */ } }
  }
  return result;
}

// Edit Cabang/Jumlah Koli/Ongkos Kirim dari pembelian manual yang udah tersimpan - bukan buat
// ubah daftar barangnya (itu udah kesimpen & udah motong stock, biar nggak ribet re-kalkulasi).
// Total dihitung ULANG dari subtotal barang asli (sheet Detail) + Ongkos Kirim yang baru.
function prosesEditPembelianManual(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noInvoice = String(data.noInvoice || '').trim();
    if (!noInvoice) throw new Error('No Invoice kosong');
    var cabang = String(data.cabang || '').trim();
    var jumlahKoli = data.jumlahKoli !== undefined && data.jumlahKoli !== '' ? parseFloat(data.jumlahKoli) || 0 : '';
    var ongkosKirim = parseFloat(data.ongkosKirim) || 0;
    var biayaLainEdit = data.biayaLain === undefined ? null : (parseFloat(data.biayaLain) || 0);
    var diskonEdit = data.diskon === undefined ? null : (parseFloat(data.diskon) || 0);
    if (ongkosKirim < 0 || (biayaLainEdit !== null && biayaLainEdit < 0) || (diskonEdit !== null && diskonEdit < 0)) throw new Error('Ongkos kirim / biaya lainnya / diskon tidak boleh minus');

    var sheets = getPembelianManualSheets();
    var lastRowHeader = sheets.header.getLastRow();
    var rowTarget = -1;
    if (lastRowHeader > 1) {
      var valsNoInvoice = sheets.header.getRange(2, 1, lastRowHeader - 1, 1).getValues();
      for (var i = 0; i < valsNoInvoice.length; i++) {
        if (String(valsNoInvoice[i][0]).trim() === noInvoice) { rowTarget = i + 2; break; }
      }
    }
    if (rowTarget === -1) throw new Error('Data pembelian dengan No Invoice ini nggak ketemu');

    // Hitung ulang subtotal barang asli dari sheet Detail (bukan dari input user - biar nggak bisa dimanipulasi/salah ketik)
    var lastRowDetail = sheets.detail.getLastRow();
    var subtotalBarang = 0;
    if (lastRowDetail > 1) {
      sheets.detail.getRange(2, 1, lastRowDetail - 1, 6).getValues().forEach(function (row) {
        if (String(row[0]).trim() === noInvoice) subtotalBarang += parseFloat(row[5]) || 0;
      });
    }
    var biayaLainBaru = biayaLainEdit !== null ? biayaLainEdit : (parseFloat(sheets.header.getRange(rowTarget, 12).getValue()) || 0);
    var diskonBaru = diskonEdit !== null ? diskonEdit : (parseFloat(sheets.header.getRange(rowTarget, 13).getValue()) || 0);
    if (diskonBaru > subtotalBarang + ongkosKirim + biayaLainBaru) throw new Error('Diskon Supplier lebih besar dari total belanja');
    var totalBaru = subtotalBarang + ongkosKirim + biayaLainBaru - diskonBaru;

    sheets.header.getRange(rowTarget, 4, 1, 4).setValues([[cabang, jumlahKoli, ongkosKirim, totalBaru]]); // Cabang, Jumlah Koli, Ongkos Kirim, Total
    sheets.header.getRange(rowTarget, 12, 1, 2).setValues([[biayaLainBaru, diskonBaru]]);
    try { finInvalidasi_(); } catch (eF) { }

    result.success = true;
    result.total = totalBaru;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Batalkan pembelian manual - status ditandai "Dibatalkan" (bukan dihapus, biar jejaknya
// tetap ada buat audit). Kalau stock-nya udah kepotong (Status Dicek = Sudah Dicek), OTOMATIS
// dikoreksi balik (tulis "Keluar" sejumlah yang beneran ketambah dulu, dicari dari Stock Ledger
// berdasarkan catatan invoice ini - bukan dari qty invoice, biar akurat walau ada Claim/selisih).
// TODO: begitu modul Finance beneran dibangun, tambahin di sini: hapus/batalkan entri Finance
// yang terhubung ke No Invoice ini juga.
function prosesBatalkanPembelianManual(data) {
  var noInvoice;
  return withTransaction(data.email, 'mintaStock', ['pembelian', 'stok'], function () {
    var result = { success: false };
    var sheets = getPembelianManualSheets();
    var lastRowHeader = sheets.header.getLastRow();
    var rowTarget = -1, statusDicekSaatIni = '', statusPembelianSaatIni = '';
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 10).getValues();
      for (var hi = 0; hi < valsHeader.length; hi++) {
        if (String(valsHeader[hi][0]).trim() === noInvoice) {
          rowTarget = hi + 2; statusDicekSaatIni = valsHeader[hi][8] || 'Belum Dicek'; statusPembelianSaatIni = valsHeader[hi][9] || 'Aktif';
          break;
        }
      }
    }
    if (rowTarget === -1) throw new Error('Invoice ini nggak ketemu');
    if (statusPembelianSaatIni === 'Dibatalkan') throw new Error('Invoice ini udah dibatalkan sebelumnya.');

    var namaStaff = getNamaStaff(data.email);
    var jumlahDikoreksi = 0;

    if (statusDicekSaatIni === 'Sudah Dicek') {
      // Cari semua entri Stock Ledger yang beneran ketambah dari invoice ini, koreksi balik per SKU
      var shLedger = getStockLedgerSheet();
      var lastRowLedger = shLedger.getLastRow();
      var polaCatatan = 'Terima Invoice Manual ' + noInvoice + ' ';
      if (lastRowLedger > 1) {
        var valsLedger = shLedger.getRange(2, 1, lastRowLedger - 1, 5).getValues(); // Tanggal, SKU, Jenis, Qty, Keterangan
        var totalPerSku = {};
        valsLedger.forEach(function (row) {
          var keterangan = String(row[4] || '');
          if (row[2] === 'Masuk' && keterangan.indexOf(polaCatatan) === 0) {
            var sku = String(row[1]).trim();
            totalPerSku[sku] = (totalPerSku[sku] || 0) + (parseFloat(row[3]) || 0);
          }
        });
        Object.keys(totalPerSku).forEach(function (sku) {
          if (totalPerSku[sku] > 0) {
            shLedger.appendRow([new Date(), sku, 'Keluar', totalPerSku[sku], 'Koreksi - Pembelian Manual ' + noInvoice + ' dibatalkan', namaStaff, 0, 0]);
            jumlahDikoreksi++;
          }
        });
      }
    }

    sheets.header.getRange(rowTarget, 10).setValue('Dibatalkan');
    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();
    try { finInvalidasi_(); } catch (eF) { }

    result.success = true;
    result.jumlahDikoreksi = jumlahDikoreksi;
    result.stockDikoreksi = statusDicekSaatIni === 'Sudah Dicek';
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      noInvoice = String(data.noInvoice || '').trim();
      if (!noInvoice) throw new Error('No Invoice kosong');
    }
  });
}

// Hapus PERMANEN invoice pembelian - hanya untuk invoice yang SUDAH DIBATALKAN (2 langkah: Batalkan -> Hapus Permanen).
// Baris header + semua baris barangnya dihapus dari sheet. Salinan lengkapnya disimpan dulu di sheet
// "Log Hapus Pembelian" (jaga-jaga / audit). Riwayat Stock Ledger (masuk + koreksi batal) TIDAK disentuh,
// karena saldo stok dari invoice yang dibatalkan memang sudah nol.
function getLogHapusPembelianSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Log Hapus Pembelian');
  if (!sh) {
    sh = ss.insertSheet('Log Hapus Pembelian');
    sh.getRange(1, 1, 1, 6).setValues([['Waktu Hapus', 'No Invoice', 'Supplier', 'Total', 'Dihapus Oleh', 'Salinan Data (JSON)']]).setFontWeight('bold');
  }
  return sh;
}
function prosesHapusPermanenPembelianManual(data) {
  return withTransaction(data.email, null, 'pembelian', function () {
    var result = { success: false };
    var staff = getStaffByEmail(data.email);
    if (!cekIzin(data.email, 'buatInvoice') && !(staff && staff.role === 'Owner')) throw new Error('Hapus permanen hanya untuk Owner / Admin Keuangan.');
    var noInvoice = String(data.noInvoice || '').trim();
    if (!noInvoice) throw new Error('No Invoice kosong');
    var sheets = getPembelianManualSheets();
    var lrH = sheets.header.getLastRow(), rowTarget = -1, header = null;
    if (lrH > 1) {
      var vals = sheets.header.getRange(2, 1, lrH - 1, 13).getValues();
      for (var i = 0; i < vals.length; i++) if (String(vals[i][0]).trim() === noInvoice) { rowTarget = i + 2; header = vals[i]; break; }
    }
    if (rowTarget === -1) throw new Error('Invoice ini tidak ditemukan (mungkin sudah dihapus).');
    if (String(header[9] || '') !== 'Dibatalkan') throw new Error('Invoice harus DIBATALKAN dulu sebelum bisa dihapus permanen.');

    // Kumpulkan baris detail invoice ini
    var lrD = sheets.detail.getLastRow(), barisDetail = [], dataDetail = [];
    if (lrD > 1) sheets.detail.getRange(2, 1, lrD - 1, 6).getValues().forEach(function (r, j) {
      if (String(r[0]).trim() === noInvoice) { barisDetail.push(j + 2); dataDetail.push(r.slice(1)); }
    });

    // 1) Simpan salinan ke log
    var tz = Session.getScriptTimeZone();
    var salinan = {
      header: header.map(function (v) { return v instanceof Date ? Utilities.formatDate(v, tz, 'yyyy-MM-dd HH:mm:ss') : v; }),
      detail: dataDetail
    };
    getLogHapusPembelianSheet().appendRow([new Date(), noInvoice, header[2], header[6], getNamaStaff(data.email) || data.email || '', JSON.stringify(salinan).slice(0, 49000)]);

    // 2) Hapus baris detail (dikelompokkan per blok berurutan, dari bawah ke atas) lalu header
    barisDetail.sort(function (a, b) { return b - a; });
    var k = 0;
    while (k < barisDetail.length) {
      var akhir = barisDetail[k], awal = akhir;
      while (k + 1 < barisDetail.length && barisDetail[k + 1] === awal - 1) { k++; awal--; }
      sheets.detail.deleteRows(awal, akhir - awal + 1);
      k++;
    }
    sheets.header.deleteRow(rowTarget);
    SpreadsheetApp.flush();
    try { invalidasiCacheGabunganPesanan(); } catch (eC) { }
    try { finInvalidasi_(); } catch (eF) { }
    result.success = true;
    result.noInvoice = noInvoice;
    result.barisBarang = barisDetail.length;
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

function prosesLihatDaftarPembelianManual(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sheets = getPembelianManualSheets();
    var lastRowHeader = sheets.header.getLastRow();
    var daftar = [];
    if (lastRowHeader > 1) {
      var tz = Session.getScriptTimeZone();
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, Math.min(13, sheets.header.getMaxColumns())).getValues();
      // Teks barang per invoice (SKU + nama) - dipakai fitur Cari di List Pembelian (web)
      var teksBarang = {}, jmlBarang = {};
      if (sheets.detail.getLastRow() > 1) sheets.detail.getRange(2, 1, sheets.detail.getLastRow() - 1, 4).getValues().forEach(function (d) {
        var inv = String(d[0] || '').trim().toLowerCase(); if (!inv) return;
        var t = String(d[1] || '').trim() + ' ' + String(d[2] || '').trim();
        if (!teksBarang[inv]) teksBarang[inv] = '';
        if (teksBarang[inv].length < 600) teksBarang[inv] += (teksBarang[inv] ? ' | ' : '') + t;
        jmlBarang[inv] = (jmlBarang[inv] || 0) + 1;
      });
      valsHeader.forEach(function (row) {
        var noInvoice = String(row[0] || '').trim();
        if (!noInvoice) return;
        daftar.push({
          barangTeks: teksBarang[noInvoice.toLowerCase()] || '', jumlahBarang: jmlBarang[noInvoice.toLowerCase()] || 0,
          dokumen: String(row[10] || '').split(/\n+/).map(function (u) { return u.trim(); }).filter(function (u) { return u; }),
          noInvoice: noInvoice,
          tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy HH:mm') : String(row[1] || '-'),
          tanggalObj: row[1] instanceof Date ? row[1].getTime() : 0,
          namaSupplier: row[2], cabang: row[3] || '-', jumlahKoli: row[4] !== '' ? row[4] : '-',
          ongkosKirim: parseFloat(row[5]) || 0, biayaLain: parseFloat(row[11]) || 0, diskon: parseFloat(row[12]) || 0, total: parseFloat(row[6]) || 0, dicatatOleh: row[7],
          statusDicek: row[8] || 'Belum Dicek', statusPembelian: row[9] || 'Aktif'
        });
      });
    }
    daftar.sort(function (a, b) { return b.tanggalObj - a.tanggalObj; });
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   UPLOAD DOKUMEN TRANSAKSI (Pembelian & Biaya Operasional)
   Dipanggil dari zona upload (drag / klik / paste screenshot). File langsung ke Drive,
   yang disimpan di sheet cuma link-nya. Gambar -> link lh3 (bisa ditampilkan), lainnya -> link Drive.
   ============================================================ */
var DOKUMEN_MAKS_BYTE = 12 * 1024 * 1024;
var DOKUMEN_FOLDER = { pembelian: 'Dokumen Pembelian', biaya: 'Struk Biaya Operasional' };

function prosesUploadDokumenTransaksi(data) {
  var result = { success: false };
  try {
    var jenis = data.jenis === 'biaya' ? 'biaya' : 'pembelian';
    if (!cekIzin(data.email, jenis === 'biaya' ? 'buatInvoice' : 'mintaStock')) throw new Error('Anda tidak punya izin untuk upload dokumen ini.');
    var b64 = String(data.base64 || '');
    if (!b64) throw new Error('File kosong');
    var bytes = Utilities.base64Decode(b64);
    if (bytes.length > DOKUMEN_MAKS_BYTE) throw new Error('File terlalu besar (maks 12 MB)');
    var mime = String(data.mimeType || 'application/octet-stream');
    // v2026.10.113 (DN-997): bukti biaya boleh Excel / CSV juga
    if (!/^(image\/|application\/pdf$|application\/vnd\.ms-excel$|application\/vnd\.openxmlformats-officedocument\.spreadsheetml\.sheet$|text\/csv$)/.test(mime)) throw new Error('Format tidak didukung - pakai gambar (JPG/PNG/WEBP), PDF, Excel atau CSV');
    var tz = Session.getScriptTimeZone();
    var namaAsli = String(data.nama || '').replace(/[\\/:*?"<>|]+/g, ' ').trim().slice(0, 80) || (mime === 'application/pdf' ? 'dokumen.pdf' : 'gambar.jpg');
    var nama = Utilities.formatDate(new Date(), tz, 'yyyyMMdd-HHmmss') + ' ' + namaAsli;
    var file = getSubfolderUpload(DOKUMEN_FOLDER[jenis]).createFile(Utilities.newBlob(bytes, mime, nama));
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    result.success = true;
    result.id = file.getId();
    result.nama = namaAsli;
    result.mime = mime;
    result.url = /^image\//.test(mime) ? 'https://lh3.googleusercontent.com/d/' + file.getId() : 'https://drive.google.com/file/d/' + file.getId() + '/view';
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Terima array link dokumen dari frontend, hanya link Drive/lh3 milik sistem ini yang disimpan
function dokumenBersihkan_(arr) {
  if (!Array.isArray(arr)) return [];
  return arr.map(function (u) { return String((u && u.url) || u || '').trim(); })
    .filter(function (u) { return /^https:\/\/(lh3\.googleusercontent\.com\/d\/|drive\.google\.com\/file\/d\/)[\w-]+/.test(u); })
    .slice(0, 10);
}

