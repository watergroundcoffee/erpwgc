    var tz = Session.getScriptTimeZone(), hariIni = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
    var namaStaff = getNamaStaff(data.email) || data.email || 'Owner';
    var potong = !!data.potongStok && !data.cekSaja;
    var lock = kunciModul_(potong ? ['penjualan', 'stok'] : 'penjualan');
    if (!data.cekSaja) { try { lock.waitLock(30000); } catch (eL) { return { success: false, error: 'Sistem sedang sibuk, coba lagi.' }; } }
    try {
      var sh = getPesananManualSheets(), lr = sh.header.getLastRow(), ada = {};
