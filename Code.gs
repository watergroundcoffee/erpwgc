  try {
    var ada = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'sinkronBookingShopeeTrigger'; });
    if (!ada) ScriptApp.newTrigger('sinkronBookingShopeeTrigger').timeBased().everyMinutes(30).create();
    cache.put('BOOKING_TRIGGER_OK', '1', 21600);
  } catch (e) { Logger.log('Trigger booking belum terpasang: ' + e); }
}

/* ============================================================
   PENGIRIMAN KILAT - CEK RESI (disederhanakan) & REKAP
   ------------------------------------------------------------
   kilat_cek_resi: 1 No Resi -> No Reservasi (Booking SN), No Pesanan Pembeli (atau "-"), status,
   dan durasi sampai diretur. Urutan pencarian (berhenti di langkah pertama yang berhasil):
     1. Sheet "Transfer Gudang Shopee" (sudah tercatat).
     2. Detail booking Shopee (resi di package_list) - daftar booking di-cache 20 menit.
     3. Endpoint tracking booking, khusus booking yang resinya belum diketahui (hasil per booking di-cache 6 jam).
     4. PERKIRAAN: booking tanpa resi yang dibuat paling dekat SEBELUM resi discan (maks 4 hari) -
        ditandai "perkiraan" dan baru disimpan setelah staff menekan Konfirmasi.
   Hasil pasti (langkah 1-3) langsung disimpan ke sheet: resi terhubung, produk & order pembeli terisi.
   ============================================================ */
function kilatMasterProduk_() {
  var peta = {};
  try {
    var sh = getMasterProdukSheet(), lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 1, lr - 1, Math.min(9, sh.getMaxColumns())).getValues().forEach(function (r) {
      var sku = String(r[0] || '').trim();
      if (!sku) return;
      var hargaShopee = Number(r[6]) || 0, hargaDefault = Number(r[2]) || 0;
      peta[sku.toUpperCase()] = { sku: sku, nama: String(r[1] || ''), hpp: Number(r[3]) || 0, hargaJual: hargaShopee || hargaDefault, hargaDariShopee: hargaShopee > 0, foto: String(r[8] || '') };
    });
  } catch (e) {}
  return peta;
}

// Resi yang discan MASUK (retur) -> tanggal pertama kali discan retur
function kilatPetaRetur_() {
  var peta = {};
  try {
    var sh = getSheetInfo('retur').sheet, lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 1, lr - 1, 2).getValues().forEach(function (r) {
      var k = kunciResi_(r[0]);
      if (k && r[1] instanceof Date && (!peta[k] || r[1] < peta[k])) peta[k] = r[1];
    });
    // v2026.10.56 (DN-261022-215843-684): retur yang ID Pesanannya diisi manual dengan No Reservasi / resi Pengiriman Kilat
    // ikut dihitung "Diretur" (dulu hanya cocok bila resi retur = resi kirim)
    var det = returBacaDetail_();
    Object.keys(det).forEach(function (kr) {
      var km = kunciResi_(det[kr].idManual), tg = peta[kr];
      if (km && tg && (!peta[km] || tg < peta[km])) peta[km] = tg;
    });
  } catch (e) {}
  return peta;
}

function kilatInfoBaris_(t, petaRetur, statusOrder) {
  var akhir = tgsStatusAkhir_(t, statusOrder || {});
  var tglRetur = (t.noResi ? petaRetur[kunciResi_(t.noResi)] : null) || (t.noReservasi ? petaRetur[kunciResi_(t.noReservasi)] : null) || null;
  var hasil;
  if (tglRetur || akhir.kode === 'retur') hasil = 'Diretur';
  else if (t.status === 'Batal' || akhir.kode === 'batal') hasil = (t.noResi || t.msKirim) ? 'Menunggu Retur' : 'Batal'; // v2026.10.56: barang sudah dikirim -> wajib kembali
  else if (akhir.kode === 'terjual' || t.status === 'Diterima') hasil = 'Berhasil';
  else hasil = 'Dalam Proses';
  // v2026.10.56 (DN-261022-215843-684): setiap Pengiriman Kilat harus berakhir Berhasil atau Diretur.
  // Belum pasti > 14 hari sejak dikirim (aturan resi bermasalah) -> ditandai perlu dicek / siapkan komplain.
  var perluCek = '';
  if (hasil === 'Menunggu Retur') perluCek = 'Booking dibatalkan tapi barang sudah dikirim - pastikan barang kembali (scan di Resi Masuk) atau ajukan komplain ke Shopee.';
  else if (hasil === 'Dalam Proses' && akhir.umurHari !== null && akhir.umurHari > 14 && akhir.kode !== 'menunggu-pembeli' && akhir.kode !== 'terjual-proses') perluCek = 'Sudah ' + akhir.umurHari + ' hari tanpa kepastian - cek status di Shopee / siapkan komplain.';
  else if (hasil === 'Dalam Proses' && akhir.kode === 'batal-pembeli' && akhir.umurHari !== null && akhir.umurHari > 14) perluCek = 'Pesanan pembeli dibatalkan ' + akhir.umurHari + ' hari lalu - pastikan stok masih di Gudang Shopee atau sudah kembali.';
  var durasiRetur = null;
  if (tglRetur && t.msKirim) durasiRetur = Math.max(0, Math.round((tglRetur.getTime() - t.msKirim) / 3600000 / 24 * 10) / 10);
  return {
    hasil: hasil, statusAkhir: akhir.label, umurHari: akhir.umurHari, perluCek: perluCek,
    tanggalRetur: tglRetur ? Utilities.formatDate(tglRetur, Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm') : '',
    durasiHariSampaiRetur: durasiRetur
  };
}

function kilatDaftarBookingDetail_(kred) {
  var c = cacheBesarGet_('KILAT_BOOKING_DETAIL_V1');
  if (c && c.detail) return c;
  var hasil = { error: [], diagnosis: {} };
  var daftar = bookingAmbilList_(kred, hasil), sns = Object.keys(daftar), detail = [];
  for (var i = 0; i < sns.length; i += 50) {
    var batch = sns.slice(i, i + 50).join(',');
    var r = shopeeGet_('/api/v2/order/get_booking_detail', { booking_sn_list: batch, response_optional_fields: 'item_list,package_list' }, kred);
    if (!r.ok && /param/i.test(r.error + r.pesan)) r = shopeeGet_('/api/v2/order/get_booking_detail', { booking_sn_list: batch }, kred);
    if (!r.ok) { hasil.error.push('get_booking_detail: ' + r.error + ' ' + r.pesan); break; }
    ((r.json.response && (r.json.response.booking_list || r.json.response.list)) || []).forEach(function (b) { detail.push(bookingUraikan_(b)); });
  }
  var out = { detail: detail, error: hasil.error };
  if (detail.length || !hasil.error.length) cacheBesarPut_('KILAT_BOOKING_DETAIL_V1', out, 1200);
  return out;
}

function kilatTrackingBooking_(kred, sn) {
  var cache = CacheService.getScriptCache(), kunci = 'KILAT_TRK_' + sn, ada = cache.get(kunci);
  if (ada !== null) return ada === '-' ? '' : ada;
  var props = PropertiesService.getScriptProperties(), epDikenal = props.getProperty('BOOKING_ENDPOINT_RESI');
  var daftarEp = epDikenal ? BOOKING_ENDPOINT_RESI.filter(function (e) { return e.path === epDikenal; }) : BOOKING_ENDPOINT_RESI;
  for (var e = 0; e < daftarEp.length; e++) {
    var p = {}; p[daftarEp[e].param] = sn;
    var t = shopeeGet_(daftarEp[e].path, p, kred);
    if (!t.ok) continue;
    var resp = t.json.response || {};
    var tn = String(bkAmbil_(resp, ['tracking_number', 'tracking_no', 'logistics_tracking_number']) || sbsCariNilai_(resp, /^tracking_(number|no)$/i) || '').trim();
    if (tn) { props.setProperty('BOOKING_ENDPOINT_RESI', daftarEp[e].path); cache.put(kunci, tn, 21600); return tn; }
    break;
  }
  cache.put(kunci, '-', 21600);
  return '';
}

function kilatJawab_(t, petaRetur, sumber) {
  var info = kilatInfoBaris_(t, petaRetur, KONTEKS_KILAT_.statusOrderShopee);
  return {
    success: true, ditemukan: true, tebakan: false, sumber: sumber, noResi: t.noResi, noReservasi: t.noReservasi,
    noPesananPembeli: t.orderPembeli || '-', status: t.status, statusBooking: t.statusBooking, tanggalKirim: t.tanggalKirim || '',
    hasil: info.hasil, statusAkhir: info.statusAkhir, umurHari: info.umurHari, tanggalRetur: info.tanggalRetur, perluCek: info.perluCek,
    durasiHariSampaiRetur: info.durasiHariSampaiRetur, item: t.item.map(function (it) { return { sku: it.sku, nama: it.nama, qty: it.qtyKirim }; })
  };
}

function prosesKilatCekResi(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiKeluar')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var resi = String(data.noResi || '').trim().replace(/^'+/, '');
    if (!resi) throw new Error('No Resi kosong.');
    var petaRetur = kilatPetaRetur_();

    // 0) Konfirmasi perkiraan dari staff -> simpan
    if (data.konfirmasiReservasi) {
      var sim = prosesTandaiPengirimanKilat({ email: data.email, noReservasi: String(data.konfirmasiReservasi).trim(), noResi: resi });
      if (!sim.success) throw new Error(sim.error || 'Gagal menyimpan');
      tgsResetMemo_();
      kilatLengkapiDariBooking_(data.email, String(data.konfirmasiReservasi).trim());
    }

    // 1) Sudah tercatat di sheet
    tgsResetMemo_();
    try { KONTEKS_KILAT_.statusOrderShopee = kilatStatusOrderRingan_(tgsBacaSemua_(), false); } catch (eSO) { }
    var t = tgsBacaSemua_().filter(function (x) { return x.noResi && resiSama_(x.noResi, resi); })[0];
    if (t) return kilatJawab_(t, petaRetur, data.konfirmasiReservasi ? 'konfirmasi' : 'sheet');

    var kred = ambilKredensialShopee();
    if (!kred.accessToken || !kred.shopId) return { success: true, ditemukan: false, alasan: 'Shopee belum terhubung - No Reservasi tidak bisa dicari otomatis.' };
    var bk = kilatDaftarBookingDetail_(kred);
    if (!bk.detail.length) return { success: true, ditemukan: false, alasan: bk.error.length ? 'API booking Shopee menolak: ' + bk.error[0] : 'Tidak ada booking Pengiriman Kilat dalam ' + BOOKING_HARI_MUNDUR + ' hari terakhir.' };

    var terhubung = {};
    tgsBacaSemua_().forEach(function (x) { if (x.noResi) terhubung[x.noReservasi] = true; });
    var waktuScan = Number(data.waktuScanMs) || Date.now();

    // 2) Resi ada di detail booking
    var cocok = bk.detail.filter(function (d) { return d.resi.some(function (r) { return resiSama_(r, resi); }); })[0];
    // 3) Endpoint tracking (booking terdekat dengan waktu scan dicek lebih dulu), maks 25 panggilan
    if (!cocok) {
      var kandidatTrk = bk.detail.filter(function (d) { return !d.resi.length && !terhubung[d.bookingSn] && d.status !== 'CANCELLED'; })
        .sort(function (a, b) { return Math.abs(waktuScan - a.dibuat * 1000) - Math.abs(waktuScan - b.dibuat * 1000); }).slice(0, 25);
      for (var i = 0; i < kandidatTrk.length && !cocok; i++) {
        var tn = kilatTrackingBooking_(kred, kandidatTrk[i].bookingSn);
        if (tn && resiSama_(tn, resi)) { cocok = kandidatTrk[i]; cocok.resi = [tn]; }
      }
    }
    if (cocok) {
      var simpan = prosesTandaiPengirimanKilat({ email: data.email, noReservasi: cocok.bookingSn, noResi: resi });
      if (!simpan.success) throw new Error(simpan.error || 'Gagal menyimpan reservasi');
      kilatLengkapiDariBooking_(data.email, cocok.bookingSn, cocok);
      tgsResetMemo_();
      var t2 = tgsBacaSemua_().filter(function (x) { return x.noReservasi === cocok.bookingSn; })[0];
      invalidasiCacheGabunganPesanan();
      if (t2) return kilatJawab_(t2, petaRetur, 'shopee');
    }

    // 4) Perkiraan (belum disimpan - perlu konfirmasi)
    var kandidat = bk.detail.filter(function (d) {
      var ms = d.dibuat * 1000;
      return d.status !== 'CANCELLED' && !terhubung[d.bookingSn] && !d.resi.length && ms && ms <= waktuScan + 3600000 && waktuScan - ms <= 4 * 86400000;
    }).sort(function (a, b) { return b.dibuat - a.dibuat; });
    if (kandidat.length) {
      var k0 = kandidat[0];
      return {
        success: true, ditemukan: true, tebakan: true, noResi: resi, noReservasi: k0.bookingSn, noPesananPembeli: k0.orderSn || '-',
        statusBooking: k0.status, dibuat: Utilities.formatDate(new Date(k0.dibuat * 1000), Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm'),
        item: k0.item, alternatif: kandidat.slice(1, 4).map(function (d) { return { noReservasi: d.bookingSn, dibuat: Utilities.formatDate(new Date(d.dibuat * 1000), Session.getScriptTimeZone(), 'dd MMM HH:mm'), totalQty: d.item.reduce(function (s, x) { return s + x.qty; }, 0) }; })
      };
    }
    return { success: true, ditemukan: false, alasan: 'Resi ini tidak cocok dengan booking Pengiriman Kilat mana pun (' + bk.detail.length + ' booking dicek).' };
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Isi produk + order pembeli + status booking ke baris reservasi (kalau masih kosong)
function kilatLengkapiDariBooking_(email, sn, d) {
  var lock = kunciModul_(['pengiriman', 'stok']);
  if (!lock.tryLock(15000)) return;
  try {
    if (!d) {
      var kred = ambilKredensialShopee();
      var bk = kred.accessToken ? kilatDaftarBookingDetail_(kred) : { detail: [] };
      d = bk.detail.filter(function (x) { return x.bookingSn === sn; })[0];
    }
    if (!d) return;
    tgsResetMemo_();
    var t = tgsBacaSemua_().filter(function (x) { return x.noReservasi === sn; })[0];
    if (!t) return;
    var sh = tgsSheetHeader_(), shD = tgsSheetDetail_();
    if (d.item.length && !t.item.length) {
      var item = d.item.map(function (it) { return { sku: resolveSkuJual(it.sku), nama: it.nama, qty: it.qty }; });
      var m = shD.getLastRow() + 1;
      shD.getRange(m, 1, item.length, 2).setNumberFormat('@');
      shD.getRange(m, 1, item.length, 5).setValues(item.map(function (x) { return [sn, x.sku, x.nama, x.qty, '']; }));
      sh.getRange(t.row, 11).setValue(item.reduce(function (s, x) { return s + x.qty; }, 0));
    }
    if (d.orderSn && d.orderSn !== t.orderPembeli) sh.getRange(t.row, 13).setValue(d.orderSn);
    if (d.status && d.status !== t.statusBooking) sh.getRange(t.row, 14).setValue(d.status);
    if (d.dibuat && !t.msDibuat) sh.getRange(t.row, 2).setValue(new Date(d.dibuat * 1000));
    tgsResetMemo_();
    // Resi sudah discan keluar & produk baru terisi -> pindahkan stok
    if (t.noResi && d.item.length && !t.item.length) {
      var infoK = getSheetInfo('keluar'), shK = infoK.sheet, lrK = shK.getLastRow();
      if (lrK > 1) {
        var vk = shK.getRange(Math.max(2, lrK - 5999), 1, Math.min(lrK - 1, 6000), 3).getValues();
        for (var k = vk.length - 1; k >= 0; k--) if (resiSama_(vk[k][0], t.noResi)) { tgsSaatResiDiscanKeluar_(t.noResi, vk[k][2] instanceof Date ? vk[k][2] : new Date(), getNamaStaff(email) || email); break; }
      }
    }
  } catch (e) { Logger.log('kilatLengkapiDariBooking_: ' + e); } finally { lepasKunci_(lock); }
}

/* STATUS ORDER PEMBELI (RINGAN) untuk Pengiriman Kilat.
   Dulu rekap memanggil bangunPetaResiKeSemuaPesananCache_() yang membaca SELURUH 5 sheet pesanan (PO, TikTok,
   Shopee, Conner, Website) + tautan resi hanya untuk mengambil status order Shopee -> sering timeout.
   Sekarang cukup 2 kolom sheet Shopee (No Pesanan & Status), hanya untuk order yang memang terhubung ke
   reservasi kilat, dan hasilnya di-cache 10 menit. */
var KILAT_STATUS_KUNCI_ = 'KILAT_STATUS_ORDER_V1';
function kilatStatusOrderRingan_(semua, paksa) {
  var perlu = {};
  (semua || []).forEach(function (t) { if (t.orderPembeli) perlu[String(t.orderPembeli).trim()] = true; });
  var kunciPerlu = Object.keys(perlu);
  if (!kunciPerlu.length) return {};
  var cache = CacheService.getScriptCache();
  if (!paksa) {
    try {
      var c = cache.get(KILAT_STATUS_KUNCI_);
      if (c) {
        var obj = JSON.parse(c);
        if (kunciPerlu.every(function (k) { return obj[k] !== undefined; })) return obj;
      }
    } catch (eC) { }
  }
  var peta = {};
  try {
    var sh = getPesananShopeeSheet(), lr = sh.getLastRow();
    if (lr > 1) {
      var no = sh.getRange(2, 1, lr - 1, 1).getValues(), st = sh.getRange(2, 5, lr - 1, 1).getValues();
      for (var i = 0; i < no.length; i++) {
        var n = typeof no[i][0] === 'number' ? kunciResi_(no[i][0]) : String(no[i][0] || '').trim();
        if (n && perlu[n]) peta[n] = String(st[i][0] || '').trim().toUpperCase();
      }
    }
  } catch (eS) { Logger.log('kilatStatusOrderRingan_: ' + eS); }
  kunciPerlu.forEach(function (k) { if (peta[k] === undefined) peta[k] = ''; });
  try { var json = JSON.stringify(peta); if (json.length < 95000) cache.put(KILAT_STATUS_KUNCI_, json, 600); } catch (eP) { }
  return peta;
}

// ===== AKSI: kilat_rekap - semua Pengiriman Kilat + detail barang + nilai (HPP & harga jual Shopee)
// Anti timeout: cache 15 menit + salinan cadangan 6 jam. Kalau perhitungan baru gagal/terlalu lama,
// salinan cadangan dikembalikan (ditandai cadangan:true) sehingga menu tidak pernah kosong/error.
var KILAT_REKAP_DETIK_ = 900, KILAT_REKAP_CADANGAN_DETIK_ = 21600;
// v2026.10.56: kunci cache V2 (data lama tanpa "Menunggu Retur" / perluCek tidak dipakai lagi)
function prosesKilatRekap(data) {
  var result = { success: false }, bolehHarga = false;
  try {
    if (!cekIzin(data.email, 'scanResiKeluar') && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    bolehHarga = cekIzin(data.email, 'buatInvoice');
    if (!data.segar) {
      var c = cacheBesarGet_('KILAT_REKAP_V2');
      if (c && c.success) { if (!bolehHarga) kilatBuangHarga_(c); c.dariCache = true; return c; }
    }
    tgsResetMemo_();
    var semua = tgsBacaSemua_(), master = kilatMasterProduk_(), petaRetur = kilatPetaRetur_();
    KONTEKS_KILAT_.statusOrderShopee = kilatStatusOrderRingan_(semua, !!data.segar);
    var ring = { total: 0, berhasil: 0, diretur: 0, proses: 0, batal: 0, menungguRetur: 0, perluCek: 0, nilaiModal: 0, nilaiJual: 0, nilaiModalRetur: 0, durasiReturTotal: 0, durasiReturN: 0 };
    var items = semua.map(function (t) {
      var info = kilatInfoBaris_(t, petaRetur, KONTEKS_KILAT_.statusOrderShopee);
      var modal = 0, jual = 0;
      var barang = t.item.map(function (it) {
        var m = master[String(it.sku || '').toUpperCase()] || {};
        var q = it.qtyKirim || 0;
        modal += (m.hpp || 0) * q; jual += (m.hargaJual || 0) * q;
        return { sku: it.sku, nama: it.nama || m.nama || '', qty: q, qtyDiterima: it.qtyDiterima, hpp: m.hpp || 0, hargaJual: m.hargaJual || 0, hargaDariShopee: !!m.hargaDariShopee, foto: m.foto || '' };
      });
      ring.total++;
      if (info.hasil === 'Berhasil') ring.berhasil++;
      else if (info.hasil === 'Diretur') { ring.diretur++; ring.nilaiModalRetur += modal; if (info.durasiHariSampaiRetur !== null) { ring.durasiReturTotal += info.durasiHariSampaiRetur; ring.durasiReturN++; } }
      else if (info.hasil === 'Batal') ring.batal++;
      else if (info.hasil === 'Menunggu Retur') ring.menungguRetur++;
      else ring.proses++;
      if (info.perluCek) ring.perluCek++;
      if (info.hasil !== 'Batal') { ring.nilaiModal += modal; ring.nilaiJual += jual; }
      return {
        noReservasi: t.noReservasi, tanggal: t.tanggal, msDibuat: t.msDibuat, tanggalKirim: t.tanggalKirim, noResi: t.noResi || '', kurir: t.kurir,
        status: t.status, statusBooking: t.statusBooking, noPesananPembeli: t.orderPembeli || '-', gudang: t.gudang,
        hasil: info.hasil, statusAkhir: info.statusAkhir, umurHari: info.umurHari, tanggalRetur: info.tanggalRetur, durasiHariSampaiRetur: info.durasiHariSampaiRetur, perluCek: info.perluCek,
        totalQty: barang.reduce(function (s, x) { return s + x.qty; }, 0), nilaiModal: modal, nilaiJual: jual, barang: barang,
        resiRetur: info.hasil === 'Diretur' ? (t.noResi || '') : ''
      };
    });
    items.sort(function (a, b) { return (b.msDibuat || 0) - (a.msDibuat || 0); });
    ring.rataHariSampaiRetur = ring.durasiReturN ? Math.round(ring.durasiReturTotal / ring.durasiReturN * 10) / 10 : null;
    delete ring.durasiReturTotal; delete ring.durasiReturN;
    result = { success: true, items: items, ringkasan: ring, bolehHarga: true, dibuatMs: Date.now() };
    cacheBesarPut_('KILAT_REKAP_V2', result, KILAT_REKAP_DETIK_);
    cacheBesarPut_('KILAT_REKAP_V2_CADANGAN', result, KILAT_REKAP_CADANGAN_DETIK_);
    if (!bolehHarga) kilatBuangHarga_(result);
  } catch (err) {
    var cad = cacheBesarGet_('KILAT_REKAP_V2_CADANGAN');
    if (cad && cad.success) {
      if (!bolehHarga) kilatBuangHarga_(cad);
      cad.dariCache = true; cad.cadangan = true; cad.peringatan = 'Data terbaru gagal dihitung (' + String(err).slice(0, 120) + ') - menampilkan data terakhir.';
      return cad;
    }
    result = { success: false, error: err.toString() };
  }
  return result;
}
function kilatBuangHarga_(r) {
  r.bolehHarga = false;
  (r.items || []).forEach(function (it) { it.nilaiModal = null; it.nilaiJual = null; it.barang.forEach(function (b) { b.hpp = null; b.hargaJual = null; }); });
  if (r.ringkasan) { r.ringkasan.nilaiModal = null; r.ringkasan.nilaiJual = null; r.ringkasan.nilaiModalRetur = null; }
}

/* ============================================================
   LAPORAN KESEHATAN BISNIS (web > Penjualan > Laporan)
   Kondisi penjualan (Bagus / Sedang / Jelek) dari tren omzet semua channel, Skor Kesehatan Katalog
   (0-100) dari kelengkapan & performa SKU, plus saran AI ringkas (Gemini, cadangan: aturan otomatis).
   ============================================================ */
function lkbParseTanggal_(t) {
  if (t instanceof Date) return t;
  var d = new Date(String(t || '').replace(',', ''));
  return isNaN(d.getTime()) ? null : d;
}

function prosesLaporanKesehatanBisnis(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk melihat laporan ini.');
    var cacheKunci = 'LKB_V1_' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMddHH');
    if (!data.segar) { var c = cacheBesarGet_(cacheKunci); if (c && c.success) { c.dariCache = true; return c; } }

    // ---- 1. Penjualan: omzet 7 hari vs 7 hari sebelumnya, 30 vs 30
    var gab = prosesLihatSemuaPesananGabungan({ email: data.email });
    var sekarang = Date.now(), H = 86400000;
    var b = { r7: 0, p7: 0, r30: 0, p30: 0, n7: 0, n30: 0, np30: 0 }, perChannel = {}, harian = {};
    (gab.daftar || []).forEach(function (o) {
      var st = String(o.status || '').toLowerCase();
      if (/batal|cancel|dibatalkan|retur|return/.test(st)) return;
      var tgl = lkbParseTanggal_(o.tanggal);
      if (!tgl) return;
      var umur = sekarang - tgl.getTime(), total = Number(o.total) || 0;
      if (umur < 0) umur = 0;
      if (umur < 7 * H) { b.r7 += total; b.n7++; }
      else if (umur < 14 * H) b.p7 += total;
      if (umur < 30 * H) {
        b.r30 += total; b.n30++;
        var ch = o.sumber || 'Lainnya';
        perChannel[ch] = perChannel[ch] || { omzet: 0, jumlah: 0 };
        perChannel[ch].omzet += total; perChannel[ch].jumlah++;
        var hk = Utilities.formatDate(tgl, Session.getScriptTimeZone(), 'yyyy-MM-dd');
        harian[hk] = (harian[hk] || 0) + total;
      } else if (umur < 60 * H) { b.p30 += total; b.np30++; }
    });
    var tumbuh = function (a, p) { return p > 0 ? Math.round((a - p) / p * 1000) / 10 : (a > 0 ? 100 : 0); };
    var g7 = tumbuh(b.r7, b.p7), g30 = tumbuh(b.r30, b.p30);
    var skorJual = 50 + Math.max(-35, Math.min(35, g7 * 0.6)) + Math.max(-15, Math.min(15, g30 * 0.3));
    if (!b.r30) skorJual = 10;
    skorJual = Math.round(Math.max(0, Math.min(100, skorJual)));
    var kondisi = skorJual >= 65 ? 'Bagus' : (skorJual >= 40 ? 'Sedang' : 'Jelek');
    var tren = [];
    for (var d = 29; d >= 0; d--) { var tk = Utilities.formatDate(new Date(sekarang - d * H), Session.getScriptTimeZone(), 'yyyy-MM-dd'); tren.push({ tanggal: tk, omzet: harian[tk] || 0 }); }

    // ---- 2. Skor Kesehatan Katalog
    var master = kilatMasterProduk_(), skus = Object.keys(master);
    var stokPeta = {};
    try { var pos = prosesLihatStock({ email: data.email }); if (pos.success) pos.daftar.forEach(function (x) { stokPeta[String(x.sku).toUpperCase()] = Number(x.stockSaatIni) || 0; }); } catch (eS) {}
    var laku = {};
    try {
      var shL = getStockLedgerSheet(), lrL = shL.getLastRow();
      if (lrL > 1) {
        var n = Math.min(lrL - 1, 25000);
        shL.getRange(lrL - n + 1, 1, n, 4).getValues().forEach(function (r) {
          if (!(r[0] instanceof Date) || sekarang - r[0].getTime() > 30 * H) return;
          if (/terjual|keluar|penjualan/i.test(String(r[2] || ''))) laku[String(r[1] || '').trim().toUpperCase()] = true;
        });
      }
    } catch (eL) {}
    var cek = { foto: 0, hpp: 0, harga: 0, margin: 0, stok: 0, laku: 0 }, masalah = { tanpaFoto: [], tanpaHpp: [], marginTipis: [], stokHabis: [], tidakLaku: [] };
    skus.forEach(function (k) {
      var m = master[k];
      if (m.foto) cek.foto++; else masalah.tanpaFoto.push(m.sku);
      if (m.hpp > 0) cek.hpp++; else masalah.tanpaHpp.push(m.sku);
      if (m.hargaJual > 0) cek.harga++;
      if (m.hpp > 0 && m.hargaJual > m.hpp * 1.15) cek.margin++; else if (m.hpp > 0 && m.hargaJual > 0) masalah.marginTipis.push(m.sku);
      var st = stokPeta[k];
      if (st === undefined || st > 0) cek.stok++; else masalah.stokHabis.push(m.sku);
      if (laku[k]) cek.laku++; else masalah.tidakLaku.push(m.sku);
    });
    var N = skus.length || 1;
    var bobot = { foto: 15, hpp: 15, harga: 10, margin: 20, stok: 20, laku: 20 };
    var komponen = Object.keys(bobot).map(function (k) { return { kunci: k, persen: Math.round(cek[k] / N * 100), bobot: bobot[k] }; });
    var skorKatalog = skus.length ? Math.round(komponen.reduce(function (s, x) { return s + x.persen * x.bobot / 100; }, 0)) : 0;
    Object.keys(masalah).forEach(function (k) { masalah[k] = { jumlah: masalah[k].length, contoh: masalah[k].slice(0, 5) }; });

    // ---- 3. Saran (AI ringkas, cadangan aturan otomatis)
    var fakta = {
      kondisiPenjualan: kondisi, skorPenjualan: skorJual, omzet7Hari: b.r7, omzet7HariSebelumnya: b.p7, pertumbuhan7HariPersen: g7,
      omzet30Hari: b.r30, pertumbuhan30HariPersen: g30, transaksi30Hari: b.n30, perChannel: perChannel,
      skorKatalog: skorKatalog, jumlahSku: skus.length, tanpaFoto: masalah.tanpaFoto.jumlah, tanpaHpp: masalah.tanpaHpp.jumlah,
      marginTipis: masalah.marginTipis.jumlah, stokHabis: masalah.stokHabis.jumlah, tidakLaku30Hari: masalah.tidakLaku.jumlah
    };
    var saran = [], sumberSaran = 'aturan';
    try {
      var prompt = 'Kamu analis bisnis e-commerce untuk pemilik toko kopi & peralatan di Indonesia. Berdasarkan data JSON berikut, ' +
        'beri TEPAT 3 saran singkat (maks 22 kata per saran), bahasa Indonesia santai-profesional, spesifik & bisa langsung dikerjakan. ' +
        'Jawab HANYA JSON array string, tanpa teks lain.\n' + JSON.stringify(fakta);
      var teksAI = String(panggilGeminiText(prompt) || '').replace(/```json|```/g, '').trim();
      var arr = JSON.parse(teksAI.slice(teksAI.indexOf('['), teksAI.lastIndexOf(']') + 1));
      if (Array.isArray(arr) && arr.length) { saran = arr.slice(0, 3).map(String); sumberSaran = 'ai'; }
    } catch (eAI) { /* AI tidak tersedia -> aturan */ }
    if (!saran.length) {
      if (g7 < -10) saran.push('Omzet 7 hari turun ' + Math.abs(g7) + '%. Aktifkan promo/voucher di channel terbesar dan hubungi pelanggan repeat.');
      else if (g7 > 10) saran.push('Omzet naik ' + g7 + '% minggu ini. Pastikan stok produk terlaris aman agar momentum tidak putus.');
      if (masalah.stokHabis.jumlah) saran.push(masalah.stokHabis.jumlah + ' SKU stoknya habis. Prioritaskan restock yang masih laku 30 hari terakhir.');
      if (masalah.tidakLaku.jumlah > N * 0.4) saran.push(masalah.tidakLaku.jumlah + ' SKU tidak terjual 30 hari. Pertimbangkan bundling, diskon cuci gudang, atau nonaktifkan.');
      if (masalah.marginTipis.jumlah) saran.push(masalah.marginTipis.jumlah + ' SKU margin < 15%. Tinjau ulang harga jual atau negosiasi harga supplier.');
      if (masalah.tanpaFoto.jumlah) saran.push('Lengkapi foto ' + masalah.tanpaFoto.jumlah + ' SKU - produk tanpa foto jarang dibeli.');
      saran = saran.slice(0, 3);
      if (!saran.length) saran.push('Kondisi stabil. Pertahankan ketersediaan stok dan konsistensi harga di semua channel.');
    }

    result = {
      success: true, dibuatPada: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm'),
      penjualan: { kondisi: kondisi, skor: skorJual, omzet7: b.r7, omzet7Sebelumnya: b.p7, tumbuh7: g7, omzet30: b.r30, omzet30Sebelumnya: b.p30, tumbuh30: g30, transaksi30: b.n30, transaksi7: b.n7, rataHarian30: Math.round(b.r30 / 30), perChannel: perChannel, tren: tren },
      katalog: { skor: skorKatalog, jumlahSku: skus.length, komponen: komponen, masalah: masalah },
      saran: saran, sumberSaran: sumberSaran
    };
    cacheBesarPut_(cacheKunci, result, 3600);
  } catch (err) { result = { success: false, error: err.toString() }; }
  return result;
}

// ===== AKSI: sinkron_booking_shopee (tombol di menu Pengiriman Kilat)
function prosesSinkronBookingShopee(data) {
  if (!cekIzin(data.email, 'scanResiKeluar')) return { success: false, error: 'Anda tidak punya izin untuk aksi ini.' };
  // Panggilan otomatis dari tab Pengiriman: maksimal 1x per 10 menit
  if (data.otomatis === true) {
    var tAkhir = parseInt(PropertiesService.getScriptProperties().getProperty('BOOKING_SHOPEE_SYNC_TERAKHIR') || '0', 10);
    if (Date.now() - tAkhir < 10 * 60000) return { success: true, dilewati: true, baru: 0, diperbarui: 0 };
  }
  var h = sinkronBookingShopee_();
  if (h.success) pastikanTriggerBooking_();
  if (!h.success && !h.error.length) h.error.push('Gagal');
  h.error = h.error.join(' | ');
  if (!h.success) delete h.contohMentah;
  return h;
}

/* ============================================================
   TRANSFER GUDANG SHOPEE ("Pengiriman Kilat" / Fulfilled by Shopee - titip stok)
   ------------------------------------------------------------
   Ini BUKAN penjualan: tidak ada pembeli, tidak masuk omzet/laporan penjualan. Ini PINDAH GUDANG.
   Resi fisiknya sama seperti kurir biasa, tapi terikat ke NOMOR RESERVASI (Inbound) Shopee,
   bukan No Pesanan -> dulu selalu "Belum Terhubung".

   Alur status & stok:
     Draft      : reservasi dibuat di OmniAI (No Reservasi + daftar SKU & qty). Stok belum bergerak.
     Dikirim    : resi discan keluar di gudang (atau ditandai manual). Stok Gudang Utama BERKURANG
                  (Stock Ledger jenis "Transfer Gudang Shopee") -> barang berstatus IN-TRANSIT.
     Diterima   : dikonfirmasi diterima Gudang Shopee (qty diterima per SKU). Tercatat di sheet
                  "Stok Gudang Shopee". Selisih kirim vs terima dicatat sebagai "Selisih Inbound".
     Batal      : kalau sudah Dikirim, stok dikembalikan ke Gudang Utama (ledger "Masuk").
   Semua penulisan: LockService + baris dicari dinamis di dalam lock + batch setValues.
   ============================================================ */
var TGS_SHEET = 'Transfer Gudang Shopee';
var TGS_SHEET_DETAIL = 'Transfer Gudang Shopee Detail';
var TGS_SHEET_STOK = 'Stok Gudang Shopee';
var TGS_HEADER = ['No Reservasi', 'Tanggal Dibuat', 'Gudang Tujuan', 'No Resi', 'Kurir', 'Status', 'Dibuat Oleh', 'Tanggal Kirim', 'Tanggal Diterima', 'Catatan', 'Total Qty', 'Stok Dipotong', 'Order Pembeli (Shopee)', 'Status Booking (Shopee)'];
var TGS_HEADER_DETAIL = ['No Reservasi', 'SKU', 'Nama Produk', 'Qty Kirim', 'Qty Diterima'];
var TGS_HEADER_STOK = ['Tanggal', 'SKU', 'Jenis', 'Qty', 'No Reservasi', 'Keterangan', 'Oleh'];
var TGS_JENIS_LEDGER = 'Transfer Gudang Shopee';

function tgsSheet_(nama, header, kolomTeks) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(nama);
  if (!sh) {
    sh = ss.insertSheet(nama);
    sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
    (kolomTeks || []).forEach(function (k) { sh.getRange(1, k, sh.getMaxRows(), 1).setNumberFormat('@'); });
    sh.setFrozenRows(1);
  }
  return sh;
}
function tgsSheetHeader_() { return tgsSheet_(TGS_SHEET, TGS_HEADER, [1, 4]); }
function tgsSheetDetail_() { return tgsSheet_(TGS_SHEET_DETAIL, TGS_HEADER_DETAIL, [1, 2]); }
function tgsSheetStok_() { return tgsSheet_(TGS_SHEET_STOK, TGS_HEADER_STOK, [2, 5]); }

var TGS_MEMO_ = null; // cache per eksekusi (scan batch 10 resi = 1x baca sheet), di-reset tiap penulisan
function tgsResetMemo_() { TGS_MEMO_ = null; }
function tgsBacaSemua_() {
  if (TGS_MEMO_) return TGS_MEMO_;
  var tz = Session.getScriptTimeZone();
  var sh = tgsSheetHeader_(), shD = tgsSheetDetail_();
  var hasil = [], per = {};
  var lr = sh.getLastRow();
  if (lr > 1) sh.getRange(2, 1, lr - 1, TGS_HEADER.length).getValues().forEach(function (r, i) {
    var no = String(r[0] || '').trim();
    if (!no) return;
    var t = { row: i + 2, noReservasi: no, tanggal: r[1] instanceof Date ? Utilities.formatDate(r[1], tz, 'dd MMM yyyy, HH:mm') : '', gudang: String(r[2] || ''),
      noResi: resiTeks_(r[3], r[4]), kurir: String(r[4] || ''), status: String(r[5] || 'Draft'), oleh: String(r[6] || ''),
      tanggalKirim: r[7] instanceof Date ? Utilities.formatDate(r[7], tz, 'dd MMM yyyy, HH:mm') : '', tanggalDiterima: r[8] instanceof Date ? Utilities.formatDate(r[8], tz, 'dd MMM yyyy, HH:mm') : '',
      catatan: String(r[9] || ''), totalQty: Number(r[10]) || 0, stokDipotong: r[11] === true || String(r[11]).toUpperCase() === 'TRUE', orderPembeli: String(r[12] || ''), statusBooking: String(r[13] || ''),
      msKirim: r[7] instanceof Date ? r[7].getTime() : 0, msDibuat: r[1] instanceof Date ? r[1].getTime() : 0, item: [] };
    hasil.push(t); per[no] = t;
  });
  var lrD = shD.getLastRow();
  if (lrD > 1) shD.getRange(2, 1, lrD - 1, 5).getValues().forEach(function (r, i) {
    var t = per[String(r[0] || '').trim()];
    if (t) t.item.push({ row: i + 2, sku: String(r[1] || '').trim(), nama: String(r[2] || ''), qtyKirim: Number(r[3]) || 0, qtyDiterima: r[4] === '' ? null : Number(r[4]) || 0 });
  });
  TGS_MEMO_ = hasil;
  return hasil;
}

// Status transfer -> 4 kategori standar tab Pengiriman
function tgsStatusPengiriman_(status) {
  if (status === 'Diterima') return 'Pesanan Selesai';
  if (status === 'Batal') return 'Retur';
  if (status === 'Dikirim') return 'Dalam Pengiriman';
  return 'Menunggu Kurir';
}

// Dipakai bangunPetaResiKeSemuaPesanan: resi & No Reservasi -> entri berjenis 'transfer'
/* STATUS AKHIR Pengiriman Kilat (goal: ada pembeli atau tidak, & sudah berapa hari)
   Sumber: status booking Shopee + order pembeli hasil MATCHED + status order itu di sheet Pesanan Shopee. */
function tgsStatusAkhir_(t, statusOrderShopee) {
  var sb = String(t.statusBooking || '').toUpperCase();
  var mulai = t.msKirim || 0;
  var umurHari = mulai ? Math.max(0, Math.floor((Date.now() - mulai) / 86400000)) : null;
  var kode, label;
  if (t.status === 'Batal' || sb === 'CANCELLED') { kode = 'batal'; label = 'Booking dibatalkan'; }
  else if (t.orderPembeli) {
    var so = String((statusOrderShopee || {})[t.orderPembeli] || '').toUpperCase();
    if (so === 'COMPLETED') { kode = 'terjual'; label = 'Terjual - pesanan selesai'; }
    else if (so.indexOf('CANCEL') !== -1) { kode = 'batal-pembeli'; label = 'Ada pembeli, tapi pesanan dibatalkan'; }
    else if (so.indexOf('RETURN') !== -1) { kode = 'retur'; label = 'Ada pembeli, tapi diretur'; }
    else { kode = 'terjual-proses'; label = 'Ada pembeli - pesanan ' + (so ? so.replace(/_/g, ' ').toLowerCase() : 'diproses'); }
  } else if (t.status === 'Dikirim' || t.status === 'Diterima' || sb === 'SHIPPED' || sb === 'PROCESSED') { kode = 'menunggu-pembeli'; label = 'Belum ada pembeli'; }
  else { kode = 'draft'; label = 'Menunggu dikirim'; }
  // v2026.10.35 (DN-261020-130130-367): ada pembeli dalam berapa hari sejak dikirim ke Gudang Shopee
  var hariLaku = null;
  if (t.orderPembeli && mulai) { var msO = TGL_ORDER_SHOPEE_[String(t.orderPembeli)]; if (msO) hariLaku = Math.max(0, Math.floor((msO - mulai) / 86400000)); }
  return { kode: kode, label: label, umurHari: umurHari, hariLaku: hariLaku };
}

function tgsIsiPeta_(peta) {
  try {
    tgsBacaSemua_().forEach(function (t) {
      var akhir = tgsStatusAkhir_(t, KONTEKS_KILAT_.statusOrderShopee);
      var entri = { noInvoice: t.noReservasi, pembeli: 'Pengiriman Kilat - Gudang Shopee' + (t.gudang ? ' ' + t.gudang : ''), status: t.status === 'Diterima' ? 'Selesai' : (t.status === 'Dikirim' ? 'Dikirim' : (t.status === 'Batal' ? 'Retur' : '')),
        noResi: t.noResi, sumber: 'Transfer Gudang Shopee', jenis: 'transfer', statusTransfer: t.status,
        statusAkhir: akhir.label, kodeAkhir: akhir.kode, umurHari: akhir.umurHari, hariLaku: akhir.hariLaku, orderPembeli: t.orderPembeli };
      var kr = kunciResi_(t.noResi), kn = kunciResi_(t.noReservasi);
      if (kn) peta[kn] = entri;
      if (kr) peta[kr] = entri; // resi transfer MENANG atas pesanan reguler (resi fisik ini milik reservasi)
    });
  } catch (e) { Logger.log('Peta transfer gudang dilewati: ' + e); }
}

function tgsTulisLedgerKeluar_(t, waktu, oleh) {
  var shL = getStockLedgerSheet();
  var baris = t.item.filter(function (it) { return it.sku && it.qtyKirim > 0; }).map(function (it) {
    return [waktu, it.sku, TGS_JENIS_LEDGER, it.qtyKirim, 'Transfer ke Gudang Shopee ' + t.noReservasi + (t.noResi ? ' (resi ' + t.noResi + ')' : ''), oleh];
  });
  if (baris.length) shL.getRange(shL.getLastRow() + 1, 1, baris.length, 6).setValues(baris);
  var shS = tgsSheetStok_();
  var bS = t.item.filter(function (it) { return it.sku && it.qtyKirim > 0; }).map(function (it) {
    return [waktu, it.sku, 'In-Transit', it.qtyKirim, t.noReservasi, 'Dikirim dari Gudang Utama', oleh];
  });
  if (bS.length) shS.getRange(shS.getLastRow() + 1, 1, bS.length, TGS_HEADER_STOK.length).setValues(bS);
}

// Hook dari scan Resi Keluar (potongStockDariScanResi) - DETEKSI OTOMATIS Pengiriman Kilat.
// Mengembalikan null (resi reguler) atau info kilat. Resi kilat TIDAK PERNAH diproses sebagai penjualan.
function tgsSaatResiDiscanKeluar_(noResi, waktuScan, dicatatOleh) {
  var semua = tgsBacaSemua_();
  var t = semua.filter(function (x) { return x.noResi && resiSama_(x.noResi, noResi); })[0];
  if (!t) return null;
  var adaProduk = t.item.some(function (it) { return it.sku && it.qtyKirim > 0; });
  var info = { jenis: 'kilat', noReservasi: t.noReservasi, status: t.status, perluProduk: !adaProduk };
  // Belum ada daftar produk -> stok belum bisa dipindah; diproses otomatis begitu produknya diisi
  if (t.status === 'Draft' && !t.stokDipotong && adaProduk) {
    var sh = tgsSheetHeader_();
    tgsTulisLedgerKeluar_(t, waktuScan, dicatatOleh);
    sh.getRange(t.row, 6).setValue('Dikirim');
    sh.getRange(t.row, 8).setValue(waktuScan);
    sh.getRange(t.row, 12).setValue(true);
    tgsResetMemo_();
    info.status = 'Dikirim';
  }
  return info;
}

function tgsCariBaris_(sh, noReservasi) {
  var lr = sh.getLastRow();
  if (lr < 2) return 0;
  var v = sh.getRange(2, 1, lr - 1, 1).getValues();
  for (var i = 0; i < v.length; i++) if (kunciResi_(v[i][0]) === kunciResi_(noReservasi)) return i + 2;
  return 0;
}

// ===== AKSI: lihat_transfer_gudang_shopee
function prosesLihatTransferGudangShopee(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiKeluar')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    pastikanTriggerBooking_(); // sinkron Booking Shopee otomatis tiap 30 menit (dipasang sekali)
    var tBk = parseInt(PropertiesService.getScriptProperties().getProperty('BOOKING_SHOPEE_SYNC_TERAKHIR') || '0', 10);
    result.bookingSyncTerakhir = tBk ? Utilities.formatDate(new Date(tBk), Session.getScriptTimeZone(), 'dd MMM HH:mm') : '';
    try { result.bookingDiagnosis = JSON.parse(PropertiesService.getScriptProperties().getProperty('BOOKING_DIAGNOSIS_TERAKHIR') || 'null'); } catch (eDg) { result.bookingDiagnosis = null; }
    // status akhir tiap transfer (ada pembeli / belum, umur hari)
    try { kumpulkanPesananUntukResi_(); } catch (eK) { }
    var daftar = tgsBacaSemua_().slice().reverse();
    // Ringkasan stok per SKU: in-transit & di Gudang Shopee
    var ringkas = {};
    daftar.forEach(function (t) {
      t.item.forEach(function (it) {
        var r = ringkas[it.sku] || (ringkas[it.sku] = { sku: it.sku, nama: it.nama, inTransit: 0, diGudangShopee: 0 });
        if (t.status === 'Dikirim') r.inTransit += it.qtyKirim;
        if (t.status === 'Diterima') r.diGudangShopee += (it.qtyDiterima === null ? it.qtyKirim : it.qtyDiterima);
      });
    });
    result.daftar = daftar.map(function (t) {
      var ak = tgsStatusAkhir_(t, KONTEKS_KILAT_.statusOrderShopee);
      t.statusAkhir = ak.label; t.kodeAkhir = ak.kode; t.umurHari = ak.umurHari;
      delete t.row; t.item.forEach(function (it) { delete it.row; }); return t;
    });
    // Resi yang TERDETEKSI OTOMATIS sebagai Pengiriman Kilat tapi belum punya No Reservasi (30 hari terakhir)
    try {
      var peta = bangunPetaResiKeSemuaPesanan(), segar = kilatSyncShopeeSegar_(), tz = Session.getScriptTimeZone();
      var shK = getSheetInfo('keluar').sheet, lrK = shK.getLastRow(), batas = Date.now() - 30 * 86400000;
      result.otomatis = [];
      if (lrK > 1) {
        var awal = Math.max(2, lrK - 2999);
        shK.getRange(awal, 1, lrK - awal + 1, 11).getValues().forEach(function (r) {
          var resi = String(r[0] || '').trim();
          if (!resi || String(r[10] || '').trim() === 'Pending' || !(r[2] instanceof Date) || r[2].getTime() < batas) return;
          if (peta[kunciResi_(resi)]) return;
          if (deteksiKilatOtomatis_(resi, r[9], r[2], segar)) result.otomatis.push({ noResi: resi, kurir: String(r[9] || ''), waktuScan: Utilities.formatDate(r[2], tz, 'dd MMM yyyy, HH:mm') });
        });
        result.otomatis.reverse();
      }
    } catch (eOto) { result.otomatis = []; }
    result.stok = Object.keys(ringkas).map(function (k) { return ringkas[k]; }).filter(function (r) { return r.inTransit || r.diGudangShopee; });
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: simpan_transfer_gudang_shopee (buat baru / ubah Draft)
function prosesSimpanTransferGudangShopee(data) {
  var no;
  return withTransaction(data.email, 'scanResiKeluar', ['pengiriman', 'stok'], function () {
    var result = { success: false };
    var noResi = String(data.noResi || '').trim().replace(/^'+/, '');
    var item = (Array.isArray(data.item) ? data.item : []).map(function (it) {
      return { sku: resolveSkuJual(String(it.sku || '').trim()), nama: String(it.nama || '').trim(), qty: Math.round(Number(it.qty) || 0) };
    }).filter(function (it) { return it.sku && it.qty > 0; });
    if (!item.length) throw new Error('Tambahkan minimal 1 produk dengan qty > 0.');

    // Resi tidak boleh sudah dipakai pesanan pembeli / transfer lain
    if (noResi) {
      var bentrok = tgsBacaSemua_().filter(function (t) { return t.noReservasi !== no && t.noResi && resiSama_(t.noResi, noResi); })[0];
      if (bentrok) throw new Error('Resi ' + noResi + ' sudah dipakai reservasi ' + bentrok.noReservasi + '.');
    }
    var sh = tgsSheetHeader_(), shD = tgsSheetDetail_();
    var row = tgsCariBaris_(sh, no);
    var oleh = getNamaStaff(data.email) || data.email;
    var total = item.reduce(function (s, it) { return s + it.qty; }, 0);
    if (row) {
      var st = String(sh.getRange(row, 6).getValue() || 'Draft');
      if (st !== 'Draft') throw new Error('Reservasi ' + no + ' sudah berstatus ' + st + ' - tidak bisa diubah.');
      sh.getRange(row, 3, 1, 3).setValues([[String(data.gudang || ''), noResi, String(data.kurir || deteksiKurir(noResi) || '')]]);
      sh.getRange(row, 10, 1, 2).setValues([[String(data.catatan || ''), total]]);
      // Ganti detail lama: hapus baris detail milik reservasi ini (dari bawah ke atas)
      var lrD = shD.getLastRow();
      if (lrD > 1) {
        var v = shD.getRange(2, 1, lrD - 1, 1).getValues();
        for (var i = v.length - 1; i >= 0; i--) if (String(v[i][0]).trim() === no) shD.deleteRow(i + 2);
      }
    } else {
      row = sh.getLastRow() + 1;
      sh.getRange(row, 1, 1, 4).setNumberFormat('@');
      sh.getRange(row, 1, 1, TGS_HEADER.length).setValues([[no, new Date(), String(data.gudang || ''), noResi, String(data.kurir || (noResi ? deteksiKurir(noResi) : '') || ''), 'Draft', oleh, '', '', String(data.catatan || ''), total, false, '', '']]);
    }
    var baris = item.map(function (it) { return [no, it.sku, it.nama, it.qty, '']; });
    var mulai = shD.getLastRow() + 1;
    shD.getRange(mulai, 1, baris.length, 2).setNumberFormat('@');
    shD.getRange(mulai, 1, baris.length, 5).setValues(baris);
    tgsResetMemo_();

    // Resi ini mungkin SUDAH discan keluar sebelum reservasinya dicatat -> langsung proses "Dikirim"
    if (noResi) {
      var infoK = getSheetInfo('keluar'), shK = infoK.sheet, lrK = shK.getLastRow();
      if (lrK > 1) {
        var vk = shK.getRange(2, 1, lrK - 1, 11).getValues();
        for (var k = vk.length - 1; k >= 0; k--) {
          if (resiSama_(vk[k][0], noResi) && String(vk[k][10] || '').trim() !== 'Pending') {
            tgsSaatResiDiscanKeluar_(noResi, vk[k][2] instanceof Date ? vk[k][2] : new Date(), oleh);
            result.langsungDikirim = true;
            break;
          }
        }
      }
    }
    invalidasiCacheGabunganPesanan();
    result.success = true;
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      no = String(data.noReservasi || '').trim();
      if (!no) throw new Error('No Reservasi wajib diisi.');
    }
  });
}

// ===== AKSI: tandai_pengiriman_kilat - resi yang sudah discan (Belum Terhubung) ditandai sebagai
// Pengiriman Kilat & dihubungkan ke No Reservasi. Produk boleh diisi belakangan (menu Pengiriman Kilat);
// begitu produk diisi, stok otomatis dipindah ke in-transit karena resinya sudah tercatat keluar.
function prosesTandaiPengirimanKilat(data) {
  return withTransaction(data.email, 'scanResiKeluar', ['pengiriman', 'stok'], function () {
    var result = { success: false };
    var no = String(data.noReservasi || '').trim(), noResi = String(data.noResi || '').trim().replace(/^'+/, '');
    if (!no || !noResi) throw new Error('No Reservasi dan No Resi wajib diisi.');
    var semua = tgsBacaSemua_();
    var bentrok = semua.filter(function (t) { return t.noReservasi !== no && t.noResi && resiSama_(t.noResi, noResi); })[0];
    if (bentrok) throw new Error('Resi ini sudah terhubung ke reservasi ' + bentrok.noReservasi + '.');
    var sh = tgsSheetHeader_();
    var ada = semua.filter(function (t) { return t.noReservasi === no; })[0];
    var oleh = getNamaStaff(data.email) || data.email;
    if (ada) {
      if (ada.noResi && !resiSama_(ada.noResi, noResi)) throw new Error('Reservasi ' + no + ' sudah memakai resi ' + ada.noResi + '.');
      if (ada.status !== 'Draft') throw new Error('Reservasi ' + no + ' sudah berstatus ' + ada.status + '.');
      sh.getRange(ada.row, 4).setNumberFormat('@').setValue(noResi);
      if (!ada.kurir) sh.getRange(ada.row, 5).setValue(deteksiKurir(noResi));
      if (data.gudang && !ada.gudang) sh.getRange(ada.row, 3).setValue(String(data.gudang));
    } else {
      var row = sh.getLastRow() + 1;
      sh.getRange(row, 1, 1, 4).setNumberFormat('@');
      sh.getRange(row, 1, 1, TGS_HEADER.length).setValues([[no, new Date(), String(data.gudang || ''), noResi, deteksiKurir(noResi), 'Draft', oleh, '', '', 'Ditandai dari Pengiriman', 0, false, '', '']]);
    }
    tgsResetMemo_();
    // Kalau reservasi ini sudah punya produk & resinya sudah discan keluar -> langsung pindahkan stok
    var infoK = getSheetInfo('keluar'), shK = infoK.sheet, lrK = shK.getLastRow(), waktuScan = null;
    if (lrK > 1) {
      var vk = shK.getRange(2, 1, lrK - 1, 11).getValues();
      for (var k = vk.length - 1; k >= 0; k--) {
        if (resiSama_(vk[k][0], noResi) && String(vk[k][10] || '').trim() !== 'Pending') { waktuScan = vk[k][2] instanceof Date ? vk[k][2] : new Date(); break; }
      }
    }
    var info = waktuScan ? tgsSaatResiDiscanKeluar_(noResi, waktuScan, oleh) : null;
    result.perluProduk = info ? info.perluProduk : !(ada && ada.item.length);
    result.status = info ? info.status : 'Draft';
    invalidasiCacheGabunganPesanan();
    result.success = true;
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// ===== AKSI: ubah_status_transfer_gudang_shopee  (kirim manual / diterima / batal)
function prosesUbahStatusTransferGudangShopee(data) {
  return withTransaction(data.email, 'scanResiKeluar', ['pengiriman', 'stok'], function () {
    var result = { success: false };
    var no = String(data.noReservasi || '').trim();
    var t = tgsBacaSemua_().filter(function (x) { return x.noReservasi === no; })[0];
    if (!t) throw new Error('Reservasi ' + no + ' tidak ditemukan.');
    var sh = tgsSheetHeader_(), shD = tgsSheetDetail_(), shS = tgsSheetStok_();
    var oleh = getNamaStaff(data.email) || data.email, sekarang = new Date();
    var aksi = String(data.aksiStatus || '');

    if (aksi === 'kirim') {
      if (t.status !== 'Draft') throw new Error('Hanya reservasi Draft yang bisa ditandai dikirim.');
      if (!t.item.some(function (it) { return it.qtyKirim > 0; })) throw new Error('Isi daftar produk & qty dulu (✏️ Ubah) supaya stok bisa dipindahkan.');
      if (!t.stokDipotong) tgsTulisLedgerKeluar_(t, sekarang, oleh);
      sh.getRange(t.row, 6).setValue('Dikirim'); sh.getRange(t.row, 8).setValue(sekarang); sh.getRange(t.row, 12).setValue(true);
    } else if (aksi === 'diterima') {
      if (t.status !== 'Dikirim') throw new Error('Hanya reservasi berstatus Dikirim (in-transit) yang bisa dikonfirmasi diterima.');
      var terima = data.qtyDiterima || {};
      var bS = [];
      t.item.forEach(function (it) {
        var q = terima.hasOwnProperty(it.sku) ? Math.max(0, Math.round(Number(terima[it.sku]) || 0)) : it.qtyKirim;
        shD.getRange(it.row, 5).setValue(q);
        bS.push([sekarang, it.sku, 'Diterima Gudang Shopee', q, t.noReservasi, 'Keluar dari in-transit', oleh]);
        if (q !== it.qtyKirim) bS.push([sekarang, it.sku, 'Selisih Inbound', q - it.qtyKirim, t.noReservasi, 'Kirim ' + it.qtyKirim + ' / diterima ' + q + ' - cek klaim ke Shopee', oleh]);
      });
      if (bS.length) shS.getRange(shS.getLastRow() + 1, 1, bS.length, TGS_HEADER_STOK.length).setValues(bS);
      sh.getRange(t.row, 6).setValue('Diterima'); sh.getRange(t.row, 9).setValue(sekarang);
      result.adaSelisih = bS.some(function (b) { return b[2] === 'Selisih Inbound'; });
    } else if (aksi === 'batal') {
      if (t.status === 'Diterima' || t.status === 'Batal') throw new Error('Reservasi berstatus ' + t.status + ' tidak bisa dibatalkan.');
      if (t.stokDipotong) {
        // Kembalikan stok ke Gudang Utama (barang pulang / tidak jadi dikirim)
        var shL = getStockLedgerSheet();
        var bL = t.item.filter(function (it) { return it.qtyKirim > 0; }).map(function (it) { return [sekarang, it.sku, 'Masuk', it.qtyKirim, 'Batal transfer Gudang Shopee ' + t.noReservasi + ' - stok kembali', oleh]; });
        if (bL.length) shL.getRange(shL.getLastRow() + 1, 1, bL.length, 6).setValues(bL);
        var bB = t.item.map(function (it) { return [sekarang, it.sku, 'Batal In-Transit', -it.qtyKirim, t.noReservasi, 'Dibatalkan', oleh]; });
        if (bB.length) shS.getRange(shS.getLastRow() + 1, 1, bB.length, TGS_HEADER_STOK.length).setValues(bB);
        sh.getRange(t.row, 12).setValue(false);
      }
      sh.getRange(t.row, 6).setValue('Batal');
    } else throw new Error('Aksi status tidak dikenal.');
    tgsResetMemo_();
    result.success = true;
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

/* ============================================================
   RELASI NO RESI <-> NO INVOICE (Pengiriman)
   Penyebab "Belum Terhubung" yang ditemukan & diperbaiki:
   1. Pesanan CONNER HARDWARE & WEBSITE tidak pernah dimasukkan ke peta -> semua resi Conner pasti gagal.
   2. Resi Conner hanya diambil SEKALI saat pesanan pertama disync (hampir selalu masih kosong karena
      kurir belum di-assign) dan tidak pernah diperbarui lagi.
   3. Pembaruan resi TikTok/Shopee dibatasi 200/500 pesanan aktif per jalan dan SELALU mulai dari
      baris paling atas (pesanan terlama) -> pesanan terbaru (yang justru sedang discan gudang) sering
      tidak pernah kebagian dicek, kolom resinya tetap "-".
   4. Satu sel berisi beberapa resi (PO Sales / multi-paket) dianggap satu string -> tidak cocok.
   5. Tautan manual (🔗) belum ada.
   Solusi: peta mencakup semua sumber + multi-resi + tabel "Tautan Resi Tambahan" (manual & multi-paket),
   pembaruan resi memprioritaskan pesanan terbaru yang resinya kosong, dan "Lengkapi Resi" otomatis
   yang menarik resi dari API (batch) untuk pesanan yang resinya masih kosong.
   ============================================================ */
var TAUTAN_RESI_SHEET = 'Tautan Resi Tambahan';
var TAUTAN_RESI_HEADER = ['No Resi', 'Sumber', 'No Pesanan', 'Keterangan', 'Oleh', 'Waktu'];
var LENGKAPI_RESI_UMUR_HARI = 45;

function getTautanResiSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(TAUTAN_RESI_SHEET);
  if (!sh) {
    sh = ss.insertSheet(TAUTAN_RESI_SHEET);
    sh.getRange(1, 1, 1, TAUTAN_RESI_HEADER.length).setValues([TAUTAN_RESI_HEADER]).setFontWeight('bold');
    sh.getRange('A:C').setNumberFormat('@');
    sh.setFrozenRows(1);
  }
  return sh;
}

// Pecah isi sel resi yang berisi lebih dari satu resi ("RESI1, RESI2" / "A / B" / baris baru)
function pecahResi_(nilai, kurir) {
  var teks = resiTeks_(nilai, kurir);
  if (!teks || teks === '-') return [];
  var bagian = String(teks).split(/[,;\/|\n\r]+/).map(function (x) { return x.trim(); }).filter(function (x) { return x && x !== '-'; });
  var hasil = [];
  bagian.forEach(function (b) {
    // "RESI1 RESI2" dipisah spasi - hanya dipecah kalau setiap potongan terlihat seperti resi utuh (>= 8 karakter)
    var sp = b.split(/\s+/);
    if (sp.length > 1 && sp.every(function (x) { return x.length >= 8; })) hasil = hasil.concat(sp);
    else hasil.push(b);
  });
  return hasil;
}

// Kumpulkan SEMUA pesanan dari semua sumber (baca sheet sekali). Dipakai peta resi & pencarian tautan.
function kumpulkanPesananUntukResi_() {
  var daftar = [];
  var tz = Session.getScriptTimeZone();
  function tgl(v) { return v instanceof Date ? Utilities.formatDate(v, tz, 'dd MMM yyyy') : String(v || ''); }
  function idTeks(v) { return typeof v === 'number' ? kunciResi_(v) : String(v || '').trim(); }

  var sheetsManual = getPesananManualSheets();
  var lr = sheetsManual.header.getLastRow();
  if (lr > 1) sheetsManual.header.getRange(2, 1, lr - 1, 12).getValues().forEach(function (row) {
    var no = idTeks(row[0]);
    if (!no) return;
    daftar.push({ noInvoice: no, pembeli: row[2], status: String(row[11] || '').trim(), resi: pecahResi_(row[10], row[5]), sumber: 'PO Sales', toko: 'Waterground', tanggal: tgl(row[1]), total: row[9], kurir: String(row[5] || '') });
  });

  var shT = getPesananTikTokShopSheet();
  lr = shT.getLastRow();
  if (lr > 1) shT.getRange(2, 1, lr - 1, 17).getValues().forEach(function (row) {
    var no = idTeks(row[0]);
    if (!no) return;
    daftar.push({ noInvoice: no, pembeli: String(row[10] || '').trim() || row[7], status: String(row[4] || '').trim(), resi: pecahResi_(row[6], row[5]),
      sumber: row[16] === 'TOKOPEDIA' ? 'Tokopedia' : 'TikTok Shop', toko: 'Waterground', tanggal: tgl(row[1]), hp: String(row[11] || ''), total: row[3], kurir: String(row[5] || '') });
  });

  var shS = getPesananShopeeSheet();
  lr = shS.getLastRow();
  var batasKosong = Date.now() - 14 * 86400000;
  KONTEKS_KILAT_.shopeeResiKosong = 0;
  KONTEKS_KILAT_.statusOrderShopee = {};
  if (lr > 1) shS.getRange(2, 1, lr - 1, 16).getValues().forEach(function (row) {
    var no = idTeks(row[0]);
    if (!no) return;
    // Pesanan Shopee yang SEHARUSNYA sudah punya resi tapi di sheet masih kosong (untuk deteksi kilat otomatis)
    var stS = String(row[4] || '').trim().toUpperCase(), rS = resiTeks_(row[6], row[5]);
    KONTEKS_KILAT_.statusOrderShopee[no] = stS;
    if (row[1] instanceof Date) TGL_ORDER_SHOPEE_[no] = row[1].getTime(); // v2026.10.35: hitung "laku dalam X hari" Pengiriman Kilat
    if (STATUS_SHOPEE_PERLU_RESI[stS] && (!rS || rS === '-') && row[1] instanceof Date && row[1].getTime() >= batasKosong) KONTEKS_KILAT_.shopeeResiKosong++;
    daftar.push({ noInvoice: no, pembeli: String(row[10] || '').trim() || row[7], status: String(row[4] || '').trim(), resi: pecahResi_(row[6], row[5]),
      sumber: 'Shopee', toko: 'Waterground', tanggal: tgl(row[1]), hp: String(row[11] || ''), total: row[3], kurir: String(row[5] || '') });
  });

  // BARU: Conner Hardware (dulu tidak ikut -> semua resi Conner "Belum Terhubung")
  var shC = getPesananConnerSheet();
  lr = shC.getLastRow();
  if (lr > 1) shC.getRange(2, 1, lr - 1, 8).getValues().forEach(function (row) {
    var no = idTeks(row[0]);
    if (!no) return;
    daftar.push({ noInvoice: no, pembeli: row[7], status: String(row[4] || '').trim(), resi: pecahResi_(row[6], row[5]), sumber: 'Conner Hardware', toko: 'Conner', tanggal: tgl(row[1]), total: row[3], kurir: String(row[5] || '') });
  });

  // BARU: Website (belum punya kolom resi - cukup bisa dicari & ditautkan manual)
  var shW = getPesananWebsiteSheet();
  lr = shW.getLastRow();
  if (lr > 1) shW.getRange(2, 1, lr - 1, 8).getValues().forEach(function (row) {
    var no = idTeks(row[0]);
    if (!no) return;
    daftar.push({ noInvoice: no, pembeli: row[2], status: String(row[7] || '').trim(), resi: [], sumber: 'Website', toko: 'Waterground', tanggal: tgl(row[1]), hp: String(row[3] || ''), total: row[6] });
  });
  return daftar;
}

/* ---------- DETEKSI OTOMATIS PENGIRIMAN KILAT (tanpa input, "invisible") ----------
   Pengiriman Kilat tidak punya No Pesanan dan Shopee tidak membuka datanya lewat API. Tapi SEMUA resi
   pesanan pembeli Shopee KITA KETAHUI (sync + pelengkap resi otomatis). Jadi dengan eliminasi:
   resi Shopee Express yang sudah discan keluar, TIDAK cocok ke pesanan mana pun, dan sistem sudah
   sempat mencari resinya -> hampir pasti Pengiriman Kilat.
   Pengaman agar tidak salah tandai pesanan pembeli:
     - hanya resi Shopee Express (SPX); sync Shopee harus masih segar (< 3 jam);
     - discan >= 60 menit lalu DAN tidak ada pesanan Shopee yang resinya masih kosong, ATAU discan >= 6 jam lalu
       (pelengkap resi jalan tiap 10 menit - pesanan pembeli pasti sudah ketemu resinya).
   Sifatnya DINAMIS: begitu resi itu ternyata milik pesanan (atau didaftarkan ke reservasi), otomatis ikut data aslinya. */
var KONTEKS_KILAT_ = { shopeeResiKosong: 0, statusOrderShopee: {} };
var TGL_ORDER_SHOPEE_ = {}; // no pesanan Shopee -> ms dibuat (tidak ikut cache konteks)
var KILAT_JEDA_MENIT = 60, KILAT_JEDA_PASTI_MENIT = 360;

function kilatSyncShopeeSegar_() {
  var t = parseInt(PropertiesService.getScriptProperties().getProperty('SHOPEE_WAKTU_SYNC_TERAKHIR') || '0', 10);
  return t > 0 && (Date.now() - t * 1000) < 3 * 3600000;
}

function deteksiKilatOtomatis_(noResi, kurir, waktuScan, syncSegar) {
  if (!syncSegar || !(waktuScan instanceof Date)) return null;
  var r = String(noResi || '').trim().toUpperCase();
  var spx = /shopee|spx/i.test(String(kurir || '')) || r.indexOf('SPX') === 0;
  if (!spx) return null;
  var menit = (Date.now() - waktuScan.getTime()) / 60000;
  var yakin = (menit >= KILAT_JEDA_MENIT && KONTEKS_KILAT_.shopeeResiKosong === 0) || menit >= KILAT_JEDA_PASTI_MENIT;
  if (!yakin) return null;
  return { noInvoice: '', pembeli: 'Pengiriman Kilat (terdeteksi otomatis)', status: 'Dikirim', noResi: noResi, sumber: 'Pengiriman Kilat',
    jenis: 'transfer', statusTransfer: 'Otomatis', kilatOtomatis: true };
}

/* ===== CACHE PETA RESI LENGKAP (Pengiriman web: daftar resi aktif) =====
   Membangun peta resi -> pesanan membaca SELURUH riwayat 5 sheet pesanan + transfer gudang + tautan,
   dan dipanggil tiap tab Pengiriman dibuka. Versi lengkap (dengan pembeli, jenis transfer, status kilat)
   sekarang di-cache 2 menit (gzip + dipecah) bersama konteks deteksi kilat, dan dibuang otomatis lewat
   invalidasiCacheGabunganPesanan() setiap ada sync / perubahan pesanan. */
var PETA_RESI_LENGKAP_KUNCI = 'PETA_RESI_LENGKAP_V1';
function bangunPetaResiKeSemuaPesananCache_() {
  var c = cacheBesarGet_(PETA_RESI_LENGKAP_KUNCI);
  if (c && c.e && c.k) {
    if (c.konteks) KONTEKS_KILAT_ = c.konteks;
    var peta = {};
    Object.keys(c.k).forEach(function (k) { peta[k] = c.e[c.k[k]]; });
    return peta;
  }
  var baru = bangunPetaResiKeSemuaPesanan();
  try {
    var entri = [], kunci = {};
    Object.keys(baru).forEach(function (k) {
      var o = baru[k];
      if (!o) return;
      if (o.__pi === undefined) { Object.defineProperty(o, '__pi', { value: entri.length, enumerable: false }); entri.push(o); }
      kunci[k] = o.__pi;
    });
    cacheBesarPut_(PETA_RESI_LENGKAP_KUNCI, { e: entri, k: kunci, konteks: KONTEKS_KILAT_ }, 120);
  } catch (e) { /* cache opsional */ }
  return baru;
}

function bangunPetaResiKeSemuaPesanan() {
  var peta = {};
  var perNo = {};
  kumpulkanPesananUntukResi_().forEach(function (p) {
    var entri = { noInvoice: p.noInvoice, pembeli: p.pembeli, status: p.status, noResi: p.resi[0] || '', sumber: p.sumber, nilai: ccAngkaRupiah_(p.total), kurir: String(p.kurir || '').trim() };
    var kNo = kunciResi_(p.noInvoice);
    if (kNo) { peta[kNo] = entri; perNo[p.sumber + '|' + kNo] = entri; if (!perNo['*|' + kNo]) perNo['*|' + kNo] = entri; }
    p.resi.forEach(function (r) { var k = kunciResi_(r); if (k) peta[k] = entri; });
  });
  // Transfer Gudang Shopee (FBS): resi terikat ke NOMOR RESERVASI, bukan No Pesanan
  tgsIsiPeta_(peta);
  // Tautan tambahan (manual / multi-paket) - prioritas tertinggi, menimpa hasil otomatis
  try {
    var sh = getTautanResiSheet_();
    var lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 1, lr - 1, 4).getValues().forEach(function (r) {
      var kr = kunciResi_(r[0]), kn = kunciResi_(r[2]);
      if (!kr || !kn) return;
      var target = perNo[String(r[1] || '') + '|' + kn] || perNo['*|' + kn];
      // v2026.10.23: resi asli / resi driver hasil cek marketplace (bukan koreksi salah scan) -> tampil sebagai resi asli
      if (target && kr !== kn && /resi driver|resi asli/i.test(String(r[3] || ''))) target.resiTautan = String(r[0] || '').trim();
      peta[kr] = target || { noInvoice: String(r[2]), pembeli: '', status: '', noResi: String(r[0]), sumber: String(r[1] || '') };
    });
  } catch (e) { /* sheet tautan opsional */ }
  return peta;
}

// ---------- Lengkapi resi kosong dari API (batch) ----------
/* ============================================================
   PELENGKAP RESI v2026.10.13 (perbaikan "resi J&T / SiCepat tidak terhubung ke invoice")
   Penyebab lama:
   - Sinkron pesanan otomatis (tiap 5 menit) hanya menarik pesanan BARU. Pesanan TikTok/Shopee masuk saat
     resinya BELUM ada (resi baru keluar setelah label dicetak), dan setelah itu tidak ditarik lagi.
   - Satu-satunya pengisi resi = pelengkap ini, yang dulu MENUMPANG di sinkron Conner, maks 1x per 10 menit,
     memegang kunci 'penjualan' selama memanggil API, dan mundur kalau kunci sedang dipakai sinkron lain.
   Sekarang:
   - Jadwal sendiri lengkapiResiTerjadwal() (dicek tiap 1 menit): jalan tiap +-2 menit, atau +-40 detik
     setelah ada scan resi keluar baru.
   - API marketplace dipanggil TANPA kunci; kunci 'penjualan' hanya dipegang sebentar saat menulis,
     dan setiap baris dicek ulang dulu (ID pesanan masih sama, resi belum diisi proses lain).
   - Jeda per pesanan (2, 4, 8, 16, 30 menit) supaya pesanan yang memang belum punya resi tidak ditanya
     terus-menerus (hemat kuota API). Ada scan keluar baru / tombol Hubungkan -> pesanan <= 3 hari
     langsung ditanya lagi tanpa menunggu jeda.
   - Resi yang DIGANTI marketplace (atur ulang pengiriman / ganti kurir) ikut diperbarui untuk pesanan
     yang belum dikirim (<= 3 hari, dicek tiap 15 menit). Resi lama tetap tertaut ke pesanan yang sama.
   ============================================================ */
var LR_JEDA_NORMAL_MS = 110000;           // jalan rutin: paling cepat tiap +-2 menit
var LR_JEDA_PEMICU_MS = 40000;            // setelah ada scan keluar baru: paling cepat 40 detik
var LR_KUNCI_TERAKHIR = 'LR_TERAKHIR_JALAN';
var LR_KUNCI_PEMICU = 'LR_PEMICU_SCAN';
var LR_KUNCI_JEDA = 'LR_JEDA_PESANAN_V1';
var LR_KUNCI_SEDANG = 'LR_SEDANG_JALAN';
var LR_UMUR_CEK_ULANG_HARI = 3;
var LR_TIKTOK_PRA_KIRIM = { AWAITING_SHIPMENT: 1, AWAITING_COLLECTION: 1 };
var LR_SHOPEE_PRA_KIRIM = { READY_TO_SHIP: 1, PROCESSED: 1, RETRY_SHIP: 1 };

function lrAngkaCache_(kunci) {
  try { return parseInt(CacheService.getScriptCache().get(kunci) || '0', 10) || 0; } catch (e) { return 0; }
}
function lrJedaMuat_() {
  try {
    var o = JSON.parse(CacheService.getScriptCache().get(LR_KUNCI_JEDA) || '{}');
    return (o && typeof o === 'object') ? o : {};
  } catch (e) { return {}; }
}
function lrJedaSimpan_(jeda) {
  try {
    var batas = Date.now() - 86400000;
    var kunci = Object.keys(jeda).filter(function (k) { return jeda[k] && jeda[k][0] > batas; });
    kunci.sort(function (a, b) { return jeda[b][0] - jeda[a][0]; });
    var o = {};
    kunci.slice(0, 1500).forEach(function (k) { o[k] = jeda[k]; });
    CacheService.getScriptCache().put(LR_KUNCI_JEDA, JSON.stringify(o), 21600);
  } catch (e) { /* jeda opsional */ }
}
function lrBolehTanya_(jeda, kunci, abaikan) {
  if (abaikan) return true;
  var e = jeda[kunci];
  return !e || e[0] <= Date.now();
}
// Belum ada resi -> tanya lagi 2, 4, 8, 16, lalu tiap 30 menit
function lrCatatBelum_(jeda, kunci) {
  var e = jeda[kunci] || [0, 0];
  var n = Math.min((e[1] || 0) + 1, 5);
  jeda[kunci] = [Date.now() + Math.min(30, Math.pow(2, n)) * 60000, n];
}
function lrIdBaris_(v, mode) {
  if (mode === 'tiktok') return typeof v === 'number' ? kunciResi_(v) : String(v || '').trim();
  return String(v || '').trim();
}
function lrDaftarResiTikTok_(o) {
  var semua = [];
  [o.tracking_number].concat((o.line_items || []).map(function (li) { return li.tracking_number; })).forEach(function (t) {
    t = String(t || '').trim();
    if (t && semua.indexOf(t) === -1) semua.push(t);
  });
  return semua;
}
function lrResiBeda_(semua, lama) {
  var kl = kunciResi_(lama);
  if (!semua.length || !kl) return false;
  for (var i = 0; i < semua.length; i++) if (kunciResi_(semua[i]) === kl) return false;
  return true;
}

// TikTok Shop (Waterground & Conner). TIDAK menulis ke sheet - mengembalikan rencana tulis.
function lengkapiResiTikTok_(cfg, hasil, ktx) {
  var tulis = [];
  var sh = cfg.sheet;
  var lr = sh.getLastRow();
  if (lr < 2 || !cfg.accessToken || !cfg.shopCipher || !cfg.appKey) return tulis;
  var sekarang = Date.now();
  var batas = sekarang - LENGKAPI_RESI_UMUR_HARI * 86400000;
  var batasBaru = sekarang - LR_UMUR_CEK_ULANG_HARI * 86400000;
  var vals = sh.getRange(2, 1, lr - 1, 7).getValues();
  var kosong = [], ulang = [];
  for (var i = vals.length - 1; i >= 0; i--) { // TERBARU dulu
    var id = lrIdBaris_(vals[i][0], 'tiktok');
    var st = String(vals[i][4] || '').toUpperCase();
    if (!id || st === 'UNPAID' || st === 'CANCELLED') continue;
    var tgl = vals[i][1] instanceof Date ? vals[i][1].getTime() : 0;
    if (tgl && tgl < batas) continue;
    var baru = !tgl || tgl >= batasBaru;
    var resi = resiTeks_(vals[i][6], vals[i][5]);
    var ada = !!(resi && resi !== '-');
    if (!ada || cfg.semuaStatus) {
      var kj = cfg.kode + '|' + id;
      if (lrBolehTanya_(ktx.jeda, kj, ktx.abaikanJeda && baru)) kosong.push({ row: i + 2, id: id, statusLama: st, resiLama: ada ? resi : '', kj: kj });
    } else if (baru && LR_TIKTOK_PRA_KIRIM[st]) {
      var ku = 'U' + cfg.kode + '|' + id;
      if (lrBolehTanya_(ktx.jeda, ku, ktx.abaikanJeda)) ulang.push({ row: i + 2, id: id, statusLama: st, resiLama: resi, kj: ku, ulang: true });
    }
  }
  var maks = (cfg.maksBatch || 8) * 20;
  var kandidat = kosong.slice(0, maks).concat(ulang.slice(0, 60));
  hasil.dicek += kandidat.length;
  for (var b = 0; b < kandidat.length; b += 20) {
    if (typeof urlFetchSedangDiblokir === 'function' && urlFetchSedangDiblokir()) break;
    var batch = kandidat.slice(b, b + 20);
    var ids = batch.map(function (r) { return r.id; }).join(',');
    try {
      var path = '/order/202309/orders';
      var params = { app_key: cfg.appKey, timestamp: String(Math.floor(Date.now() / 1000)), shop_cipher: cfg.shopCipher, version: '202309', ids: ids };
      var url = 'https://open-api.tiktokglobalshop.com' + path + '?app_key=' + encodeURIComponent(cfg.appKey) + '&shop_cipher=' + encodeURIComponent(cfg.shopCipher) +
        '&timestamp=' + params.timestamp + '&version=202309&ids=' + encodeURIComponent(ids) + '&sign=' + buatSignatureTikTok(path, params, '', cfg.appSecret);
      var res = fetchHemat(url, { method: 'get', headers: { 'x-tts-access-token': cfg.accessToken }, muteHttpExceptions: true });
      if (res.getResponseCode() !== 200) { hasil.error.push(cfg.sumber + ': HTTP ' + res.getResponseCode()); continue; }
      var parsed = JSON.parse(res.getContentText());
      var per = {};
      ((parsed.data && parsed.data.orders) || []).forEach(function (o) { per[String(o.id)] = o; });
      for (var j = 0; j < batch.length; j++) {
        var r = batch[j];
        var o = per[r.id];
        if (!o) { lrCatatBelum_(ktx.jeda, r.kj); continue; }
        var semua = lrDaftarResiTikTok_(o);
        var stApi = String(o.status || '').toUpperCase();
        if (r.ulang) {
          // Sudah dikirim -> berhenti dicek ulang. Belum -> cek lagi 15 menit lagi.
          ktx.jeda[r.kj] = LR_TIKTOK_PRA_KIRIM[stApi] ? [Date.now() + 15 * 60000, 0] : [Date.now() + 21600000, 9];
          if (lrResiBeda_(semua, r.resiLama)) tulis.push({ row: r.row, id: r.id, resi: semua[0], semua: semua, lama: r.resiLama, ganti: true });
          continue;
        }
        var statusBaru = (cfg.tulisStatus && o.status && stApi !== r.statusLama) ? String(o.status) : '';
        if (!semua.length) {
          lrCatatBelum_(ktx.jeda, r.kj);
          if (statusBaru) tulis.push({ row: r.row, id: r.id, resi: '', semua: [], status: statusBaru });
          continue;
        }
        delete ktx.jeda[r.kj];
        tulis.push({ row: r.row, id: r.id, resi: semua[0], semua: semua, status: statusBaru });
      }
    } catch (e) { hasil.error.push(cfg.sumber + ': ' + e); }
  }
  return tulis;
}

// Shopee. TIDAK menulis ke sheet - mengembalikan rencana tulis.
function lengkapiResiShopee_(hasil, ktx) {
  var tulis = [];
  var kred = ambilKredensialShopee();
  if (!kred.accessToken || !kred.shopId) return tulis;
  var sh = getPesananShopeeSheet();
  var lr = sh.getLastRow();
  if (lr < 2) return tulis;
  var sekarang = Date.now();
  var batas = sekarang - LENGKAPI_RESI_UMUR_HARI * 86400000;
  var batasBaru = sekarang - LR_UMUR_CEK_ULANG_HARI * 86400000;
  var vals = sh.getRange(2, 1, lr - 1, 7).getValues();
  var kosong = [], ulang = [];
  for (var i = vals.length - 1; i >= 0; i--) {
    var sn = lrIdBaris_(vals[i][0], 'shopee');
    var st = String(vals[i][4] || '').toUpperCase();
    if (!sn || st === 'UNPAID' || st === 'CANCELLED' || st === 'IN_CANCEL') continue;
    var tgl = vals[i][1] instanceof Date ? vals[i][1].getTime() : 0;
    if (tgl && tgl < batas) continue;
    var baru = !tgl || tgl >= batasBaru;
    var resi = resiTeks_(vals[i][6], vals[i][5]);
    if (!resi || resi === '-') {
      var kj = 'S|' + sn;
      if (lrBolehTanya_(ktx.jeda, kj, ktx.abaikanJeda && baru)) kosong.push({ row: i + 2, sn: sn, status: st, kj: kj });
    } else if (baru && LR_SHOPEE_PRA_KIRIM[st]) {
      var ku = 'US|' + sn;
      if (lrBolehTanya_(ktx.jeda, ku, ktx.abaikanJeda)) ulang.push({ row: i + 2, sn: sn, status: st, kj: ku, resiLama: resi, ulang: true });
    }
  }
  var kandidat = kosong.slice(0, 200).concat(ulang.slice(0, 50));
  hasil.dicek += kandidat.length;
  var sisaSatuan = 30; // get_tracking_number satu-per-satu (pesanan kosong dulu, baru cek ulang)
  for (var b = 0; b < kandidat.length; b += 50) {
    if (typeof urlFetchSedangDiblokir === 'function' && urlFetchSedangDiblokir()) break;
    var batch = kandidat.slice(b, b + 50);
    try {
      var path = '/api/v2/order/get_order_detail', ts = Math.floor(Date.now() / 1000);
      var url = getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts + '&sign=' + buatSignatureShopee(path, ts, kred.accessToken, kred.shopId) +
        '&access_token=' + kred.accessToken + '&shop_id=' + kred.shopId + '&order_sn_list=' + encodeURIComponent(batch.map(function (r) { return r.sn; }).join(',')) +
        '&response_optional_fields=' + encodeURIComponent('order_status,package_list');
      var parsed = JSON.parse(fetchHemat(url, { method: 'get', muteHttpExceptions: true }).getContentText());
      var per = {};
      ((parsed.response && parsed.response.order_list) || []).forEach(function (o) { per[o.order_sn] = o; });
      for (var j = 0; j < batch.length; j++) {
        var r = batch[j];
        var o = per[r.sn];
        var status = o ? String(o.order_status || r.status).toUpperCase() : r.status;
        var semua = [];
        ((o && o.package_list) || []).forEach(function (p) { var t = String(p.tracking_number || '').trim(); if (t && semua.indexOf(t) === -1) semua.push(t); });
        if (r.ulang) {
          if (!LR_SHOPEE_PRA_KIRIM[status]) { ktx.jeda[r.kj] = [Date.now() + 21600000, 9]; continue; }
          ktx.jeda[r.kj] = [Date.now() + 15 * 60000, 0];
          if (!semua.length && sisaSatuan > 0) {
            sisaSatuan--;
            var tU = ambilTrackingNumberShopee(r.sn, kred.accessToken, kred.shopId);
            if (tU) semua.push(String(tU));
          }
          if (lrResiBeda_(semua, r.resiLama)) tulis.push({ row: r.row, id: r.sn, resi: semua[0], semua: semua, lama: r.resiLama, ganti: true });
          continue;
        }
        if (!semua.length && STATUS_SHOPEE_PERLU_RESI[status] && sisaSatuan > 0) {
          sisaSatuan--;
          var t1 = ambilTrackingNumberShopee(r.sn, kred.accessToken, kred.shopId);
          if (t1) semua.push(String(t1));
        }
        if (!semua.length) { lrCatatBelum_(ktx.jeda, r.kj); continue; }
        delete ktx.jeda[r.kj];
        tulis.push({ row: r.row, id: r.sn, resi: semua[0], semua: semua });
      }
    } catch (e) { hasil.error.push('Shopee: ' + e); }
  }
  return tulis;
}

// Terapkan rencana tulis ke satu sheet pesanan. Dipanggil SAAT memegang kunci 'penjualan'.
function lrTerapkan_(sh, mode, sumber, tulis, hasil) {
  var lr = sh.getLastRow();
  for (var i = 0; i < tulis.length; i++) {
    var t = tulis[i];
    if (t.row > lr) continue;
    var baris = sh.getRange(t.row, 1, 1, 7).getValues()[0];
    if (lrIdBaris_(baris[0], mode) !== t.id) continue; // baris bergeser - dicoba lagi putaran berikutnya
    var resiSel = resiTeks_(baris[6], baris[5]);
    var kosong = !resiSel || resiSel === '-';
    if (t.status) { sh.getRange(t.row, 5).setValue(t.status); hasil.statusDiupdate++; }
    if (t.ganti) {
      if (kunciResi_(resiSel) !== kunciResi_(t.lama)) continue; // sudah diubah proses lain / manual
      tulisResiTeks_(sh.getRange(t.row, 7), t.resi);
      hasil.resiDiganti++;
      hasil.multiPaket.push({ sumber: sumber, no: t.id, resi: [t.lama], ket: 'Otomatis: resi lama (diganti marketplace)' });
      if (t.semua.length > 1) hasil.multiPaket.push({ sumber: sumber, no: t.id, resi: t.semua.slice(1) });
      continue;
    }
    if (!t.resi) continue;
    if (kosong) { tulisResiTeks_(sh.getRange(t.row, 7), t.resi); hasil.resiTerisi++; }
    if (t.semua.length > 1) hasil.multiPaket.push({ sumber: sumber, no: t.id, resi: t.semua.slice(1) });
  }
}

// Jalankan pelengkapan resi untuk semua toko.
// opsi.paksa = abaikan jeda waktu antar-putaran; opsi.abaikanJeda = pesanan <= 3 hari ditanya walau masih masa jeda;
// opsi.jedaMinMs = jeda minimal antar-putaran (default +-2 menit).
function lengkapiResiKosongSemua_(opsi) {
  opsi = opsi || {};
  var hasil = { resiTerisi: 0, resiDiganti: 0, statusDiupdate: 0, multiPaket: [], error: [], dilewati: false, dicek: 0 };
  var cache = CacheService.getScriptCache();
  var jedaMin = opsi.paksa ? 0 : (opsi.jedaMinMs || LR_JEDA_NORMAL_MS);
  if (Date.now() - lrAngkaCache_(LR_KUNCI_TERAKHIR) < jedaMin) { hasil.dilewati = true; hasil.multiPaket = 0; return hasil; }
  if (cache.get(LR_KUNCI_SEDANG)) { hasil.dilewati = true; hasil.sedangJalan = true; hasil.multiPaket = 0; return hasil; }
  try { cache.put(LR_KUNCI_SEDANG, '1', 150); cache.put(LR_KUNCI_TERAKHIR, String(Date.now()), 21600); } catch (eC) { }
  try {
    var props = PropertiesService.getScriptProperties();
    var ktx = { jeda: lrJedaMuat_(), abaikanJeda: !!opsi.abaikanJeda };
    var rencana = [];
    try {
      var shT = getPesananTikTokShopSheet();
      rencana.push({ sh: shT, mode: 'tiktok', sumber: 'TikTok Shop', tulis: lengkapiResiTikTok_({ sheet: shT, kode: 'T', sumber: 'TikTok Shop', appKey: getTiktokAppKey(), appSecret: getTiktokAppSecret(),
        accessToken: props.getProperty('TIKTOK_ACCESS_TOKEN'), shopCipher: props.getProperty('TIKTOK_SHOP_CIPHER'), maksBatch: 10 }, hasil, ktx) });
    } catch (e1) { hasil.error.push('TikTok: ' + e1); }
    try {
      // Conner: status juga diperbarui (Conner belum punya pembaruan status berkala)
      var shC = getPesananConnerSheet();
      rencana.push({ sh: shC, mode: 'tiktok', sumber: 'Conner Hardware', tulis: lengkapiResiTikTok_({ sheet: shC, kode: 'C', sumber: 'Conner Hardware', appKey: connerAppKey_(), appSecret: connerAppSecret_(),
        accessToken: props.getProperty('CONNER_ACCESS_TOKEN'), shopCipher: props.getProperty('CONNER_SHOP_CIPHER'), maksBatch: 8, tulisStatus: true }, hasil, ktx) });
    } catch (e2) { hasil.error.push('Conner: ' + e2); }
    try { rencana.push({ sh: getPesananShopeeSheet(), mode: 'shopee', sumber: 'Shopee', tulis: lengkapiResiShopee_(hasil, ktx) }); } catch (e3) { hasil.error.push('Shopee: ' + e3); }
    lrJedaSimpan_(ktx.jeda);

    var adaTulis = false;
    for (var a = 0; a < rencana.length; a++) if (rencana[a].tulis && rencana[a].tulis.length) adaTulis = true;
    if (adaTulis) {
      var lock = kunciModul_('penjualan');
      if (!lock.tryLock(30000)) {
        hasil.error.push('Sistem sibuk (sync lain berjalan) - resi ditulis di putaran berikutnya.');
        try { cache.remove(LR_KUNCI_TERAKHIR); } catch (eR) { } // putaran berikutnya langsung boleh jalan
      } else {
        try {
          for (var k = 0; k < rencana.length; k++) {
            if (rencana[k].tulis && rencana[k].tulis.length) lrTerapkan_(rencana[k].sh, rencana[k].mode, rencana[k].sumber, rencana[k].tulis, hasil);
          }
          // Resi paket ke-2 dst. + resi lama yang diganti -> tabel tautan (tanpa duplikat)
          if (hasil.multiPaket.length) {
            var shTautan = getTautanResiSheet_();
            var lrT = shTautan.getLastRow();
            var sudah = {};
            if (lrT > 1) shTautan.getRange(2, 1, lrT - 1, 1).getValues().forEach(function (r) { sudah[kunciResi_(r[0])] = true; });
            var baruT = [];
            for (var m = 0; m < hasil.multiPaket.length; m++) {
              var mp = hasil.multiPaket[m];
              for (var n = 0; n < mp.resi.length; n++) {
                var kr = kunciResi_(mp.resi[n]);
                if (!kr || sudah[kr]) continue;
                sudah[kr] = true;
                baruT.push([String(mp.resi[n]), mp.sumber, String(mp.no), mp.ket || 'Otomatis: paket tambahan', 'Sistem', new Date()]);
              }
            }
            if (baruT.length) {
              shTautan.getRange(lrT + 1, 1, baruT.length, 3).setNumberFormat('@');
              shTautan.getRange(lrT + 1, 1, baruT.length, TAUTAN_RESI_HEADER.length).setValues(baruT);
            }
          }
          if (hasil.resiTerisi || hasil.resiDiganti || hasil.statusDiupdate || hasil.multiPaket.length) {
            SpreadsheetApp.flush();
            invalidasiCacheGabunganPesanan();
            try { invalidasiPetaResiRingkas_(); } catch (eI) { }
          }
        } finally { lepasKunci_(lock); }
      }
    }
  } finally { try { cache.remove(LR_KUNCI_SEDANG); } catch (eS) { } }
  hasil.multiPaket = hasil.multiPaket.length;
  return hasil;
}

// JADWAL (dicek tiap 1 menit oleh pg_cron, lihat SQL 0005): jalan tiap +-2 menit,
// atau +-40 detik setelah ada scan resi keluar baru.
function lengkapiResiTerjadwal() {
  if (typeof urlFetchSedangDiblokir === 'function' && urlFetchSedangDiblokir()) return { dilewati: 'kuota UrlFetch' };
  var terakhir = lrAngkaCache_(LR_KUNCI_TERAKHIR), pemicu = lrAngkaCache_(LR_KUNCI_PEMICU);
  var adaPemicu = pemicu > terakhir;
  if (Date.now() - terakhir < (adaPemicu ? LR_JEDA_PEMICU_MS : LR_JEDA_NORMAL_MS)) return { dilewati: true };
  try { pastikanTokenTikTokMasihValid(); } catch (eT) { }
  try { pastikanTokenConnerMasihValid(); } catch (eC) { }
  // v2026.10.22 (Paket 9): pesanan Conner ikut ditarik otomatis tiap ±5 menit (jadwal sinkron Conner lama tidak aktif,
  // sehingga pesanan Conner hanya masuk saat ada yang menekan Tarik Pesanan -> resi J&T Conner tidak pernah terhubung).
  var nCn = 0;
  try {
    var pCn = PropertiesService.getScriptProperties();
    if (pCn.getProperty('CONNER_ACCESS_TOKEN') && pCn.getProperty('CONNER_SHOP_CIPHER') && connerAppKey_() &&
        Date.now() - lrAngkaCache_('CN_SYNC_TERJADWAL') > CN_SYNC_JEDA_MS_) {
      CacheService.getScriptCache().put('CN_SYNC_TERJADWAL', String(Date.now()), 21600);
      var hCn = prosesSyncPesananConner({ dariSistem: true });
      nCn = (hCn && hCn.jumlahBaru) || 0;
    }
  } catch (eCn) { }
  // v2026.10.52 (DN-261021-222527-664): retur/refund toko Conner ditarik tiap ±15 menit (dulu tidak pernah ditarik)
  try {
    var pRc = PropertiesService.getScriptProperties();
    if (pRc.getProperty('CONNER_ACCESS_TOKEN') && pRc.getProperty('CONNER_SHOP_CIPHER') && connerAppKey_() &&
        Date.now() - lrAngkaCache_('CN_RETUR_TERJADWAL') > P34_CN_RETUR_JEDA_MS_) {
      CacheService.getScriptCache().put('CN_RETUR_TERJADWAL', String(Date.now()), 21600);
      prosesSyncReturConner({ dariSistem: true });
    }
  } catch (eRc) { }
  var h = lengkapiResiKosongSemua_({ paksa: true, abaikanJeda: adaPemicu || nCn > 0 });
  // v2026.10.21: koreksi salah scan otomatis (tanpa API, dari data pesanan yang sudah ada) - paling sering tiap 5 menit,
  // atau segera setelah resi baru terisi / ada scan keluar baru.
  var nKrs = 0;
  try {
    var cKrs = CacheService.getScriptCache(), tKrs = lrAngkaCache_('KRS_TERAKHIR_JALAN');
    if (Date.now() - tKrs > (h.resiTerisi || h.resiDiganti || adaPemicu ? 60000 : 300000)) {
      cKrs.put('KRS_TERAKHIR_JALAN', String(Date.now()), 21600);
      nKrs = krsJalankan_({ oleh: 'Sistem (otomatis)' }).dikoreksi.length;
    }
  } catch (eKrs) { h.error.push('Koreksi resi: ' + eKrs); }
  // v2026.10.23 (DN-071908-352 / DN-070830-156): ID Pesanan / kurir kosong yang discan dari HP ikut dicek otomatis (tanpa buka web)
  var nIns = 0;
  try {
    if (Date.now() - lrAngkaCache_('P10_INSTAN_TERJADWAL') > (adaPemicu ? 60000 : 300000)) {
      CacheService.getScriptCache().put('P10_INSTAN_TERJADWAL', String(Date.now()), 21600);
      nIns = p10ResolveInstanTerjadwal_();
    }
  } catch (eIns) { h.error.push('Cek instan: ' + eIns); }
  // v2026.10.40 (Paket 24): data pembeli Shopee ditangkap selagi pesanan masih aktif (sebelum disamarkan), tiap ±10 menit
  var nPb = 0;
  try {
    // v2026.10.66 (DN-261025-192158-148): BUKAN lagi tiap 10 menit - tiap pesanan dicoba 1x setiap STATUS-nya berubah
    // (mis. UNPAID -> READY_TO_SHIP -> PROCESSED -> SHIPPED ...). Pemeriksaan perubahan status murah (tanpa API) tiap ±90 detik.
    if (Date.now() - lrAngkaCache_('SPB_TERJADWAL') > P48_SPB_CEK_MS_ && PropertiesService.getScriptProperties().getProperty('SHOPEE_ACCESS_TOKEN')) {
      CacheService.getScriptCache().put('SPB_TERJADWAL', String(Date.now()), 21600);
      var hPb = p48PembeliShopeePerStatus_();
      nPb = (hPb && hPb.terisi) || 0;
    }
  } catch (ePb) { h.error.push('Pembeli Shopee: ' + ePb); }
  // v2026.10.53 (Paket 35, DN-261022-172934-471): data pembeli TikTok Shop / Tokopedia / Conner, tiap ±10 menit
  var nTtb = 0;
  try {
    if (Date.now() - lrAngkaCache_('TTB_TERJADWAL') > TTB_JEDA_MS_) {
      CacheService.getScriptCache().put('TTB_TERJADWAL', String(Date.now()), 21600);
      var hTtb = prosesOtomatisPembeliTikTok({ dariSistem: true });
      nTtb = (hTtb && hTtb.terisi) || 0;
    }
  } catch (eTtb) { h.error.push('Pembeli TikTok: ' + eTtb); }
  return { resiTerisi: h.resiTerisi, pembeliShopeeTerisi: nPb, pembeliTiktokTerisi: nTtb, resiDiganti: h.resiDiganti, statusDiupdate: h.statusDiupdate, paketTambahan: h.multiPaket,
    dicek: h.dicek, pemicuScan: adaPemicu, dilewati: h.dilewati, koreksiResi: nKrs, pesananConnerBaru: nCn, instanDicek: nIns, error: h.error.slice(0, 3) };
}

