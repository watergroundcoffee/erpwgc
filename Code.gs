    validasi: function () {
      row = parseInt(data.row, 10) || 0;
      noInvoice = String(data.noInvoice || '').trim();
      if (!noInvoice) throw new Error('No Invoice kosong.');
      if (!data.base64 && !String(data.diterimaOleh || '').trim()) throw new Error('Isi nama penerima (Diterima oleh) atau ambil foto bukti.');
    }
