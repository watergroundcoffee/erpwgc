      var o = data.olah, inp = (o.input || []).map(function (it) {
        var b = peta[String(it.sku || '').trim().toUpperCase()];
        if (!b) throw new Error('Bahan olah ' + it.sku + ' tidak ditemukan.');
        if (!b.gramPer) throw new Error('Satuan ' + b.nama + ' harus kg / gram.');
