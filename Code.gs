/* ---------- AI_Messages ---------- */
function aiwMsgKeObjek_(r, row) {
  return {
    row: row, message_id: String(r[0] || '').trim(), session_id: String(r[1] || '').trim(), seq: Number(r[2]) || 0, role: String(r[3] || ''),
    konten: String(r[4] || ''), cards: aiwJson_(r[5], []) || [], status: String(r[6] || 'selesai'), token_in: Number(r[7]) || 0,
    token_out: Number(r[8]) || 0, dibuat: r[9], info: aiwJson_(r[10], {}) || {}
  };
}
function aiwMsgPublik_(m) {
  return { message_id: m.message_id, seq: m.seq, role: m.role, konten: m.konten, cards: m.cards, status: m.status, token_in: m.token_in, token_out: m.token_out, dibuat: aiwIso_(m.dibuat), info: m.info };
}
// Semua pesan 1 thread (urut seq). TextFinder di kolom Session_ID -> hanya baris thread ini yang dibaca.
function aiwPesanSesi_(sessionId) {
  var sh = aiwMsgSheet_(), lr = sh.getLastRow();
  if (lr < 2) return [];
  var temu = sh.getRange(2, 2, lr - 1, 1).createTextFinder(String(sessionId)).matchEntireCell(true).findAll();
  if (!temu.length) return [];
  var rows = temu.map(function (c) { return c.getRow(); }).sort(function (a, b) { return a - b; });
  var out = [];
  var min = rows[0], max = rows[rows.length - 1];
  if (max - min < 3000) {
    var set = {}; rows.forEach(function (r) { set[r] = true; });
    var vals = sh.getRange(min, 1, max - min + 1, AIW_MSG_HEADER_.length).getValues();
    vals.forEach(function (r, i) { if (set[min + i]) out.push(aiwMsgKeObjek_(r, min + i)); });
  } else {
    // Thread lama yang dibuka lagi (barisnya berjauhan) -> baca per baris, cukup 80 terakhir
    rows.slice(-80).forEach(function (row) { out.push(aiwMsgKeObjek_(sh.getRange(row, 1, 1, AIW_MSG_HEADER_.length).getValues()[0], row)); });
  }
  out.sort(function (a, b) { return a.seq - b.seq; });
  return out;
}
function aiwCariPesan_(messageId) {
  var id = String(messageId || '').trim();
  if (!id) throw new Error('message_id kosong.');
  var sh = aiwMsgSheet_(), lr = sh.getLastRow();
  if (lr < 2) throw new Error('Pesan tidak ditemukan.');
  var f = sh.getRange(2, 1, lr - 1, 1).createTextFinder(id).matchEntireCell(true).findNext();
  if (!f) throw new Error('Pesan tidak ditemukan.');
  return aiwMsgKeObjek_(sh.getRange(f.getRow(), 1, 1, AIW_MSG_HEADER_.length).getValues()[0], f.getRow());
}
function aiwTulisKartu_(m) {
