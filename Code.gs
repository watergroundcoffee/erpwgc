}

// Data lengkap per-produk buat Laporan Katalog yang bisa dicetak - gabungan Master Produk +
// Stock fisik saat ini, diurutkan per Kategori.
/* ============================================================
   DASHBOARD KATALOG - ringkasan kesehatan katalog produk, khusus menu Katalog.
   Reuse data dari Laporan Katalog & Anomali Harga yang udah ada, jadi nggak dobel logic.
   ============================================================ */
function prosesLihatDashboardKatalog(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var laporan = prosesLihatLaporanKatalogLengkap(data);
    if (!laporan.success) throw new Error(laporan.error || 'Gagal ambil data katalog.');
    var daftar = laporan.daftar || [];

    var tanpaHarga = 0, totalMarginPersen = 0, jumlahMarginValid = 0, totalNilaiInventory = 0;
    var perKategori = {};

    daftar.forEach(function (p) {
      if (!p.hargaDefault || !p.hpp) tanpaHarga++;
      perKategori[p.kategori] = (perKategori[p.kategori] || 0) + 1;
      if (p.hargaDefault > 0 && p.hpp > 0) {
        totalMarginPersen += (p.hargaDefault - p.hpp) / p.hargaDefault * 100;
        jumlahMarginValid++;
      }
      totalNilaiInventory += p.nilaiInventory || 0;
    });

    var perKategoriArr = Object.keys(perKategori).map(function (k) {
      return { kategori: k, jumlah: perKategori[k] };
    }).sort(function (a, b) { return b.jumlah - a.jumlah; });

    var topNilai = daftar.slice()
      .sort(function (a, b) { return (b.nilaiInventory || 0) - (a.nilaiInventory || 0); })
      .slice(0, 5)
      .map(function (p) { return { sku: p.sku, nama: p.nama, nilai: p.nilaiInventory || 0 }; });

    var jumlahAnomali = 0;
    try {
      var anomali = prosesLihatAnomaliHarga(data);
      if (anomali.success) jumlahAnomali = anomali.daftar.length;
    } catch (eA) { /* biarin 0 kalau gagal, jangan gagalin seluruh dashboard */ }

    result.success = true;
    result.totalProduk = daftar.length;
    result.tanpaHarga = tanpaHarga;
    result.marginRataRata = jumlahMarginValid > 0 ? Math.round(totalMarginPersen / jumlahMarginValid) : 0;
    result.totalNilaiInventory = totalNilaiInventory;
    result.perKategori = perKategoriArr;
    result.topNilai = topNilai;
    result.jumlahAnomali = jumlahAnomali;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesLihatLaporanKatalogLengkap(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var cache = CacheService.getScriptCache();
    var cacheKey = 'LAPORAN_KATALOG_' + (data.toko || 'default');
    var dariCache = cache.get(cacheKey);
    if (dariCache) {
      try { return JSON.parse(dariCache); } catch (eParseCache) { /* cache korup, lanjut baca fresh */ }
    }

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 15).getValues();
      var stockData = prosesLihatStock({ email: data.email });
      var stockMap = {};
      if (stockData.success) stockData.daftar.forEach(function (d) { stockMap[d.sku] = d.stockSaatIni; });

      var petaArsipLap = katPetaArsip_(data.toko);
      vals.forEach(function (row) {
        var sku = String(row[0] || '').trim();
        if (!sku || petaArsipLap[sku]) return;
        var hpp = parseFloat(row[3]) || 0;
        var stockFisik = stockMap[sku] || 0;
        daftar.push({
          sku: sku, nama: String(row[1] || '').trim(), kategori: String(row[7] || '').trim() || '(Tanpa Kategori)',
          brand: String(row[10] || '').trim(), hargaDefault: parseFloat(row[2]) || 0, hpp: hpp,
          stockFisik: stockFisik, nilaiInventory: hpp * Math.max(0, stockFisik) // stok minus tidak dihitung
        });
      });
    }
    daftar.sort(function (a, b) { return a.kategori.localeCompare(b.kategori) || a.nama.localeCompare(b.nama); });

    result.success = true;
    result.daftar = daftar;
    try { cache.put(cacheKey, JSON.stringify(result), 20); } catch (eCachePut) { /* kegedean buat cache, lewati */ }
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   UPDATE NAMA + FOTO + MERK DARI URL SUPPLIER - urutan pengecekan:
   1. Data terstruktur (schema.org) - paling akurat, nggak butuh AI
   2. Nama dari SLUG URL (biasanya udah jelas formatnya, cuma perlu dibersihkan)
   3. AI (fallback) - cuma dipakai kalau 1&2 nggak ketemu/nggak yakin
   ============================================================ */
function prosesUpdateNamaFotoMerkDariSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('SKU kosong');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 11).getValues();
    var rowTarget = -1, urlSupplier = '', urlFotoSaatIni = '';
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][0]).trim() === sku) {
        rowTarget = i + 2;
        urlSupplier = String(vals[i][4] || '').trim();
        urlFotoSaatIni = String(vals[i][8] || '').trim();
        break;
      }
    }
    if (rowTarget === -1) throw new Error('SKU tidak ditemukan');
    if (!urlSupplier) throw new Error('Produk ini belum punya URL Supplier');

    var html;
    if (/search|cari|[?&](key|q|keyword)=/i.test(urlSupplier)) { html = supAmbilHalamanProduk_(urlSupplier).html; } // v2026.10.36
    else {
      var res = fetchHemat(urlSupplier, { muteHttpExceptions: true, followRedirects: true });
      if (res.getResponseCode() !== 200) throw new Error('Gagal buka halaman supplier (kode ' + res.getResponseCode() + ')');
      html = res.getContentText();
    }

    // LANGKAH 1: Ambil judul produk ASLI dulu (plek ketiplek, deterministik - BUKAN AI) dari
    // data terstruktur (schema.org), og:title, atau tag <title> - urutan dari yang paling akurat.
    var judulAsli = null;
    var polaJudul = [
      /"name"\s*:\s*"([^"]{3,150})"/i,
      /property=["']og:title["'][^>]*content=["']([^"']+)["']/i,
      /<title[^>]*>([^<]{3,150})<\/title>/i
    ];
    for (var pj = 0; pj < polaJudul.length; pj++) {
      var cocokJudul = html.match(polaJudul[pj]);
      if (cocokJudul && cocokJudul[1]) { judulAsli = cocokJudul[1].replace(/\\\//g, '/').trim(); break; }
    }

    // LANGKAH 2: AI cuma URAI judul yang UDAH JELAS itu jadi komponen atribut - tugas lebih
    // simpel & lebih akurat daripada nyari sendiri di seluruh halaman.
    var namaBaru = null, tipeBaru = '', materialBaru = '', volumeBaru = '', warnaBaru = '', brandBaru = '', errorAI = '';

    if (!judulAsli) {
      errorAI = 'Judul produk nggak ketemu di halaman (nggak ada schema.org/og:title/tag title).';
    } else {
      var prompt = 'Ini JUDUL PERSIS sebuah produk dari toko online: "' + judulAsli + '"\n' +
        'Urai judul ini jadi komponen-komponennya. Balas HANYA JSON persis format ini, tanpa kata pembuka/penutup:\n' +
        '{"nama":"nama inti produk (tanpa tipe/material/volume/warna/brand)","tipe":"","material":"","volume":"","warna":"","brand":""}\n' +
        'Isi tipe/material/volume/warna/brand HANYA kalau kata itu BENERAN ada di judul. Kalau nggak ada di judul, biarkan string kosong "". ' +
        'Jangan menebak-nebak/nambahin info yang nggak ada di judul.';

      try {
        var hasilMentah = panggilGeminiText(prompt, 'rehan');
        var cocokJson = hasilMentah.match(/\{[\s\S]*\}/);
        if (!cocokJson) throw new Error('AI nggak balas format JSON. Respons: ' + hasilMentah.substring(0, 200));
        var parsed = JSON.parse(cocokJson[0]);

        var namaIntiDenganTipe = String(parsed.nama || '').trim();
        if (parsed.tipe) namaIntiDenganTipe += ' ' + String(parsed.tipe).trim();
      var bagianNama = [namaIntiDenganTipe, parsed.material, parsed.volume, parsed.warna]
        .map(function (b) { return String(b || '').trim(); }).filter(function (b) { return b.length > 0; });
      namaBaru = bagianNama.join(' ');
      tipeBaru = String(parsed.tipe || '').trim();
      materialBaru = String(parsed.material || '').trim();
      volumeBaru = String(parsed.volume || '').trim();
      warnaBaru = String(parsed.warna || '').trim();
      brandBaru = String(parsed.brand || '').trim();
    } catch (eAI) {
      errorAI = eAI.toString(); // jangan ditelan diam2 - biar kelihatan kalau masih gagal
    }
    }

    // Foto - pola yang sama seperti fitur update harga
    var fotoBaruDiisi = false;
    if (!urlFotoSaatIni) {
      var polaFoto = [/"image"\s*:\s*"([^"]+\.(?:jpg|jpeg|png|webp)[^"]*)"/i, /property=["']og:image["'][^>]*content=["']([^"']+)["']/i];
      for (var f = 0; f < polaFoto.length; f++) {
        var cocokFoto = html.match(polaFoto[f]);
        if (cocokFoto && cocokFoto[1]) {
          try {
            var urlFotoAsli = cocokFoto[1].replace(/\\\//g, '/');
            var resFoto = fetchHemat(urlFotoAsli, { muteHttpExceptions: true });
            if (resFoto.getResponseCode() === 200) {
              var fileFoto = getSubfolderUpload('Foto Produk').createFile(resFoto.getBlob().setName('foto-produk-' + sku));
              fileFoto.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
              var urlFotoSupplier = 'https://lh3.googleusercontent.com/d/' + fileFoto.getId();
              katTulisDiBarisSku_(sh, sku, function (row) { sh.getRange(row, 9).setValue(urlFotoSupplier); });
              fotoBaruDiisi = true;
            }
          } catch (eFoto) { }
          break;
        }
      }
    }

    katTulisDiBarisSku_(sh, sku, function (row) {
      if (namaBaru) sh.getRange(row, 2).setValue(namaBaru);
      if (brandBaru || tipeBaru || materialBaru || volumeBaru || warnaBaru) {
        sh.getRange(row, 11, 1, 5).setValues([[brandBaru, tipeBaru, materialBaru, volumeBaru, warnaBaru]]);
      }
    });

    result.success = true;
    result.namaBaru = namaBaru;
    result.sumberNama = 'rumus atribut';
    result.brandBaru = brandBaru;
    result.tipeBaru = tipeBaru;
    result.materialBaru = materialBaru;
    result.volumeBaru = volumeBaru;
    result.warnaBaru = warnaBaru;
    result.fotoBaruDiisi = fotoBaruDiisi;
    result.errorAI = errorAI;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

