/* ======================================================================================
   OMNIAI PERSISTENT SYSTEM MEMORY  (Google Drive: OmniAI_Memory.json)
   - File JSON di folder Drive (Script Property MEMORY_FOLDER_ID; dibuat otomatis bila kosong).
   - memoryBlokPrompt_() -> disuntikkan ke System Prompt tanyaCopilot (cache 10 menit).
   - AI mengusulkan aksi UPDATE_MEMORY lewat jalur execute_action yang sama -> tetap butuh klik
     konfirmasi (TIDAK ada di EKS_AUTOPILOT_IZIN_), izin EKS_IZIN_, dan tercatat di Execution_Logs.
   - Memori bersifat ARAHAN untuk AI; guardrail server (HPP + komisi, batas 50%) TIDAK berubah.
   - Rollback: buka file di Drive > Kelola versi / Riwayat versi.
   ====================================================================================== */
var MEM_NAMA_FILE_ = 'OmniAI_Memory.json';
var MEM_NAMA_FOLDER_DEFAULT_ = 'OmniAI_System';
var MEM_PROP_FOLDER_ = 'MEMORY_FOLDER_ID';
var MEM_PROP_FILE_ = 'MEMORY_FILE_ID';
var MEM_CACHE_ = 'OMNI_MEMORY_V1';
var MEM_MAKS_ITEM_ = 40;          // maks item per daftar (instruksi / aturan)
var MEM_MAKS_TEKS_ = 500;         // maks karakter per item
var MEM_MAKS_RIWAYAT_EKS_ = 15;   // ringkasan eksekusi yang disimpan
var MEM_MAKS_PROMPT_ = 12000;     // maks karakter blok memori di System Prompt

var MEM_ATURAN_TOOL_ =
  'ALAT MEMORI (UPDATE_MEMORY): Bila Owner menyampaikan instruksi permanen, target bisnis, atau aturan operasional yang harus diingat lintas sesi ' +
  '(contoh: "mulai bulan depan target margin bersih naik jadi 15%"), usulkan SATU blok ```json``` dengan format aksi yang sama:\n' +
  '{"tool_call":"execute_action","action":"UPDATE_MEMORY","params":{"bagian":"target_bisnis|instruksi_permanen|aturan_operasional","operasi":"tambah|ubah|hapus",' +
  '"kunci":"snake_case (wajib utk target_bisnis) ATAU id item [Mxxx] utk ubah/hapus daftar","nilai":angka atau teks,"berlaku_mulai":"yyyy-MM-dd (opsional)","catatan":"opsional"},"alasan":"..."}\n' +
  'Contoh: {"tool_call":"execute_action","action":"UPDATE_MEMORY","params":{"bagian":"target_bisnis","operasi":"ubah","kunci":"target_margin_bersih_persen","nilai":15,"berlaku_mulai":"<tgl 1 bulan depan>"},"alasan":"Owner menaikkan target margin bersih."}\n' +
  'Aturan memori: simpan HANYA hal durable yang dinyatakan langsung oleh user (bukan kesimpulanmu, bukan angka harian); hitung tanggal relatif ("bulan depan") dari tanggal hari ini; ' +
  'cek MEMORI di atas dulu - pakai "ubah" bila kunci sudah ada, jangan duplikasi; jangan simpan password/token/API key; jangan mengklaim memori sudah tersimpan sebelum sistem melapor.';

/* ---------- Struktur dasar ---------- */
function memoryDefault_() {
  return { versi: 1, diperbarui: '', diperbaruiOleh: '', instruksi_permanen: [], target_bisnis: {}, aturan_operasional: [], ringkasan_eksekusi: [] };
}
function memoryBersihTeks_(v) {
  return String(v == null ? '' : v).replace(/```/g, "'''").replace(/\s+/g, ' ').trim().slice(0, MEM_MAKS_TEKS_);
}
function memoryTanggal_(v) {
  var t = String(v == null ? '' : v).trim();
  if (!t) return '';
  if (!/^\d{4}-\d{2}-\d{2}$/.test(t)) throw new Error('berlaku_mulai harus format yyyy-MM-dd (diterima: "' + t + '").');
  return t;
}
function memoryNormalisasi_(m) {
  var d = memoryDefault_();
  m = (m && typeof m === 'object' && !Array.isArray(m)) ? m : {};
  Object.keys(d).forEach(function (k) { if (m[k] === undefined || m[k] === null) m[k] = d[k]; });
  if (typeof m.target_bisnis !== 'object' || Array.isArray(m.target_bisnis)) m.target_bisnis = {};
  if (!Array.isArray(m.ringkasan_eksekusi)) m.ringkasan_eksekusi = [];
  ['instruksi_permanen', 'aturan_operasional'].forEach(function (k) {
    if (!Array.isArray(m[k])) m[k] = [];
    m[k] = m[k].map(function (x, i) {               // toleran bila Owner mengedit manual (string biasa)
      if (typeof x === 'string') x = { teks: x };
      x = x || {};
      if (!x.id) x.id = 'M' + (i + 1);
      x.teks = memoryBersihTeks_(x.teks);
      return x;
    }).filter(function (x) { return x.teks; });
  });
  return m;
}

/* ---------- Penyimpanan Drive ---------- */
function memoryFolder_() {
  var props = PropertiesService.getScriptProperties(), id = String(props.getProperty(MEM_PROP_FOLDER_) || '').trim();
  if (id) {
    try { return DriveApp.getFolderById(id); }
    catch (e) { throw new Error('MEMORY_FOLDER_ID tidak valid / tidak bisa diakses: ' + id); }
  }
  var it = DriveApp.getFoldersByName(MEM_NAMA_FOLDER_DEFAULT_);
  var f = it.hasNext() ? it.next() : DriveApp.createFolder(MEM_NAMA_FOLDER_DEFAULT_);
  props.setProperty(MEM_PROP_FOLDER_, f.getId());
  return f;
}
function memoryFile_(buat) {
  var props = PropertiesService.getScriptProperties(), id = String(props.getProperty(MEM_PROP_FILE_) || '').trim();
  if (id) { try { var f0 = DriveApp.getFileById(id); if (!f0.isTrashed()) return f0; } catch (e) { } }
  var folder = memoryFolder_(), it = folder.getFilesByName(MEM_NAMA_FILE_), f = null;
  while (it.hasNext()) { var c = it.next(); if (!c.isTrashed()) { f = c; break; } }
  if (!f) {
    if (!buat) return null;
    f = folder.createFile(MEM_NAMA_FILE_, JSON.stringify(memoryDefault_(), null, 2), 'application/json');
  }
  props.setProperty(MEM_PROP_FILE_, f.getId());
  return f;
}
// Baca langsung dari Drive. Melempar error bila JSON rusak (supaya AI TIDAK menimpa file yang rusak).
function memoryBacaMentah_() {
  var isi = memoryFile_(true).getBlob().getDataAsString('UTF-8');
  if (!String(isi || '').trim()) return memoryDefault_();
  try { return memoryNormalisasi_(JSON.parse(isi)); }
  catch (e) { throw new Error('OmniAI_Memory.json bukan JSON valid - perbaiki di Drive (Riwayat versi) dulu: ' + e.message); }
}
// Baca untuk prompt (cache 10 menit). Tidak pernah melempar error -> Copilot tetap jalan.
function memoryMuat_(segarkan) {
  var cache = CacheService.getScriptCache();
  if (!segarkan) { var c = cache.get(MEM_CACHE_); if (c) { try { return JSON.parse(c); } catch (e) { } } }
  try {
    var mem = memoryBacaMentah_();
    try { cache.put(MEM_CACHE_, JSON.stringify(mem), 600); } catch (e) { }
    return mem;
  } catch (e) {
    var d = memoryDefault_(); d._error = e.message; return d;   // tidak di-cache agar dicoba lagi
  }
}
// oleh = null -> metadata "diperbarui" tidak diubah (dipakai saat hanya mencatat ringkasan eksekusi)
function memorySimpan_(mem, oleh) {
  delete mem._error;
  mem.versi = 1;
  if (oleh) {
    mem.diperbarui = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm:ss');
    mem.diperbaruiOleh = String(oleh).slice(0, 120);
  }
  var teks = JSON.stringify(mem, null, 2);
  if (teks.length > 90000) throw new Error('Memori terlalu besar (' + teks.length + ' karakter). Hapus/gabungkan item lama dulu.');
  memoryFile_(true).setContent(teks);
  var cache = CacheService.getScriptCache();
  try { cache.put(MEM_CACHE_, JSON.stringify(mem), 600); } catch (e) { try { cache.remove(MEM_CACHE_); } catch (e2) { } }
  return mem;
}

/* ---------- Inti perubahan memori (dipanggil executeAiAction setelah cek izin) ----------
   newContext = { bagian, operasi:'tambah'|'ubah'|'hapus', kunci?, nilai?, berlaku_mulai?, catatan? } */
function memoryUbah_(newContext, opsi) {
  opsi = opsi || {};
  var c = newContext;
  if (typeof c === 'string') { try { c = JSON.parse(c); } catch (e) { c = { bagian: 'instruksi_permanen', operasi: 'tambah', nilai: c }; } }
  c = c || {};
  var alias = { instruksi: 'instruksi_permanen', instruksi_permanen: 'instruksi_permanen', aturan: 'aturan_operasional', aturan_operasional: 'aturan_operasional', target: 'target_bisnis', target_bisnis: 'target_bisnis' };
  var bagian = alias[String(c.bagian || '').toLowerCase().trim()];
  if (!bagian) throw new Error('Bagian memori tidak dikenal: "' + c.bagian + '" (target_bisnis / instruksi_permanen / aturan_operasional).');
  var operasi = String(c.operasi || 'tambah').toLowerCase().trim();
  if (['tambah', 'ubah', 'hapus'].indexOf(operasi) < 0) throw new Error('Operasi memori tidak dikenal: "' + c.operasi + '" (tambah / ubah / hapus).');
  var berlaku = memoryTanggal_(c.berlaku_mulai);
  var oleh = String(opsi.oleh || opsi.email || 'sistem').slice(0, 120);
  var nilaiTeks = memoryBersihTeks_(c.nilai);
  if (operasi !== 'hapus') {
    if (nilaiTeks === '') throw new Error('Nilai memori kosong.');
    if (/(api[_\s-]?key|password|kata\s*sandi|token|secret)\s*[:=]\s*\S{6,}/i.test(nilaiTeks)) throw new Error('Memori tidak boleh berisi password / token / API key.');
  }

  var lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) throw new Error('Memori sedang diperbarui proses lain, coba lagi sebentar.');
  try {
    var mem = memoryBacaMentah_();
    var now = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm');
    var oldV = '', newV = '', target = '', pesan = '';

    if (bagian === 'target_bisnis') {
      var kunci = String(c.kunci || '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 60);
      if (!kunci) throw new Error('kunci wajib untuk target_bisnis (contoh: target_margin_bersih_persen).');
      var lama = mem.target_bisnis[kunci];
      oldV = lama ? JSON.stringify({ nilai: lama.nilai, berlaku_mulai: lama.berlaku_mulai || '' }) : '';
      target = 'MEMORI:target_bisnis/' + kunci;
      if (operasi === 'hapus') {
        if (!lama) throw new Error('Target "' + kunci + '" tidak ada di memori.');
        delete mem.target_bisnis[kunci];
        pesan = 'Target ' + kunci + ' dihapus dari memori.';
      } else {
        var angka = typeof c.nilai === 'number' || /^-?\d+([.,]\d+)?$/.test(String(c.nilai).trim());
        var nilai = angka ? Number(String(c.nilai).replace(',', '.')) : nilaiTeks;
        mem.target_bisnis[kunci] = {
          nilai: nilai, berlaku_mulai: berlaku,
          sebelumnya: lama ? { nilai: lama.nilai, berlaku_mulai: lama.berlaku_mulai || '' } : null,
          catatan: memoryBersihTeks_(c.catatan).slice(0, 200), diperbarui: now, oleh: oleh
        };
        newV = JSON.stringify({ nilai: nilai, berlaku_mulai: berlaku });
        pesan = 'Memori diperbarui: ' + kunci + ' = ' + nilai + (berlaku ? ' (berlaku mulai ' + berlaku + ')' : '') + '.';
      }
    } else {
      var daftar = mem[bagian];
      if (operasi === 'tambah') {
        var dup = daftar.filter(function (x) { return String(x.teks).toLowerCase() === nilaiTeks.toLowerCase(); })[0];
        if (dup) return { status: 'REJECTED_DUPLICATE', pesan: 'Sudah ada di memori [' + dup.id + '].', target: 'MEMORI:' + bagian + '/' + dup.id, oldValue: dup.teks, newValue: '' };
        if (daftar.length >= MEM_MAKS_ITEM_) throw new Error('Bagian ' + bagian + ' sudah ' + MEM_MAKS_ITEM_ + ' item. Hapus/gabungkan yang lama dulu.');
        var id = 'M' + Date.now().toString(36).toUpperCase();
        daftar.push({ id: id, teks: nilaiTeks, berlaku_mulai: berlaku, dibuat: now, oleh: oleh });
        newV = nilaiTeks; target = 'MEMORI:' + bagian + '/' + id;
        pesan = 'Ditambahkan ke memori (' + bagian + ') [' + id + '].';
      } else {
        var idCari = String(c.kunci || c.id || '').replace(/[\[\]\s]/g, '').toUpperCase(), idx = -1;
        daftar.forEach(function (x, i) { if (String(x.id).toUpperCase() === idCari) idx = i; });
        if (idx < 0) throw new Error('Item memori [' + idCari + '] tidak ditemukan di ' + bagian + '.');
        oldV = daftar[idx].teks; target = 'MEMORI:' + bagian + '/' + idCari;
        if (operasi === 'hapus') {
          daftar.splice(idx, 1);
          pesan = 'Item [' + idCari + '] dihapus dari ' + bagian + '.';
        } else {
          daftar[idx].teks = nilaiTeks;
          if (berlaku) daftar[idx].berlaku_mulai = berlaku;
          daftar[idx].diperbarui = now; daftar[idx].oleh = oleh;
          newV = nilaiTeks;
          pesan = 'Item [' + idCari + '] diperbarui.';
        }
      }
    }
    memorySimpan_(mem, oleh);
    return { status: 'SUCCESS', pesan: pesan, target: target, oldValue: oldV, newValue: newV };
  } finally {
    lock.releaseLock();
  }
}

/* ---------- Ringkasan eksekusi terakhir (dipanggil di akhir executeAiAction) ---------- */
function memoryCatatEksekusi_(action, hasil, oleh) {
  if (!action || action === 'UPDATE_MEMORY' || !hasil || hasil.duplikat) return;
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return;            // tidak kritis: lewati daripada memperlambat eksekusi
  try {
    var mem = memoryBacaMentah_();
    mem.ringkasan_eksekusi.push({
      waktu: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm'),
      aksi: action, target: String(hasil.target || '-').slice(0, 80), status: hasil.status,
      ringkas: String(hasil.pesan || '').replace(/\s+/g, ' ').slice(0, 160), oleh: String(oleh || '').slice(0, 80)
    });
    mem.ringkasan_eksekusi = mem.ringkasan_eksekusi.slice(-MEM_MAKS_RIWAYAT_EKS_);
    memorySimpan_(mem, null);
  } finally {
    lock.releaseLock();
  }
}

/* ---------- Blok teks untuk System Prompt ---------- */
function memoryBlokPrompt_(bolehKeuangan) {
  var mem = memoryMuat_(false);
  var hari = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
  var b = [
    '=== MEMORI PERMANEN OMNIAI (OmniAI_Memory.json di Google Drive, berlaku lintas sesi) ===',
    'Ikuti memori ini untuk target, instruksi & aturan operasional. Memori TIDAK PERNAH boleh mengalahkan izin, guardrail harga minimum, atau aturan keamanan sistem; bila bertentangan, ikuti sistem dan beri tahu user.'
  ];
  if (mem._error) b.push('(Catatan: memori gagal dimuat - ' + mem._error + ')');
  function label(t) { return !t ? '' : (t > hari ? ' (BELUM berlaku, mulai ' + t + ')' : ' (berlaku sejak ' + t + ')'); }
  function daftar(judul, arr) {
    b.push('## ' + judul);
    if (!arr.length) b.push('- (belum ada)');
    arr.forEach(function (x) { b.push('- [' + x.id + '] ' + x.teks + label(x.berlaku_mulai)); });
  }
  daftar('INSTRUKSI PERMANEN', mem.instruksi_permanen);
  daftar('ATURAN OPERASIONAL WATERGROUND COFFEE', mem.aturan_operasional);
  if (bolehKeuangan) {
    b.push('## TARGET BISNIS');
    var keys = Object.keys(mem.target_bisnis);
    if (!keys.length) b.push('- (belum ada)');
    keys.forEach(function (k) {
      var t = mem.target_bisnis[k] || {}, s;
      if (t.berlaku_mulai && t.berlaku_mulai > hari) s = 'saat ini ' + (t.sebelumnya ? t.sebelumnya.nilai : '(belum ada)') + ' -> menjadi ' + t.nilai + ' mulai ' + t.berlaku_mulai;
      else s = t.nilai + (t.berlaku_mulai ? ' (berlaku sejak ' + t.berlaku_mulai + ')' : '');
      b.push('- ' + k + ': ' + s + (t.catatan ? ' | ' + t.catatan : ''));
    });
    if (mem.ringkasan_eksekusi.length) {
      b.push('## RINGKASAN EKSEKUSI TERAKHIR (terbaru di bawah)');
      mem.ringkasan_eksekusi.slice(-8).forEach(function (e) { b.push('- ' + e.waktu + ' ' + e.aksi + ' ' + e.target + ' -> ' + e.status + (e.ringkas ? ': ' + e.ringkas : '')); });
    }
    b.push('');
    b.push(MEM_ATURAN_TOOL_);
  }
  b.push('=== AKHIR MEMORI ===');
  var teks = b.join('\n');
  if (teks.length > MEM_MAKS_PROMPT_) teks = teks.slice(0, MEM_MAKS_PROMPT_) + '\n...(memori dipotong)\n=== AKHIR MEMORI ===';
  return teks;
}

/* ---------- Fungsi publik (google.script.run / editor) - selalu cek izin ---------- */
function memoryEmail_(e) {
  var email = String(e || '').trim();
  if (!email) { try { email = Session.getActiveUser().getEmail() || ''; } catch (x) { } }
  return email;
}
function loadMemory(opsi) {
  opsi = opsi || {};
  var email = memoryEmail_(opsi.email);
  if (!cekIzin(email, EKS_IZIN_)) throw new Error('Anda tidak punya izin membaca memori sistem.');
  return memoryMuat_(!!opsi.segarkan);
}
function updateMemory(newContext, opsi) {
  opsi = opsi || {};
  var email = memoryEmail_(opsi.email), oleh = 'Manual - ' + (email || 'tidak dikenal');
  if (!cekIzin(email, EKS_IZIN_)) throw new Error('Anda tidak punya izin mengubah memori sistem.');
  var r;
  try { r = memoryUbah_(newContext, { oleh: oleh, email: email }); }
  catch (err) { r = { status: 'FAILED', pesan: err.message, target: 'MEMORI', oldValue: '', newValue: '' }; }
  try { eksCatatLog_(oleh, 'UPDATE_MEMORY', r.target, r.oldValue, r.newValue, r.status, { pesan: r.pesan, params: newContext }); } catch (e) { }
  r.success = r.status === 'SUCCESS';
  return r;
}

/* ---------- Jalankan sekali dari editor (sekaligus memicu izin Drive) ---------- */
function setupMemory() {
  var folder = memoryFolder_(), f = memoryFile_(true);
  Logger.log('Folder memori : ' + folder.getName() + ' | ID ' + folder.getId());
