/* =====================================================================
   OCR STRUK / BUKTI BAYAR - PROTEKSI BIAYA API (AI FALLBACK BERTINGKAT)
   Tahap 1 (WAJIB, gratis) : Gemini Flash   -> key GEMINI_FREE_API_KEY (atau key agent Rehan bila provider Gemini)
   Tahap 2 (cadangan)      : Gemini Pro     -> HANYA dipanggil bila tahap 1 error / hasilnya tidak bisa dipakai
                                               (JSON rusak, nominal 0, item kosong). Key: OCR_PAID_API_KEY ->
                                               GEMINI_API_KEY -> LLM_API_KEY.
   Script Property opsional:
     OCR_MODEL_GRATIS    (default GEMINI_FREE_MODEL / gemini-3.6-flash)
     OCR_MODEL_BERBAYAR  (default: nama model gratis dengan "flash" diganti "pro")
     OCR_PAID_MAKS_HARIAN (default 40) - batas pemakaian model berbayar per hari (rem darurat biaya)
   Setiap pembacaan dicatat di sheet "Log OCR AI" (tahap, model, berhasil/gagal, alasan fallback).
   ===================================================================== */
var OCR_LOG_SHEET_ = 'Log OCR AI';
// Angka rupiah dari balasan AI: 150000 | "150000" | "150.000" | "Rp 150.000,00" -> 150000
function ocrAngka_(v) {
  if (typeof v === 'number') return isFinite(v) ? v : 0;
  var s = String(v || '').trim();
  if (/^\d+([.,]\d{1,2})?$/.test(s)) return parseFloat(s.replace(',', '.')) || 0;
  s = s.replace(/[,.]\d{1,2}$/, '').replace(/[^\d]/g, '');
  return parseFloat(s) || 0;
}
function ocrKonfig_() {
  var p = PropertiesService.getScriptProperties(), rehan = {};
  try { rehan = aiAgentKey_('rehan') || {}; } catch (e) { rehan = {}; }
  var bersih = function (k) { k = String(k || '').trim(); return k && k.indexOf('PASTE_') !== 0 ? k : ''; };
  var keyGratis = bersih(p.getProperty('GEMINI_FREE_API_KEY')) || (rehan.provider === 'gemini' ? bersih(rehan.key) : '');
  var modelGratis = String(p.getProperty('OCR_MODEL_GRATIS') || p.getProperty('GEMINI_FREE_MODEL') || AIF_MODEL_DEFAULT_).trim();
  var keyBayar = bersih(p.getProperty('OCR_PAID_API_KEY')) || bersih(typeof GEMINI_API_KEY !== 'undefined' ? GEMINI_API_KEY : '') || bersih(p.getProperty('LLM_API_KEY')) || keyGratis;
  var modelBayar = String(p.getProperty('OCR_MODEL_BERBAYAR') || '').trim() || (/flash/i.test(modelGratis) ? modelGratis.replace(/flash(-lite)?/i, 'pro') : 'gemini-2.5-pro');
  var maks = parseInt(p.getProperty('OCR_PAID_MAKS_HARIAN'), 10);
  return { keyGratis: keyGratis, modelGratis: modelGratis, keyBayar: keyBayar, modelBayar: modelBayar, maksBayar: maks > 0 ? maks : 40, rehan: rehan };
}
function ocrLog_(jenis, tahap, model, ok, alasan) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(OCR_LOG_SHEET_);
    if (!sh) { sh = ss.insertSheet(OCR_LOG_SHEET_); sh.getRange(1, 1, 1, 6).setValues([['Waktu', 'Jenis Dokumen', 'Tahap', 'Model', 'Hasil', 'Catatan']]).setFontWeight('bold'); sh.setFrozenRows(1); }
    sh.appendRow([new Date(), jenis, tahap, model, ok ? 'Berhasil' : 'Gagal', String(alasan || '').slice(0, 400)]);
  } catch (e) { }
}
function ocrPakaiBayarHariIni_(tambah) {
  var p = PropertiesService.getScriptProperties(), hari = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd'), o = {};
  try { o = JSON.parse(p.getProperty('OCR_PAID_PEMAKAIAN') || '{}'); } catch (e) { }
  if (o.d !== hari) o = { d: hari, n: 0 };
  if (tambah) { o.n++; p.setProperty('OCR_PAID_PEMAKAIAN', JSON.stringify(o)); }
  return o.n;
}
// Panggil 1 model Gemini Vision langsung (dipakai per tahap)
function ocrGeminiPanggil_(key, model, prompt, mime, base64) {
  var url = 'https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(model) + ':generateContent';
  var res = fetchHemat(url, { method: 'post', contentType: 'application/json', headers: { 'x-goog-api-key': key }, muteHttpExceptions: true,
    payload: JSON.stringify({ contents: [{ parts: [{ text: prompt }, { inline_data: { mime_type: mime || 'image/jpeg', data: base64 } }] }],
      generationConfig: { temperature: 0.1, maxOutputTokens: 8192, responseMimeType: 'application/json' } }) });
  var kode = res.getResponseCode(), isi = res.getContentText();
  if (kode !== 200) {
    var ket = isi;
    try { var j = JSON.parse(isi); ket = (j.error && j.error.message) || isi; } catch (eJ) { }
    var e = new Error('HTTP ' + kode + ': ' + String(ket).slice(0, 220)); e.httpKode = kode; throw e;
  }
  var d = JSON.parse(isi);
  var teks = d.candidates && d.candidates[0] && d.candidates[0].content && d.candidates[0].content.parts ?
    d.candidates[0].content.parts.map(function (x) { return x.text || ''; }).join('') : '';
  if (!String(teks).trim()) throw new Error('Balasan kosong (diblokir / tidak terbaca)');
  return teks;
}
/* validasiFn(parsed) -> '' kalau hasil layak dipakai, atau teks alasan kalau tidak (memicu fallback).
   Balikan: { parsed, teks, model, tahap: 'gratis'|'berbayar', alasanFallback } */
function ocrVisionBertingkat_(jenis, base64, mime, prompt, validasiFn) {
  var cfg = ocrKonfig_(), alasan = '';
  function coba(key, model) {
    var teks = ocrGeminiPanggil_(key, model, prompt, mime, base64);
    var parsed = aiParseJsonLonggar_(teks);
    var tolak = validasiFn ? validasiFn(parsed) : '';
    if (tolak) { var e = new Error(tolak); e.tidakLayak = true; throw e; }
    return { parsed: parsed, teks: teks };
  }
  // ---- Tahap 1: GRATIS ----
  if (cfg.keyGratis) {
    try {
      var h1 = coba(cfg.keyGratis, cfg.modelGratis);
      try { aifCatat_(0, false); } catch (eC) { }
      ocrLog_(jenis, 'gratis', cfg.modelGratis, true, '');
      h1.model = cfg.modelGratis; h1.tahap = 'gratis'; h1.alasanFallback = '';
      return h1;
    } catch (e1) { alasan = String(e1.message || e1); ocrLog_(jenis, 'gratis', cfg.modelGratis, false, alasan); }
  } else if (cfg.rehan && cfg.rehan.key) {
    // Agent Rehan bukan Gemini (Anthropic/OpenAI/dll) -> tetap dicoba lebih dulu lewat jalur AIF yang ada
    try {
      var teksR = aifPanggilLangsung_({ prompt: prompt, gambar: { mime: mime || 'image/jpeg', base64: base64 }, suhu: 0.1 });
      var pR = aiParseJsonLonggar_(teksR), tR = validasiFn ? validasiFn(pR) : '';
      if (tR) throw new Error(tR);
      ocrLog_(jenis, 'gratis', 'agent Rehan (' + (cfg.rehan.model || cfg.rehan.provider) + ')', true, '');
      return { parsed: pR, teks: teksR, model: cfg.rehan.model || cfg.rehan.provider, tahap: 'gratis', alasanFallback: '' };
    } catch (eR) { alasan = String(eR.message || eR); ocrLog_(jenis, 'gratis', 'agent Rehan', false, alasan); }
  } else {
    alasan = 'Key Gemini gratis (GEMINI_FREE_API_KEY) belum dipasang';
  }
  // ---- Tahap 2: BERBAYAR (fallback) ----
  if (!cfg.keyBayar) throw new Error('Model gratis gagal (' + alasan + ') dan key model berbayar belum dipasang.');
  if (ocrPakaiBayarHariIni_(false) >= cfg.maksBayar) throw new Error('Model gratis gagal (' + alasan + '). Batas harian model berbayar (' + cfg.maksBayar + 'x) sudah tercapai - isi manual dulu.');
  ocrPakaiBayarHariIni_(true);
  try {
    var h2 = coba(cfg.keyBayar, cfg.modelBayar);
    ocrLog_(jenis, 'berbayar', cfg.modelBayar, true, 'Fallback karena: ' + alasan);
    h2.model = cfg.modelBayar; h2.tahap = 'berbayar'; h2.alasanFallback = alasan;
    return h2;
  } catch (e2) {
    ocrLog_(jenis, 'berbayar', cfg.modelBayar, false, String(e2.message || e2));
    throw new Error('Gemini Flash: ' + alasan + ' | Gemini Pro: ' + String(e2.message || e2));
  }
}

function prosesEkstrakInvoiceAI(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    if (!data.gambarBase64) throw new Error('Gambar invoice kosong.');

    var prompt = 'Kamu melihat foto/scan invoice pembelian dari supplier. Baca dan ekstrak informasinya, ' +
      'balas HANYA dalam format JSON murni (tanpa markdown, tanpa penjelasan tambahan) persis struktur ini:\n' +
      '{\n' +
      '  "namaSupplier": "nama perusahaan/toko supplier",\n' +
      '  "noInvoice": "nomor invoice/faktur kalau ada, kalau tidak ada isi string kosong",\n' +
      '  "tanggal": "format YYYY-MM-DD, kalau tidak yakin pakai tanggal hari ini",\n' +
      '  "items": [\n' +
      '    { "sku": "kode/SKU produk kalau ada, kalau tidak ada isi string kosong", "nama": "nama produk", "qty": angka, "harga": angka harga satuan }\n' +
      '  ]\n' +
      '}\n' +
      'Kalau ada info yang nggak jelas/kebaca, tetap isi dengan tebakan terbaikmu, jangan kosongkan field wajib (namaSupplier, items).';

    // Gratis (Flash) dulu -> Pro hanya kalau gagal / item kosong
    var hasilAI = ocrVisionBertingkat_('Invoice Supplier', data.gambarBase64, data.mimeType || 'image/jpeg', prompt, function (x) {
      if (!x || typeof x !== 'object') return 'Balasan bukan objek JSON';
      if (!Array.isArray(x.items) || !x.items.length) return 'Item invoice tidak terbaca';
      return '';
    });
    var parsed = hasilAI.parsed;

    result.success = true;
    result.hasil = parsed;
    result.modelAI = hasilAI.model;
    result.tahapAI = hasilAI.tahap;
    result.alasanFallback = hasilAI.alasanFallback;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

