      if (hasil.sku.toUpperCase() === mentah.sku.toUpperCase()) throw new Error('Barang hasil tidak boleh sama dengan bahan.');
      rencana.push({ tahap: 'Roasting', input: [{ b: mentah, gram: masuk }], hasil: hasil, masuk: masuk, keluar: keluar, varian: mentah.nama,
        meta: { profil: String(x.profil || '').toUpperCase(), chaff: x.chaff === '' || x.chaff == null ? '' : prod2Num_(x.chaff), suhuMasuk: x.suhuMasuk === '' || x.suhuMasuk == null ? '' : prod2Num_(x.suhuMasuk),
          suhuKeluar: x.suhuKeluar === '' || x.suhuKeluar == null ? '' : prod2Num_(x.suhuKeluar), jam: rstJam_(x.jam), catatan: String(x.catatan || '') } });
    });
