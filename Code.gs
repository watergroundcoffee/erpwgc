}

// Dipanggil tiap ada perubahan yang mempengaruhi tampilan Katalog > Harga (HPP manual/AI diedit,
// Biaya Penjualan channel diubah) - biar halaman itu nggak nampilin data basi dari cache 30 detik.
function invalidasiCacheKatalogHarga(toko) {
  try { CacheService.getScriptCache().remove('KATALOG_HARGA_' + (toko || 'default')); } catch (e) { /* biarin, nggak fatal */ }
  invalidasiCacheProdukRingan_(toko);
}

/* ============================================================
   RUMUS HARGA DEFAULT BERBASIS MARGIN BERSIH:
   Harga Jual = HPP / (1 - Margin% / 100), dibulatkan ke ratusan terdekat.
   Margin bisa GLOBAL (setting umum) atau per-SKU (override, kalau diisi).
   ============================================================ */
function hitungHargaDariMargin(hpp, marginPersen) {
  if (!hpp || hpp <= 0) return 0;
  if (!marginPersen || marginPersen <= 0 || marginPersen >= 100) return hpp;
  var harga = hpp / (1 - marginPersen / 100);
  return Math.round(harga / 100) * 100; // bulatkan ke ratusan terdekat
}

function prosesLihatSettingMargin(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var props = PropertiesService.getScriptProperties();
    result.success = true;
    result.marginDefault = parseFloat(props.getProperty('MARGIN_DEFAULT_PERSEN') || '30');
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesSimpanSettingMargin(data) {
  var result = { success: false };
  try {
    var staffPeminta = getStaffByEmail(data.email);
    if (!staffPeminta || staffPeminta.role !== 'Owner' || !staffPeminta.aktif) throw new Error('Cuma Owner yang bisa ubah setting margin.');
    var margin = parseFloat(data.marginDefault);
    if (isNaN(margin) || margin < 0 || margin >= 100) throw new Error('Margin harus antara 0-99%');
    PropertiesService.getScriptProperties().setProperty('MARGIN_DEFAULT_PERSEN', String(margin));
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesSimpanMarginCustomSku_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('SKU kosong');
    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var rowTarget = -1;
    for (var i = 0; i < vals.length; i++) { if (String(vals[i][0]).trim() === sku) { rowTarget = i + 2; break; } }
    if (rowTarget === -1) throw new Error('SKU tidak ditemukan');
    sh.getRange(rowTarget, 16).setValue(data.marginCustom === '' || data.marginCustom === null || data.marginCustom === undefined ? '' : parseFloat(data.marginCustom));
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Hitung ulang Harga Default - kalau sku dikasih, cuma 1 produk. Kalau kosong, SEMUA produk.
function prosesHitungUlangHargaDefault_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var props = PropertiesService.getScriptProperties();
    var marginGlobal = parseFloat(props.getProperty('MARGIN_DEFAULT_PERSEN') || '30');
    var skuTarget = String(data.sku || '').trim();

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    if (lastRow < 2) { result.success = true; result.jumlahDiupdate = 0; return result; }

    var vals = sh.getRange(2, 1, lastRow - 1, 16).getValues();
    var jumlahDiupdate = 0;
    for (var i = 0; i < vals.length; i++) {
      var sku = String(vals[i][0] || '').trim();
      if (!sku) continue;
      if (skuTarget && sku !== skuTarget) continue;

      var hpp = parseFloat(vals[i][3]) || 0;
      if (hpp <= 0) continue;
      var marginCustom = vals[i][15];
      var marginDipakai = (marginCustom !== '' && marginCustom !== null && !isNaN(parseFloat(marginCustom))) ? parseFloat(marginCustom) : marginGlobal;
      var hargaBaru = hitungHargaDariMargin(hpp, marginDipakai);

      sh.getRange(i + 2, 3).setValue(hargaBaru);
      jumlahDiupdate++;
      if (skuTarget && sku === skuTarget) result.hargaBaruSatuan = hargaBaru;
    }
    result.success = true;
    result.jumlahDiupdate = jumlahDiupdate;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   CHECKLIST INVOICE SUPPLIER KE STOCK - staff gudang cukup pilih invoice,
   lihat itemnya kayak cart, cocokkan jumlah, klik input ke stock (bukan manual satu2).
   ============================================================ */
function prosesLihatDetailInvoiceSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var noInvoiceSupplier = String(data.noInvoice || '').trim();
    if (!noInvoiceSupplier) throw new Error('No Invoice kosong');

    var sheets = getInvoiceSupplierSheets();
    var lastRowDetail = sheets.detail.getLastRow();
    var items = [];
    if (lastRowDetail > 1) {
      var valsDetail = sheets.detail.getRange(2, 1, lastRowDetail - 1, 6).getValues();
      valsDetail.forEach(function (row) {
        if (String(row[0]).trim() === noInvoiceSupplier) {
          items.push({ sku: row[1], nama: row[2], qty: parseFloat(row[3]) || 0, harga: parseFloat(row[4]) || 0, statusCocok: row[5] });
        }
      });
    }
    if (items.length === 0) throw new Error('Invoice tidak ditemukan atau belum ada item');

    result.success = true;
    result.items = items;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesInputChecklistKeStock(data) {
  var noInvoiceSupplier, skuDicentang;
  return withTransaction(data.email, 'mintaStock', ['pembelian', 'stok'], function () {
    var result = { success: false };
    var namaStaff = getNamaStaff(data.email);
    var sheets = getInvoiceSupplierSheets();
    var lastRowDetail = sheets.detail.getLastRow();
    var shLedger = getStockLedgerSheet(data.toko);
    var jumlahDiinput = 0;

    if (lastRowDetail > 1) {
      var valsDetail = sheets.detail.getRange(2, 1, lastRowDetail - 1, 6).getValues();
      for (var i = 0; i < valsDetail.length; i++) {
        if (String(valsDetail[i][0]).trim() !== noInvoiceSupplier) continue;
        var skuAsliInvoice = String(valsDetail[i][1]).trim();
        if (skuDicentang.indexOf(skuAsliInvoice) === -1) continue; // cuma yang dicentang

        var qty = parseFloat(valsDetail[i][3]) || 0;
        var hargaSatuan = parseFloat(valsDetail[i][4]) || 0;
        var skuJual = resolveSkuJual(skuAsliInvoice); // kalau ini SKU Supplier yang dipetakan, pakai SKU Jual-nya
        if (qty > 0) {
          shLedger.appendRow([new Date(), skuJual, 'Masuk', qty, 'Dari Invoice Supplier ' + noInvoiceSupplier + (skuJual !== skuAsliInvoice ? ' (SKU Supplier: ' + skuAsliInvoice + ')' : ''), namaStaff, data.toko || 'Waterground', hargaSatuan]);
          sheets.detail.getRange(i + 2, 6).setValue('Sudah Diinput ke Stock');
          jumlahDiinput++;
        }
      }
    }
    result.success = true;
    result.jumlahDiinput = jumlahDiinput;
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      noInvoiceSupplier = String(data.noInvoice || '').trim();
      skuDicentang = data.skuDicentang || []; // array SKU yang dicentang user buat diinput
      if (!noInvoiceSupplier || skuDicentang.length === 0) throw new Error('Nggak ada item yang dicentang');
    }
  });
}

