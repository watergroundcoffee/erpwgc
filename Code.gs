function agkMetrik_(produk) {
  var m = { total: produk.length, tanpaKategori: 0, tanpaFoto: 0, tanpaBrand: 0, tanpaHpp: 0, hargaRugi: 0, shopeeKosong: 0, tiktokKosong: 0, coretKurang: 0, namaBerantakan: 0, namaPanjang: 0, tanpaDesk: 0 };
  var contoh = {};
  function c(k, p) { m[k]++; (contoh[k] = contoh[k] || []).length < 8 && contoh[k].push(p.sku); }
  produk.forEach(function (p) {
    if (!p.kategori) c('tanpaKategori', p);
    if (!p.foto) c('tanpaFoto', p);
    if (!p.brand) c('tanpaBrand', p);
    if (!(p.hpp > 0)) c('tanpaHpp', p);
    if (p.hpp > 0 && ((p.shopee > 0 && p.shopee < p.hpp) || (p.tiktok > 0 && p.tiktok < p.hpp))) c('hargaRugi', p);
    if (!(p.shopee > 0)) c('shopeeKosong', p);
    if (!(p.tiktok > 0)) c('tiktokKosong', p);
    if ((p.coretS > 0 && p.shopee > 0 && p.coretS < p.shopee) || (p.coretT > 0 && p.tiktok > 0 && p.coretT < p.tiktok)) c('coretKurang', p);
    if (!p.desk) c('tanpaDesk', p);
