  var pct = function (k) { return m.total ? m[k] / m.total : 0; };
  m.skor = Math.max(0, Math.round(100 - (pct('tanpaKategori') * 20 + pct('tanpaFoto') * 15 + pct('tanpaHpp') * 20 + pct('hargaRugi') * 20 + pct('namaBerantakan') * 10 + pct('tanpaBrand') * 5 + pct('coretKurang') * 10) * 100 / 100));
  m.contoh = contoh;
