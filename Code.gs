    if (lastRow > 1 && query.length >= 2) {
      var values = sh.getRange(2, 1, lastRow - 1, 3).getValues();
      for (var i = 0; i < values.length; i++) {
        var nama = String(values[i][0] || '');
        var noHp = String(values[i][2] || '');
        if (nama.toLowerCase().indexOf(query) !== -1 || noHp.indexOf(query) !== -1) {
          hasil.push({ nama: nama, alamat: String(values[i][1] || ''), noHp: noHp });
          if (hasil.length >= 8) break;
        }
