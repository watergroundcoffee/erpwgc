    });
    var tersimpan = 0, terisi = 0;
    if (Object.keys(oke).length) tersimpan = spbSimpanLengkap_(oke);
    var lock = kunciModul_('penjualan');
    lock.waitLock(20000);
    try {
      if (Object.keys(oke).length) terisi = spbTulisKePesanan_(oke);
      var sh = getSpbAntreSheet_(), a = spbAntreBaca_(sh), kini = new Date();
      Object.keys(oke).forEach(function (sn) {
        var row = a.peta[sn];
        if (row) sh.getRange(row, 2, 1, 7).setValues([['', a.baris[row - 2][2], (Number(a.baris[row - 2][3]) || 0) + 1, 'Selesai', 0, 'Terbaca', kini]]);
      });
      Object.keys(gagal).forEach(function (sn) {
        var row = a.peta[sn];
        if (!row) return;
        var n = (Number(a.baris[row - 2][3]) || 0) + 1;
        sh.getRange(row, 4, 1, 4).setValues([[n, n >= SPB_ANTRE_MAKS_COBA_ ? 'Gagal' : 'Menunggu', 0, gagal[sn]]]);
        if (n >= SPB_ANTRE_MAKS_COBA_) labelOcrGagal.push({ sn: sn, catatan: 'OCR gagal 3x' }); // v2026.10.54: coba lewat label resmi
      });
