    Object.keys(stokKerja).forEach(function (k) {
      var b = peta[k];
      if (!b || !b.gramPer) return;
      var berubah = Math.abs((b.stokGram || 0) - stokKerja[k]) > 1e-9;
      if (!berubah) return;
      shB.getRange(b.row, 4).setValue(prod2Bulat_(stokKerja[k] / b.gramPer));
      if (diHasilkan[k]) shB.getRange(b.row, 5).setValue(Math.round(hargaKerja[k] * b.gramPer * 100) / 100);
      shB.getRange(b.row, 9).setValue(sekarang);
    });
    if (mutasi.length) { var shM = prod2Sheet_(PROD2_SH_MUTASI, PROD2_HDR_MUTASI, [2]); shM.getRange(shM.getLastRow() + 1, 1, mutasi.length, PROD2_HDR_MUTASI.length).setValues(mutasi); }
    var awal = shLog.getLastRow() + 1;
    shLog.getRange(awal, 1, logBaris.length, 1).setNumberFormat('@');
    shLog.getRange(awal, 1, logBaris.length, RST_HDR_LOG.length).setValues(logBaris);
    SpreadsheetApp.flush();
    result = { success: true, ringkas: ringkas, kejadian: (data.gantiTabung ? 1 : 0) + (data.servisMesin ? 1 : 0) };
    if (idp) cache.put('RST_ID_' + idp, JSON.stringify({ success: true, ringkas: ringkas, duplikat: true }), 600);
  } catch (err) { result.success = false; result.error = err.message || String(err); } finally { lepasKunci_(lock); }
  return result;
}

/* ---------- AKSI: rst_kemas - BAGI KOPI SETENGAH JADI KE KEMASAN (100 g / 150 g / 250 g ...) dalam 1 klik
   data = { skuSumber, baris:[{ sku, qty }], catatan, izinkanMinus, idPermintaan }
   - kopi sumber berkurang  qty x (gram + lebih isi)
   - bahan kemasan berkurang (pouch, valve, label ...) sesuai pengaturan per produk
   - stok produk jadi bertambah lewat Stock Ledger "Masuk" + Harga Modal Satuan = HPP per pcs
   - HPP per pcs = kopi + kemasan + biaya proses Kemas (per sesi dibagi rata per pcs, per kg, per pcs)
   - HPP Produk Master diperbarui otomatis (kecuali dimatikan / ditolak pengaman harga) */
function prosesRstKemas(data) {
  var cache = CacheService.getScriptCache(), idp = String(data.idPermintaan || '').trim();
  if (idp) { var sudah = cache.get('RST_KM_' + idp); if (sudah) return JSON.parse(sudah); }
  var lock = kunciModul_(['produksi', 'stok']);
  try { lock.waitLock(20000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  var result = { success: false };
  try {
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    var oleh = rstNamaOleh_(data.email), boleh = rstBolehHarga_(data.email);
    var semua = rstBacaBahan_(), peta = {};
    semua.forEach(function (b) { peta[b.sku.toUpperCase()] = b; });
    var src = peta[String(data.skuSumber || '').trim().toUpperCase()];
    if (!src || !src.gramPer) throw new Error('Pilih kopi sumber (setengah jadi) yang satuannya kg / gram.');
    var kemasan = {}, biaya = rstBacaBiaya_();
    rstBacaKemasan_().forEach(function (k) { kemasan[k.sku.toUpperCase()] = k; });
    var baris = (data.baris || []).map(function (x) { return { k: kemasan[String(x.sku || '').trim().toUpperCase()], qty: Math.round(prod2Num_(x.qty)) }; })
      .filter(function (x) { return x.qty > 0; });
    if (!baris.length) throw new Error('Isi jumlah kemasan yang dibuat (minimal 1 pcs).');
    baris.forEach(function (x) {
      if (!x.k) throw new Error('Ada produk kemasan yang belum diatur. Muat ulang halaman.');
      if (String(x.k.skuSumber).toUpperCase() !== src.sku.toUpperCase()) throw new Error(x.k.nama + ' bukan dari ' + src.nama + '.');
    });
    var kopiTotal = 0, pcsTotal = 0, kebutuhan = {};
    baris.forEach(function (x) {
      x.isi = x.k.gram + x.k.lebih; x.kopi = x.isi * x.qty; kopiTotal += x.kopi; pcsTotal += x.qty;
      x.k.bahanKemasan.forEach(function (bk) { var K = String(bk.sku).toUpperCase(); kebutuhan[K] = (kebutuhan[K] || 0) + bk.qty * x.qty; });
    });
    var kurang = [];
    if (src.stokGram + 1e-6 < kopiTotal) kurang.push(src.nama + ' butuh ' + Math.round(kopiTotal) + ' g, ada ' + Math.round(src.stokGram) + ' g');
    Object.keys(kebutuhan).forEach(function (K) {
      var b = peta[K];
      if (!b) throw new Error('Bahan kemasan ' + K + ' tidak ditemukan di Bahan Baku.');
      if (b.stok + 1e-6 < kebutuhan[K]) kurang.push(b.nama + ' butuh ' + prod2Bulat_(kebutuhan[K]) + ' ' + b.satuan + ', ada ' + prod2Bulat_(b.stok));
    });
    if (kurang.length && !data.izinkanMinus) throw new Error('Stok kurang: ' + kurang.join(' · ') + '.');

    var bpSesi = rstHitungBiaya_(biaya, 'Kemas', 1, 0, 0).total; // biaya per sesi, dibagi rata per pcs
    var tz = Session.getScriptTimeZone(), sekarang = new Date();
    var shK = rstSheet_(RST_SH_KLOG, RST_HDR_KLOG, [1, 3, 5]), nom = rstNoProses_(shK, 'KM', 1);
    var noKm = nom.awalan + ('0' + (nom.urut + 1)).slice(-2);
    var ledger = [], klog = [], hasil = [], mutasi = [];
    baris.forEach(function (x) {
      var kopiPcs = src.hargaGram * x.isi, kemPcs = 0;
      x.k.bahanKemasan.forEach(function (bk) { var b = peta[String(bk.sku).toUpperCase()]; kemPcs += (b.harga || 0) * bk.qty; });
      var bp = rstHitungBiaya_(biaya, 'Kemas', 0, x.isi / 1000, 1).total + (pcsTotal ? bpSesi / pcsTotal : 0);
      var hpp = Math.round(kopiPcs + kemPcs + bp);
      ledger.push([sekarang, x.k.sku, 'Masuk', x.qty, 'Hasil kemas ' + noKm + ' (' + src.nama + ' ' + x.k.gram + ' g x ' + x.qty + ')', oleh, '', hpp || '']);
      klog.push([noKm, sekarang, src.sku, src.nama, x.k.sku, x.k.nama, x.k.gram, x.qty, x.kopi, Math.round(kopiPcs), Math.round(kemPcs), Math.round(bp), hpp, oleh, String(data.catatan || '')]);
      hasil.push({ sku: x.k.sku, nama: x.k.nama, gram: x.k.gram, qty: x.qty, kopiGram: x.kopi, hpp: hpp, hppKopi: Math.round(kopiPcs), hppKemasan: Math.round(kemPcs), hppProses: Math.round(bp) });
    });
    // Stok bahan: kopi sumber + bahan kemasan
    var shB = prod2Sheet_(PROD2_SH_BAHAN, PROD2_HDR_BAHAN, [1]);
    var potong = function (b, qtySatuan) {
      b.stok = prod2Bulat_(b.stok - qtySatuan);
      shB.getRange(b.row, 4).setValue(b.stok); shB.getRange(b.row, 9).setValue(sekarang);
      mutasi.push([sekarang, b.sku, 'Pakai Produksi', -prod2Bulat_(qtySatuan), b.stok, 'Kemas ' + noKm, oleh]);
    };
    potong(src, kopiTotal / src.gramPer);
    Object.keys(kebutuhan).forEach(function (K) { potong(peta[K], kebutuhan[K]); });
    var shM = prod2Sheet_(PROD2_SH_MUTASI, PROD2_HDR_MUTASI, [2]);
    shM.getRange(shM.getLastRow() + 1, 1, mutasi.length, PROD2_HDR_MUTASI.length).setValues(mutasi);
    var shL = getStockLedgerSheet();
    shL.getRange(shL.getLastRow() + 1, 1, ledger.length, 8).setValues(ledger);
    var awal = shK.getLastRow() + 1;
    shK.getRange(awal, 1, klog.length, 1).setNumberFormat('@');
    shK.getRange(awal, 1, klog.length, RST_HDR_KLOG.length).setValues(klog);
    SpreadsheetApp.flush();
    try { smNaikkanVersiStok_(); } catch (eV) { }
    try { CacheService.getScriptCache().removeAll(['POSISI_STOCK_default__meta', 'POSISI_STOCK_default', 'POSISI_STOK_LENGKAP_default', SM_CACHE_MONITOR]); } catch (eC) { }

    // HPP Produk Master diperbarui otomatis (pengaman HPP > Harga Jual tetap berlaku)
    var hppDiperbarui = [], hppDitolak = [];
    if (data.perbaruiHpp !== false) hasil.forEach(function (h) {
      if (!(h.hpp > 0)) return;
      var izinLama = IZIN_SISTEM_;
      IZIN_SISTEM_ = true;
      try {
        var r = prosesSimpanHppManual_inti_({ email: data.email, sku: h.sku, hpp: h.hpp, toko: data.toko });
        if (r && r.success) hppDiperbarui.push(h.sku); else hppDitolak.push({ sku: h.sku, alasan: String((r && r.error) || '').replace(/^Error:\s*/, '') });
      } catch (eH) { hppDitolak.push({ sku: h.sku, alasan: eH.message || String(eH) }); } finally { IZIN_SISTEM_ = izinLama; }
    });
    result = { success: true, noKemas: noKm, sumber: src.nama, kopiTotal: kopiTotal, pcsTotal: pcsTotal, sisaGram: Math.max(0, Math.round(src.stok * src.gramPer)),
      hasil: hasil, hppDiperbarui: hppDiperbarui, hppDitolak: hppDitolak, dipaksa: kurang.length ? kurang : null };
    if (!boleh) { result.hasil.forEach(function (h) { delete h.hpp; delete h.hppKopi; delete h.hppKemasan; delete h.hppProses; }); result.hppDitolak = []; }
    if (idp) cache.put('RST_KM_' + idp, JSON.stringify({ success: true, noKemas: noKm, duplikat: true }), 600);
  } catch (err) { result.success = false; result.error = err.message || String(err); } finally { lepasKunci_(lock); }
  return result;
}

/* ---------- AKSI: rst_terapkan_hpp { sku, hpp } - simpan HPP ke Produk Master (dipakai Katalog > Harga & Laba Rugi) ---------- */
function prosesRstTerapkanHpp(data) {
  if (!rstBolehHarga_(data.email)) return { success: false, error: 'Hanya Owner / Admin Keuangan yang bisa mengubah HPP.' };
  var h = Math.round(prod2Num_(data.hpp));
  if (!(h > 0)) return { success: false, error: 'HPP belum bisa dihitung (isi harga green bean & bahan kemasan dulu).' };
  return prosesSimpanHppManual({ email: data.email, sku: data.sku, hpp: h, toko: data.toko });
}

/* ---------- AKSI: rst_impor_log { baris:[...] } - impor catatan roasting lama dari Excel (riwayat saja, stok tidak berubah) ---------- */
function prosesRstImporLog(data) {
  return withTransaction(data.email, null, ['produksi'], function () {
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    var r = rstImporBaris_(data.baris, rstNamaOleh_(data.email));
    return { success: true, ditambah: r.ditambah, dilewati: r.dilewati };
  }, { tungguMs: 20000, pesanSibuk: 'Sistem sibuk, coba lagi.' });
}

/* ---------- AKSI: rst_ubah_jenis { sku, kategori } - ubah JENIS barang produksi (hanya kolom Kategori, harga tidak tersentuh) ---------- */
function prosesRstUbahJenis(data) {
  return withTransaction(data.email, null, ['produksi'], function () {
    if (!prod2Izin_(data.email)) throw new Error('Anda tidak punya izin untuk modul Produksi.');
    var kat = String(data.kategori || '').trim();
    if (!(kat === RST_KAT_MENTAH || kat === RST_KAT_KEMASAN || /^Setengah Jadi [1-9]$/.test(kat))) throw new Error('Jenis barang tidak dikenal.');
    var b = prod2BacaBahan_().filter(function (x) { return x.sku.toUpperCase() === String(data.sku || '').trim().toUpperCase(); })[0];
    if (!b) throw new Error('Barang ' + data.sku + ' tidak ditemukan.');
    var sh = prod2Sheet_(PROD2_SH_BAHAN, PROD2_HDR_BAHAN, [1]);
    sh.getRange(b.row, 7).setValue(kat);
    sh.getRange(b.row, 9).setValue(new Date());
    return { success: true, sku: b.sku, kategori: kat };
  }, { tungguMs: 15000, pesanSibuk: 'Sistem sibuk, coba lagi.' });
}

/* =====================================================================================
   PAKET 22 (v2026.10.38) - SYNC ROASTERY DARI 1 FILE EXCEL
   Owner cukup upload 1 Excel:
     - tab "KOPI" (daftar SKU kopi per varian + harga green bean)  -> green bean (Bahan Mentah), roasted (Setengah Jadi 1),
       produk kemasan (SKU Produk Master <- roasted, gram per kemasan)
     - tab catatan roasting (kolom Varietas / Drum Input / Drum Output) bila ada -> riwayat roasting
   lalu SEMUA riwayat roasting (yang baru diimpor + yang sudah ada) dihubungkan ke green bean & roasted varian yang sama.
   Browser hanya membaca sel Excel (SheetJS) -> server menyusun rencana (rst_sync_analisa) -> Owner meninjau -> rst_sync_simpan.
   Aturan:
   - Produk Master TIDAK dibuat / diubah (SKU yang belum ada di Produk Master dilaporkan & dilewati).
   - Pengaturan produk kemasan yang sudah ada TIDAK ditimpa. Harga green bean dari Excel hanya dipakai bila harga di sistem masih 0.
   - Stok tidak berubah (riwayat saja). Nama varian di catatan roasting -> varian KOPI: otomatis bila mirip (skor >= 0,67), selain itu dipilih Owner;
     pilihan disimpan (Script Property RST_ALIAS_VARIAN) dan dipakai lagi di sync berikutnya.
   ===================================================================================== */
var RST_KUNCI_ALIAS_ = 'RST_ALIAS_VARIAN';
var RST_STOP_ = { green: 1, bean: 1, beans: 1, roasted: 1, kopi: 1, coffee: 1, gr: 1, gram: 1, g: 1, kg: 1, process: 1, proses: 1, biji: 1 };
var RST_GRAM_STANDAR_ = [100, 150, 200, 250, 500, 1000];
function rstToken_(s) {
  return String(s || '').toLowerCase().replace(/\d+(?:[.,]\d+)?\s*(?:gr|gram|g|kg)\b/g, ' ').split(/[^a-z0-9]+/)
    .filter(function (w) { return w && !RST_STOP_[w] && !/^\d+$/.test(w); });
}
function rstKunciVarian_(s) { return rstToken_(s).join(' '); }
function rstSkor_(a, b) {
  var A = {}, B = {}, n = 0, u = 0;
  a.forEach(function (w) { A[w] = 1; }); b.forEach(function (w) { B[w] = 1; });
  Object.keys(A).forEach(function (w) { u++; if (B[w]) n++; });
  Object.keys(B).forEach(function (w) { if (!A[w]) u++; });
  return u ? n / u : 0;
}
function rstStem_(nama) { return String(nama || '').replace(/\s+/g, ' ').replace(/\s*\d+(?:[.,]\d+)?\s*(?:gr|gram|g|kg)\b.*$/i, '').trim(); }
function rstGramNama_(nama) {
  var t = String(nama || ''), m = /(\d+(?:[.,]\d+)?)\s*kg\b/i.exec(t);
  if (m) return Math.round(parseFloat(m[1].replace(',', '.')) * 1000);
  m = /(\d{1,4})\s*(?:gr|gram|g)\b/i.exec(t);
  return m ? parseInt(m[1], 10) : 0;
}
function rstNamaNorm_(s) { return String(s || '').toLowerCase().replace(/\b(gram|gr)\b/g, 'g').replace(/(\d)\s+(g|kg)\b/g, '$1$2').replace(/\s+/g, ' ').trim(); }
function rstAngkaSel_(v) {
  if (typeof v === 'number') return isFinite(v) ? v : null;
  var s = String(v == null ? '' : v).trim();
  if (!s || /^#/.test(s)) return null;
  var n = parseFloat(s.replace(/[^\d.,-]/g, '').replace(/\.(?=\d{3}(\D|$))/g, '').replace(',', '.'));
  return isFinite(n) ? n : null;
}
function rstAliasBaca_() { return rstJson_(PropertiesService.getScriptProperties().getProperty(RST_KUNCI_ALIAS_), {}); }

/* Susun rencana sync (dipakai analisa & simpan - server tidak percaya hasil olahan browser) */
function rstSyncRencana_(data) {
  var baris = (data.kopi || []).slice(0, 3000), masalah = [];
  var master = prod2MasterRingkas_(), masterNama = {};
  Object.keys(master).forEach(function (k) { masterNama[rstNamaNorm_(master[k].nama)] = master[k]; });
  // 1) Baris produk (kolom A kategori, B SKU, C nama, D kg) & baris samping (H label, I nilai, J satuan/loss)
  var produk = [], samping = [];
  baris.forEach(function (r) {
    var nama = String(r.c || '').trim(), sku = String(r.b || '').trim().toUpperCase().replace(/\s+/g, '');
    var kg = rstAngkaSel_(r.d), gNama = rstGramNama_(nama);
    if (nama && (gNama || kg) && /arabica|arabika|robusta|blend|liberica|excelsa|kopi|coffee/i.test(String(r.a || '') + ' ' + nama))
      produk.push({ baris: r.baris, kategori: String(r.a || '').trim(), sku: /^[A-Z0-9][A-Z0-9._\-\/]{3,}$/.test(sku) ? sku : '', nama: nama, gramKolom: kg ? Math.round(kg * 1000) : 0, gramNama: gNama });
    var i = rstAngkaSel_(r.i);
    if (i !== null) samping.push({ baris: r.baris, h: String(r.h || '').trim(), i: i, j: rstAngkaSel_(r.j) });
  });
  // 2) Kelompokkan per varian (nama produk tanpa ukuran)
  var varian = {}, urut = [];
  produk.forEach(function (p) {
    var stem = rstStem_(p.nama), k = rstKunciVarian_(stem);
    if (!k) return;
    if (!varian[k]) { varian[k] = { kunci: k, nama: stem, kategori: p.kategori, produk: [], barisAwal: p.baris, barisAkhir: p.baris, hargaGreen: 0, loss: null }; urut.push(k); }
    var v = varian[k];
    v.barisAwal = Math.min(v.barisAwal, p.baris); v.barisAkhir = Math.max(v.barisAkhir, p.baris);
    // gram: kolom D vs nama; ambil yang termasuk ukuran standar bila beda
    var g = p.gramNama || p.gramKolom, catat = '';
    if (p.gramNama && p.gramKolom && p.gramNama !== p.gramKolom) {
      var sN = RST_GRAM_STANDAR_.indexOf(p.gramNama) >= 0, sK = RST_GRAM_STANDAR_.indexOf(p.gramKolom) >= 0;
      g = sK && !sN ? p.gramKolom : p.gramNama;
      catat = 'Isi beda: nama ' + p.gramNama + ' g, kolom kg ' + p.gramKolom + ' g -> dipakai ' + g + ' g';
    }
    v.produk.push({ baris: p.baris, sku: p.sku, nama: p.nama.replace(/\s+/g, ' '), gram: g, catatanGram: catat });
  });
  // 3) Harga green bean per varian dari blok samping di sekitar baris produknya
  urut.forEach(function (k) {
    var v = varian[k], dekat = samping.filter(function (s) { return s.baris >= v.barisAwal - 1 && s.baris <= v.barisAkhir + 2; });
    var pilih = dekat.filter(function (s) { return /green/i.test(s.h) && s.i > 1000; })[0]
      || dekat.filter(function (s) { return s.i > 1000 && s.j !== null && s.j > 0 && s.j < 1 && !/ongkos|penyusutan|total|resep/i.test(s.h); })[0];
    if (pilih) { v.hargaGreen = Math.round(pilih.i); if (pilih.j !== null && pilih.j > 0 && pilih.j < 1) v.loss = pilih.j; }
  });
  // 4) Cocokkan produk ke Produk Master + SKU dobel di Excel
  var skuDipakai = {};
  urut.forEach(function (k) { varian[k].produk.forEach(function (p) { if (p.sku) (skuDipakai[p.sku] = skuDipakai[p.sku] || []).push({ k: k, p: p }); }); });
  var kemasan = {};
  rstBacaKemasan_().forEach(function (x) { kemasan[x.sku.toUpperCase()] = x; });
  urut.forEach(function (k) {
    var v = varian[k], lihat = {};
    v.produk.forEach(function (p) {
      var m = p.sku ? master[p.sku] : null;
      if (!m) { var mn = masterNama[rstNamaNorm_(p.nama)]; if (mn) { m = mn; p.catatanSku = (p.sku ? 'SKU ' + p.sku + ' tidak ada di Produk Master; ' : 'Tanpa SKU di Excel; ') + 'cocok lewat nama -> ' + mn.sku; } }
      var dobel = p.sku && skuDipakai[p.sku] && skuDipakai[p.sku].some(function (x) { return x.k !== k; });
      if (dobel && m) {
        // SKU sama dipakai di beberapa varian: pakai varian yang namanya paling mirip nama di Produk Master
        var terbaik = skuDipakai[p.sku].map(function (x) { return { k: x.k, s: rstSkor_(rstToken_(m.nama), rstToken_(varian[x.k].nama)) }; }).sort(function (a, b) { return b.s - a.s; });
        if (terbaik[0].k !== k || (terbaik[1] && terbaik[1].s === terbaik[0].s)) { p.status = 'dobel'; p.ket = 'SKU ' + p.sku + ' juga dipakai varian lain di Excel - Produk Master: "' + m.nama + '"'; return; }
      }
      if (!m) { p.status = 'tidak_ada'; p.ket = p.sku ? 'SKU ' + p.sku + ' belum ada di Produk Master' : 'Tidak ada SKU & nama tidak ditemukan di Produk Master'; return; }
      if (lihat[m.sku.toUpperCase()]) { p.status = 'sama'; p.ket = 'Baris dobel di Excel'; return; }
      lihat[m.sku.toUpperCase()] = 1;
      p.skuMaster = m.sku; p.namaMaster = m.nama;
      if (!(p.gram > 0)) { p.status = 'gram'; p.ket = 'Isi gram tidak terbaca'; return; }
      var ada = kemasan[m.sku.toUpperCase()];
      p.status = ada ? 'sudah' : 'baru';
      if (ada) p.ket = 'Sudah terhubung (pengaturan lama dipertahankan)';
    });
  });
  // 5) Barang produksi: green bean & roasted per varian (pakai yang sudah ada bila cocok)
  var bahan = rstBacaBahan_();
  urut.forEach(function (k) {
    var v = varian[k], tok = rstToken_(v.nama);
    var lama = v.produk.filter(function (p) { return p.status === 'sudah'; }).map(function (p) { return kemasan[p.skuMaster.toUpperCase()]; })[0];
    var roasted = lama ? bahan.filter(function (b) { return b.sku.toUpperCase() === String(lama.skuSumber).toUpperCase(); })[0] : null;
    if (!roasted) roasted = bahan.filter(function (b) { return b.level >= 1 && rstSkor_(rstToken_(b.nama), tok) === 1; })[0] || null;
    var green = bahan.filter(function (b) { return b.level === 0 && rstSkor_(rstToken_(b.nama), tok) === 1; })[0] || null;
    v.green = green ? { sku: green.sku, nama: green.nama, harga: green.harga, ada: true } : { sku: '', nama: 'Green Bean ' + v.nama, harga: v.hargaGreen, ada: false };
