      if (rowPm && String(shPm.getRange(rowPm, 12).getValue() || '').trim() === 'Selesai' && String(shPm.getRange(rowPm, 11).getValue() || '').trim()) {
        shPm.getRange(rowPm, 12).setValue('Dikirim'); shPm.getRange(rowPm, 19).setValue(''); statusBaru = 'Dikirim';
        try { finInvalidasi_(); } catch (eF) { }
