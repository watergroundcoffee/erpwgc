    (saran && saran.length ? '<div style="text-align:left;margin:-8px 0 22px;padding:12px 14px;border-radius:12px;background:#f8fafc;border:1px solid #e2e8f0;">' +
      '<div style="font-size:12px;font-weight:700;color:#64748b;margin-bottom:6px;">' + (jenis === 'gagal' ? 'Yang bisa dicoba:' : 'Catatan:') + '</div>' +
