  }, {
    tungguMs: 15000,
    pesanTanpaIzin: 'Anda tidak punya izin mengonfirmasi pembayaran.',
    validasi: function () { noInvoice = String(data.noInvoice || '').trim(); if (!noInvoice) throw new Error('No Invoice kosong.'); }
  });
