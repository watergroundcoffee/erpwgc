/* ---------- Tarik saldo & mutasi marketplace ---------- */
function mkTiktokGet_(path, query) {
  var props = PropertiesService.getScriptProperties();
  var token = props.getProperty('TIKTOK_ACCESS_TOKEN'), cipher = props.getProperty('TIKTOK_SHOP_CIPHER');
  if (!token || !cipher) return { ok: false, pesan: 'TikTok Shop belum terhubung' };
  var p = { app_key: getTiktokAppKey(), timestamp: String(Math.floor(Date.now() / 1000)), shop_cipher: cipher };
  Object.keys(query || {}).forEach(function (k) { if (query[k] !== '' && query[k] !== undefined && query[k] !== null) p[k] = String(query[k]); });
  var sign = buatSignatureTikTok(path, p, '');
  var url = 'https://open-api.tiktokglobalshop.com' + path + '?' + Object.keys(p).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(p[k]); }).join('&') + '&sign=' + sign;
  var res = fetchHemat(url, { method: 'get', headers: { 'x-tts-access-token': token, 'content-type': 'application/json' }, muteHttpExceptions: true });
  var j = null; try { j = JSON.parse(res.getContentText()); } catch (e) { }
  if (!j) return { ok: false, pesan: 'Respons bukan JSON (' + res.getResponseCode() + ')' };
  return { ok: j.code === 0, pesan: j.code === 0 ? '' : (j.message || ('kode ' + j.code)), data: j.data || {} };
}
function mkNilai_(v) { if (v && typeof v === 'object') v = v.value !== undefined ? v.value : v.amount; var n = parseFloat(v); return isFinite(n) ? n : 0; }
function mkLogMp_(sumber, info) {
