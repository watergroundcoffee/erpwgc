      var dasar = awalan + '-' + nama.toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 24), sku = dasar, n = 1;
      while (skuAda[sku] || master[sku]) { n++; sku = dasar + '-' + n; }
