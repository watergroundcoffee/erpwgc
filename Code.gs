/* ---------- Katalog: SKU terlaris (Stock Ledger "Terjual ...") ---------- */
function hitungTerlarisPerSku_() {
  var now = Date.now(), b30 = now - 30 * 86400000, b90 = now - 90 * 86400000, peta = {}, sudah = {};
  ['Waterground', 'Conner Hardware'].forEach(function (toko) {
    try {
      var sh = getStockLedgerSheet(toko);
      if (sudah[sh.getName()]) return; sudah[sh.getName()] = true; // 2 toko bisa berbagi 1 sheet ledger
      var lr = sh.getLastRow(); if (lr < 2) return;
      sh.getRange(2, 1, lr - 1, 4).getValues().forEach(function (r) {
        var t = r[0], sku = String(r[1] || '').trim(), jenis = String(r[2] || ''), q = parseFloat(r[3]) || 0;
        if (!sku || jenis.indexOf('Terjual') !== 0 || !(t instanceof Date) || !(q > 0)) return;
        var ms = t.getTime(), x = peta[sku] = peta[sku] || [0, 0, 0, 0, 0]; // [qty30, qty90, qtySemua, transaksi30, terakhirMs]
        x[2] += q;
        if (ms >= b90) x[1] += q;
        if (ms >= b30) { x[0] += q; x[3]++; }
        if (ms > x[4]) x[4] = ms;
      });
    } catch (e) { }
