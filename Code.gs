  if (!sh) {
    sh = ss.insertSheet('Tugas Harian Selesai');
    sh.getRange(1, 1, 1, 3).setValues([['Tanggal', 'Kode Tugas', 'Diselesaikan Oleh']]);
    sh.getRange(1, 1, 1, 3).setFontWeight('bold');
  }
  return sh;
}

function prosesTandaiTugasSelesai(data) {
