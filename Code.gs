  var tanpaWaktu = JSON.stringify({ tugas: tugas, log: log, apiErr: apiErr });
  payload.versi = Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, tanpaWaktu)).slice(0, 22);
  return payload;
}
