    var baru = agpBulat_(s.hargaKanal * 0.93, 100), v = validatePriceSafety(s.sku, baru, pf);
    if (v.status !== 'OK' || v.marginPct < 20) return;
    temuan.push({ tingkat: 'sedang', judul: s.nama + ' turun ' + Math.abs(s.deltaPct || 0) + '% (harga tidak berubah)', detail: 'Terjual ' + s.qtyA + ' vs ' + s.qtyB + ' pcs. Margin ' + s.marginPct + '% masih tebal.' });
    rek.push({ prioritas: 'sedang', kategori: 'penjualan', judul: 'Turunkan harga ' + pf + ' ' + s.nama + ' 7% → ' + rp(baru), alasan: 'Penjualan turun padahal margin tebal; harga baru masih margin ' + v.marginPct + '%. (Cek dulu harga kompetitor.)',
      dampak: 'Uji 7 hari: target kembali ke ± ' + s.qtyB + ' pcs / ' + hari + ' hari', aksi: { tool_call: 'execute_action', action: 'UPDATE_PRICE', params: { sku: s.sku, new_price: baru, platform: pf } } });
  });
  // R4 Laris tapi margin tipis -> naikkan harga 5% (di bawah batas Auto-Pilot 15%)
  daftarSku.forEach(function (s) {
    if (rek.length >= 12 || !s.adaMaster || !(s.hargaKanal > 0) || s.marginPct === null) return;
    if (!(s.qtyA >= 5 && s.marginPct < 12 && (s.deltaPct === null || s.deltaPct >= -10))) return;
    if (s.hargaBerubah && s.hargaBerubah.naik) return;
    var pf = /tiktok|tokopedia|conner/i.test(s.kanalUtama) ? 'TikTok Shop' : 'Shopee';
    // Target margin bersih 15%, kenaikan dibatasi 5-15% (batas Auto-Pilot), dibulatkan ke Rp 500
    var grupR4 = agpGrupKanal_(s.kanalUtama), baru = Math.ceil(s.hargaKanal * 1.05 / 500) * 500;
    while (baru < s.hargaKanal * 1.15 && (baru - s.hpp - eksPotonganKomisi_(grupR4, baru).total) / baru < 0.15) baru += 500;
    if (baru > s.hargaKanal * 1.15) baru = Math.floor(s.hargaKanal * 1.15 / 500) * 500;
    if (baru <= s.hargaKanal) return;
    var v = validatePriceSafety(s.sku, baru, pf);
    if (v.status !== 'OK') return;
    var naikPct = Math.round((baru / s.hargaKanal - 1) * 100);
    var tambahLaba = (baru - s.hargaKanal) * s.qtyA * 0.9;
    rek.push({ prioritas: s.marginPct < 5 ? 'tinggi' : 'sedang', kategori: 'margin', judul: 'Naikkan harga ' + pf + ' ' + s.nama + ' ' + naikPct + '% → ' + rp(baru), alasan: 'Produk laris (' + s.qtyA + ' pcs/' + hari + ' hari) tapi margin hanya ' + s.marginPct + '%. Naik bertahap; pantau penjualan 7 hari.',
      dampak: '+ ± ' + rp(tambahLaba) + ' laba / ' + hari + ' hari (margin jadi ' + v.marginPct + '%)', aksi: { tool_call: 'execute_action', action: 'UPDATE_PRICE', params: { sku: s.sku, new_price: baru, platform: pf } } });
  });
  // R5 Data margin tidak lengkap
  var tanpaHpp = daftarSku.filter(function (s) { return s.adaMaster && !(s.hpp > 0) && (s.qtyA + s.qtyB) > 0; });
  if (tanpaHpp.length) temuan.push({ tingkat: 'sedang', judul: tanpaHpp.length + ' produk terjual belum punya Harga Modal (HPP)', detail: 'Margin & aksi harga tidak bisa dihitung: ' + tanpaHpp.slice(0, 8).map(function (s) { return s.nama || s.sku; }).join(', ') + (tanpaHpp.length > 8 ? ', …' : '') + '. Isi di Katalog > Harga.' });
  var rugi = daftarSku.filter(function (s) { return s.marginPct !== null && s.marginPct < 0 && (s.qtyA + s.qtyB) > 0; });
  if (rugi.length) temuan.push({ tingkat: 'tinggi', judul: rugi.length + ' produk dijual RUGI (di bawah HPP + komisi)', detail: rugi.slice(0, 8).map(function (s) { return s.nama + ' (' + s.marginPct + '%)'; }).join(', ') });
  var lepas = daftarSku.filter(function (s) { return !s.adaMaster && (s.qtyA + s.qtyB) > 0; });
  if (lepas.length) temuan.push({ tingkat: 'info', judul: lepas.length + ' SKU pesanan tidak terhubung ke Produk Master', detail: lepas.slice(0, 8).map(function (s) { return s.sku; }).join(', ') + ' - omzetnya ikut dihitung, margin tidak.' });
  // R6 Bundling pasangan yang sering dibeli bersama (naikkan nilai pesanan)
  if (tot.aovB > 0 && tot.aovA < tot.aovB * 0.95 || rek.length < 6) {
    var pp = Object.keys(pasangan).filter(function (k) { return pasangan[k] >= 3; }).sort(function (a, b) { return pasangan[b] - pasangan[a]; });
    for (var i = 0; i < pp.length; i++) {
      var dua = pp[i].split('+'), x = sku[dua[0]] || {}, y = sku[dua[1]] || {};
      if (!master[dua[0]] || !master[dua[1]] || !(x.marginPct >= 20) || !(y.marginPct >= 20)) continue;
      var mulai = new Date(sekarang.getTime() + 3600000), habis = new Date(sekarang.getTime() + 30 * HARI);
      var f = function (d) { return Utilities.formatDate(d, tz, 'yyyy-MM-dd HH:mm'); };
      rek.push({ prioritas: 'rendah', kategori: 'penjualan', judul: 'Paket bundling ' + (x.nama || dua[0]).slice(0, 24) + ' + ' + (y.nama || dua[1]).slice(0, 24) + ' (diskon 5%)', alasan: 'Dibeli bersama ' + pasangan[pp[i]] + 'x dalam 28 hari terakhir; kedua margin ≥ 20%.',
        dampak: 'Menaikkan nilai rata-rata pesanan (' + rp(tot.aovA) + ')', aksi: { tool_call: 'execute_action', action: 'CREATE_BUNDLE', params: { platform: 'Shopee', nama: ('Paket Hemat ' + (x.nama || '')).slice(0, 25), skus: [master[dua[0]].sku, master[dua[1]].sku], min_qty: 2, tipe: 'persen', nilai: 5, mulai: f(mulai), berakhir: f(habis) } } });
      break;
    }
  }
  var urutP = { tinggi: 0, sedang: 1, rendah: 2 };
  rek.sort(function (a, b) { return urutP[a.prioritas] - urutP[b.prioritas]; });
  rek.forEach(function (r, i) { r.id = 'agp-' + agpTgl_(sekarang).replace(/-/g, '') + '-' + hari + '-' + i + '-' + String(r.aksi.action).slice(0, 6); });
  var seri = Object.keys(harian).filter(function (t) { return t >= agpTgl_(new Date(seriMulai)); }).sort().map(function (t) { var h = harian[t]; return { t: t, omzet: Math.round(h.omzet), pesanan: h.pesanan, laba: Math.round(h.laba) }; });
  var dataKurang = [];
  if (tanpaRincian.n) dataKurang.push(tanpaRincian.n + ' pesanan tanpa rincian produk (' + rp(tanpaRincian.omzet) + ') - omzet dihitung, produknya tidak.');
  dataKurang.push('Data iklan, trafik/kunjungan toko & harga kompetitor belum masuk analisa ini.');
  Object.keys(tot).forEach(function (k) { if (/omzet|laba/.test(k)) tot[k] = Math.round(tot[k]); });
  return {
    dibuat: sekarang.getTime(), hari: hari,
    periode: { aDari: agpTgl_(new Date(aMulai)), aSampai: agpTgl_(new Date(aAkhir - 1)), bDari: agpTgl_(new Date(bMulai)), bSampai: agpTgl_(new Date(aMulai - 1)) },
    total: tot, kanal: Object.keys(kanal).map(function (k) { var x = kanal[k]; x.omzetA = Math.round(x.omzetA); x.omzetB = Math.round(x.omzetB); x.labaA = Math.round(x.labaA); x.labaB = Math.round(x.labaB); return x; }).sort(function (a, b) { return b.omzetA - a.omzetA; }),
    harian: seri, sku: daftarSku.slice(0, 60), temuan: temuan.slice(0, 14), rekomendasi: rek.slice(0, 12), dataKurang: dataKurang
  };
}

function agpNarasiAI_(h) {
  var ringkas = {
    periode: h.periode, total: h.total, kanal: h.kanal.slice(0, 6),
    produkTeratas: h.sku.slice(0, 15).map(function (s) { return { nama: s.nama, qtyA: s.qtyA, qtyB: s.qtyB, deltaPct: s.deltaPct, marginPct: s.marginPct, stok: s.stokStatus || 'aman', hargaBerubah: s.hargaBerubah || null }; }),
    temuan: h.temuan, rekomendasi: h.rekomendasi.map(function (r) { return { judul: r.judul, alasan: r.alasan, dampak: r.dampak }; })
  };
  var prompt = 'Kamu Agen Penjualan & Margin untuk toko Waterground Coffee (marketplace Shopee/TikTok/Tokopedia). Tujuan: menaikkan penjualan DAN margin.\n' +
    'Data berikut 100% dari ERP (periode A = ' + h.periode.aDari + ' s/d ' + h.periode.aSampai + ', B = periode sebelumnya). JANGAN mengarang angka lain.\n' +
    'Tulis dalam Bahasa Indonesia sederhana untuk Owner yang tidak paham akuntansi, maksimal 180 kata, format:\n' +
    '1) Kondisi toko (2 kalimat, angka utama). 2) 3 penyebab paling mungkin (tandai "dugaan" bila tidak terbukti data). 3) Urutan langkah minggu ini (merujuk judul rekomendasi yang ada, plus maksimal 2 langkah manual seperti cek harga kompetitor/iklan).\n\nDATA:\n' + JSON.stringify(ringkas);
  return String(panggilGeminiText(prompt, 'jaya') || '').trim().slice(0, 3000);
}


// ---------- Ongkir retur (DN-172826-154) ----------
// Dibebankan ke penjual  -> Jurnal Transaksi BEBAN "Beban Ongkir Retur" (mengurangi laba).
// Banding DISETUJUI      -> beban dibatalkan (status "Dihapus", jejak tetap ada) = jurnal penyesuaian balik.
// Banding ditolak / tidak diajukan -> beban tetap.
var P11_BANDING_ = ['Tidak diajukan', 'Diajukan', 'Disetujui', 'Ditolak'];
var P11_AKUN_ONGKIR_RETUR_ = 'Beban Ongkir Retur';
function p11JurnalOngkirRetur_(on, noResi, d, oleh, sekarang) {
  var shJ = getJurnalTransaksiSheet(), rowJ = parseInt(String(on.refJurnal).replace(/\D/g, ''), 10) || 0;
  var aktif = rowJ >= 2 && rowJ <= shJ.getLastRow() && String(shJ.getRange(rowJ, 4).getValue()).trim() === 'Masuk' && String(shJ.getRange(rowJ, 7).getValue()).trim() === 'Ongkir Retur';
  var perlu = on.nilai > 0 && on.banding !== 'Disetujui';
  var ket = 'Ongkir retur dibebankan ke penjual · resi ' + noResi + (d && d.idManual ? ' · pesanan ' + d.idManual : '') + ' · banding: ' + on.banding;
  if (perlu) {
    var akun = finPastikanAkunBeban_(P11_AKUN_ONGKIR_RETUR_);
    if (aktif) {
      if (Math.round(Number(shJ.getRange(rowJ, 5).getValue()) || 0) !== on.nilai) { shJ.getRange(rowJ, 5, 1, 2).setValues([[on.nilai, ket]]); finPatchBiaya_(rowJ, { tanggal: shJ.getRange(rowJ, 1).getValue(), akun: akun, jumlah: on.nilai, ket: ket, row: rowJ }); }
      else shJ.getRange(rowJ, 6).setValue(ket);
    } else {
      rowJ = shJ.getLastRow() + 1;
      shJ.getRange(rowJ, 1, 1, 8).setValues([[sekarang, akun, 'Beban', 'Masuk', on.nilai, ket, 'Ongkir Retur', '']]);
      finPatchBiaya_(0, { tanggal: sekarang, akun: akun, jumlah: on.nilai, ket: ket, row: rowJ });
      on.refJurnal = 'Jurnal baris ' + rowJ;
    }
    on.akuntansi = 'Beban Ongkir Retur ' + eksRp_(on.nilai) + (on.banding === 'Diajukan' ? ' (sementara - menunggu banding)' : '');
  } else {
    if (aktif) {
      shJ.getRange(rowJ, 4).setValue('Dihapus');
      shJ.getRange(rowJ, 6).setValue(String(shJ.getRange(rowJ, 6).getValue()) + ' [dibatalkan ' + Utilities.formatDate(sekarang, Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm') + ' oleh ' + oleh + ']');
      finPatchBiaya_(rowJ, null);
      on.refJurnal = on.refJurnal + ' (dibatalkan)';
    }
    on.akuntansi = on.nilai > 0 ? 'Banding disetujui - ongkir retur tidak jadi beban' : '';
  }
}

function prosesLihatPesananPending(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiKeluar')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    // Kumpulin semua No Resi yang UDAH discan (biar tau mana yang belum)
    var infoKeluar = getSheetInfo('keluar');
    var lastRowKeluar = infoKeluar.sheet.getLastRow();
    var sudahDiscanSet = {};
    if (lastRowKeluar > 1) {
      var valsKeluar = infoKeluar.sheet.getRange(2, 1, lastRowKeluar - 1, 11).getValues();
      valsKeluar.forEach(function (row) {
        if (String(row[10] || '').trim() !== 'Pending') { // yang beneran udah discan (bukan sekedar didaftar pending)
          sudahDiscanSet[kunciResi_(row[0])] = true;
        }
      });
    }

    var daftar = [];
    var tz = Session.getScriptTimeZone();

    // PO Sales: status kosong ('') = aktif/siap dikirim, harus punya No Resi diisi dulu (dari marketplace/kurir)
    var sheetsPesanan = getPesananManualSheets();
    var lastRowHeader = sheetsPesanan.header.getLastRow();
    if (lastRowHeader > 1) {
      var valsHeader = sheetsPesanan.header.getRange(2, 1, lastRowHeader - 1, 12).getValues();
      valsHeader.forEach(function (row) {
        var status = String(row[11] || '').trim();
        var noResi = String(row[10] || '').trim();
        if (status !== '' || !noResi) return; // cuma yang statusnya aktif DAN udah ada no resi (siap kirim)
        if (sudahDiscanSet[kunciResi_(noResi)]) return; // udah discan, nggak perlu muncul di pending lagi
        daftar.push({
          segmen: 'Offline (PO Sales)', noInvoice: row[0], noResi: noResi, pembeli: row[2],
          tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy') : '-'
        });
      });
    }

    // TikTok Shop: status AWAITING_SHIPMENT = udah "siap dikirim" di marketplace-nya
    var shTiktok = getPesananTikTokShopSheet();
    var lastRowTiktok = shTiktok.getLastRow();
    if (lastRowTiktok > 1) {
      var valsTiktok = shTiktok.getRange(2, 1, lastRowTiktok - 1, 8).getValues();
      valsTiktok.forEach(function (row) {
        var status = String(row[4] || '').trim();
        var noResi = resiTeks_(row[6], row[5]);
        if (status !== 'AWAITING_SHIPMENT' || !noResi) return;
        if (sudahDiscanSet[kunciResi_(noResi)]) return;
        daftar.push({
          segmen: 'Marketplace (TikTok Shop)', noInvoice: row[0], noResi: noResi, pembeli: row[7] || '(tersamar)',
          tanggal: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'dd MMM yyyy') : '-'
        });
      });
    }

    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   REFRESH ACCESS TOKEN TIKTOK SHOP - INI YANG SEBELUMNYA BELUM ADA.
   Access Token TikTok Shop ada masa berlakunya (biasanya ~7 hari) - kalau nggak
   di-refresh, semua sync bakal diam-diam gagal terus tanpa pemberitahuan jelas.
   ============================================================ */
function refreshTikTokAccessToken() {
  var result = { success: false };
  try {
    var props = PropertiesService.getScriptProperties();
    var refreshToken = props.getProperty('TIKTOK_REFRESH_TOKEN');
    if (!refreshToken) throw new Error('Belum ada Refresh Token tersimpan - perlu otorisasi ulang dari awal.');

    var url = 'https://auth.tiktok-shops.com/api/v2/token/refresh' +
      '?app_key=' + encodeURIComponent(getTiktokAppKey()) +
      '&app_secret=' + encodeURIComponent(getTiktokAppSecret()) +
      '&refresh_token=' + encodeURIComponent(refreshToken) +
      '&grant_type=refresh_token';

    var res = fetchHemat(url, { method: 'get', muteHttpExceptions: true });
    var data = JSON.parse(res.getContentText());

    if (!data.data || !data.data.access_token) {
      throw new Error('Gagal refresh token. Respons TikTok: ' + res.getContentText().substring(0, 300));
    }

    props.setProperty('TIKTOK_ACCESS_TOKEN', data.data.access_token);
    props.setProperty('TIKTOK_REFRESH_TOKEN', data.data.refresh_token);
    // PENTING: access_token_expire_in dari TikTok Shop itu TIMESTAMP ABSOLUT (detik epoch), BUKAN durasi -
    // jangan ditambah Date.now(), cukup dikonversi ke milidetik. (Bug lama ini yang bikin token dikira
    // valid sampai tahun 2083 padahal aslinya cuma ~7 hari, jadi auto-refresh nggak pernah kepicu.)
    props.setProperty('TIKTOK_TOKEN_EXPIRED_AT', String(data.data.access_token_expire_in * 1000));

    result.success = true;
    Logger.log('✅ Access Token TikTok Shop berhasil di-refresh, berlaku sampai ' + new Date(data.data.access_token_expire_in * 1000));
  } catch (err) {
    result.error = err.toString();
    Logger.log('❌ Gagal refresh Access Token TikTok Shop: ' + result.error);
  }
  return result;
}

// Cek apakah token perlu di-refresh SEBELUM benar-benar expired (kasih jeda aman 1 hari) - dipanggil
// otomatis tiap kali trigger sync jalan, biar nggak pernah sampai kejadian token expired lagi.
// Dikasih LOCK khusus di sini - soalnya sekarang ada 2 "pemicu" yang bisa manggil fungsi ini bersamaan
// (trigger otomatis tiap menit, DAN tombol "Refresh Pesanan" manual di web). Tanpa lock, kalau dua-duanya
// kebetulan nyaris bersamaan, bisa jadi race condition (dua-duanya minta token baru ke TikTok bersamaan,
// salah satu bisa gagal/ketimpa). Dengan lock: yang datang belakangan nunggu giliran, lalu cek ULANG
// dulu apakah token udah di-refresh sama proses sebelumnya sebelum ikut refresh lagi (biar nggak dobel).
function pastikanTokenTikTokMasihValid() {
  var props = PropertiesService.getScriptProperties();
  var SATU_HARI_MS = 24 * 60 * 60 * 1000;
  var expiredAt = parseInt(props.getProperty('TIKTOK_TOKEN_EXPIRED_AT') || '0', 10);
  if (expiredAt && (expiredAt - Date.now()) >= SATU_HARI_MS) return; // masih valid lama, nggak perlu antre lock sama sekali

  var lock = kunciModul_('token');
  try {
    lock.waitLock(10000);
  } catch (e) {
    Logger.log('⏳ Refresh token TikTok lagi ditangani proses lain, dilewati (aman - nggak perlu dobel).');
    return;
  }
  try {
    // Cek ULANG setelah dapat giliran - barangkali proses lain yang lagi antre bareng kita
    // barusan aja selesai refresh, jadi kita nggak perlu refresh lagi.
    expiredAt = parseInt(props.getProperty('TIKTOK_TOKEN_EXPIRED_AT') || '0', 10);
    if (!expiredAt || (expiredAt - Date.now()) < SATU_HARI_MS) refreshTikTokAccessToken();
  } finally {
    lock.releaseLock();
  }
}

