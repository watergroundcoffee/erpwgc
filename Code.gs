function prosesSemuaSaranAI(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var insight = [];
    var tugasSelesai = getDaftarTugasSelesaiHariIni();

    // Ambil data overview 7 hari terakhir (buat deteksi tren & angka umum)
    var sekarang = new Date();
    var tujuhHariLalu = new Date(sekarang);
    tujuhHariLalu.setDate(tujuhHariLalu.getDate() - 6);
    var tz = Session.getScriptTimeZone();
    var overview = prosesDashboardOverview({
      email: data.email,
      tanggalMulai: Utilities.formatDate(tujuhHariLalu, tz, 'yyyy-MM-dd'),
      tanggalAkhir: Utilities.formatDate(sekarang, tz, 'yyyy-MM-dd')
    });
    if (!overview.success) throw new Error(overview.error);

    if (overview.stockRendah.length > 0) {
      var top = overview.stockRendah[0];
      insight.push({
        halaman: ['overview', 'stock'], role: ['Owner', 'Admin Gudang'], kodeTugas: 'stock_rendah', tipe: 'warning',
        teks: overview.stockRendah.length + ' produk stoknya rendah (\u2264 5 unit), paling kritis: ' + top.nama + ' (sisa ' + top.stock + ').',
        aksi: 'Lihat Stock Rendah', aksiTipe: 'filter_rendah'
      });
    }

    if (overview.selisihInvoice > 0) {
      insight.push({
        halaman: ['overview', 'finance'], role: ['Owner'], kodeTugas: 'invoice_selisih', tipe: 'danger',
        teks: overview.selisihInvoice + ' invoice supplier ada selisih sama data stock masuk - perlu ditinjau.',
        aksi: null
      });
    }

    if (overview.resiPending > 0) {
      insight.push({
        halaman: ['overview'], role: ['Owner', 'Admin Gudang'], kodeTugas: 'resi_pending', tipe: 'warning',
        teks: overview.resiPending + ' resi masih berstatus Pending, belum kekirim.',
        aksi: null
      });
    }

    if (overview.trenHarian.length >= 2) {
      var kemarinData = overview.trenHarian[overview.trenHarian.length - 2].resi;
      var hariIniData = overview.trenHarian[overview.trenHarian.length - 1].resi;
      if (kemarinData > 0 && hariIniData < kemarinData * 0.5) {
        insight.push({ halaman: ['overview'], role: ['Owner'], kodeTugas: 'tren_resi_turun', tipe: 'info', teks: 'Resi keluar hari ini (' + hariIniData + ') jauh lebih sedikit dari kemarin (' + kemarinData + ').', aksi: null });
      }
    }

    // Stock: opname yang udah lama/belum pernah
    var shLedger2 = getStockLedgerSheet(data.toko);
    var lastRowLedger2 = shLedger2.getLastRow();
    if (lastRowLedger2 > 1) {
      var vals2 = shLedger2.getRange(2, 1, lastRowLedger2 - 1, 4).getValues();
      var shMaster2 = getMasterProdukSheet(data.toko);
      var namaMap2 = {};
      var lastRowMaster2 = shMaster2.getLastRow();
      if (lastRowMaster2 > 1) {
        var masterVals2 = shMaster2.getRange(2, 1, lastRowMaster2 - 1, 2).getValues();
        for (var m2 = 0; m2 < masterVals2.length; m2++) namaMap2[String(masterVals2[m2][0]).trim()] = String(masterVals2[m2][1] || '').trim();
      }
      var grouped2 = {};
      for (var i2 = 0; i2 < vals2.length; i2++) {
        var sku2 = String(vals2[i2][1] || '').trim();
        if (!sku2) continue;
        if (!grouped2[sku2]) grouped2[sku2] = [];
        grouped2[sku2].push({ tgl: vals2[i2][0], jenis: vals2[i2][2], qty: parseFloat(vals2[i2][3]) || 0 });
      }
      var belumOpnameLamaList = [];
      var msPerHari = 24 * 60 * 60 * 1000;
      Object.keys(grouped2).forEach(function (sku2) {
        var entries2 = grouped2[sku2];
        entries2.sort(function (a, b) { return a.tgl - b.tgl; });
        var tglOpnameTerakhir = null;
        for (var j2 = 0; j2 < entries2.length; j2++) {
          if (entries2[j2].jenis === 'Opname') tglOpnameTerakhir = entries2[j2].tgl;
        }
        var hariSejakOpname = tglOpnameTerakhir ? Math.floor((sekarang - tglOpnameTerakhir) / msPerHari) : null;
        if (hariSejakOpname === null || hariSejakOpname >= 30) {
          belumOpnameLamaList.push({ sku: sku2, nama: namaMap2[sku2] || sku2, hari: hariSejakOpname });
        }
      });
      if (belumOpnameLamaList.length > 0) {
        insight.push({ halaman: ['stock'], role: ['Owner', 'Admin Gudang'], kodeTugas: 'opname_lama', tipe: 'warning', teks: belumOpnameLamaList.length + ' SKU belum di-opname 30+ hari (atau belum pernah sama sekali) - akurasi datanya perlu dicek ulang.', aksi: 'Catat Stock', aksiTipe: 'buka_form' });
      }
    }

    // Pesanan TikTok Shop bernilai besar tapi belum ada data pembeli manual - layak dijadiin loyal customer
    var shTiktokPesanan = getPesananTikTokShopSheet();
    var lastRowTiktokPesanan = shTiktokPesanan.getLastRow();
    var AMBANG_PESANAN_BESAR = 300000; // Rp 300rb - bisa disesuaikan nanti kalau perlu jadi setting
    if (lastRowTiktokPesanan > 1) {
      var valsTiktokPesanan = shTiktokPesanan.getRange(2, 1, lastRowTiktokPesanan - 1, 11).getValues();
      var pesananBesarBelumDiisi = 0;
      valsTiktokPesanan.forEach(function (row) {
        var total = parseFloat(row[3]) || 0;
        var namaManual = String(row[10] || '').trim();
        if (total >= AMBANG_PESANAN_BESAR && !namaManual) pesananBesarBelumDiisi++;
      });
      if (pesananBesarBelumDiisi > 0) {
        insight.push({
          halaman: ['overview', 'pesanan'], role: ['Owner'], kodeTugas: 'tiktok_pesanan_besar', tipe: 'info',
          teks: pesananBesarBelumDiisi + ' pesanan TikTok Shop bernilai besar (\u2265 Rp ' + AMBANG_PESANAN_BESAR.toLocaleString('id-ID') + ') belum ada data pembelinya - layak dicoba dapetin kontaknya buat program loyalitas.',
          aksi: 'Lihat Pesanan TikTok Shop', aksiTipe: 'buka_pesanan_tiktok'
        });
      }
    }


    // Tandain mana yang UDAH diselesaikan hari ini (dari kodeTugas yang match)
    insight.forEach(function (item) {
      item.sudahSelesai = item.kodeTugas ? !!tugasSelesai[item.kodeTugas] : false;
    });

    if (insight.length === 0) {
      insight.push({ halaman: ['overview', 'stock', 'pesanan', 'finance', 'staff', 'promosi'], role: ['Owner', 'Admin Gudang'], kodeTugas: null, tipe: 'success', teks: 'Semua kelihatan normal - nggak ada yang butuh perhatian khusus saat ini.', aksi: null, sudahSelesai: false });
    }

    result.success = true;
    result.insight = insight;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

