/* ================= PRODUCT MANAGER · BUNDLING ================= */
var AGK_PASANGAN_ = [
  ['Grinder Kopi', 'Pembersih & Perawatan', 'Grinder + sikat pembersih: pembeli grinder hampir selalu butuh brush'],
  ['Pour Over & Dripper', 'Filter & Kertas Saring', 'Dripper + kertas filter yang ukurannya cocok: langsung bisa seduh'],
  ['Pour Over & Dripper', 'Server & Teko', 'Dripper + server: paket seduh manual lengkap'],
  ['Kettle', 'Pour Over & Dripper', 'Kettle leher angsa + dripper: starter kit pour over'],
