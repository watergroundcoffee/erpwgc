/* ============ COCOKKAN STATUS (30 hari) ============ */
function cocokkanStatus() {
  hapusDuplikat();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const shResi = ss.getSheetByName('Resi Keluar');
  const shMutasi = ss.getSheetByName('Import Mutasi Kas');
  const shRetur = ss.getSheetByName('Retur & Komplain');

  const dataResi = shResi.getDataRange().getValues();
  const dataMutasi = shMutasi.getDataRange().getValues();
  const dataRetur = shRetur.getDataRange().getValues();

  const resiLunas = new Set();
  for (let i = 1; i < dataMutasi.length; i++) {
    const noResi = String(dataMutasi[i][1] || '').trim();
    if (noResi) resiLunas.add(noResi);
  }

  const resiRetur = new Set();
  for (let i = 1; i < dataRetur.length; i++) {
    const noResi = String(dataRetur[i][0] || '').trim();
    if (noResi) resiRetur.add(noResi);
  }

  const today = new Date();
  let jumlahLunas = 0, jumlahRetur = 0, jumlahMenunggu = 0, jumlahOverdue = 0;

  for (let i = 1; i < dataResi.length; i++) {
    const noResi = String(dataResi[i][0] || '').trim();
    const noInvoice = String(dataResi[i][1] || '').trim();
    const tglKirim = dataResi[i][2];
    if (!noResi || !tglKirim) continue;

    let status = '';
    if (resiLunas.has(noResi) || resiLunas.has(noInvoice)) {
      status = 'Lunas';
      jumlahLunas++;
    } else if (resiRetur.has(noResi)) {
      status = 'Retur/Komplain';
      jumlahRetur++;
    } else {
      const tglKirimDate = new Date(tglKirim);
      const selisihHari = Math.floor((today - tglKirimDate) / (1000 * 60 * 60 * 24));
      if (selisihHari > 30) {
        status = 'OVERDUE';
        jumlahOverdue++;
      } else {
        status = 'Menunggu (masih 30 hari)';
        jumlahMenunggu++;
      }
    }

    shResi.getRange(i + 1, 7).setValue(status);
    shResi.getRange(i + 1, 8).setValue(today);
  }

  updateDashboard(ss, jumlahLunas, jumlahRetur, jumlahMenunggu, jumlahOverdue);
  SpreadsheetApp.getUi().alert('Selesai! Status semua resi sudah diperbarui.');
}

function updateDashboard(ss, lunas, retur, menunggu, overdue) {
  const sh = ss.getSheetByName('Dashboard');
  sh.clear();
  sh.getRange(1, 1, 6, 2).setValues([
    ['Ringkasan Status Resi', ''],
    ['Terakhir update:', new Date()],
    ['Lunas', lunas],
    ['Retur/Komplain', retur],
    ['Menunggu (masih 30 hari)', menunggu],
    ['OVERDUE (perlu ditindaklanjuti)', overdue]
  ]);
  sh.getRange(1, 1, 1, 2).setFontWeight('bold');
  sh.getRange(6, 1, 1, 2).setFontColor('#cc0000').setFontWeight('bold');
  sh.autoResizeColumns(1, 2);
}

function buatTriggerHarian() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(t => {
    if (t.getHandlerFunction() === 'cocokkanStatus') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('cocokkanStatus').timeBased().everyDays(1).atHour(7).create();
  SpreadsheetApp.getUi().alert('Auto-update harian jam 7 pagi sudah aktif.');
}

/* ============ HAPUS DUPLIKAT (jaring pengaman) ============ */
function hapusDuplikat() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetNames = ['Resi Keluar', 'Retur & Komplain', 'Pembelian Stock Masuk'];
  let totalDihapus = 0;

  sheetNames.forEach(function (name) {
    const sh = ss.getSheetByName(name);
    if (!sh) return;
    const lastRow = sh.getLastRow();
    if (lastRow < 3) return;

    const data = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    const seen = {};
    const rowsToDelete = [];

    for (let i = 0; i < data.length; i++) {
      const key = String(data[i][0]).trim().toUpperCase();
      if (!key) continue;
      if (seen[key]) {
        rowsToDelete.push(i + 2);
      } else {
        seen[key] = true;
      }
    }
    for (let j = rowsToDelete.length - 1; j >= 0; j--) {
      sh.deleteRow(rowsToDelete[j]);
      totalDihapus++;
    }
  });
  return totalDihapus;
}

function hapusDuplikatManual() {
  const jumlah = hapusDuplikat();
  SpreadsheetApp.getUi().alert(
    jumlah > 0 ? 'Selesai! ' + jumlah + ' baris duplikat sudah dihapus.' : 'Tidak ada data duplikat ditemukan.'
  );
}

function buatTriggerHapusDuplikat() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(t => {
    if (t.getHandlerFunction() === 'hapusDuplikat') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('hapusDuplikat').timeBased().everyMinutes(15).create();
  SpreadsheetApp.getUi().alert('Auto-hapus duplikat setiap 15 menit sudah aktif.');
}

/* ============ AUTO ISI TANGGAL KIRIM (input manual di sheet) ============ */
function onEdit(e) {
  const sheet = e.source.getActiveSheet();
  if (sheet.getName() !== 'Resi Keluar') return;
  const range = e.range;
  const col = range.getColumn();
  const row = range.getRow();
  if (col === 1 && row > 1) {
    const noResi = range.getValue();
    const tglCell = sheet.getRange(row, 3);
    if (noResi && !tglCell.getValue()) {
      tglCell.setValue(new Date());
    }
  }
}

/* ============================================================
   API untuk halaman Scan (dipanggil dari file HTML terpisah)
   Semua request POST, dibedakan lewat field "aksi"
   ============================================================ */
// Menerima redirect dari Shopee / TikTok Shop setelah seller menyetujui (atau menolak) otorisasi.
// Web App ini = Redirect URI (Callback Handler) OAuth untuk SEMUA toko & platform (multi-tenant).
//   Shopee:  ?shopee=1&state=<nonce>&code=...&shop_id=...
//   TikTok:  ?code=...&state=<nonce>  (+ app_key, locale, shop_region kalau dikirim platform)
//            ?code=... TANPA state = seller memberi izin langsung dari link Partner Center / App Store
//            (bukan dari tombol Hubungkan di dasbor) -> tetap diterima, toko dicocokkan lewat Shop ID.
function doGet(e) {
  var p = (e && e.parameter) || {};
  var sesi = null;
  try {
    var code = String(p.code || p.auth_code || '').trim();
    var errPlatform = String(p.error || p.error_code || p.errcode || p.errmsg || p.error_description || '').trim();

    // 0) Dibuka langsung tanpa parameter OAuth apa pun
    if (!code && !p.state && !errPlatform) {
      return halamanHasilOAuth_('info', 'OmniAI - Otorisasi Marketplace',
        'Halaman ini khusus untuk proses otorisasi toko. Mulai dari dasbor OmniAI: Pengaturan > Otorisasi Marketplace.');
    }

    // 1) Validasi state (anti-CSRF). State yang DIKIRIM tapi tidak valid = selalu ditolak.
    if (p.state) {
      sesi = oauthAmbilState_(p.state);
      if (!sesi) {
        return halamanHasilOAuth_('gagal', 'Sesi otorisasi tidak valid',
          'Link otorisasi sudah kedaluwarsa (lebih dari ' + Math.round(OAUTH_STATE_TTL_DETIK / 60) + ' menit), sudah pernah dipakai, atau tidak dibuat dari dasbor OmniAI.',
          ['Tutup halaman ini, lalu tekan Hubungkan / Sambungkan Ulang lagi di dasbor.', 'Selesaikan login dalam 15 menit setelah link dibuka.']);
      }
    }

    // 2) Seller menolak / platform mengembalikan error (tanpa code)
    if (errPlatform || !code) {
      var pesanTolak = oauthPesanPenolakan_(p);
      if (sesi) oauthCatatGagal_(sesi.idKoneksi, pesanTolak);
      return halamanHasilOAuth_('gagal', 'Otorisasi dibatalkan', pesanTolak,
        ['Kalau tidak sengaja, ulangi dari tombol Hubungkan di dasbor lalu tekan "Authorize/Izinkan".',
         'Pastikan login memakai akun Seller Center pemilik toko (bukan akun TikTok pribadi).']);
    }

    // 3) Tentukan platform
    var platform = sesi ? sesi.platform : (p.shopee ? 'shopee' : 'tiktok');
    if (platform === 'shopee' && !sesi) {
      return halamanHasilOAuth_('gagal', 'Sesi otorisasi tidak ditemukan', 'Otorisasi Shopee wajib dimulai dari tombol Hubungkan di dasbor OmniAI.');
    }
    if (platform === 'tiktok') {
      var adaAppKhusus = (sesi && sesi.slot && tiktokAppSendiriTersedia_(sesi.slot)) || (!sesi && p.app_key && tiktokCariSlotAppSendiri_(String(p.app_key)));
      if (!adaAppKhusus && !masterSiap_('tiktok')) {
        throw new Error('Aplikasi master TikTok Shop belum lengkap. Script Property yang kosong: ' + masterKurang_('tiktok').join(', '));
      }
      // Kode ini diterbitkan untuk aplikasi lain -> pasti gagal ditukar.
      // Yang SAH: app master OmniAI, atau "app khusus toko" (Seller in-house) yang dipasang di slot toko itu sendiri.
      var appKeyHarapan = sesi && sesi.slot ? tiktokAppUntukOtorisasi_(sesi.slot).appKey : null;
      var slotAppSendiri = p.app_key ? tiktokCariSlotAppSendiri_(String(p.app_key)) : '';
      if (p.app_key && String(p.app_key) !== (appKeyHarapan || getTiktokAppKey()) && !(!sesi && slotAppSendiri)) {
        var pesanApp = 'Kode otorisasi ini diterbitkan untuk aplikasi lain (app_key ' + String(p.app_key).slice(0, 6) + '...), bukan aplikasi yang dipakai koneksi ini. ' +
          'Gunakan link otorisasi dari dasbor OmniAI (jalankan diagnosaOtorisasiTikTok() di editor untuk melihat app mana yang aktif).';
        if (sesi) oauthCatatGagal_(sesi.idKoneksi, pesanApp);
        return halamanHasilOAuth_('gagal', 'Aplikasi tidak cocok', pesanApp);
      }
      if (!sesi && slotAppSendiri) {
        // Otorisasi langsung dari link app khusus toko (mis. app in-house Conner) -> slotnya pasti toko itu
        var kSlot = oauthBacaRegistri_().filter(function (k) { return k.platform === 'tiktok' && k.slot === slotAppSendiri; })[0];
        if (kSlot) sesi = { idKoneksi: kSlot.idKoneksi, tokoId: kSlot.tokoId, tokoNama: kSlot.tokoNama, platform: 'tiktok', slot: kSlot.slot, email: 'Otorisasi langsung (app khusus toko)' };
      }
      if (!sesi) sesi = { mode: 'tanpa-state', platform: 'tiktok', email: 'Otorisasi langsung (tanpa dasbor)' };
    }

    // 4) Tukar code -> token (kredensial MASTER)
    var hasil = platform === 'shopee' ? oauthTukarTokenShopee_(code, p.shop_id, sesi) : oauthTukarTokenTikTok_(code, sesi, p);
    if (!hasil.success) {
      if (sesi && sesi.idKoneksi) oauthCatatGagal_(sesi.idKoneksi, hasil.error);
      Logger.log('❌ OAuth ' + platform + ' gagal (' + ((sesi && sesi.idKoneksi) || 'tanpa-state') + '): ' + hasil.error);
      return halamanHasilOAuth_('gagal', 'Otorisasi gagal', hasil.error, hasil.saran || oauthSaranUmum_(platform));
    }
    oauthHapusGagal_(hasil.idKoneksi || (sesi && sesi.idKoneksi));

    if (hasil.menungguPersetujuan) {
      return halamanHasilOAuth_('info', 'Otorisasi diterima',
        'Toko ' + (hasil.namaTokoMarketplace || '') + ' sudah memberi izin ke OmniAI dan dicatat sebagai koneksi baru berstatus "Menunggu Persetujuan". ' +
        'Owner OmniAI akan melihatnya di Pengaturan > Otorisasi Marketplace. Silakan tutup halaman ini.');
    }
    return halamanHasilOAuth_('berhasil', 'Otorisasi Berhasil',
      'Toko ' + (hasil.tokoNama || sesi.tokoNama) + ' sudah terhubung ke ' + OAUTH_NAMA_PLATFORM[platform] + (hasil.namaTokoMarketplace ? ' (' + hasil.namaTokoMarketplace + ')' : '') +
      '. Silakan tutup halaman ini dan refresh dasbor Anda.', hasil.peringatan || null);
  } catch (err) {
    Logger.log('❌ doGet OAuth error: ' + err);
    if (sesi && sesi.idKoneksi) oauthCatatGagal_(sesi.idKoneksi, err.toString());
    return halamanHasilOAuth_('gagal', 'Terjadi kesalahan', err.toString(), ['Coba ulangi dari dasbor. Kalau terus terjadi, kirim tangkapan layar halaman ini lewat menu Hubungi Dev.']);
  }
}

// Pesan ramah untuk callback tanpa code (ditolak / dibatalkan / error platform)
function oauthPesanPenolakan_(p) {
  var mentah = String(p.error_description || p.errmsg || p.message || p.error || p.error_code || p.errcode || '').trim();
  if (oauthPolaTokoSendiri_(mentah)) return OAUTH_PESAN_TOKO_SENDIRI;
  if (/denied|cancel|reject|refus/i.test(mentah)) return 'Akses ditolak di halaman otorisasi platform (tombol Izinkan/Authorize tidak ditekan).';
  if (mentah) return 'Platform mengembalikan error: ' + mentah.slice(0, 200);
  return 'Platform tidak mengirim kode otorisasi. Kemungkinan halaman ditutup atau akses ditolak sebelum selesai.';
}

