// INTI FITUR: Cetak Label - otomatis potong Bahan Baku (sesuai resep) DAN tambah stock
// SKU jual yang siap dijual di Waterground Coffee. Dipanggil SEBELUM print dijalankan di browser.
function prosesCetakLabelDanPotongStock(data) {
  var sku, jumlahLabel;
  return withTransaction(data.email, 'mintaStock', 'stok', function () {
    var result = { success: false };
    // Ambil ukuran (gram) dari Katalog Kopi buat SKU ini
    var shKatalog = getKatalogKopiSheet();
    var lastRowKatalog = shKatalog.getLastRow();
    var ukuranGram = 0;
    if (lastRowKatalog > 1) {
      var valsKatalog = shKatalog.getRange(2, 1, lastRowKatalog - 1, 4).getValues();
      for (var k = 0; k < valsKatalog.length; k++) {
        if (String(valsKatalog[k][3]).trim() === sku) { ukuranGram = parseFloat(valsKatalog[k][2]) || 0; break; }
      }
    }
    if (ukuranGram <= 0) throw new Error('SKU ini belum terdaftar di Katalog Kopi - atur dulu ukurannya di situ.');

    // Ambil resep (bahan baku + persentase susut) buat SKU ini
    var shResep = getResepProduksiSheet();
    var lastRowResep = shResep.getLastRow();
    var resep = [];
    if (lastRowResep > 1) {
      var valsResep = shResep.getRange(2, 1, lastRowResep - 1, 3).getValues();
      valsResep.forEach(function (row) {
        if (String(row[0]).trim() === sku) resep.push({ namaBahan: row[1], persentaseSusut: parseFloat(row[2]) || 0 });
      });
    }
    if (resep.length === 0) throw new Error('SKU ini belum ada resepnya - atur dulu di Resep Produksi.');

    // Cek & potong Bahan Baku - kebutuhan dihitung dari ukuran + susut, GAGALKAN semuanya kalau ada yang kurang
    var shBahan = getBahanBakuRoasterySheet();
    var lastRowBahan = shBahan.getLastRow();
    var valsBahan = lastRowBahan > 1 ? shBahan.getRange(2, 1, lastRowBahan - 1, 2).getValues() : [];
    var rencanaPotong = [];
    var ringkasanKebutuhan = [];
    for (var r = 0; r < resep.length; r++) {
      // Rumus: kalau mau hasil X gram jadi, dan ada susut Y%, butuh bahan mentah = X / (1 - Y/100)
      var beratPerUnitDenganSusut = resep[r].persentaseSusut > 0 ? (ukuranGram / (1 - resep[r].persentaseSusut / 100)) : ukuranGram;
      var kebutuhan = beratPerUnitDenganSusut * jumlahLabel;
      var rowBahanKetemu = -1, stockBahanSaatIni = 0;
      for (var b = 0; b < valsBahan.length; b++) {
        if (String(valsBahan[b][0]).trim() === resep[r].namaBahan) { rowBahanKetemu = b + 2; stockBahanSaatIni = parseFloat(valsBahan[b][1]) || 0; break; }
      }
      if (rowBahanKetemu === -1) throw new Error('Bahan baku "' + resep[r].namaBahan + '" nggak ketemu.');
      if (stockBahanSaatIni < kebutuhan) throw new Error('Stock "' + resep[r].namaBahan + '" nggak cukup (butuh ' + Math.round(kebutuhan) + 'gr, tersisa ' + stockBahanSaatIni + 'gr)');
      rencanaPotong.push({ row: rowBahanKetemu, stockBaru: stockBahanSaatIni - kebutuhan });
      ringkasanKebutuhan.push(resep[r].namaBahan + ': ' + Math.round(kebutuhan) + 'gr');
    }
    // Semua bahan cukup - baru dieksekusi potongnya
    rencanaPotong.forEach(function (p) { shBahan.getRange(p.row, 2).setValue(p.stockBaru); });

    // Tambah stock SKU jual (biar siap dijual di Waterground Coffee)
    var shLedger = getStockLedgerSheet();
    shLedger.appendRow([new Date(), sku, 'Masuk', jumlahLabel, 'Hasil produksi Roastery (' + jumlahLabel + ' label dicetak, ' + ringkasanKebutuhan.join(', ') + ')', getNamaStaff(data.email), 'Waterground', 0]);

    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      sku = String(data.sku || '').trim();
      jumlahLabel = parseInt(data.jumlahLabel, 10);
      if (!sku) throw new Error('SKU kosong');
      if (!jumlahLabel || jumlahLabel <= 0) throw new Error('Jumlah label nggak valid');
    }
  });
}

/* ============================================================
   KATALOG KOPI - Jenis/Varian/Ukuran yang dikelola terpisah dari halaman
   Cetak Label. Cetak Label cuma MEMILIH dari daftar ini, nggak bisa nambah.
   ============================================================ */
function getKatalogKopiSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Katalog Kopi');
  if (!sh) {
    sh = ss.insertSheet('Katalog Kopi');
    sh.getRange(1, 1, 1, 4).setValues([['Jenis Kopi', 'Varian', 'Ukuran (gram)', 'SKU']]);
    sh.getRange(1, 1, 1, 4).setFontWeight('bold');
  }
  return sh;
}

function prosesLihatKatalogKopi(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getKatalogKopiSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 4).getValues();
      vals.forEach(function (row, idx) {
        if (!String(row[0]).trim()) return;
        daftar.push({ row: idx + 2, jenisKopi: row[0], varian: row[1], ukuran: parseFloat(row[2]) || 0, sku: row[3] });
      });
    }
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesTambahKatalogKopi(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var jenisKopi = String(data.jenisKopi || '').trim();
    var varian = String(data.varian || '').trim();
    var ukuran = parseFloat(data.ukuran);
    var sku = String(data.sku || '').trim();
    if (!jenisKopi || !varian || !sku) throw new Error('Jenis Kopi, Varian, dan SKU harus diisi');
    if (isNaN(ukuran) || ukuran <= 0) throw new Error('Ukuran nggak valid');

    var sh = getKatalogKopiSheet();
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 4).getValues();
      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][0]).trim() === jenisKopi && String(vals[i][1]).trim() === varian && parseFloat(vals[i][2]) === ukuran) {
          throw new Error('Kombinasi Jenis+Varian+Ukuran ini udah ada');
        }
      }
    }
    sh.appendRow([jenisKopi, varian, ukuran, sku]);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesHapusKatalogKopi(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var row = parseInt(data.row, 10);
    if (!row || row < 2) throw new Error('Baris nggak valid');
    getKatalogKopiSheet().deleteRow(row);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}


/* =====================================================================================
   PENJAGA KUOTA URLFETCH (fix "Service invoked too many times for one day: urlfetch")
   -------------------------------------------------------------------------------------
   Kuota UrlFetchApp dihitung PER AKUN Google untuk SEMUA pemanggilan API (Shopee, TikTok,
   Conner, Gemini, supplier, dll) - bukan per fitur. Akun gmail biasa: 20.000/hari,
   Google Workspace: 100.000/hari. Modul ini:
     1) Menghitung pemakaian harian per endpoint  -> jalankan lihatPemakaianUrlFetchHariIni()
     2) Rem darurat: begitu Google bilang kuota habis, semua fetch berikutnya langsung ditolak
        selama 1 jam (bukan terus mencoba & bikin error menumpuk tiap 5 menit).
     3) Kalau pemakaian hari ini sudah >= UF_BATAS_AMAN_HARIAN, tugas yang TIDAK kritis
        (cek resi cadangan, cek status pesanan lama, virtual stock massal, retur) otomatis ditunda.
   ===================================================================================== */
var UF_BATAS_AMAN_HARIAN = 15000;           // sisakan ruang dari batas 20.000/hari (akun gmail biasa)
var UF_KUNCI_HABIS = 'UF_KUOTA_HABIS';
var TRACKING_FALLBACK_MAKS_PER_JALAN = 10;  // maks panggilan "ambil resi satu-satu" per 1x sync
var TRACKING_JEDA_PER_ORDER_DETIK = 3600;   // 1 pesanan maksimal dicek resinya 1x per jam
var STATUS_AKTIF_JEDA_DETIK = 15 * 60;      // cek ulang status pesanan aktif maks 1x per 15 menit (dari trigger)
var STATUS_AKTIF_MAKS_UMUR_HARI = 30;       // pesanan "nyangkut" > 30 hari nggak dicek ulang tiap sync
var MAKS_BATCH_STATUS_PER_JALAN = 10;       // maks panggilan batch cek status per 1x sync

function ufKunciHariIni() {
  return 'UF_HITUNG_' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMdd');
}

function ufLabelEndpoint(url) {
  var tanpaQuery = String(url || '').split('?')[0].replace(/^https?:\/\//i, '');
  return tanpaQuery.replace(/\/[A-Za-z0-9_-]*\d{5,}[A-Za-z0-9_-]*/g, '/:id').substring(0, 90);
}

function ufCatatPemakaian(url) {
  try {
    var cache = CacheService.getScriptCache();
    var kunci = ufKunciHariIni();
    var data = JSON.parse(cache.get(kunci) || '{}');
    var label = ufLabelEndpoint(url);
    data._total = (data._total || 0) + 1;
    data[label] = (data[label] || 0) + 1;
    cache.put(kunci, JSON.stringify(data), 21600); // tiap put memperpanjang umur cache, jadi hitungan tahan seharian
  } catch (e) { /* pencatatan gagal nggak boleh gagalin fetch */ }
}

// PENGGANTI fetchHemat() di seluruh file - perilakunya sama persis, plus dihitung & ada rem darurat.
function fetchHemat(url, opsi) {
  var cache = CacheService.getScriptCache();
  if (cache.get(UF_KUNCI_HABIS)) {
    throw new Error('Kuota harian UrlFetch Google sedang habis - pemanggilan API ditunda otomatis (dicoba lagi tiap 1 jam). Detail: jalankan lihatPemakaianUrlFetchHariIni() di editor.');
  }
  ufCatatPemakaian(url);
  try {
    return UrlFetchApp.fetch(url, opsi || {});
  } catch (err) {
    if (/too many times/i.test(String(err))) cache.put(UF_KUNCI_HABIS, '1', 3600);
    throw err;
  }
}

function urlFetchSedangDiblokir() {
  try { return !!CacheService.getScriptCache().get(UF_KUNCI_HABIS); } catch (e) { return false; }
}

function kuotaUrlFetchMenipis() {
  try {
    if (urlFetchSedangDiblokir()) return true;
    var data = JSON.parse(CacheService.getScriptCache().get(ufKunciHariIni()) || '{}');
    return (data._total || 0) >= UF_BATAS_AMAN_HARIAN;
  } catch (e) { return false; }
}

// true = boleh jalan sekarang (lalu dikunci selama `detik`); false = masih dalam masa jeda
function bolehJalanTiap(kunci, detik) {
  try {
    var cache = CacheService.getScriptCache();
    if (cache.get('JEDA_' + kunci)) return false;
    cache.put('JEDA_' + kunci, '1', Math.min(21600, Math.max(1, detik)));
    return true;
  } catch (e) { return true; }
}

// JALANKAN dari editor Apps Script buat lihat fitur mana yang paling boros kuota hari ini
function lihatPemakaianUrlFetchHariIni() {
  var data = JSON.parse(CacheService.getScriptCache().get(ufKunciHariIni()) || '{}');
  var total = data._total || 0;
  delete data._total;
  var urut = Object.keys(data).map(function (k) { return [k, data[k]]; }).sort(function (a, b) { return b[1] - a[1]; });
  Logger.log('Total UrlFetch hari ini (sejak modul penjaga aktif): ' + total + ' / batas aman ' + UF_BATAS_AMAN_HARIAN);
  Logger.log('Rem darurat kuota habis: ' + (urlFetchSedangDiblokir() ? 'AKTIF' : 'tidak aktif'));
  urut.slice(0, 25).forEach(function (r) { Logger.log(r[1] + 'x  ' + r[0]); });
  return { total: total, perEndpoint: urut };
}

// JALANKAN dari editor kalau kuota sudah pulih tapi mau langsung buka rem daruratnya (tanpa tunggu 1 jam)
function resetRemKuotaUrlFetch() {
  CacheService.getScriptCache().remove(UF_KUNCI_HABIS);
  Logger.log('✅ Rem darurat UrlFetch dibuka.');
}

/* ---------- Cadangan ambil resi satu-satu: DIBATASI (anggaran per jalan + jeda per pesanan) ---------- */
var STATUS_SHOPEE_PERLU_RESI = { READY_TO_SHIP: 1, PROCESSED: 1, SHIPPED: 1, RETRY_SHIP: 1, TO_CONFIRM_RECEIVE: 1 };
var STATUS_TIKTOK_TANPA_RESI = { UNPAID: 1, ON_HOLD: 1, CANCELLED: 1, COMPLETED: 1 };

function ambilTrackingShopeeHemat(orderSn, status, accessToken, shopId, anggaran) {
  if (!orderSn) return '';
  if (status && !STATUS_SHOPEE_PERLU_RESI[String(status).toUpperCase()]) return ''; // belum/tidak akan punya resi
  if (anggaran && anggaran.sisa <= 0) return '';
  if (kuotaUrlFetchMenipis()) return '';
  if (!bolehJalanTiap('TRK_SHP_' + orderSn, TRACKING_JEDA_PER_ORDER_DETIK)) return '';
  if (anggaran) anggaran.sisa--;
  return ambilTrackingNumberShopee(orderSn, accessToken, shopId);
}

function ambilTrackingTikTokHemat(packageId, status, accessToken, shopCipher, anggaran) {
  if (!packageId || packageId === '-') return '';
  if (status && STATUS_TIKTOK_TANPA_RESI[String(status).toUpperCase()]) return '';
  if (anggaran && anggaran.sisa <= 0) return '';
  if (kuotaUrlFetchMenipis()) return '';
  if (!bolehJalanTiap('TRK_TT_' + packageId, TRACKING_JEDA_PER_ORDER_DETIK)) return '';
  if (anggaran) anggaran.sisa--;
  return ambilTrackingNumberPaketTikTok(packageId, accessToken, shopCipher);
}

/* ---------- Token Shopee via CacheService (fetch token baru HANYA kalau mau expired) ---------- */
function ambilKredensialShopee() {
  var cache = CacheService.getScriptCache();
  var AMAN_MS = 10 * 60 * 1000;
  try {
    var tersimpan = cache.get('SHOPEE_KREDENSIAL');
    if (tersimpan) {
      var k = JSON.parse(tersimpan);
      if (k.accessToken && k.expiredAt - Date.now() > AMAN_MS) return k; // 0x UrlFetch, 0x baca Properties
    }
  } catch (e) {}
  refreshTokenShopeeOtomatis(); // cuma fetch kalau token beneran mau/udah expired (ada jeda kalau gagal)
  var props = PropertiesService.getScriptProperties();
  var kred = {
    accessToken: props.getProperty('SHOPEE_ACCESS_TOKEN') || '',
    shopId: props.getProperty('SHOPEE_SHOP_ID') || '',
    expiredAt: parseInt(props.getProperty('SHOPEE_TOKEN_EXPIRED_AT') || '0', 10)
  };
  var sisaDetik = Math.floor((kred.expiredAt - Date.now() - AMAN_MS) / 1000);
  if (kred.accessToken && sisaDetik > 60) {
    try { cache.put('SHOPEE_KREDENSIAL', JSON.stringify(kred), Math.min(3 * 60 * 60, sisaDetik)); } catch (e) {}
  }
  return kred;
}

function hapusCacheKredensialShopee() {
  try { CacheService.getScriptCache().remove('SHOPEE_KREDENSIAL'); } catch (e) {}
}


/* =====================================================================================
   VALIDASI MASUK (Back-office) - cocokkan Memo Gudang (fisik) dengan Invoice Pembelian,
   lalu eksekusi ke stock dengan aturan selisih yang terstruktur.
   Alur: Gudang (mobile) catat fisik -> status "Menunggu Verifikasi" (stock BELUM berubah)
         -> Back-office pilih invoice + dokumen -> "Tambahkan ke Stock" (stock berubah di sini).
   Semua tulisan di eksekusi pakai 1 timestamp presisi yang sama (Date + ISO milidetik + epoch ms)
   supaya nanti bisa direkonsiliasi mutasi stock harian.
   ===================================================================================== */
var VM_STATUS_MENUNGGU = { 'Menunggu': 1, 'Menunggu Verifikasi': 1 };

function getValidasiMasukSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var shHeader = ss.getSheetByName('Validasi Barang Masuk');
  if (!shHeader) {
    shHeader = ss.insertSheet('Validasi Barang Masuk');
    var h = ['No Validasi', 'Timestamp Eksekusi', 'Timestamp ISO', 'Epoch (ms)', 'Waktu Klik Perangkat (ISO)', 'No Memo',
      'No Surat Jalan', 'No Invoice', 'Status Rekonsiliasi', 'Flag', 'Tindakan Lebih', 'Tindakan Kurang',
      'Catatan Discrepancy', 'Link Foto SJ', 'Divalidasi Oleh', 'Total Qty Fisik', 'Total Qty Masuk Stock'];
    shHeader.getRange(1, 1, 1, h.length).setValues([h]).setFontWeight('bold');
  }
  var shDetail = ss.getSheetByName('Validasi Barang Masuk Detail');
  if (!shDetail) {
    shDetail = ss.insertSheet('Validasi Barang Masuk Detail');
    var d = ['No Validasi', 'Timestamp ISO', 'SKU', 'Nama Produk', 'Qty Fisik', 'Qty Invoice', 'Selisih', 'Status Baris',
      'Tindakan', 'Qty Masuk Stock', 'Harga Satuan', 'No Invoice Asal', 'Flag'];
    shDetail.getRange(1, 1, 1, d.length).setValues([d]).setFontWeight('bold');
  }
  return { header: shHeader, detail: shDetail };
}

function getJurnalPenyesuaianStokSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Jurnal Penyesuaian Stok');
  if (!sh) {
    sh = ss.insertSheet('Jurnal Penyesuaian Stok');
    var h = ['Timestamp', 'Timestamp ISO', 'No Validasi', 'No Memo', 'No Invoice', 'SKU', 'Nama Produk', 'Arah',
      'Qty', 'Harga Satuan', 'Nilai', 'Tindakan', 'Catatan', 'Dicatat Oleh', 'Epoch (ms)'];
    sh.getRange(1, 1, 1, h.length).setValues([h]).setFontWeight('bold');
  }
  return sh;
}

function vmNormSku(s) { return String(s || '').trim().toUpperCase(); }

// Gabungkan beberapa memo (1 kedatangan barang) jadi 1 memo virtual: qty per SKU dijumlah.
function vmGabungkanMemo(memos) {
  var peta = {}, urut = [], daftarSJ = [], daftarInv = [];
  memos.forEach(function (m) {
    m.items.forEach(function (it) {
      var k = vmNormSku(it.sku);
      if (!peta[k]) { peta[k] = { sku: it.sku, nama: it.nama, qty: 0 }; urut.push(k); }
      peta[k].qty += it.qty;
    });
    String(m.noSuratJalan || '').split(/[,;]+/).forEach(function (s) { s = s.trim(); if (s && daftarSJ.indexOf(s) === -1) daftarSJ.push(s); });
    String(m.noInvoiceTerkait || '').split(/[,;]+/).forEach(function (s) { s = s.trim(); if (s && daftarInv.indexOf(s) === -1) daftarInv.push(s); });
  });
  return {
    noMemo: memos.map(function (m) { return m.noMemo; }).join(', '),
    items: urut.map(function (k) { return peta[k]; }),
    noSuratJalan: daftarSJ.join(', '),
    noInvoiceTerkait: daftarInv.join(', ')
  };
}

// Peta SKU -> { nama, hargaSupplier } dari Master Produk (buat nama tampilan & nilai referensi barang nyasar)
function vmPetaMasterProduk() {
  var peta = {};
  var sh = getMasterProdukSheet();
  var lastRow = sh.getLastRow();
  if (lastRow > 1) {
    sh.getRange(2, 1, lastRow - 1, 4).getValues().forEach(function (r) {
      var sku = vmNormSku(r[0]);
      if (sku) peta[sku] = { nama: String(r[1] || ''), hargaSupplier: parseFloat(r[3]) || 0 };
    });
  }
  return peta;
}

// Memo menunggu (+ isi barang) & invoice pembelian yang belum divalidasi (+ isi SKU) - 1 panggilan
function vmAmbilDataMentah() {
  var tz = Session.getScriptTimeZone();
  var master = vmPetaMasterProduk();

  var shMemo = getMemoBarangMasukSheets();
  var memoPeta = {}, memoUrut = [];
  var lastMemo = shMemo.header.getLastRow();
  if (lastMemo > 1) {
    shMemo.header.getRange(2, 1, lastMemo - 1, 9).getValues().forEach(function (r, i) {
      var no = String(r[0] || '').trim();
      if (!no || !VM_STATUS_MENUNGGU[String(r[2] || '').trim()]) return;
      memoPeta[no] = {
        noMemo: no, row: i + 2, status: String(r[2]),
        tanggal: r[1] instanceof Date ? Utilities.formatDate(r[1], tz, 'dd MMM yyyy HH:mm') : String(r[1] || '-'),
        tanggalObj: r[1] instanceof Date ? r[1].getTime() : 0,
        dicatatOleh: String(r[3] || ''), noInvoiceTerkait: String(r[6] || ''), noSuratJalan: String(r[7] || ''), items: []
      };
      memoUrut.push(no);
    });
  }
  var lastMemoDet = shMemo.detail.getLastRow();
  if (lastMemoDet > 1 && memoUrut.length) {
    shMemo.detail.getRange(2, 1, lastMemoDet - 1, 4).getValues().forEach(function (r) {
      var m = memoPeta[String(r[0] || '').trim()];
      if (!m) return;
      var sku = String(r[1] || '').trim();
      var qty = parseFloat(r[2]) || 0;
      if (!sku || qty <= 0) return;
      // SKU sama dalam 1 memo digabung
      var ada = null;
      for (var k = 0; k < m.items.length; k++) if (vmNormSku(m.items[k].sku) === vmNormSku(sku)) { ada = m.items[k]; break; }
      if (ada) { ada.qty += qty; if (r[3]) ada.catatan = (ada.catatan ? ada.catatan + '; ' : '') + r[3]; }
      else m.items.push({ sku: sku, nama: (master[vmNormSku(sku)] || {}).nama || sku, qty: qty, catatan: String(r[3] || '') });
    });
  }

  var shBeli = getPembelianManualSheets();
  var invPeta = {}, invUrut = [];
  var lastInv = shBeli.header.getLastRow();
  if (lastInv > 1) {
    shBeli.header.getRange(2, 1, lastInv - 1, 10).getValues().forEach(function (r, i) {
      var no = String(r[0] || '').trim();
      if (!no) return;
      if ((r[9] || 'Aktif') === 'Dibatalkan') return;
      if ((r[8] || 'Belum Dicek') !== 'Belum Dicek') return; // sudah divalidasi/diterima
      invPeta[no] = {
        noInvoice: no, row: i + 2, namaSupplier: String(r[2] || ''),
        tanggal: r[1] instanceof Date ? Utilities.formatDate(r[1], tz, 'dd MMM yyyy') : String(r[1] || '-'),
        tanggalObj: r[1] instanceof Date ? r[1].getTime() : 0, total: parseFloat(r[6]) || 0, items: []
      };
      invUrut.push(no);
    });
  }
  var lastInvDet = shBeli.detail.getLastRow();
  if (lastInvDet > 1 && invUrut.length) {
    shBeli.detail.getRange(2, 1, lastInvDet - 1, 6).getValues().forEach(function (r) {
      var inv = invPeta[String(r[0] || '').trim()];
      if (!inv) return;
      var sku = String(r[1] || '').trim();
      if (!sku) return;
      inv.items.push({ sku: sku, nama: String(r[2] || '') || (master[vmNormSku(sku)] || {}).nama || sku, qty: parseFloat(r[3]) || 0, harga: parseFloat(r[4]) || 0 });
    });
  }

  return {
    memos: memoUrut.map(function (n) { return memoPeta[n]; }).filter(function (m) { return m.items.length > 0; }),
    memoPeta: memoPeta,
    invoices: invUrut.map(function (n) { return invPeta[n]; }).sort(function (a, b) { return b.tanggalObj - a.tanggalObj; }),
    invPeta: invPeta,
    master: master,
    shMemo: shMemo, shBeli: shBeli
  };
}

function prosesVmLihatAntrean(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var d = vmAmbilDataMentah();
    d.memos.sort(function (a, b) { return a.tanggalObj - b.tanggalObj; }); // antrean: paling lama duluan
    result.success = true;
    result.memos = d.memos.map(function (m) { delete m.row; return m; });
    result.invoices = d.invoices.map(function (i) { delete i.row; return i; });
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Rekonsiliasi per SKU: Qty Fisik (memo) vs Qty Tagihan (gabungan invoice terpilih).
// Dipakai server sebagai SUMBER KEBENARAN (frontend punya versi tampilan yang identik).
function vmHitungRekonsiliasi(memo, invoices) {
  var peta = {}, urut = [];
  function ambil(sku, nama) {
    var k = vmNormSku(sku);
    if (!peta[k]) { peta[k] = { sku: sku, nama: nama || sku, qtyFisik: 0, qtyInvoice: 0, harga: 0, noInvoices: [] }; urut.push(k); }
    return peta[k];
  }
  memo.items.forEach(function (it) { ambil(it.sku, it.nama).qtyFisik += it.qty; });
  invoices.forEach(function (inv) {
    inv.items.forEach(function (d) {
      var r = ambil(d.sku, d.nama);
      r.qtyInvoice += d.qty;
      if (d.harga) r.harga = d.harga;
      if (!r.nama || r.nama === r.sku) r.nama = d.nama;
      if (r.noInvoices.indexOf(inv.noInvoice) === -1) r.noInvoices.push(inv.noInvoice);
    });
  });
  return urut.map(function (k) {
    var r = peta[k];
    if (r.qtyInvoice === 0) r.status = 'nyasar';
    else if (r.qtyFisik === 0) r.status = 'belum';
    else if (r.qtyFisik === r.qtyInvoice) r.status = 'sesuai';
    else if (r.qtyFisik < r.qtyInvoice) r.status = 'kurang';
    else r.status = 'lebih';
    return r;
  });
}

/* ============================================================
   MEMO GUDANG - ANTI DOBEL, BATALKAN MEMO, AUTO-APPROVE & MUTASI BERBASIS WAKTU FISIK
   ============================================================ */

/* ---------- (1) IDEMPOTENCY: 1 klik = 1 memo, walau request terkirim 2x ----------
   Penyebab memo dobel: postJson() di browser otomatis MENGULANG request kalau server belum menjawab
   dalam 20 detik. Simpan memo bisa > 20 detik (antre lock) -> request ke-2 membuat memo ke-2 dengan
   nomor baru. Sekarang browser mengirim idPermintaan unik per klik; server menolak id yang sama. */
var IDEM_AKSI_ = { buat_invoice: 1, batal_pesanan: 1, hapus_permanen_pesanan: 1, hapus_pesanan_batal_massal: 1, update_item_pesanan: 1, fin_catat_biaya: 1, simpan_memo_barang_masuk: 1, simpan_memo_minta_stock: 1, simpan_memo_hilang_rusak: 1, simpan_memo_stock_opname: 1, batalkan_memo_gudang: 1, simpan_data_pembeli_massal: 1 };

// Aksi BACA tidak pernah dicatat idempotensinya (hasilnya harus selalu segar)
// smap_analisis & smap_ai_* (Import Excel Mapping SKU) hanya MEMBACA & hasilnya besar (> 90 KB) -> jangan disimpan
// sebagai hasil idempoten: kiriman ulang otomatis dari browser harus menghitung ulang, bukan menerima versi ringkas kosong.
var IDEM_AKSI_BACA_RE_ = /^(lihat_|detail_|ringkasan_|riwayat_|cari_|cek_|semua_|hitung_|simulasi_|ambil_|analisa_|rangkum_|katalog_ambil_|vm_lihat_|reminder_|dashboard_|login$|buat_auth_url|baca_|ekstrak_|tanya_|smap_analisis$|smap_ai_)/;
function idemMulai_(aksi, data) {
  if (!data || !data.idPermintaan) return null;
  // ACTION LOG PASTI BERHASIL: SEMUA aksi TULIS yang membawa idPermintaan kini idempotent. Browser boleh
  // mengirim ulang permintaan yang sama (mis. setelah error 404 / timeout dari server Google) tanpa
  // risiko dobel: permintaan kedua menerima hasil yang tersimpan dari permintaan pertama.
  if (!IDEM_AKSI_[aksi]) {
    if (IDEM_AKSI_BACA_RE_.test(String(aksi || ''))) return null;
    return idemCekTanpaLock_('IDEM_' + String(data.idPermintaan).slice(0, 80));
  }
  var kunci = 'IDEM_' + String(data.idPermintaan).slice(0, 80);
  var cache = CacheService.getScriptCache();
  function cekDanTandai() {
    var ada = cache.get(kunci);
    if (ada === 'PROSES') return { kunci: kunci, hasil: { success: false, duplikat: true, error: 'Memo ini masih diproses dari klik sebelumnya - cek Riwayat sebentar lagi, jangan kirim ulang.' } };
    if (ada) { var h = JSON.parse(ada); h.duplikat = true; return { kunci: kunci, hasil: h }; }
    cache.put(kunci, 'PROSES', 600);
    return { kunci: kunci };
  }
  // OPTIMASI: dulu waitLock(10000) - request simpan ikut antre 10 detik di ScriptLock global SEBELUM
  // handler-nya sendiri antre lagi, dan kalau gagal, perlindungan anti-dobel dilewati total.
  // Sekarang: coba lock sebentar (bagian kritisnya hanya beberapa milidetik); kalau sibuk, tetap cek
  // cache tanpa lock (hampir selalu cukup untuk menangkap klik/retry dobel).
  var lock = LockService.getScriptLock();
  var dapat = false;
  try { dapat = lock.tryLock(3000); } catch (e) { dapat = false; }
  try { return cekDanTandai(); }
  catch (e2) { return null; } // cache error -> jalan normal (tetap dijaga lock handler)
  finally { if (dapat) lock.releaseLock(); }
}

// Versi ringan (tanpa ScriptLock) untuk aksi tulis umum: kiriman ulang dari browser selalu berjarak
// beberapa detik, jadi cek cache biasa sudah cukup & tidak menambah antrean lock global.
function idemCekTanpaLock_(kunci) {
  try {
    var cache = CacheService.getScriptCache();
    var ada = cache.get(kunci);
    if (ada === 'PROSES') return { kunci: kunci, hasil: { success: false, duplikat: true, error: 'Permintaan yang sama masih diproses server - menunggu hasilnya.' } };
    if (ada) { var h = JSON.parse(ada); h.duplikat = true; return { kunci: kunci, hasil: h }; }
    cache.put(kunci, 'PROSES', 600);
    return { kunci: kunci };
  } catch (e) { return null; }
}

function idemSelesai_(idem, out) {
  if (!idem || idem.hasil) return;
  var cache = CacheService.getScriptCache();
  try {
    if (out && out.success) {
      var teksOut = JSON.stringify(out);
      if (teksOut.length > 90000) teksOut = JSON.stringify({ success: true, ringkas: true, pesan: 'Sudah diproses sebelumnya' });
      cache.put(idem.kunci, teksOut, 21600); // 6 jam
    }
    else cache.remove(idem.kunci); // gagal -> boleh dicoba lagi
  } catch (e) { }
}

/* ---------- (4) MUTASI STOK BERBASIS WAKTU FISIK (backdating kronologis) ----------
   Baris ledger 'Masuk' dari memo memakai WAKTU MEMO DIBUAT (barang fisik tiba), bukan waktu approve,
   dan disisipkan di posisi kronologisnya (bukan ditempel di bawah). Saldo stok tidak disimpan per
   baris di Stock Ledger - saldo berjalan (kartu stok/Log Mutasi) selalu dihitung ulang dari urutan
   waktu, jadi cukup cache perhitungannya yang dibuang agar langsung dihitung ulang. */
function sisipkanLedgerKronologis_(sh, baris, nKol) {
  if (!baris || !baris.length) return;
  baris = baris.slice().sort(function (a, b) { return smMs(a[0]) - smMs(b[0]); });
  var lr = sh.getLastRow();
  if (lr < 2) { sh.getRange(2, 1, baris.length, nKol).setValues(baris); return; }
  // Cari posisi dari bawah (memo biasanya baru beberapa jam/hari) - maksimal 6000 baris terakhir
  var awal = Math.max(2, lr - 5999);
  var waktuSheet = sh.getRange(awal, 1, lr - awal + 1, 1).getValues().map(function (r) { return smMs(r[0]); });
  function posisi(ms) { // baris sheet TERAKHIR yang waktunya <= ms (sisip SESUDAHNYA)
    for (var i = waktuSheet.length - 1; i >= 0; i--) if (waktuSheet[i] && waktuSheet[i] <= ms) return awal + i;
    return awal - 1;
  }
  var grup = {}, urutPos = [];
  baris.forEach(function (b) { var p = posisi(smMs(b[0])); if (!grup[p]) { grup[p] = []; urutPos.push(p); } grup[p].push(b); });
  urutPos.sort(function (a, b) { return b - a; }); // dari bawah ke atas supaya posisi di atasnya tidak bergeser
  urutPos.forEach(function (p) {
    var isi = grup[p];
    if (p >= lr) { sh.getRange(sh.getLastRow() + 1, 1, isi.length, nKol).setValues(isi); return; }
    sh.insertRowsAfter(Math.max(1, p), isi.length);
    sh.getRange(Math.max(1, p) + 1, 1, isi.length, nKol).setValues(isi);
  });
}

function hitungUlangSaldoStok_() {
  try { smNaikkanVersiStok_(); } catch (eV) { }
  try { CacheService.getScriptCache().removeAll([SM_CACHE_MONITOR, 'OV_SNAPSHOT_STOK_default', 'OV_SNAPSHOT_STOK_Waterground', 'OV_SNAPSHOT_STOK_Conner']); } catch (e) { }
}

// Bagi qty per SKU ke memo-memo asalnya (urut waktu) -> tiap porsi memakai waktu memo masing-masing
function alokasiWaktuMemo_(memos) {
  var sisa = {}; // sku -> [{ms, qty}]
  memos.slice().sort(function (a, b) { return a.tanggalObj - b.tanggalObj; }).forEach(function (m) {
    m.items.forEach(function (it) {
      var k = vmNormSku(it.sku);
      (sisa[k] || (sisa[k] = [])).push({ ms: m.tanggalObj || Date.now(), qty: it.qty });
    });
  });
  var terakhir = memos.reduce(function (x, m) { return Math.max(x, m.tanggalObj || 0); }, 0) || Date.now();
  return function (sku, qty) { // -> [{waktu: Date, qty}]
    var daftar = sisa[vmNormSku(sku)] || [], hasil = [];
    while (qty > 0 && daftar.length) {
      var d = daftar[0], ambil = Math.min(d.qty, qty);
      if (ambil > 0) hasil.push({ waktu: new Date(d.ms), qty: ambil });
      d.qty -= ambil; qty -= ambil;
      if (d.qty <= 0) daftar.shift();
    }
    if (qty > 0) hasil.push({ waktu: new Date(terakhir), qty: qty }); // mis. bonus di atas qty memo
    return hasil;
  };
}

/* ---------- (2) BATALKAN MEMO GUDANG (Barang Masuk) ----------
   Opsi A "force_close" : keluar dari antrean persetujuan, barang yang dicatat gudang DIANGGAP SAH ->
                          stok masuk (waktu = waktu memo), status "Selesai (Force Close)". Tanpa jurnal
                          AP/invoice (invoice pembelian tetap bisa divalidasi terpisah).
   Opsi B "void"        : memo tidak valid. Tidak ada stok yang masuk. Kalau memo lama sudah sempat
                          "Dieksekusi" (stok terlanjur masuk), efeknya dibalik dengan ledger penyesuaian
                          pada waktu yang sama sehingga riwayat stok bersih. Status "Dibatalkan (Void)".
   Memo yang sudah divalidasi di Validasi Masuk (Selesai / Tervalidasi) tidak bisa dibatalkan di sini. */
function getKolomBatalMemo_(sh) {
  if (sh.getLastColumn() < 10) sh.getRange(1, 10).setValue('Catatan Pembatalan').setFontWeight('bold');
  return 10;
}

function prosesBatalkanMemoGudang(data) {
  var mode, alasan;
  return withTransaction(data.email, 'mintaStock', 'stok', function () {
    var result = { success: false };
    var noMemo = String(data.noMemo || '').trim();
    var staff = getStaffByEmail(data.email);
    var isOwner = !!(staff && staff.role === 'Owner');
    var namaStaff = getNamaStaff(data.email);

    var sheets = getMemoBarangMasukSheets();
    var lr = sheets.header.getLastRow();
    var row = -1, h = null;
    if (lr > 1) {
      var v = sheets.header.getRange(2, 1, lr - 1, 9).getValues();
      for (var i = 0; i < v.length; i++) if (String(v[i][0]).trim() === noMemo) { row = i + 2; h = v[i]; break; }
    }
    if (row === -1) throw new Error('Memo ' + noMemo + ' tidak ditemukan.');
    var status = String(h[2] || '').trim();
    if (status === 'Tervalidasi' || status.indexOf('Selesai') === 0) throw new Error('Memo ini sudah divalidasi (' + status + ') - tidak bisa dibatalkan di sini.');
    if (status.indexOf('Dibatalkan') === 0) throw new Error('Memo ini sudah dibatalkan sebelumnya.');
    var menunggu = !!VM_STATUS_MENUNGGU[status];
    if (!menunggu && status !== 'Dieksekusi') throw new Error('Status memo "' + status + '" tidak bisa dibatalkan.');
    if (mode === 'force_close' && !isOwner) throw new Error('Force Close (menganggap barang sah) hanya bisa dilakukan Owner.');
    if (mode === 'force_close' && !menunggu) throw new Error('Force Close hanya untuk memo yang masih menunggu persetujuan.');
    if (mode === 'void' && !isOwner && (!menunggu || String(h[3] || '').trim() !== namaStaff)) throw new Error('Tanpa akses Owner, Anda hanya bisa membatalkan memo buatan sendiri yang masih menunggu.');

    var waktuMemo = h[1] instanceof Date ? h[1] : new Date();
    var sekarang = new Date();
    var baris = [];
    var ld = sheets.detail.getLastRow();
    if (ld > 1) sheets.detail.getRange(2, 1, ld - 1, 4).getValues().forEach(function (r) {
      if (String(r[0]).trim() === noMemo && String(r[1] || '').trim() && (parseFloat(r[2]) || 0) > 0) baris.push({ sku: String(r[1]).trim(), qty: parseFloat(r[2]) || 0, catatan: String(r[3] || '') });
    });
    var shL = getStockLedgerSheet();
    var tz = Session.getScriptTimeZone();
    var isoMemo = Utilities.formatDate(waktuMemo, tz, "yyyy-MM-dd'T'HH:mm:ss.SSSXXX");
    var ledger = [];
    var statusBaru, ket;
    var sudahLangsung = bmAdaStokLangsung_(noMemo); // P1: stok memo ini sudah masuk langsung dari HP
    if (mode === 'force_close') {
      if (!sudahLangsung) baris.forEach(function (b) { ledger.push([waktuMemo, b.sku, 'Masuk', b.qty, 'Force Close Memo ' + noMemo + ' - dianggap sah (' + alasan + ')', namaStaff, data.toko || 'Waterground', 0, isoMemo]); });
      statusBaru = 'Selesai (Force Close)';
    } else {
      if (status === 'Dieksekusi' || sudahLangsung) {
        // Stok memo lama sudah terlanjur masuk -> balik di waktu yang sama
        baris.forEach(function (b) { ledger.push([waktuMemo, b.sku, 'Keluar', b.qty, 'Void Memo ' + noMemo + ' - pembatalan stok masuk (' + alasan + ')', namaStaff, data.toko || 'Waterground', 0, isoMemo]); });
      }
      statusBaru = 'Dibatalkan (Void)';
    }
    if (ledger.length) {
      if (shL.getLastColumn() < 9) shL.getRange(1, 9).setValue('Timestamp Presisi (ISO)').setFontWeight('bold');
      sisipkanLedgerKronologis_(shL, ledger, 9);
    }
    var kol = getKolomBatalMemo_(sheets.header);
    sheets.header.getRange(row, 3).setValue(statusBaru);
    sheets.header.getRange(row, 5, 1, 2).setValues([[namaStaff, sekarang]]);
    sheets.header.getRange(row, kol).setValue((mode === 'void' ? 'VOID' : 'FORCE CLOSE') + ' oleh ' + namaStaff + ' ' + Utilities.formatDate(sekarang, tz, 'dd MMM yyyy HH:mm') + ': ' + alasan);
    hitungUlangSaldoStok_();
    result.success = true;
    result.status = statusBaru;
    result.barisLedger = ledger.length;
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      mode = String(data.mode || '');
      if (mode !== 'force_close' && mode !== 'void') throw new Error('Pilih jenis pembatalan.');
      alasan = String(data.alasan || '').trim();
      if (!alasan) throw new Error('Alasan pembatalan wajib diisi.');
    }
  });
}

/* ---------- (3) AUTO-APPROVE MEMO GUDANG ----------
   Syarat MUTLAK: memo menunggu > AUTO_APPROVE_JAM jam DAN isi memo (SKU + qty) identik 100% dengan
   invoice pembelian yang BELUM divalidasi. Invoice diambil dari "No Invoice Terkait" di memo; kalau
   kosong, dicari 1 invoice yang cocok persis (tidak boleh ambigu). Ada selisih sekecil apa pun -> tetap
   menunggu approval manual. Eksekusi memakai prosesVmEksekusi (jalur yang SAMA dengan approval manual:
   ledger, AP, status invoice), jadi pembukuannya identik. */
var AUTO_APPROVE_JAM = 0; // v2026.10.57 (DN-814): tidak menunggu 24 jam lagi - cocok 100% langsung disahkan

function vmCocok100Persen_(memo, invoices) {
  if (!invoices.length) return false;
  var rekon = vmHitungRekonsiliasi(memo, invoices);
  return rekon.length > 0 && rekon.every(function (r) { return r.status === 'sesuai'; });
}

function autoApproveMemoGudang() {
  var ringkas = { dicek: 0, disetujui: [], dilewati: [] };
  var d = vmAmbilDataMentah();
  var batas = Date.now() - AUTO_APPROVE_JAM * 3600000;
  var invTerpakai = {};
  d.memos.sort(function (a, b) { return a.tanggalObj - b.tanggalObj; }).forEach(function (m) {
    if (!m.tanggalObj || m.tanggalObj > batas) return;
    ringkas.dicek++;
    var kandidat = [];
    var noTerkait = String(m.noInvoiceTerkait || '').split(/[,;]+/).map(function (x) { return x.trim(); }).filter(Boolean);
    if (noTerkait.length) {
      var semuaAda = noTerkait.every(function (n) { return d.invPeta[n] && !invTerpakai[n]; });
      if (!semuaAda) { ringkas.dilewati.push(m.noMemo + ': invoice terkait tidak ada / sudah divalidasi'); return; }
      kandidat = noTerkait.map(function (n) { return d.invPeta[n]; });
      if (!vmCocok100Persen_(m, kandidat)) { ringkas.dilewati.push(m.noMemo + ': ada selisih dengan ' + noTerkait.join(', ')); return; }
    } else {
      var cocok = d.invoices.filter(function (inv) { return !invTerpakai[inv.noInvoice] && vmCocok100Persen_(m, [inv]); });
      if (cocok.length !== 1) { ringkas.dilewati.push(m.noMemo + ': ' + (cocok.length ? 'lebih dari 1 invoice cocok (ambigu)' : 'tidak ada invoice yang cocok 100%')); return; }
      kandidat = cocok;
    }
    var hasil = denganIzinSistem_(function () {
      return prosesVmEksekusi({ email: '', memoIds: [m.noMemo], noInvoices: kandidat.map(function (i) { return i.noInvoice; }),
        catatan: '', namaSistem: 'Auto-Approve (Sistem)', toko: 'Waterground' });
    });
    if (hasil.success && hasil.statusRekon === 'SESUAI') {
      kandidat.forEach(function (i) { invTerpakai[i.noInvoice] = true; });
      ringkas.disetujui.push(m.noMemo + ' -> ' + hasil.noValidasi);
    } else ringkas.dilewati.push(m.noMemo + ': ' + (hasil.error || 'gagal'));
  });
  Logger.log('Auto-approve memo: ' + JSON.stringify(ringkas));
  return ringkas;
}

// Trigger harian 01:30 (sebelum Rekonsiliasi Malam 02:00, supaya rekonsiliasi sudah memakai stok hasil auto-approve)
function aktifkanAutoApproveMemo() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'autoApproveMemoGudang') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('autoApproveMemoGudang').timeBased().everyDays(1).atHour(1).nearMinute(30).create();
  Logger.log('✅ Auto-approve Memo Gudang aktif tiap hari ±01:30.');
}

function prosesAturAutoApproveMemo(data) {
  var result = { success: false };
  try {
    var staff = getStaffByEmail(data.email);
    if (!staff || staff.role !== 'Owner') throw new Error('Hanya Owner yang bisa mengatur auto-approve.');
    if (data.aktif === true) aktifkanAutoApproveMemo();
    else if (data.aktif === false) ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'autoApproveMemoGudang') ScriptApp.deleteTrigger(t); });
    if (data.jalankanSekarang === true) result.ringkas = autoApproveMemoGudang();
    result.aktif = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'autoApproveMemoGudang'; });
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

var VM_LABEL_STATUS = { sesuai: 'Sesuai', kurang: 'Kurang', lebih: 'Lebih', nyasar: 'Tidak ada di tagihan', belum: 'Belum Dikirim' };
var VM_LABEL_TINDAKAN = { bonus: 'Bonus/Hadiah (Penyesuaian Positif)', kembalikan: 'Kembalikan ke Supplier', klaim: 'Klaim ke Supplier', hilang: 'Catat Kehilangan (Penyesuaian Negatif)' };

function prosesVmEksekusi(data) {
  return withTransaction(data.email, 'mintaStock', ['pembelian', 'stok'], function () {
    var result = { success: false };
    // MULTI-MEMO: payload baru = memoIds (array). data.noMemo (1 memo, cara lama) tetap diterima.
    var memoIds = [];
    (Array.isArray(data.memoIds) ? data.memoIds : String(data.noMemo || '').split(/[,;]+/)).forEach(function (n) {
      var s = String(n || '').trim();
      if (s && memoIds.indexOf(s) === -1) memoIds.push(s);
    });
    var noInvoices = (data.noInvoices || []).map(function (n) { return String(n || '').trim(); }).filter(Boolean);
    if (memoIds.length === 0) throw new Error('Pilih minimal 1 Memo Gudang.');
    if (noInvoices.length === 0) throw new Error('Pilih minimal 1 invoice pembelian.');

    // Baca ulang dari sheet (jangan percaya angka dari browser) - sekalian cek status terbaru SEMUA memo
    var d = vmAmbilDataMentah();
    var memos = memoIds.map(function (id) {
      if (!d.memoPeta[id]) throw new Error('Memo ' + id + ' nggak ada di antrean (mungkin sudah divalidasi orang lain).');
      return d.memoPeta[id];
    });
    var memo = vmGabungkanMemo(memos);  // SKU & qty dari semua memo DIJUMLAH -> 1 "memo gabungan"
    var noMemo = memoIds.join(', ');     // dipakai di log, ledger & jurnal
    var invoices = noInvoices.map(function (n) {
      if (!d.invPeta[n]) throw new Error('Invoice ' + n + ' sudah divalidasi/dibatalkan atau nggak ditemukan.');
      return d.invPeta[n];
    });

    var rekon = vmHitungRekonsiliasi(memo, invoices);
    var adaLebih = rekon.some(function (r) { return r.status === 'lebih' || r.status === 'nyasar'; });
    var adaKurang = rekon.some(function (r) { return r.status === 'kurang' || r.status === 'belum'; });
    var tindakanLebih = String(data.tindakanLebih || '');
    var tindakanKurang = String(data.tindakanKurang || '');
    var catatan = String(data.catatan || '').trim();
    if (adaLebih && ['bonus', 'kembalikan'].indexOf(tindakanLebih) === -1) throw new Error('Pilih tindakan penyelesaian untuk barang LEBIH / tidak ada di tagihan.');
    if (adaKurang && ['klaim', 'hilang'].indexOf(tindakanKurang) === -1) throw new Error('Pilih tindakan penyelesaian untuk barang KURANG / belum dikirim.');
    if ((adaLebih || adaKurang) && !catatan) throw new Error('Catatan Discrepancy / Claim wajib diisi karena ada selisih.');
    if (!adaLebih) tindakanLebih = '';
    if (!adaKurang) tindakanKurang = '';

    // ===== SATU timestamp presisi untuk semua tulisan di eksekusi ini =====
    var tz = Session.getScriptTimeZone();
    var waktu = new Date();
    var iso = Utilities.formatDate(waktu, tz, "yyyy-MM-dd'T'HH:mm:ss.SSSXXX");
    var epoch = waktu.getTime();
    var waktuKlik = parseInt(data.waktuKlikMs, 10);
    var isoKlik = waktuKlik ? Utilities.formatDate(new Date(waktuKlik), tz, "yyyy-MM-dd'T'HH:mm:ss.SSSXXX") : '';

    // Auto-approve: nama pelaku dari server (IZIN_SISTEM_ hanya bisa aktif dari kode server)
    var namaStaff = (IZIN_SISTEM_ && data.namaSistem) ? String(data.namaSistem) : getNamaStaff(data.email);
    var toko = data.toko || 'Waterground';
    var shV = getValidasiMasukSheets();
    // WAKTU EFEKTIF: stok masuk dicatat pada waktu memo gudang dibuat (barang fisik tiba), bukan waktu approve
    var porsiWaktu = alokasiWaktuMemo_(memos);
    var noValidasi = bikinNomorMemo(shV.header, 'VLM');
    var noInvGabung = noInvoices.join(', ');

    // Foto Surat Jalan (opsional) -> Google Drive
    var linkFotoSJ = '';
    if (data.fotoSJ && data.fotoSJ.base64) {
      var mime = String(data.fotoSJ.mimeType || 'image/jpeg');
      var ext = mime === 'application/pdf' ? '.pdf' : (mime === 'image/png' ? '.png' : '.jpg');
      var blob = Utilities.newBlob(Utilities.base64Decode(String(data.fotoSJ.base64)), mime, 'SJ-' + noValidasi + '-' + memoIds[0] + (memoIds.length > 1 ? '-dst' + memoIds.length : '') + ext);
      var file = getSubfolderUpload('Surat Jalan').createFile(blob);
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      linkFotoSJ = file.getUrl();
    }

    var barisLedger = [], barisDetail = [], barisJurnal = [], barisClaim = [];
    var totalFisik = 0, totalMasuk = 0, adaKlaim = false;
    function ledger(sku, qty, ket, harga) {
      if (qty <= 0) return;
      porsiWaktu(sku, qty).forEach(function (p) {
        barisLedger.push([p.waktu, sku, 'Masuk', p.qty, ket + (Math.abs(p.waktu.getTime() - epoch) > 60000 ? ' | disahkan ' + Utilities.formatDate(waktu, tz, 'dd MMM yyyy HH:mm') : ''),
          namaStaff, toko, harga || 0, Utilities.formatDate(p.waktu, tz, "yyyy-MM-dd'T'HH:mm:ss.SSSXXX")]);
      });
    }
    function jurnal(r, arah, qty, harga, tindakan) {
      barisJurnal.push([waktu, iso, noValidasi, noMemo, r.noInvoices.join(', ') || '-', r.sku, r.nama, arah, qty, harga, qty * harga, VM_LABEL_TINDAKAN[tindakan], catatan, namaStaff, epoch]);
    }

    rekon.forEach(function (r) {
      var F = r.qtyFisik, I = r.qtyInvoice, harga = r.harga;
      var qtyMasuk = 0, tindakan = '', flag = '';
      var ketDasar = 'Validasi Masuk ' + noValidasi + ' | Memo ' + noMemo + (r.noInvoices.length ? ' | Inv ' + r.noInvoices.join(', ') : '');
      totalFisik += F;

      if (r.status === 'sesuai') {
        qtyMasuk = F;
        ledger(r.sku, F, ketDasar, harga);
      } else if (r.status === 'lebih' || r.status === 'nyasar') {
        tindakan = tindakanLebih;
        var selisihLebih = F - I;
        if (I > 0) ledger(r.sku, I, ketDasar, harga);
        if (tindakan === 'bonus') {
          // Stock bertambah sejumlah FISIK; kelebihan = barang gratis (harga modal 0) + Jurnal Penyesuaian Positif
          ledger(r.sku, selisihLebih, ketDasar + ' | Penyesuaian Positif (Bonus Supplier)', 0);
          var hargaRef = harga || (d.master[vmNormSku(r.sku)] || {}).hargaSupplier || 0;
          jurnal(r, 'Positif', selisihLebih, hargaRef, 'bonus');
          qtyMasuk = F;
        } else {
          qtyMasuk = I; // kelebihan diabaikan (akan diretur ke supplier)
        }
      } else { // kurang / belum dikirim
        tindakan = tindakanKurang;
        var selisihKurang = I - F;
        ledger(r.sku, F, ketDasar, harga);
        qtyMasuk = F;
        if (tindakan === 'klaim') {
          flag = 'KLAIM'; adaKlaim = true;
          barisClaim.push([r.noInvoices.join(', '), noValidasi, waktu, r.sku, r.nama, 'Kurang', selisihKurang, namaStaff]);
        } else {
          jurnal(r, 'Negatif', selisihKurang, harga, 'hilang'); // tagihan dianggap utuh, selisih = kerugian
        }
      }
      totalMasuk += qtyMasuk;
      barisDetail.push([noValidasi, iso, r.sku, r.nama, F, I, F - I, VM_LABEL_STATUS[r.status], tindakan ? VM_LABEL_TINDAKAN[tindakan] : '-', qtyMasuk, harga, r.noInvoices.join(', ') || '-', flag]);
    });

    var statusRekon = (adaLebih || adaKurang) ? 'SELISIH' : 'SESUAI';

    // ===== Tulis semua (batch) =====
    var shLedger = getStockLedgerSheet();
    if (shLedger.getLastColumn() < 9) shLedger.getRange(1, 9).setValue('Timestamp Presisi (ISO)').setFontWeight('bold');
    // P1: memo yang stoknya SUDAH masuk langsung dari HP -> baris "Stok Langsung HP" diganti baris validasi
    // (waktu fisik sama, kini lengkap dengan harga modal) supaya stok tidak bertambah dua kali.
    try { bmHapusStokLangsung_(memoIds); } catch (eLg) { Logger.log('Hapus stok langsung gagal: ' + eLg); }
    if (barisLedger.length) sisipkanLedgerKronologis_(shLedger, barisLedger, 9); // disisipkan sesuai urutan waktu fisik

    shV.header.appendRow([noValidasi, waktu, iso, epoch, isoKlik, noMemo, String(data.noSuratJalan || memo.noSuratJalan || '').trim(), noInvGabung,
      statusRekon, adaKlaim ? 'KLAIM' : '-', tindakanLebih ? VM_LABEL_TINDAKAN[tindakanLebih] : '-', tindakanKurang ? VM_LABEL_TINDAKAN[tindakanKurang] : '-',
      catatan || '-', linkFotoSJ || '-', namaStaff, totalFisik, totalMasuk]);
    if (barisDetail.length) shV.detail.getRange(shV.detail.getLastRow() + 1, 1, barisDetail.length, 13).setValues(barisDetail);

    if (barisJurnal.length) {
      var shJ = getJurnalPenyesuaianStokSheet();
      shJ.getRange(shJ.getLastRow() + 1, 1, barisJurnal.length, 15).setValues(barisJurnal);
    }
    if (barisClaim.length) {
      var shC = getClaimKurangRusakSheet();
      shC.getRange(shC.getLastRow() + 1, 1, barisClaim.length, 8).setValues(barisClaim);
    }

    // Memo -> Tervalidasi (+ No SJ final, invoice tertaut, No Validasi)
    // Update status SEMUA memo yang ikut digabung -> Selesai (flag Klaim kalau ada selisih yang diklaim)
    var noSJFinal = String(data.noSuratJalan || memo.noSuratJalan || '').trim();
    var statusAkhirMemo = adaKlaim ? 'Selesai (Klaim)' : 'Selesai';
    memos.forEach(function (m) {
      d.shMemo.header.getRange(m.row, 3).setValue(statusAkhirMemo);
      d.shMemo.header.getRange(m.row, 5, 1, 5).setValues([[namaStaff, waktu, noInvGabung, noSJFinal || m.noSuratJalan || '', noValidasi]]);
    });
    // Invoice pembelian -> Sudah Dicek (nggak muncul lagi di daftar yang belum divalidasi)
    invoices.forEach(function (inv) { d.shBeli.header.getRange(inv.row, 9).setValue('Sudah Dicek'); });

    result.success = true;
    result.noValidasi = noValidasi;
    result.memoIds = memoIds;
    result.statusMemo = statusAkhirMemo;
    result.timestampIso = iso;
    result.statusRekon = statusRekon;
    result.totalMasuk = totalMasuk;
    result.jumlahJurnal = barisJurnal.length;
    result.jumlahKlaim = barisClaim.length;
    result.linkFotoSJ = linkFotoSJ;
    hitungUlangSaldoStok_();
    return result;
  }, {
    tungguMs: 20000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}


/* ====================================================================================
   PERSEDIAAN v2 - MESIN STOK BERBASIS TIMESTAMP FISIK
   - Smart Opname by Timestamp (opname tanpa tutup toko) -> sheet Log_Opname
   - Monitor Stok 4 Pilar (On Hand / On Order / On Reserve / On Available)
   - Rekonsiliasi Mutasi Malam (runNightlyReconciliation, 02:00) -> sheet Master Stok

   PRINSIP UTAMA - yang dipakai adalah WAKTU FISIK barang bergerak, bukan waktu data dicatat:
   * KELUAR  = waktu resi DISCAN keluar (Resi Keluar). Pesanan marketplace TIDAK dipotong di waktu
               order dibuat (create_time) - karena selama belum discan, barangnya masih di rak dan
               ikut terhitung saat opname. Ledger 'Terjual Online' (create_time) sengaja diabaikan
               mesin ini supaya tidak dobel.
   * MASUK   = Validasi Masuk memakai waktu Memo Gudang dibuat (barang fisik tiba), bukan waktu
               back-office klik eksekusi. Kalau barang tiba 09:30, opname 10:00, divalidasi 14:00,
               barang itu SUDAH ikut terhitung di opname -> tidak boleh ditambah lagi.
   * Event dengan waktu == waktu opname dianggap sudah ikut terhitung (<=).
   Fungsi stock lama (hitungStockSatuSku, prosesLihatStock, dst) TIDAK diubah sama sekali.
   ==================================================================================== */
var SM_SHEET_LOG_OPNAME = 'Log_Opname';
var SM_SHEET_MASTER_STOK = 'Master Stok';
var SM_SHEET_LOG_REKON = 'Log_Rekonsiliasi';
var SM_CACHE_MONITOR = 'MONITOR_STOK_V2';
var SM_PROP_REKON_TERAKHIR = 'REKON_MALAM_TERAKHIR';
var SM_STATUS_MP_BATAL = { CANCELLED: 1, CANCELED: 1, IN_CANCEL: 1 };
// Status marketplace yang artinya barang PASTI sudah keluar gudang (dipakai kalau resinya lupa discan)
var SM_STATUS_MP_SUDAH_KELUAR = { IN_TRANSIT: 1, DELIVERED: 1, COMPLETED: 1, SHIPPED: 1, TO_CONFIRM_RECEIVE: 1, TO_RETURN: 1 };
var SM_HARI_RESERVE_PO_DIKIRIM = 30; // (lama - tidak dipakai lagi sejak S2: status Dikirim = stok keluar)
// S3: order marketplace yang statusnya tidak bergerak > N hari dilepas dari reserve (masuk daftar "Reserve Macet")
var SM_HARI_RESERVE_MACET = 14;
// S4: status marketplace "belum dibayar" - tetap mengunci stok (anti oversell), tapi dipisah sebagai Reserve Belum Bayar
var SM_STATUS_MP_BELUM_BAYAR = { UNPAID: 1, AWAITING_PAYMENT: 1, PENDING_PAYMENT: 1 };
// PO Sales yang dianggap SUDAH KELUAR gudang (stok dipotong saat status ini dipasang)
var SM_STATUS_PO_KELUAR = { 'Dikirim': 1, 'Selesai': 1 };
var SM_SUMBER_MARKETPLACE = [
  { label: 'TikTok Shop', header: 'Pesanan TikTok Shop', detail: 'Pesanan TikTok Shop Detail' },
  { label: 'Shopee', header: 'Pesanan Shopee', detail: 'Pesanan Shopee Detail' },
  { label: 'Conner', header: 'Pesanan Conner', detail: 'Pesanan Conner Detail' }
];

function smKey(s) { return String(s || '').trim().toUpperCase(); }
function smMs(v) {
  if (v instanceof Date) return v.getTime();
  if (typeof v === 'number') return v;
  if (!v) return 0;
  var d = new Date(v);
  return isNaN(d.getTime()) ? 0 : d.getTime();
}
function smFmt(ms) { return ms ? Utilities.formatDate(new Date(ms), Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm:ss') : ''; }
function smIso(ms) { return ms ? Utilities.formatDate(new Date(ms), Session.getScriptTimeZone(), "yyyy-MM-dd'T'HH:mm:ss.SSSXXX") : ''; }
// Memo baca sheet OPSIONAL (hanya aktif kalau pemanggil mengisinya, mis. opname massal membaca
// ulang sheet yang sama untuk banyak SKU). Default null = selalu baca segar seperti biasa.
var SM_MEMO_BACA_ = null;
function smBacaSheet(nama, jumlahKolom) {
  var kunciMemo = nama + '|' + jumlahKolom;
  if (SM_MEMO_BACA_ && SM_MEMO_BACA_[kunciMemo]) return SM_MEMO_BACA_[kunciMemo];
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(nama);
  if (!sh) return [];
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return [];
  var kolom = Math.min(jumlahKolom, sh.getLastColumn());
  if (kolom < 1) return [];
  var hasil = sh.getRange(2, 1, lastRow - 1, kolom).getValues();
  if (SM_MEMO_BACA_) SM_MEMO_BACA_[kunciMemo] = hasil;
  return hasil;
}

function getLogOpnameSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SM_SHEET_LOG_OPNAME);
  if (!sh) {
    sh = ss.insertSheet(SM_SHEET_LOG_OPNAME);
    sh.getRange(1, 1, 1, 13).setValues([[
      'ID Opname', 'Timestamp Absolut', 'Timestamp ISO', 'Epoch (ms)', 'SKU', 'Nama Produk',
      'Qty Fisik Aktual', 'Qty Sistem Saat Opname', 'Selisih', 'Catatan', 'Dicatat Oleh', 'Waktu Klik Perangkat (ISO)', 'Toko'
    ]]).setFontWeight('bold');
    sh.getRange('B:B').setNumberFormat('dd/MM/yyyy HH:mm:ss');
    sh.getRange('E:E').setNumberFormat('@');
    sh.setFrozenRows(1);
  }
  return sh;
}

function getMasterStokSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SM_SHEET_MASTER_STOK);
  if (!sh) {
    sh = ss.insertSheet(SM_SHEET_MASTER_STOK);
    sh.getRange(1, 1, 1, 13).setValues([[
      'SKU', 'Nama Produk', 'On Hand', 'Qty Opname Terakhir', 'Waktu Opname Terakhir', 'Masuk Sejak Opname',
      'Keluar (Resi) Sejak Opname', 'Penyesuaian Sejak Opname', 'On Hand Sebelumnya', 'Selisih vs Sebelumnya',
      'Keluar Tanpa Scan', 'Terdaftar di Master', 'Rekon Terakhir'
    ]]).setFontWeight('bold');
    sh.getRange('A:A').setNumberFormat('@');
    sh.setFrozenRows(1);
  }
  return sh;
}

function getLogRekonsiliasiSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SM_SHEET_LOG_REKON);
  if (!sh) {
    sh = ss.insertSheet(SM_SHEET_LOG_REKON);
    sh.getRange(1, 1, 1, 10).setValues([[
      'Waktu Mulai', 'Timestamp ISO', 'Durasi (detik)', 'Dijalankan Oleh', 'Jumlah SKU', 'SKU Berubah',
      'Total Selisih Absolut', 'Order Keluar Tanpa Scan', 'Status', 'Catatan'
    ]]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

function smInvalidasiCache() {
  smNaikkanVersiStok_(); // snapshot peta stok jadi "basi" (tetap boleh tampil instan, lalu disegarkan)
  try {
    CacheService.getScriptCache().removeAll([SM_CACHE_MONITOR, 'POSISI_STOCK_default', 'POSISI_STOCK_default__meta', 'POSISI_STOK_LENGKAP_default']);
  } catch (e) { /* cache bukan hal kritis */ }
}

/* ------------------------------------------------------------------------------------
   MESIN UTAMA. Read-only (tidak menulis apa pun) - aman dipanggil kapan saja.
   opsi.batasMs  : hitung posisi "per detik ini" (default: sekarang)
   opsi.sku      : hitung 1 SKU saja (lebih ringan di sisi olah data)
   opsi.timeline : sertakan daftar event per SKU (dipakai Kartu Stok di Log Mutasi)
   ------------------------------------------------------------------------------------ */
function smHitungMesinStok(opsi) {
  opsi = opsi || {};
  var batasMs = opsi.batasMs || Date.now();
  var filterKey = opsi.sku ? smKey(resolveSkuJual(opsi.sku)) : '';
  var denganTimeline = !!opsi.timeline;
  var peta = {};
  var statistik = { orderKeluarTanpaScan: 0, orderReserveMacet: 0, orderBelumBayar: 0, poKeluarTanpaJejak: 0, daftarMacet: [] };
  var batasMacetMs = Date.now() - SM_HARI_RESERVE_MACET * 86400000;

  // ALIAS: kode di SKU Supplier/Marketplace Terhubung yang BUKAN SKU master -> dihitung sebagai
  // SKU master pemiliknya. Data lama (pesanan/ledger yang tersimpan dengan kode mentah sebelum
  // dihubungkan) otomatis ikut menyatu ke produk induknya - tidak muncul lagi sebagai SKU ⚠️.
  var barisMaster = smBacaSheet(namaSheetToko('Master Produk'), KAT_KOL_STATUS); // s/d kolom Status Produk (soft delete)
  var skuMasterSet = {};
  barisMaster.forEach(function (r) { var km = smKey(r[0]); if (km) skuMasterSet[km] = true; });
  var alias = {};
  ['SKU Supplier Terhubung', 'SKU Marketplace Terhubung'].forEach(function (namaSh) {
    smBacaSheet(namaSh, 2).forEach(function (r) {
      var jual = smKey(r[0]);
      if (!jual || !skuMasterSet[jual]) return;
      String(r[1] || '').split(/[\s,;]+/).forEach(function (kode) {
        var kk = smKey(kode);
        if (kk && !skuMasterSet[kk] && !alias[kk]) alias[kk] = jual;
      });
    });
  });
  if (filterKey && !skuMasterSet[filterKey] && alias[filterKey]) filterKey = alias[filterKey];

  // abaikanAlias = true untuk data OPNAME: hitungan fisik lama atas kode alias tidak boleh
  // menimpa titik nol produk induknya.
  function ambil(sku, nama, abaikanAlias) {
    var k = smKey(sku);
    if (!k) return null;
    if (!skuMasterSet[k] && alias[k]) { if (abaikanAlias) return null; k = alias[k]; nama = null; }
    if (filterKey && k !== filterKey) return null;
    var p = peta[k];
    if (!p) {
      p = peta[k] = {
        sku: String(sku).trim(), nama: nama ? String(nama).trim() : '', terdaftar: false,
        anchorMs: 0, anchorQty: null, anchorSumber: '', anchorId: '',
        events: [], onOrder: 0, onReserve: 0, keluarTanpaScan: 0, reserveBelumBayar: 0, reserveMacet: 0
      };
    } else if (nama && !p.nama) p.nama = String(nama).trim();
    return p;
  }
  function tambahEvent(p, t, qty, kategori, ket, sumber) {
    if (!p || !t || !qty) return;
    p.events.push({ t: t, qty: qty, kategori: kategori, ket: ket, sumber: sumber });
  }

  // 1) Master Produk - daftar resmi SKU + nama
  barisMaster.forEach(function (r) {
    var p = ambil(r[0], r[1]);
    if (!p) return;
    p.terdaftar = true; // produk ARSIP tetap "terdaftar" (tidak jadi ⚠️) - histori stoknya tetap punya induk
    p.arsip = katApakahArsip_(r[KAT_KOL_STATUS - 1]);
    p.sku = String(r[0]).trim();
    if (r[1]) p.nama = String(r[1]).trim();
  });

  // 2) Anchor dari Log_Opname (Smart Opname) - ambil yang TERBARU per SKU
  //    v2026.10.22: baris "OPNAME AWAL OTOMATIS" = titik awal SKU yang belum pernah di-opname (dibuat sekali saat
  //    Rekonsiliasi Malam dihentikan, smKunciOpnameAwal_). Ditandai anchorOtomatis -> lihat langkah 9.
  smBacaSheet(SM_SHEET_LOG_OPNAME, 10).forEach(function (r) {
    var ms = parseFloat(r[3]) || smMs(r[1]);
    if (!ms || ms > batasMs) return;
    var p = ambil(r[4], r[5], true);
    if (!p) return;
    if (ms >= p.anchorMs) {
      var ket = String(r[9] || ''), oto = ket.indexOf(SM_TANDA_OPNAME_AWAL_) === 0;
      p.anchorMs = ms; p.anchorQty = parseFloat(r[6]) || 0; p.anchorSumber = oto ? 'Opname Awal Otomatis' : 'Smart Opname'; p.anchorId = String(r[0] || '');
      p.anchorOtomatis = oto;
      if (oto) { var mN = ket.match(/\[n=(\d+)\]/); p.anchorN = mN ? parseInt(mN[1], 10) : 0; p.anchorSistem = parseFloat(r[7]) || 0; }
    }
  });

  // 2b) Peta scan Resi Keluar (dibaca LEBIH AWAL - dipakai ledger PO Sales & pesanan marketplace)
  //     No Resi -> waktu scan (kolom 3), abaikan yang masih Pending (kolom 11)
  var scanMap = {};
  smBacaSheet('Resi Keluar', 11).forEach(function (r) {
    var resi = kunciResi_(r[0]); // smart matching: abaikan nol di depan
    if (!resi) return;
    if (String(r[10] || '').trim() === 'Pending') return;
    var ms = smMs(r[2]);
    if (ms) scanMap[resi] = ms;
  });
  // 2c) Pesanan Manual (PO Sales): No Invoice -> { tglMs, status, waktu scan resinya }
  var poHeader = {};
  smBacaSheet('Pesanan Manual', 12).forEach(function (r) {
    var noInv = String(r[0] || '').trim();
    if (!noInv) return;
    var scan = 0;
    pecahResi_(r[10], '').concat([r[10]]).forEach(function (x) { var kk = kunciResi_(x); if (kk && scanMap[kk] && (!scan || scanMap[kk] < scan)) scan = scanMap[kk]; });
    poHeader[noInv] = { tglMs: smMs(r[1]), status: String(r[11] || '').trim(), scanMs: scan };
  });
  var poSudahLedger = {}; // invoice PO Sales yang stoknya sudah dipotong di Stock Ledger

  // 3) Waktu fisik barang tiba per No Validasi (dari Memo Gudang: kolom 2 = Tanggal, kolom 9 = No Validasi)
  var waktuFisikPerValidasi = {};
  smBacaSheet('Memo Catat Barang Masuk', 9).forEach(function (r) {
    var noVal = String(r[8] || '').trim();
    var ms = smMs(r[1]);
    if (!noVal || !ms) return;
    if (!waktuFisikPerValidasi[noVal] || ms > waktuFisikPerValidasi[noVal]) waktuFisikPerValidasi[noVal] = ms;
  });

  // 4) Stock Ledger - Masuk / Keluar / Penyesuaian / Opname lama
  // v2026.10.121 (DN-251): memo yang SUDAH divalidasi -> baris "Stok Langsung HP <memo>" diabaikan (pengganti resminya
  // = baris "Validasi Masuk ... | Memo <memo>"), walau baris langsung belum sempat terhapus -> stok tidak pernah dobel.
  var memoTervalidasi = {};
  smBacaSheet(namaSheetToko('Stock Ledger'), 6).forEach(function (r) {
    var mV = String(r[4] || '').match(/^Validasi Masuk \S+ \| Memo ([^|]+)/);
    if (mV) mV[1].split(',').forEach(function (x) { x = x.trim(); if (x) memoTervalidasi[x] = 1; });
  });
  smBacaSheet(namaSheetToko('Stock Ledger'), 6).forEach(function (r) {
    var ms = smMs(r[0]);
    if (!ms || ms > batasMs) return;
    var jenis = String(r[2] || '').trim();
    var qty = Math.abs(parseFloat(r[3]) || 0);
    var ket = String(r[4] || '');
    var mLg = ket.match(/^Stok Langsung HP (\S+)/);
    if (mLg && memoTervalidasi[mLg[1]]) return;
    if (ket.indexOf('Smart Opname') === 0) return; // cermin dari Log_Opname - sudah dihitung di langkah 2
    if (jenis === 'Terjual Online') return;        // diganti versi berbasis scan resi (langkah 6)
    var p = ambil(r[1], null, jenis === 'Opname');
    if (!p) return;
    if (jenis === 'Opname') {
      if (ms > p.anchorMs) { p.anchorMs = ms; p.anchorQty = parseFloat(r[3]) || 0; p.anchorSumber = 'Opname (cara lama)'; p.anchorId = ket; p.anchorOtomatis = false; }
    } else if (jenis === 'Masuk') {
      var t = ms;
      var cocok = ket.match(/^Validasi Masuk (\S+)/);
      if (cocok && waktuFisikPerValidasi[cocok[1]] && waktuFisikPerValidasi[cocok[1]] < ms) t = waktuFisikPerValidasi[cocok[1]];
      tambahEvent(p, t, qty, 'masuk', ket + (t !== ms ? ' [waktu fisik = memo gudang]' : ''), 'Ledger');
    } else if (jenis === 'Terjual PO Sales') {
      // S2: potongan otomatis saat status "Dikirim" memakai waktu SCAN resi kalau resinya discan
      // (waktu fisik barang benar-benar keluar) - aman untuk Smart Opname di antara keduanya.
      var invPo = poInvoiceDariKet_(ket), tPo = ms, sumberPo = 'Scan Resi (PO Sales)';
      if (invPo) poSudahLedger[invPo] = true;
      if (ket.indexOf(PO_TANDA_DIKIRIM_) === 0) {
        var hPo = poHeader[invPo];
        if (hPo && hPo.scanMs && hPo.scanMs <= batasMs) tPo = hPo.scanMs;
        sumberPo = hPo && hPo.scanMs ? 'Scan Resi (PO Sales)' : 'Dikirim (PO Sales)';
      }
      if (tPo > batasMs) return;
      tambahEvent(p, tPo, -qty, 'keluar', ket + (tPo !== ms ? ' [waktu fisik = scan resi]' : ''), sumberPo);
    } else if (jenis === 'Transfer Gudang Shopee') {
      // Pindah gudang (FBS): keluar dari Gudang Utama, BUKAN penjualan (tidak masuk omzet/item terjual)
      tambahEvent(p, ms, -qty, 'keluar', ket, 'Transfer Gudang Shopee');
    } else if (jenis === 'Pemakaian Produksi') {
      // Dipakai sebagai bahan di Perintah Produksi (barang setengah jadi -> barang jadi), bukan penjualan
      tambahEvent(p, ms, -qty, 'keluar', ket, 'Produksi');
    } else if (jenis === 'Rusak/Hilang' || jenis === 'Keluar') {
      tambahEvent(p, ms, -qty, 'penyesuaian', jenis + (ket ? ' - ' + ket : ''), 'Ledger');
    }
  });

  // 5) (peta scan Resi Keluar sudah dibaca di langkah 2b)

  // 6) Pesanan marketplace (API): KELUAR saat resi discan; kalau belum discan -> RESERVE
  SM_SUMBER_MARKETPLACE.forEach(function (src) {
    var order = {};
    smBacaSheet(src.header, 7).forEach(function (r) {
      var id = String(r[0] || '').trim();
      if (id) order[id] = { tglMs: smMs(r[1]), status: String(r[4] || '').trim().toUpperCase(), resi: resiTeks_(r[6], r[5]) };
    });
    var itemPerOrder = {};
    smBacaSheet(src.detail, 3).forEach(function (r) {
      var id = String(r[0] || '').trim();
      if (!id || !order[id]) return;
      var qtyDetail = parseFloat(r[2]) || 0;
      // Data lama: SKU bundling (mis. "SKU1+SKU2") tersimpan utuh -> dipecah di sini supaya stok tiap SKU induk terpotong
      pecahSkuPesananBundling_(r[1], qtyDetail).forEach(function (b) {
        (itemPerOrder[id] = itemPerOrder[id] || []).push({ sku: b.sku, qty: b.qty });
      });
    });
    Object.keys(itemPerOrder).forEach(function (id) {
      var o = order[id];
      var waktuScan = kunciResi_(o.resi) ? (scanMap[kunciResi_(o.resi)] || 0) : 0;
      var tanpaScan = false, jadiReserve = false, waktuKeluar = 0, macet = false, belumBayar = false;
      if (waktuScan && waktuScan <= batasMs) waktuKeluar = waktuScan;
      else if (SM_STATUS_MP_BATAL[o.status]) return;
      else if (SM_STATUS_MP_SUDAH_KELUAR[o.status]) { if (o.tglMs && o.tglMs <= batasMs) { waktuKeluar = o.tglMs; tanpaScan = true; } }
      else if (!o.tglMs || o.tglMs <= batasMs) {
        // S3: status tidak bergerak > SM_HARI_RESERVE_MACET hari -> dilepas dari reserve (dicatat sebagai macet)
        if (o.tglMs && o.tglMs < batasMacetMs) macet = true;
        else { jadiReserve = true; belumBayar = !!SM_STATUS_MP_BELUM_BAYAR[o.status]; }
      }
      if (tanpaScan) statistik.orderKeluarTanpaScan++;
      if (macet) {
        statistik.orderReserveMacet++;
        if (statistik.daftarMacet.length < 50) statistik.daftarMacet.push({ sumber: src.label, id: id, status: o.status, tanggal: smFmt(o.tglMs), resi: o.resi || '' });
      }
      if (belumBayar) statistik.orderBelumBayar++;
      itemPerOrder[id].forEach(function (it) {
        if (!it.qty) return;
        var p = ambil(it.sku);
        if (!p) return;
        if (macet) { p.reserveMacet += it.qty; return; }
        if (jadiReserve) { p.onReserve += it.qty; if (belumBayar) p.reserveBelumBayar += it.qty; return; }
        if (!waktuKeluar) return;
        if (tanpaScan) p.keluarTanpaScan += it.qty;
        tambahEvent(p, waktuKeluar, -it.qty, 'keluar',
          (tanpaScan ? 'Keluar TANPA scan (fallback waktu order) ' : 'Resi ' + o.resi + ' discan keluar ') + '- ' + src.label + ' #' + id,
          tanpaScan ? src.label + ' (tanpa scan)' : 'Scan Resi (' + src.label + ')');
      });
    });
  });

  // 7) PO Sales (Pesanan Manual)
  //    - Status kosong (belum dikirim) & belum discan  -> RESERVE
  //    - Status Dikirim/Selesai                         -> KELUAR lewat ledger 'Terjual PO Sales' (S2: ditulis
  //      otomatis saat status Dikirim / foto Kurir Toko / scan resi - mana yang duluan, tidak pernah dobel).
  //    - Data LAMA berstatus Dikirim/Selesai tanpa jejak ledger & tanpa scan -> dipotong pada waktu pesanan
  //      (ditandai "tanpa jejak") supaya stok tidak lagi "kembali" diam-diam setelah 30 hari seperti dulu.
  var invReserve = {}, invTanpaJejak = {};
  Object.keys(poHeader).forEach(function (noInv) {
    var h = poHeader[noInv];
    if (h.status === 'Dibatalkan') return;
    if (poSudahLedger[noInv]) return;          // sudah dipotong lewat ledger
    if (h.scanMs) return;                       // discan tapi ledger belum ada (kasus langka) - ditangani scan
    if (h.status === '') invReserve[noInv] = true;
    else if (SM_STATUS_PO_KELUAR[h.status] && h.tglMs && h.tglMs <= batasMs) invTanpaJejak[noInv] = true;
  });
  smBacaSheet('Pesanan Manual Detail', 4).forEach(function (r) {
    var noInv = String(r[0] || '').trim();
    var qty = parseFloat(r[3]) || 0;
    if (!qty) return;
    if (invReserve[noInv]) { var p = ambil(r[1], r[2]); if (p) p.onReserve += qty; return; }
    if (invTanpaJejak[noInv]) {
      var p2 = ambil(r[1], r[2]);
      if (!p2) return;
      p2.keluarTanpaScan += qty;
      tambahEvent(p2, poHeader[noInv].tglMs, -qty, 'keluar', 'PO Sales ' + noInv + ' berstatus ' + poHeader[noInv].status + ' tanpa scan/jejak stok (data lama) - dipotong pada waktu pesanan', 'PO Sales (tanpa jejak)');
    }
  });
  statistik.poKeluarTanpaJejak = Object.keys(invTanpaJejak).length;

  // 8) ON ORDER = Invoice Pembelian yang belum divalidasi + sisa Purchase Order yang belum diterima
  var invBelumValidasi = {};
  smBacaSheet('Pembelian Manual', 10).forEach(function (r) {
    var no = String(r[0] || '').trim();
    if (!no) return;
    if ((r[9] || 'Aktif') === 'Dibatalkan') return;
    if ((r[8] || 'Belum Dicek') !== 'Belum Dicek') return;
    invBelumValidasi[no] = true;
  });
  smBacaSheet('Pembelian Manual Detail', 4).forEach(function (r) {
    if (!invBelumValidasi[String(r[0] || '').trim()]) return;
    var p = ambil(resolveSkuJualCepat_(r[1]), r[2]);
    if (p) p.onOrder += parseFloat(r[3]) || 0;
  });
  var statusPO = {};
  smBacaSheet('Purchase Order', 4).forEach(function (r) { statusPO[String(r[0] || '').trim()] = String(r[3] || '').trim(); });
  smBacaSheet('Purchase Order Detail', 5).forEach(function (r) {
    if (statusPO[String(r[0] || '').trim()] === 'Dibatalkan') return;
    var sisa = (parseFloat(r[3]) || 0) - (parseFloat(r[4]) || 0);
    if (sisa <= 0) return;
    var p = ambil(r[1], r[2]);
    if (p) p.onOrder += sisa;
  });

  // 9) Kalkulasi: On Hand = Qty Opname + Masuk - Keluar - Penyesuaian (semua SETELAH detik opname)
  var daftar = Object.keys(peta).map(function (k) {
    var p = peta[k];
    p.events.sort(function (a, b) { return a.t - b.t; });
    var punyaAnchor = p.anchorQty !== null;
    var saldo = punyaAnchor ? p.anchorQty : 0;
    // v2026.10.22 Opname Awal Otomatis (pilihan A Owner): angka titik awal DIKUNCI - data lama yang hilang / diubah tidak
    // menggeser stok. Tetapi data yang TERLAMBAT tercatat dengan waktu sebelum titik awal (mis. pesanan Conner yang baru
    // tertarik, memo masuk yang divalidasi belakangan) tetap dihitung: bila jumlah event <= titik awal sekarang >= saat
    // dikunci, selisih jumlahnya ditambahkan.
    var koreksiAwal = 0;
    if (punyaAnchor && p.anchorOtomatis) {
      var nSblm = 0, sSblm = 0;
      p.events.forEach(function (e) { if (e.t <= p.anchorMs) { nSblm++; sSblm += e.qty; } });
      if (nSblm > (p.anchorN || 0)) koreksiAwal = sSblm - (p.anchorSistem || 0);
      saldo += koreksiAwal;
    }
    var masuk = 0, keluar = 0, penyesuaian = 0;
    var timeline = [];
    p.events.forEach(function (e) {
      var diabaikan = punyaAnchor && e.t <= p.anchorMs;
      if (!diabaikan) {
        saldo += e.qty;
        if (e.kategori === 'masuk') masuk += e.qty;
        else if (e.kategori === 'keluar') keluar += -e.qty;
        else penyesuaian += -e.qty;
      }
      if (denganTimeline) timeline.push({ t: e.t, waktu: smFmt(e.t), qty: e.qty, kategori: e.kategori, ket: e.ket, sumber: e.sumber, diabaikan: diabaikan, saldo: diabaikan ? null : saldo });
    });
    var hasil = {
      sku: p.sku, nama: p.nama || '', terdaftar: p.terdaftar, arsip: !!p.arsip,
      onHand: saldo, onOrder: p.onOrder, onReserve: p.onReserve, onAvailable: saldo - p.onReserve,
      reserveBelumBayar: p.reserveBelumBayar, reserveMacet: p.reserveMacet,
      anchorMs: punyaAnchor ? p.anchorMs : 0, anchorQty: punyaAnchor ? p.anchorQty + koreksiAwal : null, anchorSumber: p.anchorSumber, anchorId: p.anchorId,
      anchorOtomatis: !!(punyaAnchor && p.anchorOtomatis), koreksiAwal: koreksiAwal,
      masuk: masuk, keluar: keluar, penyesuaian: penyesuaian, keluarTanpaScan: p.keluarTanpaScan,
      adaAktivitas: punyaAnchor || p.events.length > 0 || p.onOrder > 0 || p.onReserve > 0,
      tAkhir: p.events.reduce(function (m, e) { return e.t > m ? e.t : m; }, punyaAnchor ? p.anchorMs : 0)
    };
    if (denganTimeline) hasil.timeline = timeline;
    return hasil;
  });
  daftar.sort(function (a, b) { return a.sku.localeCompare(b.sku); });
  return { daftar: daftar, batasMs: batasMs, statistik: statistik };
}

// PETA SKU INDUK (di-memo per eksekusi). Satu produk = 1 SKU Jual (Produk Master); SEMUA kode yang
// terhubung ke produk itu - SKU Supplier, SKU Marketplace (sheet "SKU Marketplace Terhubung") dan kolom
// "SKU Terhubung Shopee/TikTok/Tokopedia" di Produk Master - diterjemahkan ke SKU Jual yang sama.
// Dipakai Laporan Keuangan (HPP, pembelian, nilai stok) -> SKU marketplace yang terjual kini terbaca
// sebagai produk induknya, sama seperti mesin stok. Kode yang SENDIRINYA SKU master tidak dialihkan.
var SM_MEMO_SKU_JUAL_ = null;
function petaSkuInduk_() {
  if (SM_MEMO_SKU_JUAL_) return SM_MEMO_SKU_JUAL_;
  var peta = { persis: {}, besar: {}, master: {}, perInduk: {} };
  function norm(x) { return String(x || '').replace(/[\u200B-\u200D\u2060\uFEFF\u00AD]/g, '').replace(/\u00A0/g, ' ').trim(); }
  try {
    var shM = getMasterProdukSheet(), lrM = shM.getLastRow();
    var kol = null;
    try { SYNC_KOLOM_MEMO_ = null; kol = syncKolomSkuTerhubungMaster_(); } catch (eK) { kol = null; }
    if (lrM > 1) {
      var lebar = shM.getLastColumn();
      var isiM = shM.getRange(2, 1, lrM - 1, lebar).getDisplayValues();
      isiM.forEach(function (r) { var m = norm(r[0]); if (m) peta.master[m.toUpperCase()] = m; });
      isiM.forEach(function (r) {
        var m = norm(r[0]); if (!m) return;
        ['Shopee', 'TikTok Shop', 'Tokopedia'].forEach(function (pf) {
          var k = kol && kol[pf]; if (!k || k.dobel) return;
          String(r[k.nomor - 1] || '').split(/[,;\r\n\s]+/).forEach(function (kode) { tambah(kode, m, pf); });
        });
      });
    }
  } catch (eM) { }
  function tambah(kode, induk, jenis) {
    kode = norm(kode); induk = norm(induk);
    if (!kode || !induk || kode === induk) return;
    var indukResmi = peta.master[induk.toUpperCase()] || induk;
    if (peta.master[kode.toUpperCase()]) return; // kode ini produk master sendiri -> jangan dialihkan
    if (!peta.persis[kode]) peta.persis[kode] = indukResmi;
    if (!peta.besar[kode.toUpperCase()]) peta.besar[kode.toUpperCase()] = indukResmi;
    var d = peta.perInduk[indukResmi] || (peta.perInduk[indukResmi] = []);
    if (!d.some(function (x) { return x.kode === kode && x.jenis === jenis; })) d.push({ kode: kode, jenis: jenis });
  }
  try {
    var sh = getSkuSupplierTerhubungSheet(), lr = sh.getLastRow();
    if (lr > 1) sh.getRange(2, 1, lr - 1, 3).getValues().forEach(function (r) {
      String(r[1]).split(/[\s,;]+/).forEach(function (kode) { tambah(kode, r[0], 'Supplier' + (String(r[2] || '').trim() ? ' · ' + String(r[2]).trim() : '')); });
    });
  } catch (eS) { }
  try {
    var shMp = getSkuMarketplaceTerhubungSheet(), lrMp = shMp.getLastRow();
    if (lrMp > 1) shMp.getRange(2, 1, lrMp - 1, 3).getValues().forEach(function (r) {
      var pl = String(r[2] || '').trim();
      var jenis = /shopee/i.test(pl) ? 'Shopee' : /tiktok/i.test(pl) ? 'TikTok Shop' : /tokopedia/i.test(pl) ? 'Tokopedia' : (pl || 'Marketplace');
      String(r[1]).split(/[\s,;]+/).forEach(function (kode) { tambah(kode, r[0], jenis); });
    });
  } catch (eMp) { }
  SM_MEMO_SKU_JUAL_ = peta;
  return peta;
}
function resolveSkuJualCepat_(sku) {
  var bersih = String(sku || '').trim();
  if (!bersih) return bersih;
  var p = petaSkuInduk_();
  if (p.master[bersih.toUpperCase()]) return p.master[bersih.toUpperCase()];
  return p.persis[bersih] || p.besar[bersih.toUpperCase()] || bersih;
}

/* ------------------------------------------------------------------------------------
   MONITOR STOK (4 Pilar) - live, memakai mesin yang SAMA dengan rekonsiliasi malam
   ------------------------------------------------------------------------------------ */
function prosesLihatMonitorStok(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var cache = CacheService.getScriptCache();
    if (!data.segarkan) {
      var dariCache = cache.get(SM_CACHE_MONITOR);
      if (dariCache) { try { return JSON.parse(dariCache); } catch (eC) { /* korup, hitung ulang */ } }
    }
    try { smKunciOpnameAwal_(); } catch (eAwal) { Logger.log('Opname awal otomatis: ' + eAwal); } // sekali saja (Paket 9)
    var mesin = smHitungMesinStok({});
    var lepasAbaikan = p88KodeLepasBaca_(), nDisembunyikan = 0; // v2026.10.108 (DN-476)
    var daftar = mesin.daftar.filter(smPerluTampil_).filter(function (p) {
      if (p.terdaftar) return true;
      var t = lepasAbaikan[smKey(p.sku)];
      if (t && (p.tAkhir || 0) <= t && !(p.onOrder > 0) && !(p.onReserve > 0)) { nDisembunyikan++; return false; }
      return true;
    }).map(function (p) {
      return {
        sku: p.sku, nama: p.nama, terdaftar: p.terdaftar, arsip: !!p.arsip,
        onHand: p.onHand, onOrder: p.onOrder, onReserve: p.onReserve, onAvailable: p.onAvailable,
        opnameTerakhir: p.anchorMs && !p.anchorOtomatis ? smFmt(p.anchorMs) : '', qtyOpname: p.anchorQty, sumberOpname: p.anchorSumber,
        titikAwal: p.anchorOtomatis ? smFmt(p.anchorMs) : '',
        keluarTanpaScan: p.keluarTanpaScan,
        tAkhir: p.tAkhir || 0 // v2026.10.120 (DN-285): gerak stok terakhir (ms)
      };
    });
    var ringkasan = { totalSku: daftar.length, onHandMinus: 0, availableMinus: 0, belumMaster: 0, belumOpname: 0 };
    daftar.forEach(function (p) {
      if (p.onHand < 0) ringkasan.onHandMinus++;
      if (p.onAvailable < 0) ringkasan.availableMinus++;
      if (!p.terdaftar) ringkasan.belumMaster++;
      if (!p.opnameTerakhir) ringkasan.belumOpname++;
    });
    result.success = true;
    result.daftar = daftar;
    ringkasan.lepasDisembunyikan = nDisembunyikan;
    result.ringkasan = ringkasan;
    result.dihitungPada = smFmt(mesin.batasMs);
    result.orderKeluarTanpaScan = mesin.statistik.orderKeluarTanpaScan;
    // v2026.10.22: Rekonsiliasi Malam dihentikan - stok selalu dihitung langsung (Smart Opname terakhir + mutasi sesudahnya)
    result.modeStok = 'timestamp';
    try { result.opnameAwal = JSON.parse(PropertiesService.getScriptProperties().getProperty(SM_PROP_OPNAME_AWAL_) || 'null'); } catch (eP) { result.opnameAwal = null; }
    try { cache.put(SM_CACHE_MONITOR, JSON.stringify(result), 30); } catch (ePut) { /* kegedean buat cache */ }
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ------------------------------------------------------------------------------------
   SMART OPNAME BY TIMESTAMP
   Timestamp diambil DI AWAL request (sebelum antre lock) = detik staf menekan Rekam.
   Qty sistem pada detik itu ikut direkam sebagai referensi selisih (blind count: staf tidak
   melihat angka sistem sebelum menghitung).
   ------------------------------------------------------------------------------------ */
function prosesSmartOpnameSimpan(data) {
  if (!mgApakahOwner_(data.email)) return { success: false, error: 'Stock Opname hanya bisa dilakukan akun Owner.' }; // P1
  var waktu = new Date();
  var ms = waktu.getTime();
  var result = { success: false };
  var sku, qty, catatan, namaStaff, qtySistem = 0, nama = '', terdaftar = false;
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    sku = resolveSkuMarketplaceKeSkuJual(resolveSkuJual(String(data.sku || '').trim()));
    if (!sku) throw new Error('SKU wajib diisi.');
    var qtyMentah = data.qtyFisik;
    qty = parseFloat(qtyMentah);
    if (qtyMentah === '' || qtyMentah === null || qtyMentah === undefined || isNaN(qty) || qty < 0) throw new Error('Qty Fisik tidak valid (minimal 0).');
    catatan = String(data.catatan || '').trim().substring(0, 300);
    namaStaff = getNamaStaff(data.email);
    // Snapshot sistem TEPAT di detik opname (read-only, di luar lock biar nggak nahan scanner)
    var mesin = smHitungMesinStok({ sku: sku, batasMs: ms });
    var p = mesin.daftar[0];
    if (p) { qtySistem = p.onHand; nama = p.nama; terdaftar = p.terdaftar; sku = p.terdaftar ? p.sku : sku; }
  } catch (errAwal) { result.error = errAwal.toString(); return result; }

  var lock = kunciModul_('stok');
  try { lock.waitLock(15000); } catch (eLock) { result.error = 'Sistem sedang sibuk, coba lagi.'; return result; }
  var id, iso = smIso(ms);
  try {
    var toko = data.toko || 'Waterground';
    var waktuKlik = parseInt(data.waktuKlikMs, 10);
    var sh = getLogOpnameSheet();
    id = bikinNomorMemo(sh, 'OPN');
    var row = sh.getLastRow() + 1;
    sh.getRange(row, 5).setNumberFormat('@');
    sh.getRange(row, 1, 1, 13).setValues([[id, waktu, iso, ms, sku, nama, qty, qtySistem, qty - qtySistem, catatan, namaStaff, waktuKlik ? smIso(waktuKlik) : '', toko]]);

    // Cermin ke Stock Ledger sebagai 'Opname' -> modul lama (virtual stock, laporan, dst) ikut sinkron.
    // Mesin baru mengabaikan baris ini (sudah dibaca dari Log_Opname).
    var shL = getStockLedgerSheet();
    if (shL.getLastColumn() < 9) shL.getRange(1, 9).setValue('Timestamp Presisi (ISO)').setFontWeight('bold');
    var rowL = shL.getLastRow() + 1;
    shL.getRange(rowL, 2).setNumberFormat('@');
    shL.getRange(rowL, 1, 1, 9).setValues([[waktu, sku, 'Opname', qty, 'Smart Opname ' + id + (catatan ? ' - ' + catatan : ''), namaStaff, toko, 0, iso]]);
  } catch (err) {
    result.error = err.toString();
    return result;
  } finally { lepasKunci_(lock); }

  smInvalidasiCache();
  try {
    if (PropertiesService.getScriptProperties().getProperty('VIRTUAL_STOCK_AKTIF_TIKTOK') === 'true') {
      prosesUpdateVirtualStockSatuSku(sku, hitungStockSatuSku(sku));
    }
  } catch (eVS) { /* gagal sync TikTok tidak boleh menggagalkan opname */ }

  result.success = true;
  result.id = id;
  result.sku = sku;
  result.nama = nama;
  result.terdaftar = terdaftar;
  result.qtyFisik = qty;
  result.qtySistem = qtySistem;
  result.selisih = qty - qtySistem;
  result.timestampIso = iso;
  result.timestampTampil = smFmt(ms);
  return result;
}

/* ===== AKSI: smart_opname_simpan_massal - Stock Opname model KERANJANG =====
   data.items = [{ sku, qtyFisik, catatan, waktuHitungMs }], data.waktuKirimMs = jam browser saat kirim.
   Titik waktu opname tiap SKU = SAAT QTY-NYA DIISI di keranjang (bukan saat tombol Rekam diklik), supaya
   prinsip Smart Opname tetap benar: resi/barang masuk SETELAH detik hitung dihitung oleh rekonsiliasi.
   Anti selisih jam HP vs server: yang dipakai adalah UMUR hitungan (waktuKirim - waktuHitung) yang
   dikurangkan dari jam SERVER, dibatasi 0 s/d 24 jam. */
var SM_OPNAME_MASSAL_MAKS = 150;
function prosesSmartOpnameSimpanMassal(data) {
  if (!mgApakahOwner_(data.email)) return { success: false, error: 'Stock Opname hanya bisa dilakukan akun Owner.' }; // P1
  var result = { success: false };
  var serverMs = Date.now();
  var items = (data.items || []).slice(0, SM_OPNAME_MASSAL_MAKS);
  var siap = [], gagal = [], namaStaff;
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    if (!items.length) throw new Error('Keranjang opname kosong.');
    namaStaff = getNamaStaff(data.email);
    var kirimMs = parseInt(data.waktuKirimMs, 10) || serverMs;
    // Snapshot stok sistem per SKU TEPAT di detik hitungnya (read-only, di luar kunci).
    // Pembacaan sheet di-memo selama loop ini -> tidak membaca ulang sheet yang sama untuk tiap SKU.
    SM_MEMO_BACA_ = {};
    try {
      items.forEach(function (it, idx) {
        try {
          var sku = resolveSkuMarketplaceKeSkuJual(resolveSkuJual(String(it.sku || '').trim()));
          if (!sku) throw new Error('SKU kosong');
          var qtyMentah = it.qtyFisik, qty = parseFloat(qtyMentah);
          if (qtyMentah === '' || qtyMentah === null || qtyMentah === undefined || isNaN(qty) || qty < 0) throw new Error('Qty Fisik tidak valid');
          var umur = kirimMs - (parseInt(it.waktuHitungMs, 10) || kirimMs);
          umur = Math.min(Math.max(umur, 0), (typeof P76_SO_WAKTU_TEPAT_ !== 'undefined' && P76_SO_WAKTU_TEPAT_ ? 400 : 1) * 24 * 60 * 60 * 1000); // P76: memo SO dari server memakai jam hitung asli
          var ms = serverMs - umur;
          var mesin = smHitungMesinStok({ sku: sku, batasMs: ms });
          var p = mesin.daftar[0], qtySistem = 0, nama = '', terdaftar = false;
          if (p) { qtySistem = p.onHand; nama = p.nama; terdaftar = p.terdaftar; sku = p.terdaftar ? p.sku : sku; }
          siap.push({ idx: idx, sku: sku, qty: qty, qtySistem: qtySistem, nama: nama, terdaftar: terdaftar, ms: ms,
            catatan: String(it.catatan || '').trim().substring(0, 300), waktuHitung: parseInt(it.waktuHitungMs, 10) || 0 });
        } catch (eItem) { gagal.push({ idx: idx, sku: String(it.sku || ''), error: String(eItem.message || eItem) }); }
      });
    } finally { SM_MEMO_BACA_ = null; }
    if (!siap.length) throw new Error('Tidak ada item yang valid.');
  } catch (errAwal) { result.error = errAwal.toString(); result.gagal = gagal; return result; }

  siap.sort(function (a, b) { return a.ms - b.ms; }); // urut waktu hitung (ledger kronologis)
  var lock = kunciModul_('stok');
  try { lock.waitLock(25000); } catch (eLock) { result.error = 'Sistem sedang sibuk, coba lagi.'; return result; }
  try {
    var toko = data.toko || 'Waterground';
    var sh = getLogOpnameSheet();
    var idPertama = bikinNomorMemo(sh, 'OPN');
    var awalan = idPertama.replace(/\d+$/, ''), nomor = parseInt(idPertama.match(/(\d+)$/)[1], 10);
    var barisLog = [], barisLedger = [];
    siap.forEach(function (s, i) {
      var n = nomor + i;
      s.id = awalan + (n < 10 ? '0' + n : String(n));
      var waktu = new Date(s.ms), iso = smIso(s.ms);
      s.iso = iso;
      barisLog.push([s.id, waktu, iso, s.ms, s.sku, s.nama, s.qty, s.qtySistem, s.qty - s.qtySistem, s.catatan, namaStaff, s.waktuHitung ? smIso(s.waktuHitung) : '', toko]);
      barisLedger.push([waktu, s.sku, 'Opname', s.qty, 'Smart Opname ' + s.id + (s.catatan ? ' - ' + s.catatan : ''), namaStaff, toko, 0, iso]);
    });
    var awalLog = sh.getLastRow() + 1;
    sh.getRange(awalLog, 5, barisLog.length, 1).setNumberFormat('@');
    sh.getRange(awalLog, 1, barisLog.length, 13).setValues(barisLog);
    var shL = getStockLedgerSheet();
    if (shL.getLastColumn() < 9) shL.getRange(1, 9).setValue('Timestamp Presisi (ISO)').setFontWeight('bold');
    var awalL = shL.getLastRow() + 1;
    shL.getRange(awalL, 2, barisLedger.length, 1).setNumberFormat('@');
    shL.getRange(awalL, 1, barisLedger.length, 9).setValues(barisLedger);
  } catch (err) {
    result.error = err.toString();
    return result;
  } finally { lepasKunci_(lock); }

  smInvalidasiCache();
  try {
    if (PropertiesService.getScriptProperties().getProperty('VIRTUAL_STOCK_AKTIF_TIKTOK') === 'true') {
      var sudah = {};
      siap.forEach(function (s) { if (!sudah[s.sku]) { sudah[s.sku] = true; try { prosesUpdateVirtualStockSatuSku(s.sku, hitungStockSatuSku(s.sku)); } catch (eVS) { } } });
    }
  } catch (eVSAll) { /* gagal sync TikTok tidak boleh menggagalkan opname */ }

  result.success = true;
  result.hasil = siap.map(function (s) {
    return { idx: s.idx, id: s.id, sku: s.sku, nama: s.nama, terdaftar: s.terdaftar, qtyFisik: s.qty, qtySistem: s.qtySistem,
      selisih: s.qty - s.qtySistem, timestampIso: s.iso, timestampTampil: smFmt(s.ms) };
  });
  result.gagal = gagal;
  return result;
}

/* ------------------------------------------------------------------------------------
   REKONSILIASI MUTASI MALAM - dijalankan trigger harian 02:00
   ------------------------------------------------------------------------------------ */
/* v2026.10.22 (Paket 9, DN-261015-170817-643): REKONSILIASI MALAM DIHENTIKAN.
   Stok sudah selalu dihitung LANGSUNG oleh smHitungMesinStok (Smart Opname terakhir + mutasi sesudahnya, per detik);
   rekonsiliasi hanya menyalin hasil itu ke sheet "Master Stok" tiap 02:00 dan tidak dibaca lagi oleh fitur mana pun
   (pembaca terakhir, data AI Penjualan, kini memakai mesin stok langsung). Bila jadwal lama masih terpanggil, fungsi ini
   hanya mengunci Opname Awal Otomatis (sekali) lalu menghapus jadwalnya sendiri. Sheet "Master Stok" & "Log_Rekonsiliasi"
   dibiarkan sebagai arsip (tidak dihapus). smJalankanRekonsiliasi tetap ada untuk keperluan darurat (tidak dipanggil UI). */
var SM_TANDA_OPNAME_AWAL_ = 'OPNAME AWAL OTOMATIS';
var SM_PROP_OPNAME_AWAL_ = 'SM_OPNAME_AWAL_V1';
function runNightlyReconciliation(e) {
  var h = null;
  try { h = smKunciOpnameAwal_(); } catch (eA) { h = { error: String(eA) }; }
  try {
    ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'runNightlyReconciliation') ScriptApp.deleteTrigger(t); });
  } catch (eT) { }
  return { status: 'DIHENTIKAN', catatan: 'Rekonsiliasi Malam sudah dihentikan (v2026.10.22). Stok dihitung langsung dari Smart Opname + mutasi.', opnameAwal: h };
}

/* Opname Awal Otomatis (pilihan A Owner, sekali saja): setiap SKU yang BELUM PERNAH di-opname tetapi punya mutasi diberi
   titik awal = stok sistem saat ini (angka yang sama dengan hasil rekonsiliasi bila dijalankan sekarang), dicatat di
   Log_Opname dengan catatan "OPNAME AWAL OTOMATIS ... [n=jumlah event]". TIDAK ditulis ke Stock Ledger (fungsi lama tidak
   berubah). Ditandai Script Property SM_OPNAME_AWAL_V1 -> tidak pernah dobel. */
function smKunciOpnameAwal_() {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty(SM_PROP_OPNAME_AWAL_)) return { sudah: true };
  var lock = kunciModul_('stok');
  if (!lock.tryLock(30000)) return { sibuk: true };
  var ringkas = null;
  try {
    if (props.getProperty(SM_PROP_OPNAME_AWAL_)) return { sudah: true };
    var L = Date.now() - 1000;
    var mesin = smHitungMesinStok({ batasMs: L, timeline: true });
    var tz = Session.getScriptTimeZone(), tgl = Utilities.formatDate(new Date(L), tz, 'yyMMdd');
    var baris = [], i = 0;
    mesin.daftar.forEach(function (p) {
      if (p.anchorQty !== null) return;                  // sudah pernah di-opname -> tidak disentuh
      var ev = (p.timeline || []).filter(function (e) { return e.t <= L; });
      if (!ev.length) return;                             // tanpa mutasi = tetap 0, tidak perlu titik awal
      i++;
      var id = 'OPA' + tgl + '-' + ('000' + i).slice(-4);
      baris.push([id, new Date(L), smIso(L), L, p.sku, p.nama || '', p.onHand, p.onHand, 0,
        SM_TANDA_OPNAME_AWAL_ + ' (Paket 9) - titik awal = stok sistem saat Rekonsiliasi Malam dihentikan [n=' + ev.length + ']', 'Sistem', '', 'Waterground']);
    });
    if (baris.length) {
      var sh = getLogOpnameSheet(), awal = sh.getLastRow() + 1;
      sh.getRange(awal, 5, baris.length, 1).setNumberFormat('@');
      sh.getRange(awal, 1, baris.length, 13).setValues(baris);
      SpreadsheetApp.flush();
    }
    ringkas = { waktu: smFmt(L), ms: L, jumlahSku: baris.length };
    props.setProperty(SM_PROP_OPNAME_AWAL_, JSON.stringify(ringkas));
  } finally { lepasKunci_(lock); }
  smInvalidasiCache();
  return ringkas;
}

function smJalankanRekonsiliasi(dijalankanOleh) {
  var mulai = new Date();
  var ringkas = { waktu: smFmt(mulai.getTime()), iso: smIso(mulai.getTime()), oleh: dijalankanOleh, jumlahSku: 0, skuBerubah: 0, totalSelisih: 0, tanpaScan: 0, status: 'GAGAL', catatan: '' };
  var mesin;
  try {
    // Hitung dulu di luar lock (read-only) - lock cuma dipegang saat menulis
    mesin = smHitungMesinStok({ batasMs: mulai.getTime() });
  } catch (errHitung) {
    ringkas.catatan = 'Gagal menghitung: ' + errHitung.toString();
    smCatatLogRekon_(ringkas, mulai);
    return ringkas;
  }

  var lock = kunciModul_('stok');
  try { lock.waitLock(60000); } catch (eLock) {
    ringkas.catatan = 'Lock sibuk lebih dari 60 detik - dilewati.';
    smCatatLogRekon_(ringkas, mulai);
    return ringkas;
  }
  try {
    var sh = getMasterStokSheet();
    var sebelumnya = {};
    var lastRow = sh.getLastRow();
    if (lastRow > 1) sh.getRange(2, 1, lastRow - 1, 3).getValues().forEach(function (r) {
      var k = smKey(r[0]);
      if (k && r[2] !== '' && r[2] !== null) sebelumnya[k] = parseFloat(r[2]) || 0;
    });
    var waktuRekon = mulai;
    var baris = mesin.daftar.filter(smPerluTampil_).map(function (p) {
      var k = smKey(p.sku);
      var prev = sebelumnya.hasOwnProperty(k) ? sebelumnya[k] : '';
      var selisih = prev === '' ? '' : p.onHand - prev;
      if (selisih !== '' && selisih !== 0) { ringkas.skuBerubah++; ringkas.totalSelisih += Math.abs(selisih); }
      return [p.sku, p.nama, p.onHand, p.anchorQty === null ? '' : p.anchorQty, p.anchorMs ? new Date(p.anchorMs) : '',
        p.masuk, p.keluar, p.penyesuaian, prev, selisih, p.keluarTanpaScan, p.terdaftar ? 'Ya' : 'TIDAK', waktuRekon];
    });
    // OVERWRITE total tabel Master Stok (batch)
    if (lastRow > 1) sh.getRange(2, 1, lastRow - 1, 13).clearContent();
    if (baris.length) {
      sh.getRange(2, 1, baris.length, 1).setNumberFormat('@');
      sh.getRange(2, 1, baris.length, 13).setValues(baris);
    }
    ringkas.jumlahSku = baris.length;
    ringkas.tanpaScan = mesin.statistik.orderKeluarTanpaScan;
    ringkas.status = 'SUKSES';
  } catch (err) {
    ringkas.catatan = err.toString();
  } finally { lepasKunci_(lock); }

  smCatatLogRekon_(ringkas, mulai);
  if (ringkas.status === 'SUKSES') {
    try { PropertiesService.getScriptProperties().setProperty(SM_PROP_REKON_TERAKHIR, JSON.stringify(ringkas)); } catch (eP) { }
  }
  smInvalidasiCache();
  return ringkas;
}

function smCatatLogRekon_(ringkas, mulai) {
  try {
    var durasi = Math.round((Date.now() - mulai.getTime()) / 100) / 10;
    ringkas.durasi = durasi;
    getLogRekonsiliasiSheet().appendRow([mulai, ringkas.iso, durasi, ringkas.oleh, ringkas.jumlahSku, ringkas.skuBerubah,
      ringkas.totalSelisih, ringkas.tanpaScan, ringkas.status, ringkas.catatan || '-']);
  } catch (e) { Logger.log('Gagal catat Log_Rekonsiliasi: ' + e); }
}

function smTriggerRekonAktif_() {
  try {
    return ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'runNightlyReconciliation'; });
  } catch (e) { return null; } // null = tidak bisa dicek dari konteks ini
}

// Pasang trigger harian 02:00 (hapus yang lama dulu biar nggak dobel). Bisa di-Run langsung dari editor.
// v2026.10.22: jadwal Rekonsiliasi Malam tidak dipasang lagi - fungsi ini justru MENGHAPUS jadwal lama bila masih ada.
