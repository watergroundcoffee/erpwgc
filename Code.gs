// Field yang HANYA boleh diset oleh kode server (trigger/proses sistem). Kalau dikirim dari browser,
// dibuang di doPost - sebelumnya browser bisa mengirim { dariSistem: true } untuk melewati cekIzin.
var FIELD_KHUSUS_SERVER_ = ['dariSistem', 'namaSistem'];

// Aksi yang mengubah data staff/role -> snapshot staff di memori harus dibuang setelahnya.
var RE_AKSI_INVALIDASI_STAFF_ = /staff|role|wewenang|izin|akses|login|daftar_user|owner/i;

function doPost(e) {
  var out;
  var aksi = '(belum terbaca)';
  var idem = null;
  try {
    var data = parsePayload_(e);
    aksi = data.aksi || 'scan';

    // Keamanan: buang flag khusus server yang mungkin disusupkan dari browser
    for (var f = 0; f < FIELD_KHUSUS_SERVER_.length; f++) delete data[FIELD_KHUSUS_SERVER_[f]];

    var routes = getRoutes_();
    if (!Object.prototype.hasOwnProperty.call(routes, aksi)) {
      return jsonOut_({ success: false, error: 'Aksi tidak dikenali: ' + aksi });
    }

    // ===== Validasi sesi =====
    // Semua aksi (kecuali AKSI_PUBLIK_) wajib membawa sessionToken hasil login. Email pelaku
    // DIAMBIL DARI TOKEN, bukan dari data.email kiriman browser -> tidak bisa lagi menyamar jadi Owner
    // hanya dengan mengetik email orang lain.
    var sesi = null;
    if (!AKSI_PUBLIK_[aksi]) {
      sesi = verifikasiTokenSesi_(data.sessionToken);
      if (!sesi) return jsonOut_({ success: false, sesiHabis: true, error: 'Sesi login berakhir. Silakan login ulang.' });
      var emailLayar_ = String(data.email || '').trim().toLowerCase(); // v2026.10.82 (DN-470): akun di layar harus sama dengan pemilik token
      if (emailLayar_ && emailLayar_.indexOf('@') > 0 && emailLayar_ !== String(sesi.email || '').trim().toLowerCase())
        return jsonOut_({ success: false, sesiBeda: true, error: 'Akun di layar (' + emailLayar_ + ') berbeda dengan sesi login (' + sesi.email + '). Keluar lalu login ulang dengan akun yang benar.' });
      data.email = sesi.email;
      RUTE_TERVERIFIKASI_ = true;
    }
    delete data.sessionToken; // token tidak ikut tersimpan di cache idem / log

    idem = idemMulai_(aksi, data); // anti dobel-submit
    if (idem && idem.hasil) return jsonOut_(idem.hasil);
    // v2026.10.14: browser hanya MENANYAKAN status permintaan yang sudah dikirim (tanpa isi file besar).
    // Kalau sampai di sini berarti permintaan aslinya sudah tidak tercatat -> jangan dijalankan dengan data kosong,
    // minta browser mengirim ulang lengkap.
    if (data.hanyaCekStatus) {
      out = { success: false, perluKirimUlang: true, error: 'Permintaan sebelumnya tidak selesai - dikirim ulang lengkap.' };
      try { if (idem && !idem.hasil) idemSelesai_(idem, out); } catch (eI) { }
      return jsonOut_(out);
    }

    out = routes[aksi](data);
    if (!out || typeof out !== 'object') out = { success: false, error: 'Handler aksi "' + aksi + '" tidak mengembalikan hasil.' };
    // Sesi bergeser (sliding): token yang sudah lewat separuh umur diganti otomatis tanpa login ulang
    if (sesi && sesi.perluDiperbarui) out._sesiBaru = buatTokenSesi_(sesi.email);

    idemSelesai_(idem, out);
    if (RE_AKSI_INVALIDASI_STAFF_.test(aksi)) staffInvalidasi_();
  } catch (err) {
    out = { success: false, error: (err && err.message) ? err.message : String(err), errorDetail: detailErrorBackend_(err, 'doPost aksi=' + aksi) };
    console.error('doPost gagal (aksi=' + aksi + '): ' + out.error + '\n' + out.errorDetail.stack);
    try { if (idem && !idem.hasil) idemSelesai_(idem, out); } catch (eI) { } // gagal -> boleh dikirim ulang
  }
  return jsonOut_(out);
}

// Parsing payload yang aman: body dikirim front-end sebagai text/plain berisi JSON.stringify(...)
// (text/plain SENGAJA, supaya browser tidak mengirim preflight OPTIONS yang tidak didukung Apps Script).
function parsePayload_(e) {
  if (!e || !e.postData || typeof e.postData.contents !== 'string' || e.postData.contents === '') {
    throw new Error('Request tanpa body. Pastikan front-end mengirim method POST dengan body JSON.stringify(payload).');
  }
  var data;
  try { data = JSON.parse(e.postData.contents); }
  catch (eParse) { throw new Error('Body request bukan JSON valid (' + eParse.message + '). Awal body: ' + e.postData.contents.substring(0, 120)); }
  if (!data || typeof data !== 'object' || Array.isArray(data)) throw new Error('Payload JSON harus berupa object.');
  return data;
}

function jsonOut_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

/* ============================================================
   MIDDLEWARE TRANSAKSI - withTransaction(email, izinKey, lockKey, logicCallback, opsi)
   ------------------------------------------------------------
   Membungkus boilerplate yang dulu ditulis ulang di tiap fungsi proses*:
     cekIzin -> validasi input -> ambil lock -> logika -> flush -> releaseLock -> try/catch.

   URUTAN (sengaja):
     1. cekIzin          -> murah, ditolak sebelum menyentuh antrean lock
     2. opsi.validasi()  -> validasi input SEBELUM lock, supaya request yang pasti gagal
                            tidak ikut antre di lock global & tidak memperlambat staff lain
     3. ambil lock       -> hanya untuk request yang lolos 1 & 2
     4. logicCallback()  -> isi transaksi (baca-tulis sheet)
     5. flush            -> SATU kali, hanya kalau lock dipegang, tepat sebelum lock dilepas
     6. releaseLock      -> selalu (finally)

   KENAPA tetap ada 1x flush di langkah 5:
     Apps Script menunda (batch) penulisan sampai akhir eksekusi. Kalau lock dilepas SEBELUM
     tulisan benar-benar masuk sheet, request berikutnya yang dapat lock bisa membaca data lama
     -> nomor invoice/memo dobel, stok terpotong dua kali. Satu flush per transaksi (bukan per
     baris) adalah biaya minimum untuk menjaga konsistensi itu.

   PARAMETER:
     email        : email pelaku (data.email)
     izinKey      : kunci izin (mis. 'buatInvoice'); null/'' = tanpa cek izin (aksi publik/baca)
     lockKey      : nama modul (mis. 'akses', atau ['stok','pesanan']) -> kunciModul_, hanya antre dgn modul sama
                    | 'script' (antrean global) | 'document' | 'user' | null/'none' = tanpa lock
     logicCallback: function (ktx) { ...; return { ...field hasil... }; }
                    ktx = { email, namaStaff() }.  Lempar Error untuk membatalkan dengan pesan.
                    Kalau hasil tidak punya field `success`, otomatis dianggap success: true.
     opsi (opsional):
       validasi   : function () { ...throw new Error('pesan') kalau input salah... } -> jalan SEBELUM lock
       tungguMs   : batas tunggu lock (default 15000)
       pesanSibuk : pesan kalau lock tidak didapat (default 'Sistem sedang sibuk, coba lagi.')
       pesanTanpaIzin : pesan kalau cekIzin gagal (default 'Anda tidak punya izin untuk aksi ini.')
       tanpaFlush : true = lewati flush (khusus transaksi yang tidak menulis ke Spreadsheet)

   CONTOH PEMAKAIAN:
     function prosesHapusStock(data) {
       return withTransaction(data.email, 'mintaStock', 'script', function () {
         var sh = getStockRequestSheet();
         sh.deleteRow(data.row);
         return { pesan: 'Terhapus' };
       }, {
         validasi: function () { wajibAngka_(data.row, 'Baris', 2); }
       });
     }
   ============================================================ */
var PESAN_TIDAK_ADA_IZIN_ = 'Anda tidak punya izin untuk aksi ini.';
var PESAN_SISTEM_SIBUK_ = 'Sistem sedang sibuk, coba lagi.';

function withTransaction(email, izinKey, lockKey, logicCallback, opsi) {
  opsi = opsi || {};
  var lock = null;
  var dapatLock = false;
  try {
    // 1) Izin
    if (izinKey && !cekIzin(email, izinKey)) return { success: false, error: opsi.pesanTanpaIzin || PESAN_TIDAK_ADA_IZIN_ };

    // 2) Validasi input - SEBELUM antre lock
    if (typeof opsi.validasi === 'function') opsi.validasi();

    // 3) Lock
    lock = ambilLockTransaksi_(lockKey);
    if (lock) {
      try { dapatLock = lock.tryLock(opsi.tungguMs || 15000); } catch (eL) { dapatLock = false; }
      if (!dapatLock) return { success: false, sibuk: true, error: opsi.pesanSibuk || PESAN_SISTEM_SIBUK_ };
    }

    // 4) Logika transaksi
    var ktx = {
      email: email,
      namaStaff: function () { return getNamaStaff(email); }
    };
    var hasil = logicCallback(ktx);
    if (!hasil || typeof hasil !== 'object') hasil = {};
    if (!Object.prototype.hasOwnProperty.call(hasil, 'success')) hasil.success = true;
    return hasil;
  } catch (err) {
    return { success: false, error: (err && err.message) ? err.message : String(err) };
  } finally {
    if (dapatLock) {
      // 5) Satu flush sebelum lock dilepas (lihat penjelasan di atas)
      if (!opsi.tanpaFlush) { try { SpreadsheetApp.flush(); } catch (eF) { console.error('flush gagal: ' + eF); } }
      // 6) Lepas lock
      try { lock.releaseLock(); } catch (eR) { }
    }
  }
}

// Lepas lock dengan SATU flush tepat sebelumnya (dipakai fungsi lama yang belum lewat withTransaction).
// Alasannya sama dengan langkah 5 withTransaction: tulisan harus sudah masuk Sheets sebelum
// request lain mendapat lock, kalau tidak request berikutnya membaca data lama.
function lepasKunci_(lock) {
  if (!lock) return;
  try { SpreadsheetApp.flush(); } catch (eF) { console.error('flush gagal: ' + eF); }
  lock.releaseLock();
}

// Versi baca-saja: cek izin + try/catch, TANPA lock & TANPA flush (untuk aksi lihat_*).
function withRead(email, izinKey, logicCallback, opsi) {
  return withTransaction(email, izinKey, null, logicCallback, opsi);
}

function ambilLockTransaksi_(lockKey) {
  var k = (lockKey === undefined) ? 'script' : lockKey;
  if (!k || k === 'none') return null;
  if (typeof k === 'object' && typeof k.tryLock === 'function') return k; // objek lock siap pakai
  if (Array.isArray(k)) return kunciModul_(k);          // mis. ['stok', 'pesanan'] -> kunci per modul
  if (k === 'script') return LockService.getScriptLock(); // antrean global
  if (k === 'document') return LockService.getDocumentLock() || LockService.getScriptLock();
  if (k === 'user') return LockService.getUserLock();
  return kunciModul_(k);                                  // nama modul -> hanya antre dengan modul yang sama
}

/* ---------- Helper validasi (dipakai di opsi.validasi, sebelum lock) ---------- */
function wajibIsi_(nilai, label) {
  if (nilai === undefined || nilai === null || String(nilai).trim() === '') throw new Error(label + ' wajib diisi.');
  return String(nilai).trim();
}
function wajibAngka_(nilai, label, minimal) {
  var n = Number(nilai);
  if (nilai === '' || nilai === null || nilai === undefined || isNaN(n)) throw new Error(label + ' harus berupa angka.');
  if (minimal !== undefined && n < minimal) throw new Error(label + ' minimal ' + minimal + '.');
  return n;
}
function wajibArray_(nilai, label) {
  if (!Array.isArray(nilai) || !nilai.length) throw new Error(label + ' tidak boleh kosong.');
  return nilai;
}

/* ============================================================
   SESI LOGIN (TOKEN) - stateless, ditandatangani HMAC-SHA256
   ------------------------------------------------------------
   Token = base64(payload JSON) + "." + base64(tanda tangan). Payload: email, waktu terbit,
   waktu kedaluwarsa, versi sesi. Tidak disimpan di sheet/cache -> verifikasi ~1 ms, tanpa I/O.
   - Kunci rahasia: Script Properties SESSION_SECRET (dibuat otomatis saat pertama dipakai).
   - Umur: Script Properties SESSION_UMUR_HARI (default 30 hari), diperpanjang otomatis
     (sliding) selama aplikasi dipakai.
   - Logout paksa SEMUA perangkat: jalankan resetSemuaSesiLogin() dari editor.
   - Staff yang dinonaktifkan tetap DITOLAK walau tokennya masih berlaku, karena cekIzin()
     selalu membaca status staff terbaru dari sheet.
   ============================================================ */
var AKSI_PUBLIK_ = {
  'login': true, 'login_dev': true, 'login_admin_gudang': true, 'ping': true,
  'login_email': true, 'login_daftar_email': true, // login & daftar dengan email + password
  'lihat_login_carousel': true, // gambar carousel di layar login
  'lihat_daftar_role': true      // daftar nama role untuk pemilih role Login Developer (tanpa data bisnis)
};
var RUTE_TERVERIFIKASI_ = false; // true selama request doPost yang tokennya sudah valid
var SESI_UMUR_HARI_DEFAULT_ = 30;

function sesiProps_() { return PropertiesService.getScriptProperties(); }

function sesiRahasia_() {
  var props = sesiProps_();
  var r = props.getProperty('SESSION_SECRET');
  if (r) return r;
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    r = props.getProperty('SESSION_SECRET');
    if (!r) {
      r = Utilities.getUuid() + Utilities.getUuid() + String(Date.now());
      props.setProperty('SESSION_SECRET', r);
    }
    return r;
  } finally { lock.releaseLock(); }
}

function sesiVersi_() { return String(sesiProps_().getProperty('SESSION_EPOCH') || '1'); }
function sesiUmurMs_() {
  var hari = parseFloat(sesiProps_().getProperty('SESSION_UMUR_HARI'));
  if (!(hari > 0)) hari = SESI_UMUR_HARI_DEFAULT_;
  return hari * 24 * 60 * 60 * 1000;
}
function sesiTandaTangan_(teks) {
  return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(teks, sesiRahasia_()));
}
function sesiSamaPersis_(a, b) {
  a = String(a); b = String(b);
  if (a.length !== b.length) return false;
  var beda = 0;
  for (var i = 0; i < a.length; i++) beda |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return beda === 0;
}

function buatTokenSesi_(email) {
  var sekarang = Date.now();
  var payload = { e: String(email || '').trim(), iat: sekarang, exp: sekarang + sesiUmurMs_(), v: sesiVersi_() };
  var badan = Utilities.base64EncodeWebSafe(JSON.stringify(payload), Utilities.Charset.UTF_8);
  return badan + '.' + sesiTandaTangan_(badan);
}

// -> { email, perluDiperbarui } atau null kalau token kosong / palsu / kedaluwarsa / sudah di-reset
function verifikasiTokenSesi_(token) {
  try {
    if (!token || typeof token !== 'string' || token.length > 2000) return null;
    var bagian = token.split('.');
    if (bagian.length !== 2) return null;
    if (!sesiSamaPersis_(sesiTandaTangan_(bagian[0]), bagian[1])) return null;
    var p = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(bagian[0])).getDataAsString());
    if (!p || !p.e || !p.exp || String(p.v) !== sesiVersi_()) return null;
    var sekarang = Date.now();
    if (sekarang > p.exp) return null;
    return { email: String(p.e), perluDiperbarui: (p.exp - sekarang) < (sesiUmurMs_() / 2) };
  } catch (e) { return null; }
}

// Jalankan dari editor Apps Script: semua perangkat wajib login ulang (mis. HP staff hilang).
function resetSemuaSesiLogin() {
  var v = parseInt(sesiVersi_(), 10) || 1;
  sesiProps_().setProperty('SESSION_EPOCH', String(v + 1));
  Logger.log('✅ Semua sesi login dibatalkan. Versi sesi sekarang: ' + (v + 1));
}

/* ---------- Pembatas percobaan login (anti tebak password/PIN) ----------
   Apps Script tidak tahu IP pengirim, jadi batasnya global per jenis login:
   5 kali salah dalam 10 menit -> jenis login itu dikunci 10 menit. */
function loginCekBlokir_(jenis) {
