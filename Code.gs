      throw new Error('Stok kurang: ' + kurang.map(function (k) { return peta[k].nama + ' (butuh ' + Math.round(pakai[k]) + ' g, ada ' + Math.round(peta[k].stokGram) + ' g)'; }).join(' · ') + '. Catat stok masuk dulu atau centang "tetap simpan".');
    }

