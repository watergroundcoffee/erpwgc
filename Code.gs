      p.item = p.item.slice(0, 150);
      p.email = s ? s.email : ''; p.role = s ? s.role : ''; p.terdaftar = !!s;
      return p;
    }).sort(function (x, y) { return (y.belum - x.belum) || (y.total - x.total); });
    result.success = true;
    result.daftar = daftar;
    result.totalBelum = daftar.reduce(function (t, p) { return t + p.belum; }, 0);
    result.namaStaf = Object.keys(staf).filter(function (k) { return staf[k].aktif; }).map(function (k) { return staf[k].nama; });
  } catch (err) { result.error = err.toString(); }
  return result;
