  Object.keys(rk).forEach(function (t) {
    var slotK = D.hari[t] || (D.hari[t] = { o: {}, h: 0, r: 0, b: 0, x: {}, l: 0, hk: {} });
    var hkT = slotK.hk || (slotK.hk = {});
    Object.keys(rk[t]).forEach(function (kn) {
      var m = rk[t][kn], tot = 0;
