// Biaya Penjualan itu GLOBAL (dipakai bareng semua toko buat ngitung Rekomendasi Harga Jual),
// jadi pas berubah, bersihin cache Katalog Harga buat semua toko yang ada - biar Katalog > Harga
// langsung kepake biaya terbaru, nggak nunggu 30 detik.
function invalidasiCacheKatalogHargaSemuaToko() {
  try {
    var cache = CacheService.getScriptCache();
    cache.remove('KATALOG_HARGA_Waterground');
    cache.remove('KATALOG_HARGA_Conner');
    cache.remove('KATALOG_HARGA_default');
  } catch (e) { /* biarin, nggak fatal */ }
  invalidasiCacheProdukRingan_('');
}

// Hitung total biaya (dalam Rupiah) buat 1 transaksi di channel tertentu, dari harga jual.
function hitungBiayaPenjualanChannel(channel, hargaJual) {
  var sh = getBiayaPenjualanSheet();
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return 0;
  var vals = sh.getRange(2, 1, lastRow - 1, 4).getValues();
  var totalBiaya = 0;
  vals.forEach(function (row) {
    if (String(row[0]).trim() !== channel) return;
    var jenis = String(row[2]).trim();
    var nilai = parseFloat(row[3]) || 0;
    totalBiaya += jenis === 'Persen' ? (hargaJual * nilai / 100) : nilai;
  });
  return totalBiaya;
}

/* ============================================================
   CONNER HARDWARE - platform sales BARU (TikTok Shop toko lain), dikelola
   PARALEL/TERPISAH dari Waterground - bukan "multi-toko" dalam 1 kredensial,
   tapi kredensial App Key/Secret/Token SENDIRI. Kode Pesanan: TC-NoPesanan#
   ============================================================ */


function refreshConnerAccessToken() {
  var result = { success: false };
  try {
    var props = PropertiesService.getScriptProperties();
    var refreshToken = props.getProperty('CONNER_REFRESH_TOKEN');
    var appKey = connerAppKey_();
    var appSecret = connerAppSecret_();
    if (!refreshToken || !appKey || !appSecret) throw new Error('Belum ada Refresh Token/App Key/Secret Conner tersimpan.');
    var region = props.getProperty('CONNER_REGION') || 'global';
    var authHost = region === 'us' ? 'auth.tiktok-shops.us' : 'auth.tiktok-shops.com';

    var url = 'https://' + authHost + '/api/v2/token/refresh' +
      '?app_key=' + encodeURIComponent(appKey) +
      '&app_secret=' + encodeURIComponent(appSecret) +
      '&refresh_token=' + encodeURIComponent(refreshToken) +
      '&grant_type=refresh_token';

    var res = fetchHemat(url, { method: 'get', muteHttpExceptions: true });
    var data = JSON.parse(res.getContentText());
    if (!data.data || !data.data.access_token) throw new Error('Gagal refresh token Conner: ' + res.getContentText().substring(0, 300));

    props.setProperty('CONNER_ACCESS_TOKEN', data.data.access_token);
    props.setProperty('CONNER_REFRESH_TOKEN', data.data.refresh_token);
    // access_token_expire_in itu timestamp absolut (detik epoch), bukan durasi - sama kayak bug di TikTok Waterground
    props.setProperty('CONNER_TOKEN_EXPIRED_AT', String(data.data.access_token_expire_in * 1000));
    result.success = true;
  } catch (err) { result.error = err.toString(); Logger.log('❌ Gagal refresh token Conner: ' + result.error); }
  return result;
}

// Sama kayak pastikanTokenTikTokMasihValid() - dikasih lock buat cegah race condition kalau
// suatu saat ada 2 pemicu (trigger otomatis + aksi manual) yang nyaris bersamaan.
function pastikanTokenConnerMasihValid() {
  var props = PropertiesService.getScriptProperties();
  var SATU_HARI_MS = 24 * 60 * 60 * 1000;
  var expiredAt = parseInt(props.getProperty('CONNER_TOKEN_EXPIRED_AT') || '0', 10);
  if (expiredAt && (expiredAt - Date.now()) >= SATU_HARI_MS) return;

  var lock = kunciModul_('token');
  try {
    lock.waitLock(10000);
  } catch (e) {
    Logger.log('⏳ Refresh token Conner lagi ditangani proses lain, dilewati (aman).');
    return;
  }
  try {
    expiredAt = parseInt(props.getProperty('CONNER_TOKEN_EXPIRED_AT') || '0', 10);
    if (!expiredAt || (expiredAt - Date.now()) < SATU_HARI_MS) refreshConnerAccessToken();
  } finally {
    lock.releaseLock();
  }
}




/* ============================================================
   INTEGRASI MARKETPLACE - "Connection Cards" (Pengaturan > Otorisasi Marketplace)
   1 panggilan untuk status semua koneksi + aksi Putuskan (hapus token, kredensial app TETAP disimpan).
   ============================================================ */

/* ============================================================
   OAUTH 2.0 MARKETPLACE - Seamless flow (OmniAI sebagai aplikasi pihak ketiga)
   Alur: dasbor minta Auth URL -> user login & setuju di halaman resmi -> platform redirect ke
   Web App ini (doGet) -> kode ditukar jadi token -> token disimpan per koneksi -> registri
   "Otorisasi Toko" diperbarui -> dasbor refresh.

   Penyimpanan:
   - Sheet "Otorisasi Toko" = REGISTRI koneksi (toko, platform, status, shop, masa berlaku, siapa).
     Tidak berisi token: siapa pun yang punya akses ke Spreadsheet bisa membaca sheet.
   - Token (access/refresh) = Script Properties per "slot" koneksi (tidak terlihat di Sheets/HTML).
     Slot toko lama memakai prefix yang sudah dipakai mesin sync (SHOPEE_, TIKTOK_, CONNER_),
     jadi sync pesanan/stok/harga yang ada tetap berjalan tanpa diubah.
   ============================================================ */
var OAUTH_SHEET = 'Otorisasi Toko';
var OAUTH_HEADER = ['ID Koneksi', 'ID Toko', 'Nama Toko', 'Platform', 'Slot Token', 'Status', 'Shop ID / Seller',
  'Nama di Marketplace', 'Terhubung Pada', 'Token Berlaku s/d', 'Diperbarui Pada', 'Dihubungkan Oleh', 'Sync Otomatis'];
var OAUTH_NAMA_PLATFORM = { shopee: 'Shopee', tiktok: 'TikTok Shop' };
var OAUTH_STATE_TTL_DETIK = 900; // 15 menit
// Toko & slot yang SUDAH dipakai mesin sync. Toko baru otomatis dapat slot generik "TOKO_<ID>_<PLATFORM>_".
var OAUTH_TOKO_BAWAAN = [
  { tokoId: 'waterground', tokoNama: 'Waterground Coffee', alias: ['waterground', 'wg'], slot: { shopee: 'SHOPEE_', tiktok: 'TIKTOK_' } },
  { tokoId: 'conner', tokoNama: 'Conner Hardware', alias: ['conner', 'ch'], slot: { tiktok: 'CONNER_' } }
];
var OAUTH_SLOT_SYNC_AKTIF = { 'SHOPEE_': true, 'TIKTOK_': true, 'CONNER_': true };

function oauthSlug_(teks) {
  return String(teks || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 40);
}

function getOtorisasiTokoSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(OAUTH_SHEET);
  if (!sh) {
    sh = ss.insertSheet(OAUTH_SHEET);
    sh.getRange(1, 1, 1, OAUTH_HEADER.length).setValues([OAUTH_HEADER]).setFontWeight('bold');
    sh.getRange('A:H').setNumberFormat('@');
    sh.setFrozenRows(1);
    // Seed koneksi toko yang sudah ada (status dibaca dari token tersimpan)
    var awal = [];
    OAUTH_TOKO_BAWAAN.forEach(function (t) {
      Object.keys(t.slot).forEach(function (pl) {
        awal.push([t.tokoId + '-' + pl, t.tokoId, t.tokoNama, pl, t.slot[pl], '', '', '', '', '', new Date(), 'Sistem', 'Ya']);
      });
    });
    sh.getRange(2, 1, awal.length, OAUTH_HEADER.length).setValues(awal);
  }
  return sh;
}

function oauthBacaRegistri_() {
  var sh = getOtorisasiTokoSheet();
  var lr = sh.getLastRow();
  if (lr < 2) return [];
  return sh.getRange(2, 1, lr - 1, OAUTH_HEADER.length).getValues().map(function (r, i) {
    return { row: i + 2, idKoneksi: String(r[0]), tokoId: String(r[1]), tokoNama: String(r[2]), platform: String(r[3]), slot: String(r[4]),
      status: String(r[5] || ''), shopId: String(r[6] || ''), namaMarketplace: String(r[7] || ''), terhubungPada: r[8], berlakuSampai: r[9],
      diperbaruiPada: r[10], oleh: String(r[11] || ''), syncOtomatis: String(r[12] || '') === 'Ya' };
  }).filter(function (k) { return k.idKoneksi; });
}

// Upsert 1 baris registri (dipanggil DI DALAM lock). Baris dicari dinamis berdasarkan ID Koneksi.
function oauthSimpanRegistri_(k) {
  var sh = getOtorisasiTokoSheet();
  var ada = oauthBacaRegistri_().filter(function (x) { return x.idKoneksi === k.idKoneksi; })[0];
  var baris = [k.idKoneksi, k.tokoId, k.tokoNama, k.platform, k.slot, k.status || '', k.shopId || '', k.namaMarketplace || '',
    k.terhubungPada || '', k.berlakuSampai || '', new Date(), k.oleh || '', OAUTH_SLOT_SYNC_AKTIF[k.slot] ? 'Ya' : 'Belum'];
  if (ada) sh.getRange(ada.row, 1, 1, OAUTH_HEADER.length).setValues([baris]);
  else sh.getRange(sh.getLastRow() + 1, 1, 1, OAUTH_HEADER.length).setValues([baris]);
}

// Tentukan koneksi dari (nama toko, platform): toko bawaan -> slot lama; toko baru -> slot generik
function oauthResolveKoneksi_(namaToko, platform) {
  var slug = oauthSlug_(namaToko);
  if (!slug) throw new Error('Nama toko wajib diisi.');
  var bawaan = OAUTH_TOKO_BAWAAN.filter(function (t) {
    return t.tokoId === slug || t.alias.some(function (a) { return slug === a || slug.indexOf(a + '-') === 0; });
  })[0];
  var registri = oauthBacaRegistri_();
  var tokoId = bawaan ? bawaan.tokoId : slug;
  var tokoNama = bawaan ? bawaan.tokoNama : String(namaToko).trim().slice(0, 60);
  var idKoneksi = tokoId + '-' + platform;
  var ada = registri.filter(function (k) { return k.idKoneksi === idKoneksi; })[0];
  var slot = ada ? ada.slot : ((bawaan && bawaan.slot[platform]) || ('TOKO_' + tokoId.toUpperCase().replace(/-/g, '_') + '_' + platform.toUpperCase() + '_'));
  return { idKoneksi: idKoneksi, tokoId: tokoId, tokoNama: ada ? ada.tokoNama : tokoNama, platform: platform, slot: slot };
}

// ----- state (anti-CSRF): nonce acak -> data koneksi, disimpan 15 menit, sekali pakai -----
function oauthSimpanState_(sesi) {
  var nonce = Utilities.getUuid().replace(/-/g, '');
  sesi.dibuat = Date.now();
  CacheService.getScriptCache().put('OAUTH_STATE_' + nonce, JSON.stringify(sesi), OAUTH_STATE_TTL_DETIK);
  return nonce;
}
function oauthAmbilState_(nonce) {
  if (!nonce || !/^[a-f0-9]{32}$/i.test(String(nonce))) return null;
  var cache = CacheService.getScriptCache();
  var isi = cache.get('OAUTH_STATE_' + nonce);
  if (!isi) return null;
  cache.remove('OAUTH_STATE_' + nonce); // sekali pakai
  try { return JSON.parse(isi); } catch (e) { return null; }
}

function getOAuthRedirectUri_() { return ScriptApp.getService().getUrl(); }

// ----- Generator Auth URL (resmi) -----
// Koneksi siap dihubungkan kalau slotnya punya app khusus toko (TikTok), atau app master platform lengkap
function oauthAppSiap_(platform, slot) {
  if (platform === 'tiktok' && tiktokAppSendiriTersedia_(slot)) return true;
  return masterSiap_(platform);
}

function oauthBuatUrlOtorisasi_(koneksi) {
  if (!oauthAppSiap_(koneksi.platform, koneksi.slot)) {
    throw new Error('Aplikasi Master OmniAI untuk ' + OAUTH_NAMA_PLATFORM[koneksi.platform] + ' belum lengkap. Script Property yang masih kosong: ' +
      masterKurang_(koneksi.platform).join(', ') + ' (jalankan infoSetupMasterApp() dari editor).');
  }
  var state = oauthSimpanState_(koneksi);
  if (koneksi.platform === 'shopee') {
    var path = '/api/v2/shop/auth_partner';
    var ts = Math.floor(Date.now() / 1000);
    var redirect = getShopeeRedirectUri() + '&state=' + state; // Shopee tidak punya param state -> dititipkan di redirect
    return getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&redirect=' + encodeURIComponent(redirect) +
      '&timestamp=' + ts + '&sign=' + buatSignatureShopee(path, ts);
  }
  // TikTok Shop: otorisasi SELLER wajib memakai service_id, bukan app_key. TIDAK ada parameter scope/shop_id/
  // account_type di URL ini - scope diatur per aplikasi di Partner Center, dan toko ditentukan oleh akun yang login.
  // App yang dipakai: app khusus toko (kalau dipasang di slot itu) atau app master OmniAI.
  var app = tiktokAppUntukOtorisasi_(koneksi.slot);
  if (app.serviceId) return tiktokAuthorizeUrl_() + '?service_id=' + encodeURIComponent(app.serviceId) + '&state=' + state;
  // App khusus toko tanpa Service ID -> format otorisasi berbasis app_key
  return tiktokAuthHost_() + '/oauth/authorize?app_key=' + encodeURIComponent(app.appKey) + '&state=' + state;
}

/* ----- Pemilihan aplikasi TikTok per slot koneksi -----
   MASTER  = app OmniAI di Script Properties TIKTOK_APP_KEY / TIKTOK_APP_SECRET / TIKTOK_SERVICE_ID.
             Harus Public App (akun App Developer/ISV) yang sudah Live agar toko mana pun bisa mengotorisasi.
   SENDIRI = "app khusus toko": Seller in-house app milik akun Seller Center toko itu sendiri. Dipasang dengan
             Script Properties <SLOT>APP_KEY, <SLOT>APP_SECRET, <SLOT>SERVICE_ID (contoh CONNER_APP_KEY, dst).
             Slot Waterground (TIKTOK_) SELALU memakai master karena puluhan fungsi sync membaca getTiktokAppKey(). */
// Cadangan kredensial app khusus toko di kode - SENGAJA KOSONG. App khusus toko sekarang diisi dari dasbor
// (Otorisasi Marketplace > detail kartu toko > "Aplikasi TikTok khusus toko ini") dan disimpan di Script Properties.
// Service ID opsional: kalau kosong, link otorisasi memakai format app_key.
var APP_KHUSUS_TOKO_BAWAAN = {};
function tiktokAppSendiri_(slot) {
  var props = PropertiesService.getScriptProperties();
  var cad = APP_KHUSUS_TOKO_BAWAAN[slot] || {};
  var ambil = function (nama, f) { return String(props.getProperty(slot + nama) || cad[f] || '').trim(); };
  return { appKey: ambil('APP_KEY', 'appKey'), appSecret: ambil('APP_SECRET', 'appSecret'), serviceId: ambil('SERVICE_ID', 'serviceId'), via: 'SENDIRI' };
}
function tiktokAppSendiriTersedia_(slot) {
  if (!slot || slot === 'TIKTOK_') return false;
  var app = tiktokAppSendiri_(slot);
  // Wajib App Key + Secret, dan harus BEDA dari app master (kalau sama, itu bukan app khusus toko)
  return !!(app.appKey && app.appSecret && app.appKey !== masterConfig_('tiktok', 'appKey'));
}
function tiktokAppMaster_() {
  return { appKey: getTiktokAppKey(), appSecret: getTiktokAppSecret(), serviceId: masterConfig_('tiktok', 'serviceId'), via: 'MASTER' };
}
// Untuk MEMULAI otorisasi (link & tukar kode): app khusus toko kalau tersedia, selain itu master.
function tiktokAppUntukOtorisasi_(slot) {
  return tiktokAppSendiriTersedia_(slot) ? tiktokAppSendiri_(slot) : tiktokAppMaster_();
}
// Untuk panggilan API/refresh SETELAH terhubung: ikuti app yang menerbitkan token (AUTH_VIA).
function tiktokAppUntukSlot_(slot) {
  var via = PropertiesService.getScriptProperties().getProperty(slot + 'AUTH_VIA');
  return (via === 'SENDIRI' && tiktokAppSendiriTersedia_(slot)) ? tiktokAppSendiri_(slot) : tiktokAppMaster_();
}
// Slot mana yang memasang app khusus dengan app_key ini (dipakai saat callback datang tanpa state)
function tiktokCariSlotAppSendiri_(appKey) {
  if (!appKey || appKey === getTiktokAppKey()) return '';
  var props = PropertiesService.getScriptProperties().getProperties();
  var kandidat = Object.keys(APP_KHUSUS_TOKO_BAWAAN);
  Object.keys(props).forEach(function (n) {
    if (/APP_KEY$/.test(n) && n !== 'TIKTOK_APP_KEY') kandidat.push(n.replace(/APP_KEY$/, ''));
  });
  var hasil = '';
  kandidat.forEach(function (slot) {
    if (!hasil && tiktokAppSendiriTersedia_(slot) && tiktokAppSendiri_(slot).appKey === appKey) hasil = slot;
  });
  return hasil;
}

function prosesBuatAuthUrlMarketplace(data) {
  var result = { success: false };
  try {
    integrasiWajibOwner_(data.email);
    var platform = String(data.platform || '').toLowerCase();
    if (platform === 'tokopedia') platform = 'tiktok'; // Tokopedia dikelola lewat TikTok Shop
    if (!OAUTH_NAMA_PLATFORM[platform]) throw new Error('Platform tidak didukung: ' + data.platform);
    var koneksi;
    if (data.idKoneksi) {
      koneksi = oauthBacaRegistri_().filter(function (k) { return k.idKoneksi === String(data.idKoneksi); })[0];
      if (!koneksi) throw new Error('Koneksi tidak ditemukan.');
      koneksi = { idKoneksi: koneksi.idKoneksi, tokoId: koneksi.tokoId, tokoNama: koneksi.tokoNama, platform: koneksi.platform, slot: koneksi.slot };
    } else {
      koneksi = oauthResolveKoneksi_(data.namaToko, platform);
    }
    koneksi.email = data.email;
    result.url = oauthBuatUrlOtorisasi_(koneksi);
    result.idKoneksi = koneksi.idKoneksi;
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ----- Penukaran kode -> token -----
function oauthTukarTokenShopee_(code, shopId, sesi) {
  var result = { success: false };
  var lock = kunciModul_('token');
  try { lock.waitLock(20000); } catch (e) { result.error = 'Sistem sibuk, coba ulangi otorisasi.'; return result; }
  try {
    if (!shopId) throw new Error('Shopee tidak mengirim shop_id.');
    var path = '/api/v2/auth/token/get';
    var ts = Math.floor(Date.now() / 1000);
    var url = getShopeeHost() + path + '?partner_id=' + getShopeePartnerId() + '&timestamp=' + ts + '&sign=' + buatSignatureShopee(path, ts);
    var res = fetchHemat(url, { method: 'post', contentType: 'application/json', muteHttpExceptions: true,
      payload: JSON.stringify({ code: code, shop_id: parseInt(shopId, 10), partner_id: parseInt(getShopeePartnerId(), 10) }) });
    var d = JSON.parse(res.getContentText());
    if (!d.access_token) throw new Error('Respons Shopee: ' + res.getContentText().substring(0, 300));

    var expiredAt = Date.now() + (d.expire_in * 1000);
    var props = PropertiesService.getScriptProperties();
    var set = {};
    set[sesi.slot + 'ACCESS_TOKEN'] = d.access_token;
    set[sesi.slot + 'REFRESH_TOKEN'] = d.refresh_token;
    set[sesi.slot + 'SHOP_ID'] = String(shopId);
    set[sesi.slot + 'TOKEN_EXPIRED_AT'] = String(expiredAt);
    props.setProperties(set);
    if (sesi.slot === 'SHOPEE_' && typeof hapusCacheKredensialShopee === 'function') hapusCacheKredensialShopee();

    oauthSimpanRegistri_({ idKoneksi: sesi.idKoneksi, tokoId: sesi.tokoId, tokoNama: sesi.tokoNama, platform: 'shopee', slot: sesi.slot,
      status: 'Terhubung', shopId: String(shopId), terhubungPada: new Date(), berlakuSampai: new Date(expiredAt), oleh: sesi.email });
    result.success = true;
  } catch (err) { result.error = err.toString(); } finally { lock.releaseLock(); }
  return result;
}

function oauthTukarTokenTikTok_(code, sesi, p) {
  p = p || {};
  var result = { success: false };
  var lock = kunciModul_('token');
  try { lock.waitLock(20000); } catch (e) { result.error = 'Sistem sibuk, coba ulangi otorisasi.'; return result; }
  try {
    // 1) Tukar auth code -> token memakai app yang SAMA dengan yang dipakai di link otorisasi
    //    (app khusus toko kalau dipasang di slot ini, selain itu app MASTER)
    var app = (sesi && sesi.slot) ? tiktokAppUntukOtorisasi_(sesi.slot) : tiktokAppMaster_();
    var url = tiktokAuthHost_() + '/api/v2/token/get' +
      '?app_key=' + encodeURIComponent(app.appKey) + '&app_secret=' + encodeURIComponent(app.appSecret) +
      '&auth_code=' + encodeURIComponent(code) + '&grant_type=authorized_code'; // khusus TikTok Shop: "authorized_code"
    var res = fetchHemat(url, { method: 'get', muteHttpExceptions: true });
    var teks = res.getContentText();
    var d;
    try { d = JSON.parse(teks); } catch (e) { throw new Error('Respons TikTok bukan JSON (HTTP ' + res.getResponseCode() + '): ' + teks.substring(0, 200)); }
    if (res.getResponseCode() !== 200 || (d.code !== undefined && Number(d.code) !== 0) || !d.data || !d.data.access_token) {
      throw new Error(oauthPesanErrorTikTok_(d, res.getResponseCode()));
    }
    var tok = d.data;
    var expiredAt = tok.access_token_expire_in * 1000; // timestamp ABSOLUT (detik epoch), bukan durasi

    // 2) Toko mana yang baru memberi izin? (shop id, nama, cipher)
    var info = oauthAmbilTokoTikTok_(tok.access_token, p.shop_region, app);
    if (!info.id && !info.cipher) {
      throw new Error('Token diterima, tapi daftar toko yang diizinkan kosong' + (info.error ? ' (' + info.error + ')' : '') +
        '. Pastikan login memakai akun Seller Center pemilik toko & scope "Authorization/Shop" aktif di aplikasi.');
    }

    // 3) Tentukan koneksi tujuan
    var registri = oauthBacaRegistri_();
    var props = PropertiesService.getScriptProperties();
    var semuaProps = props.getProperties();
    var koneksi, menunggu = false;
    if (sesi.mode === 'tanpa-state') {
      // Otorisasi langsung (tanpa dasbor): HANYA cocokkan lewat Shop ID yang sudah tercatat.
      // Sengaja tidak menebak dari nama toko supaya toko asing tidak pernah masuk ke slot sync yang aktif.
      var cocok = registri.filter(function (k) { return k.platform === 'tiktok' && info.id && k.shopId === info.id; })[0];
      if (cocok) {
        koneksi = { idKoneksi: cocok.idKoneksi, tokoId: cocok.tokoId, tokoNama: cocok.tokoNama, platform: 'tiktok', slot: cocok.slot, email: sesi.email };
      } else {
        var idBaru = 'tt' + String(info.id || Utilities.getUuid().replace(/-/g, '').slice(0, 10));
        koneksi = { idKoneksi: idBaru + '-tiktok', tokoId: idBaru, tokoNama: (info.nama || 'Toko TikTok ' + info.id).slice(0, 60), platform: 'tiktok',
          slot: 'TOKO_' + idBaru.toUpperCase() + '_TIKTOK_', email: sesi.email };
        menunggu = true;
      }
    } else {
      koneksi = sesi;
      // Pengaman salah akun: kartu Conner tapi browser masih login Waterground (atau sebaliknya)
      var barisIni = registri.filter(function (k) { return k.idKoneksi === sesi.idKoneksi; })[0];
      if (barisIni && barisIni.shopId && info.id && /^\d+$/.test(barisIni.shopId) && barisIni.shopId !== info.id) {
        result.saran = ['Logout dari TikTok Shop Seller Center di browser ini (atau pakai jendela Incognito), lalu login dengan akun toko ' + sesi.tokoNama + '.'];
        throw new Error('Anda memberi izin untuk toko "' + (info.nama || info.id) + '", padahal koneksi ini milik ' + sesi.tokoNama + ' (Shop ID ' + barisIni.shopId + '). Token tidak disimpan.');
      }
    }
    // Toko yang sama tidak boleh terpasang di 2 koneksi (mencegah pesanan toko A masuk ke sheet toko B)
    var bentrok = registri.filter(function (k) {
      if (k.platform !== 'tiktok' || k.idKoneksi === koneksi.idKoneksi) return false;
      if (!semuaProps[k.slot + 'ACCESS_TOKEN']) return false;
      return (info.id && k.shopId === info.id) || (info.cipher && semuaProps[k.slot + 'SHOP_CIPHER'] === info.cipher);
    })[0];
    if (bentrok) {
      result.saran = ['Kalau ingin menghubungkan toko lain, logout dulu dari Seller Center (atau pakai jendela Incognito) lalu login dengan akun toko yang benar.'];
      throw new Error('Toko "' + (info.nama || info.id) + '" sudah terhubung sebagai koneksi ' + bentrok.tokoNama + '. Token tidak disimpan.');
    }

    // 4) Simpan token ke slot koneksi (Script Properties, tidak terlihat di Sheets/HTML)
    var set = {};
    set[koneksi.slot + 'ACCESS_TOKEN'] = tok.access_token;
    set[koneksi.slot + 'REFRESH_TOKEN'] = tok.refresh_token;
    set[koneksi.slot + 'TOKEN_EXPIRED_AT'] = String(expiredAt);
    if (tok.refresh_token_expire_in) set[koneksi.slot + 'REFRESH_EXPIRED_AT'] = String(tok.refresh_token_expire_in * 1000);
    if (info.cipher) set[koneksi.slot + 'SHOP_CIPHER'] = info.cipher;
    if (info.id) set[koneksi.slot + 'SHOP_ID'] = info.id;
    if (tok.granted_scopes) set[koneksi.slot + 'SCOPES'] = [].concat(tok.granted_scopes).join(',').slice(0, 2000);
    // Catat app penerbit token -> semua panggilan API slot ini wajib ditandatangani app yang sama
    // (koneksi tanpa-state yang slotnya ditentukan belakangan selalu lewat master)
    var viaFinal = (app.via === 'SENDIRI' && koneksi.slot === sesi.slot) ? 'SENDIRI' : 'MASTER';
    set[koneksi.slot + 'AUTH_VIA'] = viaFinal;
    props.setProperties(set);

    var status = menunggu ? 'Menunggu Persetujuan' : (info.cipher ? 'Terhubung' : 'Terhubung (shop cipher belum didapat)');
    oauthSimpanRegistri_({ idKoneksi: koneksi.idKoneksi, tokoId: koneksi.tokoId, tokoNama: koneksi.tokoNama, platform: 'tiktok', slot: koneksi.slot,
      status: status, shopId: info.id || '', namaMarketplace: info.nama || tok.seller_name || '', terhubungPada: new Date(),
      berlakuSampai: new Date(expiredAt), oleh: koneksi.email || sesi.email });

    result.idKoneksi = koneksi.idKoneksi;
    result.tokoNama = koneksi.tokoNama;
    result.namaTokoMarketplace = info.nama || tok.seller_name || '';
    result.menungguPersetujuan = menunggu;
    if (info.jumlah > 1) result.peringatan = ['Akun ini memberi izin ' + info.jumlah + ' toko; OmniAI memakai "' + info.nama + '" (' + (info.region || '-') + ').'];
    result.success = true;
  } catch (err) { result.error = err.message || err.toString(); } finally { lock.releaseLock(); }
  return result;
}

// Terjemahkan error token/get TikTok ke pesan yang bisa ditindaklanjuti (berbasis kata kunci pesan asli)
function oauthPesanErrorTikTok_(d, http) {
  var msg = String((d && (d.message || d.msg)) || '').trim();
  var kode = d && d.code !== undefined ? ' [kode ' + d.code + ']' : '';
  var saran = '';
  if (oauthPolaTokoSendiri_(msg)) return 'TikTok menolak penukaran token' + kode + ': ' + msg + ' -> ' + OAUTH_PESAN_TOKO_SENDIRI;
  if (/auth.?code|authorized.?code|expired|invalid.*code|code.*invalid|used/i.test(msg)) saran = 'Kode otorisasi kedaluwarsa atau sudah dipakai - ulangi dari tombol Hubungkan.';
  else if (/app.?key|app.?secret|appkey|secret|sign/i.test(msg)) saran = 'App Key/App Secret master tidak cocok - cek Script Properties TIKTOK_APP_KEY & TIKTOK_APP_SECRET.';
  else if (/not.*(launch|publish|online)|develop|permission|unauthori[sz]ed|forbidden/i.test(msg)) saran = 'Aplikasi belum dipublikasikan atau akun toko ini belum diizinkan memakai aplikasi (status In development / belum lolos review).';
  return 'TikTok menolak penukaran token' + kode + ': ' + (msg || ('HTTP ' + http)) + (saran ? ' -> ' + saran : '');
}

// Ambil toko yang memberi izin (id, nama, cipher). Kalau akun punya >1 toko, pilih yang region-nya
// sama dengan shop_region dari callback; jika tidak ada, toko pertama.
function oauthAmbilTokoTikTok_(accessToken, regionCallback, app) {
  app = app || tiktokAppMaster_();
  try {
    var path = '/authorization/202309/shops';
    var params = { app_key: app.appKey, timestamp: String(Math.floor(Date.now() / 1000)), version: '202309' };
    var url = MASTER_API_CONFIG.tiktok.apiHost + path + '?app_key=' + encodeURIComponent(params.app_key) + '&timestamp=' + params.timestamp +
      '&version=' + params.version + '&sign=' + buatSignatureTikTok(path, params, '', app.appSecret);
    var res = fetchHemat(url, { method: 'get', headers: { 'x-tts-access-token': accessToken }, muteHttpExceptions: true });
    var d = JSON.parse(res.getContentText());
    var shops = (d.data && d.data.shops) || [];
    if (!shops.length) return { error: d.message || ('HTTP ' + res.getResponseCode()), jumlah: 0 };
    var reg = String(regionCallback || '').toUpperCase();
    var s = (reg && shops.filter(function (x) { return String(x.region || '').toUpperCase() === reg; })[0]) || shops[0];
    return { cipher: s.cipher, nama: s.name, id: String(s.id || ''), region: s.region || '', jumlah: shops.length };
  } catch (e) { return { error: e.toString(), jumlah: 0 }; }
}

// Conner: token lama diterbitkan app Conner sendiri; setelah otorisasi ulang lewat OmniAI, pakai app MASTER.
// AUTH_VIA = 'SENDIRI' -> token dari app khusus Conner (CONNER_APP_KEY/SECRET/SERVICE_ID).
function connerAppKey_() {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty('CONNER_AUTH_VIA') === 'MASTER') return masterConfig_('tiktok', 'appKey');
  return tiktokAppSendiri_('CONNER_').appKey || masterConfig_('tiktok', 'appKey');
}
function connerAppSecret_() {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty('CONNER_AUTH_VIA') === 'MASTER') return masterConfig_('tiktok', 'appSecret');
  return tiktokAppSendiri_('CONNER_').appSecret || masterConfig_('tiktok', 'appSecret');
}

