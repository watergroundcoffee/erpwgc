  if (tampil && !p88Samar_(tampil) && !o.pembeliTersamar) return null; // sudah ada nama asli
  if (o.sumber === 'Shopee') {
    var bid = idx.snBuyer[String(o.noReferensi)], b = bid && idx.byBuyer[bid];
    if (b && b.nama) return { nama: b.nama, hp: b.hp || '', alamat: b.alamat || '', yakin: 'pasti', alasan: 'Akun Shopee sama (Buyer ID ' + bid + '), data tanpa sensor dari ' + b.sumber };
  }
