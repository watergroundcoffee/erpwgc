    if (!aktif) { delete peta[no][k]; return; }
    peta[no][k] = { waktu: pkFmt_(r[2]), waktuMs: r[2] instanceof Date ? r[2].getTime() : 0, waktuPerangkat: pkFmt_(r[3]), oleh: String(r[4] || ''), bukti: String(r[5] || ''), catatan: String(r[6] || '') };
    var mTerima_ = /Diterima oleh:\s*([^|]+)/.exec(String(r[6] || '')); // v2026.10.26
    if (mTerima_) { peta[no][k].diterimaOleh = mTerima_[1].trim(); peta[no][k].waktuDiterima = pkFmt_(r[3]); }
  });
  try { cache.put(PK_CACHE_, JSON.stringify(peta), 21600); } catch (e) { }
