  return new Date(ms);
}

/* ---------- KURIR TOKO: foto kamera belakang (paket) + depan (staff), watermark dibuat di HP ----------
   Menggantikan input No Resi untuk kurir "Kurir Toko". Sekaligus: status Dikirim, No Resi = No Invoice,
