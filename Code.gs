/* ============================================================
   AUTO-POTONG STOCK PAS RESI KELUAR DISCAN - sebelumnya PO Sales
   SAMA SEKALI nggak motong stock otomatis (beda dari TikTok Shop yang udah otomatis).
   Timestamp presisi (detik) - aman dipakai stock opname walau toko tetap buka/beroperasi.
   ============================================================ */
/* ============================================================
   S2 - PO SALES: STOK KELUAR SAAT STATUS "DIKIRIM" (anti dobel dengan scan resi)
   Satu pesanan hanya boleh dipotong SEKALI. Siapa pun yang duluan (klik Kirim / foto Kurir Toko / scan
   resi di gudang) menulis ledger 'Terjual PO Sales'; yang datang belakangan otomatis dilewati.
   Mesin stok tetap memakai WAKTU SCAN sebagai waktu fisik bila resinya discan (lihat smHitungMesinStok).
   ============================================================ */
var PO_TANDA_DIKIRIM_ = 'Auto: dikirim ';
function poInvoiceDariKet_(ket) {
  ket = String(ket || '');
  var m = ket.match(/\[INV:([^\]]+)\]/);
  if (m) return m[1].trim();
  m = ket.match(/discan keluar \(([^)]+)\)/);
  if (m) return m[1].trim();
  m = ket.match(/backdate\)\s+(\S+)/);
  if (m) return m[1].trim();
  return '';
}
// Sudah ada potongan stok untuk invoice ini? (TextFinder di kolom Keterangan - cepat walau ledger besar)
function poSudahKeluar_(noInvoice) {
  noInvoice = String(noInvoice || '').trim();
  if (!noInvoice) return false;
  if (SCAN_KTX_ && SCAN_KTX_.ledger) {
    for (var i = 0; i < SCAN_KTX_.ledger.length; i++) {
      var b = SCAN_KTX_.ledger[i];
      if (b[2] === 'Terjual PO Sales' && poInvoiceDariKet_(b[4]) === noInvoice) return true;
    }
  }
  var sh = getStockLedgerSheet(), lr = sh.getLastRow();
  if (lr < 2) return false;
  var sel = sh.getRange(2, 5, lr - 1, 1).createTextFinder(noInvoice).matchCase(true).findAll();
  for (var j = 0; j < sel.length; j++) {
    var row = sel[j].getRow();
    var r = sh.getRange(row, 1, 1, 5).getValues()[0];
    if (String(r[2]).trim() === 'Terjual PO Sales' && poInvoiceDariKet_(r[4]) === noInvoice) return true;
  }
  return false;
}
// Tulis potongan stok PO Sales saat dikirim. sumber: 'Dikirim' | 'Kurir Toko (foto)'. Return jumlah baris ditulis.
function poTulisKeluarDikirim_(noInvoice, waktu, oleh, sumber) {
  noInvoice = String(noInvoice || '').trim();
  if (!noInvoice || poSudahKeluar_(noInvoice)) return 0;
  var po = scanKtxPoSales_();
  var baris = (po.detail[noInvoice] || []).filter(function (x) { return x[0] && x[1] > 0; })
    .map(function (x) { return [waktu, x[0], 'Terjual PO Sales', x[1], PO_TANDA_DIKIRIM_ + '(' + (sumber || 'Dikirim') + ') [INV:' + noInvoice + ']', oleh || '']; });
  if (!baris.length) return 0;
  var sh = getStockLedgerSheet();
  baris.forEach(function (b) { sh.appendRow(b); }); // appendRow = aman dari tabrakan baris antar-proses
  try { smInvalidasiCache(); } catch (e) { }
  return baris.length;
}

function poBalikPotonganDikirim_(noInvoice, oleh) {
  if (!noInvoice) return 0;
  var sh = getStockLedgerSheet(), lr = sh.getLastRow();
  if (lr < 2) return 0;
  var vals = sh.getRange(2, 1, lr - 1, 5).getValues(), auto = [], sudahDibalik = false, adaScan = false;
  vals.forEach(function (r) {
    var ket = String(r[4] || '');
    if (poInvoiceDariKet_(ket) !== noInvoice && ket.indexOf('[INV:' + noInvoice + ']') < 0) return;
    if (String(r[2]).trim() === 'Terjual PO Sales') { if (ket.indexOf(PO_TANDA_DIKIRIM_) === 0) auto.push(r); else adaScan = true; }
    if (String(r[2]).trim() === 'Masuk' && ket.indexOf('Batal pesanan') === 0) sudahDibalik = true;
  });
  if (!auto.length || adaScan || sudahDibalik) return 0;
  // Sudah discan keluar di gudang? -> jangan dibalik
  var resiH = '';
  try { var po = scanKtxPoSales_(); Object.keys(po.resiKeInvoice).forEach(function (k) { if (po.resiKeInvoice[k] === noInvoice) resiH = k; }); } catch (e) { }
  if (resiH) {
    var lrR = getResiKeluarSheetAman_();
    if (lrR && lrR.indexOf(resiH) >= 0) return 0;
  }
  var waktu = new Date();
  var baris = auto.map(function (r) { return [waktu, r[1], 'Masuk', Math.abs(parseFloat(r[3]) || 0), 'Batal pesanan ' + noInvoice + ' sebelum discan - stok dikembalikan [INV:' + noInvoice + ']', oleh || '']; });
  baris.forEach(function (b) { sh.appendRow(b); }); // appendRow = aman dari tabrakan baris antar-proses
  try { smInvalidasiCache(); } catch (e2) { }
  return baris.length;
}
// Daftar kunci resi yang sudah discan keluar (non-Pending) - ringan, hanya dipakai saat batal pesanan
function getResiKeluarSheetAman_() {
  try { return smBacaSheet('Resi Keluar', 11).filter(function (r) { return String(r[10] || '').trim() !== 'Pending'; }).map(function (r) { return kunciResi_(r[0]); }); } catch (e) { return []; }
}

function potongStockDariScanResi(noResi, waktuScan, dicatatOleh) {
  // Resi Transfer Gudang Shopee = PINDAH GUDANG, bukan penjualan: stok dipindah ke in-transit, selesai.
  // Mengembalikan info deteksi: { jenis: 'kilat', noReservasi, ... } atau { jenis: 'reguler' }
  try { var infoKilat = tgsSaatResiDiscanKeluar_(noResi, waktuScan, dicatatOleh); if (infoKilat) return infoKilat; } catch (eTgs) { Logger.log('Transfer gudang saat scan gagal: ' + eTgs); }
  try {
    // Peta resi -> invoice & rincian PO Sales: di batch dibaca SEKALI untuk semua resi
    var po = scanKtxPoSales_();
    var noInvoiceKetemu = po.resiKeInvoice[kunciResi_(noResi)];
    if (!noInvoiceKetemu) return { jenis: 'reguler' }; // resi ini nggak nyambung ke pesanan PO Sales manapun (mungkin dari channel lain)
    // S2: stok pesanan ini sudah dipotong saat status "Dikirim" -> jangan dobel. Mesin stok otomatis
    // memakai waktu scan ini sebagai waktu fisik barang keluar.
    if (poSudahKeluar_(noInvoiceKetemu)) return { jenis: 'reguler', sudahDipotong: true };
    var baris = (po.detail[noInvoiceKetemu] || []).filter(function (x) { return x[0] && x[1] > 0; })
      .map(function (x) { return [waktuScan, x[0], 'Terjual PO Sales', x[1], 'Auto: resi ' + noResi + ' discan keluar (' + noInvoiceKetemu + ')', dicatatOleh]; });
    if (baris.length) {
      if (SCAN_KTX_) { (SCAN_KTX_.ledger = SCAN_KTX_.ledger || []).push.apply(SCAN_KTX_.ledger, baris); }
      else { var shLedger = getStockLedgerSheet(); shLedger.getRange(shLedger.getLastRow() + 1, 1, baris.length, 6).setValues(baris); }
    }
  } catch (e) {
    Logger.log('Gagal potong stock dari scan resi ' + noResi + ': ' + e.toString());
    // Sengaja nggak di-throw ulang - kegagalan potong stock nggak boleh bikin proses scan resi-nya gagal juga
  }
  return { jenis: 'reguler' };
}

/* ============================================================
   LOG RESI KELUAR / MASUK / PESANAN PENDING - versi web, dicocokkan
   fleksibel (baik yang discan itu No Resi ATAU No Invoice, dua-duanya dicoba).
   ============================================================ */
// Normalisasi berbagai teks status mentah (beda-beda tiap channel) jadi 4 kategori standar
// yang seragam buat ditampilin di kolom "Status Pesanan" - Resi Keluar maupun Resi Masuk.
function normalisasiStatusPesanan(statusMentah) {
  var s = String(statusMentah || '').toLowerCase();
  if (s.indexOf('retur') !== -1 || s.indexOf('return') !== -1) return 'Retur';
  if (s.indexOf('selesai') !== -1 || s.indexOf('completed') !== -1) return 'Pesanan Selesai';
  // v2026.10.25 (Paket 12, DN-261019-073117-753): dulu IN_TRANSIT / DELIVERED (TikTok & Tokopedia), TO_CONFIRM_RECEIVE (Shopee)
  // dan CANCELLED jatuh ke "Menunggu Kurir". Sekarang: sudah sampai -> "Terkirim", perjalanan -> "Dalam Pengiriman",
  // dibatalkan -> "Retur" (paket yang sudah keluar & dibatalkan harus kembali ke gudang).
  if (/belum\s*(di)?kirim/.test(s)) return 'Menunggu Kurir';
  if (/deliver|to_confirm_receive|terkirim|diterima|sampai/.test(s)) return 'Terkirim';
  if (s.indexOf('kirim') !== -1 || s.indexOf('shipped') !== -1 || s.indexOf('shipping') !== -1 || /transit|perjalanan/.test(s)) return 'Dalam Pengiriman';
  if (/cancel|batal/.test(s)) return 'Retur';
  return 'Menunggu Kurir';
}

// Klasifikasi 4-kategori buat tab Pengiriman: Belum Selesai / Perlu Dicek / Selesai / Komplain-Batal.
// "Perlu Dicek" = masih "Dalam Pengiriman" tapi udah lebih dari 7 hari - kemungkinan besar udah
// sampai ke pembeli tapi belum ada kepastian statusnya (channel belum update / lupa difinalisasi).
function klasifikasiStatusResi(statusPesanan, tanggalScan) {
  if (statusPesanan === 'Retur') return 'Komplain/Batal';
  if (statusPesanan === 'Pesanan Selesai') return 'Selesai';
  if (statusPesanan === 'Dalam Pengiriman' || statusPesanan === 'Terkirim') {
    var hariBerlalu = tanggalScan instanceof Date ? (Date.now() - tanggalScan.getTime()) / (1000 * 60 * 60 * 24) : 0;
    return hariBerlalu > 7 ? 'Perlu Dicek' : 'Belum Selesai';
  }
  return 'Belum Selesai'; // Menunggu Kurir
}

// PENTING (fix performa): dulu tiap baris resi manggil ulang fungsi yang baca SELURUH sheet
// Pesanan Manual dari nol (N baris resi = N kali baca sheet penuh - ini kemungkinan besar
// biang lag-nya). Sekarang petanya dibangun SEKALI aja di awal, sisanya tinggal lookup cepat
// di memori. Sekalian diperluas nyakup TikTok Shop & Shopee (sebelumnya cuma Pesanan Manual/PO
// Sales doang, jadi resi buat pesanan marketplace nggak pernah kecocokkan ke channel-nya).
/* ============================================================
   DIAGNOSTIK SBS SHOPEE (Gudang Shopee / Pengiriman Kilat) - SATU KLIK dari web
   ------------------------------------------------------------
   Tujuan: memastikan data apa saja yang benar-benar diberikan modul SBS untuk toko ini, TANPA perlu
   membuka API Test Tool. Parameter tiap endpoint belum terdokumentasi publik, jadi fungsi ini
   MENCOBA beberapa kombinasi parameter secara bertahap (paling sederhana dulu) dan berhenti di
   percobaan pertama yang berhasil. Semua respons mentah disimpan di sheet "Log SBS Shopee".
   Tidak ada data stok yang diubah - murni membaca.
   ============================================================ */
var SBS_SHEET_LOG = 'Log SBS Shopee';
var SBS_ENDPOINT = ['get_bound_whs_info', 'get_current_inventory', 'get_stock_movement', 'get_fulfillment_mapping_inventory_list', 'get_expiry_report', 'get_stock_aging'];

function sbsPanggil_(nama, params, kred) {
  var path = '/api/v2/sbs/' + nama, ts = Math.floor(Date.now() / 1000);
  var q = ['partner_id=' + getShopeePartnerId(), 'timestamp=' + ts, 'sign=' + buatSignatureShopee(path, ts, kred.accessToken, kred.shopId),
    'access_token=' + encodeURIComponent(kred.accessToken), 'shop_id=' + kred.shopId];
  Object.keys(params || {}).forEach(function (k) { q.push(encodeURIComponent(k) + '=' + encodeURIComponent(params[k])); });
  var res = fetchHemat(getShopeeHost() + path + '?' + q.join('&'), { method: 'get', muteHttpExceptions: true });
  var teks = res.getContentText(), json = null;
  try { json = JSON.parse(teks); } catch (e) { }
  var err = json ? String(json.error || '') : 'bukan_json';
  return { http: res.getResponseCode(), ok: !!json && !err && res.getResponseCode() === 200, error: err, pesan: json ? String(json.message || json.msg || '') : teks.slice(0, 200), json: json, teks: teks };
}

// Cari nilai pertama dengan nama field yang cocok (dalam objek bersarang)
function sbsCariNilai_(obj, pola, kedalaman) {
  if (!obj || typeof obj !== 'object' || (kedalaman || 0) > 6) return null;
  var keys = Object.keys(obj);
  for (var i = 0; i < keys.length; i++) if (pola.test(keys[i]) && (typeof obj[keys[i]] === 'string' || typeof obj[keys[i]] === 'number')) return obj[keys[i]];
  for (var j = 0; j < keys.length; j++) { var v = sbsCariNilai_(obj[keys[j]], pola, (kedalaman || 0) + 1); if (v !== null) return v; }
  return null;
}

// Ringkas struktur respons: array data pertama, jumlah item, nama field, contoh item, field yang berbau inbound/reservasi
function sbsRingkas_(json) {
  var hasil = { kunciAtas: [], jalurData: '', jumlah: 0, field: [], contoh: null, fieldInbound: [] };
  if (!json || typeof json !== 'object') return hasil;
  var resp = json.response || json.data || json;
  hasil.kunciAtas = Object.keys(resp || {});
  var semuaField = {};
  (function telusuri(o, jalur, d) {
    if (!o || typeof o !== 'object' || d > 6) return;
    if (Array.isArray(o)) {
      if (o.length && typeof o[0] === 'object' && !hasil.jalurData) { hasil.jalurData = jalur; hasil.jumlah = o.length; hasil.contoh = o[0]; }
      o.slice(0, 3).forEach(function (x) { telusuri(x, jalur + '[]', d + 1); });
      return;
    }
    Object.keys(o).forEach(function (k) { semuaField[(jalur ? jalur + '.' : '') + k] = true; telusuri(o[k], (jalur ? jalur + '.' : '') + k, d + 1); });
  })(resp, '', 0);
  hasil.field = Object.keys(semuaField).slice(0, 120);
  hasil.fieldInbound = hasil.field.filter(function (f) { return /inbound|reserv|asn|booking|ref|receiv|movement_type|type|reason|source/i.test(f); });
  return hasil;
}

function prosesDiagnostikSbsShopee(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'scanResiKeluar')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var kred = ambilKredensialShopee();
    if (!kred.accessToken || !kred.shopId) throw new Error('Shopee belum terhubung (token kosong).');
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var shLog = ss.getSheetByName(SBS_SHEET_LOG);
    if (!shLog) { shLog = ss.insertSheet(SBS_SHEET_LOG); shLog.getRange(1, 1, 1, 7).setValues([['Waktu', 'Endpoint', 'Parameter', 'HTTP', 'Error', 'Pesan', 'Respons (JSON)']]).setFontWeight('bold'); shLog.setFrozenRows(1); }
    var log = [], sekarang = Math.floor(Date.now() / 1000);

    function coba(nama, daftarParams) {
      var terakhir = null;
      for (var i = 0; i < daftarParams.length; i++) {
        var h = sbsPanggil_(nama, daftarParams[i], kred);
        log.push([new Date(), nama, JSON.stringify(daftarParams[i]), h.http, h.error, h.pesan, h.teks.slice(0, 45000)]);
        terakhir = { endpoint: nama, berhasil: h.ok, parameter: daftarParams[i], error: h.error, pesan: h.pesan, ringkas: sbsRingkas_(h.json), json: h.json };
        if (h.ok) return terakhir;
        // Error bukan soal parameter (izin / belum FBS / kuota) -> tidak perlu mencoba kombinasi lain
        if (h.error && !/param|invalid|required|missing|empty/i.test(h.error + ' ' + h.pesan)) return terakhir;
      }
      return terakhir;
    }

    // 1) Gudang terikat -> ambil ID gudang untuk endpoint lain
    var whs = coba('get_bound_whs_info', [{}]);
    var whsId = whs && whs.json ? sbsCariNilai_(whs.json, /^(whs_id|warehouse_id|whs_code|warehouse_code)$/i) : null;
    var hal = { page_no: 1, page_size: 20 };
    function dengan(o) { var x = {}; Object.keys(o).forEach(function (k) { x[k] = o[k]; }); return x; }
    var pWhs = whsId ? { whs_id: whsId } : {};
    var rentang = { start_time: sekarang - 30 * 86400, end_time: sekarang };
    var hasil = [whs];
    hasil.push(coba('get_current_inventory', [dengan(pWhs), Object.assign(dengan(pWhs), hal), Object.assign(dengan(pWhs), { page_no: 1, page_size: 20, search_type: 1 })]));
    hasil.push(coba('get_stock_movement', [Object.assign(dengan(pWhs), rentang), Object.assign(dengan(pWhs), rentang, hal),
      Object.assign(dengan(pWhs), { start_time: sekarang - 14 * 86400, end_time: sekarang }, hal), Object.assign(dengan(pWhs), { page_no: 1, page_size: 20 })]));
    hasil.push(coba('get_fulfillment_mapping_inventory_list', [{}, dengan(hal), Object.assign(dengan(pWhs), hal)]));
    hasil.push(coba('get_expiry_report', [dengan(pWhs), Object.assign(dengan(pWhs), hal)]));
    hasil.push(coba('get_stock_aging', [dengan(pWhs), Object.assign(dengan(pWhs), hal)]));

    // Booking (No Reservasi Pengiriman Kilat = Booking SN) - modul Order
    function cobaPath(label, path, params) {
      var h = shopeeGet_(path, params, kred);
      log.push([new Date(), label, JSON.stringify(params), h.ok ? 200 : '', h.error, h.pesan, h.teks.slice(0, 45000)]);
      return { endpoint: label, berhasil: h.ok, parameter: params, error: h.error, pesan: h.pesan, ringkas: sbsRingkas_(h.json), json: h.json };
    }
    var bl = cobaPath('order.get_booking_list', '/api/v2/order/get_booking_list', { time_range_field: 'update_time', time_from: sekarang - 15 * 86400 + 60, time_to: sekarang, page_size: 20, cursor: '' });
    hasil.push(bl);
    var snContoh = bl.json && bl.json.response && (bl.json.response.booking_list || []).slice(0, 3).map(function (b) { return b.booking_sn; }).filter(Boolean);
    if (snContoh && snContoh.length) {
      var bd = cobaPath('order.get_booking_detail', '/api/v2/order/get_booking_detail', { booking_sn_list: snContoh.join(','), response_optional_fields: 'item_list,package_list' });
      hasil.push(bd);
      result.bookingTersedia = bd.berhasil;
    } else result.bookingTersedia = bl.berhasil;
    if (log.length) shLog.getRange(shLog.getLastRow() + 1, 1, log.length, 7).setValues(log);
    result.whsId = whsId;
    result.hasil = hasil.map(function (h) { if (h) delete h.json; return h; });
    result.jumlahPanggilan = log.length;
    // Kesimpulan otomatis
    var mv = hasil[2];
    result.kesimpulan = result.bookingTersedia ? 'API Booking (Pengiriman Kilat) TERSEDIA - Booking SN, status, resi & produk bisa disinkron otomatis. ' : '';
    result.kesimpulan += !whs || !whs.berhasil ? 'Toko belum bisa mengakses SBS (lihat pesan error get_bound_whs_info).'
      : (mv && mv.berhasil ? (mv.ringkas.fieldInbound.length ? 'Pergerakan stok tersedia & ada field yang kemungkinan terkait inbound/reservasi: ' + mv.ringkas.fieldInbound.join(', ') : 'Pergerakan stok tersedia, tapi tidak terlihat field inbound/reservasi - cek contoh data.')
        : 'Gudang terhubung, tapi get_stock_movement belum berhasil - lihat pesan error.');
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   SINKRON BOOKING SHOPEE (Pengiriman Kilat / Advance Fulfillment)
   ------------------------------------------------------------
   Konfirmasi CS Shopee: No Reservasi Pengiriman Kilat = "Booking SN". Shopee Open API punya modul
   booking di kategori Order: v2.order.get_booking_list (daftar booking per rentang waktu, maks 15
   hari per panggilan) & v2.order.get_booking_detail (maks 50 booking_sn per panggilan).
   Alur otomatis (trigger tiap 30 menit + tombol di menu Pengiriman Kilat):
     1. Ambil booking 30 hari terakhir (per 15 hari, pakai update_time agar perubahan status ikut).
     2. Ambil detailnya -> Booking SN, status, resi, daftar produk (SKU + qty), order pembeli (kalau MATCHED).
     3. Isi/perbarui sheet "Transfer Gudang Shopee": No Reservasi = Booking SN. Produk & resi terisi
        sendiri -> resi kilat langsung dikenali saat discan & stok dipindah otomatis (tanpa input).
   Nama field detail tidak semuanya terdokumentasi publik, jadi pembacaan dibuat toleran (beberapa
   kemungkinan nama field). Respons mentah contoh disimpan di sheet "Log SBS Shopee" untuk audit.
   ============================================================ */
var BOOKING_HARI_MUNDUR = 60;
// Kandidat endpoint resi booking (dicoba berurutan; yang berhasil diingat di Script Properties)
var BOOKING_ENDPOINT_RESI = [
  { path: '/api/v2/logistics/get_booking_tracking_number', param: 'booking_sn' },
  { path: '/api/v2/logistics/get_booking_tracking_info', param: 'booking_sn' },
  { path: '/api/v2/logistics/get_tracking_number', param: 'booking_sn' }
];

function shopeeGet_(path, params, kred) {
  var ts = Math.floor(Date.now() / 1000);
  var q = ['partner_id=' + getShopeePartnerId(), 'timestamp=' + ts, 'sign=' + buatSignatureShopee(path, ts, kred.accessToken, kred.shopId),
    'access_token=' + encodeURIComponent(kred.accessToken), 'shop_id=' + kred.shopId];
  Object.keys(params || {}).forEach(function (k) { q.push(encodeURIComponent(k) + '=' + encodeURIComponent(params[k])); });
  var res = fetchHemat(getShopeeHost() + path + '?' + q.join('&'), { method: 'get', muteHttpExceptions: true });
  var teks = res.getContentText(), json = null;
  try { json = JSON.parse(teks); } catch (e) { }
  return { ok: !!json && !json.error && res.getResponseCode() === 200, error: json ? String(json.error || '') : 'bukan_json', pesan: json ? String(json.message || '') : teks.slice(0, 200), json: json, teks: teks };
}

function bookingAmbilList_(kred, hasil) {
  var semua = {}, sekarang = Math.floor(Date.now() / 1000);
  var props = PropertiesService.getScriptProperties();
  var field = props.getProperty('BOOKING_TIME_FIELD') || 'update_time';
  for (var awal = sekarang - BOOKING_HARI_MUNDUR * 86400; awal < sekarang; awal += 15 * 86400) {
    var akhir = Math.min(sekarang, awal + 15 * 86400 - 60), cursor = '', halaman = 0;
    do {
      var r = shopeeGet_('/api/v2/order/get_booking_list', { time_range_field: field, time_from: awal, time_to: akhir, page_size: 50, cursor: cursor }, kred);
      // update_time tidak didukung -> pakai create_time (diingat untuk jalan berikutnya)
      if (!r.ok && field === 'update_time' && /param|time_range/i.test(r.error + r.pesan)) {
        field = 'create_time'; props.setProperty('BOOKING_TIME_FIELD', field);
        r = shopeeGet_('/api/v2/order/get_booking_list', { time_range_field: field, time_from: awal, time_to: akhir, page_size: 50, cursor: cursor }, kred);
      }
      if (!r.ok) { hasil.error.push('get_booking_list: ' + r.error + ' ' + r.pesan); hasil.diagnosis.langkahGagal = 'daftar booking'; return semua; }
      var resp = r.json.response || {};
      (resp.booking_list || []).forEach(function (b) { if (b.booking_sn) semua[b.booking_sn] = String(b.booking_status || ''); });
      cursor = resp.next_cursor || '';
      halaman++;
    } while (resp.more && cursor && halaman < 20);
  }
  return semua;
}

// Baca field dengan beberapa kemungkinan nama (API Shopee kadang beda nama antar modul)
function bkAmbil_(o, nama) { for (var i = 0; i < nama.length; i++) if (o && o[nama[i]] !== undefined && o[nama[i]] !== null && o[nama[i]] !== '') return o[nama[i]]; return ''; }

function bookingUraikan_(b) {
  var resi = [];
  [b.tracking_number, b.tracking_no].concat((b.package_list || []).map(function (p) { return bkAmbil_(p, ['tracking_number', 'tracking_no', 'logistics_tracking_number']); }))
    .forEach(function (t) { t = String(t || '').trim(); if (t && resi.indexOf(t) === -1) resi.push(t); });
  var item = [];
  var sumberItem = b.item_list || [];
  if (!sumberItem.length) (b.package_list || []).forEach(function (p) { sumberItem = sumberItem.concat(p.item_list || []); });
  sumberItem.forEach(function (it) {
    var sku = String(bkAmbil_(it, ['model_sku', 'item_sku', 'sku', 'seller_sku']) || '').trim();
    var qty = Number(bkAmbil_(it, ['model_quantity_purchased', 'quantity', 'model_quantity', 'qty', 'item_count'])) || 0;
    if (sku && qty > 0) item.push({ sku: sku, nama: String(bkAmbil_(it, ['item_name', 'model_name']) || ''), qty: qty });
  });
  return {
    bookingSn: String(b.booking_sn || ''), status: String(b.booking_status || '').toUpperCase(), resi: resi, item: item,
    orderSn: String(bkAmbil_(b, ['order_sn', 'matched_order_sn']) || ''), kurir: String(bkAmbil_(b, ['shipping_carrier', 'logistics_channel_name']) || ''),
    dibuat: Number(bkAmbil_(b, ['create_time'])) || 0
  };
}

function sinkronBookingShopee_(opsi) {
  opsi = opsi || {};
  var hasil = { success: false, jumlahBooking: 0, baru: 0, diperbarui: 0, produkTerisi: 0, resiTerisi: 0, langsungDikirim: 0, skuTidakDikenal: [], error: [],
    diagnosis: { bookingDitemukan: 0, detailTerbaca: 0, punyaResiDiDetail: 0, resiDariEndpointTracking: 0, tanpaResi: 0, punyaProduk: 0, matched: 0, endpointResi: '', langkahGagal: '', fieldDetail: [] } };
  var kred = ambilKredensialShopee();
  if (!kred.accessToken || !kred.shopId) { hasil.error.push('Shopee belum terhubung.'); return hasil; }
  // FIX SCAN LAMBAT: dulu kunci pengiriman+stok dipegang SELAMA semua panggilan API Shopee (list, detail,
  // s/d 80x tracking) -> bisa 30-120 detik, dan selama itu SEMUA scan resi antre lalu ditolak "server sibuk".
  // Sekarang tahap API berjalan TANPA kunci; kunci baru diambil saat menulis ke sheet (hitungan detik).
  var lock = kunciModul_(['pengiriman', 'stok']);
  try {
    var daftar = bookingAmbilList_(kred, hasil);
    var sns = Object.keys(daftar);
    hasil.jumlahBooking = sns.length;
    if (!sns.length && !hasil.diagnosis.langkahGagal) hasil.diagnosis.langkahGagal = 'tidak ada booking dalam ' + BOOKING_HARI_MUNDUR + ' hari terakhir (atau toko/app belum punya akses modul booking)';
    var detail = [];
    for (var i = 0; i < sns.length; i += 50) {
      var batch = sns.slice(i, i + 50).join(',');
      var r = shopeeGet_('/api/v2/order/get_booking_detail', { booking_sn_list: batch, response_optional_fields: 'item_list,package_list' }, kred);
      if (!r.ok && /param/i.test(r.error + r.pesan)) r = shopeeGet_('/api/v2/order/get_booking_detail', { booking_sn_list: batch }, kred);
      if (!r.ok) { hasil.error.push('get_booking_detail: ' + r.error + ' ' + r.pesan); break; }
      var list = (r.json.response && (r.json.response.booking_list || r.json.response.list)) || [];
      if (i === 0 && list.length) { hasil.contohMentah = list[0]; hasil.diagnosis.fieldDetail = sbsRingkas_({ response: list[0] }).field.slice(0, 60); }
      list.forEach(function (b) { detail.push(bookingUraikan_(b)); });
    }
    hasil.diagnosis.bookingDitemukan = sns.length;
    hasil.diagnosis.detailTerbaca = detail.length;
    hasil.diagnosis.punyaResiDiDetail = detail.filter(function (d) { return d.resi.length; }).length;
    // Resi tidak ada di detail -> coba endpoint tracking booking. Booking yang resinya SUDAH tersimpan
    // di sheet tidak dipanggil lagi (hemat kuota). Endpoint yang berhasil diingat untuk jalan berikutnya.
    var sudahAdaResi = {};
    tgsBacaSemua_().forEach(function (t) { if (t.noResi) sudahAdaResi[t.noReservasi] = t.noResi; });
    var props = PropertiesService.getScriptProperties();
    var epDikenal = props.getProperty('BOOKING_ENDPOINT_RESI');
    var daftarEp = epDikenal ? BOOKING_ENDPOINT_RESI.filter(function (e) { return e.path === epDikenal; }) : BOOKING_ENDPOINT_RESI.slice();
    var sisaTracking = 80, cacheTrk = CacheService.getScriptCache();
    detail.forEach(function (d) {
      if (d.resi.length) return;
      if (sudahAdaResi[d.bookingSn]) { d.resi.push(sudahAdaResi[d.bookingSn]); return; }
      if (!daftarEp.length || sisaTracking <= 0 || d.status === 'CANCELLED') return;
      if (cacheTrk.get('BK_TANPA_RESI_' + d.bookingSn)) return; // baru dicek < 2 jam lalu
      for (var e = 0; e < daftarEp.length && sisaTracking > 0; e++) {
        sisaTracking--;
        var p = {}; p[daftarEp[e].param] = d.bookingSn;
        var t = shopeeGet_(daftarEp[e].path, p, kred);
        if (!t.ok) {
          // Endpoint tidak ada / tidak diizinkan -> buang dari daftar, coba kandidat berikutnya
          if (/not.?found|invalid|no.?permission|path|api/i.test(t.error + ' ' + t.pesan) && !/booking.*not|sn/i.test(t.pesan)) { daftarEp.splice(e, 1); e--; }
          continue;
        }
        var resp = t.json.response || {};
        var tn = String(bkAmbil_(resp, ['tracking_number', 'tracking_no', 'logistics_tracking_number']) || sbsCariNilai_(resp, /^tracking_(number|no)$/i) || '').trim();
        if (tn) { d.resi.push(tn); hasil.diagnosis.resiDariEndpointTracking++; hasil.diagnosis.endpointResi = daftarEp[e].path; props.setProperty('BOOKING_ENDPOINT_RESI', daftarEp[e].path); daftarEp = [daftarEp[e]]; }
        else cacheTrk.put('BK_TANPA_RESI_' + d.bookingSn, '1', 7200);
        break;
      }
    });
    hasil.diagnosis.tanpaResi = detail.filter(function (d) { return !d.resi.length && d.status !== 'CANCELLED'; }).length;
    hasil.diagnosis.punyaProduk = detail.filter(function (d) { return d.item.length; }).length;
    hasil.diagnosis.matched = detail.filter(function (d) { return d.orderSn; }).length;
    if (!hasil.diagnosis.langkahGagal && detail.length && hasil.diagnosis.tanpaResi === detail.length) hasil.diagnosis.langkahGagal = 'resi booking (tidak ada di detail & endpoint tracking tidak memberi resi)';

    // Tulis ke sheet Transfer Gudang Shopee - baru sekarang kunci diambil
    if (!lock.tryLock(20000)) { hasil.error.push('Sistem sibuk, coba lagi sebentar.'); return hasil; }
    tgsResetMemo_(); // baca ulang di dalam kunci supaya tidak menimpa perubahan yang terjadi selama tahap API
    var sh = tgsSheetHeader_(), shD = tgsSheetDetail_();
    if (!String(sh.getRange(1, 13).getValue() || '')) sh.getRange(1, 13).setValue('Order Pembeli (Shopee)').setFontWeight('bold');
    if (!String(sh.getRange(1, 14).getValue() || '')) sh.getRange(1, 14).setValue('Status Booking (Shopee)').setFontWeight('bold');
    var ada = {};
    tgsBacaSemua_().forEach(function (t) { ada[t.noReservasi] = t; });
    var tz = Session.getScriptTimeZone(), sekarang = new Date();
    var infoK = getSheetInfo('keluar'), shK = infoK.sheet, lrK = shK.getLastRow();
    var scanPeta = {};
    if (lrK > 1) shK.getRange(Math.max(2, lrK - 5999), 1, Math.min(lrK - 1, 6000), 11).getValues().forEach(function (v) {
      if (String(v[10] || '').trim() !== 'Pending') scanPeta[kunciResi_(v[0])] = v[2] instanceof Date ? v[2] : sekarang;
    });
    var perluCekScan = [];
    var skuMasterBk = {};
    try { var shMB = getMasterProdukSheet(), lmb = shMB.getLastRow(); if (lmb > 1) shMB.getRange(2, 1, lmb - 1, 1).getValues().forEach(function (r) { skuMasterBk[String(r[0]).trim().toUpperCase()] = 1; }); } catch (eMB) { }
    detail.forEach(function (d) {
      if (!d.bookingSn) return;
      var item = d.item.map(function (it) {
        var skuJual = resolveSkuJual(it.sku);
        if (!skuMasterBk[String(skuJual).toUpperCase()] && hasil.skuTidakDikenal.indexOf(it.sku) === -1) hasil.skuTidakDikenal.push(it.sku);
        return { sku: skuJual, nama: it.nama, qty: it.qty };
      });
      var resi = d.resi[0] || '';
      var t = ada[d.bookingSn];
      if (!t) {
        if (d.status === 'CANCELLED') return;
        var row = sh.getLastRow() + 1;
        sh.getRange(row, 1, 1, 4).setNumberFormat('@');
        sh.getRange(row, 1, 1, 14).setValues([[d.bookingSn, d.dibuat ? new Date(d.dibuat * 1000) : sekarang, '', resi, d.kurir || (resi ? deteksiKurir(resi) : ''), 'Draft',
          'Sinkron Shopee', '', '', 'Otomatis dari Booking Shopee', item.reduce(function (s, x) { return s + x.qty; }, 0), false, d.orderSn, d.status]]);
        if (item.length) {
          var mulai = shD.getLastRow() + 1;
          shD.getRange(mulai, 1, item.length, 2).setNumberFormat('@');
          shD.getRange(mulai, 1, item.length, 5).setValues(item.map(function (x) { return [d.bookingSn, x.sku, x.nama, x.qty, '']; }));
          hasil.produkTerisi++;
        }
        hasil.baru++;
        if (resi) { hasil.resiTerisi++; perluCekScan.push(resi); }
        return;
      }
      var berubah = false;
      if (resi && !t.noResi) { sh.getRange(t.row, 4).setNumberFormat('@').setValue(resi); if (!t.kurir) sh.getRange(t.row, 5).setValue(d.kurir || deteksiKurir(resi)); hasil.resiTerisi++; berubah = true; perluCekScan.push(resi); }
      if (item.length && !t.item.length && t.status === 'Draft') {
        var m2 = shD.getLastRow() + 1;
        shD.getRange(m2, 1, item.length, 2).setNumberFormat('@');
        shD.getRange(m2, 1, item.length, 5).setValues(item.map(function (x) { return [d.bookingSn, x.sku, x.nama, x.qty, '']; }));
        sh.getRange(t.row, 11).setValue(item.reduce(function (s, x) { return s + x.qty; }, 0));
        hasil.produkTerisi++; berubah = true;
        if (t.noResi) perluCekScan.push(t.noResi);
      }
      if (d.orderSn && d.orderSn !== t.orderPembeli) { sh.getRange(t.row, 13).setValue(d.orderSn); berubah = true; }
      if (d.status && d.status !== t.statusBooking) sh.getRange(t.row, 14).setValue(d.status);
      if (d.status === 'CANCELLED' && t.status === 'Draft' && !t.stokDipotong) { sh.getRange(t.row, 6).setValue('Batal'); berubah = true; }
      if (berubah) hasil.diperbarui++;
    });
    tgsResetMemo_();
    // Resi yang SUDAH discan keluar sebelum booking-nya tersinkron -> langsung pindahkan stok
    perluCekScan.forEach(function (r) {
      var w = scanPeta[kunciResi_(r)];
      if (!w) return;
      var info = tgsSaatResiDiscanKeluar_(r, w, 'Sinkron Shopee');
      if (info && info.status === 'Dikirim') hasil.langsungDikirim++;
    });
    if (hasil.baru || hasil.diperbarui) invalidasiCacheGabunganPesanan();
    PropertiesService.getScriptProperties().setProperty('BOOKING_SHOPEE_SYNC_TERAKHIR', String(Date.now()));
    try { PropertiesService.getScriptProperties().setProperty('BOOKING_DIAGNOSIS_TERAKHIR', JSON.stringify({ waktu: Date.now(), d: hasil.diagnosis, error: hasil.error.slice(0, 3) }).slice(0, 8500)); } catch (eD) { }
    hasil.success = hasil.error.length === 0 || hasil.jumlahBooking > 0;
  } catch (err) { hasil.error.push(err.toString()); } finally { lepasKunci_(lock); }
  return hasil;
}

function sinkronBookingShopeeTrigger() {
  if (typeof urlFetchSedangDiblokir === 'function' && urlFetchSedangDiblokir()) return;
  Logger.log('Sinkron Booking Shopee: ' + JSON.stringify(sinkronBookingShopee_()));
}
function pastikanTriggerBooking_() {
