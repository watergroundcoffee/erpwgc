}



/* =====================================================================================
   PEMBARUAN v2026.10f - Mass Importer Mapping SKU · SKU Bundling Marketplace
   CATATAN STRUKTUR DATA (disesuaikan dengan sheet yang benar-benar dipakai sistem):
   - Nama sheet = "Master Produk". Kolom F = "Batas Stok Menipis", kolom G = "Harga Shopee" -> TIDAK ditulis.
   - Pemetaan SKU Marketplace -> SKU Gudang disimpan di sheet "SKU Marketplace Terhubung" (sumber yang dibaca
     resolveSkuMarketplaceKeSkuJual saat pesanan masuk) + kolom "SKU Terhubung <Platform>" di Master Produk.
   - Stok TIDAK disimpan di satu kolom: stok dihitung dari Stock Ledger + detail pesanan (mesin stok).
     Jadi "potong stok" = mencatat baris keluar per SKU Gudang induk, bukan mengurangi angka di sel.
   ===================================================================================== */

/* ---------- SKU BUNDLING ---------- */
// Pemisah bundling: tanda tambah, koma, atau petik. Jumlah per komponen opsional: "SKU1*2+SKU2" / "SKU1 x 2".
var SKU_BUNDLING_POLA_ = /[+,']/;
var CACHE_SKU_MASTER_SET_ = null; // per eksekusi

// Kode SKU Gudang standar Waterground: 2 huruf + 5 angka (mis. WF42866)
var SKU_KODE_GUDANG_RE_ = /[A-Z]{2}\d{5}/g;
// "WF42866EY90156xxx" / "RJ36207KH34374EY90156" -> ['WF42866','EY90156'] (pengisi "xxx" dibuang).
// null kalau teks BUKAN rangkaian kode gudang (supaya SKU biasa tidak ikut terpecah).
function pecahKodeGabungan_(teks) {
  var t = String(teks || '').toUpperCase().replace(/\s+/g, '');
  if (!t) return null;
  var tanpaPengisi = t.replace(/X{3,}/g, '');
  if (!/^(?:[A-Z]{2}\d{5})+$/.test(tanpaPengisi)) return null;
  var kode = tanpaPengisi.match(SKU_KODE_GUDANG_RE_) || [];
  if (kode.length >= 2 || (kode.length === 1 && tanpaPengisi !== t)) return kode;
  return null;
}

// Parser mandiri: "SKU1+SKU2" -> [{ sku: 'SKU1', qty: 1 }, { sku: 'SKU2', qty: 1 }]
// - Pemisah: + , '   (boleh campur, spasi diabaikan)
// - Gabungan TANPA pemisah dari kode gudang 2 huruf + 5 angka: "WF42866EY90156xxx" -> WF42866 + EY90156
// - Jumlah komponen: "SKU1*2", "SKU1×2", atau "SKU1 x 2" (x harus diawali spasi agar SKU seperti "BOX2" aman)
// - SKU yang sama muncul 2x digabung jumlahnya ("A+A" -> A qty 2)
function parseSKUBundling(skuString) {
  var teks = String(skuString == null ? '' : skuString).replace(/[\u200B-\u200D\u2060\uFEFF]/g, '').replace(/\u00A0/g, ' ').trim();
  if (!teks) return [];
  var hasil = [], posisi = {};
  function masuk(sku, qty) {
    sku = String(sku || '').replace(/\s+/g, '');
    if (!sku || /^X{3,}$/i.test(sku)) return;
    var k = sku.toUpperCase();
    if (posisi.hasOwnProperty(k)) hasil[posisi[k]].qty += qty;
    else { posisi[k] = hasil.length; hasil.push({ sku: sku, qty: qty }); }
  }
  teks.split(/[+,']+/).forEach(function (bagian) {
    var b = String(bagian || '').trim();
    if (!b) return;
    var qty = 1, sku = b;
    var m = b.match(/^(.+?)\s*(?:\*|×|\s[xX])\s*(\d{1,3})$/);
    if (m && parseInt(m[2], 10) > 0) { sku = m[1].trim(); qty = parseInt(m[2], 10); }
    var gab = pecahKodeGabungan_(sku);
    if (gab) gab.forEach(function (k) { masuk(k, qty); });
    else masuk(sku, qty);
  });
  return hasil;
}

/* ----- Daftar resmi isi bundling (sheet "SKU Bundling") - diisi dari Import Excel Mapping SKU ----- */
var SMAP_SHEET_BUNDLING_ = 'SKU Bundling';
var CACHE_BUNDLING_ = null; // per eksekusi
function getSkuBundlingSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(SMAP_SHEET_BUNDLING_);
  if (!sh) {
    sh = ss.insertSheet(SMAP_SHEET_BUNDLING_);
    sh.getRange(1, 1, 1, 4).setValues([['SKU Bundle', 'Isi (SKU Gudang*qty, dipisah koma)', 'Nama Bundle', 'Diperbarui']]).setFontWeight('bold');
    sh.getRange('A:B').setNumberFormat('@');
    sh.setFrozenRows(1);
  }
  return sh;
}
function bacaIsiBundling_(teks) {
  return String(teks || '').split(/[,;\n]+/).map(function (x) {
    x = x.trim(); if (!x) return null;
    var m = x.match(/^(.+?)\s*\*\s*(\d+)$/);
    return m ? { sku: m[1].trim(), qty: parseInt(m[2], 10) || 1 } : { sku: x, qty: 1 };
  }).filter(function (x) { return x && x.sku; });
}
function petaBundling_() {
  if (CACHE_BUNDLING_) return CACHE_BUNDLING_;
  CACHE_BUNDLING_ = {};
  try {
    var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SMAP_SHEET_BUNDLING_);
    if (sh && sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues().forEach(function (r, i) {
      var k = String(r[0] || '').trim().toUpperCase(); if (!k) return;
      var isi = bacaIsiBundling_(r[1]);
      if (isi.length) CACHE_BUNDLING_[k] = { isi: isi, nama: String(r[2] || ''), row: i + 2, teks: String(r[1] || '') };
    });
  } catch (e) { }
  return CACHE_BUNDLING_;
}

function skuAdaDiMasterProduk_(sku) {
  if (!CACHE_SKU_MASTER_SET_) {
    CACHE_SKU_MASTER_SET_ = {};
    try {
      var sh = getMasterProdukSheet(), lr = sh.getLastRow();
      if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r) {
        var k = String(r[0] || '').trim().toUpperCase(); if (k) CACHE_SKU_MASTER_SET_[k] = true;
      });
    } catch (e) { }
  }
  return !!CACHE_SKU_MASTER_SET_[String(sku || '').trim().toUpperCase()];
}

// SKU dari pesanan -> daftar { sku: SKU Gudang (SKU Jual), qty, bundling } yang stoknya dipotong.
// Urutan: (1) kode utuh sudah dipetakan / terdaftar di Master Produk -> tidak dipecah,
// (2) terdaftar di sheet "SKU Bundling" -> pakai isi resminya, (3) ada pemisah + , ' atau berupa
// gabungan kode gudang tanpa pemisah ("WF42866EY90156xxx") -> dipecah. Tiap komponen dipetakan ke SKU Gudang induk.
function pecahSkuPesananBundling_(skuAsli, qtyPesanan) {
  var asli = String(skuAsli == null ? '' : skuAsli).trim();
  var qty = parseFloat(qtyPesanan); if (!(qty > 0)) qty = 0;
  if (!asli) return [];
  var utuh = resolveSkuMarketplaceKeSkuJual(asli);
  // v2026.10.39: kode yang terdaftar di sheet "SKU Bundling" SELALU dipecah ke isinya, walau kode itu
  // terlanjur ada di Produk Master (DN-261016-073448-942: bundling tanpa SKU gudang baru)
  var resmi = utuh === asli ? petaBundling_()[asli.toUpperCase().replace(/\s+/g, '')] : null;
  if (!resmi && (utuh !== asli || skuAdaDiMasterProduk_(asli))) return [{ sku: utuh, qty: qty, bundling: false }];
  var bagian = resmi ? resmi.isi : ((SKU_BUNDLING_POLA_.test(asli) || pecahKodeGabungan_(asli)) ? parseSKUBundling(asli) : []);
  if (!bagian.length) return [{ sku: utuh, qty: qty, bundling: false }];
  if (bagian.length === 1 && bagian[0].qty === 1 && !resmi) return [{ sku: resolveSkuMarketplaceKeSkuJual(bagian[0].sku), qty: qty, bundling: false }]; // mis. petik di depan: "'12345" / "WF42866xxx"
  var gabung = [], idx = {};
  bagian.forEach(function (b) {
    var induk = resolveSkuMarketplaceKeSkuJual(b.sku), k = induk.toUpperCase();
    if (idx.hasOwnProperty(k)) gabung[idx[k]].qty += b.qty * qty;
    else { idx[k] = gabung.length; gabung.push({ sku: induk, qty: b.qty * qty, bundling: true }); }
  });
  return gabung;
}

/* ---------- MASS IMPORTER MAPPING SKU ---------- */
// ===== AKSI: import_mapping_sku { json: '<teks JSON>', platform?: 'Shopee'|'TikTok Shop'|'Tokopedia'|'' } =====
// Format JSON yang diterima:
//   { "SKU-MARKETPLACE": "SKU-GUDANG", ... }
//   { "SKU-GUDANG": ["SKU-MP-1", "SKU-MP-2"] }                         (nilai berupa daftar)
//   [ { "skuMarketplace": "...", "skuGudang": "...", "platform": "Shopee" }, ... ]
//   [ ["SKU-MARKETPLACE", "SKU-GUDANG", "Shopee"], ... ]

function importMappingPlatform_(teks) {
  var t = String(teks || '').trim();
  if (!t) return '';
  for (var i = 0; i < SKUP_PLATFORM.length; i++) if (SKUP_PLATFORM[i].cocok.test(t)) return SKUP_PLATFORM[i].platform;
  return '';
}
function importMappingNormalisasi_(masukan, platformDefault) {
  var obj = masukan;
  if (typeof obj === 'string') {
    try { obj = JSON.parse(obj); } catch (e) { throw new Error('Format JSON tidak valid: ' + String(e.message || e).replace(/^SyntaxError:\s*/, '')); }
  }
  var hasil = [];
  function ambil(o, kunci) { for (var i = 0; i < kunci.length; i++) if (o[kunci[i]] !== undefined && o[kunci[i]] !== null && String(o[kunci[i]]).trim() !== '') return o[kunci[i]]; return ''; }
  function tambah(mp, gudang, platform) {
    var pl = importMappingPlatform_(platform) || platformDefault;
    var daftarMp = Array.isArray(mp) ? mp : String(mp == null ? '' : mp).split(/[,;\r\n]+/);
    daftarMp.forEach(function (x) {
      var kode = String(x == null ? '' : x).replace(/^'+/, '').replace(/\s+/g, '');
      var g = String(gudang == null ? '' : gudang).replace(/^'+/, '').trim();
      if (kode && g) hasil.push({ mp: kode, gudang: g, platform: pl });
      else hasil.push({ mp: kode, gudang: g, platform: pl, tidakLengkap: true });
    });
  }
  function proses(item) {
    if (Array.isArray(item)) { tambah(item[0], item[1], item[2]); return; }
    if (item && typeof item === 'object') {
      var mp = ambil(item, ['skuMarketplace', 'sku_marketplace', 'SKU Marketplace', 'marketplace', 'mp', 'sellerSku', 'seller_sku']);
      var g = ambil(item, ['skuGudang', 'sku_gudang', 'SKU Gudang', 'gudang', 'skuJual', 'SKU Jual', 'sku']);
      tambah(mp, g, ambil(item, ['platform', 'Platform', 'channel']));
    }
  }
  if (Array.isArray(obj)) obj.forEach(proses);
  else if (obj && typeof obj === 'object') {
    var bungkus = obj.mapping || obj.data || obj.daftar;
    if (Array.isArray(bungkus)) bungkus.forEach(proses);
    else Object.keys(obj).forEach(function (k) {
      var v = obj[k];
      if (Array.isArray(v)) tambah(v, k, '');                                   // { gudang: [mp, mp] }
      else if (v && typeof v === 'object') tambah(k, ambil(v, ['skuGudang', 'sku_gudang', 'gudang', 'sku']), ambil(v, ['platform']));
      else tambah(k, v, '');                                                    // { mp: gudang }
    });
  } else throw new Error('JSON harus berupa objek {"SKU Marketplace": "SKU Gudang"} atau daftar pasangan.');
  return hasil;
}

function prosesImportMappingSku_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var platformDefault = importMappingPlatform_(data.platform);
    var daftar = importMappingNormalisasi_(data.json !== undefined ? data.json : data.daftar, platformDefault);
    if (!daftar.length) throw new Error('Tidak ada pasangan SKU yang terbaca dari JSON.');
    if (daftar.length > 5000) throw new Error('Maksimal 5.000 pasangan per import - pecah menjadi beberapa kali.');

    // 1) Master Produk: SKU Gudang yang sah (dicocokkan tanpa beda huruf besar/kecil)
    var shM = getMasterProdukSheet(data.toko), lrM = shM.getLastRow();
    var master = {};
    if (lrM > 1) shM.getRange(2, 1, lrM - 1, 1).getValues().forEach(function (r, i) {
      var s = String(r[0] || '').trim(); if (s && !master[s.toUpperCase()]) master[s.toUpperCase()] = { sku: s, row: i + 2 };
    });

    // 2) Sheet pemetaan "SKU Marketplace Terhubung" (A SKU Jual, B SKU Marketplace, C Platform)
    var shL = getSkuMarketplaceTerhubungSheet(), lrL = shL.getLastRow();
    var link = lrL > 1 ? shL.getRange(2, 1, lrL - 1, 3).getValues() : [];
    var pemilik = {}, adaDiPlatform = {}, linkBerubah = false, barisBaru = [];
    link.forEach(function (r, i) {
      var sj = String(r[0] || '').trim(); if (!sj) return;
      var pl = importMappingPlatform_(r[2]) || String(r[2] || '').trim();
      String(r[1] || '').split(/[\s,;]+/).forEach(function (k) {
        k = k.trim(); if (!k) return;
        if (!pemilik[k.toUpperCase()]) pemilik[k.toUpperCase()] = sj;
        adaDiPlatform[sj.toUpperCase() + '|' + pl.toUpperCase() + '|' + k.toUpperCase()] = true; // kode ini sudah tercatat utk produk + platform tsb
      });
    });

    // 3) Kolom "SKU Terhubung <Platform>" di Master Produk (opsional, kalau kolomnya ada)
    SYNC_KOLOM_MEMO_ = null;
    var kol = {}; try { kol = syncKolomSkuTerhubungMaster_(data.toko) || {}; } catch (eK) { kol = {}; }
    var isiKolom = {}, kolomBerubah = {};
    function kolomPlatform(pl) {
      var k = kol[pl]; if (!pl || !k || k.dobel || lrM < 2) return null;
      if (!isiKolom[pl]) isiKolom[pl] = shM.getRange(2, k.nomor, lrM - 1, 1).getValues();
      return isiKolom[pl];
    }
    function gabungSel(nilaiLama, kode) {
      var ada = String(nilaiLama || '').split(/[,;\r\n]+/).map(function (x) { return x.trim(); }).filter(function (x) { return x; });
      if (ada.some(function (x) { return x.toUpperCase() === kode.toUpperCase(); })) return null; // sudah ada -> tidak berubah
      ada.push(kode);
      return ada.join(', ');
    }

    var ditambah = 0, sudahAda = 0, dilewati = [], konflik = [], tidakLengkap = 0, kodeDiproses = {};
    daftar.forEach(function (it) {
      if (it.tidakLengkap) { tidakLengkap++; return; }
      var g = master[it.gudang.toUpperCase()];
      if (!g) { dilewati.push(it.gudang); return; } // SKU Gudang tidak ada di Master Produk -> skip, lanjut
      var kodeU = it.mp.toUpperCase();
      var milik = pemilik[kodeU];
      if (milik && milik.toUpperCase() !== g.sku.toUpperCase()) { konflik.push({ mp: it.mp, dipakai: milik, diminta: g.sku }); return; }
      var berubahIni = false;
      // 1 baris per (SKU Gudang, SKU Marketplace, Platform) - format yang sama dengan editor SKU Terhubung di Katalog,
      // sehingga tiap kode tampil di kolom SKU Marketplace sesuai platformnya. Baris lama TIDAK diubah / dihapus.
      var kunciPf = g.sku.toUpperCase() + '|' + String(it.platform || '').toUpperCase() + '|' + kodeU;
      if (!adaDiPlatform[kunciPf]) {
        barisBaru.push([g.sku, it.mp, it.platform, 'Import Mapping SKU ' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy')]);
        adaDiPlatform[kunciPf] = true;
        berubahIni = true;
      }
      if (!milik) pemilik[kodeU] = g.sku;
      // Kolom platform di Master Produk: tambahkan dengan pemisah koma, isi lama dipertahankan
      var isi = kolomPlatform(it.platform);
      if (isi) {
        var baruKol = gabungSel(isi[g.row - 2][0], it.mp);
        if (baruKol !== null) { isi[g.row - 2][0] = baruKol; kolomBerubah[it.platform] = true; berubahIni = true; }
      }
      if (kodeDiproses[kunciPf]) return; // pasangan dobel di JSON dihitung sekali
      kodeDiproses[kunciPf] = true;
      if (berubahIni) ditambah++; else sudahAda++;
    });

    // 4) Tulis sekali jalan (batch) - kolom lain di sheet tidak disentuh
    if (linkBerubah && link.length) {
      var rgB = shL.getRange(2, 2, link.length, 1);
      rgB.setNumberFormat('@');
      rgB.setValues(link.map(function (r) { return [r[1]]; }));
    }
    if (barisBaru.length) {
      var awal = shL.getLastRow() + 1;
      shL.getRange(awal, 2, barisBaru.length, 1).setNumberFormat('@');
      shL.getRange(awal, 1, barisBaru.length, 4).setValues(barisBaru);
    }
    Object.keys(kolomBerubah).forEach(function (pl) {
      var rg = shM.getRange(2, kol[pl].nomor, lrM - 1, 1);
      rg.setNumberFormat('@');
      rg.setValues(isiKolom[pl]);
    });
    SpreadsheetApp.flush();
    try { katInvalidasiCacheKatalog_(data.toko); } catch (eI) { }
    try { invalidasiCacheKatalogHarga(data.toko); } catch (eH) { }
    SYNC_KOLOM_MEMO_ = null; CACHE_SKU_MASTER_SET_ = null;

    var unikDilewati = [];
    dilewati.forEach(function (x) { if (unikDilewati.indexOf(x) === -1) unikDilewati.push(x); });
    result.success = true;
    result.total = daftar.length;
    result.ditambah = ditambah;
    result.sudahAda = sudahAda;
    result.dilewati = unikDilewati.slice(0, 100);
    result.jumlahDilewati = dilewati.length;
    result.konflik = konflik.slice(0, 100);
    result.jumlahKonflik = konflik.length;
    result.tidakLengkap = tidakLengkap;
    result.barisBaru = barisBaru.length;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}



/* =====================================================================================
   PEMBARUAN v2026.10g - IMPORT EXCEL MAPPING SKU (Excel internal + export TikTok Shop & Shopee)
   Browser membaca & merapikan file (SheetJS) -> server mencocokkan ke data sistem (smap_analisis) ->
   user meninjau per baris -> server menyimpan yang dicentang (smap_simpan).
   Aturan yang disepakati:
   - Data Excel MENIMPA nama & harga modal di Master Produk (kolom 2 & 4). Harga jual TIDAK diubah.
   - SKU dobel: harga modal tertinggi; produk kopi: HPP sheet KOPI (hasil hitung roasting) yang dipakai.
   - SKU Gudang yang belum ada: ditampilkan, user memilih per baris (default tidak dicentang).
   - SKU Supplier -> sheet "SKU Supplier Terhubung"; kode marketplace yang berbeda dari SKU Gudang ->
     "SKU Marketplace Terhubung"; isi bundling -> sheet "SKU Bundling". Semua hanya MENAMBAH, tidak menghapus.
   ===================================================================================== */
function smapU_(v) { return String(v == null ? '' : v).replace(/[\u200B-\u200D\u2060\uFEFF]/g, '').replace(/^'+/, '').replace(/\s+/g, '').toUpperCase(); }
function smapTeks_(v) { return String(v == null ? '' : v).replace(/\s+/g, ' ').trim(); }
function smapAngka_(v) { var n = parseFloat(String(v == null ? '' : v).replace(/[^\d.,-]/g, '').replace(/\.(?=\d{3}(\D|$))/g, '').replace(',', '.')); return isFinite(n) ? n : 0; }
function smapToken_(teks) {
  var STOP = { one: 1, two: 1, cups: 1, dan: 1, untuk: 1, the: 1, with: 1, dengan: 1, isi: 1, wgc: 1, premium: 1, original: 1, '-': 1 };
  return String(teks || '').toLowerCase().replace(/(\d)\s+(ml|g|gr|gram|kg|cm|mm|l|pcs)\b/g, '$1$2').split(/[^a-z0-9]+/)
    .filter(function (w) { return w && w.length >= 2 && !STOP[w]; });
}
function smapMirip_(a, b) {
  var A = {}, B = {}, n = 0, u = 0;
  a.forEach(function (w) { A[w] = 1; }); b.forEach(function (w) { B[w] = 1; });
  Object.keys(A).forEach(function (w) { u++; if (B[w]) n += /\d/.test(w) ? 2 : 1; });
  Object.keys(B).forEach(function (w) { if (!A[w]) u++; });
  return u ? Math.min(1, n / u) : 0;
}

// Data sistem yang dipakai pencocokan (dibaca sekali per request)
function smapBacaSistem_(toko) {
  var D = { master: {}, supOwner: {}, supPer: {}, mpOwner: {}, mpPf: {}, bundling: petaBundling_(), daftarNama: [], kolPf: {} };
  var shM = getMasterProdukSheet(toko), lr = shM.getLastRow();
  SYNC_KOLOM_MEMO_ = null;
  try { D.kolPf = syncKolomSkuTerhubungMaster_(toko) || {}; } catch (eK) { D.kolPf = {}; }
  if (lr > 1) {
    var lebar = Math.max(8, KAT_KOL_STATUS);
    Object.keys(D.kolPf).forEach(function (pf) { var k = D.kolPf[pf]; if (k && !k.dobel) lebar = Math.max(lebar, k.nomor); });
    lebar = Math.min(lebar, shM.getLastColumn());
    shM.getRange(2, 1, lr - 1, lebar).getValues().forEach(function (r, i) {
      var sku = String(r[0] || '').trim(); if (!sku) return;
      var u = sku.toUpperCase(); if (D.master[u]) return;
      D.master[u] = { sku: sku, nama: smapTeks_(r[1]), modal: smapAngka_(r[3]), kategori: smapTeks_(r[7]), row: i + 2,
        arsip: lebar >= KAT_KOL_STATUS && String(r[KAT_KOL_STATUS - 1] || '').trim() === KAT_STATUS_ARSIP, pf: {} };
      Object.keys(D.kolPf).forEach(function (pf) {
        var k = D.kolPf[pf]; if (!k || k.dobel || k.nomor > r.length) return;
        D.master[u].pf[pf] = String(r[k.nomor - 1] || '').split(/[\s,;]+/).map(smapU_).filter(function (x) { return x; });
      });
      if (D.master[u].nama) D.daftarNama.push({ sku: sku, nama: D.master[u].nama, tok: smapToken_(D.master[u].nama) });
    });
  }
  var shS = getSkuSupplierTerhubungSheet(), lrS = shS.getLastRow();
  if (lrS > 1) shS.getRange(2, 1, lrS - 1, 2).getValues().forEach(function (r) {
    var sj = String(r[0] || '').trim(), ks = smapU_(r[1]); if (!sj || !ks) return;
    if (!D.supOwner[ks]) D.supOwner[ks] = sj;
    (D.supPer[sj.toUpperCase()] = D.supPer[sj.toUpperCase()] || []).push(ks);
  });
  var shL = getSkuMarketplaceTerhubungSheet(), lrL = shL.getLastRow();
  if (lrL > 1) shL.getRange(2, 1, lrL - 1, 3).getValues().forEach(function (r) {
    var sj = String(r[0] || '').trim(); if (!sj) return;
    var pf = importMappingPlatform_(r[2]) || String(r[2] || '').trim();
    String(r[1] || '').split(/[\s,;]+/).forEach(function (k) {
      k = smapU_(k); if (!k) return;
      if (!D.mpOwner[k]) D.mpOwner[k] = sj;
      D.mpPf[sj.toUpperCase() + '|' + pf.toUpperCase() + '|' + k] = true;
    });
  });
  return D;
}

// ===== AKSI: smap_analisis { internal:[{sku,nama,modal,supp:[],kategori,sumber,kopi}], marketplace:[{platform,kode,nama,variasi}], bundling:[{kode,isi:[sku],nama}] } =====
function prosesSmapAnalisis(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var D = smapBacaSistem_(data.toko);
    var internal = Array.isArray(data.internal) ? data.internal : [], mp = Array.isArray(data.marketplace) ? data.marketplace : [];
    var bund = Array.isArray(data.bundling) ? data.bundling : [];
    var baris = [], dikenal = {}, supInternal = {}, statistik = { langsung: 0, sudah: 0, kosong: 0 };

    // 1) Produk dari Excel internal (sudah dirapikan & digabung di browser)
    internal.forEach(function (p) {
      var u = smapU_(p.sku); if (!u) return;
      dikenal[u] = p;
      (p.supp || []).forEach(function (k) { k = smapU_(k); if (k && k !== u && !supInternal[k]) supInternal[k] = u; });
    });
    Object.keys(dikenal).forEach(function (u) {
      var p = dikenal[u], m = D.master[u];
      var namaBaru = smapTeks_(p.nama), modalBaru = Math.round(smapAngka_(p.modal));
      var sudahSup = (D.supPer[(m ? m.sku : p.sku).toUpperCase()] || []);
      var supBaru = [], supKonflik = [];
      (p.supp || []).forEach(function (k) {
        var ku = smapU_(k); if (!ku || ku === u || sudahSup.indexOf(ku) !== -1 || supBaru.indexOf(ku) !== -1) return;
        var pemilik = D.supOwner[ku];
        if (pemilik && pemilik.toUpperCase() !== u) supKonflik.push({ kode: ku, milik: pemilik }); else supBaru.push(ku);
      });
      var row = { id: 'p:' + u, jenis: 'produk', sku: m ? m.sku : String(p.sku).trim(), sumber: p.sumber || '', kategori: smapTeks_(p.kategori),
        namaLama: m ? m.nama : '', namaBaru: namaBaru, modalLama: m ? Math.round(m.modal) : 0, modalBaru: modalBaru,
        supBaru: supBaru, supKonflik: supKonflik, catatan: p.catatan || '', arsip: m ? !!m.arsip : false };
      row.ubahNama = !!namaBaru && namaBaru !== row.namaLama;
      row.ubahModal = modalBaru > 0 && modalBaru !== row.modalLama;
      if (!m) row.status = 'baru';
      else row.status = (row.ubahNama || row.ubahModal || supBaru.length) ? 'ubah' : 'sama';
      if (supKonflik.length && row.status === 'sama') row.status = 'konflik';
      baris.push(row);
    });

    // 2) Daftar bundling resmi dari Excel internal
    var bundDiproses = {};
    bund.forEach(function (b) {
      var kode = smapU_(b.kode); if (!kode || bundDiproses[kode]) return;
      bundDiproses[kode] = true;
      var isi = (b.isi || []).map(smapU_).filter(function (x) { return x && !/^X{3,}$/.test(x); });
      if (!isi.length) return;
      var tidakAda = isi.filter(function (k) { return !D.master[k] && !dikenal[k]; });
      var lama = D.bundling[kode], teksIsi = isi.join(', ');
      baris.push({ id: 'b:' + kode, jenis: 'bundle', kode: kode, isi: isi, nama: smapTeks_(b.nama), tidakAda: tidakAda,
        status: lama && lama.isi.map(function (x) { return smapU_(x.sku); }).join(', ') === teksIsi ? 'sama' : (tidakAda.length ? 'cek' : 'bundling') });
    });

    // 3) SKU Penjual di TikTok Shop / Shopee
    var mpDiproses = {}, perluCari = [], mpBaru = {}, daftarMp = {}, barisPer = {};
    baris.forEach(function (r) { if (r.jenis === 'produk') barisPer[r.id] = r; });
    // Sudah terdaftar = ada di kolom "SKU Terhubung <Platform>" produk itu DAN tercatat di sheet SKU Marketplace
    // Terhubung UNTUK PLATFORM YANG SAMA (yang ditampilkan kolom SKU Marketplace di Katalog > Produk Master)
    function sudahTerdaftar(skuU, kode, pf) {
      var m = D.master[skuU];
      var diKolom = m && D.kolPf[pf] && !D.kolPf[pf].dobel ? (m.pf[pf] || []).indexOf(kode) !== -1 : false;
      return diKolom && !!D.mpPf[skuU + '|' + pf.toUpperCase() + '|' + kode];
    }
    function daftarkan(skuTarget, kode, platforms) {
      var su = smapU_(skuTarget);
      platforms.forEach(function (pf) {
        if (sudahTerdaftar(su, kode, pf)) { statistik.sudah++; return; }
        var l = daftarMp[su] || (daftarMp[su] = { sku: skuTarget, isi: [], kunci: {} });
        if (l.kunci[kode + '|' + pf]) return;
        l.kunci[kode + '|' + pf] = 1;
        l.isi.push({ kode: kode, platform: pf });
      });
    }
    mp.forEach(function (x) {
      var kode = smapU_(x.kode), platform = smapTeks_(x.platform);
      if (!kode || kode === '-' || kode === 'NONE' || kode === 'NULL') { statistik.kosong++; return; }
      var kunci = kode + '|' + platform; if (mpDiproses[kunci]) return; mpDiproses[kunci] = true;
      // Listing TikTok Shop yang juga tayang di Tokopedia (ada link Tokopedia) -> kode yang sama didaftarkan untuk keduanya
      var platforms = [platform].concat(x.tokopedia && platform === 'TikTok Shop' ? ['Tokopedia'] : []);
      var namaMp = smapTeks_(x.nama) + (x.variasi && !/^default$/i.test(String(x.variasi)) ? ' · ' + smapTeks_(x.variasi) : '');
      if (D.master[kode] || dikenal[kode]) { statistik.langsung++; daftarkan(D.master[kode] ? D.master[kode].sku : dikenal[kode].sku, kode, platforms); return; } // SKU Penjual = SKU Gudang
      if (D.mpOwner[kode]) { daftarkan(D.mpOwner[kode], kode, platforms); return; }      // sudah dipetakan - lengkapi kolom platform bila belum
      var milikSup = D.supOwner[kode] || (supInternal[kode] ? (D.master[supInternal[kode]] ? D.master[supInternal[kode]].sku : dikenal[supInternal[kode]].sku) : '');
      if (milikSup) { baris.push({ id: 'm:' + kunci, jenis: 'mapping', kode: kode, platform: platform, platforms: platforms, namaMp: namaMp, sku: milikSup, status: 'mapping', alasan: 'Kode ini adalah SKU Supplier dari ' + milikSup }); return; }
      if (D.bundling[kode] || bundDiproses[kode]) { statistik.langsung++; return; }           // bundling resmi
      var gab = parseSKUBundling(kode);
      if (gab.length >= 2 || pecahKodeGabungan_(kode)) {
        var isi = gab.map(function (g) { return smapU_(g.sku) + (g.qty > 1 ? '*' + g.qty : ''); });
        var tidakAda = gab.filter(function (g) { var k = smapU_(g.sku); return !D.master[k] && !dikenal[k]; }).map(function (g) { return smapU_(g.sku); });
        if (gab.length === 1 && !tidakAda.length) { statistik.langsung++; return; }         // "WF42866xxx" = 1 produk
        baris.push({ id: 'b:' + kode, jenis: 'bundle', kode: kode, isi: isi, nama: namaMp, platform: platform, tidakAda: tidakAda, status: tidakAda.length ? 'cek' : 'bundling' });
        return;
      }
      // Kode berformat SKU Gudang (2 huruf + 5 angka) tapi belum ada di sistem & Excel -> usulan produk baru
      if (/^[A-Z]{2}\d{5}$/.test(kode)) {
        if (!mpBaru[kode]) { mpBaru[kode] = true; var rb = { id: 'p:' + kode, jenis: 'produk', sku: kode, sumber: platform, kategori: '', namaLama: '', namaBaru: namaMp.slice(0, 200), modalLama: 0, modalBaru: 0, supBaru: [], supKonflik: [], status: 'baru', ubahNama: true, ubahModal: false, catatan: 'Hanya ada di ' + platform + ' - harga modal belum diketahui' }; baris.push(rb); barisPer[rb.id] = rb; }
        daftarkan(kode, kode, platforms);
        return;
      }
      var r = { id: 'm:' + kunci, jenis: 'mapping', kode: kode, platform: platform, platforms: platforms, namaMp: namaMp, sku: '', status: 'cari', kandidat: [] };
      baris.push(r); perluCari.push(r);
    });

    // 3b) Tempelkan SKU marketplace yang akan didaftarkan ke baris produknya (baris baru untuk produk yang tidak ada di Excel)
    var totalMpBaru = 0;
    Object.keys(daftarMp).forEach(function (su) {
      var l = daftarMp[su]; if (!l.isi.length) return;
      totalMpBaru += l.isi.length;
      var r = barisPer['p:' + su];
      if (!r) {
        var m = D.master[su];
        if (!m) return;
        r = { id: 'p:' + su, jenis: 'produk', sku: m.sku, sumber: 'Marketplace', kategori: m.kategori, namaLama: m.nama, namaBaru: m.nama, modalLama: Math.round(m.modal), modalBaru: Math.round(m.modal),
          supBaru: [], supKonflik: [], status: 'ubah', ubahNama: false, ubahModal: false, arsip: !!m.arsip, catatan: 'Tidak ada di Excel internal - hanya SKU marketplace yang didaftarkan' };
        baris.push(r); barisPer[r.id] = r;
      }
      r.mpBaru = l.isi;
      if (r.status === 'sama' || r.status === 'konflik') r.status = 'ubah';
    });
    statistik.mpBaru = totalMpBaru;

    // 4) Kandidat berdasarkan kemiripan nama (AI bisa dipakai setelahnya lewat smap_ai_cocok)
    var semuaNama = D.daftarNama.slice();
    Object.keys(dikenal).forEach(function (u) { if (!D.master[u] && dikenal[u].nama) semuaNama.push({ sku: dikenal[u].sku, nama: smapTeks_(dikenal[u].nama), tok: smapToken_(dikenal[u].nama), baru: true }); });
    perluCari.forEach(function (r) {
      var tok = smapToken_(r.namaMp);
      var skor = semuaNama.map(function (c) { return { sku: c.sku, nama: c.nama, skor: Math.round(smapMirip_(tok, c.tok) * 100), baru: !!c.baru }; })
        .filter(function (c) { return c.skor >= 15; }).sort(function (a, b) { return b.skor - a.skor; }).slice(0, 5);
      r.kandidat = skor;
      if (skor[0] && skor[0].skor >= 55 && (!skor[1] || skor[0].skor - skor[1].skor >= 15)) { r.sku = skor[0].sku; r.yakin = skor[0].skor; r.status = 'tebak'; }
    });

    result.success = true;
    result.baris = baris;
    result.statistik = statistik;
    result.jumlahMaster = Object.keys(D.master).length;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}

// ===== AKSI: smap_ai_cocok { item:[{id, nama, kode, kandidat:[{sku,nama}]}] } - AI memilih SKU Gudang yang paling cocok =====
function prosesSmapAiCocok(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var item = (Array.isArray(data.item) ? data.item : []).slice(0, 30);
    if (!item.length) throw new Error('Tidak ada baris untuk dicocokkan');
    var prompt = 'Kamu membantu toko perlengkapan kopi Waterground mencocokkan PRODUK MARKETPLACE dengan PRODUK GUDANG.\n' +
      'Untuk setiap item, pilih SATU SKU Gudang dari daftar kandidat yang barangnya SAMA PERSIS (merek, model, ukuran/volume, warna, varian harus cocok). ' +
      'Kalau tidak ada yang benar-benar sama, isi sku dengan "" (kosong). Jangan menebak di luar daftar kandidat.\n' +
      'Balas HANYA JSON: {"hasil":[{"id":"<id>","sku":"<SKU Gudang atau kosong>","yakin":<0-100>,"alasan":"<maks 12 kata>"}]}\n\n' +
      item.map(function (it) {
        return 'ID: ' + it.id + '\nProduk marketplace: ' + String(it.nama || '').slice(0, 160) + ' (SKU Penjual: ' + it.kode + ')\nKandidat:\n' +
          (it.kandidat || []).slice(0, 8).map(function (k) { return '- ' + k.sku + ' = ' + String(k.nama || '').slice(0, 120); }).join('\n');
      }).join('\n\n');
    var izinkan = {};
    item.forEach(function (it) { izinkan[it.id] = {}; (it.kandidat || []).forEach(function (k) { izinkan[it.id][String(k.sku).toUpperCase()] = k.sku; }); });
    var valid = function (x) { return (x && Array.isArray(x.hasil)) ? '' : 'Balasan AI tidak berisi daftar hasil'; };
    var h = aiTeksBertingkat_('Cocokkan SKU', prompt, valid);
    result.hasil = h.parsed.hasil.map(function (x) {
      var id = String(x.id || ''), sk = String(x.sku || '').trim().toUpperCase();
      var asli = izinkan[id] && izinkan[id][sk] ? izinkan[id][sk] : '';
      return { id: id, sku: asli, yakin: asli ? Math.max(0, Math.min(100, parseInt(x.yakin, 10) || 0)) : 0, alasan: String(x.alasan || '').slice(0, 120) };
    }).filter(function (x) { return izinkan[x.id]; });
    result.model = h.model;
    result.success = true;
  } catch (err) { result.error = String(err && err.message || err); }
  return result;
}

// ===== AKSI: smap_ai_kolom { sheet, baris:[[...]] } - AI mengenali baris judul & kolom sheet yang formatnya tidak dikenali =====
