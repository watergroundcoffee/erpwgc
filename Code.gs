/* ============================================================
   EDIT & HAPUS PO YANG SUDAH DIKONFIRMASI - buat koreksi kalau ada salah input,
   atau batalkan PO (otomatis balikin Request Stock terkait jadi pending lagi).
   ============================================================ */
function prosesLihatDetailPOUntukEdit(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'adminPembelian')) throw new Error('Anda tidak punya izin Admin Pembelian.');
    var noPO = String(data.noPO || '').trim();
    if (!noPO) throw new Error('No PO kosong');

    var sheets = getPurchaseOrderSheets();
    var lastRowHeader = sheets.header.getLastRow();
    var namaSupplier = '', statusPO = '';
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 4).getValues();
      for (var h = 0; h < valsHeader.length; h++) {
        if (String(valsHeader[h][0]).trim() === noPO) { namaSupplier = valsHeader[h][2]; statusPO = valsHeader[h][3]; break; }
      }
    }
    if (!namaSupplier && !statusPO) throw new Error('PO nggak ketemu');

    var lastRowDetail = sheets.detail.getLastRow();
    var items = [];
    if (lastRowDetail > 1) {
      var valsDetail = sheets.detail.getRange(2, 1, lastRowDetail - 1, 5).getValues();
      valsDetail.forEach(function (row, idx) {
        if (String(row[0]).trim() !== noPO) return;
        items.push({ row: idx + 2, sku: row[1], nama: row[2], qty: row[3] });
      });
    }

    result.success = true;
    result.namaSupplier = namaSupplier;
    result.status = statusPO;
    result.items = items;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesSimpanEditPO(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'adminPembelian')) throw new Error('Anda tidak punya izin Admin Pembelian.');
    var noPO = String(data.noPO || '').trim();
    var namaSupplier = String(data.namaSupplier || '').trim();
    var items = data.items || []; // [{row, qty}] - cuma qty yang boleh diubah per item yang UDAH ada
    if (!noPO) throw new Error('No PO kosong');
    if (!namaSupplier) throw new Error('Nama supplier kosong');

    var sheets = getPurchaseOrderSheets();
    var lastRowHeader = sheets.header.getLastRow();
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 1).getValues();
      for (var h = 0; h < valsHeader.length; h++) {
        if (String(valsHeader[h][0]).trim() === noPO) { sheets.header.getRange(h + 2, 3).setValue(namaSupplier); break; }
      }
