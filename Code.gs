/* ---------- DN-664: rekap Beranda satu jalur ---------- */
var p90RekapAsli_ = rekapBerandaPerbarui_;
rekapBerandaPerbarui_ = function (hariMundur) {
  var cache = CacheService.getScriptCache(), props = PropertiesService.getScriptProperties();
  var kecil = hariMundur && hariMundur <= 3;
  var selesai = Number(cache.get(P90_REKAP_SELESAI_) || 0);
  // 1) Rekap baru saja selesai (< 60 dtk) -> datanya sudah segar, tidak dihitung ulang
  if (kecil && selesai && Date.now() - selesai < 60000) {
    return { success: true, dilewati: 'baru diperbarui', durasiMs: 0, diperbarui: selesai };
  }
  // 2) Rekap lain sedang berjalan -> tunggu hasilnya (maks 40 dtk), lalu menumpang
  var jalan = Number(cache.get(P90_REKAP_JALAN_) || 0);
  if (jalan && Date.now() - jalan < 240000) {
    var mulaiTunggu = Date.now();
