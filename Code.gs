// Kantor approve -> BARU stock berkurang, dicatat sebagai penyesuaian (adjustment).
function prosesApproveMemoHilangRusak(data) {
  return withTransaction(data.email, 'mintaStock', 'stok', function () {
    var result = { success: false };
    var noMemo = String(data.noMemo || '').trim();
    var sheets = getMemoHilangRusakSheets();

    var lastRowHeader = sheets.header.getLastRow();
    var rowTarget = -1, statusSaatIni = '';
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 3).getValues();
      for (var i = 0; i < valsHeader.length; i++) {
        if (String(valsHeader[i][0]).trim() === noMemo) { rowTarget = i + 2; statusSaatIni = valsHeader[i][2]; break; }
      }
    }
    if (rowTarget === -1) throw new Error('Memo tidak ditemukan.');
    if (statusSaatIni === 'Disetujui') throw new Error('Memo ini udah disetujui sebelumnya.');

    var namaStaff = data._namaSistem || getNamaStaff(data.email);
    var sekarang = new Date();
    // Memo dari HP (langsung tanpa persetujuan): stok dikurangi pada WAKTU MEMO dibuat, bukan waktu server menerima
    var waktuLedgerHR = sekarang;
    if (data._langsung) { var wm = sheets.header.getRange(rowTarget, 2).getValue(); if (wm instanceof Date) waktuLedgerHR = wm; }
    var lastRowDetail = sheets.detail.getLastRow();
    var shLedger = getStockLedgerSheet();
    var barisLedger = [];
    if (lastRowDetail > 1) {
      sheets.detail.getRange(2, 1, lastRowDetail - 1, 3).getValues().forEach(function (row) {
        if (String(row[0]).trim() !== noMemo) return;
        barisLedger.push([waktuLedgerHR, row[1], 'Keluar', row[2], 'Penyesuaian - Lapor Hilang/Rusak ' + noMemo + (data._langsung ? ' (langsung dari HP)' : ''), namaStaff, 0, 0]);
      });
    }
    if (barisLedger.length > 0) {
      shLedger.getRange(shLedger.getLastRow() + 1, 1, barisLedger.length, 8).setValues(barisLedger);
    }

    sheets.header.getRange(rowTarget, 3, 1, 3).setValues([['Disetujui', namaStaff, sekarang]]);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

function getStockLedgerSheet(toko) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var namaSheet = namaSheetToko('Stock Ledger', toko);
  var sh = ss.getSheetByName(namaSheet);
  if (!sh) {
    sh = ss.insertSheet(namaSheet);
    sh.getRange(1, 1, 1, 8).setValues([['Tanggal', 'SKU', 'Jenis', 'Qty', 'Keterangan', 'Dicatat Oleh', 'Toko', 'Harga Modal Satuan']]);
    sh.getRange(1, 1, 1, 8).setFontWeight('bold');
  } else if (sh.getLastColumn() < 7) {
    sh.getRange(1, 7).setValue('Toko').setFontWeight('bold');
  } else if (sh.getLastColumn() < 8) {
    sh.getRange(1, 8).setValue('Harga Modal Satuan').setFontWeight('bold');
  }
  return sh;
}

function prosesCatatLedger(data, jenis) {
  var result = { success: false };
  var lock = kunciModul_('stok');
  try {
    lock.waitLock(15000);
  } catch (lockErr) {
    result.error = 'Sistem sedang sibuk, coba lagi.';
    return result;
  }

  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = resolveSkuJual(data.sku); // kalau ini SKU Supplier yang udah dipetakan, pakai SKU Jual-nya
    var qty = parseFloat(data.qty);
    var keterangan = String(data.keterangan || '').trim();
    var namaProduk = String(data.namaProduk || '').trim();
    var hargaModalSatuan = parseFloat(data.hargaModalSatuan) || 0;
    if (!sku) throw new Error('SKU kosong');
    if (isNaN(qty) || qty < 0) throw new Error('Qty tidak valid');
    var namaStaff = getNamaStaff(data.email);

    // Kalau nama produk dikirim (baru diketik/diedit user), simpan/update juga ke Master Produk
    if (namaProduk) {
      upsertNamaMasterProduk(sku, namaProduk, data.toko);
    }

    var sh = getStockLedgerSheet(data.toko);
    var newRow = sh.getLastRow() + 1;
    sh.getRange(newRow, 2).setNumberFormat('@'); // SKU tetap teks
    sh.getRange(newRow, 1, 1, 8).setValues([[new Date(), sku, jenis, qty, keterangan, namaStaff, data.toko || 'Waterground', hargaModalSatuan]]);

    result.success = true;
    result.stockSaatIni = hitungStockSatuSku(sku, data.toko);

    // Auto-trigger: push virtual stock (fisik + buffer) ke TikTok Shop kalau fitur ini aktif
    try {
      var propsVS = PropertiesService.getScriptProperties();
      if (propsVS.getProperty('VIRTUAL_STOCK_AKTIF_TIKTOK') === 'true') {
        prosesUpdateVirtualStockSatuSku(sku, result.stockSaatIni);
      }
    } catch (eVS) { /* jangan sampai gagal update TikTok bikin catat stock gagal juga */ }
  } catch (err) {
    result.error = err.toString();
  } finally {
    lepasKunci_(lock);
  }
  return result;
}

// Update nama produk di Master Produk (kalau SKU sudah ada), atau bikin baris baru
// (kalau SKU belum terdaftar sama sekali) - harga dibiarkan 0, bisa diisi manual nanti
function upsertNamaMasterProduk(sku, namaBaru, toko) {
  var sh = getMasterProdukSheet(toko);
  var lastRow = sh.getLastRow();
  if (lastRow > 1) {
    var skuVals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    for (var i = 0; i < skuVals.length; i++) {
      if (String(skuVals[i][0]).trim() === sku) {
        sh.getRange(i + 2, 2).setValue(namaBaru);
        return;
      }
    }
  }
  // SKU belum ada -> tambah baris baru
  var newRow = sh.getLastRow() + 1;
  sh.getRange(newRow, 1).setNumberFormat('@');
  sh.getRange(newRow, 1, 1, 3).setValues([[sku, namaBaru, 0]]);
}

function prosesCatatOpname(data) {
  return prosesCatatLedger(data, 'Opname');
}

function prosesCatatStockMasuk(data) {
  return prosesCatatLedger(data, 'Masuk');
}

function prosesCatatRusakHilang(data) {
