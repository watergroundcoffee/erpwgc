// Nambah JENIS biaya baru (bukan cuma edit nilai yang udah ada) - bisa buat channel manapun,
// jenis tarif bebas pilih Persen (dari harga jual) atau Rupiah (nominal tetap per pesanan).
function prosesTambahBiayaPenjualan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
