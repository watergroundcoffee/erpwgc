function getSkuSupplierTerhubungSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('SKU Supplier Terhubung');
  if (!sh) {
    sh = ss.insertSheet('SKU Supplier Terhubung');
    sh.getRange(1, 1, 1, 5).setValues([['SKU Jual', 'SKU Supplier', 'Nama Supplier', 'Harga', 'Keterangan']]);
    sh.getRange(1, 1, 1, 5).setFontWeight('bold');
  } else if (sh.getLastColumn() < 5) {
    // Migrasi dari struktur lama (3 kolom: SKU Jual, SKU Supplier, Keterangan) ke 5 kolom -
    // sisipkan Nama Supplier & Harga SEBELUM kolom Keterangan, biar data Keterangan lama nggak hilang.
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var dataLama = sh.getRange(2, 1, lastRow - 1, 3).getValues(); // SKU Jual, SKU Supplier, Keterangan(lama)
      var dataBaru = dataLama.map(function (r) { return [r[0], r[1], '', '', r[2]]; });
      sh.getRange(2, 1, dataBaru.length, 5).setValues(dataBaru);
    }
    sh.getRange(1, 1, 1, 5).setValues([['SKU Jual', 'SKU Supplier', 'Nama Supplier', 'Harga', 'Keterangan']]);
    sh.getRange(1, 1, 1, 5).setFontWeight('bold');
  }
  // Kolom 6: URL Supplier per SKU Supplier. Kolom 4 (Harga) = Harga Modal per SKU Supplier.
  // Urutan baris per SKU Jual = hierarki: baris PERTAMA = SKU Utama (acuan Harga Modal Katalog > Harga).
  if (sh.getMaxColumns() < 6) sh.insertColumnsAfter(sh.getMaxColumns(), 6 - sh.getMaxColumns());
  if (sh.getLastColumn() < 6) sh.getRange(1, 6).setValue('URL Supplier').setFontWeight('bold');
  return sh;
}

// HPP diubah dari jalur lain (HPP manual / ambil dari halaman supplier) -> Harga Modal SKU Utama ikut diperbarui,
// supaya acuan Katalog > Harga (SKU Utama) tidak bertentangan dengan Master Produk.
function sinkronHargaSkuUtama_(skuJual, harga) {
  try {
    var kunci = String(skuJual || '').trim(), h = parseFloat(harga);
    if (!kunci || !(h >= 0)) return false;
    var sh = getSkuSupplierTerhubungSheet(), lr = sh.getLastRow();
    if (lr < 2) return false;
    var kolA = sh.getRange(2, 1, lr - 1, 2).getValues();
    for (var i = 0; i < kolA.length; i++) {
      if (String(kolA[i][0]).trim() === kunci && String(kolA[i][1] || '').trim()) { sh.getRange(i + 2, 4).setValue(h); return true; }
    }
  } catch (e) { }
  return false;
}

// Peta SKU Jual -> SKU Utama (baris pertama di sheet SKU Supplier Terhubung): { sku, harga, url }
function petaSkuUtamaSupplier_() {
  var peta = {};
  var sh = getSkuSupplierTerhubungSheet();
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return peta;
  sh.getRange(2, 1, lastRow - 1, 6).getValues().forEach(function (r) {
    var skuJual = String(r[0] || '').trim();
    if (!skuJual || peta[skuJual] || !String(r[1] || '').trim()) return;
    peta[skuJual] = { sku: String(r[1]).trim(), harga: parseFloat(r[3]) || 0, url: String(r[5] || '').trim() };
  });
  return peta;
}

// Kalau skuInput adalah SKU Supplier yang udah dipetakan, balikin SKU Jual-nya.
// Kalau bukan (atau nggak ketemu), anggap skuInput itu SENDIRI udah SKU Jual.
function resolveSkuJual(skuInput) {
  var skuBersih = String(skuInput || '').trim();
  if (!skuBersih) return skuBersih;
  var sh = getSkuSupplierTerhubungSheet();
  var lastRow = sh.getLastRow();
  if (lastRow > 1) {
    var vals = sh.getRange(2, 1, lastRow - 1, 2).getValues();
    for (var i = 0; i < vals.length; i++) {
      // 1 sel bisa berisi BEBERAPA SKU Supplier dipisah spasi/koma (misal kalau diketik
      // langsung di Google Sheets) - dipecah dulu, dicek satu-satu.
      var kodeKodeDalamSel = String(vals[i][1]).split(/[\s,]+/).map(function (s) { return s.trim(); }).filter(function (s) { return s; });
      if (kodeKodeDalamSel.indexOf(skuBersih) !== -1) return String(vals[i][0]).trim();
    }
  }
  return skuBersih;
}

