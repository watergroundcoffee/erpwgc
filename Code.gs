// Ubah file logo di Drive jadi data URI (dicache 6 jam; logo > 70 KB dilewati supaya respons tetap ringan)
function logoDataUri_(fileId) {
  if (!fileId) return '';
  var cache = CacheService.getScriptCache(), kunci = 'LOGO_DATAURI_' + fileId;
  try { var c = cache.get(kunci); if (c) return c === '-' ? '' : c; } catch (e) { }
  var hasil = '';
  try {
    var file = DriveApp.getFileById(fileId);
    var blob = file.getBlob();
    var bytes = blob.getBytes();
    if (bytes.length <= 70 * 1024) hasil = 'data:' + (blob.getContentType() || 'image/png') + ';base64,' + Utilities.base64Encode(bytes);
    else {
      // FIX LOGO CETAK HILANG: logo > 70 KB dulu dikembalikan KOSONG -> dokumen memakai URL Drive (kena CORS
      // saat Copy/Simpan gambar & sering belum termuat saat Print). Sekarang dipakai thumbnail Drive (kecil, tajam).
      var thumb = file.getThumbnail();
      if (thumb && thumb.getBytes().length <= 70 * 1024) hasil = 'data:' + (thumb.getContentType() || 'image/png') + ';base64,' + Utilities.base64Encode(thumb.getBytes());
    }
  } catch (e) { hasil = ''; }
  try { cache.put(kunci, hasil || '-', hasil ? 21600 : 600); } catch (e) { }
  return hasil;
}
// Cadangan: logo hanya punya URL (tanpa file Drive) -> server mengambilnya (UrlFetchApp tidak kena CORS)
function logoDataUriDariUrl_(url) {
  url = String(url || '').trim();
  if (!/^https:\/\//i.test(url)) return '';
  var cache = CacheService.getScriptCache(), kunci = 'LOGO_URL_DATAURI_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, url));
  try { var c = cache.get(kunci); if (c) return c === '-' ? '' : c; } catch (e) { }
  var hasil = '';
  try {
    var res = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });
    var blob = res.getBlob(), b = blob.getBytes(), tipe = String(blob.getContentType() || '');
    if (res.getResponseCode() === 200 && /^image\//.test(tipe) && b.length <= 70 * 1024) hasil = 'data:' + tipe + ';base64,' + Utilities.base64Encode(b);
  } catch (e) { hasil = ''; }
  try { cache.put(kunci, hasil || '-', hasil ? 21600 : 600); } catch (e) { }
  return hasil;
}

function prosesLihatLogo(data) {
  var result = { success: false };
