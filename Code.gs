/* ============================================================
   CARI SEMUA JENIS SKU v2026.10.20
   Satu mesin pencari untuk Katalog > Harga, Penjualan > Pesanan & Finance > Produk Terjual:
   kode apa pun (SKU Produk Master, SKU Supplier, SKU Shopee/TikTok/Tokopedia, kode lama yang tercatat di
   rincian pesanan) -> SKU Produk Master yang dimaksud. Cocok persis didahulukan, lalu yang mengandung kata kunci.
   Normalisasi: huruf besar, buang spasi / - / _ / . / slash / petik di depan.
   ============================================================ */
var CSK_SHEET_DETAIL_ = [
  { sheet: 'Pesanan Shopee Detail', kanal: 'Shopee' },
  { sheet: 'Pesanan TikTok Shop Detail', kanal: 'TikTok Shop' },
  { sheet: 'Pesanan Conner Detail', kanal: 'Conner' },
  { sheet: 'Pesanan Manual Detail', kanal: 'PO Sales' }
];
function cskNorm_(t) {
  return String(t === null || t === undefined ? '' : t).replace(/[\u200B-\u200D\u2060\uFEFF\u00AD]/g, '').replace(/^'+/, '')
    .toUpperCase().replace(/[\s\-_.\/]+/g, '');
}
// Baris rincian pesanan semua channel (dibaca sekali per request): [{ id, sku, qty, kanal }]
function cskBarisDetail_() {
