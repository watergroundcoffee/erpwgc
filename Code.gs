// Data "Selesai/Batal" JARANG BERUBAH lagi (udah kelar) - cache jauh lebih lama (10 menit)
// dibanding data aktif, biar tab ini nggak perlu minta data ulang tiap kali dibuka.
function prosesLihatArsipPesananSelesai(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var cache = CacheService.getScriptCache();
    var cacheKey = 'ARSIP_PESANAN_SELESAI_V1';
