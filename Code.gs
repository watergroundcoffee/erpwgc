function getIzinIndividualStaff(row) {
  var sh = getStaffSheet();
  var izin = {};
  if (!sh.getRange(1, 7).getValue()) {
    // Kolom wewenang belum pernah dibuat - artinya staff lama, kasih semua false dulu
    DAFTAR_IZIN.forEach(function (key) { izin[key] = false; });
    return izin;
  }
  var vals = sh.getRange(row, 7, 1, DAFTAR_IZIN.length).getValues()[0];
  DAFTAR_IZIN.forEach(function (key, idx) { izin[key] = vals[idx] === true; });
