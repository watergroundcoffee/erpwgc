// Lihat semua entri Stock Ledger jenis "Masuk" - bisa difilter tanggal spesifik
function prosesLihatStockMasukTanggal(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tanggalFilter = String(data.tanggal || '').trim(); // format YYYY-MM-DD, kosong = semua tanggal

    var sh = getStockLedgerSheet(data.toko);
    var lastRow = sh.getLastRow();
    var daftar = [];

    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 6).getValues();
      var shMaster = getMasterProdukSheet(data.toko);
      var namaMap = {};
      var lastRowMaster = shMaster.getLastRow();
      if (lastRowMaster > 1) {
        var masterVals = shMaster.getRange(2, 1, lastRowMaster - 1, 2).getValues();
        for (var m = 0; m < masterVals.length; m++) {
          namaMap[String(masterVals[m][0]).trim()] = String(masterVals[m][1] || '').trim();
        }
      }

      var tz = Session.getScriptTimeZone();
      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][2]).trim() !== 'Masuk') continue;
        var tglBaris = vals[i][0];
        if (!(tglBaris instanceof Date)) continue;
        var tglBarisStr = Utilities.formatDate(tglBaris, tz, 'yyyy-MM-dd');
        if (tanggalFilter && tglBarisStr !== tanggalFilter) continue;

        var sku = String(vals[i][1] || '').trim();
        daftar.push({
          tanggal: Utilities.formatDate(tglBaris, tz, 'dd MMM yyyy, HH:mm'),
          tanggalRaw: tglBarisStr,
          sku: sku,
          nama: namaMap[sku] || '(tidak ditemukan)',
          qty: vals[i][3],
          keterangan: vals[i][4],
          dicatatOleh: vals[i][5]
        });
      }
    }

    daftar.reverse();
    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

// Rekonsiliasi dari arah SEBALIKNYA: tiap Stock Masuk dicek, apa ada Invoice
// Supplier yang nyocokin (SKU + qty + tanggal berdekatan)? Kalau nggak ada ->
// kemungkinan ada stock masuk yang belum/lupa diinvoice-kan.
function prosesRekonsiliasiMutasiStock(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tanggalFilter = String(data.tanggal || '').trim();

    var shLedger = getStockLedgerSheet(data.toko);
    var lastRowLedger = shLedger.getLastRow();
    if (lastRowLedger < 2) { result.success = true; result.daftar = []; return result; }

    var shMaster = getMasterProdukSheet(data.toko);
    var namaMap = {};
    var lastRowMaster = shMaster.getLastRow();
    if (lastRowMaster > 1) {
      var masterVals = shMaster.getRange(2, 1, lastRowMaster - 1, 2).getValues();
      for (var m = 0; m < masterVals.length; m++) {
        namaMap[String(masterVals[m][0]).trim()] = String(masterVals[m][1] || '').trim();
      }
    }

    // Muat semua item Invoice Supplier + tanggal headernya sekali aja (biar cepat)
    var sheetsInv = getInvoiceSupplierSheets();
    var headerVals = [];
    var lastRowHeader = sheetsInv.header.getLastRow();
    if (lastRowHeader > 1) {
      headerVals = sheetsInv.header.getRange(2, 1, lastRowHeader - 1, 2).getValues(); // [No Invoice, Tanggal]
    }
    var tanggalInvoiceMap = {};
    headerVals.forEach(function (h) {
      tanggalInvoiceMap[String(h[0]).trim()] = h[1];
    });

    var detailVals = [];
    var lastRowDetail = sheetsInv.detail.getLastRow();
    if (lastRowDetail > 1) {
      detailVals = sheetsInv.detail.getRange(2, 1, lastRowDetail - 1, 4).getValues(); // [No Invoice, SKU, Nama, Qty]
    }
    var itemInvoice = detailVals.map(function (d) {
      return { noInvoice: String(d[0]).trim(), sku: String(d[1]).trim(), qty: parseFloat(d[3]) || 0, tanggal: tanggalInvoiceMap[String(d[0]).trim()] };
    });

    var vals = shLedger.getRange(2, 1, lastRowLedger - 1, 4).getValues();
    var tz = Session.getScriptTimeZone();
    var msPerHari = 24 * 60 * 60 * 1000;
    var daftar = [];

    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][2]).trim() !== 'Masuk') continue;
      var tglBaris = vals[i][0];
      if (!(tglBaris instanceof Date)) continue;
      var tglBarisStr = Utilities.formatDate(tglBaris, tz, 'yyyy-MM-dd');
      if (tanggalFilter && tglBarisStr !== tanggalFilter) continue;

      var sku = String(vals[i][1] || '').trim();
      var qty = parseFloat(vals[i][3]) || 0;

      // Cari invoice yang cocok
      var cocok = false;
      for (var j = 0; j < itemInvoice.length; j++) {
        var it = itemInvoice[j];
        if (it.sku !== sku) continue;
        if (!(it.tanggal instanceof Date)) continue;
        var selisihHari = Math.abs((it.tanggal - tglBaris) / msPerHari);
        if (selisihHari <= 5 && Math.abs(it.qty - qty) < 0.01) { cocok = true; break; }
      }

      daftar.push({
        tanggal: Utilities.formatDate(tglBaris, tz, 'dd MMM yyyy, HH:mm'),
        sku: sku,
        nama: namaMap[sku] || '(tidak ditemukan)',
        qty: qty,
        status: cocok ? 'Ada Invoice' : 'Belum Ada Invoice'
      });
    }

    daftar.reverse();
    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

