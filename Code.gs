        laporan.push({ sn: id + ' · ' + cfg.label, status: o ? o.status : '', buyerId: o ? String(o.user_id || '') : '', username: '', sumber: sumber, akhir: akhirTampil });
        if (akhir.nama || akhir.hp || akhir.alamat) (simpan[toko] = simpan[toko] || []).push(ttbHasilDariAkhir_(cfg, id, akhir, { status: o ? o.status : '', paket: paket }));
      });
