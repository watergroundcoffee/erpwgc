/* ---------- PAKET 13 (v2026.10.26) - LUNAS + DIKIRIM = SELESAI (DN-261019-115301-703, DN-261019-115116-537) ----------
   - Pesanan Manual yang sudah Dikirim (No Resi / Kurir Toko) DAN sudah ditandai Lunas -> status "Selesai" + Tanggal Jadi Selesai.
   - Lunas tapi belum dikirim -> status tetap (harus dikirim dulu supaya stok keluar), tapi tidak bisa dibatalkan.
   - p13SapuLunasSelesai_ membereskan pesanan lama (paling sering 1x / 30 menit, dipicu saat daftar pesanan dibuka). */
function p13SudahLunas_(noInvoice) {
  if (!noInvoice) return false;
  try { var k = pkPeta_()[noInvoice]; return !!(k && k.bayar); } catch (e) { return false; }
}
function p13SelesaiBilaLunas_(sh, row, noInvoice) {
  if (!row || !p13SudahLunas_(noInvoice)) return false;
  var st = String(sh.getRange(row, 12).getValue() || '').trim();
  if (st !== 'Dikirim') return st === 'Selesai';
  sh.getRange(row, 12).setValue('Selesai');
  sh.getRange(row, 19).setValue(new Date());
  try { finInvalidasi_(); } catch (eF) { }
  return true;
}
function p13SapuLunasSelesai_(paksa) {
  var cache = CacheService.getScriptCache();
  if (!paksa && cache.get('P13_SAPU_LUNAS')) return 0;
  cache.put('P13_SAPU_LUNAS', '1', 1800);
  var pk = pkPeta_();
  var lock = kunciModul_('penjualan');
  try { lock.waitLock(5000); } catch (e) { return 0; }
  var n = 0;
  try {
    var sh = getPesananManualSheets().header, lr = sh.getLastRow();
    if (lr < 2) return 0;
    var vals = sh.getRange(2, 1, lr - 1, 12).getValues(), sekarang = new Date();
    vals.forEach(function (r, i) {
      var no = String(r[0] || '').trim();
      if (!no || String(r[11] || '').trim() !== 'Dikirim') return;
      // v2026.10.48 (DN-264): pesanan SEBELUM tanggal mulai wajib dokumen dianggap lengkap -> Selesai pada tanggal pesanannya
      var lama = r[1] instanceof Date && r[1].getTime() < PM_DOK_MULAI_MS_;
      if (!lama && !(pk[no] && pk[no].bayar)) return;
      sh.getRange(i + 2, 12).setValue('Selesai');
      sh.getRange(i + 2, 19).setValue(lama && !(pk[no] && pk[no].bayar) ? r[1] : sekarang);
      n++;
    });
    if (n) { SpreadsheetApp.flush(); pmInvalidasiCache_(); try { invalidasiCacheGabunganPesanan(); } catch (eG) { } try { finInvalidasi_(); } catch (eF) { } }
  } finally { lepasKunci_(lock); }
  return n;
}
// DN-261019-152320-160: nama pembeli marketplace yang disensor (****) -> tampilkan username
function p13NamaPembeli_(namaManual, namaTersamar, username, cadangan) {
  var m = String(namaManual || '').trim();
  if (m) return m;
  var t = String(namaTersamar || '').trim(), u = String(username || '').trim();
  if (u && !/\*{2,}/.test(u) && (!t || t === '-' || /\*{2,}/.test(t))) return u;
  return t || u || cadangan || '-';
}

// Salah klik -> Owner bisa membatalkan konfirmasi (baris tidak dihapus, ditandai Dibatalkan - jejak audit tetap ada)
function prosesBatalKonfirmasiPembayaran(data) {
  return withTransaction(data.email, 'buatInvoice', 'penjualan', function () {
    if (!mgApakahOwner_(data.email)) throw new Error('Hanya Owner yang bisa membatalkan konfirmasi pembayaran.');
    var no = String(data.noInvoice || '').trim(), sh = pkSheet_(), lr = sh.getLastRow(), n = 0;
    if (lr > 1) sh.getRange(2, 1, lr - 1, 8).getValues().forEach(function (r, i) {
      if (String(r[0]).trim() === no && r[1] === 'Pembayaran' && String(r[7] || 'Aktif') === 'Aktif') { sh.getRange(i + 2, 8).setValue('Dibatalkan oleh ' + (getNamaStaff(data.email) || '') + ' ' + pkFmt_(new Date())); n++; }
    });
    pkInvalidasi_();
    if (n) { try { ksBatalkan_(no, getNamaStaff(data.email) || ''); } catch (eKs) { } }
    // v2026.10.26: tanda lunas dibatalkan -> pesanan yang jadi "Selesai" karena lunas kembali ke "Dikirim"
    var statusBaru = '';
    if (n) {
