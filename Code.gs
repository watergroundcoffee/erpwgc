        if (kolPf) ['Shopee', 'TikTok Shop', 'Tokopedia'].forEach(function (pf) {
          var k = kolPf[pf]; if (!k || k.dobel || k.nomor > r.length) return;
          String(r[k.nomor - 1] || '').split(/[,;\r\n\s]+/).forEach(function (kode) { tambahAlias(kode, s); });
        });
