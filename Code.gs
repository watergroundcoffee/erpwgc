// Fungsi INTI - baca log Resi Keluar mentah, cross-ref ke Resi Masuk (buat kolom Resi Retur),
// dan klasifikasi 4-kategori. Dipakai bareng oleh versi Aktif, Riwayat, maupun Semua.
function ambilSemuaLogResiKeluarMentah(email) {
  if (!cekIzin(email, 'scanResiKeluar')) throw new Error('Anda tidak punya izin untuk aksi ini.');
  var info = getSheetInfo('keluar');
  var sh = info.sheet;
  var lastRow = sh.getLastRow();
  var daftar = [];
  var tz = Session.getScriptTimeZone();

  var peta = bangunPetaResiKeSemuaPesanan(); // dibangun SEKALI, dipakai buat semua baris di bawah
  var bolehNilai = cekIzin(email, 'buatInvoice');
  var petaStatusRetur = p10PetaStatusRetur_();
  var syncShopeeSegar = kilatSyncShopeeSegar_();

  // Peta No Invoice -> No Resi dari log Resi MASUK (retur), buat kolom "Resi Retur"
  var infoRetur = getSheetInfo('retur');
  var petaReturPerInvoice = {};
  var lastRowRetur = infoRetur.sheet.getLastRow();
  if (lastRowRetur > 1) {
    infoRetur.sheet.getRange(2, 1, lastRowRetur - 1, 1).getValues().forEach(function (r) {
      var noResiRetur = String(r[0] || '').trim();
      if (!noResiRetur) return;
      var cocokRetur = peta[kunciResi_(noResiRetur)];
      if (cocokRetur) petaReturPerInvoice[cocokRetur.noInvoice] = noResiRetur;
    });
  }

  if (lastRow > 1) {
    var vals = sh.getRange(2, 1, lastRow - 1, 11).getValues();
    vals.forEach(function (row) {
      var noResiScan = String(row[0] || '').trim();
      if (!noResiScan) return;
      var tanggalObj = row[2] instanceof Date ? row[2] : null;
      var cocok = peta[kunciResi_(noResiScan)] || deteksiKilatOtomatis_(noResiScan, row[9], tanggalObj, syncShopeeSegar);
      var statusPesanan = normalisasiStatusPesanan(cocok ? cocok.status : '');
      daftar.push({
        noResiScan: noResiScan, tanggal: tanggalObj ? Utilities.formatDate(tanggalObj, tz, 'dd MMM yyyy, HH:mm:ss') : '-',
        kurir: p10KurirTampil_(row[9], cocok), kurirDariPesanan: p10KurirKosong_(row[9]) && !!(cocok && cocok.kurir), resiAsli: p10ResiAsli_(noResiScan, cocok), dicatatOleh: row[8],
        noInvoice: cocok ? cocok.noInvoice : null, pembeli: cocok ? cocok.pembeli : null,
        sumber: cocok ? cocok.sumber : null, jenis: cocok ? (cocok.jenis || 'pesanan') : null, statusTransfer: cocok && cocok.statusTransfer ? cocok.statusTransfer : null, kilatOtomatis: !!(cocok && cocok.kilatOtomatis), statusAkhirKilat: cocok && cocok.statusAkhir ? cocok.statusAkhir : null, kodeAkhirKilat: cocok && cocok.kodeAkhir ? cocok.kodeAkhir : null, umurHariKilat: cocok && cocok.umurHari !== undefined ? cocok.umurHari : null, hariLakuKilat: cocok && cocok.hariLaku !== undefined ? cocok.hariLaku : null, orderPembeliKilat: cocok && cocok.orderPembeli ? cocok.orderPembeli : null,
        statusPesanan: statusPesanan,
        kategoriPengiriman: klasifikasiStatusResi(statusPesanan, tanggalObj),
        resiRetur: (cocok && petaReturPerInvoice[cocok.noInvoice]) ? petaReturPerInvoice[cocok.noInvoice] : null,
        statusRetur: p10StatusRetur_(petaStatusRetur, cocok && petaReturPerInvoice[cocok.noInvoice]),
        ms: tanggalObj ? tanggalObj.getTime() : 0, nilai: (bolehNilai && cocok && cocok.nilai) ? cocok.nilai : null
      });
    });
  }
  daftar.reverse();
  return daftar;
}

// ===== Pengiriman v2: baca log Resi Keluar BERTAHAP dari bawah (baris terbaru) =====
// Dulu: seluruh sheet dibaca + diformat + dikirim (1.500+ baris) -> timeout ~28 detik.
// Sekarang: dibaca per potongan (chunk) dari baris paling bawah ke atas, berhenti begitu udah
// dapat `limit` resi yang lolos filter. Balikin `cursorBerikut` (nomor baris sheet) supaya
// frontend bisa minta "resi lebih lama" tanpa baca ulang dari awal.
var PGR_LIMIT_DEFAULT = 200;
var PGR_LIMIT_MAKS = 500;
var PGR_UKURAN_CHUNK = 500;
var PGR_BATAS_WAKTU_MS = 20000; // rem darurat, jauh di bawah batas timeout

function bangunPetaReturPerInvoice(peta) {
