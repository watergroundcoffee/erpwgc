      if (s2 > jalan - 1000) {
        if (kecil) return { success: true, menumpang: true, durasiMs: Date.now() - mulaiTunggu, diperbarui: s2 };
        break; // rekap besar (backdate / penuh) tetap dijalankan sendiri setelah yang lain selesai
      }
      if (!cache.get(P90_REKAP_JALAN_)) break;
    }
  }
  // 3) Jalankan sendiri
  var t0 = Date.now(), hasil;
  try { cache.put(P90_REKAP_JALAN_, String(t0), 300); } catch (e0) { }
  try { hasil = p90RekapAsli_(hariMundur); }
