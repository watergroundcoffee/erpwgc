/* ---------- TAB 3: SINKRONISASI STOK ---------- */
function cnSheetProduk_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CN_SHEET_PRODUK_);
  if (!sh) {
    sh = ss.insertSheet(CN_SHEET_PRODUK_);
