    out.cocokKolom = akl.ketemu[resi] ? [akl.ketemu[resi]] : (akl.ragu[resi] || []);
    out.mirip = akl.mirip[resi] || [];
    catat('Cari di semua kolom pesanan (' + akl.dibaca + ' baris)', out.cocokKolom.length ? out.cocokKolom.map(function (x) { return x.sumber + ' ' + x.no + ' (kolom ' + x.kolom + ')'; }).join('; ') : 'Kode persis ini tidak ada di kolom mana pun.', out.cocokKolom.length === 1 ? 'ok' : out.cocokKolom.length ? 'peringatan' : 'gagal');
