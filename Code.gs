// Hitung saldo SEMUA akun (bukan cuma Beban/Pendapatan) - "Masuk" nambah, "Keluar" ngurangin.
// Ini fungsi inti yang nanti JUGA dipakai buat Neraca & Arus Kas begitu kita
// otomatisin pencatatan Kas dari Pesanan Manual & Invoice Supplier.
function hitungSaldoSemuaAkun(tglMulai, tglAkhir) {
  var shAkun = getBaganAkunSheet();
  var lastRowAkun = shAkun.getLastRow();
  var infoAkun = {}; // { namaAkun: { kategori, saldo, mutasi: [] } }
  if (lastRowAkun > 1) {
    var valsAkun = shAkun.getRange(2, 1, lastRowAkun - 1, 2).getValues();
    valsAkun.forEach(function (row) {
      var nama = String(row[0] || '').trim();
      if (nama) infoAkun[nama] = { kategori: row[1], saldo: 0, mutasi: [] };
    });
  }

  var shJurnal = getJurnalTransaksiSheet();
  var lastRowJurnal = shJurnal.getLastRow();
  var tz = Session.getScriptTimeZone();
  if (lastRowJurnal > 1) {
    var valsJurnal = shJurnal.getRange(2, 1, lastRowJurnal - 1, 7).getValues();
    for (var i = 0; i < valsJurnal.length; i++) {
      var tgl = valsJurnal[i][0];
      if (!(tgl instanceof Date)) continue;
      if (tglMulai && tgl < tglMulai) continue;
      if (tglAkhir && tgl > tglAkhir) continue;

      var akun = String(valsJurnal[i][1] || '').trim();
      var jenis = String(valsJurnal[i][3] || '').trim();
      var jumlah = parseFloat(valsJurnal[i][4]) || 0;
      if (!infoAkun[akun]) infoAkun[akun] = { kategori: valsJurnal[i][2] || '-', saldo: 0, mutasi: [] };

      var perubahan = jenis === 'Masuk' ? jumlah : -jumlah;
      infoAkun[akun].saldo += perubahan;
      infoAkun[akun].mutasi.push({
        tanggal: Utilities.formatDate(tgl, tz, 'dd MMM yyyy'),
        jenis: jenis, jumlah: jumlah, keterangan: valsJurnal[i][5], sumber: valsJurnal[i][6],
        saldoBerjalan: infoAkun[akun].saldo
      });
    }
  }

  // Pendapatan & HPP otomatis dari Pesanan Manual/Invoice Supplier JUGA masuk itungan
  // (nggak lewat cekIzin karena ini dipanggil internal, bukan langsung dari user)
  var totalPendapatanOtomatis = 0, totalHppOtomatis = 0;
  var sheetsPesananLB = getPesananManualSheets();
  var shPesananLB = sheetsPesananLB.header;
  var lastRowPesananLB = shPesananLB.getLastRow();
  if (lastRowPesananLB > 1) {
    var valsPesananLB = shPesananLB.getRange(2, 1, lastRowPesananLB - 1, 12).getValues();
    for (var p = 0; p < valsPesananLB.length; p++) {
      if (!String(valsPesananLB[p][0] || '').trim()) continue;
      if (String(valsPesananLB[p][11] || '').trim() === 'Dibatalkan') continue;
      var tglP = valsPesananLB[p][1];
      if (!(tglP instanceof Date)) continue;
      if (tglMulai && tglP < tglMulai) continue;
      if (tglAkhir && tglP > tglAkhir) continue;
      totalPendapatanOtomatis += parseFloat(valsPesananLB[p][9]) || 0;
    }
  }
  var shInvoiceLB = getInvoiceSupplierSheets().header;
  var lastRowInvoiceLB = shInvoiceLB.getLastRow();
  if (lastRowInvoiceLB > 1) {
    var valsInvoiceLB = shInvoiceLB.getRange(2, 1, lastRowInvoiceLB - 1, 5).getValues();
    for (var v = 0; v < valsInvoiceLB.length; v++) {
      if (!String(valsInvoiceLB[v][0] || '').trim()) continue;
      var tglV = valsInvoiceLB[v][1];
      if (!(tglV instanceof Date)) continue;
      if (tglMulai && tglV < tglMulai) continue;
      if (tglAkhir && tglV > tglAkhir) continue;
      totalHppOtomatis += parseFloat(valsInvoiceLB[v][4]) || 0;
    }
  }
  if (infoAkun['Pendapatan Penjualan']) {
    infoAkun['Pendapatan Penjualan'].saldo += totalPendapatanOtomatis;
    if (totalPendapatanOtomatis > 0) {
      infoAkun['Pendapatan Penjualan'].mutasi.push({ tanggal: '-', jenis: 'Masuk', jumlah: totalPendapatanOtomatis, keterangan: 'Total otomatis dari Pesanan Manual', sumber: 'Otomatis', saldoBerjalan: infoAkun['Pendapatan Penjualan'].saldo });
    }
  }
  if (infoAkun['Harga Pokok Penjualan (HPP)']) {
    infoAkun['Harga Pokok Penjualan (HPP)'].saldo += totalHppOtomatis;
    if (totalHppOtomatis > 0) {
      infoAkun['Harga Pokok Penjualan (HPP)'].mutasi.push({ tanggal: '-', jenis: 'Masuk', jumlah: totalHppOtomatis, keterangan: 'Total otomatis dari Invoice Supplier', sumber: 'Otomatis', saldoBerjalan: infoAkun['Harga Pokok Penjualan (HPP)'].saldo });
    }
  }

  return infoAkun;
}

function prosesLihatBukuBesar(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var akunDipilih = String(data.akun || '').trim();
    if (!akunDipilih) throw new Error('Pilih akun dulu');

    var tglMulai = data.tanggalMulai ? new Date(data.tanggalMulai) : null;
    var tglAkhir = data.tanggalAkhir ? new Date(data.tanggalAkhir) : null;
    if (tglAkhir) tglAkhir.setHours(23, 59, 59, 999);

    var semuaAkun = hitungSaldoSemuaAkun(tglMulai, tglAkhir);
    var info = semuaAkun[akunDipilih] || { kategori: '-', saldo: 0, mutasi: [] };

    result.success = true;
    result.kategori = info.kategori;
    result.saldoAkhir = info.saldo;
    result.mutasi = info.mutasi;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesLihatNeracaSaldo(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tglMulai = data.tanggalMulai ? new Date(data.tanggalMulai) : null;
    var tglAkhir = data.tanggalAkhir ? new Date(data.tanggalAkhir) : null;
    if (tglAkhir) tglAkhir.setHours(23, 59, 59, 999);

    var semuaAkun = hitungSaldoSemuaAkun(tglMulai, tglAkhir);
    var daftar = [];
    var totalSemua = 0;
    Object.keys(semuaAkun).forEach(function (nama) {
      var info = semuaAkun[nama];
      daftar.push({ akun: nama, kategori: info.kategori, saldo: info.saldo });
      totalSemua += info.saldo;
    });

    var urutanKategori = ['Aset', 'Liabilitas', 'Ekuitas', 'Pendapatan', 'Beban'];
    daftar.sort(function (a, b) {
      var idxA = urutanKategori.indexOf(a.kategori), idxB = urutanKategori.indexOf(b.kategori);
      if (idxA !== idxB) return idxA - idxB;
      return a.akun.localeCompare(b.akun);
    });

    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   KELOLA ROLE & WEWENANG DEFAULT (beda dari edit staff perorangan)
   ============================================================ */
function prosesUpdateRoleWewenang(data) {
  return withTransaction(data.email, null, 'akses', function () {
    var result = { success: false };
    var staffPeminta = getStaffByEmail(data.email);
    if (!staffPeminta || staffPeminta.role !== 'Owner' || !staffPeminta.aktif) {
      throw new Error('Cuma Owner yang bisa ubah wewenang role.');
    }
    var role = String(data.role || '').trim();
    if (!role) throw new Error('Role kosong');

    var sh = getHakAksesSheet();
    var lastRow = sh.getLastRow();
    var barisIzin = DAFTAR_IZIN.map(function (key) { return data.izin && data.izin[key] === true; });
    var found = false;

    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][0]).trim() === role) {
          sh.getRange(i + 2, 2, 1, DAFTAR_IZIN.length).insertCheckboxes();
          sh.getRange(i + 2, 2, 1, DAFTAR_IZIN.length).setValues([barisIzin]);
          found = true;
          break;
        }
      }
    }
    if (!found) throw new Error('Role tidak ditemukan.');

    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

function prosesTambahRoleBaru(data) {
  return withTransaction(data.email, null, 'akses', function () {
    var result = { success: false };
    var staffPeminta = getStaffByEmail(data.email);
    if (!staffPeminta || staffPeminta.role !== 'Owner' || !staffPeminta.aktif) {
