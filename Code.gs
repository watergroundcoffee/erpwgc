function prosesLihatRiwayatMintaStock(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'adminPembelian')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var mapNamaProduk = buatMapNamaProdukBySku(data.toko);
    var sh = getStockRequestSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    var tz = Session.getScriptTimeZone();
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 10).getValues();
      vals.forEach(function (row) {
        var sku = String(row[0] || '').trim();
        if (!sku) return;
        var status = String(row[5] || '').trim();
        if (status === '') return; // cuma yang UDAH diproses
        daftar.push({
