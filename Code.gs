  }, { tungguMs: 15000 });
}

/* ####################################################################################
   ACTION CENTER "Perlu Perhatian" (Dashboard) - 1 request ringan, di-cache 5 menit
   ####################################################################################
*/
var AC_CACHE_ = 'ACTION_CENTER_V1';
var AC_AMBANG_STOK_MENIPIS = 5;   // On Available <= angka ini dianggap menipis (produk aktif yang pernah bergerak)
var AC_AMBANG_HR_BESAR = 10;      // memo Hilang/Rusak dengan total qty >= ini ditandai untuk ditinjau
function prosesLihatActionCenter(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var cache = CacheService.getScriptCache();
    if (!data.segarkan) { var c = cache.get(AC_CACHE_); if (c) { try { return JSON.parse(c); } catch (e0) { } } }
    var butir = [];
    function tambah(kunci, jumlah, label, tingkat, tujuan, contoh) { if (jumlah > 0) butir.push({ kunci: kunci, jumlah: jumlah, label: label, tingkat: tingkat, tujuan: tujuan, contoh: contoh || [] }); }

    // 1) Pesanan Manual: siap diproses (belum dikirim) & belum dibayar
    var pm = smBacaSheet('Pesanan Manual', 12), pk = pkPeta_(), siap = [], belumBayar = [];
    pm.forEach(function (r) {
      var no = String(r[0] || '').trim(), st = String(r[11] || '').trim();
      if (!no || st === 'Dibatalkan' || st === 'Selesai') return;
      if (st === '') siap.push(no);
      if (!(pk[no] && pk[no].bayar) && st !== 'Selesai') belumBayar.push(no);
    });
    // 2) Marketplace: order aktif belum discan keluar
    var mesin = smHitungMesinStok({});
    var mpSiap = 0;
    var scanMap = {};
    smBacaSheet('Resi Keluar', 11).forEach(function (r) { var k = kunciResi_(r[0]); if (k && String(r[10] || '').trim() !== 'Pending') scanMap[k] = 1; });
    var batasMacet = Date.now() - SM_HARI_RESERVE_MACET * 86400000;
    SM_SUMBER_MARKETPLACE.forEach(function (src) {
      smBacaSheet(src.header, 7).forEach(function (r) {
        var st = String(r[4] || '').trim().toUpperCase(), tgl = smMs(r[1]);
        if (!String(r[0] || '').trim() || SM_STATUS_MP_BATAL[st] || SM_STATUS_MP_SUDAH_KELUAR[st] || SM_STATUS_MP_BELUM_BAYAR[st]) return;
        if (tgl && tgl < batasMacet) return;
        var resi = kunciResi_(resiTeks_(r[6], r[5]));
        if (resi && scanMap[resi]) return;
        mpSiap++;
      });
    });
    tambah('pesanan_siap', siap.length + mpSiap, 'Pesanan siap diproses', 'utama', 'pesanan', siap.slice(0, 5));
    tambah('belum_bayar', belumBayar.length, 'Pesanan manual belum dikonfirmasi bayar', 'sedang', 'pesanan', belumBayar.slice(0, 5));

    // 3) Stok
    var menipis = [], minus = [], tanpaMaster = [], belumBayarStok = 0;
    mesin.daftar.forEach(function (p) {
      if (p.arsip) return;
      if (!p.terdaftar && p.adaAktivitas) tanpaMaster.push(p.sku);
      if (!p.terdaftar) return;
      if (p.onAvailable < 0) minus.push(p.sku);
      else if (p.adaAktivitas && p.onAvailable <= AC_AMBANG_STOK_MENIPIS && (p.onOrder || 0) === 0) menipis.push(p.sku);
      belumBayarStok += p.reserveBelumBayar || 0;
    });
    tambah('stok_minus', minus.length, 'Produk stok tersedia minus (risiko oversell)', 'utama', 'persediaan', minus.slice(0, 5));
    tambah('stok_menipis', menipis.length, 'Produk stok menipis (≤ ' + AC_AMBANG_STOK_MENIPIS + ', belum dipesan)', 'sedang', 'persediaan', menipis.slice(0, 5));
    tambah('sku_tanpa_master', tanpaMaster.length, 'SKU belum terdaftar di Produk Master', 'ringan', 'katalog', tanpaMaster.slice(0, 5));
    tambah('reserve_macet', mesin.statistik.orderReserveMacet, 'Order marketplace macet > ' + SM_HARI_RESERVE_MACET + ' hari (stok dilepas)', 'sedang', 'pengiriman', mesin.statistik.daftarMacet.slice(0, 5).map(function (x) { return x.sumber + ' #' + x.id; }));
    tambah('keluar_tanpa_scan', mesin.statistik.orderKeluarTanpaScan + mesin.statistik.poKeluarTanpaJejak, 'Pesanan keluar tanpa scan resi', 'ringan', 'pengiriman');

    // 4) Memo gudang yang perlu ditinjau (langsung masuk dari HP / masih menunggu)
    var bm = getMemoBarangMasukSheets(), lrB = bm.header.getLastRow(), bmTunggu = 0;
    if (lrB > 1) bm.header.getRange(Math.max(2, lrB - 400), 3, Math.min(401, lrB - 1), 1).getValues().forEach(function (r) { if (VM_STATUS_MENUNGGU[String(r[0] || '').trim()]) bmTunggu++; });
    tambah('memo_bm', bmTunggu, 'Memo Barang Masuk belum dicocokkan invoice', 'ringan', 'validasi');
    var hr = getMemoHilangRusakSheets(), lrH = hr.header.getLastRow(), hrBesar = [];
    if (lrH > 1) {
      var batas7 = Date.now() - 7 * 86400000, memoBaru = {};
      hr.header.getRange(2, 1, lrH - 1, 3).getValues().forEach(function (r) { if (smMs(r[1]) >= batas7 && String(r[2]).indexOf('Dibatalkan') !== 0) memoBaru[String(r[0]).trim()] = 0; });
      var lrHD = hr.detail.getLastRow();
      if (lrHD > 1) hr.detail.getRange(2, 1, lrHD - 1, 3).getValues().forEach(function (r) { var n = String(r[0]).trim(); if (n in memoBaru) memoBaru[n] += parseFloat(r[2]) || 0; });
      Object.keys(memoBaru).forEach(function (n) { if (memoBaru[n] >= AC_AMBANG_HR_BESAR) hrBesar.push(n); });
    }
    tambah('hr_besar', hrBesar.length, 'Laporan Hilang/Rusak besar (7 hari) perlu ditinjau', 'sedang', 'memogudang', hrBesar.slice(0, 5));

    // 5) v2026.10.25 (Paket 12, DN-261016-180130-901): promo terjadwal 3 tahap (lepas diskon -> naik harga -> diskon H+7)
    var agP = p12ButirAgendaPromo_();
    tambah('promo_gagal', agP.gagal.length, 'Promo terjadwal Shopee GAGAL dipasang (3 hari terakhir) - cek Katalog > Harga', 'utama', 'katalogharga', agP.gagal.slice(0, 5));
    tambah('promo_jadwal', agP.dijadwalkan.length, 'Promo terjadwal Shopee (tahap 3: diskon akan tayang) - harga sudah dinaikkan, pasang grup iklan setelah tayang', 'ringan', 'katalogharga', agP.dijadwalkan.slice(0, 5));
    tambah('promo_tayang', agP.tayang.length, 'Promo terjadwal sudah tayang (3 hari terakhir) - masukkan ke grup iklan Shopee bila perlu', 'ringan', 'katalogharga', agP.tayang.slice(0, 5));

    var urut = { utama: 0, sedang: 1, ringan: 2 };
    butir.sort(function (a, b) { return (urut[a.tingkat] - urut[b.tingkat]) || (b.jumlah - a.jumlah); });
    result.success = true;
    result.butir = butir;
    result.dihitungPada = smFmt(Date.now());
    try { cache.put(AC_CACHE_, JSON.stringify(result), 300); } catch (eP) { }
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ####################################################################################
   S5 - KIRIM STOK KE MARKETPLACE (Shopee & TikTok Shop Waterground) - MANUAL lewat tombol
   Angka yang dikirim = ON AVAILABLE (On Hand - On Reserve), minimal 0. Marketplace sudah mengurangi
   pesanan aktifnya sendiri dari angka ini, jadi tidak ada pengurangan dobel.
   Identitas listing memakai kolom "SKU Terhubung Shopee/TikTok" di Produk Master (SKU Gudang tidak
   pernah dipakai sebagai pengganti) + pencarian ID yang sama dengan Sync Harga. Conner punya tombol sendiri.
   Setiap kiriman dicatat di sheet "Log Sync Stok".
   ####################################################################################
*/
var STOKMP_MAKS_SKU = 60;
function stokMpLogSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName('Log Sync Stok');
  if (!sh) { sh = ss.insertSheet('Log Sync Stok'); sh.getRange(1, 1, 1, 9).setValues([['Waktu', 'SKU Gudang', 'Channel', 'SKU Marketplace', 'Listing ID', 'Stok Dikirim', 'Status', 'Pesan', 'Oleh']]).setFontWeight('bold'); sh.setFrozenRows(1); }
  return sh;
}
function stokMpKodeTerhubung_() {
  SYNC_KOLOM_MEMO_ = null;
  var kol = syncKolomSkuTerhubungMaster_(), sh = getMasterProdukSheet(), lr = sh.getLastRow(), lc = sh.getLastColumn(), peta = {};
  if (lr < 2) return peta;
  var vals = sh.getRange(2, 1, lr - 1, lc).getDisplayValues();
  vals.forEach(function (r) {
    var sku = String(r[0] || '').trim(); if (!sku) return;
    var e = { shopee: [], tiktok: [], nama: r[1] || '', arsip: katApakahArsip_(r[KAT_KOL_STATUS - 1]) };
    [['Shopee', 'shopee'], ['TikTok Shop', 'tiktok']].forEach(function (x) {
      var k = kol[x[0]]; if (!k || k.dobel) return;
      String(r[k.nomor - 1] || '').split(/[,;\s]+/).forEach(function (c) { c = c.trim(); if (c && e[x[1]].indexOf(c) < 0) e[x[1]].push(c); });
    });
    if (e.shopee.length || e.tiktok.length) peta[sku] = e;
  });
  return peta;
}
function stokMpTerakhir_() {
  var sh = stokMpLogSheet_(), lr = sh.getLastRow(), peta = {};
  if (lr < 2) return peta;
  var awal = Math.max(2, lr - 1500);
  sh.getRange(awal, 1, lr - awal + 1, 7).getValues().forEach(function (r) {
    if (String(r[6]) !== 'Terkirim') return;
    var k = String(r[1]) + '|' + String(r[2]);
    peta[k] = { waktu: pkFmt_(r[0]), qty: r[5] };
  });
