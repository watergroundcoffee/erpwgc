function devKonteksOtomatis_() {
  var baris = [];
  try {
    var terakhir = DEV_PAKET_SELESAI_[DEV_PAKET_SELESAI_.length - 1];
    baris.push('- Versi backend terbaru: ' + terakhir.versi + ' (' + terakhir.paket + ').');
    baris.push('- Riwayat paket (catatan yang sudah dikerjakan):');
    DEV_PAKET_SELESAI_.slice(-6).forEach(function (p) {
      var ids = Object.keys(p.selesai || {});
      baris.push('  - ' + p.versi + ' · ' + p.paket + ' · ' + ids.length + ' catatan: ' + ids.map(function (id) { return id.replace(/^DN-/, '') + ' ' + String(p.selesai[id]).slice(0, 90).replace(/\s+\S*$/, '') + '…'; }).join(' | '));
    });
  } catch (e) { }
  try {
    var sh = getDevCatatanSheet_(), lr = sh.getLastRow(), terbuka = 0;
    if (lr > 1) sh.getRange(2, 14, lr - 1, 1).getValues().forEach(function (r) { var s = String(r[0] || ''); if (s && s !== 'Selesai' && s !== 'Ditolak') terbuka++; });
    baris.push('- Catatan Developer masih terbuka: ' + terbuka + ' (rinciannya di bawah file ini).');
  } catch (e) { }
  return baris.join('\n');
}
function prosesDevKonteksLihat(data) {
  try {
    if (!mgApakahOwner_(data.email)) throw new Error('Konteks Memori hanya untuk akun Owner.');
    var p = PropertiesService.getScriptProperties(), simpan = String(p.getProperty(DEV_KONTEKS_PROP_) || '');
    var diubah = Number(p.getProperty(DEV_KONTEKS_PROP_ + '_T') || 0);
    return { success: true, teks: simpan || DEV_KONTEKS_DEFAULT_, bawaan: !simpan, templateBawaan: DEV_KONTEKS_DEFAULT_, otomatis: devKonteksOtomatis_(), diubah: diubah || null, maks: DEV_KONTEKS_MAKS_ };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}
function prosesDevKonteksSimpan(data) {
  try {
    if (!mgApakahOwner_(data.email)) throw new Error('Konteks Memori hanya untuk akun Owner.');
    var teks = String(data.teks == null ? '' : data.teks).replace(/\r\n/g, '\n').trim();
    if (teks.length > DEV_KONTEKS_MAKS_) throw new Error('Konteks terlalu panjang (' + teks.length + ' karakter, maks ' + DEV_KONTEKS_MAKS_ + '). Ringkas dulu supaya hemat token.');
    var p = PropertiesService.getScriptProperties();
