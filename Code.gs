    }
  });
}

// ===== AKSI: retur_klaim_simpan { noResi, tahap, noKlaim, nilai, catatan, kanal }
var P10_KLAIM_TAHAP_ = ['Belum diajukan', 'Diajukan', 'Diminta data tambahan', 'Disetujui', 'Ditolak', 'Retur batal - dana diterima'];
function p10HasilKlaim_(tahap, nilai) {
  if (tahap === 'Disetujui') return { hasil: 'Klaim berhasil', akuntansi: 'Pendapatan Klaim (7-102) ' + nilai + ' - kerugian barang ditutup ganti rugi marketplace' };
  if (tahap === 'Ditolak') return { hasil: 'Klaim gagal', akuntansi: 'Kerugian tetap tercatat (barang rusak/hilang = beban), tidak ada pendapatan klaim' };
  if (tahap === 'Retur batal - dana diterima') return { hasil: 'Penjualan berhasil', akuntansi: 'Retur tidak jadi - dana pesanan masuk, dihitung sebagai penjualan berhasil' };
  if (tahap === 'Belum diajukan') return { hasil: '', akuntansi: '' };
