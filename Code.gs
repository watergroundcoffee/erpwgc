/* ============================================================
   CACHE BESAR (gzip + dipecah per 90 KB). CacheService membatasi 100 KB per nilai, sehingga
   daftar pesanan gabungan (beberapa MB) dulu SELALU gagal di-cache dan dihitung ulang tiap panggilan.
   Nilai dikompres, dipecah, dan diberi nomor versi supaya pembaca tidak mencampur potongan dua versi.
   ============================================================ */
var CACHE_BESAR_POTONGAN_ = 90000;

function cacheBesarPut_(kunci, obj, detik) {
  try {
    var json = JSON.stringify(obj);
    var b64 = Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(json, 'application/json')).getBytes());
    var n = Math.ceil(b64.length / CACHE_BESAR_POTONGAN_);
    if (n > 250) return false; // terlalu besar - lewati cache
    var versi = String(Date.now()) + Math.floor(Math.random() * 1000);
    var peta = {};
    for (var i = 0; i < n; i++) peta[kunci + '__' + versi + '_' + i] = b64.substr(i * CACHE_BESAR_POTONGAN_, CACHE_BESAR_POTONGAN_);
    var cache = CacheService.getScriptCache();
    cache.putAll(peta, detik);
    cache.put(kunci + '__meta', JSON.stringify({ v: versi, n: n }), detik);
    return true;
  } catch (e) { return false; }
}

function cacheBesarGet_(kunci) {
  try {
    var cache = CacheService.getScriptCache();
    var meta = cache.get(kunci + '__meta');
    if (!meta) return null;
    meta = JSON.parse(meta);
    var daftarKunci = [];
    for (var i = 0; i < meta.n; i++) daftarKunci.push(kunci + '__' + meta.v + '_' + i);
    var isi = cache.getAll(daftarKunci);
    var b64 = '';
    for (var j = 0; j < daftarKunci.length; j++) {
      if (isi[daftarKunci[j]] === undefined || isi[daftarKunci[j]] === null) return null; // ada potongan yang kedaluwarsa
      b64 += isi[daftarKunci[j]];
    }
    var json = Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(b64), 'application/x-gzip')).getDataAsString();
    return JSON.parse(json);
  } catch (e) { return null; }
}

/* ============================================================
   NO RESI = SELALU STRING. Resi SiCepat diawali "00" (format 12 digit "004xxxxxxxxx").
   Kalau sel sheet berformat Automatic, setValues("004123...") diubah Sheets jadi ANGKA dan
   nol di depannya hilang -> nggak cocok lagi sama resi hasil scan di menu Pengiriman (yang
   disimpan sebagai teks). resiTeks_ dipakai di SEMUA pembacaan kolom No Resi pesanan.
   ============================================================ */
function resiTeks_(nilai, kurir) {
  if (nilai === null || nilai === undefined || nilai === '') return '';
  if (typeof nilai !== 'number') {
    var teks = String(nilai).trim().replace(/^'+/, ''); // apostrof penanda teks (kalau ada) bukan bagian resi
    // Resi yang terlanjur tersimpan sebagai TEKS tanpa "00" (mis. "4665168330") - pulihkan kalau kurirnya SiCepat
    if (/^\d{9,11}$/.test(teks) && /si\s*cepat/i.test(String(kurir || ''))) teks = ('000000000000' + teks).slice(-12);
    return teks;
  }
  if (!isFinite(nilai)) return '';
  var s = Math.abs(nilai) < 1e21 ? nilai.toFixed(0) : String(nilai); // toFixed(0) = tanpa notasi 1.2e+11
  if (s.length < 12) {
    var dipad = ('000000000000' + s).slice(-12);
    var kurirSiCepat = /si\s*cepat/i.test(String(kurir || ''));
    // Pulihkan nol depan yang terlanjur hilang: kurirnya SiCepat, ATAU polanya persis resi
    // SiCepat (10 digit diawali "4" -> "004..."). Resi kurir lain tidak pernah diawali 0.
    if ((kurirSiCepat && s.length >= 9) || (s.length === 10 && dipad.indexOf('004') === 0)) s = dipad;
  }
  return s;
}

/* ===== SMART MATCHING No Resi =====
   Kunci pembanding: huruf besar, tanpa spasi/apostrof, TANPA nol di depan.
   "004665168330" == "4665168330" == 4665168330 (angka) -> kunci "4665168330".
   Resi alfanumerik (J&T "JY...", SPX "SPXID...") tidak berubah karena tidak diawali 0.
   WAJIB dipakai di SEMUA perbandingan resi (jangan a === b langsung). */
function kunciResi_(v) {
  if (v === null || v === undefined) return '';
  var s;
  if (typeof v === 'number') s = isFinite(v) ? (Math.abs(v) < 1e21 ? v.toFixed(0) : String(v)) : '';
  else s = String(v);
  s = s.trim().replace(/^'+/, '').replace(/\s+/g, '').toUpperCase();
  if (!s || s === '-') return '';
  var tanpaNol = s.replace(/^0+/, '');
  return tanpaNol || '0';
}

function resiSama_(a, b) {
  var ka = kunciResi_(a);
  return ka !== '' && ka === kunciResi_(b);
}

// Tulis No Resi SELALU sebagai teks murni: sel diformat Plain Text ('@') dulu, baru nilainya
// di-set sebagai String. Ini setara efek apostrof di depan, tapi tanpa risiko apostrof ikut
// tersimpan sebagai karakter di sel yang sudah berformat teks.
function tulisResiTeks_(range, nilai) {
  range.setNumberFormat('@');
  range.setValue(String(nilai == null ? '' : nilai).trim().replace(/^'+/, ''));
  return range;
}

// Format kolom No Resi (kolom 7 / G) jadi Plain Text supaya resi baru tidak lagi dikonversi
// jadi angka. Cuma jalan SEKALI per sheet (ditandai di Script Properties).
function pastikanKolomResiTeks_(sh, kunci) {
  try {
    var props = PropertiesService.getScriptProperties();
    var k = 'FMT_RESI_TEKS_' + kunci;
    if (props.getProperty(k)) return;
    sh.getRange(1, 7, sh.getMaxRows(), 1).setNumberFormat('@');
    props.setProperty(k, '1');
  } catch (e) { /* nggak fatal - penulis resi juga set format '@' sendiri sebelum menulis */ }
}

// Label channel untuk laporan: pesanan Conner (lewat API TikTok) dipisah dari TikTok Waterground
function kanalLaporanPesanan_(o) {
  return (o.toko === 'Conner') ? 'Conner Hardware' : (o.sumber || 'Lainnya');
}

function msTanggalPesanan_(o) {
  if (o.ts) return o.ts;
  var t = new Date(String(o.tanggal || '').replace(',', ''));
  return isNaN(t.getTime()) ? 0 : t.getTime();
}

// Lihat daftar mentah mutasi Stock Ledger berdasarkan Jenis tertentu
// (dipakai buat audit "Barang Rusak/Hilang" - bukan angka net, tapi tiap kejadian dicatat)
function prosesLihatLedgerJenis(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var jenisFilter = String(data.jenis || '').trim();
    if (!jenisFilter) throw new Error('Jenis kosong');

    var sh = getStockLedgerSheet(data.toko);
    var lastRow = sh.getLastRow();
    var daftar = [];

    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 6).getValues();
      var shMaster = getMasterProdukSheet(data.toko);
      var namaMap = {};
      var lastRowMaster = shMaster.getLastRow();
      if (lastRowMaster > 1) {
        var masterVals = shMaster.getRange(2, 1, lastRowMaster - 1, 2).getValues();
        for (var m = 0; m < masterVals.length; m++) {
          namaMap[String(masterVals[m][0]).trim()] = String(masterVals[m][1] || '').trim();
        }
      }

      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][2]).trim() !== jenisFilter) continue;
        var sku = String(vals[i][1] || '').trim();
        daftar.push({
          tanggal: vals[i][0] instanceof Date
            ? Utilities.formatDate(vals[i][0], Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm')
            : String(vals[i][0] || ''),
          sku: sku,
          nama: namaMap[sku] || '(tidak ditemukan)',
          qty: vals[i][3],
          keterangan: vals[i][4],
          dicatatOleh: vals[i][5]
        });
      }
    }

    daftar.reverse(); // terbaru duluan
    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

