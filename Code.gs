function prosesFinTambahKategori(data) {
  return withTransaction(data.email, 'buatInvoice', 'keuangan', function () {
    var result = { success: false };
    var akun = finAkunDariLabel_(data.label);
    if (!akun || akun.length < 8) throw new Error('Nama kategori terlalu pendek');
    if (finAdalahKartuKredit_(akun)) throw new Error('Kategori Kartu Kredit tidak dipakai lagi. Pilih jenis biaya aslinya lalu aktifkan "Rembes" (ditalangi CC pribadi Owner).');
    akun = finPastikanAkunBeban_(finAkunNormal_(akun));
    result.success = true;
    result.akun = akun;
    result.kategori = finDaftarKategori_();
    return result;
  }, {
