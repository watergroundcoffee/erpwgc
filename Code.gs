   minta Gemini baca harganya (bukan scraping kaku, biar lebih fleksibel).
   ============================================================ */
function prosesSimpanUrlSupplier_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    var url = String(data.url || '').trim();
    if (!sku) throw new Error('SKU kosong');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var rowTarget = -1;
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][0]).trim() === sku) { rowTarget = i + 2; break; }
    }
    if (rowTarget === -1) throw new Error('SKU tidak ditemukan di Master Produk');

    var urlLama = String(sh.getRange(rowTarget, 5).getValue() || '').trim();
    sh.getRange(rowTarget, 5).setValue(url);
    // URL berubah -> kosongkan Last_Checked_URL supaya produk ini jadi prioritas antrean autoUpdateHPP_AI
    if (urlLama !== url) sh.getRange(rowTarget, 26).setValue('');
    SpreadsheetApp.flush();
    invalidasiCacheKatalogHarga(data.toko);
    try { CacheService.getScriptCache().remove('KATALOG_PRODUK_' + (data.toko || 'default')); } catch (eCache) { /* biarin */ }
    result.success = true;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesUpdateHargaModalDariSupplier(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('SKU kosong');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 9).getValues();
    var rowTarget = -1, urlSupplier = '', namaProduk = '', urlFotoSaatIni = '';
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][0]).trim() === sku) {
        rowTarget = i + 2;
        namaProduk = String(vals[i][1] || '').trim();
        urlSupplier = String(vals[i][4] || '').trim();
        urlFotoSaatIni = String(vals[i][8] || '').trim();
        break;
      }
    }
    if (rowTarget === -1) throw new Error('SKU tidak ditemukan di Master Produk');
    if (!urlSupplier) throw new Error('Belum ada URL Supplier buat SKU ini');

    // Ambil HTML halaman produk (v2026.10.36: URL pencarian supplier -> halaman produk yang cocok dibuka otomatis)
    var html;
    if (/search|cari|[?&](key|q|keyword)=/i.test(urlSupplier)) { html = supAmbilHalamanProduk_(urlSupplier).html; }
    else {
      var res = fetchHemat(urlSupplier, {
        muteHttpExceptions: true,
        headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36' }
      });
      if (res.getResponseCode() !== 200) {
        throw new Error('Gagal buka halaman supplier (kode ' + res.getResponseCode() + '). Kemungkinan situsnya diblokir/butuh JavaScript.');
      }
      html = res.getContentText();
    }

    var hargaBaru = null;
    var sumberHarga = '';

    // LAPIS 1: Cari data terstruktur (schema.org JSON-LD) - banyak toko online pakai ini
    // buat SEO. Kalau ketemu, ini jauh lebih akurat & nggak perlu AI sama sekali.
    var polaHargaTerstruktur = [
      /"@type"\s*:\s*"Offer"[^}]*?"price"\s*:\s*"?([\d.]+)"?/,
      /"price"\s*:\s*"?([\d]{3,})"?\s*,\s*"priceCurrency"/,
      /itemprop=["']price["'][^>]*content=["']([\d.]+)["']/i,
      /property=["']product:price:amount["'][^>]*content=["']([\d.]+)["']/i
    ];
    for (var p = 0; p < polaHargaTerstruktur.length; p++) {
      var cocok = html.match(polaHargaTerstruktur[p]);
      if (cocok && cocok[1]) {
        var angkaTerstruktur = cocok[1].replace(/\./g, '');
        if (angkaTerstruktur.length >= 3) { // minimal 3 digit, hindari salah tangkap angka kecil nggak relevan
          hargaBaru = parseInt(angkaTerstruktur, 10);
          sumberHarga = 'data terstruktur (schema.org)';
          break;
        }
      }
    }

    // LAPIS 1b (v2026.10.52): pembaca data produk supplier (JSON-LD @graph / meta) dari Paket 20
    if (!hargaBaru) {
      try { var ekP34 = supEkstrak_(html, urlSupplier); if (ekP34 && ekP34.harga >= 100) { hargaBaru = Math.round(ekP34.harga); sumberHarga = 'data produk halaman'; } } catch (eEk) { }
    }
    if (!hargaBaru && data.tanpaAI) throw new Error('Harga tidak terbaca dari data halaman (jadwal otomatis tidak memakai AI).');
    // LAPIS 2: Kalau data terstruktur nggak ketemu, baru minta AI baca teks halamannya
    if (!hargaBaru) {
      var teksBersih = html
        .replace(/<script[\s\S]*?<\/script>/gi, ' ')
        .replace(/<style[\s\S]*?<\/style>/gi, ' ')
        .replace(/<[^>]+>/g, ' ')
        .replace(/&nbsp;/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
      if (teksBersih.length > 15000) teksBersih = teksBersih.substring(0, 15000);

      var prompt = 'Ini isi teks dari halaman produk toko online. Nama produk yang saya cari: "' + namaProduk + '". ' +
        'Cari HARGA JUAL produk ini di teks berikut, lalu balas HANYA dengan angka rupiah-nya aja (tanpa "Rp", tanpa titik/koma, cuma digit angka). ' +
        'Kalau kamu nggak yakin atau nggak nemu harganya, balas dengan tulisan: TIDAK_KETEMU\n\n' +
        'TEKS HALAMAN:\n' + teksBersih;

      var jawabanAI = panggilGeminiText(prompt, 'rehan');
      var jawabanBersih = String(jawabanAI || '').trim();
      var angkaHarga = jawabanBersih.replace(/[^0-9]/g, '');

      if (jawabanBersih.indexOf('TIDAK_KETEMU') !== -1 || !angkaHarga) {
        throw new Error('Harga nggak ketemu - baik dari data terstruktur maupun AI baca teks halaman. Kemungkinan halamannya butuh JavaScript.');
      }
      hargaBaru = parseInt(angkaHarga, 10);
      sumberHarga = 'AI membaca teks halaman';
    }

    // Tulis HPP di dalam lock + cari ulang baris. PENGAMAN HARGA (Level 1 #4): kalau HPP dari supplier
    // >= Harga Jual Default, HPP TIDAK disimpan (hanya tanda "sudah dicek"), lalu admin diberi pesan.
    var pesanTolakHarga = null;
    katTulisDiBarisSku_(sh, sku, function (row) {
      var hargaJualSaatIni = parseFloat(sh.getRange(row, 3).getValue()) || 0;
      pesanTolakHarga = katPesanHppMelebihiHarga_(sku, hargaBaru, hargaJualSaatIni);
      if (!pesanTolakHarga) sh.getRange(row, 4).setValue(hargaBaru);
      sh.getRange(row, 26).setValue(new Date());
    });
    if (pesanTolakHarga) throw new Error(pesanTolakHarga + ' (harga dari supplier: ' + sumberHarga + ')');
    sinkronHargaSkuUtama_(sku, hargaBaru); // Harga Modal SKU Utama ikut harga terbaru dari supplier

    // Coba ambil foto produk juga dari data terstruktur yang sama - cuma kalau BELUM ada foto
    // (nggak nimpa foto yang udah diupload manual).
    var fotoBaruDiisi = false;
    if (!urlFotoSaatIni) {
      try {
        var polaFoto = [
          /"image"\s*:\s*"([^"]+\.(?:jpg|jpeg|png|webp)[^"]*)"/i,
          /property=["']og:image["'][^>]*content=["']([^"']+)["']/i
        ];
        var urlFotoAsli = null;
        for (var f = 0; f < polaFoto.length; f++) {
          var cocokFoto = html.match(polaFoto[f]);
          if (cocokFoto && cocokFoto[1]) { urlFotoAsli = cocokFoto[1].replace(/\\\//g, '/'); break; }
        }
        if (urlFotoAsli) {
          var resFoto = fetchHemat(urlFotoAsli, { muteHttpExceptions: true });
          if (resFoto.getResponseCode() === 200) {
            var blobFoto = resFoto.getBlob().setName('foto-produk-' + sku);
            var fileFoto = getSubfolderUpload('Foto Produk').createFile(blobFoto);
            fileFoto.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
            var urlFotoTersimpan = 'https://lh3.googleusercontent.com/d/' + fileFoto.getId();
            katTulisDiBarisSku_(sh, sku, function (row) { sh.getRange(row, 9).setValue(urlFotoTersimpan); });
            fotoBaruDiisi = true;
          }
        }
      } catch (eFoto) { /* foto gagal diambil, nggak masalah - harga tetap berhasil diupdate */ }
    }

    // (Last_Checked_URL sudah ditulis bersama HPP di dalam lock di atas.)
    invalidasiCacheKatalogHarga(data.toko);

    result.success = true;
    result.hargaModalBaru = hargaBaru;
    result.hargaModalLama = parseFloat(vals[rowTarget - 2][3]) || 0;
    result.sumberHarga = sumberHarga;
    result.fotoBaruDiisi = fotoBaruDiisi;
  } catch (err) {
    result.error = String(err && err.message || err);
  }
  return result;
}

/* ============================================================
   UPDATE HARGA MODAL OTOMATIS HARIAN - jalan sendiri tiap hari,
   cek SEMUA SKU yang punya URL Supplier terisi.
   ============================================================ */
/* ============================================================
   BATCH UPDATE HARGA SUPPLIER - aman buat ratusan SKU:
   - Proses SEBAGIAN per jalan (bukan semua sekaligus) - hindari limit 6 menit Apps Script
   - Ada "penanda posisi" (cursor) - next run lanjut dari situ, bukan ulang dari awal
   - Ada jaring pengaman waktu - berhenti otomatis kalau mendekati limit
   - Deteksi perubahan harga >50% - dicatat ke Sheet "Anomali Harga" biar bisa direview
   ============================================================ */
var BATCH_HPP_UKURAN_PER_JALAN = 30; // maks SKU diproses per eksekusi
var BATCH_HPP_BATAS_DETIK = 280; // berhenti kalau udah lewat ini (dari limit 360 detik/6 menit)

function getAnomaliHargaSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Anomali Harga');
  if (!sh) {
    sh = ss.insertSheet('Anomali Harga');
    sh.getRange(1, 1, 1, 5).setValues([['Tanggal', 'SKU', 'Nama Produk', 'Harga Lama', 'Harga Baru']]);
    sh.getRange(1, 1, 1, 5).setFontWeight('bold');
  }
  return sh;
}

function prosesUpdateHargaModalBatch() {
  var waktuMulai = new Date().getTime();
  var props = PropertiesService.getScriptProperties();

  var sh = getMasterProdukSheet();
  var lastRow = sh.getLastRow();
  if (lastRow < 2) { Logger.log('Batch Update Harga: belum ada produk di Master Produk.'); return; }

  var vals = sh.getRange(2, 1, lastRow - 1, 5).getValues();
  // Cuma ambil yang PUNYA URL Supplier - itu yang "antre" buat diproses
  var antrian = [];
  for (var i = 0; i < vals.length; i++) {
    var sku = String(vals[i][0] || '').trim();
    var urlSupplier = String(vals[i][4] || '').trim();
    if (sku && urlSupplier) antrian.push(sku);
  }
  if (antrian.length === 0) { Logger.log('Batch Update Harga: belum ada SKU yang punya URL Supplier.'); return; }

  var cursor = parseInt(props.getProperty('HPP_BATCH_CURSOR') || '0', 10);
  if (cursor >= antrian.length) cursor = 0; // udah sekali putaran penuh, mulai lagi dari awal

  var diproses = 0, berhasil = 0, gagal = 0;
  var shAnomali = getAnomaliHargaSheet();
  var tz = Session.getScriptTimeZone();

  while (diproses < BATCH_HPP_UKURAN_PER_JALAN && cursor < antrian.length) {
    var detikBerlalu = (new Date().getTime() - waktuMulai) / 1000;
    if (detikBerlalu > BATCH_HPP_BATAS_DETIK) {
      Logger.log('Batch Update Harga: berhenti duluan karena mendekati batas waktu (' + Math.round(detikBerlalu) + ' detik).');
      break;
    }

    var sku = antrian[cursor];
    var hargaLama = null;
    // Ambil harga lama SEBELUM update, buat bandingin (deteksi anomali)
    var rowCekLama = sh.getRange(2, 1, lastRow - 1, 4).getValues();
    for (var j = 0; j < rowCekLama.length; j++) {
      if (String(rowCekLama[j][0]).trim() === sku) { hargaLama = parseFloat(rowCekLama[j][3]) || 0; break; }
    }

    var hasil = denganIzinSistem_(function () { return prosesUpdateHargaModalDariSupplier({ sku: sku, email: SISTEM_EMAIL_ }); });
    // Catatan: Nama/Foto/Merk SENGAJA NGGAK ikut disini - cuma Harga Modal yang sync otomatis.
    // Update Nama/Foto/Merk cuma lewat tombol manual di Katalog (biar terkontrol, nggak berubah sendiri).
    if (hasil.success) {
      berhasil++;
      if (hargaLama && hargaLama > 0) {
        var persenPerubahan = Math.abs(hasil.hargaModalBaru - hargaLama) / hargaLama;
        if (persenPerubahan > 0.5) {
          var namaProdukAnomali = '';
          for (var k = 0; k < rowCekLama.length; k++) {
            if (String(rowCekLama[k][0]).trim() === sku) { namaProdukAnomali = rowCekLama[k][1]; break; }
          }
          shAnomali.appendRow([new Date(), sku, namaProdukAnomali, hargaLama, hasil.hargaModalBaru]);
        }
      }
    } else {
      gagal++;
      Logger.log('Gagal update harga SKU ' + sku + ': ' + hasil.error);
    }

    diproses++;
    cursor++;
    Utilities.sleep(1500); // jeda antar produk, biar nggak keliatan kayak nyerang situs suppliernya
  }

  props.setProperty('HPP_BATCH_CURSOR', String(cursor));
  Logger.log('Batch Update Harga selesai: ' + diproses + ' diproses (' + berhasil + ' berhasil, ' + gagal + ' gagal). Posisi sekarang: ' + cursor + '/' + antrian.length + '.');
}

// JALANKAN INI SEKALI SAJA (klik ▶ Run manual di editor) buat mengaktifkan batch update harga
// otomatis tiap 15 menit - bakal muter terus proses sebagian SKU tiap kali, sampai semua kebagian.
// JALANKAN INI SEKALI SAJA (klik ▶ Run manual di editor) buat mengaktifkan batch update harga
// otomatis - jalan 1x SEHARI, proses sebagian SKU tiap kali (pakai cursor, nyambung dari posisi
// terakhir), sampai semua SKU kebagian. Sengaja harian (bukan tiap menit) karena harga supplier
// biasanya baru berubah ~seminggu sekali - nggak perlu lebih sering dari itu, biar hemat kuota.
function aktifkanUpdateHargaModalOtomatis() {
  hapusUpdateHargaModalOtomatis(); // bersihin dulu kalau ada trigger lama, biar nggak dobel
  ScriptApp.newTrigger('prosesUpdateHargaModalBatch')
    .timeBased()
    .everyDays(1)
    .create();
  Logger.log('✅ Batch Update Harga Supplier AKTIF - bakal jalan sendiri 1x sehari, proses ' + BATCH_HPP_UKURAN_PER_JALAN + ' SKU per jalan.');
}

// Buat matiin kalau suatu saat perlu
function hapusUpdateHargaModalOtomatis() {
  var triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(function (t) {
    if (t.getHandlerFunction() === 'prosesUpdateHargaModalBatch' || t.getHandlerFunction() === 'prosesUpdateSemuaHargaModalOtomatis') ScriptApp.deleteTrigger(t);
  });
  Logger.log('Update Harga Supplier otomatis DIMATIKAN.');
}

/* ============================================================
   LAPORAN INVENTORY - HPP, Nilai Inventory, Barang Tidak Laku, Batas Stok per produk.
   Terinspirasi dari fitur sejenis di Jubelio, disesuaikan struktur data kita.
   CATATAN: "Tidak Laku" dihitung dari data PO Sales (Pesanan Manual Detail) saja -
   data penjualan TikTok Shop belum terstruktur per-SKU (baru ringkasan teks produk),
   jadi belum bisa diikutkan di laporan ini.
   ============================================================ */
function prosesLihatLaporanInventory(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    // 1. Ambil semua SKU + Harga Supplier + Batas Stok Menipis dari Master Produk
    var shMaster = getMasterProdukSheet(data.toko);
    var lastRowMaster = shMaster.getLastRow();
    var daftarProduk = [];
    if (lastRowMaster > 1) {
      var valsMaster = shMaster.getRange(2, 1, lastRowMaster - 1, 6).getValues();
      valsMaster.forEach(function (row) {
        var sku = String(row[0] || '').trim();
        if (!sku) return;
        daftarProduk.push({
          sku: sku,
          nama: String(row[1] || '').trim(),
          hargaSupplier: parseFloat(row[3]) || 0,
          batasStokMenipis: (row[5] !== '' && row[5] != null) ? parseFloat(row[5]) : 5 // default 5 kalau belum diisi
        });
      });
    }

    // 2. Hitung stock fisik tiap SKU (pakai fungsi yang udah ada)
    var stockData = prosesLihatStock({ email: data.email });
    var stockMap = {};
    if (stockData.success) {
      stockData.daftar.forEach(function (d) { stockMap[d.sku] = d.stockSaatIni; });
    }

    // 3. Cari tanggal terakhir tiap SKU terjual (dari Pesanan Manual Detail + Header, buat cek "Tidak Laku")
    var sheets = getPesananManualSheets();
    var tglTerakhirJualMap = {};
    var lastRowHeader = sheets.header.getLastRow();
    var mapTanggalPerInvoice = {};
    if (lastRowHeader > 1) {
      var valsHeader = sheets.header.getRange(2, 1, lastRowHeader - 1, 2).getValues();
      valsHeader.forEach(function (row) {
        var noInv = String(row[0] || '').trim();
        if (noInv && row[1] instanceof Date) mapTanggalPerInvoice[noInv] = row[1];
      });
    }
    var lastRowDetail = sheets.detail.getLastRow();
    if (lastRowDetail > 1) {
      var valsDetail = sheets.detail.getRange(2, 1, lastRowDetail - 1, 2).getValues();
      valsDetail.forEach(function (row) {
        var noInv = String(row[0] || '').trim();
        var sku = String(row[1] || '').trim();
        var tglInvoice = mapTanggalPerInvoice[noInv];
        if (sku && tglInvoice) {
          if (!tglTerakhirJualMap[sku] || tglInvoice > tglTerakhirJualMap[sku]) tglTerakhirJualMap[sku] = tglInvoice;
        }
      });
    }

    // 4. Gabungkan semua jadi 1 laporan per produk
    var sekarang = new Date();
    var msPerHari = 24 * 60 * 60 * 1000;
    var totalNilaiInventory = 0;
    var tz = Session.getScriptTimeZone();
    // v2026.10.15: stok MINUS (terjual sebelum stok masuk tercatat / Stock Bayangan) TIDAK ikut nilai inventory -
    // dilaporkan terpisah supaya total nilai tidak membingungkan.
    var stokMinus = { jumlahSku: 0, totalQty: 0, nilai: 0 };

    var laporan = daftarProduk.map(function (p) {
      var stockFisik = stockMap[p.sku] || 0;
      var nilaiInventoryProduk = Math.max(0, stockFisik) * p.hargaSupplier;
      totalNilaiInventory += nilaiInventoryProduk;
      if (stockFisik < 0) { stokMinus.jumlahSku++; stokMinus.totalQty += -stockFisik; stokMinus.nilai += -stockFisik * (p.hargaSupplier || 0); }

      var tglTerakhirJual = tglTerakhirJualMap[p.sku] || null;
      var hariSejakTerjual = tglTerakhirJual ? Math.floor((sekarang - tglTerakhirJual) / msPerHari) : null;
      var tidakLaku = hariSejakTerjual === null || hariSejakTerjual >= 90;

      return {
        sku: p.sku,
        nama: p.nama,
        stockFisik: stockFisik,
        hargaSupplier: p.hargaSupplier,
        nilaiInventory: nilaiInventoryProduk,
        stokMinus: stockFisik < 0,
        batasStokMenipis: p.batasStokMenipis,
        menipis: stockFisik <= p.batasStokMenipis,
        tglTerakhirJual: tglTerakhirJual ? Utilities.formatDate(tglTerakhirJual, tz, 'dd MMM yyyy') : null,
        hariSejakTerjual: hariSejakTerjual,
        tidakLaku: tidakLaku
      };
    });

    result.success = true;
    result.laporan = laporan;
    result.totalNilaiInventory = totalNilaiInventory;
    result.stokMinus = stokMinus;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesSimpanBatasStokMenipisSatuSku_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    var batas = parseFloat(data.batas);
    if (!sku || isNaN(batas) || batas < 0) throw new Error('Data tidak valid');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var rowTarget = -1;
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][0]).trim() === sku) { rowTarget = i + 2; break; }
    }
    if (rowTarget === -1) throw new Error('SKU tidak ditemukan');

    sh.getRange(rowTarget, 6).setValue(batas);
    result.success = true;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   KATALOG - Produk (info channel), Harga (per-channel), Kategori
   ============================================================ */
function prosesLihatKatalogProduk(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var denganArsip = data.denganArsip === true; // toggle "Tampilkan Arsip" - selalu dibaca segar (tanpa cache)
    var cache = CacheService.getScriptCache();
    var cacheKey = 'KATALOG_PRODUK_' + (data.toko || 'default');
    // segar: true -> abaikan cache (dipakai setelah Simpan Edit supaya tabel PASTI menampilkan data terbaru)
    var dariCache = (denganArsip || data.segar === true) ? null : cache.get(cacheKey);
    if (dariCache) {
      try { return JSON.parse(dariCache); } catch (eParseCache) { /* cache korup, lanjut fresh */ }
    }
    var petaArsipKatalog = katPetaArsip_(data.toko);

    var shMaster = vbPastikanKolom_(getMasterProdukSheet(data.toko));
    var lastRowMaster = shMaster.getLastRow();
    var daftar = [];
    if (lastRowMaster > 1) {
      var valsMaster = shMaster.getRange(2, 1, lastRowMaster - 1, VB_KOL_NILAI2).getValues();
      valsMaster.forEach(function (row, idx) {
        var sku = String(row[0] || '').trim();
        if (!sku) return;
        var arsip = !!petaArsipKatalog[sku];
        if (arsip && !denganArsip) return; // SOFT DELETE: disembunyikan, baris tetap ada di sheet
        // Field detail ikut dikirim di list -> halaman Detail & modal Edit dirender dari data lokal browser
        // (tanpa request lihat_detail_produk tiap klik). Kolom sudah ikut terbaca di getValues() yang sama.
        var spesifikasiList = [], galeriList = [];
        try { spesifikasiList = row[20] ? JSON.parse(row[20]) : []; } catch (eSpek) { spesifikasiList = []; }
        try { galeriList = row[21] ? JSON.parse(row[21]) : []; } catch (eGaleri) { galeriList = []; }
        daftar.push({
          hargaDefault: parseFloat(row[2]) || 0, hargaSupplier: parseFloat(row[3]) || 0,
          batasStokMenipis: row[5], hargaShopee: parseFloat(row[6]) || 0,
          deskripsi: String(row[9] || '').trim(), marginCustom: row[15] !== '' ? row[15] : null,
          berat: String(row[18] || '').trim(), dimensi: String(row[19] || '').trim(),
          spesifikasiTambahan: spesifikasiList, galeriFotoTambahan: galeriList,
          arsip: arsip,
          sku: sku, nama: String(row[1] || '').trim(), kategori: String(row[7] || '').trim(),
          urlFoto: String(row[8] || '').trim(), urlSupplier: String(row[4] || '').trim(),
          brand: String(row[10] || '').trim(), tipe: String(row[11] || '').trim(),
          material: String(row[12] || '').trim(), volume: String(row[13] || '').trim(), warna: String(row[14] || '').trim(),
          tampilWebsite: row[17] === true, channel: [],
          idVarian: String(row[22] || '').trim(), labelVarian: String(row[23] || '').trim(),
          tipe1: String(row[VB_KOL_TIPE1 - 1] || '').trim(), nilai1: String(row[VB_KOL_NILAI1 - 1] || '').trim(),
          tipe2: String(row[VB_KOL_TIPE2 - 1] || '').trim(), nilai2: String(row[VB_KOL_NILAI2 - 1] || '').trim(),
          noBaris: idx // urutan asli di sheet - dipakai buat sort "Terbaru" (baris makin bawah = makin baru)
        });
      });
    }
    var mapBySku = {};
    daftar.forEach(function (d) { mapBySku[d.sku] = d; });

    // Cek channel dari sheet terpusat "SKU Marketplace Terhubung" - mencakup SEMUA platform
    // (TikTok Shop, Shopee, Tokopedia) yang udah dipetakan, bukan cuma TikTok kayak sebelumnya.
    var shSkuMarket = getSkuMarketplaceTerhubungSheet();
    var lastRowSkuMarket = shSkuMarket.getLastRow();
    if (lastRowSkuMarket > 1) {
      var valsSkuMarket = shSkuMarket.getRange(2, 1, lastRowSkuMarket - 1, 3).getValues(); // SKU Jual, SKU Marketplace, Platform
      valsSkuMarket.forEach(function (row) {
        var skuJual = String(row[0] || '').trim();
        var platform = String(row[2] || '').trim();
        if (skuJual && platform && mapBySku[skuJual] && mapBySku[skuJual].channel.indexOf(platform) === -1) {
          mapBySku[skuJual].channel.push(platform);
        }
      });
    }
    // Fallback tambahan: produk TikTok Shop yang sellerSku-nya udah SAMA PERSIS sama SKU Jual
    // (belum sempat dipetakan manual di atas) - biar nggak keluput dari badge channel.
    var shTiktokProduk = getProdukTikTokShopSheet();
    var lastRowTiktok = shTiktokProduk.getLastRow();
    if (lastRowTiktok > 1) {
      var valsTiktok = shTiktokProduk.getRange(2, 1, lastRowTiktok - 1, 1).getValues();
      valsTiktok.forEach(function (row) {
        var sellerSku = String(row[0] || '').trim();
        if (sellerSku && mapBySku[sellerSku] && mapBySku[sellerSku].channel.indexOf('TikTok Shop') === -1) {
          mapBySku[sellerSku].channel.push('TikTok Shop');
        }
      });
    }

    result.success = true;
    result.daftar = daftar;
    // Definisi grup varian bertingkat (nama induk, urutan pilihan) ikut dikirim -> jendela Atur Variasi
    // dibuka dari data lokal browser tanpa request lihat_varian_bertingkat.
    try { result.urutanVarian = vbBacaUrutan_(); } catch (eUrutan) { result.urutanVarian = {}; }
    if (!denganArsip) { try { cache.put(cacheKey, JSON.stringify(result), 30); } catch (eCachePut) { /* kegedean buat cache, lewati */ } }
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesLihatKatalogHarga(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var cache = CacheService.getScriptCache();
    var cacheKey = 'KATALOG_HARGA_' + (data.toko || 'default');
    var dariCache = cache.get(cacheKey);
    if (dariCache) {
      try { return JSON.parse(dariCache); } catch (eParseCache) { /* cache korup, lanjut fresh */ }
    }

    var props = PropertiesService.getScriptProperties();
    var marginGlobal = parseFloat(props.getProperty('MARGIN_DEFAULT_PERSEN') || '30');

    // Halaman Harga v2: SEMUA perhitungan Rekomendasi Harga (True Margin) dilakukan real-time di
    // front-end pakai Parameter Biaya Platform (Tab 2). Server cuma nyuplai data mentah: identitas
    // produk (read-only, ditarik dari Master Produk), HPP, margin, dan 3 Harga Jual Final tersimpan.
    // Harga Modal/HPP di sini SENGAJA nggak disambungin ke rata-rata Stock Ledger (itu urusan
    // Laporan Inventory) - biar nilainya stabil & nggak berubah sendiri gara-gara stock masuk.
    var shMaster = getMasterProdukSheet(data.toko);
    var lastRowMaster = shMaster.getLastRow();
    var daftar = [];
    if (lastRowMaster > 1) {
      var valsMaster = shMaster.getRange(2, 1, lastRowMaster - 1, 29).getValues();
      var tzHarga = Session.getScriptTimeZone();
      var petaArsipHarga = katPetaArsip_(data.toko);
      var petaInduk = null;
      try { SM_MEMO_SKU_JUAL_ = null; petaInduk = petaSkuInduk_(); } catch (eP) { petaInduk = null; }
      // Harga Modal acuan = Harga Modal SKU Utama (baris teratas SKU Supplier). Kosong -> Harga Supplier Master Produk.
      var petaUtama = {};
      try { petaUtama = petaSkuUtamaSupplier_(); } catch (eU) { petaUtama = {}; }
      valsMaster.forEach(function (row) {
        var sku = String(row[0] || '').trim();
        if (!sku || petaArsipHarga[sku]) return; // produk arsip tidak tampil di menu Harga
        var marginCustom = (row[15] !== '' && row[15] !== null && !isNaN(parseFloat(row[15]))) ? parseFloat(row[15]) : null;
        var utama = petaUtama[sku] || null;
        var hppUtama = utama && utama.harga > 0 ? utama.harga : 0;
        daftar.push({
          sku: sku,
          nama: String(row[1] || '').trim(),
          urlFoto: String(row[8] || '').trim(),
          hpp: hppUtama > 0 ? hppUtama : (parseFloat(row[3]) || 0),
          hppSumber: hppUtama > 0 ? 'sku_utama' : 'master',
          skuUtamaSupplier: utama ? utama.sku : '',
          urlSupplier: (utama && utama.url) || String(row[4] || '').trim(),
          marginCustom: marginCustom,
          hargaDefault: parseFloat(row[2]) || 0,
          hargaShopee: parseFloat(row[6]) || 0,
          hargaTiktok: parseFloat(row[24]) || 0,
          hargaCoretShopee: parseFloat(row[27]) || 0,
          hargaCoretTiktok: parseFloat(row[28]) || 0,
          terhubung: petaInduk ? (petaInduk.perInduk[sku] || []).slice(0, 40) : [],
          terakhirSync: row[26] instanceof Date ? Utilities.formatDate(row[26], tzHarga, 'dd MMM yyyy HH:mm') : String(row[26] || '').trim()
        });
      });
    }

    result.success = true;
    result.daftar = daftar;
    result.marginGlobal = marginGlobal;
    result.paramBiaya = ambilParamBiayaPlatform();
    try { var teksHarga = JSON.stringify(result); if (teksHarga.length < 95000) cache.put(cacheKey, teksHarga, 30); } catch (eCachePut) { /* kegedean buat cache, lewati */ }
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesSimpanHargaShopee_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('Data tidak valid');
    // Failsafe lapis 2: harga <= 0 / kosong / NaN DITOLAK mutlak.
    var harga = assertHargaJualFinalValid(data.harga, 'Shopee (' + sku + ')');
    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var rowTarget = -1;
    for (var i = 0; i < vals.length; i++) { if (String(vals[i][0]).trim() === sku) { rowTarget = i + 2; break; } }
    if (rowTarget === -1) throw new Error('SKU tidak ditemukan');
    sh.getRange(rowTarget, 7).setValue(harga);
    SpreadsheetApp.flush();
    invalidasiCacheKatalogHarga(data.toko);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   KALKULATOR HARGA JUAL (Katalog > Harga, Tab 2) - Parameter v4
   ------------------------------------------------------------
   MURNI untuk simulasi rekomendasi harga jual - TIDAK dipakai Laporan Keuangan.
   Disimpan sebagai 1 JSON di Script Properties (KUNCI_PARAM_BIAYA_PLATFORM):
   { versi: 4, grup: { default|shopee|tiktok|tokopedia: { biaya: [], promosi: [], operasional: [] } } }
   Semua seksi memakai format baris yang SAMA:
     { nama, nominal, tipe: '%' | 'Rp', maks: number|null (hanya untuk %), peran?: 'markup' }
   Baris ber-peran 'markup' (default: "Harga Coret (Markup)" di seksi promosi) BUKAN biaya -
   dipakai front-end untuk menghitung Harga Coret dari Harga Jual Final. Semua baris lain = biaya
   dan ikut rumus True Margin.
   Data versi 2 & 3 (sebelumnya) otomatis dimigrasi.
   ============================================================ */
var KUNCI_PARAM_BIAYA_PLATFORM = 'PARAM_BIAYA_PLATFORM_V2'; // key sama, isi sekarang versi 4 (auto-migrasi)
var GRUP_PARAM_BIAYA = ['default', 'shopee', 'tiktok', 'tokopedia'];
var SEKSI_PARAM_BIAYA = ['biaya', 'promosi', 'operasional'];

function barisMarkupDefault_(nominal) { return { nama: 'Harga Coret (Markup)', nominal: nominal || 0, tipe: '%', maks: null, peran: 'markup' }; }
function barisIklanDefault_(nominal) { return { nama: 'Biaya Iklan', nominal: nominal || 0, tipe: '%', maks: null }; }
function barisPackingDefault_(nominal, tipe) { return { nama: 'Biaya Packing Gudang', nominal: nominal || 0, tipe: tipe === '%' ? '%' : 'Rp', maks: null }; }

function defaultParamBiayaPlatform() {
  function grup(biaya, marketplace) {
    return {
      biaya: biaya,
      promosi: [barisMarkupDefault_(0), barisIklanDefault_(0)], // Harga Coret permanen di SEMUA card (termasuk Offline)
      operasional: [barisPackingDefault_(0, 'Rp')]
    };
  }
  return {
    versi: 4,
    grup: {
      default: grup([], false),
      shopee: grup([
        { nama: 'Biaya Layanan/Admin', nominal: 6.5, tipe: '%', maks: 10000 },
        { nama: 'Bebas Ongkir Xtra', nominal: 4, tipe: '%', maks: 10000 },
        { nama: 'Biaya Komisi Xtra', nominal: 0, tipe: '%', maks: null },
        { nama: 'Komisi Dinamis', nominal: 0, tipe: '%', maks: 60000 },
        { nama: 'Komisi Platform', nominal: 0, tipe: '%', maks: null }
      ], true),
      tiktok: grup([
        { nama: 'Biaya Komisi TikTok', nominal: 6.5, tipe: '%', maks: null },
        { nama: 'Biaya Transaksi TikTok', nominal: 2000, tipe: 'Rp', maks: null }
      ], true),
      tokopedia: grup([
        { nama: 'Biaya Layanan Tokopedia', nominal: 5.5, tipe: '%', maks: null },
        { nama: 'Bebas Ongkir Tokopedia', nominal: 4, tipe: '%', maks: 10000 }
      ], true)
    }
  };
}

// Versi 2 / 3 -> versi 4
function migrasiParamBiayaKeV4(p) {
  if (p && p.versi === 4 && p.grup) return p;
  var hasil = defaultParamBiayaPlatform();
  if (p && p.versi === 2) {
    GRUP_PARAM_BIAYA.forEach(function (g) { if (Array.isArray(p[g])) hasil.grup[g].biaya = p[g]; });
  } else if (p && p.versi === 3 && p.grup) {
    GRUP_PARAM_BIAYA.forEach(function (g) {
      var x = p.grup[g];
      if (!x) return;
      var mp = g !== 'default';
      hasil.grup[g] = {
        biaya: Array.isArray(x.biaya) ? x.biaya : [],
        promosi: (mp ? [barisMarkupDefault_(Number(x.markup) || 0)] : []).concat([barisIklanDefault_(Number(x.iklan) || 0)]).concat(Array.isArray(x.promosi) ? x.promosi : []),
        operasional: [barisPackingDefault_(x.packing ? Number(x.packing.nominal) || 0 : 0, x.packing ? x.packing.tipe : 'Rp')]
      };
    });
  }
  return hasil;
}

function normalisasiBarisBiaya_(daftar, labelGrup, labelSeksi) {
  daftar = Array.isArray(daftar) ? daftar : [];
  if (daftar.length > 30) throw new Error('Maksimal 30 baris ' + labelSeksi + ' per card (' + labelGrup + ').');
  return daftar.map(function (b, idx) {
    var nama = String((b && b.nama) || '').trim().substring(0, 60);
    if (!nama) throw new Error('Nama di ' + labelSeksi + ' baris ke-' + (idx + 1) + ' (' + labelGrup + ') wajib diisi.');
    var tipe = (b && b.tipe) === 'Rp' ? 'Rp' : '%';
    var markup = !!(b && b.peran === 'markup');
    var nominal = (b && (b.nominal === '' || b.nominal === null || b.nominal === undefined)) ? 0 : Number(b && b.nominal);
    if (isNaN(nominal) || !isFinite(nominal) || nominal < 0) throw new Error('Nominal "' + nama + '" harus angka 0 atau lebih.');
    // Markup boleh > 100% (harga coret bisa 2x lipat), biaya % harus < 100
    if (tipe === '%' && nominal >= (markup ? 1000 : 100)) throw new Error('Persen "' + nama + '" terlalu besar.');
    var maks = null;
    if (!markup && tipe === '%' && b && b.maks !== '' && b.maks !== null && b.maks !== undefined) {
      maks = Number(b.maks);
      if (isNaN(maks) || !isFinite(maks) || maks <= 0) throw new Error('Batas Maks "' + nama + '" harus lebih dari Rp 0 atau dikosongkan.');
      maks = Math.round(maks);
    }
    var hasil = { nama: nama, nominal: tipe === '%' ? Math.round(nominal * 1000) / 1000 : Math.round(nominal), tipe: tipe, maks: maks };
    if (markup) hasil.peran = 'markup';
    return hasil;
  });
}

// Baris "Harga Coret (Markup)" PERMANEN: tepat 1 per card (termasuk Offline), selalu di posisi pertama
// seksi promosi, nama & tipe (%) dikunci. Kalau tidak ada (data lama / terhapus), dibuat ulang dengan 0%.
function pastikanBarisMarkup_(promosi) {
  var list = (promosi || []).slice();
  var idx = -1;
  for (var i = 0; i < list.length; i++) { if (list[i].peran === 'markup') { idx = i; break; } }
  var markup = idx === -1 ? barisMarkupDefault_(0) : list.splice(idx, 1)[0];
  list.forEach(function (b) { delete b.peran; });
  var nominal = markup.tipe === '%' ? Number(markup.nominal) || 0 : 0;
  return [barisMarkupDefault_(nominal)].concat(list);
}

// Validasi + normalisasi. throw Error kalau ada yang tidak valid.
function normalisasiParamBiayaPlatform(pMentah) {
  var p = migrasiParamBiayaKeV4(pMentah);
  var hasil = { versi: 4, grup: {} };
  GRUP_PARAM_BIAYA.forEach(function (g) {
    var src = (p.grup && p.grup[g]) || {};
    var labelGrup = g === 'default' ? 'Offline' : g;
    var x = {};
    SEKSI_PARAM_BIAYA.forEach(function (seksi) { x[seksi] = normalisasiBarisBiaya_(src[seksi], labelGrup, seksi); });
    x.promosi = pastikanBarisMarkup_(x.promosi);
    // Total biaya persen (semua seksi, KECUALI baris markup) harus < 100%, kalau tidak rumus True Margin mustahil
    var totalPersen = 0;
    x.biaya.concat(x.promosi, x.operasional).forEach(function (b) { if (b.tipe === '%' && b.peran !== 'markup') totalPersen += b.nominal; });
    if (totalPersen >= 100) throw new Error('Total biaya persen ' + labelGrup + ' harus di bawah 100%.');
    hasil.grup[g] = x;
  });
  // v2026.10.108 (DN-912): Tokopedia (bagian TikTok Shop) memakai skema biaya yang SAMA PERSIS dengan TikTok Shop
  if (hasil.grup.tiktok && hasil.grup.tokopedia) hasil.grup.tokopedia = JSON.parse(JSON.stringify(hasil.grup.tiktok));
  return hasil;
}

function ambilParamBiayaPlatform() {
  var raw = PropertiesService.getScriptProperties().getProperty(KUNCI_PARAM_BIAYA_PLATFORM);
  if (raw) {
    try {
      var p = JSON.parse(raw);
      var bersih = normalisasiParamBiayaPlatform(p);
      bersih.sumber = 'tersimpan';
      bersih.diubahOleh = p.diubahOleh || '';
      bersih.diubahPada = p.diubahPada || '';
      return bersih;
    } catch (eParse) { /* korup - jatuh ke default di bawah */ }
  }
  var def = defaultParamBiayaPlatform();
  def.sumber = 'default';
  def.diubahOleh = '';
  def.diubahPada = '';
  return def;
}

function prosesLihatParamBiayaPlatform(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    result.paramBiaya = ambilParamBiayaPlatform();
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesSimpanParamBiayaPlatform(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var bersih = normalisasiParamBiayaPlatform(data.paramBiaya || {});
    bersih.diubahOleh = String(data.email || '');
    bersih.diubahPada = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm');
    PropertiesService.getScriptProperties().setProperty(KUNCI_PARAM_BIAYA_PLATFORM, JSON.stringify(bersih));
    invalidasiCacheKatalogHargaSemuaToko();
    result.paramBiaya = ambilParamBiayaPlatform();
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   AUTO-UPDATE HPP AI (Background Queue / Cron Job)
   ------------------------------------------------------------
   Dipicu Time-driven Trigger (default tiap 6 jam - pasang lewat menu "Tracking Resi" >
   "Aktifkan Auto-Update HPP AI", atau jalankan pasangTriggerAutoUpdateHPP() sekali).
   Tiap jalan: ambil maks AUTO_HPP_BATCH_MAKS produk yang PUNYA URL Supplier dengan
   Last_Checked_URL paling usang (kosong = belum pernah dicek = prioritas pertama),
   proses satu per satu, lalu perbarui timestamp Last_Checked_URL-nya.
   Kolom Master Produk yang dipakai:
     1 = SKU, 2 = Nama, 4 = Harga Supplier (HPP), 5 = URL Supplier, 26 = Last_Checked_URL
   ============================================================ */
var AUTO_HPP_BATCH_MAKS = 15;
var AUTO_HPP_KOLOM_LAST_CHECKED = 26;
var AUTO_HPP_BATAS_WAKTU_MS = 5 * 60 * 1000; // Apps Script dibatasi 6 menit/eksekusi - sisakan napas 1 menit

function autoUpdateHPP_AI() {
  // PENTING: fungsi ini TIDAK memegang ScriptLock selama proses AI (bisa sampai 5 menit) - ScriptLock
  // dipakai bersama oleh semua aksi simpan (Simpan Pembelian, scan resi, dll). Kalau dipegang lama,
  // semua simpan lain gagal "Sistem sibuk". Pencegah eksekusi dobel pakai flag CacheService, dan
  // ScriptLock hanya diambil SEBENTAR di akhir untuk 1x tulis batch.
  var cache = CacheService.getScriptCache();
  if (cache.get('AUTO_HPP_SEDANG_JALAN')) { console.log('autoUpdateHPP_AI: eksekusi sebelumnya masih jalan, dilewati.'); return; }
  cache.put('AUTO_HPP_SEDANG_JALAN', '1', 400); // otomatis kedaluwarsa ~6,5 menit (batas maksimal eksekusi Apps Script)
  var waktuMulai = Date.now();
  var ringkasan = { dicek: 0, hppDiupdate: 0, gagal: 0, dilewati: 0 };
  try {
    var sh = getMasterProdukSheet();
    var lastRow = sh.getLastRow();
    if (lastRow < 2) return;
    var vals = sh.getRange(2, 1, lastRow - 1, AUTO_HPP_KOLOM_LAST_CHECKED).getValues();

    // 1) Kumpulkan kandidat: produk ber-URL Supplier, urutkan Last_Checked_URL paling lama dulu
    var kandidat = [];
    vals.forEach(function (row) {
      var sku = String(row[0] || '').trim();
      var url = String(row[4] || '').trim();
      if (!sku || !/^https?:\/\/\S+/i.test(url)) return;
      if (katPetaArsip_()[sku]) return; // produk diarsipkan tidak perlu dicek AI
      var terakhir = row[AUTO_HPP_KOLOM_LAST_CHECKED - 1];
      var waktuTerakhir = (terakhir instanceof Date) ? terakhir.getTime() : (terakhir ? new Date(terakhir).getTime() : 0);
      if (isNaN(waktuTerakhir)) waktuTerakhir = 0;
      kandidat.push({ sku: sku, nama: String(row[1] || '').trim(), url: url, hppLama: parseFloat(row[3]) || 0, waktuTerakhir: waktuTerakhir });
    });
    kandidat.sort(function (a, b) { return a.waktuTerakhir - b.waktuTerakhir; });
    var batch = kandidat.slice(0, AUTO_HPP_BATCH_MAKS);

    // 2) Proses satu per satu - hasil dikumpulkan di MEMORY dulu (belum menulis ke sheet)
    var hasilPerSku = {}; // sku -> { hppBaru: number|null, dicekPada: Date }
    batch.forEach(function (item) {
      if (Date.now() - waktuMulai > AUTO_HPP_BATAS_WAKTU_MS) { ringkasan.dilewati++; return; } // sisa batch lanjut di trigger berikutnya
      ringkasan.dicek++;
      var hppBaru = null;
      try {
        /* ======================================================================
           TEMPAT PEMANGGILAN API GEMINI (isi di sini)
           ----------------------------------------------------------------------
           Input yang tersedia : item.url (URL Supplier), item.nama, item.sku, item.hppLama
           Output yang diharapkan: hppBaru = angka harga (Rupiah) hasil bacaan AI.
           Contoh kerangka:
             var html = fetchHemat(item.url, { muteHttpExceptions: true, followRedirects: true }).getContentText();
             var jawabanAI = panggilGeminiUntukHarga(html, item.nama);   // <- fungsi Gemini buatan Maswan
             hppBaru = Number(jawabanAI.harga);
           Kalau AI gagal / tidak yakin, biarkan hppBaru = null (HPP lama TIDAK disentuh).
           ====================================================================== */
      } catch (errAI) {
        ringkasan.gagal++;
        console.log('autoUpdateHPP_AI: gagal cek ' + item.sku + ' - ' + errAI);
      }
      // FAILSAFE: hanya pakai HPP kalau hasil AI angka valid > 0. Rp 0 / NaN / negatif DIABAIKAN.
      var valid = hppBaru !== null && isFinite(Number(hppBaru)) && Math.round(Number(hppBaru)) > 0;
      // Timestamp tetap diperbarui walau AI gagal, supaya antrean berputar ke produk lain.
      hasilPerSku[item.sku] = { hppBaru: valid ? Math.round(Number(hppBaru)) : null, dicekPada: new Date() };
    });
    if (Object.keys(hasilPerSku).length === 0) return;

    // 3) Tulis BATCH dengan lock singkat: baca ulang SKU/HPP/Last_Checked (bisa saja baris bergeser
    //    selama proses AI), ubah di memory, lalu 1x setValues untuk kolom HPP & 1x untuk Last_Checked.
    var lock = kunciModul_('katalog');
    if (!lock.tryLock(20000)) { console.log('autoUpdateHPP_AI: gagal dapat lock untuk menulis, hasil dibuang - dicoba lagi di putaran berikutnya.'); return; }
    try {
      var lastRowTulis = sh.getLastRow();
      if (lastRowTulis < 2) return;
      var n = lastRowTulis - 1;
      var kolomSku = sh.getRange(2, 1, n, 1).getValues();
      var kolomHpp = sh.getRange(2, 4, n, 1).getValues();
      var kolomHarga = sh.getRange(2, 3, n, 1).getValues();
      var kolomCek = sh.getRange(2, AUTO_HPP_KOLOM_LAST_CHECKED, n, 1).getValues();
      ringkasan.ditolakHarga = 0;
      kolomSku.forEach(function (r, i) {
        var h = hasilPerSku[String(r[0] || '').trim()];
        if (!h) return;
        kolomCek[i][0] = h.dicekPada;
        // PENGAMAN HARGA: HPP hasil AI >= Harga Jual Default -> TIDAK ditulis (dicatat di log)
        if (h.hppBaru !== null && katPesanHppMelebihiHarga_(String(r[0]).trim(), h.hppBaru, parseFloat(kolomHarga[i][0]) || 0)) {
          ringkasan.ditolakHarga++;
          console.log('autoUpdateHPP_AI: HPP ' + h.hppBaru + ' untuk ' + r[0] + ' ditolak - >= harga jual ' + kolomHarga[i][0]);
          return;
        }
        if (h.hppBaru !== null && h.hppBaru !== Math.round(parseFloat(kolomHpp[i][0]) || 0)) {
          kolomHpp[i][0] = h.hppBaru;
          ringkasan.hppDiupdate++;
        }
      });
      if (ringkasan.hppDiupdate > 0) sh.getRange(2, 4, n, 1).setValues(kolomHpp);
      sh.getRange(2, AUTO_HPP_KOLOM_LAST_CHECKED, n, 1).setValues(kolomCek);
      SpreadsheetApp.flush();
    } finally {
      lepasKunci_(lock);
    }
    if (ringkasan.hppDiupdate > 0) invalidasiCacheKatalogHargaSemuaToko();
    console.log('autoUpdateHPP_AI selesai: ' + JSON.stringify(ringkasan) + ' dari ' + kandidat.length + ' produk ber-URL.');
  } catch (err) {
    console.error('autoUpdateHPP_AI error: ' + JSON.stringify(detailErrorBackend_(err, 'autoUpdateHPP_AI')));
  } finally {
    cache.remove('AUTO_HPP_SEDANG_JALAN');
  }
}

