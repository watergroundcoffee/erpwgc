}

/* ===== Jurnal Transaksi (manual) ===== */
function prosesCatatJurnal(data) {
  var akun, jenis, jumlah;
  return withTransaction(data.email, 'buatInvoice', 'keuangan', function () {
    var result = { success: false };
    var tanggal = data.tanggal ? new Date(data.tanggal) : new Date();
    var kategoriAkun = getKategoriAkun(akun);

    var sh = getJurnalTransaksiSheet();
    sh.appendRow([tanggal, akun, kategoriAkun, jenis, jumlah, data.keterangan || '', 'Manual']);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.',
    validasi: function () {
      akun = String(data.akun || '').trim();
      jenis = String(data.jenis || '').trim(); // 'Masuk' atau 'Keluar'
      jumlah = parseFloat(data.jumlah);
      if (!akun) throw new Error('Akun belum dipilih');
      if (jenis !== 'Masuk' && jenis !== 'Keluar') throw new Error('Jenis transaksi tidak valid');
      if (isNaN(jumlah) || jumlah <= 0) throw new Error('Jumlah tidak valid');
    }
  });
}

function getKategoriAkun(namaAkun) {
  var sh = getBaganAkunSheet();
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return '';
  var vals = sh.getRange(2, 1, lastRow - 1, 2).getValues();
  for (var i = 0; i < vals.length; i++) {
    if (String(vals[i][0]).trim().toLowerCase() === namaAkun.trim().toLowerCase()) return vals[i][1];
  }
  return '';
}

function prosesLihatJurnal(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getJurnalTransaksiSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    var tz = Session.getScriptTimeZone();
    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 7).getValues();
      for (var i = 0; i < vals.length; i++) {
        if (!(vals[i][0] instanceof Date)) continue;
        daftar.push({
          row: i + 2,
          tanggal: Utilities.formatDate(vals[i][0], tz, 'dd MMM yyyy'),
          akun: vals[i][1], kategori: vals[i][2], jenis: vals[i][3], jumlah: vals[i][4],
          keterangan: vals[i][5], sumber: vals[i][6]
        });
      }
    }
    daftar.reverse();
    result.success = true;
    result.daftar = daftar.slice(0, 200);
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ===== Hitung Laporan Laba Rugi (gabungan: Pesanan Manual + Invoice Supplier + Jurnal manual) ===== */
function prosesHitungLabaRugi(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var tglMulai = data.tanggalMulai ? new Date(data.tanggalMulai) : new Date(0);
    var tglAkhir = data.tanggalAkhir ? new Date(data.tanggalAkhir) : new Date();
    tglAkhir.setHours(23, 59, 59, 999); // include seluruh hari terakhir

    var tz = Session.getScriptTimeZone();

    // 1. Pendapatan - dari Pesanan Manual (yang statusnya BUKAN Dibatalkan)
    var sheetsPesanan = getPesananManualSheets();
    var shPesanan = sheetsPesanan.header;
    var lastRowPesanan = shPesanan.getLastRow();
    var totalPendapatan = 0;
    var rincianPendapatan = [];
    if (lastRowPesanan > 1) {
      var valsPesanan = shPesanan.getRange(2, 1, lastRowPesanan - 1, 12).getValues();
      for (var p = 0; p < valsPesanan.length; p++) {
        if (!String(valsPesanan[p][0] || '').trim()) continue;
        if (String(valsPesanan[p][11] || '').trim() === 'Dibatalkan') continue;
        var tglP = valsPesanan[p][1];
        if (!(tglP instanceof Date) || tglP < tglMulai || tglP > tglAkhir) continue;
        totalPendapatan += parseFloat(valsPesanan[p][9]) || 0;
      }
    }
    rincianPendapatan.push({ akun: 'Pendapatan Penjualan', jumlah: totalPendapatan, sumber: 'Otomatis dari Pesanan Manual' });

    // 2. HPP - dari Invoice Supplier
    var sheetsInvoice = getInvoiceSupplierSheets();
    var shInvoice = sheetsInvoice.header;
    var lastRowInvoice = shInvoice.getLastRow();
    var totalHpp = 0;
    if (lastRowInvoice > 1) {
      var valsInvoice = shInvoice.getRange(2, 1, lastRowInvoice - 1, 5).getValues();
      for (var v = 0; v < valsInvoice.length; v++) {
        if (!String(valsInvoice[v][0] || '').trim()) continue;
        var tglV = valsInvoice[v][1];
        if (!(tglV instanceof Date) || tglV < tglMulai || tglV > tglAkhir) continue;
        totalHpp += parseFloat(valsInvoice[v][4]) || 0;
      }
    }

    // 3. Jurnal manual (kategori Pendapatan/Beban tambahan di luar yang otomatis)
    var shJurnal = getJurnalTransaksiSheet();
    var lastRowJurnal = shJurnal.getLastRow();
    var rincianBebanManual = {}; // { namaAkun: total }
    var rincianPendapatanManual = {};
    if (lastRowJurnal > 1) {
      var valsJurnal = shJurnal.getRange(2, 1, lastRowJurnal - 1, 5).getValues();
      for (var j = 0; j < valsJurnal.length; j++) {
        var tglJ = valsJurnal[j][0];
        if (!(tglJ instanceof Date) || tglJ < tglMulai || tglJ > tglAkhir) continue;
        var akunJ = String(valsJurnal[j][1] || '').trim();
        var kategoriJ = String(valsJurnal[j][2] || '').trim();
        var jenisJ = String(valsJurnal[j][3] || '').trim();
        var jumlahJ = parseFloat(valsJurnal[j][4]) || 0;
        if (jenisJ !== 'Masuk') continue; // cuma yang jenis "Masuk" (transaksi tercatat) yang dihitung ke laporan

        if (kategoriJ === 'Beban') {
          rincianBebanManual[akunJ] = (rincianBebanManual[akunJ] || 0) + jumlahJ;
        } else if (kategoriJ === 'Pendapatan') {
          rincianPendapatanManual[akunJ] = (rincianPendapatanManual[akunJ] || 0) + jumlahJ;
        }
      }
    }

    var totalBebanManual = 0;
    var rincianBeban = [];
    Object.keys(rincianBebanManual).forEach(function (akun) {
      rincianBeban.push({ akun: akun, jumlah: rincianBebanManual[akun] });
      totalBebanManual += rincianBebanManual[akun];
    });
    Object.keys(rincianPendapatanManual).forEach(function (akun) {
      rincianPendapatan.push({ akun: akun, jumlah: rincianPendapatanManual[akun], sumber: 'Jurnal manual' });
      totalPendapatan += rincianPendapatanManual[akun];
    });

    var labaKotor = totalPendapatan - totalHpp;
    var labaBersih = labaKotor - totalBebanManual;

    result.success = true;
    result.periodeMulai = Utilities.formatDate(tglMulai, tz, 'dd MMM yyyy');
    result.periodeAkhir = Utilities.formatDate(tglAkhir, tz, 'dd MMM yyyy');
    result.totalPendapatan = totalPendapatan;
    result.rincianPendapatan = rincianPendapatan;
    result.totalHpp = totalHpp;
    result.labaKotor = labaKotor;
    result.totalBeban = totalBebanManual;
    result.rincianBeban = rincianBeban;
    result.labaBersih = labaBersih;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesTerbitkanLaporan(data) {
