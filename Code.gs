// ===================== SAKELAR SYNC HARGA MARKETPLACE =====================
// 'DRY-RUN' : payload Shopee / TikTok Shop (termasuk listing Tokopedia) disusun lengkap lalu HANYA di-log
//             (Logger + sheet "Log Sync Harga"). Tidak ada harga yang berubah di marketplace.
// 'LIVE'    : UrlFetchApp.fetch SUNGGUHAN ke API Shopee & API TikTok Shop memakai token di Script Properties.
// Satu-satunya tempat mengganti mode. Setelah diganti: Deploy > Manage deployments > New version.
var SYNC_HARGA_MODE = 'LIVE'; // DIAKTIFKAN: harga benar-benar dikirim ke Shopee & TikTok Shop

// PENTING: Ini API Key Gemini buat baca invoice pakai AI. BEDA dari
// GOOGLE_CLIENT_ID di file HTML - yang ini JANGAN PERNAH ditaruh di
// file HTML (yang bisa dilihat siapa aja), taruh di sini aja (Code.gs
// cuma bisa dibuka lewat Apps Script, aman).
// Sekarang diambil dari Script Properties dulu (bisa diisi lewat halaman Pengaturan API Key
// di web app) - kalau belum pernah diisi, fallback ke placeholder ini.
const GEMINI_API_KEY = PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY') || "PASTE_GEMINI_API_KEY_DI_SINI";

// ============================================================
// ⚠️ JALUR DEVELOPER - TIDAK LAGI DI-HARDCODE ⚠️
// Nilainya diambil dari Apps Script > Project Settings > Script Properties, properti
// DEV_EMAIL_TESTING. Kalau properti itu KOSONG / tidak ada -> jalur developer MATI dan semua
// orang (termasuk developer) lewat akses normal (tab Staff + Hak Akses).
// Isi properti hanya selama masa testing, hapus begitu sistem dipakai staff/customer asli.
var DEV_EMAIL_TESTING = String(PropertiesService.getScriptProperties().getProperty('DEV_EMAIL_TESTING') || '').trim();

// Identitas untuk proses SISTEM (trigger otomatis). Bukan backdoor: izinnya hanya berlaku
// di dalam denganIzinSistem_() yang cuma bisa diaktifkan dari kode server, bukan dari browser.
var SISTEM_EMAIL_ = 'sistem@omniai.internal';

// true kalau email = developer terdaftar di Script Properties. Kalau properti kosong,
// fallback ke akses normal: hanya staff aktif ber-role Owner yang dianggap developer.
function isDeveloperEmail_(email) {
  var e = String(email || '').trim();
  if (!e) return false;
  if (DEV_EMAIL_TESTING) return e === DEV_EMAIL_TESTING;
  var staff = getStaffByEmail(e);
  return !!(staff && staff.aktif && String(staff.role || '').trim().toLowerCase() === 'owner');
}

// ⚠️ SEMENTARA - akun bersama "Login Admin Gudang" (tanpa individu per staff), dipakai selagi
// Google Login bermasalah. Sama seperti DEV_EMAIL_TESTING: diambil dari Script Properties
// (properti ADMIN_GUDANG_EMAIL_TESTING). Kosong = tombol Login Admin Gudang MATI.
// Opsional: isi ADMIN_GUDANG_PIN supaya login Admin Gudang wajib memasukkan PIN.
var ADMIN_GUDANG_EMAIL_TESTING = String(PropertiesService.getScriptProperties().getProperty('ADMIN_GUDANG_EMAIL_TESTING') || '').trim();

// ============================================================
// MASTER_API_CONFIG - SATU aplikasi OmniAI (pihak ketiga) untuk SEMUA toko klien.
// Klien tidak pernah mengisi App Key/Secret: mereka cukup login & menyetujui akses di halaman
// resmi Shopee/TikTok (OAuth 2.0), lalu token tokonya tersimpan otomatis lewat doGet().
//
// Nilai RAHASIA sengaja TIDAK ditulis literal di file ini - Code.gs ikut tersalin ke setiap
// versi deployment & bisa dibaca siapa pun yang punya akses edit project. Isi SEKALI oleh
// developer di: Apps Script > Project Settings > Script Properties, dengan nama properti di
// kolom "prop" di bawah. (Jalankan infoSetupMasterApp() dari editor untuk cek & lihat Redirect URI.)
// ============================================================
var MASTER_API_CONFIG = {
  shopee: {
    partnerId:  { prop: 'SHOPEE_PARTNER_ID' },
    partnerKey: { prop: 'SHOPEE_PARTNER_KEY' },
    host: 'https://partner.shopeemobile.com'          // Live (production)
  },
  tiktok: {
    // App Key/Secret/Service ID = aplikasi milik akun DEVELOPER PIHAK KETIGA (App Developer/ISV) di
    // TikTok Shop Partner Center - BUKAN akun "Seller in-house developer" (itu hanya bisa akses toko sendiri).
    appKey:    { prop: 'TIKTOK_APP_KEY' },
    appSecret: { prop: 'TIKTOK_APP_SECRET' },
    serviceId: { prop: 'TIKTOK_SERVICE_ID' },          // WAJIB: Partner Center > App & Service > (app) > Basic Information > Service ID
    region:    { prop: 'TIKTOK_REGION' },              // opsional: 'us' khusus toko Amerika; kosong = global (termasuk Indonesia)
    authHost: 'https://auth.tiktok-shops.com',
    authHostUS: 'https://auth.tiktok-shops.us',
    apiHost: 'https://open-api.tiktokglobalshop.com',
    // Otorisasi SELLER memakai service_id (bukan app_key). Domain per wilayah:
    authorizeUrl: 'https://services.tiktokshop.com/open/authorize',
    authorizeUrlUS: 'https://services.us.tiktokshop.com/open/authorize'
  },
  gemini: {
    apiKey: { prop: 'GEMINI_API_KEY' }
  }
};

function masterConfig_(platform, field) {
  var c = MASTER_API_CONFIG[platform] && MASTER_API_CONFIG[platform][field];
  if (c && typeof c === 'object' && c.prop) return String(PropertiesService.getScriptProperties().getProperty(c.prop) || '').trim();
  return c || '';
}

function masterSiap_(platform) {
  if (platform === 'shopee') return !!(masterConfig_('shopee', 'partnerId') && masterConfig_('shopee', 'partnerKey'));
  if (platform === 'tiktok') return !!(masterConfig_('tiktok', 'appKey') && masterConfig_('tiktok', 'appSecret') && masterConfig_('tiktok', 'serviceId'));
  return false;
}

// Daftar Script Property master yang masih kosong (untuk pesan di dasbor & infoSetupMasterApp)
function masterKurang_(platform) {
  var wajib = platform === 'shopee' ? ['partnerId', 'partnerKey'] : (platform === 'tiktok' ? ['appKey', 'appSecret', 'serviceId'] : []);
  return wajib.filter(function (f) { return !masterConfig_(platform, f); }).map(function (f) { return MASTER_API_CONFIG[platform][f].prop; });
}

function tiktokRegionUS_() { return String(masterConfig_('tiktok', 'region') || '').toLowerCase() === 'us'; }
function tiktokAuthHost_() { return tiktokRegionUS_() ? MASTER_API_CONFIG.tiktok.authHostUS : MASTER_API_CONFIG.tiktok.authHost; }
function tiktokAuthorizeUrl_() { return tiktokRegionUS_() ? MASTER_API_CONFIG.tiktok.authorizeUrlUS : MASTER_API_CONFIG.tiktok.authorizeUrl; }

// Getter lama dipertahankan (dipakai puluhan fungsi sync/harga) - sekarang membaca MASTER_API_CONFIG.
// Nilai 'PASTE_...' tetap dipakai sebagai penanda "belum dikonfigurasi" agar pengecekan lama tetap jalan.
