/* ============ RESI: scan / lihat / hapus ============ */
function getSheetInfo(tipe) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var map = {
    keluar: { name: 'Resi Keluar', resiCol: 1, dateCol: 3 },
    retur: { name: 'Retur & Komplain', resiCol: 1, dateCol: 2 },
    stock: { name: 'Pembelian Stock Masuk', resiCol: 1, dateCol: 2 }
  };
  var info = map[tipe];
  if (!info) throw new Error('Tipe tidak dikenali: ' + tipe);

  var sh = ss.getSheetByName(info.name);
  if (!sh) {
    sh = ss.insertSheet(info.name);
    if (tipe === 'stock') {
      sh.getRange(1, 1, 1, 3).setValues([['No Resi / No PO', 'Tanggal Terima', 'Keterangan']]);
      sh.getRange(1, 1, 1, 3).setFontWeight('bold');
    }
  }
  info.sheet = sh;
  return info;
}

// Batch scan - dipanggil dari UI antrean 3-section (Section 1/2/3). SENGAJA cuma nge-loop
// manggil prosesScan() yang udah ada per item, BUKAN nulis ulang logikanya - biar semua
// perilaku yang udah teruji (deteksi duplikat, resolusi pending, pencocokan retur TikTok,
// potong stock) tetap jalan persis sama, cuma dibungkus jadi 1 panggilan buat banyak resi.
// FIX "sedang sibuk memproses scan lain":
// Dulu tiap resi dalam batch mengambil & melepas kunci sendiri-sendiri, cek izin berulang, dan batch besar
// bisa melewati batas tunggu browser (30 dtk) -> browser MENGULANG batch yang sama (postJson auto-retry)
// sementara batch pertama masih berjalan -> request kedua antre di kunci yang sama lalu gagal "sibuk".
// Sekarang: izin dicek SEKALI, kunci dipegang SEKALI untuk seluruh batch, dan batch dibatasi waktu
// (~20 dtk). Resi yang belum sempat diproses dikembalikan di `belumDiproses` supaya browser mengirimnya
// di batch berikutnya (tidak pernah timeout, tidak pernah dobel).
var SCAN_BATCH_BATAS_MS = 20000;
/* ===== KONTEKS SCAN (percepat scan batch) =====
   Dulu SETIAP resi di batch membaca ulang seluruh kolom No Resi (riwayat penuh), sheet Pola Kurir,
   seluruh header + detail Pesanan Manual, lalu appendRow ledger satu per satu + flush.
   Sekarang dalam 1 batch semuanya dibaca sekali, dan penulisan ledger digabung jadi 1 setValues. */
var SCAN_KTX_ = null;
function scanKtxPetaResi_(sh) {
  var k = SCAN_KTX_;
  if (k && k.petaResi) return k;
  var lr = sh.getLastRow(), peta = {};
  if (lr > 1) sh.getRange(2, 1, lr - 1, 1).getValues().forEach(function (r, i) { var kk = kunciResi_(r[0]); if (kk && !peta[kk]) peta[kk] = i + 2; });
  var hasil = { petaResi: peta, lastRow: lr };
  if (k) { k.petaResi = peta; k.lastRow = lr; return k; }
  return hasil;
}
function scanKtxPoSales_() {
  var k = SCAN_KTX_ || {};
  if (k.po) return k.po;
  var sheets = getPesananManualSheets(), po = { resiKeInvoice: {}, detail: {} };
  var lr = sheets.header.getLastRow();
  if (lr > 1) sheets.header.getRange(2, 1, lr - 1, 11).getValues().forEach(function (r) {
    var inv = String(r[0] || '').trim();
    if (!inv) return;
    pecahResi_(r[10], '').forEach(function (x) { var kk = kunciResi_(x); if (kk && !po.resiKeInvoice[kk]) po.resiKeInvoice[kk] = inv; });
    var kk2 = kunciResi_(r[10]); if (kk2 && !po.resiKeInvoice[kk2]) po.resiKeInvoice[kk2] = inv;
  });
  var lrD = sheets.detail.getLastRow();
  if (lrD > 1) sheets.detail.getRange(2, 1, lrD - 1, 4).getValues().forEach(function (r) {
    var inv = String(r[0] || '').trim();
    if (inv) (po.detail[inv] = po.detail[inv] || []).push([String(r[1] || '').trim(), parseFloat(r[3]) || 0]);
  });
  if (SCAN_KTX_) SCAN_KTX_.po = po;
  return po;
}
// Tulis semua baris resi baru dari 1 batch sekaligus (baris berurutan -> 1x format + 1x setValues)
function scanKtxTulisBaris_(sh) {
  var k = SCAN_KTX_;
  if (!k || !k.barisBaru || !k.barisBaru.length) return;
  var list = k.barisBaru.slice().sort(function (a, b) { return a.row - b.row; });
  var lebar = list.reduce(function (m, x) { return Math.max(m, x.lebar); }, 0);
  var awal = list[0].row, akhir = list[list.length - 1].row;
  var berurutan = akhir - awal + 1 === list.length;
  var nilai = list.map(function (x) { var r = x.nilai.slice(); while (r.length < lebar) r.push(''); return r; });
  if (berurutan) {
    sh.getRange(awal, 1, list.length, 1).setNumberFormat('@'); // No Resi = teks (angka 0 di depan aman)
    sh.getRange(awal, 1, list.length, lebar).setValues(nilai);
  } else {
    list.forEach(function (x, i) { sh.getRange(x.row, 1).setNumberFormat('@'); sh.getRange(x.row, 1, 1, lebar).setValues([nilai[i]]); });
  }
  k.barisBaru = [];
}

function scanKtxTulisLedger_() {
  var k = SCAN_KTX_;
  if (!k || !k.ledger || !k.ledger.length) return;
  var sh = getStockLedgerSheet();
  sh.getRange(sh.getLastRow() + 1, 1, k.ledger.length, 6).setValues(k.ledger);
  k.ledger = [];
}

// ===== AKSI: hitung_menu - jumlah resi hari ini (keluar, retur, stock) dalam SATU request
// (dulu menu mobile mengirim 3 request terpisah, masing-masing cek izin & buka sheet sendiri)
function prosesHitungMenu(data) {
  var result = { success: false };
  try {
    var bolehKeluar = cekIzin(data.email, 'scanResiKeluar'), bolehMasuk = cekIzin(data.email, 'scanResiMasuk');
    result.jumlah = {};
    ['keluar', 'retur', 'stock'].forEach(function (tipe) {
      if ((tipe === 'keluar' && !bolehKeluar) || (tipe !== 'keluar' && !bolehMasuk)) { result.jumlah[tipe] = null; return; }
      try { result.jumlah[tipe] = prosesLihatResiHarian({ email: data.email, tipe: tipe, hanyaHitung: true }).jumlah; } catch (e) { result.jumlah[tipe] = null; }
    });
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesScanBatch(data) {
  var result = { success: false };
  try {
    var daftarNoResi = data.daftarNoResi || [];
    if (daftarNoResi.length === 0) throw new Error('Nggak ada resi yang dikirim.');
    var permKey = data.tipe === 'keluar' ? 'scanResiKeluar' : 'scanResiMasuk';
    if (!cekIzin(data.email, permKey)) throw new Error('Anda tidak punya izin untuk scan jenis ini.');
    var namaStaff = getNamaStaff(data.email);
    var lock = kunciModul_(['pengiriman', 'stok']);
    if (!lock.tryLock(25000)) {
      result.sibuk = true;
      result.error = 'Server masih menyelesaikan proses lain - resi tetap di antrean & dikirim ulang otomatis.';
      return result;
    }
    var mulai = Date.now(), hasil = [], belum = [];
    // Konteks bersama 1 batch: kolom No Resi, pola kurir, peta PO Sales & tulisan ledger dibaca/ditulis SEKALI
    SCAN_KTX_ = { tipe: data.tipe, batch: true };
    try {
      daftarNoResi.forEach(function (noResi) {
        if (Date.now() - mulai > SCAN_BATCH_BATAS_MS) { belum.push(noResi); return; }
        var hasilSatuan = prosesScan({ tipe: data.tipe, noResi: noResi, email: data.email, _izinSudahDicek: true, _namaStaff: namaStaff });
        hasilSatuan.noResi = noResi;
        hasil.push(hasilSatuan);
      });
      try {
        scanKtxTulisBaris_(getSheetInfo(data.tipe).sheet);
      } catch (eTulis) {
        // Penulisan gabungan gagal -> resi yang tertampung dilaporkan GAGAL (tetap bisa dikirim ulang)
        hasil.forEach(function (h) { if (h._tertampung) { h.success = false; h.error = 'Gagal menyimpan: ' + eTulis; } });
        SCAN_KTX_.ledger = [];
      }
      scanKtxTulisLedger_();
      hasil.forEach(function (h) { delete h._tertampung; });
    } finally { SCAN_KTX_ = null; lepasKunci_(lock); }
    result.success = true;
    result.hasil = hasil;
    result.belumDiproses = belum;
    if (data.tipe === 'keluar' && hasil.length) lrTandaiAdaScanKeluar_(); // pelengkap resi jalan lebih cepat
  } catch (err) { result.error = err.toString(); }
  return result;
}

function prosesScan(data) {
  var result = { success: false };
  var email = data.email || '';
  var tipe = data.tipe;
  // Cek izin & nama staff DI LUAR kunci (membaca sheet Staff/Hak Akses) -> kunci dipegang sesingkat mungkin.
  // Dari prosesScanBatch keduanya sudah dicek sekali untuk seluruh batch (_izinSudahDicek).
  var namaStaff = data._namaStaff;
  if (!data._izinSudahDicek) {
    var permKey = tipe === 'keluar' ? 'scanResiKeluar' : 'scanResiMasuk';
    if (!cekIzin(email, permKey)) { result.error = 'Anda tidak punya izin untuk scan jenis ini.'; return result; }
    namaStaff = getNamaStaff(email);
  }
  // Kunci reentrant: dari batch, kunci sudah dipegang batch -> langsung lolos tanpa antre lagi
  var lock = kunciModul_(['pengiriman', 'stok']);
  try {
    lock.waitLock(25000);
  } catch (lockErr) {
    result.error = 'Server masih menyelesaikan proses lain (scan/gudang). Resi belum tersimpan - kirim ulang.';
    result.sibuk = true;
    return result;
  }

  try {

    var noResi = String(data.noResi || '').trim();
    var noResiKey = noResi.toUpperCase();
    if (!noResi) throw new Error('No resi kosong');

    var info = getSheetInfo(tipe);
    var sh = info.sheet;

    var ktx = scanKtxPetaResi_(sh);          // di batch: kolom No Resi dibaca SEKALI untuk semua resi
    var lastRow = ktx.lastRow;
    var kolomKurir0 = tipe === 'keluar' ? 10 : (tipe === 'retur' ? 7 : 5);
    var kolomPendingStatus = tipe === 'keluar' ? 11 : null;

    var rowAda = ktx.petaResi[kunciResi_(noResi)];
    if (rowAda) {
      {
        {
          var rowKetemu = rowAda;

          // Kalau ini Resi Keluar dan statusnya lagi Pending -> scan ini artinya
          // "beneran udah dikirim", jadi selesaikan pending-nya, BUKAN error duplikat
          if (tipe === 'keluar') {
            var statusPendingSekarang = String(sh.getRange(rowKetemu, kolomPendingStatus).getValue() || '').trim();
            if (statusPendingSekarang === 'Pending') {
              var waktuPendingSelesai = new Date();
              sh.getRange(rowKetemu, kolomPendingStatus).setValue('');
              sh.getRange(rowKetemu, 12).setValue('');
              sh.getRange(rowKetemu, 3).setValue(waktuPendingSelesai);
              sh.getRange(rowKetemu, 9).setValue(namaStaff);
              var infoJenisPending = potongStockDariScanResi(noResi, waktuPendingSelesai, namaStaff) || { jenis: 'reguler' };
              result.success = true;
              result.pendingDiselesaikan = true;
              result.jenisPengiriman = infoJenisPending.jenis; // 'kilat' | 'reguler'
              if (infoJenisPending.jenis === 'kilat') { result.noReservasi = infoJenisPending.noReservasi; result.perluProduk = infoJenisPending.perluProduk; }
              result.row = rowKetemu;
              result.kurir = String(sh.getRange(rowKetemu, kolomKurir0).getValue() || '').trim() || deteksiKurir(noResi);
              return result;
            }
          }

          result.duplicate = true;
          throw new Error('Resi sudah discan sebelumnya');
        }
      }
    }

    // Tulis ke baris baru dengan kolom No Resi dipaksa format Plain Text
    // supaya angka 0 di depan (misal resi SiCepat "0012345678") tidak hilang
    var newRow = lastRow + 1;
    if (!(SCAN_KTX_ && SCAN_KTX_.batch)) sh.getRange(newRow, 1).setNumberFormat('@');

    var kolomDicatat = tipe === 'keluar' ? 9 : (tipe === 'retur' ? 6 : 4);
    var kolomKurir = tipe === 'keluar' ? 10 : (tipe === 'retur' ? 7 : 5);
    if (!(SCAN_KTX_ && SCAN_KTX_.headerOk)) {
      var hdr = sh.getRange(1, 1, 1, Math.max(kolomDicatat, kolomKurir)).getValues()[0];
      if (!hdr[kolomDicatat - 1]) sh.getRange(1, kolomDicatat).setValue('Dicatat Oleh').setFontWeight('bold');
      if (!hdr[kolomKurir - 1]) sh.getRange(1, kolomKurir).setValue('Kurir').setFontWeight('bold');
      if (SCAN_KTX_) SCAN_KTX_.headerOk = true;
    }

    var waktuScanSekarang = new Date();
    var kurirTerdeteksi = deteksiKurir(noResi);
    // Satu baris utuh (No Resi ... Dicatat Oleh, Kurir). Di batch: ditampung lalu ditulis SEKALI untuk semua resi
    // (dulu 4 panggilan tulis per resi: format, isi, dicatat oleh, kurir).
    var lebarBaris = Math.max(kolomDicatat, kolomKurir, tipe === 'keluar' ? 8 : (tipe === 'retur' ? 5 : 3));
    var barisBaru = [];
    for (var kb = 0; kb < lebarBaris; kb++) barisBaru.push('');
    barisBaru[0] = noResi;
    if (tipe === 'keluar') barisBaru[2] = waktuScanSekarang;
    else if (tipe === 'retur') { barisBaru[1] = waktuScanSekarang; barisBaru[2] = 'Retur (scan)'; }
    else if (tipe === 'stock') barisBaru[1] = waktuScanSekarang;
    barisBaru[kolomDicatat - 1] = namaStaff;
    barisBaru[kolomKurir - 1] = kurirTerdeteksi;
    if (SCAN_KTX_ && SCAN_KTX_.batch) {
      (SCAN_KTX_.barisBaru = SCAN_KTX_.barisBaru || []).push({ row: newRow, nilai: barisBaru, lebar: lebarBaris });
      result._tertampung = true;
    } else {
      sh.getRange(newRow, 1, 1, lebarBaris).setValues([barisBaru]);
    }
    if (tipe === 'keluar') {
      // (baris sudah disiapkan di atas)
    } else if (tipe === 'retur') {
      // Cek juga apakah resi ini cocok sama data Retur TikTok Shop yang udah tersinkron dari API -
      // kalau ketemu, otomatis tandai "Diterima Gudang" di situ, biar nggak perlu dicentang manual lagi.
      try {
        var alasanTT = tandaiReturMarketplaceDiterima_(getReturTikTokSheet(), 'petaReturTikTok', noResi, waktuScanSekarang);
        if (alasanTT !== null) { result.returTikTokCocok = true; result.returTikTokAlasan = alasanTT; }
        else {
          var alasanSP = tandaiReturMarketplaceDiterima_(getReturShopeeSheet(), 'petaReturShopee', noResi, waktuScanSekarang);
          if (alasanSP !== null) { result.returShopeeCocok = true; result.returTikTokCocok = true; result.returTikTokAlasan = alasanSP; }
          else {
            var alasanCN = tandaiReturMarketplaceDiterima_(getReturConnerSheet(), 'petaReturConner', noResi, waktuScanSekarang);
            if (alasanCN !== null) { result.returConnerCocok = true; result.returTikTokCocok = true; result.returTikTokAlasan = alasanCN; }
          }
        }
      } catch (eReturCheck) { /* biar scan tetap sukses walau pengecekan pencocokan ini gagal */ }
    }

    var infoJenis = null;
    if (tipe === 'keluar') {
      infoJenis = potongStockDariScanResi(noResi, waktuScanSekarang, namaStaff) || { jenis: 'reguler' };
    }
    // Catat ke konteks batch supaya resi dobel di batch yang sama langsung terdeteksi
    ktx.petaResi[kunciResi_(noResi)] = newRow;
    ktx.lastRow = newRow;

    result.success = true;
    if (infoJenis) {
      // Deteksi otomatis: pengiriman reguler (pesanan pembeli) vs Pengiriman Kilat (Transfer Gudang Shopee)
      result.jenisPengiriman = infoJenis.jenis;
      if (infoJenis.jenis === 'kilat') { result.noReservasi = infoJenis.noReservasi; result.perluProduk = infoJenis.perluProduk; }
    }
    result.row = newRow;
    result.kurir = kurirTerdeteksi;
  } catch (err) {
    result.error = err.toString();
  } finally {
    lepasKunci_(lock);
  }
  return result;
}

function prosesLihat(data) {
  var result = { success: false };
  try {
    var tipe = data.tipe;
    var permKey = tipe === 'keluar' ? 'scanResiKeluar' : 'scanResiMasuk';
    if (!cekIzin(data.email, permKey)) throw new Error('Anda tidak punya izin untuk melihat data ini.');

    var info = getSheetInfo(tipe);
    var sh = info.sheet;
    var lastRow = sh.getLastRow();
    var kolomKurir = tipe === 'keluar' ? 10 : (tipe === 'retur' ? 7 : 5);

    var items = [];
    var countToday = 0;
    var tz = Session.getScriptTimeZone();
    var todayStr = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
    var daftarPola = muatDaftarPolaPelajari(); // dimuat SEKALI, bukan per-baris
    var kolomPendingStatus = tipe === 'keluar' ? 11 : null;

    if (lastRow > 1) {
      var numRows = lastRow - 1;
      var resiVals = sh.getRange(2, info.resiCol, numRows, 1).getValues();
      var dateVals = sh.getRange(2, info.dateCol, numRows, 1).getValues();
      var kurirVals = sh.getRange(2, kolomKurir, numRows, 1).getValues();
      var pendingVals = kolomPendingStatus ? sh.getRange(2, kolomPendingStatus, numRows, 1).getValues() : null;

      for (var i = 0; i < numRows; i++) {
        var noResi = String(resiVals[i][0] || '').trim();
        if (!noResi) continue;

        // Resi yang statusnya Pending TIDAK ditampilkan di list biasa ini -
        // dia cuma muncul di section "Resi Pending" (lihat prosesLihatPending)
        if (pendingVals && String(pendingVals[i][0] || '').trim() === 'Pending') continue;

        var tgl = dateVals[i][0];
        var tglStr = '';
        var isToday = false;
        if (tgl instanceof Date) {
          tglStr = Utilities.formatDate(tgl, tz, 'dd MMM, HH:mm');
          if (Utilities.formatDate(tgl, tz, 'yyyy-MM-dd') === todayStr) {
            countToday++;
            isToday = true;
          }
        }
        var kurirTersimpan = String(kurirVals[i][0] || '').trim();
        var kurir = kurirTersimpan || deteksiKurirCepat(noResi, daftarPola);
        items.push({ row: i + 2, noResi: noResi, tanggal: tglStr, kurir: kurir, hariIni: isToday });
      }
    }

    items.reverse();
    result.success = true;
    result.items = items.slice(0, 300); // dinaikin dari 50 ke 300 biar cukup buat pagination versi web
    result.countToday = countToday;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ===== Scan Resi v2: daftar resi PER TANGGAL (fix timeout 28 detik) =====
   Log resi ditulis berurutan ke bawah (baris terbaru = paling bawah), jadi:
   1) Kolom tanggal dibaca SEKALI (1 kolom aja), lalu di-loop DARI BAWAH KE ATAS.
   2) Begitu ketemu tanggal yang lebih lama dari tanggal target -> BREAK.
   3) Cuma baris hasil loop itu yang dibaca detailnya & diproses (kurir, jam, invoice, status).
   Pengecualian khusus Resi Keluar: resi "Pending" yang diselesaikan hari ini tanggalnya di-update
   di BARIS LAMA (bukan baris baru), jadi ada 1 sapuan ringan kolom tanggal di atas titik break
   (cuma bandingin angka, tanpa format apa-apa) supaya resi itu nggak hilang dari daftar. */
var RH_KONFIG_SHEET = {
  keluar: { kolomTanggal: 3, kolomKurir: 10, kolomPending: 11, lebar: 11, pakaiInvoice: true },
  retur:  { kolomTanggal: 2, kolomKurir: 7,  kolomPending: null, lebar: 7, pakaiInvoice: true },
  stock:  { kolomTanggal: 2, kolomKurir: 5,  kolomPending: null, lebar: 5, pakaiInvoice: false }
};

function ambilResiPerTanggal(tipe, tanggalStr, hanyaHitung) {
  var konf = RH_KONFIG_SHEET[tipe];
  if (!konf) throw new Error('Tipe tidak dikenali: ' + tipe);

  var tz = Session.getScriptTimeZone();
  var hariIniStr = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  if (!tanggalStr || !/^\d{4}-\d{2}-\d{2}$/.test(String(tanggalStr))) tanggalStr = hariIniStr;
  var awalMs = Utilities.parseDate(tanggalStr + ' 00:00:00', tz, 'yyyy-MM-dd HH:mm:ss').getTime();
  var akhirMs = awalMs + 24 * 60 * 60 * 1000; // WIB nggak ada daylight saving, aman

  var hasil = { tanggal: tanggalStr, hariIni: tanggalStr === hariIniStr, jumlah: 0, items: [] };

  var sh = getSheetInfo(tipe).sheet;
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return hasil;
  var n = lastRow - 1;

  // --- Langkah 1: baca 1 kolom tanggal, reverse loop + break ---
  var tglVals = sh.getRange(2, konf.kolomTanggal, n, 1).getValues();
  var indeks = [];
  var i;
  if (P67_OPSI_) {
    // v2026.10.86 (DN-106): mode "Semua tanggal" / pencarian di seluruh data -> per halaman (offset + limit), terbaru dulu
    var o67 = P67_OPSI_, cari67 = o67.cari ? kunciResi_(o67.cari) : '', resi67 = cari67 ? sh.getRange(2, 1, n, 1).getValues() : null, total67 = 0;
    for (i = n - 1; i >= 0; i--) {
      if (!(tglVals[i][0] instanceof Date)) continue;
      if (cari67 && kunciResi_(resi67[i][0]).indexOf(cari67) < 0) continue;
      total67++;
      if (total67 <= o67.offset || indeks.length >= o67.limit) continue;
      indeks.push(i);
    }
    o67.total += total67; if (total67 > o67.offset + o67.limit) o67.adaLagi = true;
    i = -1;
  } else
  for (i = n - 1; i >= 0; i--) {
    var t = tglVals[i][0];
    if (!(t instanceof Date)) continue;
    var ms = t.getTime();
    if (ms >= akhirMs) continue; // lebih baru dari tanggal target (misal lagi lihat "kemarin")
    if (ms < awalMs) break;      // udah masuk hari sebelumnya -> STOP
    indeks.push(i);
  }

  // --- Langkah 2 (khusus Resi Keluar): sapuan pengaman buat Pending yang diselesaikan ---
  if (konf.kolomPending) {
    for (var j = i - 1; j >= 0; j--) {
      var t2 = tglVals[j][0];
      if (!(t2 instanceof Date)) continue;
      var ms2 = t2.getTime();
      if (ms2 >= awalMs && ms2 < akhirMs) indeks.push(j);
    }
  }
  if (indeks.length === 0) {
    if (!hanyaHitung && !P67_OPSI_) { try { hasil.items = ambilResiDihapusPerTanggal_(tipe, awalMs, akhirMs).map(function (it) { delete it.waktuMs; return it; }); } catch (eA) {} }
    return hasil;
  }

  // --- Langkah 3: baca detail PER KELOMPOK baris yang berdekatan ---
  // FIX LAMBAT: dulu 1 rentang dari baris terkecil s/d terbesar. Kalau ada 1 resi Pending lama yang
  // diselesaikan hari ini (barisnya jauh di atas), rentang itu ikut membaca ribuan baris x 11 kolom yang
  // tidak dipakai. Sekarang baris dikelompokkan: celah > 50 baris = kelompok baru (getValues terpisah).
  var lebar = Math.min(konf.lebar, sh.getMaxColumns());
  var vals = rhBacaBarisBerkelompok_(sh, indeks, lebar, 50);

  var daftarPola = null; // dimuat cuma kalau ada resi yang kurirnya kosong
  var items = [];
  indeks.forEach(function (idx) {
    var row = vals[idx];
    if (!row) return;
    var noResi = String(row[0] || '').trim();
    if (!noResi) return;
    // Resi yang statusnya Pending nggak ditampilkan di daftar biasa (sama seperti prosesLihat)
    if (konf.kolomPending && konf.kolomPending <= lebar && String(row[konf.kolomPending - 1] || '').trim() === 'Pending') return;
    hasil.jumlah++;
    if (hanyaHitung) return;

    var tgl = tglVals[idx][0];
    var kurirTersimpan = konf.kolomKurir <= lebar ? String(row[konf.kolomKurir - 1] || '').trim() : '';
    var kurir = kurirTersimpan;
    if (!kurir) {
      if (daftarPola === null) daftarPola = muatDaftarPolaPelajari();
      kurir = deteksiKurirCepat(noResi, daftarPola);
    }
    items.push({ row: idx + 2, noResi: noResi, waktuMs: tgl.getTime(), jam: Utilities.formatDate(tgl, tz, 'HH:mm:ss'), kurir: kurir, kurirTersimpan: !p10KurirKosong_(kurirTersimpan) });
  });
  if (hanyaHitung) return hasil;

  // Resi yang dihapus (arsip) ikut dikirim sebagai item "dihapus" - TIDAK dihitung di hasil.jumlah
  if (!P67_OPSI_) { try { items = items.concat(ambilResiDihapusPerTanggal_(tipe, awalMs, akhirMs)); } catch (eArsip) { /* arsip opsional */ } }
  items.sort(function (a, b) { return b.waktuMs - a.waktuMs; }); // terbaru di atas

  // --- Langkah 4: cocokkan ke invoice & status pesanan (peta dibangun SEKALI) ---
  if (konf.pakaiInvoice && items.length > 0) {
    // FIX LAMBAT: dulu bangunPetaResiKeSemuaPesanan() dipanggil TIAP buka daftar = membaca SELURUH
    // riwayat 5 sheet pesanan (TikTok, Shopee, Conner, Website, PO Sales) + transfer gudang + tautan.
    // Sekarang pakai peta ringkas yang di-cache (gzip, dipecah) - rebuild paling sering tiap 3 menit.
    var ringkas = petaResiRingkasCache_();
    items.forEach(function (it) {
      var cocok = cariPetaResiRingkas_(ringkas, it.noResi);
      it.noInvoice = cocok ? cocok.noInvoice : null;
      it.sumber = cocok ? cocok.sumber : null;
      it.statusPesanan = cocok ? normalisasiStatusPesanan(cocok.status) : null;
      // v2026.10.23 (DN-071908-352): kurir dari pesanan bila kolom Kurir kosong / Tidak Diketahui; ID Pesanan discan -> resi asli
      if (cocok && cocok.kurir && !it.kurirTersimpan) { it.kurir = cocok.kurir; it.kurirDariPesanan = true; }
      var ra = cocok ? p10ResiAsli_(it.noResi, { noInvoice: cocok.noInvoice, noResi: cocok.noResi }) : '';
      if (ra) it.resiAsli = ra;
    });
    // v2026.10.52 (DN-261021-222527-664): resi RETUR yang bukan resi kirim -> cari di No Resi Pengembalian data retur 3 toko
    if (tipe === 'retur') { try { p34LengkapiItemRetur_(items, ringkas); } catch (eP34) { } }
  }
  items.forEach(function (it) { if (P67_OPSI_ && it.waktuMs) it.tgl = Utilities.formatDate(new Date(it.waktuMs), tz, 'dd MMM yy'); delete it.waktuMs; delete it.kurirTersimpan; });
  hasil.items = items;
  return hasil;
}

// Baca baris-baris (indeks 0-based dari baris 2) per kelompok yang berdekatan.
// Hasil: objek { indeks: arrayBaris } - baris yang tidak diminta tidak ikut dibaca.
function rhBacaBarisBerkelompok_(sh, indeks, lebar, maksCelah) {
  var hasil = {};
  if (!indeks.length) return hasil;
  var urut = indeks.slice().sort(function (a, b) { return a - b; });
  var awal = urut[0], akhir = urut[0];
  function baca(a, b) {
    var blok = sh.getRange(a + 2, 1, b - a + 1, lebar).getValues();
    for (var r = 0; r < blok.length; r++) hasil[a + r] = blok[r];
  }
  for (var i = 1; i < urut.length; i++) {
    if (urut[i] - akhir > maksCelah) { baca(awal, akhir); awal = urut[i]; }
    akhir = urut[i];
  }
  baca(awal, akhir);
  return hasil;
}

/* ===== PETA RESI RINGKAS (cache) - dipakai Daftar Resi harian =====
   Isi: { e: [[noInvoice, sumber, status], ...], k: { kunciResi: indeksEntri } }
   Entri dipakai bersama (1 pesanan bisa punya beberapa kunci: No Pesanan + tiap resi) supaya kecil.
   Disimpan lewat cacheBesarPut_ (gzip + dipecah) selama PETA_RESI_RINGKAS_DETIK. */
var PETA_RESI_RINGKAS_KUNCI = 'PETA_RESI_RINGKAS_V2'; // v2026.10.23: + kurir & resi asli pesanan
var PETA_RESI_RINGKAS_DETIK = 180;

function petaResiRingkasCache_() {
  var dariCache = cacheBesarGet_(PETA_RESI_RINGKAS_KUNCI);
  if (dariCache && dariCache.e && dariCache.k) return dariCache;
  var peta = bangunPetaResiKeSemuaPesanan();
  var entri = [], kunci = {};
  Object.keys(peta).forEach(function (k) {
    var p = peta[k];
    if (!p) return;
    // Objek entri yang sama (dipakai beberapa kunci) cukup disimpan sekali: tandai dengan indeks sementara
    if (p.__idxRingkas === undefined) {
      p.__idxRingkas = entri.length;
      entri.push([String(p.noInvoice || ''), String(p.sumber || ''), String(p.status || ''), String(p.kurir || ''), String(p.resiTautan || p.noResi || '')]);
    }
    kunci[k] = p.__idxRingkas;
  });
  var ringkas = { e: entri, k: kunci };
  cacheBesarPut_(PETA_RESI_RINGKAS_KUNCI, ringkas, PETA_RESI_RINGKAS_DETIK);
  return ringkas;
}

function cariPetaResiRingkas_(ringkas, noResi) {
  var k = kunciResi_(noResi);
  if (!k || !ringkas || !ringkas.k.hasOwnProperty(k)) return null;
  var e = ringkas.e[ringkas.k[k]];
  return e ? { noInvoice: e[0], sumber: e[1], status: e[2], kurir: e[3] || '', noResi: e[4] || '' } : null;
}

function invalidasiPetaResiRingkas_() {
  try { CacheService.getScriptCache().remove(PETA_RESI_RINGKAS_KUNCI + '__meta'); } catch (e) { /* nggak fatal */ }
}

function prosesLihatResiHarian(data) {
  var result = { success: false };
  try {
    var tipe = data.tipe;
    var permKey = tipe === 'keluar' ? 'scanResiKeluar' : 'scanResiMasuk';
    if (!cekIzin(data.email, permKey)) throw new Error('Anda tidak punya izin untuk melihat data ini.');
    var hasil = ambilResiPerTanggal(tipe, data.tanggal, !!data.hanyaHitung);
    result.success = true;
    result.tanggal = hasil.tanggal;
    result.hariIni = hasil.hariIni;
    result.jumlah = hasil.jumlah;
    result.countToday = hasil.hariIni ? hasil.jumlah : null; // kompatibel sama respons 'lihat' lama
    result.items = hasil.items;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ===== ARSIP RESI DIHAPUS (soft delete yang bisa dipulihkan) =====
   Baris yang dihapus dari sheet resi (Resi Keluar / Retur / Pembelian Stock) disalin utuh ke sheet
   "<nama sheet> - Dihapus" sebelum dihapus. Isi baris disimpan sebagai JSON (tanggal diberi penanda)
   supaya bisa dikembalikan PERSIS seperti semula. Resi di arsip TIDAK ikut dihitung di jumlah harian,
   rekap kurir, tanda terima, maupun potong stock - karena baris aslinya memang sudah tidak ada. */
var ARSIP_RESI_HEADER = ['No Resi', 'Tanggal Scan', 'Kurir', 'Dihapus Pada', 'Dihapus Oleh', 'Baris Asal', 'Data Baris (JSON)', 'Status', 'Dipulihkan Pada', 'Dipulihkan Oleh'];

function getArsipResiSheet_(tipe) {
  var info = getSheetInfo(tipe);
  var nama = info.name + ' - Dihapus';
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(nama);
  if (!sh) {
    sh = ss.insertSheet(nama);
    sh.getRange(1, 1, 1, ARSIP_RESI_HEADER.length).setValues([ARSIP_RESI_HEADER]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange('A:A').setNumberFormat('@');
  }
  return sh;
}

function arsipkanResiDihapus_(tipe, sh, row, email, alasan) {
  try {
    var konf = RH_KONFIG_SHEET[tipe] || {};
    var lebar = Math.max(sh.getLastColumn(), 1);
    var nilai = sh.getRange(row, 1, 1, lebar).getValues()[0];
    var dataJson = JSON.stringify(nilai.map(function (v) { return v instanceof Date ? { __tgl: v.getTime() } : v; }));
    var tgl = konf.kolomTanggal ? nilai[konf.kolomTanggal - 1] : '';
    var kurir = konf.kolomKurir ? String(nilai[konf.kolomKurir - 1] || '').trim() : '';
    var sekarang = new Date();
    var shA = getArsipResiSheet_(tipe);
    var baris = shA.getLastRow() + 1;
    shA.getRange(baris, 1).setNumberFormat('@');
    shA.getRange(baris, 1, 1, 8).setValues([[String(nilai[0] || '').trim(), tgl instanceof Date ? tgl : '', kurir, sekarang,
      getNamaStaff(email) || email || '', row, dataJson, 'Dihapus']]);
    // v2026.10.15: alasan hapus (tab Menggantung) di kolom 11 - sesudah 'Dipulihkan Pada' & 'Dipulihkan Oleh'
    if (alasan) {
      var kolAlasan = ARSIP_RESI_HEADER.length + 1;
      if (!String(shA.getRange(1, kolAlasan).getValue() || '').trim()) shA.getRange(1, kolAlasan).setValue('Alasan Hapus').setFontWeight('bold');
      shA.getRange(baris, kolAlasan).setValue(String(alasan).slice(0, 300));
    }
    return { dihapusPada: Utilities.formatDate(sekarang, Session.getScriptTimeZone(), 'HH:mm') };
  } catch (e) {
    Logger.log('Arsip resi dihapus gagal (penghapusan tetap jalan): ' + e);
    return null;
  }
}

// Resi di arsip (status masih "Dihapus") dengan tanggal scan di [awalMs, akhirMs)
function ambilResiDihapusPerTanggal_(tipe, awalMs, akhirMs) {
  var hasil = [];
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(getSheetInfo(tipe).name + ' - Dihapus');
  if (!sh) return hasil;
  var lr = sh.getLastRow();
  if (lr < 2) return hasil;
  var tz = Session.getScriptTimeZone();
  var vals = sh.getRange(2, 1, lr - 1, 8).getValues();
  var sudah = {};
  for (var i = vals.length - 1; i >= 0; i--) {
    var r = vals[i];
    if (String(r[7]) !== 'Dihapus' || !(r[1] instanceof Date)) continue;
    var ms = r[1].getTime();
    if (ms < awalMs || ms >= akhirMs) continue;
    var k = String(r[0] || '').trim().toUpperCase();
    if (!k || sudah[k]) continue; // resi yang sama dihapus berkali-kali -> tampil sekali (yang terbaru)
    sudah[k] = true;
    hasil.push({
      arsipRow: i + 2, noResi: String(r[0]).trim(), waktuMs: ms, jam: Utilities.formatDate(r[1], tz, 'HH:mm:ss'),
      kurir: String(r[2] || '').trim() || 'Tidak Diketahui', dihapus: true,
      dihapusPada: r[3] instanceof Date ? Utilities.formatDate(r[3], tz, 'dd MMM HH:mm') : '', dihapusOleh: String(r[4] || '')
    });
  }
  return hasil;
}

// ===== AKSI: pulihkan_resi - kembalikan resi dari arsip ke posisi kronologisnya di sheet asli
function prosesPulihkanResi(data) {
  return withTransaction(data.email, null, 'pengiriman', function () {
    var result = { success: false };
    var tipe = data.tipe;
    var permKey = tipe === 'keluar' ? 'scanResiKeluar' : 'scanResiMasuk';
    if (!cekIzin(data.email, permKey)) throw new Error('Anda tidak punya izin untuk memulihkan data ini.');
    var target = String(data.noResi || '').trim().toUpperCase();
    if (!target) throw new Error('No Resi kosong');
    var konf = RH_KONFIG_SHEET[tipe];
    if (!konf) throw new Error('Tipe tidak dikenali: ' + tipe);

    var shA = getArsipResiSheet_(tipe);
    var lrA = shA.getLastRow();
    var barisArsip = 0, isi = null;
    if (lrA > 1) {
      var va = shA.getRange(2, 1, lrA - 1, 8).getValues();
      var saran = parseInt(data.arsipRow, 10);
      if (saran >= 2 && saran <= lrA && String(va[saran - 2][0]).trim().toUpperCase() === target && String(va[saran - 2][7]) === 'Dihapus') barisArsip = saran;
      for (var i = va.length - 1; !barisArsip && i >= 0; i--) {
        if (String(va[i][0]).trim().toUpperCase() === target && String(va[i][7]) === 'Dihapus') barisArsip = i + 2;
      }
      if (barisArsip) isi = va[barisArsip - 2];
    }
    if (!barisArsip) throw new Error('Resi ' + data.noResi + ' tidak ada di daftar resi dihapus (mungkin sudah dipulihkan).');

    var nilai = JSON.parse(String(isi[6] || '[]')).map(function (v) {
      return (v && typeof v === 'object' && v.__tgl !== undefined) ? new Date(v.__tgl) : v;
    });
    if (!nilai.length) throw new Error('Data baris arsip kosong - tidak bisa dipulihkan.');

    var sh = getSheetInfo(tipe).sheet;
    var lastRow = sh.getLastRow();

    // Cegah dobel: resi ini sudah discan ulang setelah dihapus?
    if (lastRow > 1) {
      var kolResi = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var d = kolResi.length - 1; d >= 0; d--) {
        if (String(kolResi[d][0] || '').trim().toUpperCase() === target) {
          throw new Error('Resi ' + data.noResi + ' sudah ada lagi di sheet (baris ' + (d + 2) + ') - tidak perlu dipulihkan.');
        }
      }
    }

    // Posisi kronologis: sisipkan tepat di bawah baris terakhir yang waktunya <= waktu scan resi ini,
    // supaya pembacaan harian (loop dari bawah + berhenti di hari sebelumnya) tetap benar.
    var tglResi = nilai[konf.kolomTanggal - 1];
    var sisipSetelah = lastRow; // default: paling bawah
    if (tglResi instanceof Date && lastRow > 1) {
      var tglVals = sh.getRange(2, konf.kolomTanggal, lastRow - 1, 1).getValues();
      var msResi = tglResi.getTime();
      sisipSetelah = 1;
      for (var t = tglVals.length - 1; t >= 0; t--) {
        var v = tglVals[t][0];
        if (v instanceof Date && v.getTime() <= msResi) { sisipSetelah = t + 2; break; }
      }
    }
    var barisBaru;
    if (sisipSetelah >= lastRow) {
      barisBaru = lastRow + 1;
    } else {
      sh.insertRowAfter(sisipSetelah);
      barisBaru = sisipSetelah + 1;
    }
    var lebar = Math.min(nilai.length, sh.getMaxColumns());
    sh.getRange(barisBaru, 1).setNumberFormat('@'); // No Resi tetap teks (0 di depan aman)
    sh.getRange(barisBaru, 1, 1, lebar).setValues([nilai.slice(0, lebar)]);

    shA.getRange(barisArsip, 8, 1, 3).setValues([['Dipulihkan', new Date(), getNamaStaff(data.email) || data.email || '']]);
    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();

    result.success = true;
    result.row = barisBaru;
    result.barisDisisipkan = barisBaru <= lastRow; // true = baris di bawahnya bergeser turun 1
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.'
  });
}

function prosesHapus(data) {
  return withTransaction(data.email, null, 'pengiriman', function () {
    var result = { success: false };
    var tipe = data.tipe;
    var permKey = tipe === 'keluar' ? 'scanResiKeluar' : 'scanResiMasuk';
    if (!cekIzin(data.email, permKey)) throw new Error('Anda tidak punya izin untuk menghapus data ini.');

    var row = parseInt(data.row, 10);
    if (!row || row < 2) throw new Error('Baris tidak valid');

    var info = getSheetInfo(tipe);
    var sh = info.sheet;
    var lastRowHapus = sh.getLastRow();

    // Pengaman (opsional, dipakai daftar resi v2): kalau noResi ikut dikirim, pastikan baris yang
    // dihapus BENAR resi itu. Kalau barisnya udah geser (ada resi lain dihapus/ditambah duluan),
    // cari ulang posisinya dari bawah - biar nggak pernah salah hapus resi orang lain.
    if (data.noResi) {
      var targetResi = String(data.noResi).trim().toUpperCase();
      var nilaiDiBaris = row <= lastRowHapus ? String(sh.getRange(row, 1).getValue() || '').trim().toUpperCase() : '';
      if (nilaiDiBaris !== targetResi) {
        row = 0;
        if (lastRowHapus > 1) {
          var semuaResi = sh.getRange(2, 1, lastRowHapus - 1, 1).getValues();
          for (var k = semuaResi.length - 1; k >= 0; k--) {
            if (String(semuaResi[k][0] || '').trim().toUpperCase() === targetResi) { row = k + 2; break; }
          }
        }
        if (!row) throw new Error('Resi ' + data.noResi + ' sudah nggak ada di sheet (mungkin sudah dihapus sebelumnya)');
      }
    }

    if (row > lastRowHapus) throw new Error('Baris sudah tidak ada (mungkin sudah dihapus sebelumnya)');

    // Arsipkan dulu isi barisnya (supaya bisa dipulihkan & tampil di filter "Resi dihapus")
    var arsip = arsipkanResiDihapus_(tipe, sh, row, data.email, data.alasan);

    sh.deleteRow(row);
    SpreadsheetApp.flush();
    invalidasiCacheGabunganPesanan();
    result.success = true;
    result.rowTerhapus = row;
    result.dihapusPada = arsip ? arsip.dihapusPada : '';
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.'
  });
}

