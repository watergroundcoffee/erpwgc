    }
    var key = String(p.getProperty('GOOGLE_MAPS_API_KEY') || '').trim();
    if (!key) return { success: true, google: false };
    var j, res;
    if (data.mode === 'cari') {
      res = UrlFetchApp.fetch('https://places.googleapis.com/v1/places:autocomplete', { method: 'post', contentType: 'application/json', headers: { 'X-Goog-Api-Key': key }, payload: JSON.stringify({ input: String(data.q || ''), includedRegionCodes: ['id'], languageCode: 'id', sessionToken: data.sesi || undefined }), muteHttpExceptions: true });
      j = JSON.parse(res.getContentText() || '{}'); if (j.error) throw new Error(j.error.message || 'Google error');
      return { success: true, google: true, saran: (j.suggestions || []).filter(function (s) { return s.placePrediction; }).slice(0, 7).map(function (s) {
        var pp = s.placePrediction, sf = pp.structuredFormat || {};
        return { placeId: pp.placeId, utama: (sf.mainText && sf.mainText.text) || (pp.text && pp.text.text) || '', sub: (sf.secondaryText && sf.secondaryText.text) || '' };
      }) };
    }
    if (data.mode === 'detail') {
      res = UrlFetchApp.fetch('https://places.googleapis.com/v1/places/' + encodeURIComponent(String(data.placeId || '')) + '?languageCode=id' + (data.sesi ? '&sessionToken=' + encodeURIComponent(data.sesi) : ''), { headers: { 'X-Goog-Api-Key': key, 'X-Goog-FieldMask': 'formattedAddress,location,addressComponents,displayName' }, muteHttpExceptions: true });
      j = JSON.parse(res.getContentText() || '{}'); if (j.error) throw new Error(j.error.message || 'Google error');
      var o = p87GeoKomponen_(j.addressComponents, j.location ? { lat: j.location.latitude, lng: j.location.longitude } : null, j.formattedAddress);
      o.nama = j.displayName ? j.displayName.text : '';
