    var urlLangsung = 'https://lh3.googleusercontent.com/d/' + fileId; // format URL yang bisa langsung dipakai di tag <img>

    props.setProperty(keyFileId, fileId);
    props.setProperty(keyUrl, urlLangsung);

    result.success = true;
    result.url = urlLangsung;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

