  finally { try { cache.remove(P90_REKAP_JALAN_); } catch (e1) { } }
  if (hasil && hasil.success) { try { cache.put(P90_REKAP_SELESAI_, String(Date.now()), 21600); } catch (e2) { } }
  try {
    props.setProperty('P90_REKAP_INFO', JSON.stringify({ ms: t0, durasi: Date.now() - t0, ok: !!(hasil && hasil.success), hari: hariMundur || 0,
      error: hasil && !hasil.success ? String(hasil.error || '').slice(0, 300) : '' }));
