/* ---------- AKSI: ai_kirim_pesan { sessionId?, konten, clientMsgId, topik?, segarkanKonteks? } ---------- */
function prosesAiKirimPesan(data) {
  var mulai = Date.now();
  try {
    aiwIzinChat_(data.email);
    var email = aiwEmail_(data.email);
    var pesan = String(data.konten || data.pesan || '').trim();
    if (!pesan) throw new Error('Pesan kosong.');
    if (pesan.length > 4000) pesan = pesan.slice(0, 4000);
    var cache = CacheService.getScriptCache();
    // Anti kirim dobel (klik ganda / retry jaringan): clientMsgId yang sama -> hasil yang sama
    var kunciMsg = data.clientMsgId ? 'AIW_MSG_' + String(data.clientMsgId).slice(0, 60) : '';
    if (kunciMsg) { var lama = aiwJson_(cache.get(kunciMsg), null); if (lama) { lama.duplikat = true; return lama; } }
    var kRate = 'COPILOT_RATE_' + email, n = parseInt(cache.get(kRate) || '0', 10);
    if (n >= 12) throw new Error('Terlalu banyak pesan dalam 1 menit. Tunggu sebentar ya.');
    cache.put(kRate, String(n + 1), 60);
    aiwCekKuotaToken_();
    if (data.segarkanKonteks) { cache.remove(COPILOT_CACHE_KONTEKS_ + '_F'); cache.remove(COPILOT_CACHE_KONTEKS_ + '_S'); }

    // Thread baru BARU dibuat setelah LLM berhasil menjawab -> tidak ada thread kosong bila panggilan gagal
    var sesi = data.sessionId ? aiwCariSesi_(data.sessionId, email) : null;
    var topikBaru = (data.topik && data.topik !== 'umum' && AIW_TOPIK_[data.topik]) ? data.topik : aiwTebakTopik_(pesan);
    var judulKonteks = sesi ? sesi.judul : aiwJudulDari_(pesan), topikKonteks = sesi ? sesi.topik : topikBaru;
    var riwayat = sesi && sesi.jumlahPesan ? aiwRiwayatUntukLLM_(sesi, aiwPesanSesi_(sesi.session_id)) : (sesi ? aiwRiwayatUntukLLM_(sesi, []) : []);
    var bolehKeu = cekIzin(data.email, EKS_IZIN_);
    var hasil = tanyaCopilot(pesan, {
      email: data.email, riwayat: riwayat, bolehKeuangan: bolehKeu,
      halaman: ('AI Agent Workspace - thread "' + judulKonteks + '" (topik ' + topikKonteks + ')').slice(0, 160)
    });
    var pisah = aiwPisahkanAksi_(hasil.teks);
    var kartu = bolehKeu ? pisah.aksi.slice(0, AIW_MAKS_KARTU_).map(aiwBuatKartu_) : [];
    var usage = hasil.usage || { in: 0, out: 0 };
    var durasi = Math.round((Date.now() - mulai) / 100) / 10;
    var info = { model: hasil.model, grounded: !!hasil.grounded, sumber: hasil.sumber || [], durasi: durasi };
    var teksAi = pisah.teks || (kartu.length ? 'Berikut aksi yang aku usulkan:' : '...');

    var out = aiwKunci_(function () {
      if (!sesi) sesi = aiwBuatSesi_(email, pesan, topikBaru);
      var s = aiwBacaSesiRow_(aiwSesiSheet_(), sesi.row); // baca ulang (tab lain bisa menambah pesan selama LLM berpikir)
      if (s.session_id !== sesi.session_id) s = aiwCariSesi_(sesi.session_id, email);
      var now = new Date(), seqU = s.jumlahPesan + 1, seqA = s.jumlahPesan + 2;
      var mU = { message_id: aiwId_('MSG'), session_id: s.session_id, seq: seqU, role: 'user', konten: pesan, cards: [], status: 'selesai', token_in: 0, token_out: 0, dibuat: now, info: {} };
      var mA = { message_id: aiwId_('MSG'), session_id: s.session_id, seq: seqA, role: 'assistant', konten: teksAi.slice(0, 45000), cards: kartu, status: 'selesai', token_in: usage.in || 0, token_out: usage.out || 0, dibuat: now, info: info };
      var sh = aiwMsgSheet_(), r0 = sh.getLastRow() + 1;
      sh.getRange(r0, 1, 2, AIW_MSG_HEADER_.length).setValues([mU, mA].map(function (m) {
        return [m.message_id, m.session_id, m.seq, m.role, m.konten, JSON.stringify(m.cards).slice(0, 45000), m.status, m.token_in, m.token_out, m.dibuat, JSON.stringify(m.info).slice(0, 4000)];
      }));
      s.jumlahPesan = seqA;
      s.tokenTotal += (usage.in || 0) + (usage.out || 0);
      s.model = hasil.model || s.model;
      if (s.judul === 'Chat Baru') s.judul = aiwJudulDari_(pesan);
      aiwTulisSesi_(s);
      return {
        success: true, sesi: aiwSesiPublik_(s), pesan_user: aiwMsgPublik_(mU), pesan_ai: aiwMsgPublik_(mA),
        perluRingkas: (s.jumlahPesan - s.ringkasanSampai) > AIW_JENDELA_PESAN_ + AIW_AMBANG_RINGKAS_,
        token: aiwTokenHariIni_(), durasi: durasi
      };
    });
    copilotLog_(data.email, pesan, hasil.teks, { model: hasil.model, grounded: hasil.grounded, durasi: durasi });
    if (kunciMsg) { try { cache.put(kunciMsg, JSON.stringify(out), 1800); } catch (eC) { } }
    return out;
  } catch (err) { return aiwGagal_(err); }
}

/* ---------- AKSI: ai_sesi_ringkas { sessionId } - dipanggil browser di latar setelah balasan tampil ---------- */
function prosesAiSesiRingkas(data) {
  try {
    aiwIzinChat_(data.email);
    var sesi = aiwCariSesi_(data.sessionId, data.email);
    var batasSeq = sesi.jumlahPesan - AIW_JENDELA_PESAN_;
    if (batasSeq - sesi.ringkasanSampai <= AIW_AMBANG_RINGKAS_) return { success: true, dilewati: true };
    var potong = aiwPesanSesi_(sesi.session_id).filter(function (m) { return m.seq > sesi.ringkasanSampai && m.seq <= batasSeq; });
    if (!potong.length) return { success: true, dilewati: true };
    var teks = potong.map(function (m) {
      var k = (m.cards || []).map(aiwRingkasKartu_).join('\n');
      return (m.role === 'user' ? 'USER: ' : 'AI: ') + m.konten.slice(0, 1500) + (k ? '\n' + k : '');
    }).join('\n\n').slice(0, 30000);
    var sys = 'Kamu merangkum percakapan antara pemilik toko kopi dan asisten ERP OmniAI. ' +
      'Tulis ringkasan gabungan dalam bullet Bahasa Indonesia, maksimal 250 kata. ' +
      'WAJIB pertahankan: keputusan yang diambil, angka penting (harga, HPP, margin, stok, budget), SKU, task_id, campaign_id, status aksi (berhasil/gagal/ditolak), dan preferensi user. ' +
      'Buang basa-basi. Jangan menambah informasi yang tidak ada di percakapan.';
    var r = copilotPanggilLLM_(sys, [{ role: 'user', parts: [{ text: 'RINGKASAN LAMA:\n' + (sesi.ringkasan || '(belum ada)') + '\n\nPESAN YANG HARUS DIGABUNG:\n' + teks + '\n\nTulis ringkasan gabungan yang baru.' }] }], { tanpaSearch: true, agent: 'budi' });
    return aiwKunci_(function () {
      var s = aiwCariSesi_(data.sessionId, data.email);
      if (s.ringkasanSampai >= batasSeq) return { success: true, dilewati: true };
      s.ringkasan = String(r.teks || '').slice(0, 6000);
      s.ringkasanSampai = batasSeq;
      s.tokenTotal += ((r.usage && r.usage.in) || 0) + ((r.usage && r.usage.out) || 0);
      aiwTulisSesi_(s);
      return { success: true, ringkasanSampai: batasSeq };
    });
  } catch (err) { return aiwGagal_(err); }
}

/* ---------- AKSI: ai_kartu_eksekusi { messageId, cardId, paramsOverride? } ---------- */
function aiwSaringOverride_(o) {
  var out = {};
  if (!o || typeof o !== 'object') return out;
  Object.keys(o).forEach(function (k) {
    var tipe = AIW_OVERRIDE_BOLEH_[k];
    if (!tipe) return;
    if (tipe === 'angka') { var v = Number(o[k]); if (isFinite(v)) out[k] = v; }
    else out[k] = String(o[k] || '').slice(0, 40);
  });
  return out;
}
function prosesAiKartuEksekusi(data) {
  try {
    aiwIzinEksekusi_(data.email);
    var email = aiwEmail_(data.email), cardId = String(data.cardId || '').trim();
    // 1) Klaim kartu (di dalam lock): cegah 2 eksekusi bersamaan untuk kartu yang sama
    var klaim = aiwKunci_(function () {
      var m = aiwCariPesan_(data.messageId);
      aiwCariSesi_(m.session_id, email); // pastikan thread milik user ini
      var c = (m.cards || []).filter(function (x) { return x.card_id === cardId; })[0];
      if (!c) throw new Error('Kartu aksi tidak ditemukan.');
      if (c.status === 'SUCCESS' || c.status === 'REJECTED_USER' || c.status === 'EXPIRED' || /^REJECTED/.test(c.status)) return { selesai: true, kartu: c };
      if (c.status === 'RUNNING' && c.mulai && Date.now() - new Date(c.mulai).getTime() < 5 * 60000) throw new Error('Aksi ini sedang dieksekusi - tunggu hasilnya.');
      if (c.status === 'PROPOSED' && Date.now() - new Date(c.dibuat).getTime() > AIW_KARTU_KEDALUWARSA_MS_) {
        c.status = 'EXPIRED'; c.hasil = { status: 'EXPIRED', pesan: 'Usulan lebih dari 24 jam - minta AI menghitung ulang dengan data terbaru.', waktu: new Date().toISOString() };
        aiwTulisKartu_(m);
        return { selesai: true, kartu: c };
      }
      var override = c.status === 'BACA' ? {} : aiwSaringOverride_(data.paramsOverride);
      var params = Object.assign({}, c.params, override);
      if (Object.keys(override).length) c.override = override;
      c.statusSebelum = c.status;
      c.status = 'RUNNING'; c.mulai = new Date().toISOString();
      aiwTulisKartu_(m);
      return { selesai: false, kartu: c, params: params };
    });
    if (klaim.selesai) return { success: klaim.kartu.status === 'SUCCESS', sudahDiproses: true, kartu: klaim.kartu, error: klaim.kartu.status === 'SUCCESS' ? '' : (klaim.kartu.hasil && klaim.kartu.hasil.pesan) || klaim.kartu.status };

    // 2) Eksekusi lewat jalur yang sudah teruji (izin + guardrail + Execution_Logs + memori)
    var c0 = klaim.kartu, hasil;
    try {
      hasil = executeAiAction({ tool_call: 'execute_action', action: c0.action, params: klaim.params, sumber: 'AI', mode: 'manual', actionId: c0.card_id, email: data.email, toko: data.toko });
    } catch (eEks) { hasil = { success: false, status: 'FAILED', pesan: (eEks && eEks.message) || String(eEks) }; }

    // 3) Simpan hasil ke kartu
    var kartuAkhir = aiwKunci_(function () {
      var m = aiwCariPesan_(data.messageId);
      var c = (m.cards || []).filter(function (x) { return x.card_id === cardId; })[0] || c0;
      c.status = hasil.bacaSaja && hasil.status === 'SUCCESS' ? 'SUCCESS' : (hasil.status || 'FAILED');
      c.hasil = {
        status: hasil.status, pesan: String(hasil.pesan || '').slice(0, 3000), target: hasil.target || '', oldValue: hasil.oldValue, newValue: hasil.newValue,
        guardrail: hasil.guardrail || null, bacaSaja: !!hasil.bacaSaja, duplikat: !!hasil.duplikat, waktu: new Date().toISOString(), oleh: email,
        data: hasil.bacaSaja && hasil.data !== undefined && hasil.data !== null ? aiwJson_(aiwPotongJson_(hasil.data, 8000), null) : undefined
      };
      delete c.mulai; delete c.statusSebelum;
      var ada = false;
      m.cards = (m.cards || []).map(function (x) { if (x.card_id === cardId) { ada = true; return c; } return x; });
      if (!ada) m.cards.push(c);
      aiwTulisKartu_(m);
      return c;
    });
    try { CacheService.getScriptCache().remove(AIW_CACHE_TC_); } catch (eC) { }
    return { success: kartuAkhir.status === 'SUCCESS', status: kartuAkhir.status, kartu: kartuAkhir, error: kartuAkhir.status === 'SUCCESS' ? '' : (kartuAkhir.hasil && kartuAkhir.hasil.pesan) || kartuAkhir.status };
  } catch (err) { return aiwGagal_(err); }
}
// Potong data hasil aksi BACA supaya muat di sel (maks n karakter) dan tetap JSON valid
function aiwPotongJson_(obj, n) {
  var s = JSON.stringify(obj);
  if (s.length <= n) return s;
  if (Array.isArray(obj)) {
    var arr = obj.slice();
    while (arr.length && JSON.stringify(arr).length > n) arr.pop();
    return JSON.stringify(arr);
  }
  return JSON.stringify({ terpotong: true, ringkas: s.slice(0, n - 60) });
}

/* ---------- AKSI: ai_kartu_tolak { messageId, cardId, alasan? } ---------- */
