    if (!src.gramPer) throw new Error('Satuan ' + src.nama + ' harus kg / gram supaya bisa dibagi ke kemasan.');
    var gram = prod2Num_(k.gram);
    if (!(gram > 0)) throw new Error('Isi berat per kemasan (gram).');
    var lebih = Math.max(0, prod2Num_(k.lebih));
    var bk = (k.bahanKemasan || []).map(function (x) {
      var b = peta[String(x.sku || '').trim().toUpperCase()];
