function prosesLihatLogOpname(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var filter = smKey(data.sku);
    var batas = Math.min(parseInt(data.limit, 10) || 500, 2000);
    var rows = smBacaSheet(SM_SHEET_LOG_OPNAME, 13);
    var daftar = [];
    for (var i = rows.length - 1; i >= 0 && daftar.length < batas; i--) {
      var r = rows[i];
      if (!r[0]) continue;
      if (filter && smKey(r[4]).indexOf(filter) === -1 && String(r[5] || '').toUpperCase().indexOf(filter) === -1) continue;
      var ms = parseFloat(r[3]) || smMs(r[1]);
      daftar.push({ id: String(r[0]), waktu: smFmt(ms), iso: String(r[2] || ''), sku: String(r[4] || ''), nama: String(r[5] || ''),
        qtyFisik: r[6], qtySistem: r[7], selisih: r[8], catatan: String(r[9] || ''), oleh: String(r[10] || ''), waktuKlik: String(r[11] || '') });
    }
    result.success = true;
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Tanpa SKU  -> jurnal Stock Ledger terbaru (semua jenis, apa adanya).
// Dengan SKU -> KARTU STOK dari mesin: event yang benar-benar dipakai menghitung On Hand + saldo berjalan.
function prosesLihatLogMutasi(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuFilter = String(data.sku || '').trim();
    if (skuFilter) {
      var mesin = smHitungMesinStok({ sku: skuFilter, timeline: true });
      var p = mesin.daftar[0];
      if (!p) throw new Error('SKU "' + skuFilter + '" tidak ditemukan di Master Produk maupun riwayat mutasi.');
      result.success = true;
      result.mode = 'kartu';
      result.kartu = {
        sku: p.sku, nama: p.nama, terdaftar: p.terdaftar, onHand: p.onHand, onReserve: p.onReserve, onOrder: p.onOrder, onAvailable: p.onAvailable,
        opnameTerakhir: p.anchorMs ? smFmt(p.anchorMs) : '', qtyOpname: p.anchorQty, sumberOpname: p.anchorSumber, idOpname: p.anchorId, opnameOtomatis: !!p.anchorOtomatis,
        masuk: p.masuk, keluar: p.keluar, penyesuaian: p.penyesuaian, keluarTanpaScan: p.keluarTanpaScan,
        timeline: (p.timeline || []).slice(-400).reverse()
      };
      return result;
    }
    var jenisFilter = String(data.jenis || '').trim();
    var batas = Math.min(parseInt(data.limit, 10) || 800, 3000);
    var namaMap = {};
    smBacaSheet(namaSheetToko('Master Produk'), 2).forEach(function (r) { namaMap[smKey(r[0])] = String(r[1] || ''); });
    var rows = smBacaSheet(namaSheetToko('Stock Ledger'), 6);
    var daftar = [];
    for (var i = rows.length - 1; i >= 0 && daftar.length < batas; i--) {
      var r = rows[i];
      var jenis = String(r[2] || '').trim();
      if (!r[1] || !jenis) continue;
      if (jenisFilter && jenis !== jenisFilter) continue;
      var tanda = (jenis === 'Masuk') ? 1 : (jenis === 'Opname' ? 0 : -1);
      daftar.push({ waktu: smFmt(smMs(r[0])), sku: String(r[1]), nama: namaMap[smKey(r[1])] || '', jenis: jenis,
        qty: parseFloat(r[3]) || 0, tanda: tanda, ket: String(r[4] || ''), oleh: String(r[5] || '') });
    }
    result.success = true;
    result.mode = 'jurnal';
    result.daftar = daftar;
  } catch (err) { result.error = err.toString(); }
  return result;
}

