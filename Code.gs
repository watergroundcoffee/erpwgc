/* Google Maps (opsional): Places Autocomplete (New) + Place Details + Geocoding */
function p87GeoKomponen_(list, lokasi, alamat) {
  var o = { jalan: '', no: '', kel: '', kec: '', kota: '', prov: '', pos: '', lat: lokasi ? lokasi.lat : null, lng: lokasi ? lokasi.lng : null, alamat: alamat || '' };
