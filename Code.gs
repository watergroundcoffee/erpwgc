// Daftar biaya operasional yang udah diinput, bisa difilter per bulan
function prosesLihatBiayaOperasional(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sh = getJurnalTransaksiSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    var tz = Session.getScriptTimeZone();
    var bulanFilter = data.bulan || ''; // format 'yyyy-MM', kosong = semua

    if (lastRow > 1) {
      var vals = sh.getRange(2, 1, lastRow - 1, 8).getValues();
      vals.forEach(function (row, idx) {
        if (String(row[6] || '').trim() !== 'Biaya Operasional') return;
        var tgl = row[0];
        if (!(tgl instanceof Date)) return;
        var bulanRow = Utilities.formatDate(tgl, tz, 'yyyy-MM');
        if (bulanFilter && bulanRow !== bulanFilter) return;
        daftar.push({
          row: idx + 2, tanggal: Utilities.formatDate(tgl, tz, 'dd MMM yyyy'),
          kategoriBiaya: row[1], jumlah: parseFloat(row[4]) || 0, keterangan: row[5], linkFoto: row[7] || ''
        });
      });
    }
    daftar.reverse();
    var totalBulan = daftar.reduce(function (t, d) { return t + d.jumlah; }, 0);

    result.success = true;
    result.daftar = daftar;
    result.totalBulan = totalBulan;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   BUKU BESAR & NERACA SALDO - fondasi juga buat Neraca & Arus Kas nanti
