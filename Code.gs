// Push stock virtual (fisik + buffer) ke TikTok Shop buat 1 SKU tertentu
function prosesUpdateVirtualStockSatuSku(skuKita, stockFisik) {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty('VIRTUAL_STOCK_AKTIF_TIKTOK') !== 'true') return { success: false, error: 'Virtual Stock belum diaktifkan' };

  // RESOLVER: SKU Gudang -> SKU TikTok/Tokopedia (kolom Produk Master + Katalog, fallback SKU Gudang)
  // -> SEMUA listing (product_id/sku_id) dari sheet "Produk TikTok Shop". Dulu dicari pakai SKU Gudang saja.
  var map = syncKodeTerhubung_(skuKita, ['TikTok Shop', 'Tokopedia']);
  var lokal = syncPetaIdLokal_()['TikTok Shop'] || {}, target = [], ada = {};
  map.kode.forEach(function (k) {
    (lokal[k] || []).forEach(function (id) { var kk = id.productId + '|' + id.skuId; if (ada[kk]) return; ada[kk] = 1; target.push({ kode: k, productId: id.productId, skuId: id.skuId }); });
  });
  if (!target.length) return { success: false, error: 'Mapping TikTok untuk ' + skuKita + ' belum ketemu: kode ' + map.kode.join(', ') + ' tidak ada di sheet "Produk TikTok Shop" (sync produk TikTok dulu / cek SKU Terhubung).' };

  var accessToken = props.getProperty('TIKTOK_ACCESS_TOKEN');
  var shopCipher = props.getProperty('TIKTOK_SHOP_CIPHER');
  if (!accessToken || !shopCipher) return { success: false, error: 'TikTok Shop belum terhubung' };

  var buffer = parseInt(props.getProperty('VIRTUAL_STOCK_BUFFER_TIKTOK') || '100', 10);
  var stockVirtual = Math.max(0, stockFisik) + buffer;
  var sukses = 0, gagal = [];
  target.forEach(function (t) {
    try {
      var path = '/product/202309/products/' + t.productId + '/skus/' + t.skuId + '/stock';
      var bodyString = JSON.stringify({ quantity: stockVirtual });
      var paramsUntukSign = { app_key: getTiktokAppKey(), timestamp: String(Math.floor(Date.now() / 1000)), shop_cipher: shopCipher, version: '202309' };
      var signature = buatSignatureTikTok(path, paramsUntukSign, bodyString);
      var url = 'https://open-api.tiktokglobalshop.com' + path +
        '?app_key=' + encodeURIComponent(getTiktokAppKey()) + '&shop_cipher=' + encodeURIComponent(shopCipher) +
        '&timestamp=' + paramsUntukSign.timestamp + '&version=' + paramsUntukSign.version + '&sign=' + signature;
      var res = fetchHemat(url, { method: 'post', contentType: 'application/json', payload: bodyString, headers: { 'x-tts-access-token': accessToken }, muteHttpExceptions: true });
      var json = {}; try { json = JSON.parse(res.getContentText() || '{}'); } catch (eJ) { }
      // TikTok membalas HTTP 200 walau ditolak -> json.code juga wajib 0
      if (res.getResponseCode() === 200 && (json.code === undefined || json.code === 0)) {
        sukses++;
        Logger.log('Syncing ' + skuKita + ' via Mapped SKU ' + t.kode + ' to TikTok Shop (stok ' + stockVirtual + ', product ' + t.productId + ')');
      } else {
        apiErrCatat_('TikTok Shop', 'product.202309.skus.stock', skuKita + ' via ' + t.kode, { quantity: stockVirtual }, res.getResponseCode(), json, res.getContentText());
        gagal.push(t.kode + ' (product ' + t.productId + '): ' + (json.message || res.getContentText().slice(0, 150)));
      }
    } catch (err) { gagal.push(t.kode + ': ' + err); }
  });
  if (sukses) {
    // Ingat nilai terakhir yang terkirim - update massal berikutnya cuma kirim SKU yang nilainya berubah
    try { if (!gagal.length) CacheService.getScriptCache().put('VS_TT_' + skuKita, String(stockVirtual), 21600); } catch (eC) {}
    return { success: true, stockVirtual: stockVirtual, jumlahListing: target.length, jumlahSukses: sukses, gagal: gagal };
  }
  return { success: false, error: gagal.join('; ') };
}

// Dipanggil dari web - update virtual stock buat 1 SKU spesifik (tombol manual)
function prosesUpdateVirtualStockManual(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var sku = String(data.sku || '').trim();
    if (!sku) throw new Error('SKU kosong');
    var stockData = prosesLihatStock({ email: data.email });
    var produkStock = stockData.success ? stockData.daftar.find(function (d) { return d.sku === sku; }) : null;
    var stockFisik = produkStock ? produkStock.stockSaatIni : 0;

    var hasil = prosesUpdateVirtualStockSatuSku(sku, stockFisik);
    if (!hasil.success) throw new Error(hasil.error);
    result.success = true;
    result.stockFisik = stockFisik;
    result.stockVirtual = hasil.stockVirtual;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Sync SEMUA SKU sekaligus - dipanggil dari tombol "Update Semua Stock ke TikTok"
function prosesUpdateVirtualStockSemua(data) {
  var result = { success: false };
  try {
    if (!data.dariSistem && !cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var emailUntukLihatStock = data.dariSistem ? SISTEM_EMAIL_ : data.email;
    var stockData = data.dariSistem
      ? denganIzinSistem_(function () { return prosesLihatStock({ email: emailUntukLihatStock }); })
      : prosesLihatStock({ email: emailUntukLihatStock });
    if (!stockData.success) throw new Error(stockData.error);

    // FIX KUOTA: dulu SEMUA SKU dikirim ke TikTok tiap 10 menit (1 SKU = 1 panggilan API) walau stoknya
    // nggak berubah. Sekarang dari trigger otomatis cuma SKU yang nilai virtual stock-nya BEDA dari yang
    // terakhir terkirim (nilai terakhir diingat maks 6 jam, jadi tiap SKU tetap disegarkan penuh ~4x sehari).
    // Tombol manual "Update Semua" dari web tetap kirim semua seperti dulu.
    var props = PropertiesService.getScriptProperties();
    var buffer = parseInt(props.getProperty('VIRTUAL_STOCK_BUFFER_TIKTOK') || '100', 10);
    var cache = CacheService.getScriptCache();
    var terakhirTerkirim = {};
    if (data.dariSistem) {
      var kunciVS = stockData.daftar.map(function (d) { return 'VS_TT_' + d.sku; });
      for (var k = 0; k < kunciVS.length; k += 500) {
        var sebagian = cache.getAll(kunciVS.slice(k, k + 500));
        Object.keys(sebagian).forEach(function (key) { terakhirTerkirim[key] = sebagian[key]; });
      }
    }

    var berhasil = 0, gagal = 0, dilewati = 0, gagalDetail = [];
    stockData.daftar.forEach(function (d) {
      if (data.dariSistem) {
        var nilaiBaru = String(Math.max(0, d.stockSaatIni) + buffer);
        if (terakhirTerkirim['VS_TT_' + d.sku] === nilaiBaru) { dilewati++; return; } // nggak berubah - nggak usah kirim
        if (urlFetchSedangDiblokir()) { dilewati++; return; }
      }
      var hasil = prosesUpdateVirtualStockSatuSku(d.sku, d.stockSaatIni);
      if (hasil.success) berhasil++;
      else { gagal++; if (gagalDetail.length < 5) gagalDetail.push(d.sku + ': ' + hasil.error); }
    });

    result.success = true;
    result.dilewatiKarenaSama = dilewati;
    result.berhasil = berhasil;
    result.gagal = gagal;
    result.gagalDetail = gagalDetail;
  } catch (err) { result.error = err.toString(); }
  return result;
}

/* ============================================================
   SINKRONISASI NAMA PRODUK - Master (internal) vs nama di tiap marketplace
   ============================================================ */
function prosesLihatSinkronisasiNamaProduk(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var shMaster = getMasterProdukSheet(data.toko);
    var lastRowMaster = shMaster.getLastRow();
    var daftar = [];
    if (lastRowMaster > 1) {
      var valsMaster = shMaster.getRange(2, 1, lastRowMaster - 1, 2).getValues();
      valsMaster.forEach(function (row) {
        var sku = String(row[0] || '').trim();
        if (!sku) return;
        daftar.push({ sku: sku, namaMaster: String(row[1] || '').trim(), tiktok: null });
      });
    }
    var mapBySku = {};
    daftar.forEach(function (d) { mapBySku[d.sku] = d; });

    var shTiktokProduk = getProdukTikTokShopSheet();
    var lastRowTiktok = shTiktokProduk.getLastRow();
    if (lastRowTiktok > 1) {
      var valsTiktok = shTiktokProduk.getRange(2, 1, lastRowTiktok - 1, 5).getValues();
      valsTiktok.forEach(function (row) {
        var sellerSku = String(row[0] || '').trim();
        if (!sellerSku) return;
        var info = { namaTiktok: row[3], stockTiktok: row[4] };
        if (mapBySku[sellerSku]) {
          mapBySku[sellerSku].tiktok = info;
        } else {
          // Ada produk di TikTok tapi SKU-nya nggak ketemu di Master Produk kita - tetap ditampilkan biar kelihatan perlu dicocokkan
          daftar.push({ sku: sellerSku, namaMaster: null, tiktok: info });
        }
      });
    }

    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============================================================
   LOGO PERUSAHAAN - disimpan sebagai file di Google Drive (Script Properties
   nggak cukup besar buat nyimpen gambar), URL-nya aja yang disimpan di Script Properties.
   ============================================================ */
function getFolderUploadOmniAI() {
  // Simpan ID folder-nya di Script Properties - biar nggak perlu DriveApp.getFoldersByName()
  // (yang butuh izin akses ke SEMUA Drive) tiap kali dipanggil. Cukup drive.file scope.
  var props = PropertiesService.getScriptProperties();
  var idTersimpan = props.getProperty('FOLDER_UPLOAD_ID');
  if (idTersimpan) {
    try { return DriveApp.getFolderById(idTersimpan); } catch (e) { /* folder kehapus manual, bikin baru di bawah */ }
  }
  var folderBaru = DriveApp.createFolder('OmniAI - File Upload');
  props.setProperty('FOLDER_UPLOAD_ID', folderBaru.getId());
  return folderBaru;
}

// Ambil (atau bikin) subfolder di dalam folder utama - biar tiap jenis upload rapi kepisah
function getSubfolderUpload(namaSubfolder) {
  var props = PropertiesService.getScriptProperties();
  var keyProperty = 'SUBFOLDER_ID_' + namaSubfolder.toUpperCase().replace(/[^A-Z0-9]/g, '_');
  var idTersimpan = props.getProperty(keyProperty);
  if (idTersimpan) {
    try { return DriveApp.getFolderById(idTersimpan); } catch (e) { /* folder kehapus manual, bikin baru di bawah */ }
  }
  var subfolderBaru = getFolderUploadOmniAI().createFolder(namaSubfolder);
  props.setProperty(keyProperty, subfolderBaru.getId());
  return subfolderBaru;
}

function prosesUploadLogo(data) {
  var result = { success: false };
  try {
    var staffPeminta = getStaffByEmail(data.email);
    if (!staffPeminta || staffPeminta.role !== 'Owner' || !staffPeminta.aktif) {
      throw new Error('Cuma Owner yang bisa ubah logo.');
    }
    var base64Data = String(data.base64 || '');
    var mimeType = String(data.mimeType || 'image/png');
    if (!base64Data) throw new Error('Tidak ada gambar yang dikirim');
    var toko = data.toko || 'Waterground';
    var keyFileId = toko === 'Conner' ? 'LOGO_DRIVE_FILE_ID_CONNER' : 'LOGO_DRIVE_FILE_ID';
    var keyUrl = toko === 'Conner' ? 'LOGO_URL_CONNER' : 'LOGO_URL';

    var bytes = Utilities.base64Decode(base64Data);
    var blob = Utilities.newBlob(bytes, mimeType, 'logo-' + toko.toLowerCase());

    var props = PropertiesService.getScriptProperties();
    var fileIdLama = props.getProperty(keyFileId);
    if (fileIdLama) {
      try { DriveApp.getFileById(fileIdLama).setTrashed(true); } catch (e) { /* file lama udah nggak ada, lanjut aja */ }
    }

    var file = getSubfolderUpload('Logo').createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
