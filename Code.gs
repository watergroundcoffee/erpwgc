}

function finNonOpsDariAkun_(akun) {
  var a = String(akun || '').trim().toLowerCase();
  var ks = Object.keys(FIN_NONOPS_JENIS);
  for (var i = 0; i < ks.length; i++) if (FIN_NONOPS_JENIS[ks[i]].akunSheet.toLowerCase() === a) return ks[i];
  return '';
}
function finTempoKanal_(peng, kanal) { return FIN_KANAL_MARKETPLACE[kanal] ? peng.tempoMarketplace : peng.tempoLain; }

/* ------------------------------------------------------------
   JURNAL UMUM OTOMATIS
   Menghasilkan semua entri dari tanggal mulai pembukuan s.d. `sampai` (urut kronologis).
   Entri: { t, j (kode jenis), no, ket, ak (kelas arus kas bila menyentuh Kas), l: [[kode, debet, kredit]] }
   Semua nilai dibulatkan ke rupiah SEBELUM disusun sehingga setiap entri pasti seimbang.
   ------------------------------------------------------------ */
function finBangunJurnal_(D, peng, mulai, sampai) {
  var R = {}, E = [], seq = 0;
  function reg(kode, nama, gol, normal, ekstra) {
    if (!R[kode]) { R[kode] = { kode: kode, nama: nama, gol: gol, normal: normal }; if (ekstra) Object.keys(ekstra).forEach(function (k) { R[kode][k] = ekstra[k]; }); }
    return kode;
  }
  Object.keys(FIN_AKUN_TETAP).forEach(function (k) { var a = FIN_AKUN_TETAP[k]; reg(k, a[0], a[1], a[2]); });
  function entri(t, j, ket, ak, baris, ref) {
    var l = [], d = 0, k = 0;
    baris.forEach(function (b) {
      var v = Math.round(finAngka_(b[1]));
      if (!v) return;
      if (v > 0) { l.push([b[0], v, 0]); d += v; } else { l.push([b[0], 0, -v]); k -= v; }
    });
    if (l.length < 2 || d !== k) return null;
    var e = { t: t, j: j, ket: ket, ak: ak || '', l: l, s: seq++ };
    if (ref) e.ref = ref;
    E.push(e);
    return e;
  }
  if (!mulai || !sampai || mulai > sampai) return { entri: [], akun: R, piutangKanal: {}, utangSup: {}, aset: [] };

  // --- Akun dinamis per channel (kode tetap untuk channel standar) ---
  var idxLain = {}, nLain = 0;
  function idxKanal(kn) {
    var i = REKAP_KANAL.indexOf(kn);
    if (i >= 0) return i + 1;
    if (!idxLain[kn]) idxLain[kn] = 50 + (nLain++);
    return idxLain[kn];
  }
  function kodeJual(kn) { return reg(finKodeUrut_('4-1', idxKanal(kn)), 'Penjualan ' + kn, 'pendapatan', 'K', { kanal: kn }); }
  function kodePot(kn) { return reg(finKodeUrut_('6-1', idxKanal(kn)), 'Beban Potongan & Komisi ' + kn, 'bebanJual', 'D', { kanal: kn }); }
  // --- Akun beban per kategori ---
  var kodeBebanCustom = {};
  (function () {
    var custom = {};
    (D.biayaList || []).forEach(function (b) { if (!FIN_KATEGORI_BIAYA.some(function (k) { return k.akun === b.a; })) custom[b.a] = 1; });
    Object.keys(custom).sort().forEach(function (a, i) { kodeBebanCustom[a] = finKodeUrut_('6-2', 50 + i); });
  })();
  function kodeBeban(akun) {
    if (akun === FIN_AKUN_PAJAK_PH) return '9-101'; // pajak penghasilan: di bawah Laba Sebelum Pajak
    var i = -1, urut = FIN_KATEGORI_BIAYA.filter(function (k) { return k.akun !== FIN_AKUN_PAJAK_PH; }); // kode akun lama tidak bergeser
    for (var x = 0; x < urut.length; x++) if (urut[x].akun === akun) { i = x; break; }
    var kode = i >= 0 ? finKodeUrut_('6-2', i + 1) : (kodeBebanCustom[akun] || '6-299');
    return reg(kode, akun, 'beban', 'D');
  }

  var piutangKanal = {}, utangSup = {};
  function tambahPeta(peta, k, v) { peta[k] = (peta[k] || 0) + v; if (Math.abs(peta[k]) < 0.5) delete peta[k]; }
  function tglLabel(t) { return t.slice(8, 10) + '/' + t.slice(5, 7) + '/' + t.slice(0, 4); }

  // 0) Saldo awal pembukuan
  var kasA = Math.round(peng.kasAwal), piuA = Math.round(peng.piutangAwal), perA = Math.round(peng.persediaanAwal), utA = Math.round(peng.utangAwal);
  var modalA = kasA + piuA + perA - utA;
  entri(mulai, 'SA', 'Saldo awal pembukuan (Kas, Piutang, Persediaan, Utang)', '', [['1-101', kasA], ['1-102', piuA], ['1-103', perA], ['2-101', -utA], ['3-101', -modalA]]);
  if (piuA > 0) {
    tambahPeta(piutangKanal, 'Saldo awal', piuA);
    var tPiu = finTambahHari_(mulai, peng.tempoMarketplace || 14);
    if (tPiu <= sampai && entri(tPiu, 'PC', 'Penagihan piutang saldo awal', 'op_pelanggan', [['1-101', piuA], ['1-102', -piuA]])) tambahPeta(piutangKanal, 'Saldo awal', -piuA);
  }
  if (utA > 0) {
    tambahPeta(utangSup, 'Saldo awal', utA);
    var tUt = finTambahHari_(mulai, peng.tempoPembelian || 30);
    if (tUt <= sampai && entri(tUt, 'BY', 'Pelunasan utang saldo awal', 'op_pemasok', [['2-101', utA], ['1-101', -utA]])) tambahPeta(utangSup, 'Saldo awal', -utA);
  }

  // 1) Penjualan per hari per channel (+ potongan marketplace) & pencairan dana
  Object.keys(D.hari).sort().forEach(function (t) {
    if (t < mulai || t > sampai) return;
    var h = D.hari[t];
    Object.keys(h.o).sort().forEach(function (kn) {
      var om = Math.round(h.o[kn][0]), n = h.o[kn][1];
      if (!om) return;
      var tr = D.tarif[FIN_KANAL_TARIF[kn] || kn] || { persen: 0, rupiah: 0 };
      var pot = Math.round(om * tr.persen / 100 + n * tr.rupiah), net = om - pot;
      var L = finTempoKanal_(peng, kn);
      var kodeTerima = L > 0 ? '1-102' : '1-101';
      var e = entri(t, 'PJ', 'Penjualan ' + kn + ' · ' + Number(n).toLocaleString('id-ID') + ' pesanan' + (pot ? ' (dipotong komisi/biaya ' + kn + ')' : ''),
        L > 0 ? '' : 'op_pelanggan', [[kodeTerima, net], [kodePot(kn), pot], [kodeJual(kn), -om]]);
      if (!e || !(L > 0)) return;
      tambahPeta(piutangKanal, kn, net);
      var tc = finTambahHari_(t, L);
      if (tc <= sampai && entri(tc, 'PC', 'Pencairan dana ' + kn + ' atas penjualan ' + tglLabel(t), 'op_pelanggan', [['1-101', net], ['1-102', -net]])) tambahPeta(piutangKanal, kn, -net);
    });
    // 2) HPP & kerugian persediaan per hari
    var balikHpp = Math.round(h.hb || 0), hpp = Math.round(h.h) + balikHpp, rsk = Math.round(h.r);
    if (hpp) entri(t, 'HP', 'Harga pokok barang terjual hari ini (Σ qty terjual per SKU × harga modal SKU)', '', [['5-101', hpp], ['1-103', -hpp]]);
    // v2026.10.25 (Paket 12): barang retur yang kembali ke stok -> HPP-nya dibalik (Dr Persediaan, Cr HPP)
    if (balikHpp) entri(t, 'HP', 'Pembalikan HPP: barang retur / batal kembali masuk stok (diterima baik)', '', [['1-103', balikHpp], ['5-101', -balikHpp]]);
    if (rsk) entri(t, 'RS', 'Barang rusak/hilang (Stock Ledger)', '', [['6-301', rsk], ['1-103', -rsk]]);
  });

  // 3) Pembelian persediaan per invoice (+ pelunasan sesuai tempo)
  var Lb = peng.tempoPembelian;
  (D.beliList || []).forEach(function (b) {
    if (b.t < mulai || b.t > sampai) return;
    var v = Math.round(b.v); if (!v) return;
    var ket = 'Pembelian ' + b.inv + ' · ' + b.sup;
    if (Lb > 0) {
      if (!entri(b.t, 'PB', ket + ' (tempo ' + Lb + ' hari)', '', [['1-103', v], ['2-101', -v]], b.inv)) return;
      tambahPeta(utangSup, b.sup, v);
      var tb = finTambahHari_(b.t, Lb);
      if (tb <= sampai && entri(tb, 'BY', 'Bayar utang ' + b.inv + ' · ' + b.sup, 'op_pemasok', [['2-101', v], ['1-101', -v]], b.inv)) tambahPeta(utangSup, b.sup, -v);
    } else {
      entri(b.t, 'PB', ket + ' (tunai)', 'op_pemasok', [['1-103', v], ['1-101', -v]], b.inv);
    }
  });

  // 3b) Pesanan PO: penjualan (kas bila sudah dibayar, piutang bila belum) + HPP dari nota pembelian
  (D.poList || []).forEach(function (o) {
    if (o.t < mulai || o.t > sampai) return;
    var jual = Math.round(o.jual), hpp = Math.round(o.hpp), lunas = o.bayar && o.bayar <= o.t;
    var kJ = kodeJual(PO_KANAL);
    if (jual && entri(o.t, 'PO', 'Penjualan ' + o.no + ' · ' + o.pembeli + (lunas ? ' (lunas)' : ' (belum dibayar)'), lunas ? 'op_pelanggan' : '', [[lunas ? '1-101' : '1-102', jual], [kJ, -jual]], o.no) && !lunas) {
      tambahPeta(piutangKanal, PO_KANAL, jual);
      if (o.bayar && o.bayar <= sampai && entri(o.bayar, 'PC', 'Pembayaran pembeli ' + o.no + ' · ' + o.pembeli, 'op_pelanggan', [['1-101', jual], ['1-102', -jual]], o.no)) tambahPeta(piutangKanal, PO_KANAL, -jual);
    }
    if (hpp) entri(o.t, 'PO', 'Modal barang ' + o.no + ' (nota pembelian, langsung terjual)', 'op_pemasok', [['5-101', hpp], ['1-101', -hpp]], o.no);
  });

  // 4) Biaya operasional & pendapatan lain
  (D.biayaList || []).forEach(function (b) {
    if (b.t < mulai || b.t > sampai) return;
    var info = finInfoKategori_(b.a), akKas = b.a === FIN_AKUN_PAJAK_PH ? 'op_pajak' : 'op_beban';
    if (b.rb) {
      // REIMBURSE: beban diakui hari ini, tapi yang bertambah UTANG perusahaan ke penalang (bukan Kas berkurang)
      entri(b.t, 'BO', info.label + (b.ket ? ' · ' + b.ket : '') + ' (ditalangi ' + b.rb + ')', '', [[kodeBeban(b.a), b.v], ['2-102', -b.v]]);
      if (b.rbt && b.rbt >= b.t && b.rbt >= mulai && b.rbt <= sampai) {
        entri(b.rbt, 'RB', 'Pelunasan reimburse ke ' + b.rb + ' · ' + info.label + (b.ket ? ' · ' + b.ket : ''), akKas, [['2-102', b.v], ['1-101', -b.v]]);
      }
      return;
    }
    entri(b.t, 'BO', info.label + (b.ket ? ' · ' + b.ket : ''), akKas, [[kodeBeban(b.a), b.v], ['1-101', -b.v]]);
  });
  (D.lainList || []).forEach(function (b) {
    if (b.t < mulai || b.t > sampai) return;
    // Pendapatan Klaim (Memo Rusak/Kurang diganti uang) -> akun 7-102 sendiri, sisanya 7-101
    var kodePL = b.a === MRK_AKUN_PENDAPATAN_KLAIM ? '7-102' : '7-101';
    entri(b.t, 'PL', (b.a || 'Pendapatan lain') + (b.ket ? ' · ' + b.ket : ''), 'op_lain', [['1-101', b.v], [kodePL, -b.v]]);
  });

  // 5) Transaksi non-operasional + penyusutan aset tetap (garis lurus, dibukukan tiap akhir bulan)
  var aset = [], susutBulan = {};
  (D.nonOps || []).forEach(function (x) {
    if (x.t < mulai || x.t > sampai) return;
    var ket = x.ket ? ' · ' + x.ket : '';
    if (x.j === 'modal') entri(x.t, 'MD', 'Setoran modal pemilik' + ket, 'fin_modal', [['1-101', x.v], ['3-101', -x.v]]);
    else if (x.j === 'prive') entri(x.t, 'PV', 'Pengambilan pribadi pemilik (prive)' + ket, 'fin_prive', [['3-102', x.v], ['1-101', -x.v]]);
    else if (x.j === 'pinjam') entri(x.t, 'PN', 'Penerimaan pinjaman' + ket, 'fin_pinjam', [['1-101', x.v], ['2-201', -x.v]]);
    else if (x.j === 'cicil') entri(x.t, 'CC', 'Pembayaran pokok pinjaman' + ket, 'fin_cicil', [['2-201', x.v], ['1-101', -x.v]]);
    else if (x.j === 'bunga') entri(x.t, 'BG', 'Bunga pinjaman' + ket, 'op_bunga', [['8-101', x.v], ['1-101', -x.v]]);
    else if (x.j === 'aset') {
      if (!entri(x.t, 'AT', 'Pembelian aset tetap' + ket, 'inv_aset', [['1-201', x.v], ['1-101', -x.v]])) return;
      var u = x.u > 0 ? x.u : 48, per = Math.floor(x.v / u), akum = 0;
      var th = +x.t.slice(0, 4), bl = +x.t.slice(5, 7) - 1;
      for (var m = 0; m < u; m++) {
        var ts = finAkhirBulan_(th, bl + m);
        if (ts > sampai) break;
        var nilai = m === u - 1 ? x.v - per * (u - 1) : per;
        susutBulan[ts] = (susutBulan[ts] || 0) + nilai;
        akum += nilai;
      }
      aset.push({ t: x.t, ket: x.ket || 'Aset tetap', nilai: x.v, umur: u, perBulan: per, akumulasi: akum, nilaiBuku: x.v - akum });
    }
  });
  Object.keys(susutBulan).sort().forEach(function (ts) {
    entri(ts, 'SS', 'Penyusutan aset tetap bulan ' + ts.slice(5, 7) + '/' + ts.slice(0, 4) + ' (garis lurus)', '', [['6-302', susutBulan[ts]], ['1-202', -susutBulan[ts]]]);
  });

  // Urutkan kronologis + beri nomor bukti per jenis per hari
  E.sort(function (a, b) { return a.t < b.t ? -1 : a.t > b.t ? 1 : ((FIN_URUT_JURNAL[a.j] - FIN_URUT_JURNAL[b.j]) || (a.s - b.s)); });
  var nomor = {};
  E.forEach(function (e) {
    var kk = e.j + e.t;
    nomor[kk] = (nomor[kk] || 0) + 1;
    e.no = e.j + '-' + e.t.replace(/-/g, '').slice(2) + '-' + ('00' + nomor[kk]).slice(-3);
    delete e.s;
  });
  return { entri: E, akun: R, piutangKanal: piutangKanal, utangSup: utangSup, aset: aset };
}

// Saldo per akun: saldo awal (sebelum `dari`, plus entri Saldo Awal) + mutasi periode. Nilai bertanda (debet - kredit).
function finHitungSaldo_(J, dari, sampai) {
  var S = { awal: {}, d: {}, k: {}, arus: {}, jumlahEntri: 0, totalD: 0, totalK: 0 };
  J.entri.forEach(function (e) {
    if (e.t > sampai) return;
    var buka = e.j === 'SA' || e.t < dari, kas = 0;
    e.l.forEach(function (x) {
      if (buka) S.awal[x[0]] = (S.awal[x[0]] || 0) + x[1] - x[2];
      else { S.d[x[0]] = (S.d[x[0]] || 0) + x[1]; S.k[x[0]] = (S.k[x[0]] || 0) + x[2]; S.totalD += x[1]; S.totalK += x[2]; }
      if (x[0] === '1-101') kas += x[1] - x[2];
    });
    if (!buka) { S.jumlahEntri++; if (e.ak && kas) S.arus[e.ak] = (S.arus[e.ak] || 0) + kas; }
  });
  // Tutup buku otomatis: saldo akun nominal (pendapatan/beban) sebelum periode dipindah ke Laba Ditahan
  var ld = 0;
  Object.keys(S.awal).forEach(function (k) { if (finNominal_(k)) { ld += S.awal[k]; delete S.awal[k]; } });
  if (ld) S.awal['3-201'] = (S.awal['3-201'] || 0) + ld;
  S.akhir = function (k) { return (S.awal[k] || 0) + (S.d[k] || 0) - (S.k[k] || 0); };
  S.mutasi = function (k) { return (S.d[k] || 0) - (S.k[k] || 0); };
  return S;
}

function finSusunLaporan_(D, dari, sampai, peng) {
  var tz = Session.getScriptTimeZone();
  var hariIni = finTglStr_(new Date(), tz);
  var mulai = peng.tanggalMulai || D.tglPertama || dari;
  var dariEfektif = dari < mulai ? mulai : dari;
  var J = finBangunJurnal_(D, peng, mulai, sampai);
  var S = finHitungSaldo_(J, dariEfektif, sampai);
  var kodeUrut = Object.keys(J.akun).sort();
  function kredit(k) { return -S.mutasi(k); } // mutasi periode, positif = sisi kredit
  function debet(k) { return S.mutasi(k); }
  function pilih(awalan) { return kodeUrut.filter(function (k) { return k.indexOf(awalan) === 0; }); }

  // Jumlah pesanan per channel pada periode
  var pesananKanal = {}, totalPesanan = 0;
  Object.keys(D.hari).forEach(function (t) {
    if (t < dariEfektif || t > sampai) return;
    var o = D.hari[t].o;
    Object.keys(o).forEach(function (kn) { if (Math.round(o[kn][0])) { pesananKanal[kn] = (pesananKanal[kn] || 0) + o[kn][1]; totalPesanan += o[kn][1]; } });
  });
  var poPeriode = (D.poList || []).filter(function (o) { return o.t >= dariEfektif && o.t <= sampai; });
  if (poPeriode.length) { pesananKanal[PO_KANAL] = (pesananKanal[PO_KANAL] || 0) + poPeriode.length; totalPesanan += poPeriode.length; }

  // ----- LAPORAN LABA RUGI -----
  var pendapatan = pilih('4-1').map(function (k) { var a = J.akun[k]; return { kode: k, nama: a.nama, kanal: a.kanal, nilai: kredit(k), pesanan: pesananKanal[a.kanal] || 0 }; })
    .filter(function (x) { return x.nilai; }).sort(function (a, b) { return b.nilai - a.nilai; });
  var totalPendapatan = pendapatan.reduce(function (t, x) { return t + x.nilai; }, 0);
  var hpp = debet('5-101');
  var bebanPenjualan = pilih('6-1').map(function (k) { var a = J.akun[k]; return { kode: k, nama: 'Potongan & komisi ' + a.kanal, kanal: a.kanal, nilai: debet(k) }; })
    .filter(function (x) { return x.nilai; }).sort(function (a, b) { return b.nilai - a.nilai; });
  var totalBebanPenjualan = bebanPenjualan.reduce(function (t, x) { return t + x.nilai; }, 0);
  var bebanUmum = pilih('6-2').map(function (k) { var a = J.akun[k], i = finInfoKategori_(a.nama); return { kode: k, akun: a.nama, nama: a.nama, label: i.label, ikon: i.ikon, nilai: debet(k) }; })
    .filter(function (x) { return x.nilai; }).sort(function (a, b) { return b.nilai - a.nilai; });
  var totalBebanUmum = bebanUmum.reduce(function (t, x) { return t + x.nilai; }, 0);
  var rusak = debet('6-301'), susut = debet('6-302');
  var totalBebanUsaha = totalBebanPenjualan + totalBebanUmum + rusak + susut;
  var labaKotor = totalPendapatan - hpp, labaUsaha = labaKotor - totalBebanUsaha;
  var pendLain = kredit('7-101') + kredit('7-102'), bebanLain = debet('8-101') + debet('8-102'); // 8-102 = penyesuaian retur & klaim (v2026.10.119)
  var labaSebelumPajak = labaUsaha + pendLain - bebanLain;
  var bebanPajak = debet('9-101');
  var labaBersih = labaSebelumPajak - bebanPajak;
  var labaRugi = {
    pendapatan: pendapatan, totalPendapatan: totalPendapatan, jumlahPesanan: totalPesanan,
    hpp: hpp, labaKotor: labaKotor,
    bebanPenjualan: bebanPenjualan, totalBebanPenjualan: totalBebanPenjualan,
    bebanUmum: bebanUmum, totalBebanUmum: totalBebanUmum,
    bebanKerugianPersediaan: rusak, bebanPenyusutan: susut,
    totalBebanUsaha: totalBebanUsaha, labaUsaha: labaUsaha,
    pendapatanLain: pendLain, bebanLain: bebanLain, labaSebelumPajak: labaSebelumPajak, bebanPajak: bebanPajak, labaBersih: labaBersih,
    marginKotor: totalPendapatan ? labaKotor / totalPendapatan : 0,
    marginBersih: totalPendapatan ? labaBersih / totalPendapatan : 0,
    estimasiPphFinal: totalPendapatan * 0.005
  };

  // ----- LAPORAN POSISI KEUANGAN (NERACA) -----
  var kas = S.akhir('1-101'), piutang = S.akhir('1-102'), persediaan = S.akhir('1-103');
  var asetTetap = S.akhir('1-201'), akumSusut = -S.akhir('1-202');
  var utangUsaha = -S.akhir('2-101') || 0, utangPinjaman = -S.akhir('2-201') || 0, utangReimburse = -S.akhir('2-102') || 0;
  var modal = -S.akhir('3-101'), prive = S.akhir('3-102'), labaDitahan = -(S.awal['3-201'] || 0);
  var totalAsetLancar = kas + piutang + persediaan, asetTetapBersih = asetTetap - akumSusut;
  var totalAset = totalAsetLancar + asetTetapBersih, totalLiabilitas = utangUsaha + utangReimburse + utangPinjaman;
  var totalEkuitas = modal - prive + labaDitahan + labaBersih;
  var stokFisik = finNilaiStokFisik_(D, peng._segar === true);
  var saranPersediaanAwal = null;
  if (stokFisik.ok) {
    var sdHariIni = finAgregat_(D, mulai, hariIni);
    saranPersediaanAwal = Math.max(0, Math.round(stokFisik.nilai - sdHariIni.beli + sdHariIni.hpp + sdHariIni.rusak));
  }
  var neraca = {
    tanggal: sampai, kas: kas, piutang: piutang, persediaan: persediaan, totalAsetLancar: totalAsetLancar,
    asetTetap: asetTetap, akumulasiPenyusutan: akumSusut, asetTetapBersih: asetTetapBersih, totalAset: totalAset,
    utangUsaha: utangUsaha, utangReimburse: utangReimburse, utangPinjaman: utangPinjaman, totalLiabilitas: totalLiabilitas,
    modal: modal, prive: prive, labaDitahan: labaDitahan, labaBerjalan: labaBersih, totalEkuitas: totalEkuitas,
    totalPasiva: totalLiabilitas + totalEkuitas,
    seimbang: Math.abs(totalAset - (totalLiabilitas + totalEkuitas)) < 1,
    stokFisik: stokFisik.ok ? { nilai: stokFisik.nilai, skuTanpaHarga: stokFisik.skuTanpaHarga, selisih: sampai >= hariIni ? stokFisik.nilai - persediaan : null } : null,
    saranPersediaanAwal: saranPersediaanAwal
  };

  // ----- NERACA SALDO (TRIAL BALANCE) -----
  var nsBaris = [], ns = { awalD: 0, awalK: 0, mutD: 0, mutK: 0, akhirD: 0, akhirK: 0 };
  kodeUrut.forEach(function (k) {
    var a = J.akun[k], aw = S.awal[k] || 0, md = S.d[k] || 0, mk = S.k[k] || 0, ak = S.akhir(k);
    if (!aw && !md && !mk && !FIN_AKUN_INTI[k]) return;
    nsBaris.push({ kode: k, nama: a.nama, gol: a.gol, normal: a.normal, awal: aw, debet: md, kredit: mk, akhir: ak });
    if (aw > 0) ns.awalD += aw; else ns.awalK -= aw;
    ns.mutD += md; ns.mutK += mk;
    if (ak > 0) ns.akhirD += ak; else ns.akhirK -= ak;
  });
  var neracaSaldo = { baris: nsBaris, total: ns, seimbang: Math.abs(ns.akhirD - ns.akhirK) < 1 && Math.abs(ns.mutD - ns.mutK) < 1, jumlahEntri: S.jumlahEntri };

  // ----- LAPORAN ARUS KAS (metode langsung + rekonsiliasi metode tidak langsung) -----
  function grupArus(g) {
    return Object.keys(FIN_ARUS_KAS).filter(function (k) { return FIN_ARUS_KAS[k].grup === g && S.arus[k]; })
      .map(function (k) { return { kode: k, nama: FIN_ARUS_KAS[k].nama, nilai: S.arus[k] }; });
  }
  var op = grupArus('op'), inv = grupArus('inv'), fin = grupArus('fin');
  function jml(a) { return a.reduce(function (t, x) { return t + x.nilai; }, 0); }
  var kasAwalPeriode = S.awal['1-101'] || 0;
  var kasOp = jml(op), kasInv = jml(inv), kasFin = jml(fin);
  var arusKas = {
    kasAwal: kasAwalPeriode, operasi: op, totalOperasi: kasOp, investasi: inv, totalInvestasi: kasInv,
    pendanaan: fin, totalPendanaan: kasFin, kenaikan: kasOp + kasInv + kasFin, kasAkhir: kas,
    cocok: Math.abs(kasAwalPeriode + kasOp + kasInv + kasFin - kas) < 1,
    rekonsiliasi: {
      labaBersih: labaBersih, penyusutan: susut,
      perubahanPiutang: -S.mutasi('1-102'), perubahanPersediaan: -S.mutasi('1-103'), perubahanUtang: -S.mutasi('2-101'),
      perubahanUtangReimburse: -S.mutasi('2-102'),
      kasOperasi: labaBersih + susut - S.mutasi('1-102') - S.mutasi('1-103') - S.mutasi('2-101') - S.mutasi('2-102')
    }
  };

  // ----- LAPORAN PERUBAHAN EKUITAS -----
  var modalAwal = -(S.awal['3-101'] || 0), priveAwal = S.awal['3-102'] || 0;
  var setoran = kredit('3-101'), priveP = debet('3-102');
  var ekuitas = {
    modalAwal: modalAwal - priveAwal, labaAwal: labaDitahan,
    setoran: setoran, prive: priveP, laba: labaBersih,
    modalAkhir: modalAwal - priveAwal + setoran - priveP, labaAkhir: labaDitahan + labaBersih
  };
  ekuitas.totalAwal = ekuitas.modalAwal + ekuitas.labaAwal;
  ekuitas.totalAkhir = ekuitas.modalAkhir + ekuitas.labaAkhir;
  ekuitas.cocok = Math.abs(ekuitas.totalAkhir - totalEkuitas) < 1;

  // ----- Rincian untuk CaLK -----
  var calk = {
    piutang: Object.keys(J.piutangKanal).map(function (k) { return { nama: k, nilai: J.piutangKanal[k] }; }).sort(function (a, b) { return b.nilai - a.nilai; }),
    utang: Object.keys(J.utangSup).map(function (k) { return { nama: k, nilai: J.utangSup[k] }; }).sort(function (a, b) { return b.nilai - a.nilai; }).slice(0, 20),
    aset: J.aset.slice(0, 40),
    tanpaHpp: D.tanpaHpp.length,
    jumlahPembelian: (D.beliList || []).filter(function (b) { return b.t >= dariEfektif && b.t <= sampai; }).length,
    po: { jumlah: poPeriode.length, lengkap: poPeriode.filter(function (o) { return o.lengkap; }).length,
      jual: poPeriode.reduce(function (t, o) { return t + o.jual; }, 0), hpp: poPeriode.reduce(function (t, o) { return t + o.hpp; }, 0) }
  };

  // ----- Tren 6 bulan (dari jurnal yang sama) -----
  var tren = [], bln = {};
  var th = +sampai.slice(0, 4), bl = +sampai.slice(5, 7) - 1;
  for (var i = 5; i >= 0; i--) {
    var dA = new Date(Date.UTC(th, bl - i, 1));
    var kunci = dA.getUTCFullYear() + '-' + ('0' + (dA.getUTCMonth() + 1)).slice(-2);
    bln[kunci] = { bulan: Utilities.formatDate(new Date(dA.getTime() + 12 * 3600000), 'UTC', 'MMM yy'), omzet: 0, laba: 0, biaya: 0 };
    tren.push(bln[kunci]);
  }
  J.entri.forEach(function (e) {
    if (e.j === 'SA') return;
    var b = bln[e.t.slice(0, 7)]; if (!b) return;
    e.l.forEach(function (x) {
      if (!finNominal_(x[0])) return;
      var v = x[1] - x[2];
      b.laba -= v;
      if (x[0].indexOf('4-1') === 0) b.omzet -= v;
      else if (x[0].charAt(0) === '6' || x[0].charAt(0) === '8' || x[0].charAt(0) === '9') b.biaya += v;
    });
  });

  // ----- Peringatan otomatis (bahasa awam) -----
  var peringatan = [];
  if (!totalPendapatan && !Object.keys(D.hari).length) peringatan.push({ jenis: 'info', teks: 'Belum ada data penjualan di rekap. Buka Beranda sekali atau tunggu ±10 menit sampai rekap otomatis selesai dibangun.' });
  if (D.tanpaHpp.length) peringatan.push({ jenis: 'warn', teks: D.tanpaHpp.length + ' produk terjual belum punya harga modal (HPP dihitung Rp 0). Isi lewat Pembelian atau kolom Harga Supplier di Master Produk.', daftar: D.tanpaHpp.slice(0, 8) });
  if (kas < 0) peringatan.push({ jenis: 'warn', teks: 'Kas hasil hitungan minus. Biasanya karena ada uang pribadi yang dipakai untuk belanja. Isi "Kas Awal" di Saldo Awal atau catat "Setoran Modal" di Modal, Aset & Pinjaman.' });
  if (persediaan < 0) peringatan.push({ jenis: 'warn', teks: 'Persediaan buku minus - stok lama sebelum sistem belum tercatat. Klik "Samakan dengan stok fisik" di Saldo Awal.' });
  if (!Object.keys(D.tarif).some(function (k) { return D.tarif[k].persen > 0 || D.tarif[k].rupiah > 0; })) peringatan.push({ jenis: 'info', teks: 'Tarif potongan marketplace masih 0 semua, jadi laba terlihat lebih besar dari aslinya. Atur di Laporan → Potongan Marketplace.' });
  var poKurang = poPeriode.filter(function (o) { return !o.lengkap; });
  if (poKurang.length) peringatan.push({ jenis: 'warn', teks: poKurang.length + ' Pesanan PO di periode ini dokumennya belum lengkap (Invoice Penjualan, Nota Pembelian, Bukti Transfer). Lengkapi di Pembelian → Pesanan PO.', daftar: poKurang.slice(0, 8).map(function (o) { return o.no + ' · ' + o.pembeli; }) });
  if (!neracaSaldo.seimbang || !neraca.seimbang) peringatan.push({ jenis: 'warn', teks: 'Neraca Saldo tidak seimbang - kemungkinan ada data rusak. Hubungi developer.' });

  var agP = finAgregat_(D, dariEfektif, sampai);
  return {
    periode: { dari: dariEfektif, sampai: sampai, dariDiminta: dari, mulaiPembukuan: mulai },
    labaRugi: labaRugi, neraca: neraca, neracaSaldo: neracaSaldo, arusKas: arusKas, ekuitas: ekuitas, calk: calk,
    arusKasRiil: (function () { try { return finArusKasRiil_(dariEfektif, sampai); } catch (eR) { return null; } })(),
    tren: tren, peringatan: peringatan,
    jenisJurnal: FIN_JENIS_JURNAL,
    kpi: {
      omzet: totalPendapatan, hpp: hpp, biayaOperasional: totalBebanUmum + rusak + susut,
      potongan: totalBebanPenjualan, labaBersih: labaBersih, pesanan: totalPesanan,
      marginBersih: labaRugi.marginBersih, pembelian: agP.beli, kas: kas
    },
    info: {
      rekapDiperbarui: D.rekapDiperbarui, dataDibuat: D.dibuat, sumberHpp: D.sumberHpp,
      pengaturan: peng
    }
  };
}

// Daftar transaksi non-operasional (untuk kartu Modal, Aset & Pinjaman) - digabung per grup (cicilan = pokok + bunga)
function finDaftarNonOps_(D) {
  var g = {}, urut = [];
  (D.nonOps || []).forEach(function (x) {
    var it = g[x.g];
    if (!it) {
      it = g[x.g] = { grup: x.g, tanggal: x.t, jenis: x.j === 'bunga' ? 'cicil' : x.j, jumlah: 0, bunga: 0, umur: 0, ket: x.ket, rows: [] };
      urut.push(it);
    }
    if (x.j === 'bunga') it.bunga += x.v; else { it.jumlah += x.v; it.jenis = x.j; if (x.u) it.umur = x.u; if (x.ket) it.ket = x.ket; }
    it.rows.push(x.row);
  });
  urut.forEach(function (it) { var j = FIN_NONOPS_JENIS[it.jenis] || {}; it.label = j.label || it.jenis; it.ikon = j.ikon || '•'; });
  urut.sort(function (a, b) { return a.tanggal < b.tanggal ? 1 : a.tanggal > b.tanggal ? -1 : (b.rows[0] - a.rows[0]); });
  return urut.slice(0, 80);
}

function finRentangDariData_(data) {
  var tz = Session.getScriptTimeZone();
  var hariIni = finTglStr_(new Date(), tz);
  var sampai = finValidTgl_(data.sampai) ? String(data.sampai) : hariIni;
  var dari = finValidTgl_(data.dari) ? String(data.dari) : sampai.slice(0, 8) + '01';
  if (dari > sampai) { var tmp = dari; dari = sampai; sampai = tmp; }
  return { dari: dari, sampai: sampai };
}

// Laporan jadi per periode di-cache 10 menit. Kunci memuat versi data (D.dibuat + D.versi + versi
// laporan + pengaturan) -> begitu ada data baru, kunci otomatis berganti dan laporan dihitung ulang.
function finLaporanJadi_(D, dari, sampai, segar) {
  var peng = finPengaturan_();
  var kunci = 'FIN_LAP_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5,
    [dari, sampai, D.dibuat, D.versi || 0, D.hppSig || '', finLapVersi_(), peng.diperbarui || ''].join('|'))).slice(0, 22);
  if (!segar) { var c = cacheBesarGet_(kunci); if (c && c.success) { c.info = c.info || {}; c.info.dariCache = true; return c; } }
  peng._segar = segar;
  var lap = finSusunLaporan_(D, dari, sampai, peng);
  delete peng._segar;
  lap.success = true;
  lap.kategori = finDaftarKategori_();
  lap.nonOps = finDaftarNonOps_(D);
  lap.jenisNonOps = FIN_NONOPS_JENIS;
  cacheBesarPut_(kunci, lap, 600);
  return lap;
}
function finCatatDibuka_() {
  try {
    var c = CacheService.getScriptCache();
    if (c.get('FIN_DIBUKA_TANDA')) return;
    c.put('FIN_DIBUKA_TANDA', '1', 3600);
    PropertiesService.getScriptProperties().setProperty('FIN_TERAKHIR_DIBUKA', String(Date.now()));
  } catch (e) { }
}
// Dipanaskan oleh trigger rekap 10 menit (jam kerja, hanya kalau Finance dipakai 3 hari terakhir):
// data keuangan & laporan Bulan Ini selalu siap di cache -> Dashboard terbuka instan.
function finPanaskanCache_() {
  try {
    var jam = Number(Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'H'));
    if (jam < 6 || jam > 22) return;
    var dibuka = Number(PropertiesService.getScriptProperties().getProperty('FIN_TERAKHIR_DIBUKA') || 0);
    if (Date.now() - dibuka > 3 * 86400000) return;
    var D = cacheBesarGet_(FIN_CACHE_KUNCI);
    if (!D || !D.hari || !D.jualSku || Date.now() - (D.dibuat || 0) > 25 * 60000) D = finBangunData_(true, true); // bangun ulang maks ±2x/jam (hemat kuota trigger)
    else finTerapkanHpp_(D, false);
    var rg = finRentangDariData_({});
    finLaporanJadi_(D, rg.dari, rg.sampai, false);
  } catch (e) { Logger.log('finPanaskanCache_: ' + e); }
}

// ===== AKSI: lihat_fin_laporan { dari, sampai, segar } =====
function prosesLihatFinLaporan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk melihat laporan keuangan.');
    var rg = finRentangDariData_(data);
    var segar = data.segar === true;
    finCatatDibuka_();
    var D = finBangunData_(segar);
    return finLaporanJadi_(D, rg.dari, rg.sampai, segar);
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: lihat_fin_jurnal { dari, sampai, mode: 'jurnal'|'buku', akun, jenis, cari, hal } =====
function prosesLihatFinJurnal(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk melihat laporan keuangan.');
    var rg = finRentangDariData_(data);
    var D = finBangunData_(false), peng = finPengaturan_();
    var mulai = peng.tanggalMulai || D.tglPertama || rg.dari;
    var dari = rg.dari < mulai ? mulai : rg.dari, sampai = rg.sampai;
    var J = finBangunJurnal_(D, peng, mulai, sampai);
    var hal = Math.max(1, parseInt(data.hal, 10) || 1);
    var namaAkun = function (k) { return J.akun[k] ? J.akun[k].nama : k; };
    result.periode = { dari: dari, sampai: sampai };
    result.akunList = Object.keys(J.akun).sort().map(function (k) { return { kode: k, nama: J.akun[k].nama, normal: J.akun[k].normal }; });
    result.jenisJurnal = FIN_JENIS_JURNAL;

    if (data.mode === 'buku') {
      var kode = J.akun[data.akun] ? String(data.akun) : '1-101';
      var S = finHitungSaldo_(J, dari, sampai);
      var akun = J.akun[kode], tanda = akun.normal === 'K' ? -1 : 1;
      var saldo = (S.awal[kode] || 0) * tanda, baris = [], totD = 0, totK = 0;
      J.entri.forEach(function (e) {
        if (e.j === 'SA' || e.t < dari || e.t > sampai) return;
        var d = 0, k = 0, lawan = [];
        e.l.forEach(function (x) { if (x[0] === kode) { d += x[1]; k += x[2]; } else lawan.push(x[0]); });
        if (!d && !k) return;
        saldo += (d - k) * tanda; totD += d; totK += k;
        baris.push({ t: e.t, no: e.no, j: e.j, ket: e.ket, d: d, k: k, saldo: saldo, lawan: lawan.slice(0, 3).map(namaAkun).join(', ') });
      });
      var per = 150, nHal = Math.max(1, Math.ceil(baris.length / per));
      if (hal > nHal) hal = nHal;
      result.akun = { kode: kode, nama: akun.nama, normal: akun.normal, gol: akun.gol };
      result.saldoAwal = (S.awal[kode] || 0) * tanda;
      result.saldoAkhir = saldo; result.totalDebet = totD; result.totalKredit = totK;
      result.jumlah = baris.length; result.hal = hal; result.nHal = nHal;
      result.baris = baris.slice((hal - 1) * per, hal * per);
      result.saldoSebelumHal = hal > 1 ? baris[(hal - 1) * per - 1].saldo : result.saldoAwal;
    } else {
      var jenis = FIN_JENIS_JURNAL[data.jenis] ? String(data.jenis) : '';
      var cari = String(data.cari || '').trim().toLowerCase().slice(0, 60);
      var daftar = J.entri.filter(function (e) {
        if (e.j === 'SA' || e.t < dari || e.t > sampai) return false;
        if (jenis && e.j !== jenis) return false;
        if (cari && (e.ket + ' ' + e.no).toLowerCase().indexOf(cari) === -1) return false;
        return true;
      });
      var tD = 0, tK = 0;
      daftar.forEach(function (e) { e.l.forEach(function (x) { tD += x[1]; tK += x[2]; }); });
      var perJ = 60, nHalJ = Math.max(1, Math.ceil(daftar.length / perJ));
      if (hal > nHalJ) hal = nHalJ;
      result.entri = daftar.slice((hal - 1) * perJ, hal * perJ).map(function (e) {
        return { t: e.t, no: e.no, j: e.j, ket: e.ket, l: e.l.map(function (x) { return [x[0], namaAkun(x[0]), x[1], x[2]]; }) };
      });
      result.jumlah = daftar.length; result.hal = hal; result.nHal = nHalJ;
      result.totalDebet = tD; result.totalKredit = tK; result.seimbang = Math.abs(tD - tK) < 1;
      result.saldoAwalAda = J.entri.some(function (e) { return e.j === 'SA'; });
    }
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: lihat_fin_biaya { bulan: 'yyyy-MM' } =====
function prosesLihatFinBiaya(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    try { pastikanTriggerIklan_(); } catch (eTr) { } // v2026.10.30: biaya iklan masuk otomatis tiap 3 jam
    var tz = Session.getScriptTimeZone();
    var bulan = /^\d{4}-\d{2}$/.test(String(data.bulan || '')) ? String(data.bulan) : Utilities.formatDate(new Date(), tz, 'yyyy-MM');
    var sh = getJurnalTransaksiSheet(), lr = sh.getLastRow(), daftar = [], perAkun = {};
    var namaRembesSemua = {};
    if (lr > 1) {
      var lebar = Math.min(14, sh.getMaxColumns());
      sh.getRange(2, 1, lr - 1, lebar).getValues().forEach(function (r, i) {
        var d = r[0]; if (!(d instanceof Date)) return;
        var nmR = lebar >= 12 ? finNamaRembes_(r[11]) : '';
        if (nmR) namaRembesSemua[nmR] = Math.max(namaRembesSemua[nmR] || 0, d.getTime());
        if (Utilities.formatDate(d, tz, 'yyyy-MM') !== bulan) return;
        if (String(r[3] || '').trim() !== 'Masuk' || String(r[2] || '').trim() !== 'Beban' || String(r[1] || '').trim() === FIN_AKUN_HPP) return;
        if (String(r[6] || '').trim() === FIN_SUMBER_NONOPS) return; // bunga pinjaman dicatat di Modal, Aset & Pinjaman
        var akun = finAkunNormal_(r[1]), info = finInfoKategori_(akun), jml = finAngka_(r[4]);
        var sumber = String(r[6] || '').trim();
        perAkun[akun] = (perAkun[akun] || 0) + jml;
        daftar.push({
          row: i + 2, tanggal: finTglStr_(d, tz), tanggalLabel: Utilities.formatDate(d, tz, 'dd MMM yyyy'), ms: d.getTime(),
          akun: akun, label: info.label, ikon: info.ikon, jumlah: jml, keterangan: String(r[5] || ''), sumber: sumber || '-',
          dokumen: lebar >= 8 ? String(r[7] || '').split(/\n+/).map(function (u) { return u.trim(); }).filter(function (u) { return u; }) : [],
          noNota: lebar >= 10 ? String(r[9] || '').trim() : '',
          merchant: lebar >= 14 ? String(r[13] || '').trim() : '',
          bisaHapus: !!FIN_SUMBER_BISA_HAPUS[sumber],
          rembesOleh: nmR, statusRembes: nmR ? (String(r[12] || '').trim() || FIN_REMBES_BELUM) : '',
          rembesDibayar: !!nmR && finRembesDibayar_(r[12])
        });
      });
    }
    daftar.sort(function (a, b) { return (b.ms - a.ms) || (b.row - a.row); });
    // Rekap Rembes bulan ini: per nama -> total, sudah dibayar, sisa yang harus dibayar balik
    var perNama = {};
    daftar.forEach(function (x) {
      if (!x.rembesOleh) return;
      var p = perNama[x.rembesOleh] || (perNama[x.rembesOleh] = { nama: x.rembesOleh, total: 0, belum: 0, sudah: 0, jumlahItem: 0, rows: [] });
      p.total += x.jumlah; p.jumlahItem++; p.rows.push(x.row);
      if (x.rembesDibayar) p.sudah += x.jumlah; else p.belum += x.jumlah;
    });
    result.rembes = Object.keys(perNama).map(function (k) { return perNama[k]; }).sort(function (a, b) { return (b.belum - a.belum) || (b.total - a.total); });
    result.namaRembes = Object.keys(namaRembesSemua).sort(function (a, b) { return namaRembesSemua[b] - namaRembesSemua[a]; }).slice(0, 30);
    result.success = true;
    result.bulan = bulan;
    result.daftar = daftar;
    result.total = daftar.reduce(function (t, d) { return t + d.jumlah; }, 0);
    result.perKategori = Object.keys(perAkun).sort(function (a, b) { return perAkun[b] - perAkun[a]; })
      .map(function (k) { var i = finInfoKategori_(k); return { akun: k, label: i.label, ikon: i.ikon, total: perAkun[k] }; });
    result.kategori = finDaftarKategori_();
    result.namaOwner = finNamaOwner_();
    try { result.iklanSync = JSON.parse(PropertiesService.getScriptProperties().getProperty('FIN_IKLAN_SYNC') || 'null'); } catch (eIk) { result.iklanSync = null; }
    result.perluMigrasiCC = !PropertiesService.getScriptProperties().getProperty('FIN_MIGRASI_CC_V1');
  } catch (err) { result.error = err.toString(); }
  return result;
}

// ===== AKSI: fin_catat_biaya { tanggal, akun, jumlah, keterangan, fotoBase64?, fotoMimeType? } =====
function prosesFinCatatBiaya(data) {
  var result = { success: false };
  // Validasi + upload foto DI LUAR lock (upload Drive bisa beberapa detik)
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var akun = data.kategoriBaru ? finAkunNormal_(finAkunDariLabel_(data.kategoriBaru)) : finAkunNormal_(data.akun);
    if (!akun || akun.length < 8) throw new Error('Kategori biaya belum dipilih');
    var dokumen = dokumenBersihkan_(data.dokumen);
    var jumlah = Math.round(finAngka_(data.jumlah));
    if (!(jumlah > 0)) throw new Error('Jumlah biaya harus lebih dari 0');
    if (jumlah > 100000000000) throw new Error('Jumlah terlalu besar - cek lagi angkanya');
    var tanggal = finParseTanggalInput_(data.tanggal);
    if (tanggal.getTime() > Date.now() + 2 * 86400000) throw new Error('Tanggal tidak boleh di masa depan');
    var keterangan = String(data.keterangan || '').trim().slice(0, 300);
    var noNota = finNotaBersih_(data.noNota);
    var merchant = String(data.merchant || '').replace(/\s+/g, ' ').trim().slice(0, 80);
    // VALIDASI WAJIB (anti data terbaca ganda): ID Pembayaran, Nama Merchant & Foto Bukti
    if (!noNota) throw new Error('ID Pembayaran / No Nota wajib diisi');
    if (!merchant) throw new Error('Nama Merchant wajib diisi');
    if (!dokumen.length && !data.fotoBase64) throw new Error('Foto Bukti wajib dilampirkan');
    var rembesOleh = data.rembes ? finNamaRembes_(data.rembesOleh) : '';
    if (data.rembes && !rembesOleh) throw new Error('Isi nama staf yang menalangi biaya ini (Reimburse)');
    if (finAdalahKartuKredit_(akun)) throw new Error('Akun Kartu Kredit sudah dihapus. Pilih jenis biaya aslinya lalu aktifkan "Rembes" (ditalangi CC pribadi Owner).');
    // PPh yang dibayar di Tokopedia selalu memakai CC pribadi -> wajib alur Reimburse ke Owner
    if (!rembesOleh && akun === FIN_AKUN_PAJAK_PH && FIN_POLA_PPH_TOKOPEDIA.test(keterangan + ' ' + noNota)) { rembesOleh = finNamaOwner_(); result.rembesOtomatis = true; }
  } catch (errV) { result.error = errV.toString(); return result; }

  var linkFoto = dokumen.join('\n');
  if (!linkFoto && data.fotoBase64) {
    try {
      var folder = getSubfolderUpload('Struk Biaya Operasional');
      var blob = Utilities.newBlob(Utilities.base64Decode(String(data.fotoBase64)), data.fotoMimeType || 'image/jpeg',
        'struk-' + Utilities.formatDate(tanggal, Session.getScriptTimeZone(), 'yyyyMMdd') + '-' + Date.now() + '.jpg');
      var file = folder.createFile(blob);
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      linkFoto = 'https://lh3.googleusercontent.com/d/' + file.getId();
    } catch (eF) { linkFoto = ''; } // gagal upload foto bukan alasan batal simpan
  }

  var lock = kunciModul_('keuangan');
  try { lock.waitLock(15000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  try {
    // Anti dobel ke-2 (selain idPermintaan): isi yang PERSIS sama dari user yang sama dalam 3 menit
    // dianggap klik ganda -> kembalikan baris yang sudah ada, tidak menulis lagi.
    var cacheDup = CacheService.getScriptCache();
    var sidik = 'FINDUP_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5,
      [String(data.email || '').toLowerCase(), akun, jumlah, finTglStr_(tanggal), keterangan, noNota].join('|')));
    var sudahAda = cacheDup.get(sidik);
    if (sudahAda) {
      var lama = JSON.parse(sudahAda);
      lama.duplikat = true;
      return lama;
    }
    akun = finPastikanAkunBeban_(akun);
    var sh = getJurnalTransaksiSheet();
    // TOLAK OTOMATIS: No Nota + nominal yang sama persis sudah tercatat (nota yang sama tidak mungkin dibayar 2x)
    var notaSama = finCariNotaSama_(sh, noNota, jumlah, 0);
    if (notaSama) return { success: false, ditolakDobel: true, mirip: [notaSama], error: 'Ditolak otomatis: No Nota ' + noNota + ' senilai Rp ' + jumlah.toLocaleString('id-ID') + ' sudah tercatat (' + notaSama.tanggal + ' · ' + notaSama.label + ')' };
    // Deteksi kemungkinan DOBEL (bukan klik ganda): no invoice/nota sama, atau nominal sama di tanggal ±1 hari
    // dengan kategori/keterangan serupa. User diminta konfirmasi; data.tetapSimpan = true untuk melewati.
    if (!data.tetapSimpan) {
      var mirip = finCariBiayaMirip_(sh, akun, jumlah, tanggal, keterangan, noNota);
      if (mirip.length) return { success: false, kemungkinanDobel: true, mirip: mirip, error: 'Kemungkinan biaya ini sudah pernah dicatat' };
    }
    var row = sh.getLastRow() + 1;
    sh.getRange(row, 1, 1, 10).setValues([[tanggal, akun, 'Beban', 'Masuk', jumlah, keterangan, 'Biaya Operasional', linkFoto, '', noNota]]);
    if (rembesOleh) sh.getRange(row, 12, 1, 2).setValues([[rembesOleh, FIN_REMBES_BELUM]]);
    if (!String(sh.getRange(1, 14).getValue() || '').trim()) sh.getRange(1, 14).setValue('Nama Merchant').setFontWeight('bold');
    sh.getRange(row, 14).setValue(merchant);
    SpreadsheetApp.flush();
    finPatchBiaya_(0, { tanggal: tanggal, akun: akun, jumlah: jumlah, ket: keterangan, row: row, rembesOleh: rembesOleh, statusRembes: rembesOleh ? FIN_REMBES_BELUM : '' });
    result.success = true;
    result.row = row;
    result.akun = akun;
    result.linkFoto = linkFoto;
    result.item = finItemBiaya_(row, tanggal, akun, jumlah, keterangan, 'Biaya Operasional', linkFoto, noNota, rembesOleh, rembesOleh ? FIN_REMBES_BELUM : '');
    result.item.merchant = merchant;
    try { cacheDup.put(sidik, JSON.stringify(result), 180); } catch (eC) { }
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

// Token "nomor dokumen" dari keterangan: INV/2026/001, NOTA-123, 8-12 digit angka, dll
function finTokenDokumen_(teks) {
  var t = String(teks || '').toUpperCase(), hasil = [];
  (t.match(/[A-Z0-9][A-Z0-9\/\-\.]{4,}[0-9]/g) || []).forEach(function (x) {
    var bersih = x.replace(/[\/\-\.]/g, '');
    if (/\d/.test(bersih) && bersih.length >= 6 && !/^20\d{2}(0[1-9]|1[0-2])\d{0,2}$/.test(bersih)) hasil.push(bersih);
  });
  return hasil;
}
function finCariBiayaMirip_(sh, akun, jumlah, tanggal, keterangan, noNota) {
  var lr = sh.getLastRow(), tz = Session.getScriptTimeZone(), hasil = [];
  if (lr < 2) return hasil;
  var awal = Math.max(2, lr - 4999); // cek 5.000 baris terakhir
  var token = finTokenDokumen_(keterangan), ketKecil = String(keterangan || '').toLowerCase().replace(/\s+/g, ' ').trim();
  var ms = tanggal.getTime(), notaK = finNotaKunci_(noNota);
  var lebar = Math.min(10, sh.getLastColumn());
  sh.getRange(awal, 1, lr - awal + 1, lebar).getValues().forEach(function (r, i) {
    if (!(r[0] instanceof Date)) return;
    var notaR = lebar >= 10 ? finNotaKunci_(r[9]) : '';
    if (notaK && notaR && notaK !== notaR) return; // No Nota beda -> pasti transaksi lain (mis. bayar listrik 2x nominal sama)
    if (String(r[3] || '').trim() !== 'Masuk' || String(r[2] || '').trim() !== 'Beban') return;
    if (String(r[6] || '').trim() === FIN_SUMBER_NONOPS) return;
    var jml = Math.round(finAngka_(r[4])), ket = String(r[5] || ''), akunR = finAkunNormal_(r[1]);
    var alasan = '';
    var tokR = token.length ? finTokenDokumen_(ket) : [];
    var samaToken = token.some(function (x) { return tokR.indexOf(x) !== -1; });
    var dekat = Math.abs(r[0].getTime() - ms) <= 1.5 * 86400000;
    // No Nota baru muncul di keterangan baris lama (data lama yang No Nota-nya ditulis di keterangan)
    var notaDiKetLama = notaK && !notaR && finTokenDokumen_(ket).indexOf(notaK) !== -1;
    if (samaToken || notaDiKetLama) alasan = 'No dokumen sama';
    // Nominal & tanggal sama BUKAN bukti dobel kalau entri baru punya No Nota sendiri (mis. bayar 2 nota berbeda
    // dengan nominal sama di hari yang sama) - hanya dipakai kalau No Nota entri baru kosong.
    else if (!notaK && jml === jumlah && dekat && (akunR === akun || (ketKecil && ket.toLowerCase().replace(/\s+/g, ' ').trim() === ketKecil))) alasan = 'Nominal & tanggal sama';
    if (!alasan) return;
    hasil.push({ row: awal + i, tanggal: Utilities.formatDate(r[0], tz, 'dd MMM yyyy'), akun: akunR, label: finInfoKategori_(akunR).label, jumlah: jml, keterangan: ket.slice(0, 120), alasan: alasan });
  });
  return hasil.slice(-5).reverse();
}

// No Nota dirapikan (huruf besar, spasi tunggal); pembanding mengabaikan spasi / - / . / /
function finNotaBersih_(v) { return String(v || '').replace(/\s+/g, ' ').trim().toUpperCase().slice(0, 60); }
function finNotaKunci_(v) { return finNotaBersih_(v).replace(/[\s\-\.\/_#:]/g, ''); }
function finCariNotaSama_(sh, noNota, jumlah, kecualiRow) {
  var kunci = finNotaKunci_(noNota);
  if (!kunci) return null;
  var lr = sh.getLastRow();
  if (lr < 2 || sh.getMaxColumns() < 10) return null;
  var tz = Session.getScriptTimeZone(), hasil = null;
  var v = sh.getRange(2, 1, lr - 1, 10).getValues();
  for (var i = v.length - 1; i >= 0; i--) {
    var r = v[i];
    if (i + 2 === kecualiRow || !(r[0] instanceof Date)) continue;
    if (String(r[3] || '').trim() !== 'Masuk' || String(r[2] || '').trim() !== 'Beban') continue;
    if (finNotaKunci_(r[9]) !== kunci || Math.round(finAngka_(r[4])) !== Math.round(jumlah)) continue;
    var a = finAkunNormal_(r[1]);
    hasil = { row: i + 2, tanggal: Utilities.formatDate(r[0], tz, 'dd MMM yyyy'), akun: a, label: finInfoKategori_(a).label, jumlah: Math.round(finAngka_(r[4])), keterangan: String(r[5] || '').slice(0, 120), alasan: 'No Nota & nominal sama persis' };
    break;
  }
  return hasil;
}
function finItemBiaya_(row, d, akun, jumlah, keterangan, sumber, linkFoto, noNota, rembesOleh, statusRembes) {
  var tz = Session.getScriptTimeZone(), info = finInfoKategori_(akun);
  return {
    row: row, tanggal: finTglStr_(d, tz), tanggalLabel: Utilities.formatDate(d, tz, 'dd MMM yyyy'), ms: d.getTime(),
    akun: akun, label: info.label, ikon: info.ikon, jumlah: jumlah, keterangan: keterangan || '', sumber: sumber || '-',
    dokumen: String(linkFoto || '').split(/\n+/).map(function (u) { return u.trim(); }).filter(function (u) { return u; }),
    noNota: noNota || '', bisaHapus: !!FIN_SUMBER_BISA_HAPUS[sumber],
    rembesOleh: rembesOleh || '', statusRembes: rembesOleh ? (statusRembes || FIN_REMBES_BELUM) : '',
    rembesDibayar: !!rembesOleh && String(statusRembes || '').indexOf('Sudah') === 0
  };
}

/* =====================================================================
   REMBES (REIMBURSEMENT) - biaya operasional yang DITALANGI uang pribadi staff/owner.
   Biaya tetap diakui sebagai beban di tanggal transaksinya (laporan tidak berubah). Kolom 12-13 Jurnal Transaksi
   mencatat siapa yang menalangi & apakah sudah dibayar balik. Rekap bulanan: total per nama yang harus dibayar.
   ===================================================================== */
var FIN_REMBES_BELUM = 'Belum Dibayar';
function finNamaRembes_(v) { return String(v || '').replace(/\s+/g, ' ').trim().slice(0, 60); }
function finRembesDibayar_(status) { return String(status || '').indexOf('Sudah') === 0; }

// ===== AKSI: fin_tandai_rembes { bulan: 'yyyy-MM', nama, dibayar: true|false, rows?: [row] } =====
function prosesFinTandaiRembes(data) {
  var result = { success: false };
  try { if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.'); }
  catch (eI) { result.error = eI.toString(); return result; }
  var lock = kunciModul_('keuangan');
  try { lock.waitLock(15000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  try {
    var tz = Session.getScriptTimeZone();
    var bulan = /^\d{4}-\d{2}$/.test(String(data.bulan || '')) ? String(data.bulan) : '';
    var nama = finNamaRembes_(data.nama);
    if (!bulan || !nama) throw new Error('Bulan & nama rembes wajib diisi');
    var hanyaRow = {};
    (Array.isArray(data.rows) ? data.rows : []).forEach(function (r) { var n = parseInt(r, 10); if (n >= 2) hanyaRow[n] = 1; });
    var pakaiFilterRow = Object.keys(hanyaRow).length > 0;
    var sh = getJurnalTransaksiSheet(), lr = sh.getLastRow();
    if (lr < 2) throw new Error('Belum ada data biaya');
    var oleh = getNamaStaff(data.email) || data.email || '';
    var statusBaru = data.dibayar ? 'Sudah Dibayar · ' + Utilities.formatDate(new Date(), tz, 'dd MMM yyyy') + ' · ' + oleh : FIN_REMBES_BELUM;
    var v = sh.getRange(2, 1, lr - 1, 13).getValues(), n = 0, total = 0, rowsBerubah = [];
    for (var i = 0; i < v.length; i++) {
      var r = v[i];
      if (!(r[0] instanceof Date) || Utilities.formatDate(r[0], tz, 'yyyy-MM') !== bulan) continue;
      if (String(r[3] || '').trim() !== 'Masuk') continue;
      if (finNamaRembes_(r[11]).toLowerCase() !== nama.toLowerCase()) continue;
      if (pakaiFilterRow && !hanyaRow[i + 2]) continue;
      if (finRembesDibayar_(r[12]) === !!data.dibayar) continue; // sudah sesuai -> lewati (kiriman ulang aman)
      sh.getRange(i + 2, 13).setValue(statusBaru);
      n++; total += Math.round(finAngka_(r[4]));
      rowsBerubah.push(i + 2);
    }
    SpreadsheetApp.flush();
    if (rowsBerubah.length) finPatchRembes_(rowsBerubah, nama, statusBaru); // jurnal pelunasan Reimburse ikut diperbarui
    result.success = true;
    result.jumlah = n;
    result.total = total;
    result.status = statusBaru;
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

// ===== AKSI: fin_migrasi_kartu_kredit - satu kali, aman diulang (idempoten) =====
// Biaya lama berakun "Kartu Kredit" dipindah ke kategori aslinya (PPh -> Pajak Penghasilan, lainnya -> Lain-lain)
// dan ditandai Rembes atas nama Owner (Belum Dibayar, kecuali sudah punya status). Akun Kartu Kredit di Bagan Akun
// diarsipkan (dipindah ke tipe "Arsip") supaya tidak muncul lagi di pilihan kategori.
function prosesFinMigrasiKartuKredit(data) {
  var result = { success: false };
  try { if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.'); }
  catch (eI) { result.error = eI.toString(); return result; }
  var lock = kunciModul_('keuangan');
  try { lock.waitLock(15000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  try {
    var sh = getJurnalTransaksiSheet(), lr = sh.getLastRow(), n = 0, total = 0, owner = finNamaOwner_();
    var tz = Session.getScriptTimeZone(), oleh = getNamaStaff(data.email) || data.email || '';
    if (lr > 1) {
      var lebar = Math.min(13, sh.getMaxColumns());
      var v = sh.getRange(2, 1, lr - 1, lebar).getValues();
      for (var i = 0; i < v.length; i++) {
        var r = v[i];
        if (String(r[2] || '').trim() !== 'Beban' || String(r[3] || '').trim() !== 'Masuk') continue;
        if (!finAdalahKartuKredit_(r[1])) continue;
        var ket = String(r[5] || '');
        var akunBaru = /\bpph\b|pajak\s*penghasilan|ntpn/i.test(ket) ? FIN_AKUN_PAJAK_PH : 'Beban Operasional Lain';
        var jejak = String(lebar >= 11 ? r[10] || '' : '');
        jejak = (jejak ? jejak + '\n' : '') + Utilities.formatDate(new Date(), tz, 'dd MMM yyyy HH:mm') + ' ' + oleh + ': migrasi akun "' + r[1] + '" -> ' + akunBaru + ' + Reimburse ' + owner;
        sh.getRange(i + 2, 2).setValue(akunBaru);
        if (lebar >= 11) sh.getRange(i + 2, 11).setValue(jejak.slice(-45000));
        var nmLama = lebar >= 12 ? finNamaRembes_(r[11]) : '';
        sh.getRange(i + 2, 12, 1, 2).setValues([[nmLama || owner, lebar >= 13 && String(r[12] || '').trim() ? String(r[12]).trim() : FIN_REMBES_BELUM]]);
        n++; total += Math.round(finAngka_(r[4]));
      }
    }
    var diarsip = 0;
    try {
      var shA = getBaganAkunSheet(), lrA = shA.getLastRow();
      if (lrA > 1) shA.getRange(2, 1, lrA - 1, 2).getValues().forEach(function (r, i) {
        if (String(r[1] || '').trim() === 'Beban' && finAdalahKartuKredit_(r[0])) { shA.getRange(i + 2, 2).setValue('Arsip'); diarsip++; }
      });
    } catch (eA) { }
    try {
      var custom = mkKategoriCustom_(), sisa = custom.filter(function (c) { return !finAdalahKartuKredit_(c && c.label); });
      if (sisa.length !== custom.length) { PropertiesService.getScriptProperties().setProperty('MK_KATEGORI_CUSTOM', JSON.stringify(sisa)); MK_KATEGORI_MEMO_ = null; }
    } catch (eM) { }
    SpreadsheetApp.flush();
    if (n || diarsip) finInvalidasi_();
    PropertiesService.getScriptProperties().setProperty('FIN_MIGRASI_CC_V1', String(Date.now()));
    result.success = true;
    result.jumlah = n; result.total = total; result.akunDiarsip = diarsip; result.owner = owner;
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

// ===== AKSI: fin_edit_biaya { row, jumlahLama, tanggal, akun | kategoriBaru, jumlah, keterangan, noNota } =====
function prosesFinEditBiaya(data) {
  return withTransaction(data.email, 'buatInvoice', 'keuangan', function () {
    var result = { success: false };
    var row = parseInt(data.row, 10);
    var sh = getJurnalTransaksiSheet();
    if (!(row >= 2 && row <= sh.getLastRow())) throw new Error('Data biaya tidak ditemukan');
    var r = sh.getRange(row, 1, 1, 13).getValues()[0];
    var sumber = String(r[6] || '').trim();
    if (!FIN_SUMBER_BISA_HAPUS[sumber]) throw new Error('Baris ini bukan biaya operasional - tidak bisa diedit dari sini');
    // Rembes: undefined = tidak diubah. Nyalakan -> status Belum Dibayar (status lama dipertahankan kalau hanya ganti nama)
    var rembesLama = finNamaRembes_(r[11]), statusRembesLama = String(r[12] || '').trim();
    var rembesOleh = rembesLama, statusRembes = statusRembesLama;
    if (data.rembes !== undefined && data.rembes !== null) {
      if (data.rembes) {
        rembesOleh = finNamaRembes_(data.rembesOleh);
        if (!rembesOleh) throw new Error('Isi nama yang menalangi biaya ini (Rembes)');
        if (!rembesLama) statusRembes = FIN_REMBES_BELUM;
      } else { rembesOleh = ''; statusRembes = ''; }
    }
    var rembesBerubah = rembesOleh !== rembesLama || statusRembes !== statusRembesLama;
    if (String(r[3] || '').trim() !== 'Masuk') throw new Error('Biaya ini sudah dihapus');
    var akun = data.kategoriBaru ? finAkunNormal_(finAkunDariLabel_(data.kategoriBaru)) : finAkunNormal_(data.akun || r[1]);
    if (!akun || akun.length < 8) throw new Error('Kategori biaya belum dipilih');
    var jumlah = Math.round(finAngka_(data.jumlah));
    if (!(jumlah > 0)) throw new Error('Jumlah biaya harus lebih dari 0');
    var tanggal = finValidTgl_(data.tanggal) ? finParseTanggalInput_(data.tanggal) : r[0];
    var keterangan = String(data.keterangan === undefined ? r[5] : data.keterangan).trim().slice(0, 300);
    var noNota = finNotaBersih_(data.noNota === undefined ? r[9] : data.noNota);
    var tz = Session.getScriptTimeZone();
    // Sudah sama persis dengan isi sheet (kiriman ulang) -> anggap berhasil
    var samaSemua = Math.round(finAngka_(r[4])) === jumlah && finAkunNormal_(r[1]) === akun && String(r[5] || '').trim() === keterangan &&
      finNotaBersih_(r[9]) === noNota && (r[0] instanceof Date) && finTglStr_(r[0], tz) === finTglStr_(tanggal, tz);
    if (samaSemua && rembesBerubah) {
      sh.getRange(row, 12, 1, 2).setValues([[rembesOleh, statusRembes]]);
      SpreadsheetApp.flush();
      finPatchRembes_([row], rembesOleh, statusRembes);
    }
    if (!samaSemua) {
      if (data.jumlahLama !== undefined && Math.round(finAngka_(data.jumlahLama)) !== Math.round(finAngka_(r[4]))) throw new Error('Data sudah diubah dari tempat lain - muat ulang dulu');
      var notaSama = finCariNotaSama_(sh, noNota, jumlah, row);
      if (notaSama) return { success: false, ditolakDobel: true, error: 'Ditolak: No Nota ' + noNota + ' senilai Rp ' + jumlah.toLocaleString('id-ID') + ' sudah tercatat (' + notaSama.tanggal + ' · ' + notaSama.label + ')' };
      akun = finPastikanAkunBeban_(akun);
      var oleh = getNamaStaff(data.email) || data.email || '';
      var jejak = String(r[10] || '');
      var catatan = Utilities.formatDate(new Date(), tz, 'dd MMM yyyy HH:mm') + ' ' + oleh + ': ' +
        [finTglStr_(r[0] instanceof Date ? r[0] : new Date(), tz), finAkunNormal_(r[1]), Math.round(finAngka_(r[4])), String(r[9] || '')].join(' | ') + ' -> ' +
        [finTglStr_(tanggal, tz), akun, jumlah, noNota].join(' | ');
      jejak = (jejak ? jejak + '\n' : '') + catatan;
      sh.getRange(row, 1, 1, 2).setValues([[tanggal, akun]]);
      sh.getRange(row, 5, 1, 2).setValues([[jumlah, keterangan]]);
      sh.getRange(row, 10, 1, 2).setValues([[noNota, jejak.slice(-45000)]]);
      if (rembesBerubah) sh.getRange(row, 12, 1, 2).setValues([[rembesOleh, statusRembes]]);
      SpreadsheetApp.flush();
      finPatchBiaya_(row, { tanggal: tanggal, akun: akun, jumlah: jumlah, ket: keterangan, row: row, rembesOleh: rembesOleh, statusRembes: statusRembes });
    }
    result.success = true;
    result.item = finItemBiaya_(row, tanggal, akun, jumlah, keterangan, sumber, r[7], noNota, rembesOleh, statusRembes);
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// ===== AKSI: fin_hapus_biaya { row } - soft delete (jejak tetap ada di sheet) =====
function prosesFinHapusBiaya(data) {
  return withTransaction(data.email, 'buatInvoice', 'keuangan', function () {
    var result = { success: false };
    var row = parseInt(data.row, 10);
    var sh = getJurnalTransaksiSheet();
    if (!(row >= 2 && row <= sh.getLastRow())) throw new Error('Data biaya tidak ditemukan');
    var r = sh.getRange(row, 1, 1, 7).getValues()[0];
    if (!FIN_SUMBER_BISA_HAPUS[String(r[6] || '').trim()]) throw new Error('Baris ini bukan biaya operasional - tidak bisa dihapus dari sini');
    if (String(r[3] || '').trim() !== 'Masuk') { result.success = true; result.sudahDihapus = true; return result; } // kiriman ulang -> sudah beres
    if (data.jumlah !== undefined && Math.round(finAngka_(data.jumlah)) !== Math.round(finAngka_(r[4]))) throw new Error('Data sudah berubah - muat ulang dulu');
    var oleh = getNamaStaff(data.email) || data.email || '';
    var tz = Session.getScriptTimeZone();
    sh.getRange(row, 4).setValue('Dihapus');
    sh.getRange(row, 6).setValue(String(r[5] || '') + ' [dihapus ' + Utilities.formatDate(new Date(), tz, 'dd MMM yyyy HH:mm') + ' oleh ' + oleh + ']');
    SpreadsheetApp.flush();
    finPatchBiaya_(row, null);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// ===== AKSI: fin_catat_nonops { jenis: modal|prive|aset|pinjam|cicil, tanggal, jumlah, bunga?, umur?, keterangan, dokumen? } =====
function prosesFinCatatNonOps(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var jenis = String(data.jenis || '');
    if (!FIN_NONOPS_JENIS[jenis] || jenis === 'bunga') throw new Error('Jenis transaksi tidak dikenali');
    var jumlah = Math.round(finAngka_(data.jumlah));
    var bunga = jenis === 'cicil' ? Math.max(0, Math.round(finAngka_(data.bunga))) : 0;
    if (jumlah < 0) throw new Error('Jumlah tidak boleh minus');
    if (jenis === 'cicil' ? !(jumlah + bunga > 0) : !(jumlah > 0)) throw new Error('Jumlah harus lebih dari 0');
    if (jumlah > 100000000000 || bunga > 100000000000) throw new Error('Jumlah terlalu besar - cek lagi angkanya');
    var umur = 0;
    if (jenis === 'aset') {
      umur = Math.round(finAngka_(data.umur)) || 48;
      if (umur < 1 || umur > 600) throw new Error('Umur manfaat harus 1-600 bulan');
    }
    var tanggal = finParseTanggalInput_(data.tanggal);
    if (tanggal.getTime() > Date.now() + 2 * 86400000) throw new Error('Tanggal tidak boleh di masa depan');
    var ket = String(data.keterangan || '').trim().slice(0, 200);
    if (jenis === 'aset' && !ket) throw new Error('Isi nama aset di keterangan (mis. Mesin roasting 5 kg)');
    var dokumen = dokumenBersihkan_(data.dokumen).join('\n');
  } catch (errV) { result.error = errV.toString(); return result; }

  var lock = kunciModul_('keuangan');
  try { lock.waitLock(15000); } catch (e) { return { success: false, error: 'Sistem sibuk, coba lagi.' }; }
  try {
    var cacheDup = CacheService.getScriptCache();
    var sidik = 'FINNOP_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5,
      [String(data.email || '').toLowerCase(), jenis, jumlah, bunga, umur, finTglStr_(tanggal), ket].join('|')));
    var lama = cacheDup.get(sidik);
    if (lama) { var o = JSON.parse(lama); o.duplikat = true; return o; }
    var sh = getJurnalTransaksiSheet();
    var grup = 'n' + Date.now().toString(36) + Math.floor(Math.random() * 1296).toString(36);
    var j = FIN_NONOPS_JENIS[jenis], baris = [];
    if (jumlah > 0) baris.push([tanggal, j.akunSheet, j.kategori, 'Masuk', jumlah, ket, FIN_SUMBER_NONOPS, dokumen, JSON.stringify({ j: jenis, u: umur || undefined, g: grup })]);
    if (bunga > 0) {
      var jb = FIN_NONOPS_JENIS.bunga;
      baris.push([tanggal, jb.akunSheet, jb.kategori, 'Masuk', bunga, ket, FIN_SUMBER_NONOPS, dokumen, JSON.stringify({ j: 'bunga', g: grup })]);
    }
    var row = sh.getLastRow() + 1;
    sh.getRange(row, 1, baris.length, 9).setValues(baris);
    SpreadsheetApp.flush();
    finInvalidasi_();
    result.success = true;
    result.grup = grup;
    result.rows = baris.map(function (b, i) { return row + i; });
    try { cacheDup.put(sidik, JSON.stringify(result), 180); } catch (eC) { }
  } catch (err) { result.error = err.toString(); } finally { lepasKunci_(lock); }
  return result;
}

// ===== AKSI: fin_hapus_nonops { grup, rows[] } - soft delete (jejak tetap ada di sheet) =====
function prosesFinHapusNonOps(data) {
  return withTransaction(data.email, 'buatInvoice', 'keuangan', function () {
    var result = { success: false };
    var grup = String(data.grup || '');
    var rows = (Array.isArray(data.rows) ? data.rows : []).map(function (r) { return parseInt(r, 10); }).filter(function (r) { return r >= 2; });
    if (!grup || !rows.length) throw new Error('Data tidak lengkap');
    var sh = getJurnalTransaksiSheet(), lr = sh.getLastRow();
    var oleh = getNamaStaff(data.email) || data.email || '';
    var cap = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm');
    var n = 0;
    rows.forEach(function (row) {
      if (row > lr) return;
      var r = sh.getRange(row, 1, 1, 9).getValues()[0];
      if (String(r[6] || '').trim() !== FIN_SUMBER_NONOPS) throw new Error('Baris ' + row + ' bukan transaksi modal/aset/pinjaman');
      var info = {}; try { info = JSON.parse(String(r[8] || '{}')) || {}; } catch (eI) { }
      if (String(info.g || ('r' + row)) !== grup) throw new Error('Data sudah berubah - muat ulang dulu');
      if (String(r[3] || '').trim() !== 'Masuk') return;
      sh.getRange(row, 4).setValue('Dihapus');
      sh.getRange(row, 6).setValue(String(r[5] || '') + ' [dihapus ' + cap + ' oleh ' + oleh + ']');
      n++;
    });
    if (!n) throw new Error('Transaksi ini sudah dihapus sebelumnya');
    SpreadsheetApp.flush();
    finInvalidasi_();
    result.success = true;
    result.dihapus = n;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sibuk, coba lagi.'
  });
}

// ===== AKSI: fin_simpan_pengaturan { tanggalMulai, kasAwal, piutangAwal, persediaanAwal, utangAwal, tempoMarketplace, tempoLain, tempoPembelian } =====
function prosesFinSimpanPengaturan(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var lama = finPengaturan_();
    function ambil(k, def) { return data[k] === undefined || data[k] === null || data[k] === '' ? def : data[k]; }
    function tempo(v) { var n = Math.round(finAngka_(v)); if (n < 0 || n > 180) throw new Error('Tempo harus 0-180 hari'); return n; }
    var p = {
      tanggalMulai: finValidTgl_(data.tanggalMulai) ? String(data.tanggalMulai) : '',
      kasAwal: Math.round(finAngka_(ambil('kasAwal', lama.kasAwal))),
      piutangAwal: Math.max(0, Math.round(finAngka_(ambil('piutangAwal', lama.piutangAwal)))),
      persediaanAwal: Math.max(0, Math.round(finAngka_(ambil('persediaanAwal', lama.persediaanAwal)))),
      utangAwal: Math.max(0, Math.round(finAngka_(ambil('utangAwal', lama.utangAwal)))),
      tempoMarketplace: tempo(ambil('tempoMarketplace', lama.tempoMarketplace)),
      tempoLain: tempo(ambil('tempoLain', lama.tempoLain)),
      tempoPembelian: tempo(ambil('tempoPembelian', lama.tempoPembelian)),
      diperbarui: new Date().toISOString(), oleh: getNamaStaff(data.email) || data.email || ''
    };
    PropertiesService.getScriptProperties().setProperty('FIN_PENGATURAN', JSON.stringify(p));
    result.success = true;
    result.pengaturan = finPengaturan_();
  } catch (err) { result.error = err.toString(); }
  return result;
}

// Buat 1 file Excel berisi beberapa sheet: lembar = [{ nama, header, rows }]
function finBuatExcelMulti_(namaFile, lembar) {
  var ss = SpreadsheetApp.create(namaFile);
  var pertama = ss.getSheets()[0];
  lembar.forEach(function (L, i) {
    var sh = i === 0 ? pertama : ss.insertSheet();
    sh.setName(L.nama.slice(0, 90));
    var lebar = L.header.length;
    sh.getRange(1, 1, 1, lebar).setValues([L.header]).setFontWeight('bold').setBackground('#eef2ff');
    var rows = L.rows.map(function (r) { var x = r.slice(0, lebar); while (x.length < lebar) x.push(''); return x; });
    if (rows.length) sh.getRange(2, 1, rows.length, lebar).setValues(rows);
    if (L.formatAngka) L.formatAngka.forEach(function (c) { if (rows.length) sh.getRange(2, c, rows.length, 1).setNumberFormat('#,##0;(#,##0)'); });
    sh.setFrozenRows(1);
    try { sh.autoResizeColumns(1, lebar); } catch (eR) { }
  });
  SpreadsheetApp.flush();
  var fileId = ss.getId();
  var res = fetchHemat('https://docs.google.com/spreadsheets/d/' + fileId + '/export?format=xlsx', { headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() } });
  var base64 = Utilities.base64Encode(res.getContent());
  DriveApp.getFileById(fileId).setTrashed(true);
  return base64;
}

