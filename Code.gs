        if (!laporan.tanggalPaling || tgl < laporan.tanggalPaling) laporan.tanggalPaling = tgl;
        laporan.baru++;
      });
      if (!data.cekSaja && header.length) {
        var r0 = sh.header.getLastRow() + 1;
        if (!sh.header.getRange(1, 13).getValue()) sh.header.getRange(1, 13).setValue('Dibuat Oleh').setFontWeight('bold');
        if (!sh.header.getRange(1, 14).getValue()) { sh.header.getRange(1, 14).setValue('Diskon').setFontWeight('bold'); sh.header.getRange(1, 15).setValue('Pajak (VAT)').setFontWeight('bold'); }
