function prosesEditProdukMaster_inti_(data) {
  var result = { success: false };
  try {
    if (!cekIzin(data.email, 'mintaStock')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var skuLama = String(data.skuLama || '').trim();
    var skuBaru = String(data.skuBaru || '').trim();
    var namaBaru = String(data.namaBaru || '').trim();
    var kategoriBaru = String(data.kategoriBaru || '').trim();
    if (!skuLama || !skuBaru) throw new Error('SKU tidak boleh kosong');

    var sh = getMasterProdukSheet(data.toko);
    var lastRow = sh.getLastRow();
    var vals = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var rowTarget = -1;
    for (var i = 0; i < vals.length; i++) {
      var skuBaris = String(vals[i][0]).trim();
      if (skuBaris === skuLama) rowTarget = i + 2;
      else if (skuBaris === skuBaru && skuBaru !== skuLama) throw new Error('SKU baru "' + skuBaru + '" udah dipakai produk lain');
    }
    if (rowTarget === -1) throw new Error('Produk tidak ditemukan');

    sh.getRange(rowTarget, 1).setValue(skuBaru);
    sh.getRange(rowTarget, 2).setValue(namaBaru);
    sh.getRange(rowTarget, 8).setValue(kategoriBaru);

    // Kalau kategori ini BELUM ada di Sheet Kategori Produk, otomatis daftarin (biar konsisten
