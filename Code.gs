function pelTambahMarketplace_(daftarPembeli, mapPembeli) {
  function tambah(nama, hp, alamat, sumber, segmen, total, tgl, username) {
    nama = String(nama || '').trim();
    username = String(username || '').trim();
    if (shopeeTersamar_(username)) username = '';
    // v2026.10.52: nama tersamar tetapi username ada -> tetap jadi pelanggan (dikenali lewat username)
    if ((!nama || shopeeTersamar_(nama)) && username) nama = '@' + username;
    if (!nama || shopeeTersamar_(nama)) return;
    if (shopeeTersamar_(hp)) hp = '';
    if (shopeeTersamar_(alamat)) alamat = '';
