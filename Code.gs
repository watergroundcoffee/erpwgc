/* ---------- AKSI: bundling_daftar ---------- */
function prosesBundlingDaftar(data) {
  try {
    if (!cekIzin(data.email, 'mintaStock') && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var boleh = cekIzin(data.email, 'buatInvoice');
    var master = bdlMaster_(data.toko), stok = rstStokProduk_(data.email), daftar = bdlBacaSheet_(), terdaftar = {};
    var hasil = daftar.map(function (b) {
      terdaftar[b.sku.toUpperCase()] = 1;
      var h = bdlHitung_(b.isi, master, stok);
      var x = { sku: b.sku, nama: b.nama, diperbarui: b.diperbarui, stok: h.stok, tidakAda: h.tidakAda, diMaster: !!(master[b.sku.toUpperCase()] && !master[b.sku.toUpperCase()].arsip),
        isi: b.isi.map(function (i) { var m = master[String(i.sku).toUpperCase()]; return { sku: m ? m.sku : i.sku, qty: i.qty, nama: m ? m.nama : '(tidak ada di Produk Master)', stok: m ? (stok[m.sku.toUpperCase()] || 0) : 0 }; }) };
      if (boleh) { x.hpp = h.hpp; x.hargaNormal = h.hargaNormal; }
      return x;
    });
    // Kode bundling yang terlanjur jadi produk di Produk Master (belum diarsipkan & belum terdaftar)
    var kandidat = [];
    Object.keys(master).forEach(function (K) {
      var m = master[K];
      if (m.arsip || terdaftar[K]) return;
      var kode = pecahKodeGabungan_(m.sku), pakaiPemisah = SKU_BUNDLING_POLA_.test(m.sku);
      if (!kode && !pakaiPemisah) return;
      var isi = parseSKUBundling(m.sku);
      if (!isi.length || (isi.length === 1 && isi[0].qty === 1)) return;
      var ok = isi.every(function (i) { return master[String(i.sku).toUpperCase()] && String(i.sku).toUpperCase() !== K; });
      var x = { sku: m.sku, nama: m.nama, stokSendiri: stok[K] || 0, isiValid: ok,
        isi: isi.map(function (i) { var mm = master[String(i.sku).toUpperCase()]; return { sku: mm ? mm.sku : i.sku, qty: i.qty, nama: mm ? mm.nama : '(tidak ada di Produk Master)' }; }) };
      kandidat.push(x);
    });
    return { success: true, daftar: hasil, kandidat: kandidat.slice(0, 300), bolehHarga: boleh };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

/* ---------- AKSI: bundling_simpan { skuBundle?, skuLama?, nama, isi:[{sku, qty}], ubahDariMaster } ---------- */
function prosesBundlingSimpan(data) { return katJalankanTerkunci_(prosesBundlingSimpan_inti_, data); }
function prosesBundlingSimpan_inti_(data) {
