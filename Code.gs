    if (turun && stokAman && s.hargaBerubah && s.hargaBerubah.naik) {
      var pf = s.hargaBerubah.kanal && /tiktok|tokopedia/i.test(s.hargaBerubah.kanal) ? 'TikTok Shop' : 'Shopee';
      var v = validatePriceSafety(s.sku, s.hargaBerubah.dari, pf);
      temuan.push({ tingkat: 'tinggi', judul: s.nama + ' turun ' + Math.abs(s.deltaPct || 0) + '% setelah harga naik', detail: 'Harga ' + pf + ' ' + rp(s.hargaBerubah.dari) + ' → ' + rp(s.hargaBerubah.ke) + ' (' + agpTgl_(new Date(s.hargaBerubah.ms)) + '). Terjual ' + s.qtyA + ' vs ' + s.qtyB + ' pcs.' });
      if (v.status === 'OK') rek.push({ prioritas: 'tinggi', kategori: 'penjualan', judul: 'Kembalikan harga ' + s.nama + ' ke ' + rp(s.hargaBerubah.dari), alasan: 'Penjualan turun sejak harga dinaikkan. Harga lama masih aman (margin ' + v.marginPct + '%).',
        dampak: 'Potensi kembali ± ' + Math.round((s.qtyB - s.qtyA)) + ' pcs / ' + hari + ' hari', aksi: { tool_call: 'execute_action', action: 'UPDATE_PRICE', params: { sku: s.sku, new_price: s.hargaBerubah.dari, platform: pf } } });
