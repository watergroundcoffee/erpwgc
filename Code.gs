  });
  daftar.sort(function (a, b) { return a.urutan - b.urutan; });
  // v2026.10.123 (DN-318): nama baku toko bawaan - Waterground Coffee & Conner Official (nama yang sudah diubah Owner tetap dipakai)
  daftar.forEach(function (t) {
    if (t.kode === 'Waterground' && /^(waterground|waterground coffee & roastery)$/i.test(t.nama)) t.nama = 'Waterground Coffee';
    if (t.kode === 'Conner' && /^(conner|conner hardware)$/i.test(t.nama)) t.nama = 'Conner Official';
  });
  try { c.put(TOKO_CACHE_KUNCI_, JSON.stringify(daftar), 600); } catch (e) { }
  return daftar;
}
function prosesLihatDaftarToko(data) {
  try { return { success: true, daftar: tokoDaftar_() }; }
  catch (err) { return { success: false, error: err.message || String(err) }; }
}
function prosesSimpanToko(data) {
  try {
    var s = getStaffByEmail(data.email);
    if (!s || s.role !== 'Owner' || !s.aktif) throw new Error('Hanya Owner yang bisa mengatur daftar toko.');
    var nama = wajibIsi_(data.nama, 'Nama toko');
    if (nama.length > 60) throw new Error('Nama toko maksimal 60 karakter.');
    var warna = /^#[0-9a-fA-F]{6}$/.test(String(data.warna || '')) ? String(data.warna) : '#475569';
    var logoUrl = null;
    if (data.logoBase64) {
      if (String(data.logoBase64).length > 2.9 * 1024 * 1024) throw new Error('Logo maksimal 2 MB.');
      var mime = /^image\/(png|jpe?g|webp|svg\+xml)$/i.test(String(data.logoMime || '')) ? String(data.logoMime) : 'image/png';
      var file = getSubfolderUpload('Logo Toko').createFile(Utilities.newBlob(Utilities.base64Decode(String(data.logoBase64)), mime, 'logo-toko-' + nama));
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      logoUrl = 'https://lh3.googleusercontent.com/d/' + file.getId();
    }
    var lock = LockService.getScriptLock();
    lock.waitLock(15000);
    var idHasil = '';
    try {
      var sh = getTokoSheet_(), lr = sh.getLastRow();
      var rows = lr > 1 ? sh.getRange(2, 1, lr - 1, TOKO_HEADER_.length).getValues() : [];
      var namaKecil = nama.toLowerCase();
      for (var i = 0; i < rows.length; i++) {
        if (String(rows[i][1]).trim().toLowerCase() === namaKecil && String(rows[i][0]) !== String(data.id || '')) throw new Error('Nama toko "' + nama + '" sudah dipakai.');
      }
      if (data.id) {
        var idx = -1;
        for (var j = 0; j < rows.length; j++) if (String(rows[j][0]) === String(data.id)) { idx = j; break; }
        if (idx < 0) throw new Error('Toko tidak ditemukan.');
        var r = rows[idx];
        r[1] = nama; r[4] = warna; if (logoUrl) r[3] = logoUrl; r[7] = data.email;
        sh.getRange(idx + 2, 1, 1, TOKO_HEADER_.length).setValues([r]);
        idHasil = String(data.id);
      } else {
        var kode = TOKO_DATA_INDUK_.indexOf(String(data.kode)) >= 0 ? String(data.kode) : 'Waterground';
        idHasil = 'tk-' + Utilities.getUuid().replace(/-/g, '').slice(0, 10);
        var urutan = rows.reduce(function (m, x) { return Math.max(m, parseFloat(x[5]) || 0); }, 0) + 1;
        sh.getRange(lr + 1, 1, 1, TOKO_HEADER_.length).setValues([[idHasil, nama, kode, logoUrl || '', warna, urutan, new Date(), data.email]]);
      }
      SpreadsheetApp.flush();
    } finally { lock.releaseLock(); }
    CacheService.getScriptCache().remove(TOKO_CACHE_KUNCI_);
    return { success: true, id: idHasil, daftar: tokoDaftar_() };
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}

/* ---------- (3) PEMBELI SHOPEE OTOMATIS ----------
   Mengisi kolom yang MASIH KOSONG di sheet Pesanan Shopee (11 Nama, 12 HP, 13 Alamat, 15 Username).
   Data yang sudah diketik admin tidak pernah ditimpa. Pesanan yang datanya disamarkan Shopee
   (atau tidak ditemukan) ditandai 6 jam supaya API tidak ditanya berulang-ulang.
   Bisa dipanggil dari browser (daftar No Pesanan yang tampil) atau trigger terjadwal. */
function prosesOtomatisPembeliShopee(data) {
  data = data || {};
  try {
    if (!data.dariSistem && !cekIzin(data.email, 'buatInvoice')) throw new Error('Anda tidak punya izin untuk aksi ini.');
    var kred = ambilKredensialShopee();
    if (!kred || !kred.accessToken || !kred.shopId) return { success: true, dilewati: 'Shopee belum terhubung', data: {}, terisi: 0 };
    var cache = CacheService.getScriptCache();
    if (cache.get('AUTO_PB_SHOPEE_JALAN')) return { success: true, sedangJalan: true, data: {}, terisi: 0 };
    cache.put('AUTO_PB_SHOPEE_JALAN', '1', 180);
    try {
      var sh = getPesananShopeeSheet(), lr = sh.getLastRow();
      if (lr < 2) return { success: true, data: {}, terisi: 0 };
      var vals = sh.getRange(2, 1, lr - 1, 15).getValues();
      var diminta = {};
      (data.daftar || []).forEach(function (x) { var k = String(x || '').trim(); if (k) diminta[k] = true; });
      var pakaiFilter = Object.keys(diminta).length > 0;
      var target = [];
      for (var i = vals.length - 1; i >= 0 && target.length < 100; i--) {
        var sn = String(vals[i][0] || '').trim();
        if (!sn || (pakaiFilter && !diminta[sn])) continue;
        // v2026.10.40: dari jadwal hanya pesanan <= SPB_HARI_OTOMATIS_ hari (pesanan lama sudah pasti disamarkan Shopee)
        if (data.dariSistem && !pakaiFilter && vals[i][1] instanceof Date && Date.now() - vals[i][1].getTime() > SPB_HARI_OTOMATIS_ * 86400000) continue;
        // Lewati hanya kalau Nama, HP, Alamat & Username SEMUA sudah terisi (dulu cukup salah satu)
        if (String(vals[i][10] || '').trim() && String(vals[i][11] || '').trim() && String(vals[i][12] || '').trim() && String(vals[i][14] || '').trim()) continue;
        if (shopeeEkspor_(vals[i][14], vals[i][7])) continue; // v2026.10.50 (DN-300): pesanan ekspor -> "pembeli" = gudang ekspor Shopee, tidak dicari
        if (!data.abaikanTanda && cache.get('AUTO_PB_X_' + sn)) continue; // v2026.10.66: jalur per-status tidak memakai tanda waktu
        target.push(sn);
      }
      var tarik = shopeeAmbilPembeliBatch_(target, kred, {});
      var hasil = tarik.hasil, peringatan = tarik.peringatan.join(' | ');
      var terisi = 0;
      if (Object.keys(hasil).length) {
        var lock = kunciModul_('penjualan');
        lock.waitLock(20000);
        try {
          var lr2 = sh.getLastRow();
          var peta = {};
          sh.getRange(2, 1, lr2 - 1, 1).getValues().forEach(function (x, idx) { var k = String(x[0] || '').trim(); if (k && !peta[k]) peta[k] = idx + 2; });
          Object.keys(hasil).forEach(function (sn) {
            var h = hasil[sn], row = peta[sn];
            if (!row) return;
            var rg = sh.getRange(row, 11, 1, 5), blok = rg.getValues()[0], ubah = false;
            // Per field: yang tersamar sudah dikosongkan helper -> otomatis dilewati
            if (!String(blok[0]).trim() && h.nama) { blok[0] = h.nama; ubah = true; }
            if (!String(blok[1]).trim() && h.hp) { blok[1] = h.hp; ubah = true; }
            if (!String(blok[2]).trim() && h.alamat) { blok[2] = h.alamat; ubah = true; }
            if (!String(blok[4]).trim() && h.username) { blok[4] = h.username; ubah = true; }
            if (ubah) { rg.setNumberFormat('@'); rg.setValues([blok]); terisi++; }
          });
          if (terisi) invalidasiCacheGabunganPesanan();
        } finally { lepasKunci_(lock); }
      }
      // v2026.10.40: pesanan belum dibayar / baru dikemas ditanya lagi lebih cepat (30 menit) - data biasanya terbuka setelah dibayar
      target.forEach(function (sn) { if (!hasil[sn] || hasil[sn].tersamar || hasil[sn].tersamarSebagian) { try { cache.put('AUTO_PB_X_' + sn, '1', hasil[sn] && /^(UNPAID|READY_TO_SHIP|PROCESSED)$/.test(hasil[sn].status || '') ? 1800 : 21600); } catch (e) { } } });
      return { success: true, data: hasil, terisi: terisi, diperiksa: target.length, peringatan: peringatan };
    } finally { cache.remove('AUTO_PB_SHOPEE_JALAN'); }
  } catch (err) { return { success: false, error: err.message || String(err) }; }
}
function autoPembeliShopeeTerjadwal() {
  try { denganIzinSistem_(function () { prosesOtomatisPembeliShopee({ dariSistem: true }); }); } catch (e) { console.error('autoPembeliShopeeTerjadwal: ' + e); }
}
// Jalankan SEKALI dari editor Apps Script supaya pembeli Shopee terisi otomatis tiap 30 menit walau web tidak dibuka
function aktifkanAutoPembeliShopee() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'autoPembeliShopeeTerjadwal') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('autoPembeliShopeeTerjadwal').timeBased().everyMinutes(30).create();
  Logger.log('Trigger pembeli Shopee otomatis (30 menit) aktif.');
}

