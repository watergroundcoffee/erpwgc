    sh.getRange(rowTarget, 11, 1, 5).setValues([[
      String(data.brand || '').trim(), String(data.tipe || '').trim(), String(data.material || '').trim(),
      String(data.volume || '').trim(), String(data.warna || '').trim()
    ]]);
    result.success = true;
  } catch (err) { result.error = err.toString(); }
  return result;
}

