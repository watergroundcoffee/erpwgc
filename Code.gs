var DAFTAR_IZIN = ['scanResiKeluar', 'scanResiMasuk', 'mintaStock', 'adminPembelian', 'buatInvoice', 'printLabel', 'kirimResi', 'batalPesanan', 'lihatTagihan'];
var HEADER_IZIN = ['Role', 'Scan Resi Keluar', 'Scan Resi Masuk', 'Minta Stock', 'Admin Pembelian (Konfirmasi PO)', 'Buat Invoice (Lihat Harga)', 'Print Label Saja', 'Kirim Resi', 'Batalkan Pesanan', 'Lihat Tagihan (Billing)'];

// Pasang dropdown pilihan Role di kolom C tab Staff, isinya sinkron sama daftar
// role yang ada di tab "Hak Akses Role" - biar nggak perlu ketik manual (rawan typo/beda kapitalisasi)
function pasangDropdownRoleStaff(shStaff) {
  try {
    var shHakAkses = getHakAksesSheet();
    var lastRowHakAkses = shHakAkses.getLastRow();
    var daftarRole = [];
    if (lastRowHakAkses > 1) {
      var values = shHakAkses.getRange(2, 1, lastRowHakAkses - 1, 1).getValues();
      for (var i = 0; i < values.length; i++) {
        var role = String(values[i][0] || '').trim();
        if (role) daftarRole.push(role);
      }
    }
    if (daftarRole.length === 0) return;

    var rule = SpreadsheetApp.newDataValidation().requireValueInList(daftarRole, true).setAllowInvalid(false).build();
    shStaff.getRange(2, 3, 300, 1).setDataValidation(rule); // siap buat 300 baris ke depan
  } catch (err) {
    // Kalau gagal (misal Hak Akses Role belum ada), biarin aja - kolom Role tetap bisa diisi manual
  }
}

// Bisa dipanggil manual dari menu "Tracking Resi" kalau kamu nambah/ubah role baru
// di tab Hak Akses Role, biar dropdown di tab Staff ikut sinkron ulang
function refreshDropdownRoleStaff() {
  var sh = getStaffSheet();
  pasangDropdownRoleStaff(sh);
  SpreadsheetApp.getUi().alert('Selesai! Dropdown Role di tab Staff sudah disinkronkan ulang.');
}

// Cari baris kosong beneran berdasarkan 1 kolom spesifik (bukan getLastRow() mentah,
// yang bisa salah hitung kalau ada checkbox/formatting "hantu" di kolom lain)
function cariBarisKosongBerikutnya(sheet, kolomCek) {
  var lastRow = sheet.getLastRow();
  if (lastRow < 1) return 2;
  var nilaiKolom = sheet.getRange(1, kolomCek, lastRow, 1).getValues();
  for (var i = nilaiKolom.length - 1; i >= 1; i--) { // mulai dari bawah, skip baris 1 (header)
    if (String(nilaiKolom[i][0]).trim() !== '') return i + 2; // +2: i berbasis 0 mulai dari baris 2
  }
  return 2; // semua kosong -> mulai dari baris 2
}

// Kolom No HP & Alamat di tab Staff dicari lewat NAMA HEADER (bukan nomor kolom tetap),
// jadi aman kalau nanti DAFTAR_IZIN nambah dan kolom izin melebar ke kanan.
var KOLOM_STAFF_HP = 'No HP';
var KOLOM_STAFF_ALAMAT = 'Alamat';
function staffCariKolomHeader_(sh, namaHeader, buatJikaBelumAda) {
  var lastCol = sh.getLastColumn();
  if (lastCol > 0) {
    var header = sh.getRange(1, 1, 1, lastCol).getValues()[0];
    for (var c = 0; c < header.length; c++) {
      if (String(header[c] || '').trim().toLowerCase() === namaHeader.toLowerCase()) return c + 1;
    }
  }
  if (!buatJikaBelumAda) return 0;
  // Taruh setelah kolom izin terakhir biar nggak nabrak kolom checkbox
  var kolBaru = Math.max(lastCol, 6 + DAFTAR_IZIN.length) + 1;
  if (kolBaru > sh.getMaxColumns()) sh.insertColumnsAfter(sh.getMaxColumns(), kolBaru - sh.getMaxColumns());
  sh.getRange(1, kolBaru).setValue(namaHeader).setFontWeight('bold');
  return kolBaru;
}

function getStaffSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Staff');
  if (!sh) {
    sh = ss.insertSheet('Staff');
    sh.getRange(1, 1, 1, 4).setValues([['Email', 'Nama', 'Role', 'Status Aktif']]);
    sh.getRange(1, 1, 1, 4).setFontWeight('bold');
    // Sengaja dibiarkan KOSONG (tanpa baris contoh, tanpa checkbox "cadangan") -
    // supaya getLastRow() akurat dan sistem izin tetap "terbuka" sampai kamu
    // benar-benar menambahkan staff pertama. Checkbox tiap baris baru dipasang
    // satu-satu pas baris itu memang ditulis (lihat prosesLogin/prosesTandaiPending dst).
    pasangDropdownRoleStaff(sh);
  }
  return sh;
}

function getHakAksesSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Hak Akses Role');
  if (!sh) {
    sh = ss.insertSheet('Hak Akses Role');
    sh.getRange(1, 1, 1, HEADER_IZIN.length).setValues([HEADER_IZIN]);
    sh.getRange(1, 1, 1, HEADER_IZIN.length).setFontWeight('bold');

    var contohRows = [
      ['Owner', true, true, true, true, true, true, true, true, true],
      ['Admin Gudang', true, true, true, false, true, true, false, false, false],
      ['Admin Finance', true, true, false, true, true, true, true, true, true]
    ];
    sh.getRange(2, 1, contohRows.length, HEADER_IZIN.length).setValues(contohRows);
    sh.getRange(2, 2, contohRows.length, HEADER_IZIN.length - 1).insertCheckboxes();
    // (Tidak lagi menyiapkan checkbox "cadangan" di baris kosong berikutnya - itu bikin
    // getLastRow() salah hitung. Kalau kamu nambah role baru manual, tinggal ketik nama role-nya
    // di kolom A, lalu blok kolom B ke kanan di baris itu > Insert > Checkbox, biar formatnya konsisten.)
  } else if (sh.getLastColumn() < HEADER_IZIN.length) {
    // Migrasi - kolom "Lihat Tagihan (Billing)" baru ditambahkan, sheet lama belum punya kolom ini.
    // Role yang udah ada dianggap belum punya akses (false) - Owner perlu centang manual lewat
    // Kelola Akses buat role yang emang harus bisa lihat Tagihan (misal Admin Finance).
    var lastRow = sh.getLastRow();
    sh.getRange(1, HEADER_IZIN.length).setValue(HEADER_IZIN[HEADER_IZIN.length - 1]).setFontWeight('bold');
    if (lastRow > 1) {
      var kolomBaru = [];
      for (var r = 0; r < lastRow - 1; r++) kolomBaru.push([false]);
      sh.getRange(2, HEADER_IZIN.length, kolomBaru.length, 1).setValues(kolomBaru);
      sh.getRange(2, HEADER_IZIN.length, kolomBaru.length, 1).insertCheckboxes();
    }
  }
  return sh;
}

/* ===== SNAPSHOT STAFF (percepat SEMUA request) =====
   Dulu setiap request membaca sheet Staff 4-6 kali (cekIzin: kolom email + getStaffByEmail + getIzinByEmail
   yang membaca lagi + getNamaStaff). Sekarang dibaca SEKALI, disimpan di memori eksekusi + CacheService
   2 menit, dan dibuang otomatis setiap ada aksi yang mengubah staff / hak akses. */
var STAFF_SNAP_MEMO_ = null;
function staffSnapshot_() {
  if (STAFF_SNAP_MEMO_) return STAFF_SNAP_MEMO_;
  var cache = CacheService.getScriptCache();
  try { var c = cache.get('STAFF_SNAP_V1'); if (c) { STAFF_SNAP_MEMO_ = JSON.parse(c); return STAFF_SNAP_MEMO_; } } catch (e) {}
  var sh = getStaffSheet(), lr = sh.getLastRow();
  var lc = Math.max(4, Math.min(Math.max(sh.getLastColumn(), 4), 6 + DAFTAR_IZIN.length));
  var snap = { adaKolomIzin: false, rows: [] };
  if (lr >= 1 && lc >= 7) snap.adaKolomIzin = !!sh.getRange(1, 7).getValue();
  if (lr > 1) snap.rows = sh.getRange(2, 1, lr - 1, lc).getValues().map(function (r) {
    return [String(r[0] || '').trim().toLowerCase(), r[1] instanceof Date ? String(r[1]) : r[1], String(r[2] || ''), r[3] === true,
      r.slice(6).map(function (x) { return x === true; })];
  });
  STAFF_SNAP_MEMO_ = snap;
  try { cache.put('STAFF_SNAP_V1', JSON.stringify(snap), 120); } catch (e) {}
  return snap;
}
function staffInvalidasi_() {
  STAFF_SNAP_MEMO_ = null;
  try { CacheService.getScriptCache().remove('STAFF_SNAP_V1'); } catch (e) {}
}
function staffBaris_(email) {
  var e = String(email || '').trim().toLowerCase();
  if (!e) return null;
  var rows = staffSnapshot_().rows;
  for (var i = 0; i < rows.length; i++) if (rows[i][0] === e) return rows[i];
  return null;
}

function getStaffByEmail(email) {
  // Jalur belakang khusus developer testing - lihat peringatan di DEV_EMAIL_TESTING paling atas file ini
  if (DEV_EMAIL_TESTING && String(email).trim() === DEV_EMAIL_TESTING) {
    return { nama: 'Developer (Testing)', role: 'Owner', aktif: true };
  }

  // Jalur belakang khusus "Admin Gudang" sementara
  if (ADMIN_GUDANG_EMAIL_TESTING && String(email).trim() === ADMIN_GUDANG_EMAIL_TESTING) {
    return { nama: 'Admin Gudang', role: 'Admin Gudang', aktif: true };
  }

  var b = staffBaris_(email);
  return b ? { nama: b[1], role: b[2], aktif: b[3] } : null;
}

// Owner = akses penuh, SEMUA wewenang selalu aktif (tidak bisa dikurangi lewat centang)
function izinPenuhOwner_() {
  var semua = {};
  DAFTAR_IZIN.forEach(function (key) { semua[key] = true; });
  return semua;
}

function getPermissionsForRole(role) {
  if (String(role || '').trim().toLowerCase() === 'owner') return izinPenuhOwner_();
  var izinDefault = {};
  DAFTAR_IZIN.forEach(function (key) { izinDefault[key] = false; });

  var sh = getHakAksesSheet();
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return izinDefault;

  var values = sh.getRange(2, 1, lastRow - 1, HEADER_IZIN.length).getValues();
  for (var i = 0; i < values.length; i++) {
    if (String(values[i][0]).trim() === String(role).trim()) {
      var izin = {};
      DAFTAR_IZIN.forEach(function (key, idx) {
        izin[key] = values[i][idx + 1] === true;
      });
      return izin;
    }
  }
  return izinDefault;
}

function verifikasiGoogleToken(idToken) {
  // Token yang sama (mis. tombol Masuk ditekan ulang) tidak perlu ditanyakan lagi ke Google: cache 10 menit
  var kunciCacheTok = '';
  try {
    kunciCacheTok = 'GTOK_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(idToken || ''))).slice(0, 43);
    var adaTok = CacheService.getScriptCache().get(kunciCacheTok);
    if (adaTok) return JSON.parse(adaTok);
  } catch (eTok) { /* cache opsional */ }
  try {
    var url = 'https://oauth2.googleapis.com/tokeninfo?id_token=' + encodeURIComponent(idToken);
    var res = fetchHemat(url, { muteHttpExceptions: true });
    var kode = res.getResponseCode();
    var isiRespons = res.getContentText();

    if (kode !== 200) {
      // Diagnosa sementara: simpan alasan gagal supaya kelihatan di respons login
      throw new Error('DIAGNOSA: tokeninfo balas kode ' + kode + ' - isi: ' + isiRespons.substring(0, 300));
    }
    var data = JSON.parse(isiRespons);
    if (data.email_verified !== 'true' && data.email_verified !== true) {
      throw new Error('DIAGNOSA: email_verified = ' + data.email_verified);
    }
    var hasilTok = { email: data.email, nama: data.name || data.email, foto: data.picture || '' };
    try { if (kunciCacheTok) CacheService.getScriptCache().put(kunciCacheTok, JSON.stringify(hasilTok), 600); } catch (eTok2) { }
    return hasilTok;
  } catch (err) {
    // Sementara: lempar lagi errornya biar keliatan di frontend (bukan return null diam-diam)
    throw err;
  }
}

function prosesLogin(data) {
  var result = { success: false };
  try {
    var googleData = verifikasiGoogleToken(data.idToken);
    if (!googleData) throw new Error('Token Google tidak valid atau kadaluarsa. Coba login ulang.');
    var email = googleData.email;
    var namaGoogle = googleData.nama;
    data._fotoGoogle = googleData.foto || ''; // dipakai route 'login' untuk foto profil

    var staff = getStaffByEmail(email);

    if (!staff) {
      // Baru pertama kali login -> otomatis didaftarkan, tapi berstatus BELUM AKTIF (menunggu approval Owner)
      var shStaff = getStaffSheet();
      shStaff.insertRowAfter(1); // selalu masuk PALING ATAS (baris 2) biar gampang keliatan, bukan nyempil di bawah
      var newRow = 2;
      shStaff.getRange(newRow, 4).insertCheckboxes();
      var sekarang = new Date();
      shStaff.getRange(newRow, 1, 1, 6).setValues([[email, namaGoogle || email, '', false, sekarang, sekarang]]);
      if (!shStaff.getRange(1, 5).getValue()) {
        shStaff.getRange(1, 5).setValue('Tanggal Bergabung').setFontWeight('bold');
        shStaff.getRange(1, 6).setValue('Terakhir Login').setFontWeight('bold');
      }

      result.success = true;
      result.email = email;
      result.nama = namaGoogle || email;
      result.role = '';
      result.aktif = false;
      result.izin = {};
      return result;
    }

    // Update "Terakhir Login" tiap kali berhasil login (staff sudah terdaftar)
    updateTerakhirLoginStaff(email);

    if (!staff.aktif) {
      // Sudah terdaftar tapi belum di-approve
      result.success = true;
      result.email = email;
      result.nama = staff.nama;
      result.role = staff.role || '';
      result.aktif = false;
      result.izin = {};
      return result;
    }

    var izin = getIzinByEmail(email);
    result.success = true;
    result.email = email;
    result.nama = staff.nama;
    result.role = staff.role;
    result.aktif = true;
    result.isOwner = staff.role === 'Owner';
    result.izin = izin;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function updateTerakhirLoginStaff(email) {
  try {
    var sh = getStaffSheet();
    var lastRow = sh.getLastRow();
    if (lastRow < 2) return;
    var emails = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    var emailLower = String(email).trim().toLowerCase();
    for (var i = 0; i < emails.length; i++) {
      if (String(emails[i][0]).trim().toLowerCase() === emailLower) {
        sh.getRange(i + 2, 6).setValue(new Date());
        break;
      }
    }
  } catch (e) {} // gagal update "terakhir login" bukan alasan buat gagalin proses login-nya
}

/* ============ APPROVAL AKSES (khusus Owner) ============ */
function prosesLihatPermintaanAkses(data) {
  var result = { success: false };
  try {
    var staffPeminta = getStaffByEmail(data.email);
    if (!staffPeminta || staffPeminta.role !== 'Owner' || !staffPeminta.aktif) {
      throw new Error('Cuma Owner yang bisa lihat daftar permintaan akses.');
    }

    var sh = getStaffSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    if (lastRow > 1) {
      var values = sh.getRange(2, 1, lastRow - 1, 4).getValues();
      for (var i = 0; i < values.length; i++) {
        var aktif = values[i][3] === true;
        if (aktif) continue; // cuma yang BELUM aktif (pending)
        var email = String(values[i][0] || '').trim();
        if (!email) continue;
        daftar.push({ row: i + 2, email: email, nama: String(values[i][1] || '').trim() });
      }
    }
    result.success = true;
    result.daftar = daftar;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesApproveAkses(data) {
  return withTransaction(data.email, null, 'akses', function () {
    var result = { success: false };
    var staffPeminta = getStaffByEmail(data.email);
    if (!staffPeminta || staffPeminta.role !== 'Owner' || !staffPeminta.aktif) {
      throw new Error('Cuma Owner yang bisa approve akses.');
    }

    var row = parseInt(data.row, 10);
    var roleBaru = String(data.role || '').trim();
    if (!row || row < 2) throw new Error('Baris tidak valid');
    if (!roleBaru) throw new Error('Pilih role dulu sebelum approve.');

    var sh = getStaffSheet();
    if (row > sh.getLastRow()) throw new Error('Data sudah tidak ada.');

    sh.getRange(row, 3).setValue(roleBaru);
    sh.getRange(row, 4).setValue(true);

    // Otomatis isi wewenang (kolom 7-13) sesuai default role yang dipilih -
    // Owner tetap bisa ubah manual satu-satu nanti lewat Kelola Staff
    if (!sh.getRange(1, 7).getValue()) {
      sh.getRange(1, 7, 1, DAFTAR_IZIN.length).setValues([DAFTAR_IZIN]).setFontWeight('bold');
    }
    var izinDefault = getPermissionsForRole(roleBaru);
    var barisIzin = DAFTAR_IZIN.map(function (key) { return izinDefault[key] === true; });
    sh.getRange(row, 7, 1, DAFTAR_IZIN.length).insertCheckboxes();
    sh.getRange(row, 7, 1, DAFTAR_IZIN.length).setValues([barisIzin]);

    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.'
  });
}

function prosesTolakAkses(data) {
  return withTransaction(data.email, null, 'akses', function () {
    var result = { success: false };
    var staffPeminta = getStaffByEmail(data.email);
    if (!staffPeminta || staffPeminta.role !== 'Owner' || !staffPeminta.aktif) {
      throw new Error('Cuma Owner yang bisa tolak akses.');
    }

    var row = parseInt(data.row, 10);
    if (!row || row < 2) throw new Error('Baris tidak valid');

    var sh = getStaffSheet();
    if (row > sh.getLastRow()) throw new Error('Data sudah tidak ada.');
    sh.deleteRow(row);
    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.'
  });
}

function prosesLihatDaftarRole(data) {
  var result = { success: false };
  try {
    var sh = getHakAksesSheet();
    var lastRow = sh.getLastRow();
    var daftar = [];
    var izinPerRole = {};
    if (lastRow > 1) {
      var values = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < values.length; i++) {
        var role = String(values[i][0] || '').trim();
        if (role) {
          daftar.push(role);
          izinPerRole[role] = getPermissionsForRole(role);
        }
      }
    }
    result.success = true;
    result.daftar = daftar;
    result.izinPerRole = izinPerRole;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

function prosesCekStatusStaff(data) {
  var result = { success: false };
  try {
    var email = String(data.email || '').trim();
    if (!email) throw new Error('Email kosong');

    var staff = getStaffByEmail(email);
    if (!staff) {
      result.success = true;
      result.aktif = false;
      return result;
    }

    result.success = true;
    result.email = email;
    result.nama = staff.nama;
    result.role = staff.role || '';
    result.aktif = staff.aktif;
    if (staff.aktif) {
      result.isOwner = staff.role === 'Owner';
      result.izin = getPermissionsForRole(staff.role);
    }
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

// Cek izin ulang dari Sheets tiap kali dipanggil (bukan percaya begitu saja data dari frontend)
function cekIzin(email, key) {
  // Proses SISTEM (trigger rekap, dll.) - flag server-side, tidak bisa diset dari browser
  if (IZIN_SISTEM_) return true;
  // Jalur belakang khusus developer testing - lihat peringatan di DEV_EMAIL_TESTING paling atas file ini
  if (DEV_EMAIL_TESTING && email === DEV_EMAIL_TESTING) return true;

  // Jalur belakang khusus "Admin Gudang" sementara - izin terbatas (nggak termasuk buatInvoice/batalPesanan)
  if (ADMIN_GUDANG_EMAIL_TESTING && email === ADMIN_GUDANG_EMAIL_TESTING) {
    var izinAdminGudang = { scanResiKeluar: true, scanResiMasuk: true, mintaStock: true, printLabel: true, kirimResi: true };
    return izinAdminGudang[key] === true;
  }

  // Jaring pengaman: kalau tab Staff belum punya email terdaftar sama sekali,
  // izinkan semua aksi - supaya sistem nggak terkunci sebelum Owner pertama didaftarkan.
  var adaEmailTerdaftar = staffSnapshot_().rows.some(function (r) { return r[0] !== ''; });
  if (!adaEmailTerdaftar) return true;

  if (!email) return false;
  var staff = getStaffByEmail(email);
  if (!staff || !staff.aktif) return false;
  var izin = getIzinByEmail(email);
  return !!izin[key];
}

function getNamaStaff(email) {
  var staff = getStaffByEmail(email);
  return staff ? staff.nama : (email || '-');
}

/* ============================================================
   DETEKSI KURIR OTOMATIS (best-effort dari pola nomor resi)
   CATATAN: resi dari marketplace sering cuma angka polos tanpa kode
   kurir, jadi banyak yang bakal masuk "Tidak Diketahui" - itu wajar,
   silakan dikoreksi manual lewat halaman Lihat Resi.
   ============================================================ */
// Versi lengkap (1x buka Sheets) - dipakai buat aksi tunggal seperti scan/koreksi 1 resi
function deteksiKurir(noResi) {
  var daftarPola = muatDaftarPolaPelajari();
  return deteksiKurirCepat(noResi, daftarPola);
}

function prosesUpdateKurirResi(data) {
  return withTransaction(data.email, null, 'pengiriman', function () {
    var result = { success: false };
    var tipe = data.tipe;
    var permKey = tipe === 'keluar' ? 'scanResiKeluar' : 'scanResiMasuk';
    if (!cekIzin(data.email, permKey)) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var row = parseInt(data.row, 10);
    var kurirBaru = String(data.kurir || '').trim();
    if (!row || row < 2) throw new Error('Baris tidak valid');
    if (!kurirBaru) throw new Error('Nama kurir kosong');

    var info = getSheetInfo(tipe);
    var sh = info.sheet;
    var kolomKurir = tipe === 'keluar' ? 10 : (tipe === 'retur' ? 7 : 5);

    if (!sh.getRange(1, kolomKurir).getValue()) {
      sh.getRange(1, kolomKurir).setValue('Kurir').setFontWeight('bold');
    }
    sh.getRange(row, kolomKurir).setValue(kurirBaru);

    // Pelajari pola dari koreksi ini supaya scan berikutnya otomatis lebih akurat
    var noResiBaris = String(sh.getRange(row, 1).getValue() || '').trim();
    if (noResiBaris) simpanPolaKurir(noResiBaris, kurirBaru);

    result.success = true;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.'
  });
}

function prosesEditNoResi(data) {
  return withTransaction(data.email, null, 'pengiriman', function () {
    var result = { success: false };
    var tipe = data.tipe;
    var permKey = tipe === 'keluar' ? 'scanResiKeluar' : 'scanResiMasuk';
    if (!cekIzin(data.email, permKey)) throw new Error('Anda tidak punya izin untuk aksi ini.');

    var row = parseInt(data.row, 10);
    var noResiBaru = String(data.noResi || '').trim();
    if (!row || row < 2) throw new Error('Baris tidak valid');
    if (!noResiBaru) throw new Error('No Resi tidak boleh kosong');

    var info = getSheetInfo(tipe);
    var sh = info.sheet;
    var kolomKurir = tipe === 'keluar' ? 10 : (tipe === 'retur' ? 7 : 5);

    // Cek duplikat terhadap baris lain (selain baris ini sendiri)
    var lastRow = sh.getLastRow();
    if (lastRow > 1) {
      var existing = sh.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < existing.length; i++) {
        var baris = i + 2;
        if (baris === row) continue;
        if (resiSama_(existing[i][0], noResiBaru)) {
          throw new Error('No Resi ini sudah ada di baris lain, tidak bisa dipakai dobel.');
        }
      }
    }

    tulisResiTeks_(sh.getRange(row, 1), noResiBaru);
    var kurirBaru = deteksiKurir(noResiBaru);
    sh.getRange(row, kolomKurir).setValue(kurirBaru);

    result.success = true;
    result.kurir = kurirBaru;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.'
  });
}

function prosesRingkasanKurir(data) {
  var result = { success: false };
  try {
    var tipe = data.tipe; // 'keluar', 'retur', atau 'stock'
    var permKeyRK = tipe === 'keluar' ? 'scanResiKeluar' : 'scanResiMasuk';
    if (!cekIzin(data.email, permKeyRK)) {
      throw new Error('Anda tidak punya izin untuk aksi ini.');
    }

    var tz = Session.getScriptTimeZone();
    var todayStr = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
    var kelompok = {}; // { 'JNE': [ {noResi, row, tanggal}, ... ], ... }
    var daftarPola = muatDaftarPolaPelajari(); // dimuat SEKALI, bukan per-baris

    function prosesSheet(tipeInfo, kolomDate, kolomKurir) {
      var info = getSheetInfo(tipeInfo);
      var sh = info.sheet;
      var lastRow = sh.getLastRow();
      if (lastRow < 2) return;
      var numRows = lastRow - 1;
      var resiVals = sh.getRange(2, 1, numRows, 1).getValues();
      var dateVals = sh.getRange(2, kolomDate, numRows, 1).getValues();
      var kurirVals = sh.getRange(2, kolomKurir, numRows, 1).getValues();

      for (var i = 0; i < numRows; i++) {
        var noResi = String(resiVals[i][0] || '').trim();
        if (!noResi) continue;
        var tgl = dateVals[i][0];
        if (!(tgl instanceof Date)) continue;
        if (Utilities.formatDate(tgl, tz, 'yyyy-MM-dd') !== todayStr) continue;

        var kurirTersimpan = String(kurirVals[i][0] || '').trim();
        var kurir = kurirTersimpan || deteksiKurirCepat(noResi, daftarPola);

        if (!kelompok[kurir]) kelompok[kurir] = [];
        kelompok[kurir].push({ noResi: noResi, row: i + 2 });
      }
    }

    if (tipe === 'keluar') {
      prosesSheet('keluar', 3, 10);
    } else if (tipe === 'retur') {
      prosesSheet('retur', 2, 7);
    } else if (tipe === 'stock') {
      prosesSheet('stock', 2, 5);
    } else {
      // fallback gabungan retur+stock (dipakai kalau tipe tidak spesifik)
      prosesSheet('retur', 2, 7);
      prosesSheet('stock', 2, 5);
    }

    result.success = true;
    result.kelompok = kelompok;
  } catch (err) {
    result.error = err.toString();
  }
  return result;
}

/* ============ EDIT PESANAN: ubah produk & simpan ke No Invoice yang sama ============ */
function prosesUpdateItemPesanan(data) {
  var row, namaPenerima, alamat, noHp, kurir, items, ongkosKirim, biayaLainnya, diskon, pajak;
  return withTransaction(data.email, 'buatInvoice', 'penjualan', function () {
    var result = { success: false };
    var sheets = getPesananManualSheets();
    var sh = sheets.header;
    if (row > sh.getLastRow()) throw new Error('Pesanan tidak ditemukan');

    if (data.noInvoice) { row = pmCariBaris_(sh, row, data.noInvoice) || row; } // baris bisa bergeser setelah ada hapus permanen
    var noInvoice = String(sh.getRange(row, 1).getValue()).trim();

    var subtotalProduk = 0;
    items.forEach(function (item) {
      subtotalProduk += (parseFloat(item.harga) || 0) * (parseInt(item.qty, 10) || 0);
    });
    var total = subtotalProduk + ongkosKirim + biayaLainnya - diskon + pajak;

    // Update baris header (No Invoice & Tanggal TIDAK berubah)
    sh.getRange(row, 3, 1, 8).setValues([[namaPenerima, alamat, noHp, kurir, subtotalProduk, ongkosKirim, biayaLainnya, total]]);
    sh.getRange(row, 14, 1, 2).setValues([[diskon, pajak]]);
    var namaPembeli = String(data.namaPembeli || '').trim() || namaPenerima;
    var noHpPembeli = String(data.noHpPembeli || '').trim() || noHp;
    sh.getRange(row, 16, 1, 2).setValues([[namaPembeli, noHpPembeli]]);
    sh.getRange(row, 18).setValue(data.toko || 'Waterground');

    // Hapus rincian produk lama punya invoice ini, ganti dengan yang baru
    var shDetail = sheets.detail;
    var lastRowDetail = shDetail.getLastRow();
    if (lastRowDetail > 1) {
      var detailVals = shDetail.getRange(2, 1, lastRowDetail - 1, 1).getValues();
      var rowsToDelete = [];
      for (var i = 0; i < detailVals.length; i++) {
        if (String(detailVals[i][0]).trim() === noInvoice) rowsToDelete.push(i + 2);
      }
      for (var j = rowsToDelete.length - 1; j >= 0; j--) {
        shDetail.deleteRow(rowsToDelete[j]);
      }
    }

    var startRow = shDetail.getLastRow() + 1;
    var detailRows = items.map(function (item) {
      return [noInvoice, item.sku, item.nama, item.qty, item.harga];
    });
    shDetail.getRange(startRow, 1, detailRows.length, 5).setNumberFormat('@');
    shDetail.getRange(startRow, 1, detailRows.length, 5).setValues(detailRows);

    result.success = true;
    result.noInvoice = noInvoice;
    result.total = total;
    return result;
  }, {
    tungguMs: 15000,
    pesanSibuk: 'Sistem sedang sibuk, coba lagi.',
    pesanTanpaIzin: 'Anda tidak punya izin untuk mengubah pesanan.',
    validasi: function () {
      row = parseInt(data.row, 10);
      if (!row || row < 2) throw new Error('Baris tidak valid');
  
      namaPenerima = String(data.namaPenerima || '').trim();
      alamat = String(data.alamat || '').trim();
      noHp = String(data.noHp || '').trim();
      kurir = String(data.kurir || '').trim();
      items = data.items || [];
      ongkosKirim = parseFloat(data.ongkosKirim) || 0;
      biayaLainnya = parseFloat(data.biayaLainnya) || 0;
      diskon = parseFloat(data.diskon) || 0;
      pajak = parseFloat(data.pajak) || 0;
  
      if (!namaPenerima) throw new Error('Nama penerima kosong');
      if (!alamat) throw new Error('Alamat kosong');
      if (items.length === 0) throw new Error('Belum ada produk ditambahkan');
    }
  });
}

/* ============================================================
   POLA KURIR YANG DIPELAJARI (dari koreksi manual)
   Tiap kali user koreksi kurir manual, sistem belajar pola nomor
   resi-nya supaya deteksi otomatis makin akurat ke depannya.
   ============================================================ */
function getPolaKurirSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('Pola Kurir');
  if (!sh) {
    sh = ss.insertSheet('Pola Kurir');
    sh.getRange(1, 1, 1, 3).setValues([['Pola (Awalan)', 'Kurir', 'Terakhir Diupdate']]);
    sh.getRange(1, 1, 1, 3).setFontWeight('bold');
  }
  return sh;
}

function turunkanPolaDariResi(noResi) {
  var s = String(noResi || '').trim().toUpperCase();
  var hurufDepan = s.match(/^[A-Z]+/);
  if (hurufDepan && hurufDepan[0].length >= 2) {
    return hurufDepan[0].length > 6 ? hurufDepan[0].substring(0, 6) : hurufDepan[0];
  }
  var angkaDepan = s.match(/^\d+/);
  if (angkaDepan && angkaDepan[0].length >= 3) {
    return angkaDepan[0].substring(0, Math.min(4, angkaDepan[0].length));
  }
  return s.substring(0, Math.min(4, s.length));
}

var POLA_KURIR_MEMO_ = null;
function muatDaftarPolaPelajari() {
  if (POLA_KURIR_MEMO_) return POLA_KURIR_MEMO_;
  try { var c = CacheService.getScriptCache().get('POLA_KURIR_V1'); if (c) { POLA_KURIR_MEMO_ = JSON.parse(c); return POLA_KURIR_MEMO_; } } catch (e) {}
  POLA_KURIR_MEMO_ = muatDaftarPolaPelajariSheet_();
  try { CacheService.getScriptCache().put('POLA_KURIR_V1', JSON.stringify(POLA_KURIR_MEMO_), 600); } catch (e) {}
  return POLA_KURIR_MEMO_;
}
function muatDaftarPolaPelajariSheet_() {
  var sh = getPolaKurirSheet();
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return [];

  var data = sh.getRange(2, 1, lastRow - 1, 2).getValues();
  var daftar = [];
  for (var i = 0; i < data.length; i++) {
    var pola = String(data[i][0] || '').trim().toUpperCase();
    var kurir = String(data[i][1] || '').trim();
    if (!pola || !kurir) continue;
    daftar.push({ pola: pola, kurir: kurir });
  }
  return daftar;
}

function cocokkanPolaDariDaftar(noResiUpper, daftarPola) {
  var terbaik = null;
  for (var i = 0; i < daftarPola.length; i++) {
    var item = daftarPola[i];
    if (noResiUpper.indexOf(item.pola) === 0) {
      if (!terbaik || item.pola.length > terbaik.length) {
        terbaik = item.pola;
        var kurirTerbaik = item.kurir;
      }
    }
  }
  return terbaik ? kurirTerbaik : null;
}

// Versi cepat (nggak buka Sheets) - dipakai di dalam loop, butuh daftarPola sudah dimuat duluan
function deteksiKurirCepat(noResi, daftarPolaPelajari) {
  var s = String(noResi || '').trim().toUpperCase();
  if (!s) return 'Tidak Diketahui';

  var polaPelajari = cocokkanPolaDariDaftar(s, daftarPolaPelajari);
  if (polaPelajari) return polaPelajari;

  return cocokkanPolaBawaan(s);
}

function cocokkanPolaBawaan(s) {
  if (s.indexOf('JY') === 0) return 'J&T';
  if (s.indexOf('CM') === 0) return 'JNE';
  if (s.indexOf('SHPE') === 0) return 'Shopee Express';
  if (s.indexOf('1100') === 0) return 'AnterAja';
  if (s.indexOf('004') === 0) return 'SiCepat';
  if (s.indexOf('260') === 0) return 'Shopee Express';
  if (s.indexOf('5850') === 0) return 'Shopee Express';
  if (s.indexOf('JNT') === 0) return 'J&T';
  if (s.indexOf('ANTA') === 0) return 'AnterAja';
  if (s.indexOf('SSCP') === 0 || s.indexOf('SICEPAT') === 0) return 'SiCepat';
  if (s.indexOf('JNE') === 0) return 'JNE';
  if (s.indexOf('SPX') === 0) return 'Shopee Express';
  if (s.indexOf('NINJA') === 0 || s.indexOf('NJV') === 0) return 'Ninja Van';
  if (s.indexOf('TIKI') === 0) return 'TIKI';
  if (s.indexOf('LION') === 0 || s.indexOf('LP') === 0) return 'Lion Parcel';
  if (s.indexOf('WHN') === 0 || s.indexOf('WAHANA') === 0) return 'Wahana';
  if (s.indexOf('IDE') === 0) return 'ID Express';
  if (/^[A-Z]{2}\d{9}[A-Z]{2}$/.test(s)) return 'Pos Indonesia';
  return 'Tidak Diketahui';
}

function simpanPolaKurir(noResi, kurirBaru) {
  POLA_KURIR_MEMO_ = null;
  try { CacheService.getScriptCache().remove('POLA_KURIR_V1'); } catch (e) {}
  if (!kurirBaru || kurirBaru === 'Tidak Diketahui') return;
  var pola = turunkanPolaDariResi(noResi);
  if (!pola) return;

  var sh = getPolaKurirSheet();
  var lastRow = sh.getLastRow();

  if (lastRow > 1) {
    var data = sh.getRange(2, 1, lastRow - 1, 1).getValues();
    for (var i = 0; i < data.length; i++) {
      if (String(data[i][0]).trim().toUpperCase() === pola) {
        // Pola sudah ada -> update kurir-nya (mungkin sebelumnya salah)
        sh.getRange(i + 2, 2).setValue(kurirBaru);
        sh.getRange(i + 2, 3).setValue(new Date());
        return;
      }
    }
  }
  // Pola baru -> tambahkan baris baru
  sh.appendRow([pola, kurirBaru, new Date()]);
}

