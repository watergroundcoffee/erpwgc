function agkTokenModel_(nama) {
  return String(nama || '').toLowerCase().split(/[^a-z0-9]+/).filter(function (w) { return w && (/\d/.test(w) || /^(wave|switch|origami|mugen|suiren|chestnut|slim|nano|crystal|clever)$/.test(w)); });
}
function agkAgenBundling_(produk, opsi) {
  var stok = {}; try { stok = rstStokProduk_(opsi.email); } catch (e) { stok = {}; }
  var adaBdl = {}; try { bdlBacaSheet_().forEach(function (b) { adaBdl[b.isi.map(function (x) { return String(x.sku).toUpperCase(); }).sort().join('+')] = 1; }); } catch (e) { }
  var perKat = {}, petaSku = {};
  produk.forEach(function (p) {
    petaSku[p.sku.toUpperCase()] = p;
    if (!(p.hpp > 0) || !((p.shopee || p.harga) > 0)) return;
    var c = agkKlasifikasi_(p.nama + ' ' + p.tipe);
    if (c) (perKat[c.k] = perKat[c.k] || []).push(p);
  });
  var calon = [], dipakai = {};
  function hargaOf(p) { return p.shopee || p.harga; }
  function tambah(isi, alasan, sumber) {
    var kunci = isi.map(function (x) { return x.sku.toUpperCase(); }).sort().join('+');
    if (adaBdl[kunci] || dipakai[kunci]) return;
    var ps = isi.map(function (x) { return petaSku[x.sku.toUpperCase()]; });
    if (ps.some(function (p) { return !p; })) return;
    dipakai[kunci] = 1;
    var normal = 0, hpp = 0;
    ps.forEach(function (p, i) { normal += hargaOf(p) * isi[i].qty; hpp += p.hpp * isi[i].qty; });
    var diskon = 0, hargaB = normal;
    if (normal > 0 && (normal * 0.95 - hpp) / (normal * 0.95) >= 0.2) { diskon = 5; hargaB = Math.round(normal * 0.95 / 500) * 500; }
    var pendek = function (p) { var n = agkRumusNama_(p).baru; return n.length > 34 ? n.slice(0, 34).replace(/\s+\S*$/, '') : n; };
    var nama = 'Paket ' + ps.map(pendek).join(' + ');
    calon.push({ jenis: 'buat_bundling', kunci: 'bdl|' + kunci, judul: nama.slice(0, 120),
      alasan: alasan + ' · harga normal Rp ' + Math.round(normal).toLocaleString('id-ID') + (diskon ? ' → usulan harga bundling Rp ' + hargaB.toLocaleString('id-ID') + ' (-5%, margin tetap ≥ 20%)' : ' (diskon tidak diusulkan: margin < 20%)'),
      data: { isi: isi, nama: nama.slice(0, 120), hargaNormal: Math.round(normal), hpp: Math.round(hpp), diskonPct: diskon, hargaBundling: hargaB, sumber: sumber,
        produk: ps.map(function (p, i) { return { sku: p.sku, nama: p.nama, qty: isi[i].qty, stok: stok[p.sku.toUpperCase()] || 0 }; }) } });
  }
  // 1) Dibeli bersama (dari Agen Penjualan, bila hasil analisanya masih tersimpan)
  [30, 14, 7].forEach(function (h) {
    try {
      var a = cacheBesarGet_(AGP_CACHE_ + h);
      ((a && a.rekomendasi) || []).forEach(function (r) {
        var ak = r.aksi || {}, skus = (ak.params && ak.params.skus) || [];
        if (ak.action === 'CREATE_BUNDLE' && skus.length >= 2) tambah(skus.slice(0, 3).map(function (s) { return { sku: String(s), qty: 1 }; }), 'Sering dibeli bersama (data penjualan ' + h + ' hari)', 'penjualan');
      });
    } catch (e) { }
  });
  // 2) Pasangan pelengkap alat kopi
  AGK_PASANGAN_.forEach(function (ps) {
    var A = perKat[ps[0]] || [], B = perKat[ps[1]] || [], pasang = [];
    A.forEach(function (a) {
      B.forEach(function (b) {
        if (a.sku === b.sku) return;
        var skor = 0, sa = stok[a.sku.toUpperCase()] || 0, sb = stok[b.sku.toUpperCase()] || 0;
        if (sa > 0 && sb > 0) skor += 3; else if (sa > 0 || sb > 0) skor += 1;
        var ma = agkMerekDi_(a.brand || a.nama), mb = agkMerekDi_(b.brand || b.nama);
        if (ma && ma === mb) skor += 3;
        var ta = agkTokenModel_(a.nama), tb = agkTokenModel_(b.nama);
        if (ta.some(function (t) { return tb.indexOf(t) !== -1; })) skor += 4;
        pasang.push({ a: a, b: b, skor: skor });
      });
    });
    pasang.sort(function (x, y) { return y.skor - x.skor; });
    var n = 0, terpakai = {};
    for (var i = 0; i < pasang.length && n < 2; i++) {
      var x = pasang[i];
      if (x.skor < 3 || terpakai[x.a.sku] || terpakai[x.b.sku]) continue;
      terpakai[x.a.sku] = terpakai[x.b.sku] = 1; n++;
      tambah([{ sku: x.a.sku, qty: 1 }, { sku: x.b.sku, qty: 1 }], ps[2], 'pelengkap');
    }
  });
  return { daftar: calon.slice(0, AGK_MAKS_.pm_bundling), ringkas: calon.length + ' kombinasi bundling diusulkan (stok tersedia, merek/model cocok diutamakan, bundling yang sudah ada dilewati)' };
}

